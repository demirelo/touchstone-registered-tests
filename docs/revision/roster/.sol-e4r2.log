"""Fails when the response letter names a table number that the compiled paper does not give that table (lesson
2026-11-05: table numbers typed from memory were wrong). Usage: check_letter_tables.py LETTER.md MAIN.aux"""
import re
import sys

EXPECT = {"side-evidence table": "tab:q1-side", "new exploratory table": "tab:ph-q1", "per-market table": "tab:ph-q4",
          "stability table": "tab:ph-stability", "Table 11)": "tab:ph-welfare", "Tables 17 and 18": "tab:predictions"}


def problems(letter: str, aux: str) -> list[str]:
    num = dict(re.findall(r"\\newlabel\{(tab:[^}]*)\}\{\{(\d+)\}", aux)); out = []
    for phrase, label in EXPECT.items():
        for m in re.finditer(re.escape(phrase), letter):
            near = letter[max(0, m.start() - 10): m.end() + 30]
            got = re.findall(r"Tables? (\d+)", near)
            if label not in num:
                out.append(f"{label}: not in the paper")
            elif got and num[label] not in got:
                out.append(f"'{phrase}': letter says Table {got[0]}, paper has Table {num[label]}")
    return out


if __name__ == "__main__":
    pr = problems(open(sys.argv[1]).read(), open(sys.argv[2]).read())
    print("\n".join(pr) or "ok"); sys.exit(1 if pr else 0)
"""Tests for cells_v2.py (per-cell means from the verified evaluation records) and score_v2.py (the hashed prediction
scoring table, cell by cell). The world is the code's own synthetic world (tests/test_report_v2.py)."""
import json
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(Path(__file__).resolve().parent))
import cells_v2 as C  # noqa: E402
import score_v2 as S  # noqa: E402
from tests import test_report_v2 as W  # noqa: E402


@pytest.fixture
def world(tmp_path, monkeypatch):
    out, cat = W._world(tmp_path)
    return out, W._run(monkeypatch, out, cat)


def test_cells_reads_means_and_hashes(world):
    out, _ = world
    cells = C.extract(out)
    rid = "headline@rho0.2|F111|X7-SC|profit"
    gains = json.loads((out / "evaluate" / (C.safe(rid) + ".json")).read_text())["gain"]
    assert abs(cells[rid]["gain"] - sum(gains) / len(gains)) < 1e-12
    assert len(cells[rid]["sha256"]) == 64
    x8 = cells["headline@rho0.2|F111|X8-DB|total|c2_roles"]
    assert len(x8["member_gain"]) == 2


def test_every_prediction_scored_with_a_valid_status(world):
    out, rep = world
    sc = S.score(rep, C.extract(out))
    ids = {"Q1-a", "Q1-a-alt", "Q1-b", "Q1-c", "Q1-d", "Q2-a", "Q2-b", "Q2-c", "Q2-d", "Q3-a", "Q3-b", "Q3-c", "Q3-d", "Q3-e",
           "Q3-f", "Q3-g", "Q4-a", "Q4-b"}
    assert set(sc) == ids
    assert all(v["status"] in ("fulfilled", "failed", "not assessed") for v in sc.values())


def test_q1a_follows_the_category(world):
    out, rep = world
    rep["q1"]["tests"]["C*-F111|D2+H3"]["category"] = "equivalent, direction R3 lower"
    assert S.score(rep, C.extract(out))["Q1-a"]["status"] == "fulfilled"
    rep["q1"]["tests"]["C*-F111|D2+H3"]["category"] = "C* materially lower"
    assert S.score(rep, C.extract(out))["Q1-a"]["status"] == "failed"


def test_q1b_excludes_the_c_star_lower_direction(world):
    out, rep = world
    rep["q1"]["tests"]["C*-F111|X7-SC"]["category"] = "equivalent, direction C* lower"
    assert S.score(rep, C.extract(out))["Q1-b"]["status"] == "failed"


def test_cell_aggregation_missing_cell_is_not_assessed_but_a_failed_cell_fails(world):
    out, rep = world
    cells = C.extract(out)
    del cells["fresh3@rho0.2|C*|X7-SC|profit"]
    st = S.score(rep, cells)["Q3-a"]
    assert st["status"] in ("not assessed", "failed")
    if st["status"] == "not assessed":
        assert any(c["status"] == "not assessed" for c in st["cells"])
    cells["fresh0@rho0.2|F111|X7-SC|profit"]["gain"] = cells["fresh0@rho0.2|F111|D2+H3|profit"]["gain"] + 0.2
    assert S.score(rep, cells)["Q3-a"]["status"] == "failed"


def test_q3d_uses_the_difference_also_for_nonpositive_totals(world):
    out, rep = world
    for r in ("F111", "C*"):
        for g in rep["q3"]["coalition"][r]:
            rep["q3"]["coalition"][r][g] = {"G_tot": {"estimate": -0.2}, "G_min": {"estimate": -0.05, "bounds": [None, None]}}   # -0.05 > 0.5 x -0.2
    assert S.score(rep, C.extract(out))["Q3-d"]["status"] == "failed"
    for r in ("F111", "C*"):
        for g in rep["q3"]["coalition"][r]:
            rep["q3"]["coalition"][r][g] = {"G_tot": {"estimate": -0.2}, "G_min": {"estimate": -0.15, "bounds": [None, None]}}   # -0.15 <= 0.5 x -0.2
    assert S.score(rep, C.extract(out))["Q3-d"]["status"] == "fulfilled"


def test_q4b_strict_tie_fails_and_no_eligible_market_is_not_assessed(world):
    out, rep = world
    rep["q4"]["failing"] = []
    assert S.score(rep, C.extract(out))["Q4-b"]["status"] == "not assessed"
    m = "fresh1"
    rep["q4"]["failing"] = [m]; rep["q4"]["markets"][m]["p_gain"] = rep["q4"]["markets"][m]["p_eff"] = 0.5
    assert S.score(rep, C.extract(out))["Q4-b"]["status"] == "failed"


def test_q4a_needs_a_decision(world):
    out, rep = world
    rep["q4"]["k"] = None
    assert S.score(rep, C.extract(out))["Q4-a"]["status"] == "not assessed"
    rep["q4"]["k"] = 5
    assert S.score(rep, C.extract(out))["Q4-a"]["status"] == "fulfilled"


def test_q1c_reports_c_star_minus_f111_as_registered(world):
    out, rep = world
    rep["q1"]["tests"]["C*-F111|D2+H3"]["side"]["gross_eff_diff"] = 0.004          # the report's side fields are F111 minus C*
    cell = [c for c in S.score(rep, C.extract(out))["Q1-c"]["cells"] if c["cell"] == "D2+H3"][0]
    assert cell["value"] == -0.004
"""Tests for tables_v2.py on the report built by the code's own synthetic world (tests/test_report_v2.py), so the
schema is the real one. Row labels are the keys that fetch the values; these tests check that, and the status rows."""
import json
import math
import subprocess
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(Path(__file__).resolve().parent))
import tables_v2 as T  # noqa: E402
from tests import test_report_v2 as W  # noqa: E402


@pytest.fixture
def report(tmp_path, monkeypatch):
    out, cat = W._world(tmp_path)
    return W._run(monkeypatch, out, cat)


def _row(tex: str, label: str) -> str:
    rows = [r for r in tex.split("\\\\") if r.strip().startswith(label + " &") or ("\n" + label + " &") in r]
    assert len(rows) == 1, (label, rows)
    return rows[0]


def test_q4_rows_carry_their_own_market_values(report):
    for i, m in enumerate(W.FRESH):
        if isinstance(report["q4"]["markets"][m], dict):
            report["q4"]["markets"][m]["gain_diff"] = 0.101 + i / 10
    tex = T.q4(report)
    for i, m in enumerate(W.FRESH):
        assert f"{0.101 + i / 10:.3f}" in _row(tex, m)


def test_q4_status_row_for_an_undecided_market(report):
    report["q4"]["markets"]["fresh2"] = "not decided"
    assert "not decided" in _row(T.q4(report), "fresh2")


def test_q1_rows_by_family_with_category_and_side_evidence(report):
    tex = T.q1(report); side = T.q1_side(report)
    for fam in ("D2+H3", "X7-SC"):
        t = report["q1"]["tests"][f"C*-F111|{fam}"]
        assert T.esc(t["category"]) in _row(tex, fam)
        assert f"{t['side']['gross_eff_diff']:.3f}".lstrip("-") in _row(side, fam)


def test_q2_contrast_rows_match_their_contrast(report):
    tex = T.q2(report, "D2+H3")
    for c, v in report["q2"]["searched"]["D2+H3"].items():
        assert f"{v['estimate']:.3f}".lstrip("-") in _row(tex, c)


def test_coalition_and_welfare_tables_render(report):
    assert "c5\\_staggered" in T.coalitions(report)
    assert "W1" in T.welfare(report)


def test_nonfinite_value_refused(report):
    report["q4"]["markets"]["fresh0"]["gain_diff"] = math.nan
    with pytest.raises(ValueError):
        T.q4(report)


def test_all_tables_compile(report, tmp_path):
    tex = "\n".join(T.all_tables(report).values())
    (tmp_path / "t.tex").write_text("\\documentclass{article}\\usepackage{booktabs}\\begin{document}\n" + tex + "\n\\end{document}\n")
    r = subprocess.run(["pdflatex", "-interaction=nonstopmode", "-halt-on-error", "t.tex"], cwd=tmp_path, capture_output=True, text=True)
    assert r.returncode == 0, r.stdout[-1500:]


def test_small_p_values_keep_digits_in_tables(report):
    report["q1"]["tests"]["C*-F111|D2+H3"]["p"] = 0.0001
    for m in W.FRESH:
        if isinstance(report["q4"]["markets"][m], dict):
            report["q4"]["markets"][m]["p_gain"] = 0.00003
    assert "0.0001" in _row(T.q1(report), "D2+H3")
    assert "3\\times10^{-5}" in _row(T.q4(report), "fresh0")


def test_predictions_rows_carry_their_own_status_and_cells():
    sc = {"Q1-a": {"status": "fulfilled", "cells": [{"cell": "D2+H3", "status": "fulfilled", "value": "equivalent"}]},
          "Q2-a": {"status": "failed", "cells": [{"cell": "G", "status": "fulfilled", "value": -0.0952},
                                                 {"cell": "S", "status": "failed", "value": 0.0039}]},
          "Q4-b": {"status": "not assessed", "cells": []}}
    tex = T.predictions(sc)
    assert "fulfilled" in _row(tex, "Q1-a") and "equivalent" in _row(tex, "Q1-a")
    r = _row(tex, "Q2-a")
    assert r.split("&")[2].strip() == "failed" and "S 0.004 failed" in r and "-0.095" in r.replace("\\ensuremath{", "").replace("}", "")
    assert "not assessed" in _row(tex, "Q4-b")


def test_prediction_pairs_are_labelled_and_rounded():
    sc = {"Q2-d": {"status": "failed", "cells": [{"cell": "P D2+H3", "status": "failed", "value": [-0.08739750289482723, -0.0831087194]}]},
          "Q3-d": {"status": "fulfilled", "cells": [{"cell": "F111 c2_staggered", "status": "fulfilled", "value": [-0.0019989738, 0.07708038]}]}}
    tex = T.predictions(sc).replace("\\ensuremath{", "").replace("}", "")
    assert "fixed -0.0874, searched -0.0831" in _row(tex, "Q2-d")
    assert "G_min -0.0020, G_tot 0.0771" in _row(tex, "Q3-d").replace("\\_", "_")
    assert "0.08739" not in tex and "[" not in tex.split("midrule")[1]


def test_prediction_statements_come_from_the_registered_table():
    md = "| ID | Quantity | Where | Condition |\n|---|---|---|---|\n| Q1-a | category, D2+H3 | pooled fresh | \\| x \\| < 0.05 |\n"
    st = T.statements(md)
    assert st == {"Q1-a": "category, D2+H3 (pooled fresh): | x | < 0.05"}
    tex = T.predictions({"Q1-a": {"status": "fulfilled", "cells": []}}, st)
    assert "category, D2+H3" in _row(tex, "Q1-a")


def test_all_prediction_pairs_are_named_and_precise():
    sc = {"Q3-e": {"status": "fulfilled", "cells": [{"cell": "headline", "status": "fulfilled", "value": [0.04312, 0.04301]}]},
          "Q4-b": {"status": "fulfilled", "cells": [{"cell": "fresh0", "status": "fulfilled", "value": [1.0, 0.0001]}]}}
    tex = T.predictions(sc).replace("\\ensuremath{", "").replace("}", "")
    assert "F111 0.0431, C* 0.0430" in _row(tex, "Q3-e").replace("C$^*$", "C*")
    assert "value 1" not in tex and "p'" in _row(tex, "Q4-b")


def test_predictions_split_into_two_tables_by_question():
    sc = {k: {"status": "fulfilled", "cells": []} for k in ("Q1-a", "Q2-a", "Q3-a", "Q4-a")}
    a, b = T.predictions(sc, ids=("Q1", "Q2")), T.predictions(sc, ids=("Q3", "Q4"))
    assert "Q1-a" in a and "Q3-a" not in a and "Q4-a" in b and "Q2-a" not in b
"""Tests for posthoc_v2.py (exploratory analyses after the report; external review round 4): the Q1 split into attacked and
reference terms, the episode-mixture welfare frontier, and the per-market Q4 diagnostics."""
import json
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import posthoc_v2 as P  # noqa: E402


def _rec(out, rid, **f):
    p = out / "evaluate" / (P.safe(rid) + ".json"); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(json.dumps(f))


def test_split_terms_add_up_to_the_gain_difference(tmp_path):
    s = [10.0, 10.0]
    _rec(tmp_path, "m0@rho0.2|C*|D2+H3|profit", profit_attack=[3.0, 5.0], profit_ref=[1.0, 1.0], sstar=s)
    _rec(tmp_path, "m0@rho0.2|F111|D2+H3|profit", profit_attack=[2.0, 2.0], profit_ref=[0.5, 0.5], sstar=s)
    got = P.split(tmp_path, ["m0"], "C*", "F111", "D2+H3", n=10)
    # g_C = (2, 4), g_F = (1.5, 1.5): d mean = 1.5; attacked term = (1, 3) mean 2; reference term = -(0.5, 0.5) mean -0.5
    assert got["pooled"]["estimate"] == pytest.approx(1.5)
    assert got["pooled"]["attacked"] == pytest.approx(2.0) and got["pooled"]["reference"] == pytest.approx(-0.5)


def test_mixture_weight_is_the_largest_with_a_nonnegative_lower_bound():
    rng = np.random.default_rng(0)
    gw0, gp = -0.1 + 0.001 * rng.standard_normal(200), 0.06 + 0.001 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    m = P.mixture(gw0, ew0, gp, ep)
    assert 0.0 < m["weight"] < 0.375                          # 0.375 is where the mean gain reaches zero
    g = m["weight"] * gw0 + (1 - m["weight"]) * gp
    assert g.mean() - 1.645 * g.std(ddof=1) / np.sqrt(len(g)) >= 0
    assert m["efficiency"] == pytest.approx(m["weight"] * 0.84 + (1 - m["weight"]) * 1.0)


def test_no_mixture_when_the_profitable_policy_is_not_profitable():
    z = np.zeros(200)
    assert P.mixture(z - 0.1, z + 0.84, z - 0.01, z + 1.0)["weight"] == 0.0


def test_weight_label_and_stability_table_keep_the_needed_precision():
    assert P.weight_label(0.4195) == "41.95 percent"            # a rounded 0.42 flips the sign of the lower bound
    res = {"q1_split": {}, "welfare": {}, "q4_diag": {},
           "stability": {"q1": {"C*-F111|D2+H3": {"estimate_report": 0.020720, "estimate_registered_cfg": 0.020917, "category_registered_cfg": "eq"}}}}
    assert "0.0207" in P.tables(res)["stability"] and "0.0209" in P.tables(res)["stability"]

