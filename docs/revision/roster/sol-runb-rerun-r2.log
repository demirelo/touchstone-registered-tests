    31	def validate(job: dict, stage: str, rec: dict, upstream: dict) -> None:
    32	    """`upstream` maps each upstream record id to its current path; raises ValueError on any mismatch."""
    33	    if rec.get("stage") != stage:
    34	        raise ValueError(f"record stage {rec.get('stage')!r} is not {stage!r}")
    35	    if rec.get("provenance") != job.get("provenance"):
    36	        raise ValueError("record provenance differs from the job's")
    37	    for rid, sha in (rec.get("upstream") or {}).items():
    38	        p = upstream.get(rid)
    39	        if p is None or not Path(p).exists() or sha_file(p) != sha:
    40	            raise ValueError(f"upstream {rid} changed or is missing")
