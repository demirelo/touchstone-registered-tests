   399	    dbl_rec = lambda j: Path(a.src) / "doubling" / (R._safe(j["id"]) + ".json")
   400	    def bind_for(j, inputs, smoke, gate):
   401	        st = {"max_rounds": 1 if gate else a.max_rounds, "threshold": THRESHOLD, "seeds": "1+(k-1)R", "gate": gate,
   402	              "nesting": (j["id"] in plan["nesting"]) and not gate}
