   260	def restart_hours(hs: list) -> dict:
   261	    """Hours a restart needs for cells of these worst-case hours on 1 to 16 workers: longest first onto the least-loaded
   262	    worker, plus 0.1 h shutdown, rounded up to 0.01 h (Sol and Astra, rerun review r1: not a fixed estimate)."""
   263	    import math
   264	    out = {}
   265	    for w in range(1, 17):
   266	        load = [0.0] * w
   267	        for h in sorted(hs, reverse=True):
   268	            load[load.index(min(load))] += h
   269	        out[str(w)] = math.ceil((max(load) + 0.1) * 100 - 1e-6) / 100
   270	    return out
   271	
   272	
   273	def _run_and_save(fn, x: tuple, dest, extra: dict) -> None:
   274	    """In the worker: run one cell and write its record (atomic) before anything goes back to the parent, so a sibling's
   275	    death cannot discard a finished result in transit (Sol and Astra, rerun review r1)."""
   276	    write(dest, {**fn(*x), **extra})
   277	
   278	
   279	def run_cells(fn, todo: list, args: list, workers: int, dests: list, extras: list) -> list:
   280	    """Run the cells, each in a worker process (also with one worker: a kill must not take the driver), and let each worker
   281	    save its own record the moment the cell ends. Run B lost all 17 cells to one killed worker because results were written
   282	    only after every cell ended. A lost worker breaks the pool (at submission or later); every cell with no record on disk
   283	    is returned as lost, and saved cells are skipped on restart (guards.reusable)."""
   284	    from concurrent.futures import ProcessPoolExecutor, wait
   285	    from concurrent.futures.process import BrokenProcessPool
   286	    with ProcessPoolExecutor(max_workers=max(1, workers)) as ex:
   287	        futs = []
   288	        try:
   289	            for x, d, e in zip(args, dests, extras):
   290	                futs.append(ex.submit(_run_and_save, fn, x, d, e))
   291	        except BrokenProcessPool:
   292	            pass
   293	        wait(futs)                                               # a broken pool fails the rest; the disk says what is saved
   294	    return [j["id"] for j, d in zip(todo, dests) if read(d) is None]
