   305	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   306	    """Gate mode: round 1 only. On the Mac it is compared with the frozen doubling stage run on the same machine (flagged
   307	    cells diverge across platforms); on the pod, with the registered doubling record. Saved full-budget evidence bound to
   308	    the cell's inputs, this driver, the site, and the environment."""
   309	    ref = frozen_doubling(job, out) if site == "mac" else None
   310	    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours, reference=ref)
   311	    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
   312	    stopped = r.get("round1_gate") == "not run"        # refused by the cell's own admission before round 1: a cost stop, not a mismatch
   313	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "cost_stopped": stopped, "cost": r.get("cost") if stopped else None, "site": site, "compared_with": "frozen stage, same machine" if ref else "registered record",
   314	            "comparison": r["round1_gate"],
   315	            "round1": (r.get("rounds") or [None])[0],
   316	            "binding": bind, "environment": G.environment()}
