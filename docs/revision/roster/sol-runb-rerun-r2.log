   296	
   297	def frozen_doubling(job: dict, out) -> Path:
   298	    """The frozen doubling stage (revision_v2.stage_doubling) for this cell on this machine, saved as a reference record."""
   299	    p = Path(out) / "gate" / "frozen" / (R._safe(job["id"]) + ".json")
   300	    if read(p) is None:
   301	        write(p, {"stage": "doubling", "id": job["id"], **R.stage_doubling(job, Path(out), CUTS, H4_EXCLUDED)})
   302	    return p
