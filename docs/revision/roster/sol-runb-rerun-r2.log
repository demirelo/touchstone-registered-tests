    12	def write(path, rec: dict) -> None:
    13	    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    14	    tmp = p.with_name(f".{p.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")       # unique per writer
    15	    with open(tmp, "w") as f:
    16	        json.dump(rec, f, default=float); f.flush(); os.fsync(f.fileno())
    17	    os.replace(tmp, p)
