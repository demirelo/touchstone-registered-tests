     1	"""Shared guards of the follow-up runs in docs/revision/followup2 (internal review round 1 of both plans): pinned search
     2	settings, budgets checked against the frozen records, saved results reused only under the same binding, a
     3	driver-specific inventory, a cost stop between stages (never a kill), and saved reproduction evidence."""
     4	from __future__ import annotations
     5	
     6	import json
     7	import math
     8	import os
     9	import subprocess
    10	import sys
    11	import time
    12	from pathlib import Path
    13	
    14	HERE = Path(__file__).resolve().parent
    15	ROOT = HERE.parents[2]
    16	sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(HERE.parent / "followup"))
    17	
    18	import reset_followup_v2 as F  # noqa: E402
    19	from sim.records_v2 import read, sha_file, write  # noqa: E402
    20	
    21	PINNED = ("experiments/locked.yaml", "experiments/revision-v2-manifest.yaml")
    22	
    23	
    24	def _refuse(msg: str):
    25	    raise SystemExit(f"follow-up refused: {msg}")
    26	
    27	
    28	def pin_settings() -> None:
    29	    """The locked search settings and the manifest are those of protocol-v2, with no TOUCHSTONE_LOCKED override."""
    30	    if os.environ.get("TOUCHSTONE_LOCKED"):
    31	        _refuse("TOUCHSTONE_LOCKED is set; the locked settings must be the registered file")
    32	    r = subprocess.run(["git", "diff", "--quiet", "protocol-v2", "--", *PINNED], cwd=ROOT)
    33	    if r.returncode != 0:
    34	        _refuse(f"{PINNED} differ from protocol-v2 (or the tag is missing)")
    35	
    36	
    37	def check_budget(job: dict, frozen_record) -> None:
    38	    rec = read(frozen_record)
    39	    if rec is None or list(rec["provenance"]["budget"]) != list(job["budget"]):
    40	        _refuse(f"{job['id']}: search budget {job['budget']} is not the frozen record's {None if rec is None else rec['provenance']['budget']}")
    41	
    42	
    43	def binding(inputs_sha: str, provenance: dict, smoke: bool, settings: dict, driver_sha: str, deps: dict | None = None) -> dict:
    44	    """`deps`: hashes of everything else a result depends on (helpers, plan, report, posthoc, registered records)."""
    45	    b = {"inputs_sha": inputs_sha, "provenance": provenance, "smoke": bool(smoke), "settings": settings, "driver_sha": driver_sha, "deps": dict(deps or {})}
    46	    return json.loads(json.dumps(b, default=float))              # the form it has when read back (tuples become lists)
    47	
    48	
    49	def reusable(path, b: dict) -> bool:
    50	    """False if nothing is saved; True if the saved result has this exact binding; refused otherwise (never overwritten)."""
    51	    rec = read(path)
    52	    if rec is None:
    53	        return False
    54	    if rec.get("binding") != b:
    55	        _refuse(f"{path}: a saved result with another binding exists")
    56	    return True
    57	
    58	
    59	def finite(*xs) -> bool:
    60	    def vals(x):
    61	        if isinstance(x, dict):
    62	            for v in x.values():
    63	                yield from vals(v)
    64	        elif isinstance(x, (list, tuple)):
    65	            for v in x:
    66	                yield from vals(v)
    67	        elif isinstance(x, (int, float)) and not isinstance(x, bool):
    68	            yield x
    69	    return all(math.isfinite(v) for x in xs for v in vals(x))
    70	
    71	
    72	def environment() -> dict:
    73	    env = dict(F.environment()); env.pop("driver_sha256", None)          # the helper hashes the reset driver, not this one
    74	    return env
    75	
    76	
    77	def inventory(out, deviations, files: dict, args) -> dict:
    78	    """Every output file with its hash; this run's deviations; hashes of this driver, the shared modules, the imported
    79	    helpers, the plan and the report; the run arguments and the environment."""
    80	    out = Path(out)
    81	    fixed = {"common.py": HERE / "common.py", "guards.py": HERE / "guards.py", "reset_followup_v2.py": HERE.parent / "followup" / "reset_followup_v2.py",
    82	             "revision_v2.py": ROOT / "scripts" / "revision_v2.py"}
    83	    hashes = {k: sha_file(Path(p)) for k, p in {**fixed, **files}.items() if Path(p).exists()}
    84	    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
    85	            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
    86	    inv = {"stage": "inventory", "deviations": list(deviations), "files": hashes, "args": list(args), "environment": environment(), "records": recs}
    87	    write(out / "inventory.json", inv)
    88	    return inv
