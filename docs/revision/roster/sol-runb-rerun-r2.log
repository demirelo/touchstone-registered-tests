   427	        G.inventory(out, DEVIATIONS, files, argv)
   428	        return 0 if all(r["pass"] for r in res.values()) else 4
   429	    path = lambda j: out / "convergence" / (R._safe(j["id"]) + ".json")
   430	    todo = sorted((j for j in jobs if not G.reusable(path(j), bind(j))), key=lambda j: j["family"] != "X7-SC")   # longest first
   431	    minr = lambda j: 2 if j["id"] in plan["nesting"] else 1
   432	    args = [(j, out, a.max_rounds, None if a.smoke else a.src, cargs, hours(j), emb(j), minr(j)) for j in todo]
   433	    run_cells(run_cell, todo, args, a.workers, [path(j) for j in todo], [{"binding": bind(j)} for j in todo])
   434	    lost = [j["id"] for j in todo if not G.reusable(path(j), bind(j))]          # the disk, not the pool, says what is saved
   435	    status = {j["id"]: read(path(j))["status"] for j in jobs if j["id"] not in lost}
   436	    mismatch = [k for k, v in status.items() if v.startswith("stopped: round 1")]
   437	    if lost:                                                     # exit 5: a worker was lost; a restart runs only these cells
   438	        write(out / "lost_cells.json", {"lost": lost, "saved": [j["id"] for j in todo if j["id"] not in lost], "mismatch": mismatch,
   439	                                        "restart_hours": restart_hours([hours(j) * a.max_rounds for j in todo if j["id"] in lost])})
   440	        G.inventory(out, DEVIATIONS, files, argv)
   441	        return 4 if mismatch else 5                              # Astra r1: a measured mismatch outranks a lost worker (no restart)
   442	    if not a.smoke and not mismatch:
