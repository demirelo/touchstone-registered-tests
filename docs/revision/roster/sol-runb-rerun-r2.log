   331	
   332	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   333	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   334	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   335	    expected = expected or {}
   336	    for rid in expected:
   337	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   338	            raise ValueError(f"{rid}: the run's result is missing")
   339	    sub, out = [], {}
   340	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   341	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   342	        for m in markets:
   343	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   344	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   345	                continue
   346	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra, expected), _cell_gains(src, conv, rb, expected)
   347	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   348	            sub += [r for r, s_ in ((ra, sa), (rb, sb)) if s_ and r not in sub]
   349	        if fz_a:
   350	            out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   351	    return {"label": "exploratory sensitivity; the frozen estimates stay primary; " + C.SCOPE, **out, "substituted": sub}
   352	
