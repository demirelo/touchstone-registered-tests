   423	                G.inventory(out, DEVIATIONS, files, argv); return 3
   424	            write(out / "gate" / (R._safe(j["id"]) + f"__{a.site}.json"), res[j["id"]])
   425	            if not res[j["id"]]["pass"]:                         # review r2: a measured mismatch ends the gate at once (exit 4);
