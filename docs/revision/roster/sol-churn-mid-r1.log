    24	def _write(path: Path, obj):
    25	    path.parent.mkdir(parents=True, exist_ok=True); path.write_text(json.dumps(obj))
    26	
    27	
    28	def _gains(n=40, noise=0.0, seed=0, base=None, shift=None, rates=RATES):
    29	    """Per-seed gains {cond: {ver: {m: {rule: array}}}}; cond 0 is no churn. Shared noise per market and seed."""
    30	    base = base or {"F111": 0.06, "C*": 0.08, "F000": 0.23}
    31	    shift = shift or {}
    32	    rng = np.random.default_rng(seed); out = {}
    33	    e = {m: (rng.normal(0, noise, n) if noise else np.zeros(n)) for m in M6}
    34	    for c in (0,) + tuple(rates):
    35	        out[c] = {}
    36	        for v in ("base", "doubled"):
    37	            out[c][v] = {m: {r: base[r] + shift.get((c, v, r), 0.0) + e[m] for r in CB.RULES} for m in M6}
    38	    return out
    39	
    40	
    41	def _tree(tmp: Path, gains: dict, n=40, seeds=None, flags=None, rates=RATES):
    42	    """Writes the registered no-churn records (eval-all/evaluate and report.json doubling) and the churn records."""
    43	    seeds = list(range(1000, 1000 + n)) if seeds is None else seeds
    44	    ea, ch = tmp / "eval-all", tmp / "churn"; report = {"doubling": {}}
    45	    for m in M6:
    46	        for r in CB.RULES:
    47	            rid = f"{m}@rho0.2|{r}|D2+H3|profit"
    48	            _write(ea / "evaluate" / (CB.safe(rid) + ".json"), _rec(gains[0]["base"][m][r], seeds))
    49	            report["doubling"][rid] = {"attack_change": 0.0, "reference_change": 0.0, "incomplete": False, "kind": "x",
    50	                                       "heldout": _rec(gains[0]["doubled"][m][r], seeds)}
    51	            for p in rates:
    52	                cid = f"{rid}|churn{p:g}"; d = ch / f"p{p:g}"
    53	                _write(d / "evaluate" / (CB.safe(cid) + ".json"), _rec(gains[p]["base"][m][r], seeds))
    54	                fl = (flags or {}).get((p, m, r), {"attack_change": 0.0, "reference_change": 0.0, "incomplete": False})
    55	                _write(d / "doubling" / (CB.safe(cid) + ".json"), dict(fl, kind="x", heldout=_rec(gains[p]["doubled"][m][r], seeds)))
    56	    _write(tmp / "report.json", report)
    57	    return ea, ch, tmp / "report.json"
