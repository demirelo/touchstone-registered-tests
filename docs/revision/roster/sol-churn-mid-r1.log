            wanted=dict(zip((\"young_honest_job_share\",\"young_honest_audit_share\",\"established_honest_audit_rate\",\"focal_job_share\",\"focal_audit_rate\"),map(statistics.mean,zip(*rows))))
            actual=j[\"review_r4\"][\"audit_allocation\"][c][f\"{rule}|{version}\"]
