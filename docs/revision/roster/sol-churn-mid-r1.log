    63	def load(eval_all, churn_dir, report_path, markets, n_seeds: int = 200, rates=RATES) -> dict:
    64	    """Per-seed arrays {ver: {cond: {market: {rule: {gain, profit_attack, profit_ref}}}}}, the doubling flags of the churn
