   289	def review_r4(res: dict, data: dict | None, diags: dict) -> dict:
   290	    """Post hoc block after external review round 4 (Fable 5.2): t intervals over the six market means of d and q (5 degrees
   291	    of freedom), pooled efficiency under the selected attack, and the audit allocation per rate. Not part of the plan."""
   292	    t95 = {}
   293	    for v in VERS:
   294	        t95[v] = {}
   295	        for c in res[v]:
   296	            if c == "0" or not isinstance(res[v][c], dict) or "d" not in res[v][c]:
   297	                continue
   298	            t95[v][c] = {}
   299	            for s in ("d", "q"):
   300	                xs = np.array(list(res[v][c][s]["markets"].values()), dtype=float)
   301	                if xs.size == 6:
   302	                    half = T5 * xs.std(ddof=1) / math.sqrt(6)
   303	                    t95[v][c][s] = {"mean": float(xs.mean()), "ci": [float(xs.mean() - half), float(xs.mean() + half)]}
   304	    eff = {}
   305	    if data is not None:
   306	        for v in VERS:
   307	            eff[v] = {}
   308	            for c in data["conds"]:
   309	                eff[v][c] = {}
   310	                for r in RULES:
   311	                    ms = [float(np.mean(data["cells"][v][c][m][r]["eff_attack"])) for m in data["markets"]
   312	                          if r in data["cells"][v][c][m] and "eff_attack" in data["cells"][v][c][m][r]]
   313	                    eff[v][c][r] = float(np.mean(ms)) if len(ms) == len(data["markets"]) else None
   314	    return {"label": "post hoc, after external review round 4; not part of the plan", "t95": t95, "eff_attack": eff,
   315	            "audit_allocation": {c: audit_allocation(d) for c, d in diags.items() if d}}
