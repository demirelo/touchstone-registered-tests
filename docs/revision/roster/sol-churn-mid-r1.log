   407	def _fmt(e, d: int = 3) -> str:
   408	    p = e["pooled"]
   409	    if p["estimate"] is None:
   410	        return "--"
   411	    lo, hi = p["ci95"] or (None, None)
   412	    n = lambda x: f"{x:.{d}f}".replace("-", "$-$")          # a typeset minus, not a hyphen
   413	    return n(p["estimate"]) + ("" if lo is None else f" [{n(lo)}, {n(hi)}]")
   414	
   415	
   416	def table(res: dict) -> str:
   417	    name = {"0": "0 (registered)"}
   418	    lines = ["\\begin{tabular}{llccccc}", "\\toprule",
   419	             "Winner & $p$ & $g$(R3) & $g$(C*) & $g$(B3) & $d$ = C*$-$R3 & $q$ = B3$-$R3 \\\\", "\\midrule"]
   420	    for v in VERS:
   421	        for c in [k for k in res[v] if k in ("0",) or k.replace(".", "", 1).isdigit()]:
   422	            b = res[v][c]
   423	            lines.append(f"{'frozen' if v == 'base' else v} & {name.get(c, c)} & " + " & ".join([_fmt(b["g"][r]) for r in RULES] + [_fmt(b["d"]), _fmt(b["q"])]) + " \\\\")
   424	    lines += ["\\bottomrule", "\\end{tabular}"]
   425	    return "\n".join(lines) + "\n"
   426	
