   432	def main(argv=None) -> int:
   433	    import argparse
   434	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   435	    ap.add_argument("--records", required=True, help="registered eval-all directory (no-churn base records)")
   436	    ap.add_argument("--churn", required=True, help="the pod's followup-churn directory (p0.01, p0.05)")
   437	    ap.add_argument("--report", required=True, help="registered report.json (no-churn doubled records)")
   438	    ap.add_argument("--out", required=True); ap.add_argument("--tables", required=True)
   439	    ap.add_argument("--posthoc", default=None, help="posthoc.json, to check the registered no-churn values")
   440	    ap.add_argument("--n-seeds", dest="n_seeds", type=int, default=200)
   441	    ap.add_argument("--rates", default=",".join(f"{p:g}" for p in RATES), help="draft 6: 0.01,0.05; amendment 1: 0.02,0.03")
   442	    ap.add_argument("--first", default=None, help="churn.json of draft 6 (needed to score expectations 5 to 8)")
   443	    ap.add_argument("--resamples", type=int, default=B); ap.add_argument("--seed", type=int, default=SEED)
   444	    a = ap.parse_args(argv)
   445	    markets = tuple(f"fresh{i}" for i in range(6)); ch = Path(a.churn)
   446	    try:
   447	        rates = tuple(float(x) for x in a.rates.split(","))
   448	    except ValueError:
   449	        ap.error("--rates must be numbers")
   450	    if not rates or len(set(rates)) != len(rates) or not set(rates) <= ALLOWED:
   451	        ap.error("--rates must list distinct rates from 0.01, 0.02, 0.03, 0.05")
   452	    conds = ("0",) + tuple(f"{p:g}" for p in rates)
   453	    data = load(a.records, ch, a.report, markets, a.n_seeds, rates)
   454	    res = analyse(data, a.resamples, a.seed)
   455	    diags = {c: _read(ch / f"p{c}" / "diagnostics.json") for c in conds[1:]}
   456	    for d in diags.values():
   457	        if d is not None:
   458	            validate_diagnostics(d, markets, a.n_seeds, data["seeds"])
   459	    out = {"label": LABEL, "statistics": res, "flags": data["flags"], "flag_summary": flag_summary(data["flags"]),
   460	           "expectations": (expectations(res, diags.get("0.05")) if rates == RATES else
   461	                            expectations_mid(res, diags, json.loads(Path(a.first).read_text())) if a.first and set(rates) == {0.02, 0.03} else {}),
   462	           "review_r4": review_r4(res, data, diags),
   463	           "diagnostics": {c: (diag_summary(d) if d else None) for c, d in diags.items()},
   464	           "inputs": {"records": str(a.records), "churn": str(ch), "report_sha256": _sha(Path(a.report)),
   465	                      "run_json_sha256": _sha(ch / "run.json"),
   466	                      **{f"inventory_p{c}_sha256": _sha(ch / f"p{c}" / "inventory.json") for c in conds[1:]},
   467	                      **{f"diagnostics_p{c}_sha256": _sha(ch / f"p{c}" / "diagnostics.json") for c in conds[1:]}}}
   468	    if a.first:
   469	        out["inputs"]["first_sha256"] = _sha(Path(a.first))
   470	    if a.posthoc:
   471	        out["registered_check"] = registered_check(res, json.loads(Path(a.posthoc).read_text())["doubled"]["D2+H3"])
   472	        out["inputs"]["posthoc_sha256"] = _sha(Path(a.posthoc))
   473	    Path(a.out).write_text(json.dumps(out, indent=1) + "\n")
   474	    d = Path(a.tables); d.mkdir(parents=True, exist_ok=True)
   475	    name = "posthoc_churn.tex" if rates == RATES else "posthoc_churn_mid.tex"
   476	    (d / name).write_text(table(res).replace("C*", "C$^*$"))
   477	    return 0
