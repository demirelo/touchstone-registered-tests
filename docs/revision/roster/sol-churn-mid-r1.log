   510	    ap.add_argument("--workers-search", dest="workers_search", type=int, default=16); ap.add_argument("--workers-eval", dest="workers_eval", type=int, default=9)
   511	    ap.add_argument("--started", type=float, default=None, help="epoch seconds of pod allocation; spend is billed from it")
   512	    ap.add_argument("--stop-usd", dest="stop_usd", type=float, default=STOP_USD)
   513	    ap.add_argument("--usd-per-hour", dest="usd_per_hour", type=float, default=None, help="the pod's actual hourly price (required in production)")
   514	    ap.add_argument("--prior-usd", dest="prior_usd", type=float, default=0.0, help="charges of earlier failed attempts of this arm")
   515	    ap.add_argument("--gate", choices=("first", "only", "skip"), default="first", help="the p = 0 reproduction gate (plan section 3 c)")
   516	    ap.add_argument("--require-identical", dest="req_id", action="store_true", help="the pod gate: bit identity (the author's decision)")
   517	    ap.add_argument("--smoke", action="store_true")
   518	    a = ap.parse_args(argv); base = Path(a.out); F.check_out(base, a.src)
   519	    if not a.smoke:
   520	        check_started(a.started)
   521	        if a.usd_per_hour is None or not a.usd_per_hour > 0:
   522	            raise SystemExit("churn arm refused: --usd-per-hour must be the pod's actual hourly price")
   523	        if a.gate == "skip":
   524	            raise SystemExit("churn arm refused: production runs cannot skip the gate")
   525	        if a.stage != "all":
   526	            require_gate(base, a.req_id)
   527	        base.mkdir(parents=True, exist_ok=True)
   528	        write(base / "run.json", {"started": a.started, "usd_per_hour": a.usd_per_hour, "prior_usd": a.prior_usd, "stop_usd": a.stop_usd})
   529	    if a.usd_per_hour is None:
   530	        a.usd_per_hour = POD_USD_PER_HOUR
   531	    from sim.records import cfg_from_dict
   532	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   533	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   534	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   535	    params = json.loads(Path(a.params).read_text())
   536	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if a.stage == "all" else (a.stage,)
   537	    install()
   538	    if a.gate != "skip" and a.stage == "all":
   539	        out = base / "gate-p0"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   540	        jobs = build_jobs(root, cfgs, params, salt_sha, 0.0, (GATE_CELL[0],), (GATE_CELL[1],), a.smoke)
   541	        _run_rate(out, jobs, ("inputs", "search", "freeze", "evaluate", "doubling", "inventory"), a, salt_sha, container, 0.0, a.started)
   542	        rid = R.cell_id(f"{GATE_CELL[0]}@rho0.2", GATE_CELL[1], "D2+H3", "profit")
   543	        g = gate_compare(a.src, out, rid, jobs[0]["id"], a.req_id); inventory(out, 0.0)
   544	        print(json.dumps({"gate_ok": g["gate_ok"], "identical": g["identical"], "search": g["search"].get("problems"), "doubling": g["doubling"].get("problems")}), flush=True)
   545	        if not g["gate_ok"] and not a.smoke:
   546	            print("churn arm stopped: the p = 0 gate failed", file=sys.stderr)
   547	            return 1
   548	        if a.gate == "only":
   549	            return 0 if g["gate_ok"] else 1
   550	    if not a.smoke:
   551	        require_gate(base, a.req_id)
   552	    for p in (float(x) for x in a.rates.split(",")):
   553	        out = base / f"p{p:g}"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   554	        jobs = build_jobs(root, cfgs, params, salt_sha, p, tuple(a.markets.split(",")), tuple(a.rules.split(",")), a.smoke)
   555	        _run_rate(out, jobs, steps, a, salt_sha, container, p, a.started)
   556	    return 0
