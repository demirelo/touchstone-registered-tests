    64	def test_point_estimates_contrasts_and_changes(tmp_path):
    65	    g = _gains(shift={(0.05, "base", "F111"): 0.02, (0.05, "doubled", "F111"): 0.03})
    66	    data = CB.load(*_tree(tmp_path, g), markets=M6, n_seeds=40)
    67	    s = CB.statistics(data)
    68	    assert s["base"]["0"]["g"]["F111"]["pooled"] == pytest.approx(0.06)
    69	    assert s["base"]["0.05"]["g"]["F111"]["pooled"] == pytest.approx(0.08)
    70	    assert s["base"]["0.05"]["d"]["pooled"] == pytest.approx(0.0)              # C* - R3 = 0.08 - 0.08
    71	    assert s["base"]["0.05"]["q"]["pooled"] == pytest.approx(0.15)             # B3 - R3 = 0.23 - 0.08
    72	    assert s["base"]["0.05"]["change"]["d"]["pooled"] == pytest.approx(-0.02)
    73	    assert s["doubled"]["0.05"]["change"]["g"]["F111"]["pooled"] == pytest.approx(0.03)
    74	    assert s["base"]["0.01"]["change"]["q"]["pooled"] == pytest.approx(0.0)
