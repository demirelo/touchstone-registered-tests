   202	def test_expectation_4_reads_the_first_bin_at_p005(tmp_path):
   203	    r = CB.analyse(CB.load(*_tree(tmp_path, _gains()), markets=M6, n_seeds=40), b=99, seed=1)
   204	    hi = {("F111", w): 0.9 for w in ("base", "doubled")} | {(x, w): 0.3 for x in ("C*", "F000") for w in ("base", "doubled")}
   205	    assert CB.expectations(r, diagnostics=_diag(hi))["4"]["verdict"] == "met"
   206	    one = dict(hi); one[("F000", "doubled")] = 0.95                        # R3 not above B3 for the doubled winner
   207	    assert CB.expectations(r, diagnostics=_diag(one))["4"]["verdict"] == "not established"
   208	    low = {k: (0.1 if k[0] == "F111" else 0.5) for k in hi}
   209	    assert CB.expectations(r, diagnostics=_diag(low))["4"]["verdict"] == "failed"
   210	    na = dict(hi); na[("C*", "base")] = None
   211	    assert CB.expectations(r, diagnostics=_diag(na))["4"]["verdict"] == "unavailable"
   212	    assert CB.expectations(r, diagnostics=None)["4"]["verdict"] == "unavailable"
