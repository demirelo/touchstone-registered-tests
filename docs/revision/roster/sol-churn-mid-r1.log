    54	        out[k] = a
    55	    if "eff_attack" in src:                # round-4 review block: efficiency under the selected attack
    56	        e = np.asarray(src["eff_attack"], dtype=float)
    57	        if e.ndim != 1 or e.size != n_seeds or not np.all(np.isfinite(e)):
    58	            raise ValueError(f"{what}: eff_attack is not {n_seeds} finite values")
