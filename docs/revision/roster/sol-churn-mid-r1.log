   215	def _full_diag(n=4, share_r3=0.6, markets=M6, seeds=None):
   216	    """Consistent driver-shaped diagnostics: per-episode [served, audited] counts, bin totals, and the market-pooled shares."""
   217	    cells, pooled = {}, {}
   218	    for r in CB.RULES:
   219	        for w in ("base", "doubled"):
   220	            bins_by_m = {}
   221	            for i, m in enumerate(markets):
   222	                au = {"F111": round(10 * share_r3), "C*": 4, "F000": 2}[r] + (i % 2)
   223	                per = [{c: [[10, au], [5, 1], [0, 0], [3, 0]] for c in ("honest_replacement", "honest_initial", "focal")} for _ in range(n)]
   224	                sh = {}
   225	                for c in ("honest_replacement", "honest_initial", "focal"):
   226	                    rows = []
   227	                    for b in range(4):
   228	                        sv = sum(e[c][b][0] for e in per); a = sum(e[c][b][1] for e in per)
   229	                        rows.append({"age": list(CB.AGE_BINS[b]), "served": sv, "audited": a, "share": (a / sv if sv else None)})
   230	                    sh[c] = rows
   231	                sh.update(per_episode=per, honest_replacements_per_episode=18.0, focal_newest_by_creation=[0.5] * n,
   232	                          focal_newest_by_first_offer_assigned=[0.25] * n)
   233	                cells.setdefault(f"{m}@rho0.2|{r}", {})[w] = {"seeds": list(range(n)) if seeds is None else list(seeds), "shares": sh,
   234	                                                             "knobs": {"x": i % 2}}
   235	                bins_by_m[m] = sh
   236	            pooled[f"{r}|{w}"] = {}
   237	            for c in ("honest_replacement", "honest_initial", "focal"):
   238	                res = []
   239	                for b in range(4):
   240	                    v = [bins_by_m[m][c][b]["share"] for m in markets if bins_by_m[m][c][b]["share"] is not None]
   241	                    res.append({"share": (sum(v) / len(v) if v else None), "markets": len(v)})
   242	                pooled[f"{r}|{w}"][c] = res
   243	    return {"cells": cells, "pooled": pooled}
   244	
