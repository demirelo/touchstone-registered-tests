   396	def test_expectations_5_to_8(tmp_path):
   397	    r1 = CB.analyse(CB.load(*_tree(tmp_path / "a", _gains(shift={(0.05, v, "F111"): 0.2 for v in ("base", "doubled")})),
   398	                            markets=M6, n_seeds=40), b=99, seed=1)                         # g_0.05(R3) = 0.26
   399	    g = _gains(rates=MID, shift={(0.03, v, "F111"): 0.01 for v in ("base", "doubled")})   # d_0.03 < d_0.02
   400	    rm = CB.analyse(CB.load(*_tree(tmp_path / "b", g, rates=MID), markets=M6, n_seeds=40, rates=MID), b=99, seed=1)
   401	    e = CB.expectations_mid(rm, _mid_diag(0.8, 0.7), _first(r1))
   402	    assert [e[k]["verdict"] for k in ("5", "6", "7", "8")] == ["met", "met", "met", "met"]
   403	    assert CB.expectations_mid(rm, _mid_diag(0.7, 0.8), _first(r1))["5"]["verdict"] == "failed"     # not lower at 0.03
   404	    assert CB.expectations_mid(rm, _mid_diag(0.9, 0.7), _first(r1))["5"]["verdict"] == "failed"     # above the 0.01 value
   405	    g2 = _gains(rates=MID, shift={(0.02, "base", "F111"): 0.2})                                     # frozen g_0.02 = 0.26 > midpoint 0.16
   406	    rm2 = CB.analyse(CB.load(*_tree(tmp_path / "c", g2, rates=MID), markets=M6, n_seeds=40, rates=MID), b=99, seed=1)
