    diag=json.loads((root/f\"p{c}\"/\"diagnostics.json\").read_text())
    for rule in (\"F111\",\"C*\",\"F000\"):
        for version in (\"base\",\"doubled\"):
            rows=[]
            for market in [f\"fresh{i}\" for i in range(6)]:
                per=diag[\"cells\"][f\"{market}@rho0.2|{rule}\"][version][\"shares\"][\"per_episode\"]
                served=audited=ys=ya=es=ea=fs=fa=0
                for ep in per:
                    for cat, bins in ep.items():
                        for age,(s,a) in enumerate(bins):
                            served+=s; audited+=a
                            if cat==\"focal\": fs+=s; fa+=a
                            elif age==0: ys+=s; ya+=a
                            else: es+=s; ea+=a
