    90	def test_bootstrap_is_paired_across_rules_rates_versions_and_no_churn(tmp_path):
    91	    g = _gains(noise=0.05, seed=3, shift={(0.05, "base", "C*"): 0.01})
    92	    r = CB.analyse(CB.load(*_tree(tmp_path, g), markets=M6, n_seeds=40), b=499, seed=2)
    93	    lo, hi = r["base"]["0.05"]["d"]["pooled"]["ci95"]            # shared noise cancels in a paired contrast
    94	    assert hi - lo == pytest.approx(0.0, abs=1e-12)
    95	    lo, hi = r["base"]["0.05"]["change"]["g"]["F111"]["pooled"]["ci95"]   # and in the change from no churn
    96	    assert hi - lo == pytest.approx(0.0, abs=1e-12)
    97	    lo, hi = r["base"]["0.05"]["g"]["F111"]["pooled"]["ci95"]    # a level keeps its seed noise
    98	    assert hi - lo > 0.005
