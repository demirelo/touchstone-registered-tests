   193	def _diag(sh):
   194	    """Driver-shaped pooled diagnostics: sh[(rule, winner)] is the first-bin honest-replacement share."""
   195	    pooled = {}
   196	    for (rule, w), v in sh.items():
   197	        bins = [{"share": v, "markets": 6 if v is not None else 0}] + [{"share": 0.1, "markets": 6}] * 3
   198	        pooled[f"{rule}|{w}"] = {"honest_replacement": bins, "honest_initial": bins, "focal": bins}
   199	    return {"cells": {}, "pooled": pooled}
