   273	                audits = sum(t[c][b][1] for c in CATS for b in range(len(AGE_BINS)))
   274	                yh = [t["honest_replacement"][0][j] + t["honest_initial"][0][j] for j in (0, 1)]
   275	                eh = [sum(t[c][b][j] for c in ("honest_replacement", "honest_initial") for b in range(1, len(AGE_BINS))) for j in (0, 1)]
   276	                fo = [sum(t["focal"][b][j] for b in range(len(AGE_BINS))) for j in (0, 1)]
   277	                div = lambda a, b: a / b if b else None
   278	                rows.append({"young_honest_job_share": div(yh[0], served), "young_honest_audit_share": div(yh[1], audits),
   279	                             "established_honest_audit_rate": div(eh[1], eh[0]), "focal_job_share": div(fo[0], served),
   280	                             "focal_audit_rate": div(fo[1], fo[0])})
   281	                xs[m] = (cell[w].get("knobs") or {}).get("x")
   282	            mean = lambda k: (float(np.mean([x[k] for x in rows if x[k] is not None])) if any(x[k] is not None for x in rows) else None)
   283	            out[f"{r}|{w}"] = {k: mean(k) for k in ("young_honest_job_share", "young_honest_audit_share",
   284	                                                     "established_honest_audit_rate", "focal_job_share", "focal_audit_rate")}
   285	            out[f"{r}|{w}"].update(markets=len(rows), x_by_market=xs)
   286	    return out
