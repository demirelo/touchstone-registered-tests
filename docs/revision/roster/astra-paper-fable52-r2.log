    from scipy import stats
    res = {}
    for fam, v in dbl.items():
        out = {}
        for k in ("frozen", "doubled"):
            x = np.array([row[f"q1_{k}"] for row in v["markets"].values()]); n = len(x)
            h = float(stats.t.ppf(0.975, n - 1) * x.std(ddof=1) / np.sqrt(n))
            out[k] = {"mean": float(x.mean()), "t95": [float(x.mean()) - h, float(x.mean()) + h], "positive": int((x > 0).sum()), "n": n}
        out["relative"] = v["absolute"]["C*"]["mean_gain"] / v["absolute"]["F111"]["mean_gain"] - 1
        res[fam] = out
    return res


def x7_embedding(out, markets) -> dict:
    """Fable 5.2 review: Q1 cells where the X7-SC search winner is the embedded D2+H3 winner (design 5.2 incumbent) and its
    evaluated gains equal the D2+H3 cell's, so the second Q1 family adds no evidence there."""
    same, differs, n = 0, [], 0
    for m in markets:
        for rule in ("C*", "F111"):
            x, d = _rec(out, f"{m}@rho0.2|{rule}|X7-SC|profit"), _rec(out, f"{m}@rho0.2|{rule}|D2+H3|profit")
            if x is None or d is None:
                continue
            n += 1; src = _search_rec(out, f"{m}@rho0.2|{rule}|X7-SC|profit")["attack"].get("best_source", "")
            if src.startswith("incumbent:embedded") and list(x["gain"]) == list(d["gain"]):
                same += 1
            else:
                differs.append(f"{m}@rho0.2|{rule}")
    return {"embedded_identical": same, "cells": n, "differs": differs}


def envelope_difference(report: dict, markets) -> dict:
    """Fable 5.2 review: C* minus R3 with each rule's training-selected strongest family (report q3.envelope); descriptive."""
    e = report["q3"]["envelope"]; rows = {}
    for m in markets:
        if m in e.get("C*", {}) and m in e.get("F111", {}):
            rows[m] = {"difference": e["C*"][m]["estimate"] - e["F111"][m]["estimate"], "family_cstar": e["C*"][m]["family"], "family_r3": e["F111"][m]["family"]}
    return {"markets": rows, "pooled": float(np.mean([v["difference"] for v in rows.values()]))}


def doubling_flags(report: dict) -> dict:
    d = report["doubling"]
    return {"flagged": sum(1 for v in d.values() if v.get("incomplete")), "checks": len(d)}


def q4_diagnostics(out) -> dict:
    res = {}
    for m in FRESH:
        sp = split(out, [m], "F000", "F111", "D2+H3")["markets"].get(m)
        r = _rec(out, f"{m}@rho0.2|F111|D2+H3|profit")
        if sp is None or r is None:
            continue
        res[m] = {**sp, "audit_spend": float(np.mean(r["audit_spend_attack"])), "served_share": float(np.mean(r["served_share_attack"])),
                  "efficiency": float(np.mean(r["eff_attack"]))}
    return res


def stability(report: dict, stab: dict) -> dict:
    q1 = {k: {"estimate_report": report["q1"]["tests"][k]["estimate"], "estimate_registered_cfg": v["estimate"],
              "category_report": report["q1"]["tests"][k]["category"], "category_registered_cfg": v["category"]}
          for k, v in stab["q1_new"].items()}
    shifts = [abs(c["mean_new"] - c["mean_old"]) for c in stab["cells"].values()]
    return {"q1": q1, "q4_k_report": report["q4"]["k"], "q4_k_registered_cfg": stab["q4_new"]["k"],
            "cells": len(shifts), "max_mean_shift": float(max(shifts)), "decisions_unchanged": bool(stab["decisions_unchanged"])}


def _f(x, d: int = 3):
    return "n/a" if x is None else (f"\\ensuremath{{{x:.{d}f}}}" if x < 0 else f"{x:.{d}f}")


def label3(x) -> str:
    """A positive or negative value at three significant digits as plain text (for sites in the paper's prose)."""
    if x is None:
        return "n/a"
    if x == 0:
        return "0"
    d = max(0, 2 - int(np.floor(np.log10(abs(x))))); return f"{x:.{d}f}"


def _s3(x) -> str:
    """Three significant digits in fixed notation, so a small gain or bound never prints as 0.000."""
    if x is None:
        return "n/a"
    if x == 0:
        return "0"
    d = max(0, 2 - int(np.floor(np.log10(abs(x))))); t = f"{x:.{d}f}"
    return f"\\ensuremath{{{t}}}" if x < 0 else t


def tables(res: dict) -> dict:
    t = {}
    rows = [f"{fam} & {_f(v['pooled']['estimate'])} & {_f(v['pooled']['attacked'])} & {_f(v['pooled']['reference'])} \\\\"
            for fam, v in res["q1_split"].items()]
    t["q1_split"] = ("\\begin{tabular}{@{}lrrr@{}}\\toprule\nFamily & $d$ & Attacked term & Reference term \\\\\\midrule\n"
                     + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = []
    for r, v in res["welfare"].items():
        mixes = v.get("mixtures", {})
        if any(m["weight"] >= 1.0 for m in mixes.values()):
            mx = next(m for m in mixes.values() if m["weight"] >= 1.0)
            rows.append(f"{r} & {_f(v['w1']['efficiency'])} & {_f(v['w0']['efficiency'])} & none (W0 estimated gain positive) & 1 & {_s3(mx['estimate'])} & "
                        f"{_s3(mx.get('lower'))} & {_s3(mx.get('train_mix'))} & {_f(mx['efficiency'], 4)} \\\\"); continue
        for fam in ("H4", "D2+H3"):
            mx = mixes.get(fam)
            if mx and mx["weight"] > 0:
                rows.append(f"{r} & {_f(v['w1']['efficiency'])} & {_f(v['w0']['efficiency'])} & {fam} & {mx['weight']:.4f} & {_s3(mx['estimate'])} & "
                            f"{_s3(mx.get('lower'))} & {_s3(mx.get('train_mix'))} & {_f(mx['efficiency'], 4)} \\\\")
                fm = mx.get("train_feasible_mixture") or {}
                if fm.get("weight"):
                    rows.append(f"{r} & {_f(v['w1']['efficiency'])} & {_f(v['w0']['efficiency'])} & {fam}, training-feasible & {fm['weight']:.4f} & "
                                f"{_s3(fm['estimate'])} & {_s3(fm['lower'])} & {_s3(fm['train_mix'])} & {_f(fm['efficiency'], 4)} \\\\")
    t["welfare_mix"] = ("\\begin{tabular}{@{}lrrlrrrrr@{}}\\toprule\nRule & W1 eff. & W0 eff. & Mixed with & W0 weight & Est.\\ gain & Unadj.\\ lower & Train gain & Mixed eff. \\\\\\midrule\n"
                        + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = []
    for r in ("F111", "C*"):
        for fam in ("H4", "D2+H3"):
            mx = res["welfare"].get(r, {}).get("mixtures", {}).get(fam)
            if mx and "sensitivity" in mx:
                rows.append(f"{r} & {fam} & " + " & ".join(f"{_s3(x['estimate'])} / {_f(x['efficiency'])}" for x in mx["sensitivity"]) + " \\\\")
    t["welfare_sens"] = ("\\begin{tabular}{@{}ll" + "r" * len(SENS_WEIGHTS) + "@{}}\\toprule\nRule & Mixed with & "
                         + " & ".join(f"$w={w:.1f}$" for w in SENS_WEIGHTS) + " \\\\\\midrule\n" + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = [f"{m} & {_f(v['estimate'])} & {_f(v['attacked'])} & {_f(v['reference'])} & {_f(v['audit_spend'])} & {_f(v['served_share'])} \\\\"
            for m, v in res["q4_diag"].items()]
    t["q4_diag"] = ("\\begin{tabular}{@{}lrrrrr@{}}\\toprule\nMarket & B3$-$R3 gain & Attacked term & Reference term & R3 audit spend & R3 service fraction \\\\\\midrule\n"
                    + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = [f"{k} & {_f(v['estimate_report'], 4)} & {_f(v['estimate_registered_cfg'], 4)} & {v['category_registered_cfg']} \\\\" for k, v in res["stability"]["q1"].items()]
    t["stability"] = ("\\begin{tabular}{@{}lrrl@{}}\\toprule\nQ1 test & $d$, report & $d$, registered configs & Category, registered configs \\\\\\midrule\n"
                      + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    if "doubled" in res:
        sg = lambda x: f"${x:.3f}$".replace("$-", "$-") if x is not None else "--"
        rows = []
        for m in res["doubled"]["D2+H3"]["markets"]:
            a, b = res["doubled"]["D2+H3"]["markets"][m], res["doubled"].get("X7-SC", {}).get("markets", {}).get(m, {})
            rows.append(f"{m} & {sg(a['q1_frozen'])} & {sg(a['q1_doubled'])} & {sg(b.get('q1_frozen'))} & {sg(b.get('q1_doubled'))} & "
                        f"{sg(a.get('q4_frozen'))} & {sg(a.get('q4_doubled'))} \\\\")
        t["doubled"] = ("\\begin{tabular}{@{}lrrrrrr@{}}\\toprule\n & \\multicolumn{2}{c}{C*$-$R3, D2+H3} & \\multicolumn{2}{c}{C*$-$R3, X7-SC} & \\multicolumn{2}{c}{B3$-$R3, D2+H3} \\\\\n"
                        "Market & Frozen & Doubled & Frozen & Doubled & Frozen & Doubled \\\\\\midrule\n" + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    if "honest" in res:
        rows = []
        for r in ("F000", "F111", "C*"):
            v = res["honest"][r]; b = v["bins"]
            rows.append(f"{ {"F000": "B3 (F000)", "F111": "R3 (F111)"}.get(r, r)} & " + " & ".join(f"{x["audited_share"]:.3f}" for x in b[:3]) + f" & {v['mean_profit_per_round'] * 1e4:.2f} & {v['mean_false_refund'] * 1e5:.2f} \\\\")
        t["honest"] = ("\\begin{tabular}{@{}lrrrrr@{}}\\toprule\n & \\multicolumn{3}{c}{Audited share, by age} & Profit per round & False refunds \\\\\n"
                       "Rule & 0--10 & 10--20 & 20--30 & ($\\times 10^{-4}$) & ($\\times 10^{-5}$) \\\\\\midrule\n" + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    return t


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    for k in ("--records", "--report", "--stability", "--out", "--tables"):
        ap.add_argument(k, required=True)
    a = ap.parse_args(argv)
    out = Path(a.records); report = json.loads(Path(a.report).read_text()); stab = json.loads(Path(a.stability).read_text())
    res = {"label": "exploratory, after the report; not registered",
           "q1_split": {f: split(out, FRESH, "C*", "F111", f) for f in ("D2+H3", "X7-SC")},
           "welfare": {r: welfare_mixtures(out, r) for r in ("F000", "F111", "C*")},
           "q4_diag": q4_diagnostics(out), "stability": stability(report, stab),
           "doubled": doubled(out, report, FRESH), "honest": honest(report)}
    res["market_level"] = market_level(res["doubled"]); res["x7_embedding"] = x7_embedding(out, FRESH)
    res["envelope"] = envelope_difference(report, FRESH); res["doubling_flags"] = doubling_flags(report)
    Path(a.out).write_text(json.dumps(res, indent=1) + "\n")
    import csv
    seeds = [row for r in ("F000", "F111", "C*") for row in seed_rows(out, r)]
    with open(Path(a.out).with_name("lottery_seeds.csv"), "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=list(seeds[0])); w.writeheader(); w.writerows(seeds)
    train = [row for r in ("F000", "F111", "C*") for row in train_rows(out, r)]
    with open(Path(a.out).with_name("lottery_train.csv"), "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=list(train[0])); w.writeheader(); w.writerows(train)
    d = Path(a.tables); d.mkdir(parents=True, exist_ok=True)
    for k, v in tables(res).items():
        (d / f"posthoc_{k}.tex").write_text(v.replace("C*", "C$^*$"))
    print(json.dumps({r: v.get("best") for r, v in res["welfare"].items()}, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""Tests for posthoc_v2.py (exploratory analyses after the report; external review round 4): the Q1 split into attacked and
reference terms, the episode-mixture welfare frontier, and the per-market Q4 diagnostics."""
import json
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import posthoc_v2 as P  # noqa: E402


def _rec(out, rid, **f):
    p = out / "evaluate" / (P.safe(rid) + ".json"); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(json.dumps(f))


def test_split_terms_add_up_to_the_gain_difference(tmp_path):
    s = [10.0, 10.0]
    _rec(tmp_path, "m0@rho0.2|C*|D2+H3|profit", profit_attack=[3.0, 5.0], profit_ref=[1.0, 1.0], sstar=s)
    _rec(tmp_path, "m0@rho0.2|F111|D2+H3|profit", profit_attack=[2.0, 2.0], profit_ref=[0.5, 0.5], sstar=s)
    got = P.split(tmp_path, ["m0"], "C*", "F111", "D2+H3", n=10)
    # g_C = (2, 4), g_F = (1.5, 1.5): d mean = 1.5; attacked term = (1, 3) mean 2; reference term = -(0.5, 0.5) mean -0.5
    assert got["pooled"]["estimate"] == pytest.approx(1.5)
    assert got["pooled"]["attacked"] == pytest.approx(2.0) and got["pooled"]["reference"] == pytest.approx(-0.5)


def test_mixture_weight_is_the_largest_with_a_nonnegative_lower_bound():
    rng = np.random.default_rng(0)
    gw0, gp = -0.1 + 0.001 * rng.standard_normal(200), 0.06 + 0.001 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    m = P.mixture(gw0, ew0, gp, ep)
    assert 0.0 < m["weight"] < 0.375                          # 0.375 is where the mean gain reaches zero
    g = m["weight"] * gw0 + (1 - m["weight"]) * gp
    assert g.mean() - 1.645 * g.std(ddof=1) / np.sqrt(len(g)) >= 0
    assert m["efficiency"] == pytest.approx(m["weight"] * 0.84 + (1 - m["weight"]) * 1.0)


def test_no_mixture_when_the_profitable_policy_is_not_profitable():
    z = np.zeros(200)
    assert P.mixture(z - 0.1, z + 0.84, z - 0.01, z + 1.0)["weight"] == 0.0


def test_weight_label_and_stability_table_keep_the_needed_precision():
    assert P.weight_label(0.4195) == "41.95 percent"            # a rounded 0.42 flips the sign of the lower bound
    res = {"q1_split": {}, "welfare": {}, "q4_diag": {},
           "stability": {"q1": {"C*-F111|D2+H3": {"estimate_report": 0.020720, "estimate_registered_cfg": 0.020917, "category_registered_cfg": "eq"}}}}
    assert "0.0207" in P.tables(res)["stability"] and "0.0209" in P.tables(res)["stability"]


def test_sensitivity_is_linear_in_the_weight_with_its_own_bound():
    rng = np.random.default_rng(2)
    gw0, gp = -0.1 + 0.01 * rng.standard_normal(200), 0.06 + 0.01 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    rows = P.sensitivity(gw0, ew0, gp, ep, (0.0, 0.25, 0.5))
    assert [r["weight"] for r in rows] == [0.0, 0.25, 0.5]
    g = 0.25 * gw0 + 0.75 * gp
    assert rows[1]["estimate"] == pytest.approx(g.mean()) and rows[1]["efficiency"] == pytest.approx(0.25 * 0.84 + 0.75)
    assert rows[1]["lower"] == pytest.approx(g.mean() - 1.645 * g.std(ddof=1) / np.sqrt(200))


def test_welfare_table_prints_small_gains_with_their_bound_and_every_companion():
    res = {"q1_split": {}, "q4_diag": {}, "stability": {"q1": {}},
           "welfare": {"F111": {"w1": {"efficiency": 0.997}, "w0": {"efficiency": 0.840},
                                "mixtures": {"H4": {"weight": 0.4195, "weight_label": "41.95 percent", "estimate": 0.000374263, "lower": 0.0000279, "efficiency": 0.931956},
                                             "D2+H3": {"weight": 0.339, "weight_label": "33.90 percent", "estimate": 0.000252853, "lower": 0.0000101, "efficiency": 0.944510,
                                                       "train_mix": -0.00057978}}}}}
    t = P.tables(res)["welfare_mix"]
    assert "\\ensuremath{-0.000580}" in t and "Train gain" in t
    assert "0.000374" in t and "0.0000279" in t and "0.000253" in t and "D2+H3" in t and "H4" in t


def test_a_profitable_w0_attack_is_one_row_without_a_companion():
    mx = {"weight": 1.0, "weight_label": "100.00 percent", "estimate": 0.254, "lower": 0.253, "efficiency": 0.8387, "train_mix": 0.2}
    res = {"q1_split": {}, "q4_diag": {}, "stability": {"q1": {}},
           "welfare": {"F000": {"w1": {"efficiency": 0.839}, "w0": {"efficiency": 0.839}, "mixtures": {"H4": mx, "D2+H3": dict(mx)}}}}
    t = P.tables(res)["welfare_mix"]
    assert t.count("F000 &") == 1 and "none (W0 estimated gain positive)" in t


def test_mixture_labels_keep_three_significant_digits():
    assert P.label3(0.000374263) == "0.000374" and P.label3(0.0000279) == "0.0000279" and P.label3(None) == "n/a"


def _search(out, rid, **rec):
    p = out / "search" / (P.safe(rid) + ".json"); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(json.dumps(rec))


def test_training_gain_reads_the_archive_entry_of_the_evaluated_policy(tmp_path):
    ref = [0.05, 0.06]
    p = tmp_path / "reference" / "headline@rho0.2" / "F111.json"; p.parent.mkdir(parents=True); p.write_text(json.dumps({"per_seed_normalized": ref}))
    _search(tmp_path, "headline@rho0.2|F111|D2+H3|W0", selected={"a": 1},
            welfare={"archive": [{"knobs": {"a": 0}, "per_seed_normalized": [9, 9]}, {"knobs": {"a": 1}, "per_seed_normalized": [0.0, 0.0]}]})
    _search(tmp_path, "headline@rho0.2|F111|H4|profit", attack={"best_knobs": {"b": 2}, "best_f": 99.0,
            "archive": [{"knobs": {"b": 2}, "per_seed_normalized": [0.15, 0.16]}]})
    assert P.train_gain_w0(tmp_path, "F111") == pytest.approx(-0.055)            # mean of (0 - 0.05, 0 - 0.06)
    assert P.train_gain_profit(tmp_path, "F111", "H4") == pytest.approx(0.10)       # archive, not best_f
    assert P.train_mix(-0.055, 0.10, 0.4) == pytest.approx(0.4 * -0.055 + 0.6 * 0.10)


def test_training_feasible_weight_meets_both_empirical_checks():
    # external review round 6: the largest grid weight at which the evaluation lower bound and the training mean gain are
    # both non-negative (C* with D2+H3: training break-even 0.47676, so 0.4765 on the 0.0005 grid)
    rng = np.random.default_rng(3)
    gw0, gp = -0.1 + 0.001 * rng.standard_normal(200), 0.11 + 0.001 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    g0_tr, gp_tr = -0.0937682027, 0.0854403021
    m = P.feasible_mixture(gw0, ew0, gp, ep, g0_tr, gp_tr)
    assert m["weight"] == pytest.approx(0.4765)
    assert P.train_mix(g0_tr, gp_tr, m["weight"]) >= 0 > P.train_mix(g0_tr, gp_tr, m["weight"] + 0.0005)
    assert m["train_mix"] == pytest.approx(P.train_mix(g0_tr, gp_tr, 0.4765))
    g = 0.4765 * gw0 + (1 - 0.4765) * gp
    assert m["lower"] == pytest.approx(g.mean() - 1.645 * g.std(ddof=1) / np.sqrt(200)) and m["lower"] >= 0


def test_w0_gain_refuses_a_w1_record_with_another_seed_order(tmp_path):
    ctx = "headline@rho0.2"
    _rec(tmp_path, f"{ctx}|C*|D2+H3|W0", seeds=[1, 2], normalized=[0.1, 0.2], eff=[0.8, 0.8])
    _rec(tmp_path, f"{ctx}|C*|D2+H3|W1", seeds=[2, 1], normalized=[0.3, 0.3], constraint=[0.0, 0.0], eff=[1.0, 1.0])
    with pytest.raises(ValueError, match="seed order"):
        P._w0_gain(tmp_path, "C*")


def test_training_rows_export_seeds_policies_and_reference(tmp_path):
    ctx = "headline@rho0.2"; seeds = [11, 12, 13, 14, 15]
    ref = {"per_seed_normalized": [0.5] * 5, "choice": 1, "candidates": [{"name": "a"}, {"name": "ref-b"}],
           "provenance": {"seeds_train": seeds}}
    p = tmp_path / "reference" / ctx / "Cstar.json"; p.parent.mkdir(parents=True); p.write_text(json.dumps(ref))
    k0, kp = {"x": 0}, {"x": 1}
    for rid, body in ((f"{ctx}|C*|D2+H3|W0", {"selected": k0, "welfare": {"archive": [{"knobs": k0, "per_seed_normalized": [0.4] * 5}]},
                                               "provenance": {"seeds_train": seeds}}),
                      (f"{ctx}|C*|H4|profit", {"attack": {"best_knobs": kp, "archive": [{"knobs": kp, "per_seed_normalized": [0.7] * 5}]},
                                               "provenance": {"seeds_train": seeds}})):
        q = tmp_path / "search" / (P.safe(rid) + ".json"); q.parent.mkdir(parents=True, exist_ok=True); q.write_text(json.dumps(body))
    rows = P.train_rows(tmp_path, "C*", ["H4"])
    assert [r["seed"] for r in rows if r["component"] == "W0"] == seeds
    r = next(r for r in rows if r["component"] == "H4" and r["seed"] == 13)
    assert r["reference"] == "ref-b" and r["normalized"] == pytest.approx(0.7) and r["reference_normalized"] == pytest.approx(0.5)
    assert r["gain"] == pytest.approx(0.2) and json.loads(r["policy_knobs"]) == kp


def test_welfare_table_adds_the_training_feasible_row_beside_the_failed_one():
    fm = {"weight": 0.4765, "estimate": 0.00093096, "lower": 0.00069945, "efficiency": 0.922401, "train_mix": 0.00004745}
    mx = {"weight": 0.48, "estimate": 0.00029715, "lower": 0.0000668, "efficiency": 0.921852, "train_mix": -0.00057978,
          "train_feasible_mixture": fm}
    res = {"q1_split": {}, "q4_diag": {}, "stability": {"q1": {}},
           "welfare": {"C*": {"w1": {"efficiency": 0.997}, "w0": {"efficiency": 0.840}, "mixtures": {"D2+H3": mx}}}}
    t = P.tables(res)["welfare_mix"]
    assert "D2+H3 & 0.4800" in t and "D2+H3, training-feasible & 0.4765" in t       # the failed row stays
    assert "0.0000475" in t and "0.000931" in t and "0.9224" in t


def _report_doubling(cells):
    return {"doubling": {rid: {"heldout": {"gain": g, "seeds": [1, 2]}} for rid, g in cells.items()}}


def test_doubled_winners_pair_the_heldout_gains_against_the_frozen_search(tmp_path):
    # external review round 9: the doubled-search winners, evaluated on the same seeds, beside the frozen searches
    for rule, g in (("C*", [0.10, 0.12]), ("F111", [0.14, 0.16]), ("F000", [0.40, 0.42])):
        _rec(tmp_path, f"m0@rho0.2|{rule}|D2+H3|profit", gain=g, seeds=[1, 2])
    rep = _report_doubling({"m0@rho0.2|C*|D2+H3|profit": [0.20, 0.22], "m0@rho0.2|F111|D2+H3|profit": [0.14, 0.16],
                            "m0@rho0.2|F000|D2+H3|profit": [0.40, 0.42]})
    got = P.doubled(tmp_path, rep, ["m0"], fams=("D2+H3",))
    row = got["D2+H3"]["markets"]["m0"]
    assert row["q1_frozen"] == pytest.approx(-0.04) and row["q1_doubled"] == pytest.approx(0.06)       # C* - F111 changes sign
    assert row["q4_frozen"] == pytest.approx(0.26) and row["q4_doubled"] == pytest.approx(0.26)         # F000 - F111
    assert got["D2+H3"]["pooled"]["q1_doubled"] == pytest.approx(0.06)
    assert got["D2+H3"]["absolute"] == {"C*": {"mean_gain": pytest.approx(0.11)}, "F111": {"mean_gain": pytest.approx(0.15)}}


def test_doubled_refuses_a_heldout_evaluation_on_other_seeds(tmp_path):
    for rule in ("C*", "F111", "F000"):
        _rec(tmp_path, f"m0@rho0.2|{rule}|D2+H3|profit", gain=[0.1, 0.1], seeds=[1, 2])
    rep = _report_doubling({f"m0@rho0.2|{r}|D2+H3|profit": [0.1, 0.1] for r in ("C*", "F111", "F000")})
    rep["doubling"]["m0@rho0.2|C*|D2+H3|profit"]["heldout"]["seeds"] = [3, 4]
    with pytest.raises(ValueError):
        P.doubled(tmp_path, rep, ["m0"], fams=("D2+H3",))


def test_honest_profile_keeps_unrounded_values_and_the_r3_minus_cstar_difference():
    bins = lambda a, p: [{"age": [0, 10], "audited_share": a, "profit_per_round": p, "false_refund": 1e-5},
                         {"age": [10, 20], "audited_share": a / 2, "profit_per_round": p, "false_refund": 1e-5}]
    rep = {"q3": {"diagnostic": {"F111": {"replace_at": 50, "bins": bins(1.0, 0.000280)},
                                 "C*": {"replace_at": 50, "bins": bins(0.4, 0.000286)},
                                 "F000": {"replace_at": 50, "bins": bins(0.25, 0.000287)}}}}
    got = P.honest(rep)
    assert got["F111"]["bins"][0]["audited_share"] == 1.0 and got["F111"]["mean_profit_per_round"] == pytest.approx(0.000280)
    assert got["r3_minus_cstar_profit_per_round"] == pytest.approx(-0.000006)


def test_tables_show_doubled_winners_and_the_honest_profile():
    res = {"q1_split": {}, "welfare": {}, "q4_diag": {}, "stability": {"q1": {}},
           "doubled": {"D2+H3": {"markets": {"fresh3": {"q1_frozen": -0.0382, "q1_doubled": 0.0149, "q4_frozen": 0.2626, "q4_doubled": 0.2600}}},
                       "X7-SC": {"markets": {"fresh3": {"q1_frozen": 0.01, "q1_doubled": 0.01}}}},
           "honest": {r: {"bins": [{"age": [0, 10], "audited_share": a, "profit_per_round": 0.00028, "false_refund": 2e-5}] * 3,
                          "mean_profit_per_round": 0.00028, "mean_false_refund": 2e-5} for r, a in (("F000", 0.25), ("F111", 1.0), ("C*", 0.428))}}
    t = P.tables(res)
    assert "fresh3 & $-0.038$ & $0.015$ & $0.010$ & $0.010$ & $0.263$ & $0.260$" in t["doubled"]
    assert "C* & 0.428" in t["honest"] and "R3 (F111) & 1.000" in t["honest"] and "2.80" in t["honest"] and "2.00" in t["honest"]


# ---- Fable 5.2 review (2026-11-10): market-level variation, the X7-SC embedding, the envelope, the doubling flags ----

def _dbl(vals_frozen, vals_doubled, c=0.09, r=0.06):
    return {"D2+H3": {"markets": {f"fresh{i}": {"q1_frozen": a, "q1_doubled": b} for i, (a, b) in enumerate(zip(vals_frozen, vals_doubled))},
                      "absolute": {"C*": {"mean_gain": c}, "F111": {"mean_gain": r}}}}


def test_market_level_interval_treats_the_six_markets_as_a_sample():
    x = [0.0211, 0.0525, 0.0285, -0.0382, 0.0438, 0.0165]
    got = P.market_level(_dbl(x, x, c=0.0856, r=0.0649))["D2+H3"]
    assert got["frozen"]["mean"] == pytest.approx(0.020700, abs=1e-6) and got["frozen"]["positive"] == 5 and got["frozen"]["n"] == 6
    lo, hi = got["frozen"]["t95"]                                   # values from scipy on the report numbers (2026-11-10 command)
    assert lo == pytest.approx(-0.01279, abs=2e-5) and hi == pytest.approx(0.05419, abs=2e-5)
    assert got["relative"] == pytest.approx(0.0856 / 0.0649 - 1)


def test_x7_embedding_counts_cells_whose_winner_is_the_embedded_d2h3_winner(tmp_path):
    for m, src, gx in (("fresh0", "incumbent:embedded_h3", [0.1, 0.2]), ("fresh1", "restart_2", [0.3, 0.4])):
        for rule in ("C*", "F111"):
            _rec(tmp_path, f"{m}@rho0.2|{rule}|D2+H3|profit", gain=[0.1, 0.2])
            _rec(tmp_path, f"{m}@rho0.2|{rule}|X7-SC|profit", gain=gx)
            p = tmp_path / "search" / (P.safe(f"{m}@rho0.2|{rule}|X7-SC|profit") + ".json"); p.parent.mkdir(parents=True, exist_ok=True)
            p.write_text(json.dumps({"attack": {"best_source": src}}))
    got = P.x7_embedding(tmp_path, ["fresh0", "fresh1"])
    assert got["embedded_identical"] == 2 and got["cells"] == 4 and got["differs"] == ["fresh1@rho0.2|C*", "fresh1@rho0.2|F111"]


def test_envelope_difference_and_flag_count_come_from_the_report():
    rep = {"q3": {"envelope": {"C*": {"fresh0": {"estimate": 0.11, "family": "D2+H3"}, "fresh1": {"estimate": 0.17, "family": "X5-AG/v2"}},
                               "F111": {"fresh0": {"estimate": 0.09, "family": "D2+H3"}, "fresh1": {"estimate": 0.10, "family": "D2+H3"}}}},
           "doubling": {"a": {"incomplete": True}, "b": {"incomplete": False}, "c": {"incomplete": True}}}
    env = P.envelope_difference(rep, ["fresh0", "fresh1"])
    assert env["markets"]["fresh1"] == {"difference": pytest.approx(0.07), "family_cstar": "X5-AG/v2", "family_r3": "D2+H3"}
    assert env["pooled"] == pytest.approx(0.045)
    assert P.doubling_flags(rep) == {"flagged": 2, "checks": 3}

