   117	def attempts_spend(path, usd_per_hour: float, started: float | None = None, now: float | None = None) -> dict:
   118	    """The launcher's attempts file (results/pods/reset_pod.sh: one line per event, `<pod> <epoch> start` or
   119	    `<pod> <epoch> deleted`), validated: finite epochs in nondecreasing order, every deletion after its pod's start, and
   120	    exactly one open attempt (the current pod). A closed attempt is billed at `usd_per_hour` (the price ceiling); the open
   121	    one is the caller's, counted from `started`, which must lie between the open start and `now`."""
   122	    p = Path(path) if path else None
   123	    if p is None or not p.exists():
   124	        _refuse(f"no launcher attempts file at {path}")
   125	    starts, closed, last = {}, 0.0, -math.inf
   126	    for line in p.read_text().splitlines():
   127	        if not line.strip():
   128	            continue
   129	        parts = line.split()
   130	        if len(parts) != 3 or parts[2] not in ("start", "deleted"):
   131	            _refuse(f"unreadable line in the attempts file {p}: {line!r}")
   132	        try:
   133	            t = float(parts[1])
   134	        except ValueError:
   135	            t = math.nan
   136	        if not math.isfinite(t) or t < last:
   137	            _refuse(f"a nonfinite or out-of-order epoch in the attempts file {p}: {line!r}")
   138	        last = t; pod, ev = parts[0], parts[2]
   139	        if ev == "start":
   140	            if pod in starts:
   141	                _refuse(f"two starts of {pod} in the attempts file {p}")
   142	            starts[pod] = t
   143	        else:
   144	            if pod not in starts:
   145	                _refuse(f"a deletion of {pod} without an earlier start in the attempts file {p}")
   146	            closed += (t - starts.pop(pod)) / 3600 * usd_per_hour
   147	    if len(starts) != 1:
   148	        _refuse(f"the attempts file {p} must have exactly one open attempt, the current pod; it has {sorted(starts)}")
   149	    (pod, t_open), = starts.items()
   150	    if started is not None:
   151	        now = time.time() if now is None else now
   152	        if not (t_open <= float(started) <= now):
   153	            _refuse(f"the allocation time {started} is not between the open attempt's start {t_open} and now {now}")
   154	    return {"closed_usd": closed, "open": [pod], "open_start": t_open}
