   248	def _verified_dir(d, stage: str, cell: str, inputs: dict, budget, site: str, src=None) -> dict:
   249	    """A reset-driver evidence directory: the gate record names this stage and cell and passed; the inventory lists every
   250	    required record and every listed hash equals its file; the reset driver is the current one; the inputs equal those
   251	    recomputed from the original records; the search record has the full budget; and, with `src`, the comparison is
   252	    recomputed against the registered records and passes."""
   253	    d = Path(d); g, inv, inp = read(d / "gate.json"), read(d / "inventory.json"), read(d / "inputs.json")
   254	    srch = read(F.R.path_of(d, cell)); drv = sha_file(HERE.parent / "followup" / "reset_followup_v2.py")
   255	    recs = (inv or {}).get("records") or {}; env = (inv or {}).get("environment") or {}
   256	    problems = []
   257	    if g is None or g.get("stage") != stage or g.get("cell") != cell or g.get("pass") is not True:
   258	        problems.append("gate record missing, unrelated, or failed")
   259	    if missing := [r for r in _required_records(d, stage, cell) if r not in recs or not (d / r).exists()]:
   260	        problems.append(f"required records missing or unlisted: {missing}")
   261	    if bad := [r for r, h in recs.items() if not (d / r).exists() or sha_file(d / r) != h]:
   262	        problems.append(f"inventory hashes differ from the files: {bad[:3]}")
   263	    if env.get("driver_sha256") != drv:
   264	        problems.append("made by another reset driver")
   265	    if inp != inputs:
   266	        problems.append("inputs differ from the current original records")
   267	    if srch is None or list((srch.get("provenance") or {}).get("budget") or []) != list(budget):
   268	        problems.append("not the registered full budget")
   269	    if srch is None or srch.get("stage") != "search" or srch.get("id") != cell or (srch.get("provenance") or {}).get("id") != cell:
   270	        problems.append("search record: stage or identity wrong")
   271	    for r, h in (inp or {}).items():                              # every copied input present with its recorded hash
   272	        q = F.R.path_of(d, r)
   273	        if not q.exists() or sha_file(q) != h:
   274	            problems.append(f"copied input {r} missing or changed"); break
   275	    problems += _supporting_problems(d, stage, cell, inp or {}, srch, src)
   276	    rep = None
   277	    if not problems and src is not None:
   278	        rep = F.compare(src, d) if stage == "reproduction gate" else F.compare_doubling(src, d, cell)
   279	        if not rep.get("pass"):
   280	            problems.append(f"the recomputed comparison fails: {rep.get('problems')}")
   281	    if problems:
   282	        _refuse(f"{site} evidence in {d}: {problems}")
   283	    return {"gate": g, "environment": env, "recomputed": rep}
