   294	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   295	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   296	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   297	    expected = expected or {}
   298	    for rid in expected:
   299	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   300	            raise ValueError(f"{rid}: the run's result is missing")
   301	    sub, out = [], {}
   302	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   303	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   304	        for m in markets:
   305	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   306	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   307	                continue
