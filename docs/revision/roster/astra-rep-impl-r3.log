def merge_inputs(needs: list[dict]) -> dict:
    merged = {}
    for n in needs:
        for k, v in n.items():
            if merged.setdefault(k, v) != v:
                _refuse(f"{k}: two cells list different hashes")
    return merged


def worker_cost_args(stop) -> tuple:
    """The arguments a worker uses to rebuild the validated cost stop: the same cap, rate, accounting start (the recorded
    open event), prior spend, STOP file and soft deadline."""
    import time as _t
    return (stop.cap, stop.rate, stop.started, _t.time, stop.prior, str(stop.stop_file) if stop.stop_file else None, stop.soft)


def run_cell(job: dict, out, max_rounds: int = MAX_ROUNDS, src=None, cost: tuple | None = None, round_hours: float = 0.0,
             embedded: dict | None = None, min_rounds: int = 1, reference=None) -> dict:
    from sim.cell import SeedCache
    from sim.locked import load_locked
    from sim.records import search_from_json
    from sim.reference import reference_candidates, select_reference
    from sim.search import Objective, cma_search
    T, L = R.constants(job); fam = R.family_for(job["family"], T, L); cell = R.train_cell(job); st = R.settings(job); cache = SeedCache()
    rec = read(R.path_of(out, job["id"])); prev = search_from_json(rec["attack"]); twin = search_from_json(rec["twin"])
    frozen_ref, rrec, _ = R.reference_of(job, out); prev_ref = float(np.mean(rrec["per_seed_normalized"]))
    cands, _, _ = R.menu(job, out, CUTS, H4_EXCLUDED); order = tuple(load_locked()["reference_order"])
    stopper = G.CostStop(*cost) if cost else None
    emb = R.embed_h3(embedded, T) if embedded is not None else None
    rounds, gate, outcome = [], None, "round cap"
    if stopper and not stopper.allow("round 1", round_hours):           # admission before the cell's first round
        return {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": [],
                "status": "stopped at the cost cap", "passed_round": None, "round1_gate": "not run", "claim": CLAIM, "cost": stopper.report()}
    for k in range(1, max_rounds + 1):
        obj = Objective(cell, fam, cache); obj.archive.update(prev.archive)     # revision_v2.continue_search, with the round's incumbents
        new = cma_search(obj, fam, st, round_seed(k, st.restarts) + st.restarts, incumbents=round_incumbents(k, prev.best_knobs, emb))
        best = new if new.best_f > prev.best_f else replace(new, best_x=prev.best_x, best_knobs=prev.best_knobs, best_f=prev.best_f, best_source=prev.best_source)
        extra = reference_candidates(cell, fam, best, twin, [], order)
        ref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache); ref_f = float(np.mean(ref.per_seed_normalized))
        rounds.append({"round": k, "restarts_total": st.restarts * (k + 1), "cma_seeds": sorted(cma_seeds(k, st.restarts)), "attack_f": float(best.best_f),
                       "attack_change": float(best.best_f - prev.best_f), "reference_f": ref_f, "reference_change": ref_f - prev_ref,
                       "best_knobs": dict(best.best_knobs), "best_source": best.best_source})
        if k == 1 and src is not None:                          # the registered doubling's held-out winner is round 1's search winner
            reg = read(reference) if reference is not None else read(Path(src) / "doubling" / (R._safe(job["id"]) + ".json"))
            h1 = R.gain_fields(R.eval_cell(job), fam, new.best_knobs, frozen_ref, SeedCache())
            r1 = {**rounds[0], "heldout": {"knobs": dict(new.best_knobs), "seeds": list(R.eval_cell(job).seeds), "gain": h1["gain"]}}
            gate = compare_round1(reg, r1) if reg is not None else {"pass": False, "problems": ["no registered doubling record"]}
            gate["heldout_knobs"], gate["heldout_mean"] = dict(new.best_knobs), float(np.mean(h1["gain"]))
        prev, prev_ref = best, ref_f
        outcome = decide(k, rounds[-1], gate, stopper.allow(f"round {k + 1}", round_hours) if stopper else True, max_rounds, min_rounds)
        if outcome != "continue":
            break
    status, passed = final_status(rounds, outcome, min_rounds)
    res = {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": rounds, "status": status,
           "passed_round": passed, "round1_gate": gate if gate is not None else "not compared (smoke)", "claim": CLAIM,
           "frozen_best_f": float(rec["attack"]["best_f"]), "embedded_doubled_d2h3": emb is not None, "min_rounds": min_rounds,
           "cost": stopper.report() if stopper else None}
    if outcome != "round-1 mismatch":
        held = R.gain_fields(R.eval_cell(job), fam, prev.best_knobs, frozen_ref, SeedCache())
        res.update(place_heldout(status, {"knobs": dict(prev.best_knobs), "seeds": list(R.eval_cell(job).seeds), **held}))
    return res


def restart_hours(hs: list) -> dict:
    """Hours a restart needs for cells of these worst-case hours on 1 to 16 workers: longest first onto the least-loaded
    worker, plus 0.1 h shutdown, rounded up to 0.01 h (Sol and Astra, rerun review r1: not a fixed estimate)."""
    import math
    out = {}
    for w in range(1, 17):
        load = [0.0] * w
        for h in sorted(hs, reverse=True):
            load[load.index(min(load))] += h
        out[str(w)] = math.ceil((max(load) + 0.1) * 100 - 1e-6) / 100
    return out


def _run_and_save(fn, x: tuple, dest, extra: dict) -> None:
    """In the worker: run one cell and write its record (atomic) before anything goes back to the parent, so a sibling's
    death cannot discard a finished result in transit (Sol and Astra, rerun review r1)."""
    write(dest, {**fn(*x), **extra})


def run_cells(fn, todo: list, args: list, workers: int, dests: list, extras: list) -> tuple:
    """Run the cells, each in a worker process (also with one worker: a kill must not take the driver), and let each worker
    save its own record the moment the cell ends. Run B lost all 17 cells to one killed worker because results were written
    only after every cell ended. A lost worker breaks the pool (at submission or later); every cell with no record on disk
    is lost, and saved cells are skipped on restart (guards.reusable). An ordinary exception in a cell is not a lost
    worker: it is returned with its message and never restarted (Sol and Astra, rerun review r2). Returns (lost, failed)."""
    from concurrent.futures import ProcessPoolExecutor, wait
    from concurrent.futures.process import BrokenProcessPool
    with ProcessPoolExecutor(max_workers=max(1, workers)) as ex:
        futs = []
        try:
            for x, d, e in zip(args, dests, extras):
                futs.append(ex.submit(_run_and_save, fn, x, d, e))
        except BrokenProcessPool:
            pass
        wait(futs)                                               # a broken pool fails the rest; the disk says what is saved
    failed = {}
    for j, f in zip(todo, futs):
        e = f.exception()
        if e is not None and not isinstance(e, BrokenProcessPool):
            failed[j["id"]] = f"{type(e).__name__}: {e}"
    return [j["id"] for j, d in zip(todo, dests) if read(d) is None and j["id"] not in failed], failed


def frozen_doubling(job: dict, out) -> Path:
    """The frozen doubling stage (revision_v2.stage_doubling) for this cell on this machine, saved as a reference record."""
    p = Path(out) / "gate" / "frozen" / (R._safe(job["id"]) + ".json")
    if read(p) is None:
        write(p, {"stage": "doubling", "id": job["id"], **R.stage_doubling(job, Path(out), CUTS, H4_EXCLUDED)})
    return p


def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
    """Gate mode: round 1 only. On the Mac it is compared with the frozen doubling stage run on the same machine (flagged
    cells diverge across platforms); on the pod, with the registered doubling record. Saved full-budget evidence bound to
    the cell's inputs, this driver, the site, and the environment."""
    ref = frozen_doubling(job, out) if site == "mac" else None
    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours, reference=ref)
    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
    stopped = r.get("round1_gate") == "not run"        # refused by the cell's own admission before round 1: a cost stop, not a mismatch
    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "cost_stopped": stopped, "cost": r.get("cost") if stopped else None, "site": site, "compared_with": "frozen stage, same machine" if ref else "registered record",
            "comparison": r["round1_gate"],
"""Tests for the replication's continuation stage and record loader (plan sections 2 and 4)."""
import sys
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import rep_collect as D  # noqa: E402


def _w(p, obj):
    import json
    p.parent.mkdir(parents=True, exist_ok=True); p.write_text(json.dumps(obj))


def test_winner_selection_rules(tmp_path):
    # plan section 4: passed and round-cap cells use their continued winner; cost-stopped or missing cells keep the frozen one
    frozen = [0.1, 0.2]
    rec = lambda status, **k: {"status": status, **k}
    assert D.select_winner(frozen, None) == (frozen, "frozen")
    assert D.select_winner(frozen, rec("passed", heldout={"gain": [0.3, 0.4]})) == ([0.3, 0.4], "continued")
    assert D.select_winner(frozen, rec("not passed at the cap", heldout={"gain": [0.5, 0.6]})) == ([0.5, 0.6], "unresolved")
    assert D.select_winner(frozen, rec("stopped at the cost cap", partial={"gain": [9, 9]})) == (frozen, "stopped")
    assert D.select_winner(frozen, rec("passed", heldout={"gain": [float("nan"), 0.1]})) == (frozen, "not continued")
    with pytest.raises(D.Round1Mismatch):
        D.select_winner(frozen, rec("stopped: round 1 differs from the registered doubling"))


def test_rule_names_map_to_the_analysis_labels():
    assert D.analysis_rule("menu", "F111") == "R3" and D.analysis_rule("menu", "F000") == "B3"
    assert D.analysis_rule("menu", "C*") == "C*" and D.analysis_rule("cthr", "C*") == "C-thr"


def test_the_worker_function_is_picklable():
    import pickle
    assert pickle.loads(pickle.dumps(D._cont_one)) is D._cont_one


def test_a_saved_round1_mismatch_stops_the_queue_on_resume(tmp_path, monkeypatch):
    import json
    calls = []
    monkeypatch.setattr(D, "_cont_one", lambda *a: calls.append(a) or {"status": "passed"})
    q = [{"id": "a", "job": {}, "dir": "x"}, {"id": "b", "job": {}, "dir": "x"}]
    (tmp_path / "continuation").mkdir()
    (tmp_path / "continuation" / "a.json").write_text(json.dumps({"id": "a", "status": "stopped: round 1 differs from the registered doubling"}))
    res = D.run_queue(q, tmp_path, workers=1, gate={"id": "g", "job": {}, "dir": "x"})
    assert calls == [] and "mismatch" in res["gate"]


def _queue(n, churn=0.05):
    return [{"id": f"c{i}", "job": {"id": f"j{i}", "churn": churn, "family": "D2+H3", "provenance": {"id": f"j{i}"}}, "dir": "x"}
            for i in range(n)]


def test_every_continuation_round_is_admitted_with_a_nonzero_estimate(tmp_path, monkeypatch):
    # review gap 2026-11-19: run_cell's round admission used round_hours = 0, so the cost stop could never refuse a round
    seen = []
    monkeypatch.setattr(D, "_cont_one", lambda job, d, mr, cost, hours: seen.append(hours) or {"status": "passed", "provenance": job["provenance"], "round1_gate": EXACT})
    monkeypatch.setattr(D, "run_cells", lambda fn, todo, args, w, dests, extras: (
        [D.write_record(d, {**fn(*a), **e}) for a, d, e in zip(args, dests, extras)], ([], {}))[1])
    D.run_queue(_queue(3), tmp_path, workers=2, gate=_gate())
    assert len(seen) == 4 and all(h > 0.3 for h in seen)
    assert D.round_hours({"churn": 0.05, "family": "D2+H3"}) > D.round_hours({"family": "D2+H3"})


def test_end_codes_mismatch_lost_and_failed(tmp_path, monkeypatch):
    # Run B's codes: 4 a measured round-1 mismatch (outranks the rest), 5 a lost worker (restart estimate saved), 6 a cell error
    ok = lambda job, *a: {"status": "passed", "provenance": job["provenance"], "round1_gate": EXACT}
    monkeypatch.setattr(D, "_cont_one", ok)
    def cells(outcome):
        def f(fn, todo, args, w, dests, extras):
            lost, failed = [], {}
            for c, a, d, e in zip(todo, args, dests, extras):
                o = outcome.get(c["id"], "ok")
                if o == "lost":
                    lost.append(c["id"])
                elif o == "fail":
                    failed[c["id"]] = "ValueError: x"
                else:
                    D.write_record(d, {**fn(*a), **e, **({"status": "stopped: round 1 differs"} if o == "mm" else {})})
            return lost, failed
        return f
    for outcome, code in (({}, 0), ({"c2": "lost"}, 5), ({"c2": "fail"}, 6), ({"c1": "mm", "c2": "lost"}, 4)):
        d = tmp_path / str(code); monkeypatch.setattr(D, "run_cells", cells(outcome))
        res = D.run_queue(_queue(3), d, workers=2, gate=_gate())
        assert res["exit"] == code, (outcome, res)
    import json
    assert json.loads((tmp_path / "5" / "continuation" / "lost_cells.json").read_text())["restart_hours"]["1"] > 0



