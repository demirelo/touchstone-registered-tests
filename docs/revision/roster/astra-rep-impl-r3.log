"""Commitment manifest and run-time freeze check of the churn replication (replication-plan.md, section 5).
build(): deterministic manifest bytes (sorted JSON) with the frozen code's git commit and the SHA-256 of every listed
file; these bytes are what is stamped and what block_draw.py and the instance wrapper read as --protocol.
frozen_problems(): sim/, scripts/ and the frozen configuration inputs equal the commit (no change, no untracked file)
  and no outside override is set.
verify() / require(): every required file is listed and every listed file still matches its hash; require() stops the
  run on any problem. build() refuses a file list without a required file or without a file of the drivers' import
  closure (imports inside functions included, review rep-impl-r1).
Usage: commitment.py build <out> <commit> <file>...   |   commitment.py check <manifest>"""
import ast
import hashlib
import json
import os
import subprocess
import sys
from pathlib import Path

FROZEN = ("sim", "scripts")
# Files outside sim/ and scripts/ that the frozen code reads (plan section 5: "the frozen configuration inputs").
FROZEN_INPUTS = ("experiments/locked.yaml", "experiments/revision-v2-manifest.yaml", "experiments/calibration.json",
                 "experiments/v2/params.json", "experiments/v2/benchmark/timings.json")
F3, CH, F2, F1 = "docs/revision/followup3", "docs/revision/churn", "docs/revision/followup2", "docs/revision/followup"
# Plan section 5: this plan, the analysis and its tests, the drivers and adapters, every imported helper outside sim/
# and scripts/ (test_the_real_required_set_covers_the_drivers_import_closure keeps this complete), the parameter files
# and uv.lock; also the launcher and its harness, the cost schedule and the frozen configuration inputs.
REQUIRED = tuple(sorted({
    f"{F3}/replication-plan.md", f"{F3}/replication_analysis.py", f"{F3}/test_replication_analysis.py",
    f"{F3}/commitment.py", f"{F3}/test_commitment.py", f"{F3}/continuation.py", f"{F3}/test_continuation.py",
    f"{F3}/rep_v2.py", f"{F3}/test_rep_v2.py", f"{F3}/rep_collect.py", f"{F3}/test_rep_collect.py",
    f"{F3}/rep_pod.sh", f"{F3}/test_rep_pod_harness.sh", f"{F3}/cost_estimate.py",
    f"{CH}/churn_v2.py", f"{F1}/reset_followup_v2.py", f"{F2}/common.py", f"{F2}/convergence_v2.py", f"{F2}/guards.py",
    f"{F2}/runnerup_v2.py", "uv.lock", *FROZEN_INPUTS,
    # Review rep-impl-r2: the preflight task that churn_v2 runs as a subprocess, and the runner-up recheck record that
    # runnerup_v2.runner_up_cred reads (the C-thr(12) parameters).
    f"{CH}/churn_memory.py",
    'experiments/v2/log/Cstar__{"L":10,"cred":{"K":12,"M":null,"variant":"thr"},"tol":0.16}__recheck.json'}))
# Environment variables the frozen code reads; the driver sets TOUCHSTONE_IDENTITY_SALT itself (checked against the draw).
OVERRIDES = ("TOUCHSTONE_LOCKED", "TOUCHSTONE_PROPOSED_MODULE", "TOUCHSTONE_PROPOSED_PARAMS", "TOUCHSTONE_SEALED_DIR",
             "TOUCHSTONE_GIT_COMMIT")


def _sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def search_dirs(root) -> list:
    """The drivers' import path outside the standard library (rep_v2.py, rep_collect.py): their own folders and the repo."""
    root = Path(root)
    return [root / F3, root / CH, root / F2, root / F1, root, root / "scripts"]


def _imports(path: Path) -> set:
    """Module names imported by the file, plus the stems of scripts it names as string literals ending in .py (a script
    run as a subprocess, review rep-impl-r2)."""
    names = set()
    for n in ast.walk(ast.parse(path.read_text(), filename=str(path))):
        if isinstance(n, ast.Constant) and isinstance(n.value, str) and n.value.endswith(".py") and "/" not in n.value \
                and n.value[:-3].isidentifier():
            names.add(n.value[:-3])
        elif isinstance(n, ast.Import):
            names |= {a.name.split(".")[0] for a in n.names}
        elif isinstance(n, ast.ImportFrom) and n.module and n.level == 0:
            names.add(n.module.split(".")[0])
    return names


def import_closure(root, start, search) -> set:
    """Every repo file outside sim/, scripts/ and the virtual environment reachable by imports (at any depth, inside
    functions too) from the start files, resolved along `search` as the drivers' sys.path does; paths relative to root."""
    root = Path(root).resolve(); seen, todo = set(), [root / f for f in start]
    while todo:
        p = todo.pop().resolve(); rel = str(p.relative_to(root))
        if rel in seen:
            continue
        seen.add(rel)
        for name in _imports(p):
            for d in [p.parent, *map(Path, search)]:
                q = (Path(d) / f"{name}.py").resolve()
                if q.is_file():
                    r = q.relative_to(root).parts
                    if r[0] not in (*FROZEN, ".venv"):
                        todo.append(q)
                    break
    return seen


def build(root, files, commit: str, required=None, search=None) -> bytes:
    root = Path(root); files = sorted(set(files))
    need = set(REQUIRED if required is None else required)
    py = [f for f in files if f.endswith(".py")]
    need |= import_closure(root, py, search_dirs(root) if search is None else search)
    if missing := sorted(need - set(files)):
        raise SystemExit(f"manifest refused: required or imported files not listed: {missing}")
    body = {"commit": commit, "files": {f: _sha(root / f) for f in sorted(set(files))},
            "note": "churn replication commitment; docs/revision/followup3/replication-plan.md"}
    return (json.dumps(body, indent=1, sort_keys=True) + "\n").encode()


def verify(root, manifest, required=None) -> list:
    root = Path(root); m = json.loads(Path(manifest).read_text())
    out = [f"{f}: required but not listed" for f in (REQUIRED if required is None else required) if f not in m["files"]]
    for f, h in m["files"].items():
        p = root / f
        if not p.exists():
            out.append(f"{f}: missing")
        elif _sha(p) != h:
            out.append(f"{f}: hash differs from the manifest")
    return out


def _git(root, *a) -> subprocess.CompletedProcess:
    return subprocess.run(["git", "-C", str(root), *a], capture_output=True, text=True)


def frozen_problems(root, commit: str) -> list:
    """A git error (an unknown commit included) is a problem, never an empty difference (review rep-impl-r2)."""
    if _git(root, "cat-file", "-e", f"{commit}^{{commit}}").returncode != 0:
        return [f"git: commit {commit} not found"]
    out = []
    paths = [*FROZEN, *[f for f in FROZEN_INPUTS if (Path(root) / f).exists() or _git(root, "cat-file", "-e", f"{commit}:{f}").returncode == 0]]
    d = _git(root, "diff", "--name-only", commit, "--", *paths)
    if d.returncode != 0:
        return [f"git diff failed: {d.stderr.strip()[:200]}"]
    changed = d.stdout.split()
    if changed:
        out.append(f"differ from commit {commit}: {', '.join(changed[:5])}")
    u = _git(root, "ls-files", "--others", "--exclude-standard", "--", *paths)
    if u.returncode != 0:
        return [f"git ls-files failed: {u.stderr.strip()[:200]}"]
    untracked = u.stdout.split()
    if untracked:
        out.append(f"untracked files under {', '.join(FROZEN)}: {', '.join(untracked[:5])}")
    out += [f"environment override set: {v}" for v in OVERRIDES if os.environ.get(v)]
    return out


def require(root, manifest, required=None) -> None:
    m = json.loads(Path(manifest).read_text())
    bad = frozen_problems(root, m["commit"]) + verify(root, manifest, required)
    if bad:
        raise SystemExit("commitment check failed:\n" + "\n".join(bad))


def main(argv) -> int:
    root = Path(_git(".", "rev-parse", "--show-toplevel").stdout.strip())
    if argv[0] == "build":
        Path(argv[1]).write_bytes(build(root, argv[3:], argv[2])); print("manifest written"); return 0
    require(root, argv[1]); print("commitment ok"); return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
"""Analysis of the churn replication (docs/revision/followup3/replication-plan.md, sections 2 and 3), fixed before the
draw. Input per winner set: recs[rate][market][rule] = per-seed lists {"gain", "attack", "reference", "eff_attack",
"seeds"} for markets rep0..rep5, rules R3, C*, C-thr, B3 and rates "0", "0.03", "0.05"; audit[rate][market] =
(audited jobs, served jobs) of the attacker under R3. Output: the paired changes from each market's own no-churn value,
the descriptive support criterion and its material companion, the five expectations, the absolute contrasts, the attack
and reference terms and efficiency under attack, and the seed-bootstrap intervals with one index vector per market
shared by every rule, rate and winner set. A missing cell makes what needs it "not scorable"; a malformed cell (nonfinite
values, unequal seed vectors within a market) is refused. Exploratory; intervals omit search uncertainty."""
import math

import numpy as np

MARKETS = tuple(f"rep{i}" for i in range(6))
RULES = ("R3", "C*", "C-thr", "B3")
CONTRASTS = {"d": "C*", "q": "B3", "u": "C-thr"}   # x = g(comparator) - g(R3)
RATES = ("0.03", "0.05")
ALL_RATES = ("0",) + RATES
T5 = 2.570581835636314                             # 0.975 quantile of Student's t, 5 degrees of freedom
MATERIAL = -0.05                                   # the registered Q1 margin
RESAMPLES, SEED = 9999, 0
FIELDS = ("gain", "attack", "reference", "eff_attack")


def _mean(xs):
    return sum(xs) / len(xs)


def _finite(xs) -> bool:
    return bool(xs) and all(isinstance(x, (int, float)) and math.isfinite(x) for x in xs)


def _check(gains: dict) -> None:
    """Every present cell finite; within a market every rule and rate has the same number of seeds."""
    for m in MARKETS:
        lens = set()
        for p in ALL_RATES:
            for r, xs in (gains.get(p, {}).get(m) or {}).items():
                if not _finite(xs):
                    raise ValueError(f"{p} {m} {r}: missing or nonfinite gains")
                lens.add(len(xs))
        if len(lens) > 1:
            raise ValueError(f"{m}: unequal seed vectors {sorted(lens)}")


def _check_recs(recs: dict) -> None:
    for m in MARKETS:
        seeds = None
        for p in ALL_RATES:
            for r, c in (recs.get(p, {}).get(m) or {}).items():
                for f in FIELDS:
                    if not _finite(c.get(f)):
                        raise ValueError(f"{p} {m} {r}: missing or nonfinite {f}")
                if len({len(c[f]) for f in FIELDS} | {len(c["seeds"])}) != 1:
                    raise ValueError(f"{p} {m} {r}: fields of unequal length")
                if seeds is None:
                    seeds = list(c["seeds"])
                elif list(c["seeds"]) != seeds:
                    raise ValueError(f"{p} {m} {r}: seeds differ from the market's other cells")


def gains_of(recs: dict) -> dict:
    return {p: {m: {r: list(c["gain"]) for r, c in rs.items()} for m, rs in ms.items()} for p, ms in recs.items()}


def _t95(xs: list) -> list:
    n = len(xs); m = _mean(xs); sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1))
    half = T5 * sd / math.sqrt(n)
    return [m - half, m + half]


def contrast(cell: dict, comparator: str):
    """Mean of g(comparator) - g(R3) over the seeds of one market, or None if a rule is missing."""
    if comparator not in cell or "R3" not in cell:
        return None
    return _mean(cell[comparator]) - _mean(cell["R3"])


def _cell(gains, p, m):
    return gains.get(p, {}).get(m) or {}


def paired_changes(gains: dict) -> dict:
    """Delta_x(m, p) = x(m, p) - x(m, 0) per contrast and positive rate over the six named markets; mean, market t interval
    and markets lower. A market missing a needed rule at either rate leaves that contrast incomplete."""
    _check(gains)
    out = {}
    for p in RATES:
        out[p] = {}
        for x, comp in CONTRASTS.items():
            ms = {}
            for m in MARKETS:
                a, b = contrast(_cell(gains, p, m), comp), contrast(_cell(gains, "0", m), comp)
                if a is not None and b is not None:
                    ms[m] = a - b
            vals = list(ms.values())
            out[p][x] = {"markets": ms, "complete": len(ms) == len(MARKETS),
                         "mean": _mean(vals) if vals else None, "t95": _t95(vals) if len(vals) > 1 else None,
                         "lower": sum(1 for v in vals if v < 0)}
    return out


def criteria(pc: dict) -> dict:
    """Support (descriptive): mean < 0 and at least 5 of 6 markets lower; material: mean <= -0.05. None if incomplete."""
    out = {}
    for p, xs in pc.items():
        out[p] = {}
        for x, r in xs.items():
            if not r["complete"]:
                out[p][x] = None; continue
            out[p][x] = {"support": r["mean"] < 0 and r["lower"] >= 5, "material": r["mean"] <= MATERIAL}
    return out


def _verdict(*conds):
    if any(c is None for c in conds):
        return "not scorable"
    return "met" if all(conds) else "not met"


def expectations(crit: dict, audit: dict) -> dict:
    s = lambda p, x: None if crit.get(p, {}).get(x) is None else crit[p][x]["support"]
    below = None
    if all(m in audit.get("0", {}) and m in audit.get("0.05", {}) for m in MARKETS):
        n = 0
        for m in MARKETS:
            (a0, s0), (a5, s5) = audit["0"][m], audit["0.05"][m]
            if s0 and s5 and a5 / s5 < a0 / s0:             # a zero denominator at either rate counts as not below
                n += 1
        below = n >= 5
    return {"1": {"text": "support for d at p = 0.05", "verdict": _verdict(s("0.05", "d"))},
            "2": {"text": "support for q at p = 0.05", "verdict": _verdict(s("0.05", "q"))},
            "3": {"text": "support for d and q at p = 0.03", "verdict": _verdict(s("0.03", "d"), s("0.03", "q"))},
            "4": {"text": "support for u (runner-up) at p = 0.05; subjective prospective probability 0.5",
                  "verdict": _verdict(s("0.05", "u"))},
            "5": {"text": "R3's audited share of the attacker's jobs lower at p = 0.05 than at p = 0 on at least 5 of 6 markets",
                  "verdict": _verdict(below)}}


def boot_indices(n_by_market: dict, resamples: int = RESAMPLES, seed: int = SEED) -> dict:
    """One (resamples x n) index array per market, drawn in market order from one generator seeded with `seed`; the
    same arrays serve every rule, rate and winner set (the churn arm's pairing)."""
    rng = np.random.default_rng(seed)
    return {m: rng.integers(0, n_by_market[m], size=(resamples, n_by_market[m])) for m in MARKETS if m in n_by_market}


def _ci(boots) -> list:
    b = np.sort(np.asarray(boots)); k = len(b)
    return [float(b[int(0.025 * (k + 1)) - 1]), float(b[int(0.975 * (k + 1)) - 1])]


def bootstrap(gains: dict, idx: dict) -> dict:
    """Per contrast and rate: per-market and equal-weight pooled percentile intervals of the absolute contrast x at every
    rate (its own cells only), and of the paired change Delta_x at the positive rates (it also needs the p = 0 cells),
    from the shared index arrays. A missing cell gives no market entry; a pooled interval needs all six markets."""
    bm = {}                                                  # bm[m][p][r] = resampled means (resamples,)
    for m, ix in idx.items():
        bm[m] = {p: {r: np.asarray(xs)[ix].mean(axis=1) for r, xs in _cell(gains, p, m).items()} for p in ALL_RATES}
    out = {}
    for p in ALL_RATES:
        out[p] = {}
        for x, comp in CONTRASTS.items():
            delta, absolute = {}, {}
            for m in MARKETS:
                b = bm.get(m, {})
                if all(r in b.get(p, {}) for r in (comp, "R3")):
                    absolute[m] = b[p][comp] - b[p]["R3"]
                    if p != "0" and all(r in b.get("0", {}) for r in (comp, "R3")):
                        delta[m] = absolute[m] - (b["0"][comp] - b["0"]["R3"])
            row = {"absolute_markets": {m: {"ci95": _ci(v)} for m, v in absolute.items()},
                   "absolute_pooled": {"ci95": _ci(sum(absolute.values()) / len(MARKETS))} if len(absolute) == len(MARKETS) else None}
            if p != "0":
                row.update({"markets": {m: {"ci95": _ci(v)} for m, v in delta.items()},
                            "pooled": {"ci95": _ci(sum(delta.values()) / len(MARKETS))} if len(delta) == len(MARKETS) else None})
            out[p][x] = row
    return out


def absolute(gains: dict, boot: dict) -> dict:
    """The absolute contrasts x(m, p) at every rate (secondary, descriptive): per market with its seed interval, mean,
    market t interval (all six markets only) and the pooled seed interval (all six markets only)."""
    out = {}
    for p in ALL_RATES:
        out[p] = {}
        for x, comp in CONTRASTS.items():
            ms = {m: contrast(_cell(gains, p, m), comp) for m in MARKETS}
            ms = {m: v for m, v in ms.items() if v is not None}
            b = boot.get(p, {}).get(x, {})
            vals = list(ms.values())
            out[p][x] = {"markets": {m: {"estimate": v, "ci95": (b.get("absolute_markets", {}).get(m) or {}).get("ci95")}
                                     for m, v in ms.items()},
                         "complete": len(ms) == len(MARKETS), "mean": _mean(vals) if vals else None,
                         "t95": _t95(vals) if len(ms) == len(MARKETS) else None,
                         "pooled_ci95": (b.get("absolute_pooled") or {}).get("ci95")}
    return out


def terms(recs: dict) -> dict:
    """Per cell: the mean gain, attack term and reference term (gain = attack - reference) and efficiency under attack."""
    return {p: {m: {r: {f: _mean(c[f]) for f in FIELDS} for r, c in (recs.get(p, {}).get(m) or {}).items()}
                for m in MARKETS} for p in ALL_RATES}


def analyse(recs: dict, audit: dict, resamples: int = RESAMPLES, seed: int = SEED) -> dict:
    """Everything the plan reports for one winner set."""
    _check_recs(recs)
    g = gains_of(recs)
    pc = paired_changes(g); cr = criteria(pc)
    n = {}
    for p in ALL_RATES:
        for m, rs in (g.get(p) or {}).items():
)
