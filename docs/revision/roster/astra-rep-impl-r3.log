   279	        return "evaluation: " + x
   280	    if db is None:
   281	        return "no doubling record"
   282	    if db.get("stage") != "doubling" or db.get("id") != job["id"] or db.get("provenance") != job["provenance"] or db.get("kind") != "profit":
   283	        return "doubling record of another stage, cell, run or kind"
   284	    ch = [db.get("attack_change"), db.get("reference_change")]
   285	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   286	        return "doubling changes nonfinite or flag missing"
   287	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   288	        return "doubling flag differs from its changes"
   289	    h = db.get("heldout")
   290	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   291	        return "doubling held-out result missing, nonfinite or on other seeds"
   292	    ref = read_record(R.path_of(d, rid))
   293	    if ref is None or not isinstance(ref.get("upstream"), dict):
   294	        return "no reference record"
   295	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   296	        return "doubling: " + x
   297	    return None
   298	
   299	
   300	def _shares_ok(sh) -> bool:
   301	    """Newcomer audit counts: per episode a list of [served, audited] bins, the same number of bins in every episode,
   302	    finite and nonnegative, audited at most served."""
   303	    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
   304	    if not isinstance(per, list) or not per:
   305	        return False
   306	    nb = None
   307	    for e in per:
   308	        f = e.get("focal") if isinstance(e, dict) else None
   309	        if not isinstance(f, list) or not f or (nb is not None and len(f) != nb):
   310	            return False
   311	        nb = len(f)
   312	        for b in f:
   313	            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
   314	                return False
   315	    return True
   316	
   317	
   318	def diag_ok(row, seeds, knobs) -> bool:
   319	    """A diagnostics row (frozen: diagnostics.json cells[...]["base"]; continued: its own record) for this winner: its
   320	    knobs, the job's ordered evaluation seeds, finite per-seed profits and well-formed audit counts (review rep-impl-r2)."""
   321	    return isinstance(row, dict) and row.get("knobs") == knobs and list(row.get("seeds") or []) == list(seeds) and \
   322	        _finite(row.get("normalized")) and len(row["normalized"]) == len(seeds) and _shares_ok(row.get("shares"))
   323	
   324	
   325	def cont_diag_ok(rec, key: str, job: dict, knobs) -> bool:
   326	    return isinstance(rec, dict) and rec.get("stage") == "continued diagnostics" and rec.get("id") == key and \
   327	        rec.get("provenance") == job["provenance"] and diag_ok(rec, job["mkt"]["seeds_eval"], knobs)
   328	
