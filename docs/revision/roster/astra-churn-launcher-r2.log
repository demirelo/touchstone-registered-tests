   461	def _run_rate(out, jobs, steps, a, salt_sha, container, p, started) -> None:
   462	    F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
   463	    if not a.smoke:
   464	        F.check_pairing(a.src, jobs)
   465	    slow = 1.33 if p > 0 else 1.0
   466	    lim = None if a.smoke else memory_limit()                                   # review r4: the limit persists across commands
   467	    sv = saved_workers(out, lim); w_mem = min(a.workers_eval, sv) if sv else a.workers_eval
   468	    cap = lambda need: check_cap(started, need, a.stop_usd, a.usd_per_hour, prior_usd=a.prior_usd)
   469	    for st in steps:
   470	        if st == "inputs":
   471	            F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
   472	        elif st == "search":
   473	            cap(STAGE_SECONDS["search"] * slow * _waves(len(jobs), a.workers_search)); run_stage("search", jobs, out, a.workers_search)
   474	        elif st == "freeze":
   475	            F.prefreeze(out, jobs)
   476	        elif st in ("evaluate", "doubling"):
   477	            sec = STAGE_SECONDS[st] * slow
   478	            k = len(preflight_sample(st, jobs)) if (not a.smoke and len(jobs) > 1) else 0
   479	            cap(sec * (k + _waves(len(jobs) - k, w_mem)))                       # admission includes the serial preflight tasks
   480	            F.accept(out, jobs, salt_sha, container, src=a.src)
   481	            if k:
   482	                mp = memory_preflight(st, jobs, out, w_mem)
   483	                w_mem = save_workers(out, min(w_mem, mp["workers"]), mp.get("limit_bytes", lim), st)
   484	                fresh = set() if mp.get("reused") else set(mp["measured"])      # just run in this command: their records exist
   485	                cap(sec * _waves(len(jobs) - len(fresh), w_mem))                 # admission again with the chosen workers
   486	            run_stage(st, jobs, out, w_mem)       # review r5: every job passes through _run_one, which skips a valid record
   487	                                                  # and recomputes a missing or damaged one
   488	        elif st == "diagnostics":
