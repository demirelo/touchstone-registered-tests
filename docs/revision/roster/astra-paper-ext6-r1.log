from __future__ import annotations

import numpy as np

from .cell import SeedCache, run_profile
from .policies.base import Action
from .policies.honest import HonestMax

EPS = 1e-12


def _truthful(result) -> np.ndarray:
    c, e = np.asarray(result.claims, dtype=float), np.asarray(result.efforts, dtype=float)
    return np.where(np.isnan(c), False, c <= e + EPS)


def by_entity(result, table, N: int) -> np.ndarray:
    """A (T, identities) ledger table summed to (T, entities) through the episode's identity map."""
    a = np.asarray(table, dtype=float)
    if a.shape[1] == int(N) and not hasattr(result, "entity_of"):
        return a
    out = np.zeros((a.shape[0], int(N)))
    for ident, e in enumerate(result.entity_of):
        out[:, int(e)] += a[:, ident]
    return out


def false_refunds(result, focal: int, N: int) -> tuple[float, float]:
    """(focal, all other entities) refunds on failed truthful jobs, each normalised by S*/N."""
    mask = (np.asarray(result.failures) > 0) & _truthful(result)
    ref = np.where(mask, by_entity(result, result.ledger.refunds, N), 0.0); scale = float(result.sstar) / int(N)
    return float(ref[:, int(focal)].sum()) / scale, float(ref.sum() - ref[:, int(focal)].sum()) / scale


def served_share(result, cfg) -> float:
    n_fb = int(cfg.T) * min(int(cfg.J), sum(int(p.k) for p in cfg.providers))
    return float(np.asarray(result.served).sum()) / n_fb


def extras(attack_results, ref_results, cfg, focal: int) -> dict:
    """The draft-7 evaluation fields per seed (design 9.3 Q1 side fields)."""
    out = {"served_share_attack": [], "served_share_ref": [], "false_refund_focal_attack": [], "false_refund_others_attack": [],
           "false_refund_focal_ref": [], "false_refund_others_ref": []}
    for tag, res in (("attack", attack_results), ("ref", ref_results)):
        for r in res:
            f, o = false_refunds(r, focal, cfg.N)
            out[f"served_share_{tag}"].append(served_share(r, cfg))
            out[f"false_refund_focal_{tag}"].append(f); out[f"false_refund_others_{tag}"].append(o)
    return out


def decompose(row: dict, rule_r: str, rule_c: str) -> dict:
    """gain_R - gain_C = attack_term - reference_term per seed (design 6.6), from normalised per-seed profits."""
    a = np.subtract(row[rule_r]["profit_attack"], row[rule_c]["profit_attack"])
% BEGIN-EV2
The registered estimates and decisions below come from the report that the tagged code wrote; the addendum beside it (Section~\ref{sec:design}) adds labels and disclosures. Tables~\ref{tab:ph-q1}, \ref{tab:ph-q4}, \ref{tab:ph-welfare}, and~\ref{tab:ph-welfare-sens} report exploratory analyses of existing records, and Tables~\ref{tab:ph-stability} and~\ref{tab:ph-q4-stability} the separate registered-configuration stability check; none of these changes a registered estimate or decision. Gains are normalised attacker gains; intervals are those of Table~\ref{tab:rules-v2}. Some descriptive fixed-reference contrasts on fresh1 (\site{r_ext_n} interval entries in the report's per-market Q2 rows) have numerically extreme studentized intervals: the reference-profit contrast there is above rounding scale on only \site{r_ext_seeds} of \site{r_ext_total} seeds (the others are at most \site{r_ext_round} in absolute value), and \site{r_ext_cnt} of the \site{r_ext_tot} frozen resamples (\site{r_ext_share}) omit all three, so their standard error is of rounding size and their bootstrap-t statistics are huge. We retain these frozen outputs, list them in the audit file, and draw no inferential conclusion from them; no other interval in the report has a bound beyond $\const{1000}$ in absolute value.

\paragraph{Age-ranked versus history-based checking (Q1).} Pooled over the six fresh markets, the prescribed searches leave the identity-replacement attacker a measured gain against C$^*$ higher than against R3 by \site{r_q1_d_est} under D2+H3 and by \site{r_q1_x_est} under X7-SC. Both direction tests reject $d = \const{0}$ (calibrated input $p' = $ \site{r_q1_d_p}; Holm-adjusted $p = $ \site{r_q1_holm} for each). Both intervals lie inside the registered margin of $\pm\const{0.05}$: the categories are ``\site{r_q1_d_cat}'' (D2+H3) and ``\site{r_q1_x_cat}'' (X7-SC), and the separate efficiency label is ``\site{r_q1_d_eff}''. R3 is not materially better than the development-selected comparator. The difference changes sign across markets: per market (descriptive), it ranges from \site{r_q1_f3_d} on fresh3 to \site{r_q1_f1_d} on fresh1 under D2+H3. Both decisions are about the prescribed search procedure: the D2+H3 test uses search-flagged cells, and the X7-SC test uses them through its references (addendum); their nominal error guarantees are not established on the fresh, selected-rule distributions (Section~\ref{sec:design}). The paired descriptive differences in Table~\ref{tab:q1-side} are small for efficiency, audit spending, refunds on false audit failures, and the market service fraction; the reference-profit column is in raw profit units. Splitting $d$ with the same normalisation into the attacked-profit term and the reference-profit term (Table~\ref{tab:ph-q1}, exploratory) shows that almost all of it is attacked profit: the attacker earns more under C$^*$ when it deviates, not when it is truthful.
