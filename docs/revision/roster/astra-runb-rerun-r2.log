   350	def test_each_cell_is_saved_by_its_worker_and_a_killed_worker_loses_only_its_own_cell(tmp_path):
   351	    jobs = [{"id": "kill"}, {"id": "a"}, {"id": "b"}]
   352	    dests, extras = _dests(tmp_path, jobs)
   353	    lost = B.run_cells(_probe_cell, jobs, [(jobs[0], 1.5), (jobs[1], 0.0), (jobs[2], 0.0)], 2, dests, extras)
   354	    assert lost == ["kill"] and not dests[0].exists()
   355	    for d, j in zip(dests[1:], jobs[1:]):
   356	        assert json.loads(d.read_text()) == {"id": j["id"], "status": "passed", "binding": {"cell": j["id"]}}
