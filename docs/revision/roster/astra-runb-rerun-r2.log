   331	# Run B rerun (board card touchstone-runb-rerun): one killed worker lost all 17 cells, because results were written only
   332	# after every cell ended. Each cell must be saved the moment it ends, and a lost worker must cost only its own cells.
   333	def _probe_cell(job, wait, watch=None):
   334	    import os
   335	    import time
   336	    time.sleep(wait)
   337	    if job["id"] == "kill":
   338	        for _ in range(200):                                     # die the moment a sibling's record is on disk (review r1)
   339	            if watch is None or Path(watch).exists():
   340	                break
   341	            time.sleep(0.025)
   342	        os.kill(os.getpid(), 9)                                  # what the out-of-memory killer did on the pod
   343	    return {"id": job["id"], "status": "passed"}
