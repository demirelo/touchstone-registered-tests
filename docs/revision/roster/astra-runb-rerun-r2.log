def test_flagged_cells_split_into_profit_and_coalition():
    rep = {"doubling": {"a|F111|D2+H3|profit": {"kind": "profit", "incomplete": True}, "b|C*|X6-SE/v2|total|c2_s": {"kind": "coalition", "incomplete": True},
