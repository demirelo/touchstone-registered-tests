   394	def test_restart_hours_schedule_the_lost_cells_longest_first_on_each_worker_count():
   395	    """Sol and Astra r1: the restart was admitted at a fixed 2.60 h; an early loss can leave all 19 cells (about 10 h on 3
   396	    workers). The estimate comes from the lost cells: longest first onto the least-loaded worker, plus 0.1 h shutdown."""
   397	    h = B.restart_hours([3.0, 3.0, 2.0, 1.0, 1.0])
   398	    assert h["1"] == 10.1 and h["2"] == 5.1 and h["3"] == 4.1 and h["5"] == 3.1 and h["16"] == 3.1
   399	    assert all(h[str(w)] >= h[str(w + 1)] for w in range(1, 16))
   400	    assert B.restart_hours([]) == {str(w): 0.1 for w in range(1, 17)}
