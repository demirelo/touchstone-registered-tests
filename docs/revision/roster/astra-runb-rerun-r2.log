   377	def test_a_pool_broken_during_submission_is_a_lost_worker_not_a_crash(tmp_path, monkeypatch):
   378	    """Sol and Astra r1: BrokenProcessPool raised by submit() escaped the handler (no lost_cells.json, no exit 5)."""
   379	    import concurrent.futures as cf
   380	    from concurrent.futures.process import BrokenProcessPool
   381	    real, n = cf.ProcessPoolExecutor.submit, []
   382	    def submit(self, *a, **k):
   383	        n.append(1)
   384	        if len(n) > 1:
   385	            raise BrokenProcessPool("a worker died during submission")
   386	        return real(self, *a, **k)
   387	    monkeypatch.setattr(cf.ProcessPoolExecutor, "submit", submit)
   388	    jobs = [{"id": "a"}, {"id": "b"}, {"id": "c"}]
   389	    dests, extras = _dests(tmp_path, jobs)
   390	    lost = B.run_cells(_probe_cell, jobs, [(j, 0.0) for j in jobs], 2, dests, extras)
   391	    assert dests[0].exists() and lost == ["b", "c"]
