   403	def _fake_run_cells(calls, first_status="passed"):
   404	    def fake(fn, todo, args, workers, dests, extras):
   405	        calls.append([j["id"] for j in todo])
   406	        for i, j in enumerate(todo):
   407	            if len(calls) == 1 and i == 0:
   408	                continue                                         # the first call loses its first cell
   409	            B.write(dests[i], {"status": first_status if len(calls) == 1 else "passed", "rounds": [], **extras[i]})
   410	        return [todo[0]["id"]] if len(calls) == 1 else []
