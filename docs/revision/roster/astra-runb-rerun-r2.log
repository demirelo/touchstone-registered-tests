   319	def _cell_gains(src, conv, rid: str, expected: dict):
   320	    f = read(R.eval_path(src, rid))
   321	    if rid not in expected:
   322	        return f["gain"], f["gain"], False
   323	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   324	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   325	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   326	    g = c["heldout"]["gain"]
   327	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   328	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   329	    return f["gain"], g, True
