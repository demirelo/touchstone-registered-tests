   295	def main(argv=None) -> int:
   296	    argv = list(sys.argv[1:] if argv is None else argv)
   297	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   298	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True); ap.add_argument("--report", default=str(ROOT / "results/v2/report/report.json"))
   299	    ap.add_argument("--draw", required=True); ap.add_argument("--instances", required=True); ap.add_argument("--cfgs", required=True); ap.add_argument("--addendum", required=True)
   300	    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   301	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "reference", "freeze", "evaluate", "doubling", "analysis", "inventory", "all"))
   302	    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--smoke", action="store_true")
   303	    ap.add_argument("--evidence", action="append", default=[], help="saved reproduction gate files that must report a pass (full runs)")
   304	    ap.add_argument("--cap-usd", dest="cap", type=float, default=3.00); ap.add_argument("--usd-per-hour", dest="rate", type=float, default=0.56)
   305	    ap.add_argument("--started-at", dest="started", type=float, default=None, help="pod allocation time (epoch seconds)")
   306	    a = ap.parse_args(argv); out = Path(a.out); F.check_out(out, a.src)
   307	    G.pin_settings(); check_run_evidence(a.evidence, a.smoke)
   308	    from sim.records import cfg_from_dict
   309	    root = json.loads(Path(a.draw).read_text())["hash"]; salt = json.loads(Path(a.instances).read_text())["salt_sha256"]
   310	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   311	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   312	    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   313	    markets = tuple(a.markets.split(","))
   314	    jobs = build_jobs(root, cfgs, runner_up_params(json.loads(Path(a.params).read_text())), salt, markets, a.smoke)
   315	    check_spec(jobs)
