   318	            G.check_budget(j, R.path_of(a.src, R.cell_id(j["context"], LABEL, j["family"], "profit")))
   319	    preflight(out, a.src, jobs, salt, container, a.smoke)
   320	    b = G.binding(inputs_sha=G.sha_json(bank_inputs(a.src, [j["context"] for j in jobs])), provenance={j["id"]: j["provenance"] for j in jobs},
   321	                  smoke=a.smoke, settings={"markets": list(markets), "spec": EXPECTED_SPEC, "cuts": CUTS}, driver_sha=sha_file(Path(__file__)))
   322	    if not G.reusable(out / "run.json", b):
   323	        write(out / "run.json", {"binding": b, "label": "runner-up follow-up run"})
   324	    write(out / "label.json", {"rule_label": LABEL, "rule": "C-thr", "cred": runner_up_cred(), "source": str(LOG.relative_to(ROOT)), "deviations": list(DEVIATIONS)})
   325	    cost = G.CostStop(a.cap, a.rate, a.started if a.started is not None else __import__("time").time()); hours = stage_hours()
   326	    files = {"driver": Path(__file__), "plan": HERE / "runner-up-plan.md", "report": Path(a.report)}
   327	    steps = ("inputs", "search", "reference", "freeze", "evaluate", "doubling", "analysis", "inventory") if a.stage == "all" else (a.stage,)
   328	    for st in steps:
   329	        if not cost.allow(st, hours[st]):
   330	            write(out / "cost_stop.json", cost.report()); G.inventory(out, DEVIATIONS, files, argv)
   331	            print(json.dumps({"stopped_before": st, "cap_usd": a.cap}), flush=True)
   332	            return 3
   333	        if st == "inputs":
   334	            F.copy_inputs(a.src, out, bank_inputs(a.src, [j["context"] for j in jobs]))
   335	        elif st == "search":
