    ref = read(A.R.path_of(out, f"reference/{CTX}/C*")); assert ref["provenance"]["rule_params_sha256"] != read(A.R.path_of(MAIN / "eval/all", f"reference/{CTX}/C*"))["provenance"]["rule_params_sha256"]
