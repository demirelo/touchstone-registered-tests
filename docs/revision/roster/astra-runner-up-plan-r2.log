    48	def reusable(path, b: dict) -> bool:
    49	    """False if nothing is saved; True if the saved result has this exact binding; refused otherwise (never overwritten)."""
    50	    rec = read(path)
    51	    if rec is None:
    52	        return False
    53	    if rec.get("binding") != b:
    54	        _refuse(f"{path}: a saved result with another binding exists")
    55	    return True
