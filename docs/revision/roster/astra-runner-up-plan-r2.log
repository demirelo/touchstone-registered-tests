   289	    """Billed wall time per stage on one pod (critical path), from the benchmark."""
   290	    t = json.loads((ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]; ev = lambda k: t["eval160"][k] * 200 / 160
   291	    return {"inputs": 0.02, "search": (t["d2h3_cell"] + t["x7_cell"]) / 3600, "reference": 6 * t["reference"] / 3600, "freeze": 0.01,
   292	            "evaluate": max(ev("profit"), ev("x7")) / 3600, "doubling": t["doubling_x7"] / 3600, "analysis": 0.05, "inventory": 0.01}
