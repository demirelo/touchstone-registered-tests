def stage_upstream(stage: str, job: dict, catalog: list[dict], cuts: int, h4_excluded: bool) -> set:
    if stage in ("search", "dependent"):
        return expected_upstream(job["id"], catalog, cuts, h4_excluded)
    ids = _inputs(job) | {f"freeze/{job['context']}"}
    if stage == "doubling" and job["objective"] == "profit":                  # the profit check reselects from the rule's menu
        ids |= expected_upstream(f"reference/{job['context']}/{job['rule']}", catalog, cuts, h4_excluded)
    return ids


def _tiers(items: list) -> list[list]:
    return [[i for i in items if i.get("priority", 3) == t] for t in range(4)]


def _menu_items(jobs: list[dict]) -> list[dict]:
    menus = {}
    for j in jobs:
        if j["objective"] == "profit" and j["family"] in MENU:
            k = (j["context"], j["rule"]); m = menus.get(k)
            if m is None or (j["family"] == "D2+H3" and m["family"] != "D2+H3"):
                menus[k] = {**j, "id": f"reference/{k[0]}/{k[1]}", "priority": min(j.get("priority", 3), (m or {}).get("priority", 3))}
            else:
                m["priority"] = min(m["priority"], j.get("priority", 3))
    return list(menus.values())


