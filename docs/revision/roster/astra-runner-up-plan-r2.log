   250	def _contrasts(ru, r3, cs, markets, resamples) -> dict | str:
   251	    if None in (ru, r3, cs):
   252	        return "not available"
   253	    for m in markets:
   254	        if not (ru[m][0] == r3[m][0] == cs[m][0]):
   255	            raise ValueError(f"{m}: evaluation seeds differ")
   256	    if not G.finite([ru[m][1] for m in markets], [r3[m][1] for m in markets], [cs[m][1] for m in markets]):
   257	        return "not available"
   258	    g = lambda d: {m: d[m][1] for m in markets}
   259	    a, b, c = C.pooled_paired(g(ru), g(r3), resamples), C.pooled_paired(g(cs), g(ru), resamples), C.pooled_paired(g(cs), g(r3), resamples)
   260	    return {"runner_up_minus_r3": {**a, "category": C.q1_category(a["interval"])}, "cstar_minus_runner_up": b,
   261	            "cstar_minus_r3": {**c, "category": C.q1_category(c["interval"])}}
   262	
   263	
   264	def _score(base, doubled) -> dict:
   265	    vals = [None if isinstance(x, str) else x["cstar_minus_runner_up"]["estimate"] > 0 for x in (base, doubled)]   # a tie is not met
   266	    score = "not available" if None in vals else ("met" if all(vals) else ("failed" if not any(vals) else "not established"))
   267	    return {"statement": EXPECTATION, "base": vals[0], "doubled": vals[1], "score": score}
