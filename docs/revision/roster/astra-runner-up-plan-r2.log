    assert A.main(args) == 0
    for fam in ("D2+H3", "X7-SC"):
        rid = A.R.cell_id(CTX, "C*", fam, "profit")
        ev = read(A.R.eval_path(out, rid)); db = read(out / "doubling" / (A.R._safe(rid) + ".json"))
