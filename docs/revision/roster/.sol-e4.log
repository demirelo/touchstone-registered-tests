    49	            continue
    50	        (pa, ta), (pb, tb) = _terms(ra), _terms(rb)
    51	        att, ref = pa - pb, -(ta - tb)
    52	        rows[m] = {"estimate": float(np.mean(att + ref)), "attacked": float(np.mean(att)), "reference": float(np.mean(ref))}
    53	    pooled = {k: float(np.mean([v[k] for v in rows.values()])) for k in ("estimate", "attacked", "reference")} if rows else {}
