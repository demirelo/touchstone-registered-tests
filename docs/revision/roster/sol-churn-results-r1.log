    39	
    40	def _tree(tmp: Path, gains: dict, n=40, seeds=None, flags=None):
    41	    """Writes the registered no-churn records (eval-all/evaluate and report.json doubling) and the churn records."""
    42	    seeds = list(range(1000, 1000 + n)) if seeds is None else seeds
    43	    ea, ch = tmp / "eval-all", tmp / "churn"; report = {"doubling": {}}
    44	    for m in M6:
    45	        for r in CB.RULES:
    46	            rid = f"{m}@rho0.2|{r}|D2+H3|profit"
    47	            _write(ea / "evaluate" / (CB.safe(rid) + ".json"), _rec(gains[0]["base"][m][r], seeds))
    48	            report["doubling"][rid] = {"attack_change": 0.0, "reference_change": 0.0, "incomplete": False, "kind": "x",
    49	                                       "heldout": _rec(gains[0]["doubled"][m][r], seeds)}
    50	            for p in RATES:
    51	                cid = f"{rid}|churn{p:g}"; d = ch / f"p{p:g}"
    52	                _write(d / "evaluate" / (CB.safe(cid) + ".json"), _rec(gains[p]["base"][m][r], seeds))
    53	                fl = (flags or {}).get((p, m, r), {"attack_change": 0.0, "reference_change": 0.0, "incomplete": False})
    54	                _write(d / "doubling" / (CB.safe(cid) + ".json"), dict(fl, kind="x", heldout=_rec(gains[p]["doubled"][m][r], seeds)))
    55	    _write(tmp / "report.json", report)
    56	    return ea, ch, tmp / "report.json"
