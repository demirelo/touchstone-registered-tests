    16	def _rec(gain, seeds, pa=None, pr=None):
    17	    g = np.asarray(gain, float)
    18	    pa = g + 1.0 if pa is None else np.asarray(pa, float)
    19	    pr = pa - g if pr is None else np.asarray(pr, float)
    20	    return {"seeds": list(seeds), "gain": g.tolist(), "profit_attack": pa.tolist(), "profit_ref": pr.tolist()}
