"""The 2 x 2 x 2 decomposition of R3 (design 3.2) and the repaired R3, R4 (design 3.4). Every cell is B3's allocation and
payment with refund-and-ban enforcement; cells differ in pacing (S: B3's spread count or R3's reserve schedule) and in
selection (P: the priority phase over identities younger than L rounds; G: the newest-first half of the residual). F000 is
B3, F111 is R3, F011 is the killed amendment-2 rule (tests/oracles). Ties: when P = G = 0 the uniform order is B3's (stable
order of the audit key over jobs in assignment order); otherwise R3's (audit key, then job)."""
from __future__ import annotations

import numpy as np

from .base import AuditRecord, Consequences, Mechanism, Offers, StateView
from .pacing import ReservePacing, spread_cap, spread_count
from .second_score import SecondScore

NAMES = tuple(f"F{p}{g}{s}" for p in (0, 1) for g in (0, 1) for s in (0, 1)) + ("R4",)


def select(jobs_by_identity: dict, audit_key, first_round: dict, t: int, L: int, k: int, P: int, G: int, order: list | None = None) -> list:
    """k audited jobs in order. Priority phase (P = 1): the jobs of identities with 0 <= t - first_round < L, by (-first_round,
    audit_key, job). Residual r: with G = 1, ceil(r / 2) picks by (-first_round, audit_key, job), then uniform by (audit_key, job);
    with G = 0, all uniform. With P = G = 0, uniform is B3's stable audit-key order over `order` (jobs in assignment order)."""
    remaining = {int(j): int(i) for i, jobs in jobs_by_identity.items() for j in jobs}
    k = max(0, min(int(k), len(remaining)))
    if not P and not G:
        jobs = np.asarray(order if order is not None else list(remaining), dtype=np.int64)
        idx = np.argsort(np.asarray(audit_key)[jobs], kind="stable")
        return jobs[idx[:k]].tolist()
    born = lambda i: int(first_round.get(i, t))
    newest = lambda j: (-born(remaining[j]), float(audit_key[j]), j)
    chosen: list = []
    if P:
        fresh = sorted((j for j, i in remaining.items() if 0 <= int(t) - born(i) < int(L)), key=newest)
        for j in fresh[:k]:
            remaining.pop(j); chosen.append(j)
    r = k - len(chosen)
    k_t = (r + 1) // 2 if G else 0
    for _ in range(k_t):
        pick = min(remaining, key=newest)
        remaining.pop(pick); chosen.append(pick)
    rest = sorted(remaining, key=lambda j: (float(audit_key[j]), j))
    chosen.extend(rest[: r - k_t])
    return chosen


class FactorialRule(Mechanism):
    def __init__(self, P: int, G: int, S: int, tol: float, L: int, reserve: str = "full") -> None:
        if any(v not in (0, 1) for v in (P, G, S)):
            raise ValueError("P, G, S must be 0 or 1")
        self.P, self.G, self.S, self.tol, self.L, self.reserve = int(P), int(G), int(S), float(tol), int(L), str(reserve)
        if self.reserve != "full" and not (self.P and self.G and self.S):
            raise ValueError("the half reserve is R4 only")
        self.name = "R4" if self.reserve == "half" else f"F{self.P}{self.G}{self.S}"
        self._b3 = SecondScore(self.tol, self.L)
        self._pacing = ReservePacing(self.reserve, self.L)
        self.T, self.cap = 1, 1

    def bind(self, cfg) -> None:
        self.T, self.cap = int(cfg.T), spread_cap(cfg)
        self._pacing.bind(cfg)

    @staticmethod
    def _memory(view: StateView) -> tuple[dict, dict, dict]:
        m = view.memory
        return m.setdefault("first_round", {}), m.setdefault("audits", {}), m.setdefault("served", {})

    def allocate(self, values_t: np.ndarray, offers: Offers, view: StateView) -> dict[int, int]:
        first_round, _, served = self._memory(view)
        for i in offers:
            if view.is_active(i):
                first_round.setdefault(int(i), int(view.t))
                served.setdefault(int(i), 0)
        out = self._b3.allocate(values_t, offers, view)
        for i in out.values():
            served[int(i)] = served.get(int(i), 0) + 1
        return out

    def price(self, assignment, values_t, offers, view) -> dict[int, float]:
        return self._b3.price(assignment, values_t, offers, view)

    def audit(self, assignment: dict[int, int], view: StateView) -> list[int]:
        first_round, audits, _ = self._memory(view)
        n = len(assignment)
        k = self._pacing.count(view, n) if self.S else spread_count(view, self.T, self.cap, n)
        if k <= 0:
            return []
        by_identity: dict[int, list[int]] = {}
        for j, i in assignment.items():
            by_identity.setdefault(int(i), []).append(int(j))
        chosen = select(by_identity, view.audit_key, first_round, view.t, self.L, k, self.P, self.G, order=[int(j) for j in assignment])
        for j in chosen:
            i = int(assignment[j]); audits[i] = audits.get(i, 0) + 1
        return chosen

    def enforce(self, records: tuple[AuditRecord, ...], view: StateView) -> Consequences:
        cons = Consequences()
        for r in records:
            if r.failed:
                cons.refunds[r.job] = float(view.escrow[r.job])
                cons.bans[r.provider] = max(cons.bans.get(r.provider, 0), int(self.L))
        return cons

    def describe(self) -> dict:
        d = dict(self._b3.describe())
        if self.name != "F000":
            d["audit_selection"] = "not expressible"
        d["parameters"] = {"audit_tolerance": float(self.tol), "ban_length": int(self.L)}
        return d


def make_factorial(name: str, tol: float, L: int) -> FactorialRule:
    if name == "R4":
        return FactorialRule(1, 1, 1, tol, L, reserve="half")
    if name not in NAMES:
        raise ValueError(f"unknown factorial cell {name!r}")
    return FactorialRule(int(name[1]), int(name[2]), int(name[3]), tol, L)
    """The text with every \\input or \\include file inlined, except the generated numbers file and generated tables
    (checked by tables_v2.py --check)."""
    base = Path(tex_path).parent; skip = {Path(numbers_path).name} if numbers_path else set()
    def inline(m):
        name = m.group(1); f = base / (name if name.endswith(".tex") else name + ".tex")
        if f.name in skip or name.startswith("tables/") or not f.exists():
            return m.group(0)
        return sources(f, numbers_path)
    return INPUT.sub(inline, strip_comments(Path(tex_path).read_text()))      # comments first: a commented \\input is not followed


def _report_numbers(raw: dict) -> set:
    return {f"{v:.3f}" for v in raw.values() if isinstance(v, float) and not isinstance(v, bool) and math.isfinite(v)}


def check(report_path, numbers_path, tex_path, extra: dict | None = None) -> list[str]:
    report = load(report_path, extra); known = macros(report); raw = flat(report)
    tex = sources(tex_path, numbers_path); problems = []
    sites = _sites(tex_path)
    if not Path(numbers_path).exists() or Path(numbers_path).read_text() != render(report, sites):
        problems.append(f"{numbers_path}: stale or missing; run --write")
    used = set(USE.findall(tex)) | {p for _, p in USEK.findall(tex)}
    problems += [f"unknown report path in the text: {p}" for p in sorted(used) if p not in known]
    for kind, p in USEK.findall(tex):
        if kind not in KINDS:
            problems.append(f"unknown kind {kind} for {p}")
        elif p in raw and not KINDS[kind](p.split(".")[-1], raw[p]):
            problems.append(f"kind {kind} does not fit {p} (value {raw[p]!r})")
    blocks, bp = _blocks(tex); problems += bp
    for b in blocks:
        problems += [f"plain \\rv in an evaluation-2 block (use \\rvk with a kind): {p}" for p in USE.findall(b)]
        bare = BARE.findall(EXEMPT.sub("", USEK.sub("", USE.sub("", b))))
        problems += [f"bare number in an evaluation-2 block: {x}" for x in bare]
    outside = tex
docs/revision/paper-v2/main.tex:67:\paragraph{Benchmark and metrics.} One focal provider deviates while the others play honestly at full effort with truthful claims; this is a unilateral deviation, not an equilibrium. For a seed with first-best surplus $S^*$, the focal provider's \emph{gain} is its profit under the attack minus its profit under a selected truthful reference, divided by $S^*/N$. \emph{Gross efficiency} is $(W + \text{audit cost})/S^*$, with $W$ the realised social surplus net of audit cost; net efficiency is $W/S^*$. Gain is a difference of two searched values, so search error can bias it either way. It is excess profit when replacement is available; it does not isolate how much of that profit comes from the ability to replace an identity; Section~\ref{sec:results} reports an exploratory matched comparison with replacement disabled, within the D2 family only. The second test adds two objectives at its headline market: welfare attacks that minimise gross efficiency, without a constraint (W0) or subject to a nonnegative mean normalised gain over the attacker's reference on the training seeds (W1), whose profitability is then called supported only if its nominal 95\% lower bound on the evaluation seeds is nonnegative; and coalitions of two or five providers, scored by the total gain $G_{\mathrm{tot}}$ and by the worst member's mean gain $G_{\min}$, both against a coordinated truthful reference. Coalition results say nothing about coalition stability.
docs/revision/paper-v2/main.tex:132:\paragraph{Search quality.} Scheduled cells get a doubling check: the registered search continues with as many restarts again, and the cell is flagged if the doubled search improves the attacker's normalised profit or the reference's normalised profit (profit cells), the welfare attack's efficiency (welfare cells), or the coalition objective by at least \const{0.005}, or if a W1 search finds a feasible candidate where the original found none. A doubled search's winner is reported beside the cell and never replaces its frozen estimate. Cells without a scheduled check carry no search-quality claim. A cell is \emph{missing} if it did not complete or is invalid: not run (a cap stop or a cut), a refused sample, a nonfinite statistic, a search with no finite candidate, or a failed load of H4; a missing cell removes every decision that uses it. A \emph{search-flagged} cell keeps its decision, labelled as a decision about the prescribed search procedure, and leaves that rule's robustness statement for that family unanswered. The search bounds exposure to the searched families and optimiser; it does not certify robustness.
docs/revision/paper-v2/main.tex:156:\paragraph{Result.} The original claim failed against H2: R3 passed the rule clause, but neither audited baseline met either baseline criterion (Table~\ref{tab:verdict1}). The amended claim passed: under D2+H3 the mean gains were \evone{0.570} for B2, \evone{0.353} for B3, and \evone{0.071} for R3. These are normalised excess focal profits, not losses of honest surplus; and the first report's sentence that R3 matched B3 and B2 under H2 ``within noise'' was unsupported, since no equivalence test was run (published erratum).
docs/revision/paper-v2/main.tex:171:\paragraph{Decision rules.} Table~\ref{tab:rules-v2} summarises them; the protocol file is the authority. Pooled statistics weight the six markets equally, and intervals use a studentized bootstrap (\const{9999} resamples) that resamples seeds within each market, pairing the rules' outcomes on each seed; this measures uncertainty over seeds in the six fixed markets, not over new markets or repeated searches. The gain is $g = (\pi^{A} - \pi^{T})/(S^*/N)$, attacked profit minus the profit of the rule's frozen truthful reference, normalised by the first-best surplus per provider; with $N = \const{10}$ providers, the Q1 margin of $\const{0.05}$ is half a percent of the first-best surplus. \emph{Calibration.} A multiplier $\kappa$ replaces each nominal tail $\alpha_e$ by $\kappa\alpha_e$, so $\kappa < \const{1}$ widens the intervals. It was selected from $\{1, 1/2, 1/4\}$ on fixtures built from frozen development attacks and references on the headline market and dev0 (pools of \const{20000} seeds per market; Q1 in six equal strata), using \const{10000} selection replications, and admitted on \const{20000} independent validation replications if every endpoint's Clopper--Pearson upper bound on its miss rate, at confidence $1 - \const{0.01}/m$ with $m = \const{8}$ endpoints for Q1 and $m = \const{36}$ for Q4 (the two-market branch evaluates \const{24} Q4 endpoints and keeps the denominator \const{36}, which is conservative), was at most its allocated tail. The fixtures hold the policies and references fixed, so admission does not cover search or reference selection, and it does not establish nominal coverage on the fresh, selected-rule distributions. Q1's categories follow the logic of equivalence testing and Q4's market test is an intersection-union test~\cite{berger1996bioequivalence}; the calibration follows the reporting of simulation studies of statistical methods~\cite{morris2019simulation}. Conditional on valid calibrated component $p$-values, Holm controls the Q1 direction family and the six Q4 joint gain-and-efficiency decisions separately; fixture admission does not establish that validity on the fresh-market distributions. Q1's reported intervals use calibrated Bonferroni tails, and its efficiency condition uses a separate nominal one-sided \const{97.5} percent bound. The report stores the calibrated two-sided Q1 value that enters Holm and, for Q4, the raw one-sided bootstrap $p$-values of the two components and the calibrated market value $\max(p'_{\mathrm{gain}}, p'_{\mathrm{eff}})$ with $p' = \min(\const{1}, p/\kappa)$; Tables~\ref{tab:q1} and~\ref{tab:q4} print these with their Holm-adjusted values, and an audit script recomputes these values from the records and reproduces each Q1 category and direction rejection and each Q4 decision.
docs/revision/paper-v2/main.tex:189:The registered estimates and decisions below come from the report that the tagged code wrote; the addendum beside it (Section~\ref{sec:design}) adds labels and disclosures. Table~\ref{tab:ph-honest} reports the registered descriptive honest-replacement diagnostic. Tables~\ref{tab:ph-q1}, \ref{tab:ph-doubled}, \ref{tab:ph-q4}, \ref{tab:ph-welfare}, and~\ref{tab:ph-welfare-sens} report exploratory analyses of existing records, and Tables~\ref{tab:ph-stability} and~\ref{tab:ph-q4-stability} the separate registered-configuration stability check; none of these changes a registered estimate or decision. Gains are normalised attacker gains; intervals are those of Table~\ref{tab:rules-v2}. Some descriptive fixed-reference contrasts on fresh1 (\site{r_ext_n} interval entries in the report's per-market Q2 rows) have numerically extreme studentized intervals: the reference-profit contrast there is above rounding scale on only \site{r_ext_seeds} of \site{r_ext_total} seeds (the others are at most \site{r_ext_round} in absolute value), and \site{r_ext_cnt} of the \site{r_ext_tot} frozen resamples (\site{r_ext_share}) omit all three, so their standard error is of rounding size and their bootstrap-t statistics are huge. We retain these frozen outputs, list them in the audit file, and draw no inferential conclusion from them; no other interval in the report has a bound beyond $\const{1000}$ in absolute value.
docs/revision/paper-v2/main.tex:191:\paragraph{Age-ranked versus history-based checking (Q1).} Pooled over the six fresh markets, the prescribed searches leave the identity-replacement attacker a measured gain against C$^*$ higher than against R3 by \site{r_q1_d_est} under D2+H3 and by \site{r_q1_x_est} under X7-SC; the mean gains are \site{r_abs_cs} against C$^*$ and \site{r_abs_r3} against R3 under D2+H3, and \site{r_abs_cs_x} and \site{r_abs_r3_x} under X7-SC. Both direction tests reject $d = \const{0}$ (calibrated input $p' = $ \site{r_q1_d_p}; Holm-adjusted $p = $ \site{r_q1_holm} for each). Both intervals lie inside the registered margin of $\pm\const{0.05}$: the categories are ``\site{r_q1_d_cat}'' (D2+H3) and ``\site{r_q1_x_cat}'' (X7-SC), and the separate efficiency label is ``\site{r_q1_d_eff}''. Under the registered margin, R3 is not materially better than the development-selected comparator; the margin of $\pm\const{0.05}$ is half the first test's comparative margin, not an estimated threshold of buyer indifference, and a narrower margin could order the two rules. The difference changes sign across markets: per market (descriptive), it ranges from \site{r_q1_f3_d} on fresh3 to \site{r_q1_f1_d} on fresh1 under D2+H3. Search uncertainty matters at this level: evaluating the doubled-search winners on the same seeds against the same frozen references (Table~\ref{tab:ph-doubled}, exploratory) changes fresh3's difference from \site{r_dbl_f3} to \site{r_dbl_f3_d}, and the pooled differences to \site{r_dbl_pool_d} under D2+H3 and \site{r_dbl_pool_x} under X7-SC; no decision is recomputed. The registered intervals measure seed uncertainty in six fixed markets. Treating the six markets as a sample of the neighbourhood (exploratory), a $t$ interval over the per-market differences is [\site{r_ml_lo}, \site{r_ml_hi}] under D2+H3, with \site{r_ml_pos} of six markets positive, and [\site{r_ml_xlo}, \site{r_ml_xhi}] under X7-SC; with the doubled-search winners it is [\site{r_ml_dlo}, \site{r_ml_dhi}] under D2+H3, with \site{r_ml_dpos} positive. With each rule's strongest training-selected family the interval is [\site{r_env_lo}, \site{r_env_hi}], with \site{r_env_pos} of six markets positive. The direction is therefore fairly stable across these analyses, while the size is not: every upper end is near the margin, so the equivalence label is the most fragile part; beyond these six markets the sign is not established either, since the frozen interval contains zero and the searches share inputs; on these markets the registered direction tests reject zero for the prescribed searches, and another comparator would be a different comparison. The frozen D2+H3 interval contains zero and crosses the margin, so this analysis does not establish the category for the neighbourhood; the X7-SC interval excludes zero and lies inside the margin, but that family mostly repeats D2+H3 (below). In relative terms, under D2+H3, the attacker's pooled mean gain against C$^*$ exceeds that against R3 by a fraction of \site{r_rel}. The two Q1 families are close to one test: X7-SC's search starts from the embedded D2+H3 winner, and in \site{r_x7_same} of the \site{r_x7_cells} Q1 cells it selected that winner, with identical evaluated gains; only fresh3 against C$^*$ and fresh4 against R3 differ. With the headline market, the same holds in \site{r_x7_all} of \site{r_x7_all_n} market--rule cells, which is why most of prediction Q3-a's differences are exactly zero. With each rule's strongest training-selected family instead (Table~\ref{tab:q3-envelope}), the pooled difference is \site{r_env_pool}, and \site{r_env_f1} on fresh1, where X5-AG/v2 is C$^*$'s strongest family. C$^*$ was selected in development on gross efficiency in effect, and the full-budget runner-up left a lower development gain than C$^*$ (Section~\ref{sec:rules}); a comparator selected on attacker gain could change the direction label. The two rules differ more in whom they burden than in the attacker's gain. In the registered descriptive honest-replacement diagnostic at the headline market (Table~\ref{tab:ph-honest}), an honest provider replaces its identity at round \const{50}: R3 audits \site{r_hon_r3_0} and \site{r_hon_r3_1} of the replacement's served jobs in its first two ten-round age bins, C$^*$ audits \site{r_hon_cs_0} and \site{r_hon_cs_1} (its lowest bin; \site{r_hon_cs_2} in the next), and B3 about \site{r_hon_b3_0}. Under R3 the replacement earns less per round (relative to C$^*$, a fraction of \site{r_hon_rel}; the registered diagnostic stores bin means, so no interval is available) and loses more receipts to refunds paid to buyers on false audit failures; R3 directs more of the fixed audit capacity to this provider, which does not show higher total audit spending. Both decisions are about the prescribed search procedure: the D2+H3 test uses search-flagged cells, and the X7-SC test uses them through its references (addendum); their nominal error guarantees are not established on the fresh, selected-rule distributions (Section~\ref{sec:design}). The paired descriptive differences in Table~\ref{tab:q1-side} are small for efficiency, audit spending, refunds on false audit failures, and the market service fraction; the reference-profit column is in raw profit units. Splitting $d$ with the same normalisation into the attacked-profit term and the reference-profit term (Table~\ref{tab:ph-q1}, exploratory) shows that almost all of it is attacked profit: the attacker earns more under C$^*$ when it deviates, not when it is truthful.
docs/revision/paper-v2/main.tex:194:\caption{Exploratory, after the report: the pooled Q1 difference split into the attacked-profit term and the reference-profit term, with the normalisation of the gain and equal market weights.}\label{tab:ph-q1}

