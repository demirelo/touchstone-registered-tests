   222	def diagnostics(out, jobs: list[dict], workers: int = 1) -> dict:
   223	    """Plan section 4 (draft 2): the base and the doubled winner of each churn cell rerun on the evaluation seeds under
   224	    churn, with per-seed normalised profits and newcomer audit counts; and, per rule and winner, the age-bin shares pooled
   225	    over markets with equal weights."""
   226	    install()
   227	    if workers <= 1 or len(jobs) <= 1:
   228	        rows = [_diag_one(j, str(out)) for j in jobs]
   229	    else:
   230	        with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
   231	            rows = list(ex.map(_diag_one, jobs, [str(out)] * len(jobs)))
   232	    res = dict(rows); pooled = {}
   233	    for rule in sorted({k.split("|")[1] for k in res}):
   234	        for w in ("base", "doubled"):
   235	            bm = {k.split("|")[0]: v[w]["shares"] for k, v in res.items() if k.split("|")[1] == rule}
   236	            pooled[f"{rule}|{w}"] = {c: pool_markets(bm, c) for c in ("honest_replacement", "honest_initial", "focal")}
   237	    return {"cells": res, "pooled": pooled}
