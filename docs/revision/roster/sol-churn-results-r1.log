    22	
    23	def _write(path: Path, obj):
    24	    path.parent.mkdir(parents=True, exist_ok=True); path.write_text(json.dumps(obj))
    25	
    26	
    27	def _gains(n=40, noise=0.0, seed=0, base=None, shift=None):
    28	    """Per-seed gains {cond: {ver: {m: {rule: array}}}}; cond 0 is no churn. Shared noise per market and seed."""
    29	    base = base or {"F111": 0.06, "C*": 0.08, "F000": 0.23}
    30	    shift = shift or {}
    31	    rng = np.random.default_rng(seed); out = {}
    32	    e = {m: (rng.normal(0, noise, n) if noise else np.zeros(n)) for m in M6}
    33	    for c in (0,) + RATES:
    34	        out[c] = {}
    35	        for v in ("base", "doubled"):
    36	            out[c][v] = {m: {r: base[r] + shift.get((c, v, r), 0.0) + e[m] for r in CB.RULES} for m in M6}
    37	    return out
