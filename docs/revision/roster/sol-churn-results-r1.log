   201	def test_expectation_4_reads_the_first_bin_at_p005(tmp_path):
   202	    r = CB.analyse(CB.load(*_tree(tmp_path, _gains()), markets=M6, n_seeds=40), b=99, seed=1)
   203	    hi = {("F111", w): 0.9 for w in ("base", "doubled")} | {(x, w): 0.3 for x in ("C*", "F000") for w in ("base", "doubled")}
