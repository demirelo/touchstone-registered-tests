   204	    out["1"] = {"text": "pooled g_0.05(R3) exceeds pooled no-churn g(R3)", **e1, "verdict": _verdict({v: e1[v]["holds"] for v in VERS})}
   205	    out["2"] = {"text": "pooled d_0.05 = C* - R3 below its no-churn value", **e2, "verdict": _verdict({v: e2[v]["holds"] for v in VERS})}
   206	    out["3"] = {"text": "q_0.01 = B3 - R3 positive on all six markets", **e3, "verdict": _verdict({v: e3[v]["holds"] for v in VERS})}
   207	    e4 = {}
   208	    for w in VERS:
   209	        try:
   210	            sh = {r: diagnostics["pooled"][f"{r}|{w}"]["honest_replacement"][0]["share"] for r in RULES}
   211	        except (TypeError, KeyError, IndexError):
   212	            sh = {r: None for r in RULES}
   213	        ok = None if any(x is None for x in sh.values()) else (sh["F111"] > sh["C*"] and sh["F111"] > sh["F000"])
   214	        e4[w] = {"first_bin_share": sh, "holds": ok}
   215	    out["4"] = {"text": "p = 0.05: pooled audited share of honest replacements aged [0, 10) higher under R3 than C* and B3",
   216	                **e4, "verdict": _verdict({w: e4[w]["holds"] for w in VERS})}
   217	    return out
