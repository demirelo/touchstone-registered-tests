   220	def registered_check(res: dict, reg: dict) -> dict:
   221	    """The no-churn records reproduce posthoc.json doubled.D2+H3 (q1 = C* - R3, q4 = B3 - R3; frozen = base)."""
   222	    pairs = {"q1_frozen": ("base", "d"), "q1_doubled": ("doubled", "d"), "q4_frozen": ("base", "q"), "q4_doubled": ("doubled", "q")}
   223	    rows = {}
   224	    for k, (v, s) in pairs.items():
   225	        got = _est(res[v]["0"][s]); want = reg["pooled"][k]
   226	        rows[k] = {"registered": want, "computed": got, "ok": got is not None and abs(got - want) <= TOL}
   227	    absm = [v for v in VERS if all(_est(res[v]["0"]["g"][r]) is not None
   228	                                   and abs(_est(res[v]["0"]["g"][r]) - reg["absolute"][r]["mean_gain"]) <= TOL for r in ("C*", "F111"))]
   229	    return {"pooled": rows, "absolute_matches": absm, "ok": all(x["ok"] for x in rows.values()) and bool(absm)}
   230	
   231	
   232	def diag_summary(diag: dict) -> dict:
   233	    """Per rule and winner: honest replacements per episode and the mechanism-relevant newest share of the focal identity
   234	    (means over markets of per-episode means), and the driver's market-pooled age-bin shares."""
   235	    out = {}
   236	    cells = diag.get("cells", {})
   237	    for r in RULES:
   238	        for w in VERS:
   239	            reps, newest = [], []
   240	            for k, cell in cells.items():
   241	                if k.split("|")[-1] != r or w not in cell:
   242	                    continue
   243	                s = cell[w]["shares"]; reps.append(float(s["honest_replacements_per_episode"]))
   244	                xs = [x for x in s["focal_newest_by_first_offer_assigned"] if x is not None and math.isfinite(x)]
   245	                if xs:
   246	                    newest.append(float(np.mean(xs)))
   247	            out[f"{r}|{w}"] = {"honest_replacements_per_episode": float(np.mean(reps)) if reps else None,
   248	                               "focal_newest_first_offer": float(np.mean(newest)) if newest else None,
   249	                               "markets": len(reps), "pooled_bins": diag.get("pooled", {}).get(f"{r}|{w}")}
   250	    return out
   251	
   252	
   253	def _fmt(e, d: int = 3) -> str:
   254	    p = e["pooled"]
   255	    if p["estimate"] is None:
   256	        return "--"
   257	    lo, hi = p["ci95"] or (None, None)
   258	    n = lambda x: f"{x:.{d}f}".replace("-", "$-$")          # a typeset minus, not a hyphen
   259	    return n(p["estimate"]) + ("" if lo is None else f" [{n(lo)}, {n(hi)}]")
   260	
   261	
   262	def table(res: dict) -> str:
   263	    name = {"0": "0 (registered)", "0.01": "0.01", "0.05": "0.05"}
   264	    lines = ["\\begin{tabular}{llccccc}", "\\toprule",
   265	             "Winner & $p$ & $g$(R3) & $g$(C*) & $g$(B3) & $d$ = C*$-$R3 & $q$ = B3$-$R3 \\\\", "\\midrule"]
   266	    for v in VERS:
   267	        for c in CONDS:
   268	            b = res[v][c]
   269	            lines.append(f"{'frozen' if v == 'base' else v} & {name[c]} & " + " & ".join([_fmt(b["g"][r]) for r in RULES] + [_fmt(b["d"]), _fmt(b["q"])]) + " \\\\")
   270	    lines += ["\\bottomrule", "\\end{tabular}"]
   271	    return "\n".join(lines) + "\n"
   272	
   273	
   274	def _sha(p: Path):
   275	    return hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None
   276	
   277	
   278	def main(argv=None) -> int:
   279	    import argparse
   280	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   281	    ap.add_argument("--records", required=True, help="registered eval-all directory (no-churn base records)")
   282	    ap.add_argument("--churn", required=True, help="the pod's followup-churn directory (p0.01, p0.05)")
   283	    ap.add_argument("--report", required=True, help="registered report.json (no-churn doubled records)")
   284	    ap.add_argument("--out", required=True); ap.add_argument("--tables", required=True)
   285	    ap.add_argument("--posthoc", default=None, help="posthoc.json, to check the registered no-churn values")
   286	    ap.add_argument("--n-seeds", dest="n_seeds", type=int, default=200)
   287	    ap.add_argument("--resamples", type=int, default=B); ap.add_argument("--seed", type=int, default=SEED)
   288	    a = ap.parse_args(argv)
   289	    markets = tuple(f"fresh{i}" for i in range(6)); ch = Path(a.churn)
   290	    data = load(a.records, ch, a.report, markets, a.n_seeds)
   291	    res = analyse(data, a.resamples, a.seed)
   292	    diags = {c: _read(ch / f"p{c}" / "diagnostics.json") for c in CONDS[1:]}
   293	    out = {"label": LABEL, "statistics": res, "flags": data["flags"], "flag_summary": flag_summary(data["flags"]),
   294	           "expectations": expectations(res, diags.get("0.05")),
   295	           "diagnostics": {c: (diag_summary(d) if d else None) for c, d in diags.items()},
   296	           "inputs": {"records": str(a.records), "churn": str(ch), "report_sha256": _sha(Path(a.report)),
   297	                      "run_json_sha256": _sha(ch / "run.json"),
   298	                      **{f"inventory_p{c}_sha256": _sha(ch / f"p{c}" / "inventory.json") for c in CONDS[1:]},
   299	                      **{f"diagnostics_p{c}_sha256": _sha(ch / f"p{c}" / "diagnostics.json") for c in CONDS[1:]}}}
   300	    if a.posthoc:
   301	        out["registered_check"] = registered_check(res, json.loads(Path(a.posthoc).read_text())["doubled"]["D2+H3"])
   302	        out["inputs"]["posthoc_sha256"] = _sha(Path(a.posthoc))
   303	    Path(a.out).write_text(json.dumps(out, indent=1) + "\n")
   304	    d = Path(a.tables); d.mkdir(parents=True, exist_ok=True)
   305	    (d / "posthoc_churn.tex").write_text(table(res).replace("C*", "C$^*$"))
   306	    return 0
   307	
