#!/bin/bash
# Build the WEIS version's PDF: a fresh copy of paper-v2 (tables, figures, refs) with paper-weis/main.tex and
# numbers.tex laid over it, built by paper_pdf.sh. Usage: paper_pdf_weis.sh OUTDIR [--anon]. --anon runs the anonymizer
