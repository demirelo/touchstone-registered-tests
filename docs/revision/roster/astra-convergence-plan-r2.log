   507	        ok = pod_gate_ok(rep, a.req_id)
   508	        print(json.dumps({"reproduce": REPRO, "require_identical": a.req_id, "gate_ok": ok, **rep}))
   509	        return 0 if ok else 1
   510	    jobs = build_jobs(root, cfgs, json.loads(Path(a.params).read_text()), salt_sha, tuple(a.markets.split(",")), a.smoke)
   511	    check_configs(jobs, container); check_salt(out, salt_sha, jobs); check_commit(jobs); check_code()
   512	    if not a.smoke:
