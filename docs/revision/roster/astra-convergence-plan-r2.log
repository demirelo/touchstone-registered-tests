   283	    """Plan section 4: a D2 winner (x = 0) must never replace its identity; anything else is a construction error."""
   284	    if any(stats["resets"]):
   285	        _refuse(f"{what}: the D2 winner has resets in {sum(1 for r in stats['resets'] if r)} episodes")
