   499	        headline_diagnostics(a.src, out, root, params, salt_sha, json.loads(Path(a.report).read_text())); inventory(out)
   500	        print(json.dumps({"headline_diagnostics": len(j0)})); return 0
   501	    if a.repro_dbl:
   502	        rep = reproduce_doubling(a.src, out, a.repro_dbl, root, cfgs, json.loads(Path(a.params).read_text()), salt_sha)
   503	        print(json.dumps({"reproduce_doubling": a.repro_dbl, **rep}))
   504	        return 0 if rep["pass"] else 1
   505	    if a.reproduce:
