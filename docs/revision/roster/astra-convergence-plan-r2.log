    90	class CostStop:
    91	    """Checked between stages: a stage starts only if the billed time so far plus its estimate stays within the cap.
    92	    A running stage is never interrupted (the author: do not kill jobs); the run stops and reports instead."""
    93	
    94	    def __init__(self, cap_usd: float, usd_per_hour: float, started: float, clock=time.time):
    95	        self.cap, self.rate, self.started, self.clock, self.stopped, self.log = float(cap_usd), float(usd_per_hour), float(started), clock, None, []
    96	
    97	    def allow(self, stage: str, est_hours: float) -> bool:
    98	        spent = (self.clock() - self.started) / 3600 * self.rate; ok = spent + est_hours * self.rate <= self.cap + 1e-9
    99	        self.log.append({"stage": stage, "spent_usd": round(spent, 4), "next_usd": round(est_hours * self.rate, 4), "allowed": ok})
