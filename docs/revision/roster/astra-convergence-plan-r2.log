   184	def gate_cell(job: dict, out, src) -> dict:
   185	    """Gate mode: round 1 only, compared with the registered doubling record (saved full-budget evidence)."""
   186	    r = run_cell(job, out, max_rounds=1, src=src)
   187	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(r["round1_gate"] != "not compared (smoke)" and r["round1_gate"]["pass"]),
   188	            "comparison": r["round1_gate"], "environment": G.environment()}
