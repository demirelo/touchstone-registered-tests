"""Tests for posthoc_v2.py (exploratory analyses after the report; external review round 4): the Q1 split into attacked and
reference terms, the episode-mixture welfare frontier, and the per-market Q4 diagnostics."""
import json
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import posthoc_v2 as P  # noqa: E402


def _rec(out, rid, **f):
    p = out / "evaluate" / (P.safe(rid) + ".json"); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(json.dumps(f))


def test_split_terms_add_up_to_the_gain_difference(tmp_path):
    s = [10.0, 10.0]
    _rec(tmp_path, "m0@rho0.2|C*|D2+H3|profit", profit_attack=[3.0, 5.0], profit_ref=[1.0, 1.0], sstar=s)
    _rec(tmp_path, "m0@rho0.2|F111|D2+H3|profit", profit_attack=[2.0, 2.0], profit_ref=[0.5, 0.5], sstar=s)
    got = P.split(tmp_path, ["m0"], "C*", "F111", "D2+H3", n=10)
    # g_C = (2, 4), g_F = (1.5, 1.5): d mean = 1.5; attacked term = (1, 3) mean 2; reference term = -(0.5, 0.5) mean -0.5
    assert got["pooled"]["estimate"] == pytest.approx(1.5)
    assert got["pooled"]["attacked"] == pytest.approx(2.0) and got["pooled"]["reference"] == pytest.approx(-0.5)


def test_mixture_weight_is_the_largest_with_a_nonnegative_lower_bound():
    rng = np.random.default_rng(0)
    gw0, gp = -0.1 + 0.001 * rng.standard_normal(200), 0.06 + 0.001 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    m = P.mixture(gw0, ew0, gp, ep)
    assert 0.0 < m["weight"] < 0.375                          # 0.375 is where the mean gain reaches zero
    g = m["weight"] * gw0 + (1 - m["weight"]) * gp
    assert g.mean() - 1.645 * g.std(ddof=1) / np.sqrt(len(g)) >= 0
    assert m["efficiency"] == pytest.approx(m["weight"] * 0.84 + (1 - m["weight"]) * 1.0)


def test_no_mixture_when_the_profitable_policy_is_not_profitable():
    z = np.zeros(200)
    assert P.mixture(z - 0.1, z + 0.84, z - 0.01, z + 1.0)["weight"] == 0.0


def test_weight_label_and_stability_table_keep_the_needed_precision():
    assert P.weight_label(0.4195) == "41.95 percent"            # a rounded 0.42 flips the sign of the lower bound
    res = {"q1_split": {}, "welfare": {}, "q4_diag": {},
           "stability": {"q1": {"C*-F111|D2+H3": {"estimate_report": 0.020720, "estimate_registered_cfg": 0.020917, "category_registered_cfg": "eq"}}}}
    assert "0.0207" in P.tables(res)["stability"] and "0.0209" in P.tables(res)["stability"]


def test_sensitivity_is_linear_in_the_weight_with_its_own_bound():
    rng = np.random.default_rng(2)
    gw0, gp = -0.1 + 0.01 * rng.standard_normal(200), 0.06 + 0.01 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    rows = P.sensitivity(gw0, ew0, gp, ep, (0.0, 0.25, 0.5))
    # internal review r2: Q3-a's zeros come from the embedding on the fresh markets and the headline market
    import inspect
    src = inspect.getsource(P.main)
    assert 'x7_embedding(out, FRESH + ("headline",))' in src


# ---- follow-up reviews (Fable 5.2 r2, Astra ext11, 2026-11-10) ----

def test_direct_priority_contrast_is_f111_minus_f011_per_market_and_pooled(tmp_path):
    for m, a, b in (("m0", [0.05, 0.07], [0.06, 0.08]), ("m1", [0.10, 0.10], [0.10, 0.12])):
        _rec(tmp_path, f"{m}@rho0.2|F111|D2+H3|profit", gain=a); _rec(tmp_path, f"{m}@rho0.2|F011|D2+H3|profit", gain=b)
    got = P.direct_priority(tmp_path, ["m0", "m1"], fams=("D2+H3",))["D2+H3"]
    assert got["markets"]["m0"] == pytest.approx(-0.01) and got["markets"]["m1"] == pytest.approx(-0.01) and got["pooled"] == pytest.approx(-0.01)


def test_nesting_test_flags_x7_cells_below_the_best_d2h3_winner(tmp_path):
    _rec(tmp_path, "m0@rho0.2|C*|D2+H3|profit", gain=[0.03, 0.04], seeds=[1, 2]); _rec(tmp_path, "m0@rho0.2|C*|X7-SC|profit", gain=[0.06, 0.07], seeds=[1, 2])
    rep = {"doubling": {"m0@rho0.2|C*|D2+H3|profit": {"heldout": {"gain": [0.08, 0.09], "seeds": [1, 2]}}}}
    got = P.nesting(tmp_path, rep, ["m0"], rules=("C*",))
    row = got["cells"]["m0@rho0.2|C*"]
    assert row["shortfall"] == pytest.approx(0.02) and got["failures"] == ["m0@rho0.2|C*"]
    assert got["over_threshold"] == 1 and got["max_shortfall"] == pytest.approx(0.02)


def test_envelope_interval_and_honest_relative_cost():
    env = {"markets": {f"f{i}": {"difference": d} for i, d in enumerate([0.021, 0.070, 0.028, 0.017, 0.031, 0.016])}, "pooled": 0.0305}
    got = P.envelope_interval(env)
    assert got["positive"] == 6 and got["t95"][0] > 0 and got["t95"][1] < 0.06
    hon = {"F111": {"mean_profit_per_round": 0.000274}, "C*": {"mean_profit_per_round": 0.000286}}
    assert P.honest_relative(hon) == pytest.approx(0.000274 / 0.000286 - 1)
"""The development comparator table (internal review r2/r3 of the Fable 5.2 revision): every configuration's stored
inner-budget gains and efficiencies, and the two full-budget rechecks, from experiments/v2/log/Cstar__*.json."""
import json
import sys

import pytest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import comparator_table as C  # noqa: E402


def _log(d, variant, K, M, kind, g_hl, g_d0, e_hl=0.999, e_d0=0.995):
    spec = {"L": 10, "cred": {"K": K, "M": M, "variant": variant}, "tol": 0.16}
    det = {m: {f: {"gain": g, "eff": e} for f in ("D2+H3", "X7-SC")} for m, g, e in (("headline", g_hl, e_hl), ("dev0", g_d0, e_d0))}
    mar = {m: {f: (e - 0.9) / 0.9 for f in ("D2", "D2+H3")} for m, e in (("headline", e_hl), ("dev0", e_d0))}
    mar["dev0"]["D2"] = (e_d0 - 0.005 - 0.9) / 0.9                            # the deciding cell
    (d / f"Cstar__{json.dumps(spec, sort_keys=True, separators=(',', ':'))}__{kind}.json").write_text(json.dumps({"spec": spec, "detail": det, "margins": mar}))


def test_rows_list_inner_and_recheck_runs_with_gains(tmp_path):
    _log(tmp_path, "mem", 6, 20, "inner", 0.0, -0.1767); _log(tmp_path, "mem", 6, 20, "recheck", 0.0966, 0.0381)
    _log(tmp_path, "thr", 12, None, "recheck", 0.0761, 0.0178); _log(tmp_path, "boinc", 10, None, "inner", 0.0, 0.0)
    rows = C.rows(tmp_path)
    assert [(r["config"], r["budget"]) for r in rows] == [("C-boinc", "inner"), ("C-mem(6, 20)", "inner"), ("C-mem(6, 20)", "full"), ("C-thr(12)", "full")]
    assert rows[2]["gain"]["headline"]["D2+H3"] == 0.0966
    t = C.table(rows)
    assert "C-mem(6, 20) & full & 0.097 & 0.038" in t and "C-thr(12) & full & 0.076 & 0.018" in t and "\\ensuremath{-0.177}" in t


def test_rows_carry_the_selection_score_and_its_deciding_cell(tmp_path):
    _log(tmp_path, "mem", 6, 20, "recheck", 0.0966, 0.0381, 0.9974, 0.9944)
    r = C.rows(tmp_path)[0]
    assert r["score"] == pytest.approx((0.9944 - 0.005 - 0.9) / 0.9) and r["decides"] == "dev0, D2"
    assert "0.0993 & dev0, D2 & 0.9894" in C.table([r])                       # score to 4 decimals and the deciding efficiency
% BEGIN-EV2
The registered estimates and decisions below come from the report that the tagged code wrote; the addendum beside it (Section~\ref{sec:design}) adds labels and disclosures. Table~\ref{tab:ph-honest} reports the registered descriptive honest-replacement diagnostic. Tables~\ref{tab:ph-q1}, \ref{tab:ph-doubled}, \ref{tab:ph-q4}, \ref{tab:ph-welfare}, and~\ref{tab:ph-welfare-sens} report exploratory analyses of existing records, and Tables~\ref{tab:ph-stability} and~\ref{tab:ph-q4-stability} the separate registered-configuration stability check; none of these changes a registered estimate or decision. Gains are normalised attacker gains; intervals are those of Table~\ref{tab:rules-v2}. Some descriptive fixed-reference contrasts on fresh1 (\site{r_ext_n} interval entries in the report's per-market Q2 rows) have numerically extreme studentized intervals: the reference-profit contrast there is above rounding scale on only \site{r_ext_seeds} of \site{r_ext_total} seeds (the others are at most \site{r_ext_round} in absolute value), and \site{r_ext_cnt} of the \site{r_ext_tot} frozen resamples (\site{r_ext_share}) omit all three, so their standard error is of rounding size and their bootstrap-t statistics are huge. We retain these frozen outputs, list them in the audit file, and draw no inferential conclusion from them; no other interval in the report has a bound beyond $\const{1000}$ in absolute value.

\paragraph{Age-ranked versus history-based checking (Q1).} Pooled over the six fresh markets, the prescribed searches leave the identity-replacement attacker a measured gain against C$^*$ higher than against R3 by \site{r_q1_d_est} under D2+H3 and by \site{r_q1_x_est} under X7-SC; the mean gains are \site{r_abs_cs} against C$^*$ and \site{r_abs_r3} against R3 under D2+H3, and \site{r_abs_cs_x} and \site{r_abs_r3_x} under X7-SC. Both direction tests reject $d = \const{0}$ (calibrated input $p' = $ \site{r_q1_d_p}; Holm-adjusted $p = $ \site{r_q1_holm} for each). Both intervals lie inside the registered margin of $\pm\const{0.05}$: the categories are ``\site{r_q1_d_cat}'' (D2+H3) and ``\site{r_q1_x_cat}'' (X7-SC), and the separate efficiency label is ``\site{r_q1_d_eff}''. Under the registered margin, R3 is not materially better than the development-selected comparator; the margin of $\pm\const{0.05}$ is half the first test's comparative margin, not an estimated threshold of buyer indifference, and a narrower margin could order the two rules. The difference changes sign across markets: per market (descriptive), it ranges from \site{r_q1_f3_d} on fresh3 to \site{r_q1_f1_d} on fresh1 under D2+H3. Search uncertainty matters at this level: evaluating the doubled-search winners on the same seeds against the same frozen references (Table~\ref{tab:ph-doubled}, exploratory) changes fresh3's difference from \site{r_dbl_f3} to \site{r_dbl_f3_d}, and the pooled differences to \site{r_dbl_pool_d} under D2+H3 and \site{r_dbl_pool_x} under X7-SC; no decision is recomputed. The registered intervals measure seed uncertainty in six fixed markets. Treating the six markets as a sample of the neighbourhood (exploratory), a $t$ interval over the per-market differences is [\site{r_ml_lo}, \site{r_ml_hi}] under D2+H3, with \site{r_ml_pos} of six markets positive, and [\site{r_ml_xlo}, \site{r_ml_xhi}] under X7-SC; with the doubled-search winners it is [\site{r_ml_dlo}, \site{r_ml_dhi}] under D2+H3, with \site{r_ml_dpos} positive. With each rule's strongest training-selected family the interval is [\site{r_env_lo}, \site{r_env_hi}], with \site{r_env_pos} of six markets positive. The direction is therefore fairly stable across these analyses, while the size is not: every upper end is near the margin, so the equivalence label is the most fragile part; the sign itself is not established, since the frozen interval contains zero, the searches share inputs, and another comparator could change it. The frozen D2+H3 interval contains zero and crosses the margin, so this analysis does not establish the category for the neighbourhood; the X7-SC interval excludes zero and lies inside the margin, but that family mostly repeats D2+H3 (below). In relative terms, under D2+H3, the attacker's pooled mean gain against C$^*$ exceeds that against R3 by a fraction of \site{r_rel}. The two Q1 families are close to one test: X7-SC's search starts from the embedded D2+H3 winner, and in \site{r_x7_same} of the \site{r_x7_cells} Q1 cells it selected that winner, with identical evaluated gains; only fresh3 against C$^*$ and fresh4 against R3 differ. With the headline market, the same holds in \site{r_x7_all} of \site{r_x7_all_n} market--rule cells, which is why most of prediction Q3-a's differences are exactly zero. With each rule's strongest training-selected family instead (Table~\ref{tab:q3-envelope}), the pooled difference is \site{r_env_pool}, and \site{r_env_f1} on fresh1, where X5-AG/v2 is C$^*$'s strongest family. C$^*$ was selected in development on gross efficiency in effect, and the full-budget runner-up left a lower development gain than C$^*$ (Section~\ref{sec:rules}); a comparator selected on attacker gain could change the direction label. The two rules differ more in whom they burden than in the attacker's gain. In the registered descriptive honest-replacement diagnostic at the headline market (Table~\ref{tab:ph-honest}), an honest provider replaces its identity at round \const{50}: R3 audits \site{r_hon_r3_0} and \site{r_hon_r3_1} of the replacement's served jobs in its first two ten-round age bins, C$^*$ audits \site{r_hon_cs_0} and \site{r_hon_cs_1} (its lowest bin; \site{r_hon_cs_2} in the next), and B3 about \site{r_hon_b3_0}. Under R3 the replacement earns less per round (relative to C$^*$, a fraction of \site{r_hon_rel}; the registered diagnostic stores bin means, so no interval is available) and loses more receipts to refunds paid to buyers on false audit failures; R3 directs more of the fixed audit capacity to this provider, which does not show higher total audit spending. Both decisions are about the prescribed search procedure: the D2+H3 test uses search-flagged cells, and the X7-SC test uses them through its references (addendum); their nominal error guarantees are not established on the fresh, selected-rule distributions (Section~\ref{sec:design}). The paired descriptive differences in Table~\ref{tab:q1-side} are small for efficiency, audit spending, refunds on false audit failures, and the market service fraction; the reference-profit column is in raw profit units. Splitting $d$ with the same normalisation into the attacked-profit term and the reference-profit term (Table~\ref{tab:ph-q1}, exploratory) shows that almost all of it is attacked profit: the attacker earns more under C$^*$ when it deviates, not when it is truthful.
