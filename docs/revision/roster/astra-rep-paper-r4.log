+CONT = [("menu", "0", "rep2", "F111"), ("menu", "0.03", "rep4", "F111"), ("menu", "0.05", "rep1", "Cstar"), ("cthr", "0.05", "rep3", "Cstar")]
+RULE = {("menu", "F111"): "R3", ("menu", "Cstar"): "C*", ("cthr", "Cstar"): "C-thr"}
