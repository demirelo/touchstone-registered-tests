+"""Driver of the churn replication (docs/revision/followup3/replication-plan.md, draft 3 with the review r3 caveats).
+It calls the frozen functions directly (no change under sim/ or scripts/) and reuses the churn arm's and Run A's helpers.
+Stages, in order (each checks the commitment manifest and the frozen code first, plan section 5):
+  instances    the draw record and stamped manifest -> the six markets, their seeds and salt (no calibration)
+  calibrate    the six calibrated configurations, once, on this machine; their hashes and the container record
+  menu         the matched rules' D2+H3 searches, then their X7-SC searches; references of R3, C*, B3; the follow-up freeze
+  cthr         the runner-up C-thr(12) under the C* label in its own directory: bank copies, searches, reference, freeze
+  gate0        the churn-zero gate: one p = 0 cell through the churn path against the ordinary menu search (all stages)
+  rates        p = 0 evaluation and doubling of the menu winners; p = 0.03, 0.05 churn search, evaluation, doubling, diagnostics
+  continue     the ordered continuation queue of flagged cells (churn-aware adapter; round 1 against this run's doubling)
+  inventory    one inventory.json at the output root (last on each pod; the launcher verifies against it)
+The market labels stay fresh0..fresh5 (the frozen code requires them); every output lives under --out, never under the
+registered results. Usage: rep_v2.py --stage <stage> --out <dir> --manifest <file> [stage options]"""
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+for p in (HERE, HERE.parent / "churn", HERE.parent / "followup2", HERE.parent / "followup", ROOT, ROOT / "scripts"):
+    if str(p) not in sys.path:
+        sys.path.insert(0, str(p))
+
+import commitment as K  # noqa: E402
+
+MARKETS = tuple(f"fresh{i}" for i in range(6))
+TARGETS = ("F111", "C*", "F000")                     # R3, C*, B3
+RATES = (0.03, 0.05)
+FAMS = ("D2+H3", "X7-SC")
+CONT_RATE_ORDER = (0.05, 0.03, 0.0)                  # plan section 4: the continuation queue order
+CONT_RULE_ORDER = ("F111", "C*", "Cthr", "F000")
+
+
+def _refuse(msg: str):
+    raise SystemExit(f"replication refused: {msg}")
+
+
+# ---- pure helpers (tested) ------------------------------------------------------------------------------------------
+
+def continuation_queue(flagged: list[dict]) -> list[dict]:
+    """The flagged cells in the fixed order: rate 0.05, 0.03, 0; markets fresh0..5; rules R3, C*, C-thr, B3.
+    Each item: {"rate": float, "market": str, "rule": "F111" | "C*" | "Cthr" | "F000", ...}."""
+    rk = {r: i for i, r in enumerate(CONT_RATE_ORDER)}; uk = {r: i for i, r in enumerate(CONT_RULE_ORDER)}
+    bad = [c for c in flagged if c["rate"] not in rk or c["rule"] not in uk or c["market"] not in MARKETS]
+    if bad:
+        _refuse(f"unknown cells in the flag list: {bad[:3]}")
+    return sorted(flagged, key=lambda c: (rk[c["rate"]], MARKETS.index(c["market"]), uk[c["rule"]]))
+
+
+def resume_point(queue: list[dict], passed: set) -> int:
+    """A resume continues the same queue from the first cell without a passing record (plan section 4)."""
+    for i, c in enumerate(queue):
+        if c["id"] not in passed:
+            return i
+    return len(queue)
+
+
+def admit_workers(requested: int, limit_bytes: int | None, peak_bytes: float, parent_bytes: float = 2e9, headroom: float = 1.25) -> int:
+    """Pod-memory admission (plan section 5): the largest worker count whose measured peak with 25 percent headroom,
+    plus the parent, fits the pod's cgroup limit; at least 1 only if one task fits, else refuse."""
+    if limit_bytes is None:
+        return requested
+    fit = int((limit_bytes - parent_bytes) // (peak_bytes * headroom))
+    if fit < 1:
+        _refuse(f"one task needs {peak_bytes * headroom / 1e9:.1f} GB with headroom; the limit is {limit_bytes / 1e9:.1f} GB")
+    return min(requested, fit)
+
+
+def check_params_listed(manifest, params) -> None:
+    """The parameter file is one the manifest lists (plan section 5: the parameter files are committed)."""
+"""Analysis of the churn replication (docs/revision/followup3/replication-plan.md, sections 2 and 3), fixed before the
+draw. Input per winner set: recs[rate][market][rule] = per-seed lists {"gain", "attack", "reference", "eff_attack",
+"seeds"} for markets rep0..rep5, rules R3, C*, C-thr, B3 and rates "0", "0.03", "0.05"; audit[rate][market] =
+(audited jobs, served jobs) of the attacker under R3. Output: the paired changes from each market's own no-churn value,
+the descriptive support criterion and its material companion, the five expectations, the absolute contrasts, the attack
+and reference terms and efficiency under attack, and the seed-bootstrap intervals with one index vector per market
+shared by every rule, rate and winner set. A missing cell makes what needs it "not scorable"; a malformed cell (nonfinite
+values, unequal seed vectors within a market) is refused. Exploratory; intervals omit search uncertainty."""
+import math
+
+import numpy as np
+
+MARKETS = tuple(f"rep{i}" for i in range(6))
+RULES = ("R3", "C*", "C-thr", "B3")
+CONTRASTS = {"d": "C*", "q": "B3", "u": "C-thr"}   # x = g(comparator) - g(R3)
+RATES = ("0.03", "0.05")
+ALL_RATES = ("0",) + RATES
+T5 = 2.570581835636314                             # 0.975 quantile of Student's t, 5 degrees of freedom
+MATERIAL = -0.05                                   # the registered Q1 margin
+RESAMPLES, SEED = 9999, 0
+FIELDS = ("gain", "attack", "reference", "eff_attack")
+
+
+def _mean(xs):
+    return sum(xs) / len(xs)
+
+
+def _finite(xs) -> bool:
+    return bool(xs) and all(isinstance(x, (int, float)) and math.isfinite(x) for x in xs)
+
+
+def _check(gains: dict) -> None:
+    """Every present cell finite; within a market every rule and rate has the same number of seeds."""
+    for m in MARKETS:
+        lens = set()
+        for p in ALL_RATES:
+            for r, xs in (gains.get(p, {}).get(m) or {}).items():
+                if not _finite(xs):
+                    raise ValueError(f"{p} {m} {r}: missing or nonfinite gains")
+                lens.add(len(xs))
+        if len(lens) > 1:
+            raise ValueError(f"{m}: unequal seed vectors {sorted(lens)}")
+
+
+def _check_recs(recs: dict) -> None:
+    for m in MARKETS:
+        seeds = None
+        for p in ALL_RATES:
+            for r, c in (recs.get(p, {}).get(m) or {}).items():
+                for f in FIELDS:
+                    if not _finite(c.get(f)):
+                        raise ValueError(f"{p} {m} {r}: missing or nonfinite {f}")
+                if len({len(c[f]) for f in FIELDS} | {len(c["seeds"])}) != 1:
+                    raise ValueError(f"{p} {m} {r}: fields of unequal length")
+                if seeds is None:
+                    seeds = list(c["seeds"])
+                elif list(c["seeds"]) != seeds:
+                    raise ValueError(f"{p} {m} {r}: seeds differ from the market's other cells")
+
+
+def gains_of(recs: dict) -> dict:
+    return {p: {m: {r: list(c["gain"]) for r, c in rs.items()} for m, rs in ms.items()} for p, ms in recs.items()}
+
+
+def _t95(xs: list) -> list:
+    n = len(xs); m = _mean(xs); sd = math.sqrt(sum((x - m) ** 2 for x in xs) / (n - 1))
+    half = T5 * sd / math.sqrt(n)
+    return [m - half, m + half]
+
+
+def contrast(cell: dict, comparator: str):
+    """Mean of g(comparator) - g(R3) over the seeds of one market, or None if a rule is missing."""
+    if comparator not in cell or "R3" not in cell:
+        return None
+    return _mean(cell[comparator]) - _mean(cell["R3"])
+
+
+def _cell(gains, p, m):
+    return gains.get(p, {}).get(m) or {}
+
+
+def paired_changes(gains: dict) -> dict:
+    """Delta_x(m, p) = x(m, p) - x(m, 0) per contrast and positive rate over the six named markets; mean, market t interval
+    and markets lower. A market missing a needed rule at either rate leaves that contrast incomplete."""
+    _check(gains)
+    out = {}
+    for p in RATES:
+        out[p] = {}
+        for x, comp in CONTRASTS.items():
+            ms = {}
+            for m in MARKETS:
+                a, b = contrast(_cell(gains, p, m), comp), contrast(_cell(gains, "0", m), comp)
+                if a is not None and b is not None:
+                    ms[m] = a - b
+            vals = list(ms.values())
+            out[p][x] = {"markets": ms, "complete": len(ms) == len(MARKETS),
+                         "mean": _mean(vals) if vals else None, "t95": _t95(vals) if len(ms) == len(MARKETS) else None,
+                         "lower": sum(1 for v in vals if v < 0)}
+    return out
+
+
+def criteria(pc: dict) -> dict:
+    """Support (descriptive): mean < 0 and at least 5 of 6 markets lower; material: mean <= -0.05. None if incomplete."""
+    out = {}
+    for p, xs in pc.items():
+        out[p] = {}
+        for x, r in xs.items():
+            if not r["complete"]:
+                out[p][x] = None; continue
+            out[p][x] = {"support": r["mean"] < 0 and r["lower"] >= 5, "material": r["mean"] <= MATERIAL}
+    return out
+
+
+def _verdict(*conds):
+    if any(c is None for c in conds):
+        return "not scorable"
+    return "met" if all(conds) else "not met"
+
+
+def expectations(crit: dict, audit: dict) -> dict:
+    s = lambda p, x: None if crit.get(p, {}).get(x) is None else crit[p][x]["support"]
+    below = None
+    if all(m in audit.get("0", {}) and m in audit.get("0.05", {}) for m in MARKETS):
+        n = 0
+        for m in MARKETS:
+            (a0, s0), (a5, s5) = audit["0"][m], audit["0.05"][m]
+            if s0 and s5 and a5 / s5 < a0 / s0:             # a zero denominator at either rate counts as not below
+                n += 1
+        below = n >= 5
+    return {"1": {"text": "support for d at p = 0.05", "verdict": _verdict(s("0.05", "d"))},
