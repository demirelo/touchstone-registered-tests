def load(report_path, extra: dict | None = None) -> dict:
    """report.json at the top level; each extra source (name -> path: cells.json, scoring.json) under its own name."""
    data = json.loads(Path(report_path).read_text())
    for name, path in (extra or {}).items():
        if name in data:
            raise ValueError(f"extra source name {name} collides with a report key")
        data[name] = json.loads(Path(path).read_text())
    return data


def write(report_path, numbers_path, extra: dict | None = None) -> None:
    Path(numbers_path).write_text(render(load(report_path, extra), _sites(numbers_path)))


def _blocks(tex: str) -> tuple[list[str], list[str]]:
    blocks, problems, cur = [], [], None
    for n, line in enumerate(tex.splitlines(), 1):
        s = line.strip()
        if s == "% BEGIN-EV2":
            if cur is not None:
                problems.append(f"line {n}: nested BEGIN-EV2")
            cur = []
        elif s == "% END-EV2":
            if cur is None:
                problems.append(f"line {n}: END-EV2 without BEGIN-EV2")
            else:
                blocks.append("\n".join(cur)); cur = None
        elif cur is not None and not s.startswith("%"):
            cur.append(line)
    if cur is not None:
        problems.append("unclosed BEGIN-EV2 block")
    return blocks, problems


def strip_comments(text: str) -> str:
    """Remove LaTeX comments (a % after an even number of backslashes), keeping the region marker lines."""
    out = []
    for line in text.splitlines():
        if line.strip() in ("% BEGIN-EV2", "% END-EV2"):
            out.append(line.strip()); continue
        cut, i = len(line), 0
        while i < len(line):
            if line[i] == "%":
                k = i
                while k > 0 and line[k - 1] == "\\":
                    k -= 1
                if (i - k) % 2 == 0:
                    cut = i; break
            i += 1
