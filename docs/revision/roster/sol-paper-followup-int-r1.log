def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    for k in ("--records", "--report", "--stability", "--out", "--tables"):
        ap.add_argument(k, required=True)
    a = ap.parse_args(argv)
    out = Path(a.records); report = json.loads(Path(a.report).read_text()); stab = json.loads(Path(a.stability).read_text())
    res = {"label": "exploratory, after the report; not registered",
           "q1_split": {f: split(out, FRESH, "C*", "F111", f) for f in ("D2+H3", "X7-SC")},
           "welfare": {r: welfare_mixtures(out, r) for r in ("F000", "F111", "C*")},
           "q4_diag": q4_diagnostics(out), "stability": stability(report, stab),
           "doubled": doubled(out, report, FRESH), "honest": honest(report)}
    res["market_level"] = market_level(res["doubled"]); res["x7_embedding"] = x7_embedding(out, FRESH); res["x7_embedding_all"] = x7_embedding(out, FRESH + ("headline",))
    res["envelope"] = envelope_difference(report, FRESH); res["doubling_flags"] = doubling_flags(report)
    res["direct_priority"] = direct_priority(out, FRESH); res["nesting"] = nesting(out, report, FRESH + ("headline",))
    res["envelope_interval"] = envelope_interval(res["envelope"]); res["honest_cost"] = {"relative": honest_relative(res["honest"])}
    Path(a.out).write_text(json.dumps(res, indent=1) + "\n")
    import csv
    seeds = [row for r in ("F000", "F111", "C*") for row in seed_rows(out, r)]
    with open(Path(a.out).with_name("lottery_seeds.csv"), "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=list(seeds[0])); w.writeheader(); w.writerows(seeds)
def _sites(path) -> dict | None:
    """The result-site manifest: site name -> {path, kind, section}; read from beside the given file when present."""
    f = Path(path).parent / "sites.json"
    return json.loads(f.read_text()) if f.exists() else None


def load(report_path, extra: dict | None = None) -> dict:
    """report.json at the top level; each extra source (name -> path: cells.json, scoring.json) under its own name."""
    data = json.loads(Path(report_path).read_text())
    for name, path in (extra or {}).items():
        if name in data:
            raise ValueError(f"extra source name {name} collides with a report key")
        data[name] = json.loads(Path(path).read_text())
    return data


def write(report_path, numbers_path, extra: dict | None = None) -> None:
    Path(numbers_path).write_text(render(load(report_path, extra), _sites(numbers_path)))


def _blocks(tex: str) -> tuple[list[str], list[str]]:
    blocks, problems, cur = [], [], None
    for n, line in enumerate(tex.splitlines(), 1):
        s = line.strip()
        if s == "% BEGIN-EV2":
            if cur is not None:
                problems.append(f"line {n}: nested BEGIN-EV2")
            cur = []
        elif s == "% END-EV2":
            if cur is None:
                problems.append(f"line {n}: END-EV2 without BEGIN-EV2")
            else:
                blocks.append("\n".join(cur)); cur = None
        elif cur is not None and not s.startswith("%"):
            cur.append(line)
    if cur is not None:
        problems.append("unclosed BEGIN-EV2 block")
    return blocks, problems


def strip_comments(text: str) -> str:
    """Remove LaTeX comments (a % after an even number of backslashes), keeping the region marker lines."""
    out = []
    for line in text.splitlines():
        if line.strip() in ("% BEGIN-EV2", "% END-EV2"):
            out.append(line.strip()); continue
        cut, i = len(line), 0
        while i < len(line):
            if line[i] == "%":
                k = i
                while k > 0 and line[k - 1] == "\\":
                    k -= 1
                if (i - k) % 2 == 0:
                    cut = i; break
            i += 1
        out.append(line[:cut])
