def doubling_report(kind: str, old: dict, new: dict) -> dict:
    """Changes in the objective's units (design 6.5): profit (attack and reference normalised profit), welfare (gross
    efficiency, lower is a better attack), w1 (efficiency and feasibility), coalition (objective)."""
    rep = {"kind": kind}
    if kind == "profit":
        rep["attack_change"] = float(new["attack_f"] - old["attack_f"]); rep["reference_change"] = float(new["ref_f"] - old["ref_f"])
        changes = [rep["attack_change"], rep["reference_change"]]
    elif kind in ("welfare", "w1"):
        rep["efficiency_change"] = float(old["eff"] - new["eff"]) if old.get("eff") is not None and new.get("eff") is not None else 0.0
        changes = [rep["efficiency_change"]]
        if kind == "w1":
            rep["feasibility_transition"] = bool(old.get("feasible") is False and new.get("feasible") is True)
    elif kind == "coalition":
        rep["objective_change"] = float(new["f"] - old["f"]); changes = [rep["objective_change"]]
    else:
        raise ValueError(kind)
    rep["incomplete"] = bool(any(c >= THRESHOLD - 1e-12 for c in changes) or rep.get("feasibility_transition", False))
    return rep


def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
        _, rrec, _ = reference_of(job, out)
        cands, fams, _ = menu(job, out, cuts, h4_excluded)
        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
    if job["objective"] in ("W0", "W1"):
        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
        continue_search(obj, fam, st, orig)
        sel_old = rec["selected"]
        old_eff = obj.extra[exact_key(sel_old)]["eff"] if sel_old is not None else None
        sel = select_w1(obj) if job["objective"] == "W1" else dict(max(obj.archive.values(), key=lambda e: e.f).knobs)
        new_eff = obj.extra[exact_key(sel)]["eff"] if sel is not None else None
        held = None
        if sel is not None:
            fr = run_focal(eval_cell(job), lambda: fam.make(dict(sel)), SeedCache())
            held = {"knobs": dict(sel), "seeds": list(eval_cell(job).seeds), "eff": gross_efficiency(fr.results).tolist()}
        return {**doubling_report("w1" if job["objective"] == "W1" else "welfare", {"eff": old_eff, "feasible": sel_old is not None},
                                  {"eff": new_eff, "feasible": sel is not None}), "heldout": held}
    m = job["mkt"]; fam = family_for(job["family"], T, L); orig = search_from_json(rec["coalition"])
    if job["objective"] == "total":
        obj = _coalition_objective(job, "total", np.zeros((len(_members(job)), len(m["seeds_train"]))), cache)
        new = continue_search(obj, fam, st, orig)
        return {**doubling_report("coalition", {"f": orig.best_f}, {"f": max(new.best_f, orig.best_f)}),
                "heldout": _coalition_heldout(job, _desc(job, new.best_knobs), out)}
    ctx, tag = job["context"], _coalition_tag(job)                  # G_min: every score against the final reference (design 6.3)
    ref = np.asarray(read(path_of(out, f"joint_reference/{ctx}/{tag}"))["member_normalized"])
    sel = read(path_of(out, f"coalition_select/{ctx}/{tag}"))["winners"][job["id"]]
    orig = rescore_min(orig, rec["rows"], ref)
    obj = _coalition_objective(job, "min", ref, cache)
    new = continue_search(obj, fam, st, orig)
    win, f = (_desc(job, new.best_knobs), new.best_f) if new.best_f > sel["score"] else (sel["descriptor"], sel["score"])   # step 6's winner stays in
    return {**doubling_report("coalition", {"f": sel["score"]}, {"f": f}), "heldout": _coalition_heldout(job, win, out)}


def _coalition_heldout(job: dict, desc: dict, out: Path) -> dict:
        if bad:                                                          # a damaged current record is recomputed, not skipped
            raise ValueError(bad)
    if reusable(p, old, prov, check):
        return "skipped"
    write(p, stage_cross(ctx, fam, catalog, out))
    return "done"


def _run_reference(item: dict, out: Path, cuts: int, h4_excluded: bool, catalog: list[dict]) -> str:
    rid = item["id"]; p = path_of(out, rid); old = read(p)
    if reusable(p, old, reference_provenance(item), lambda: check_record(rid, old, catalog, out, cuts, h4_excluded)):
        return "skipped"
    rec = stage_reference(item, out, cuts, h4_excluded); up = rec.pop("upstream")
    write(p, {"stage": "reference", "provenance": reference_provenance(item), "upstream": up, **rec})
    return "done"


def _run_one(stage: str, job: dict, out: str, cuts: int, h4_excluded: bool, catalog: list | None = None) -> str:
    out = Path(out); catalog = catalog or [job]
    if stage == "reference":
        return _run_reference(job, out, cuts, h4_excluded, catalog)
    if stage == "cross":
        return _run_cross(job, out, catalog)
    if stage in COALITION_STEPS:
        return coalition_step(stage, job, out, catalog)
    p = _stage_record_path(stage, job, out); rec = read(p)
    want = stage_upstream(stage, job, catalog, cuts, h4_excluded)
    def check():
        if set(rec.get("upstream") or {}) != want:
            raise ValueError("dependency set")
        validate(job, stage, rec, {u: path_of(out, u) for u in want})
        if stage == "evaluate":                                         # a damaged current record is recomputed, not skipped
            bad = _schema_problems(job, rec, len(job["mkt"]["seeds_eval"]))
            if bad:
                raise ValueError(bad)
        if stage == "doubling" and "heldout" not in rec:
            raise ValueError("doubling record without its held-out diagnostic")
    if reusable(p, rec, job["provenance"], check):
        return "skipped"
    body = {"search": stage_search, "dependent": stage_dependent, "evaluate": stage_evaluate}.get(stage)
    rec = body(job, out) if body else stage_doubling(job, out, cuts, h4_excluded)
    upstream = rec.pop("upstream", None)
    if stage in ("evaluate", "doubling") or upstream is None:
        upstream = {u: sha_file(path_of(out, u)) for u in sorted(want)}
    write(p, {"stage": stage, "id": job["id"], "provenance": job["provenance"], "upstream": upstream, **rec})
    return "done"


def _pool(stage, jobs, out, workers, cuts, h4_excluded, catalog=None) -> list:
    if workers <= 1 or len(jobs) <= 1:
        return [_run_one(stage, j, str(out), cuts, h4_excluded, catalog) for j in jobs]
    with ProcessPoolExecutor(max_workers=workers) as ex:
        n = len(jobs)
        return list(ex.map(_run_one, [stage] * n, jobs, [str(out)] * n, [cuts] * n, [h4_excluded] * n, [catalog] * n))


from __future__ import annotations

from dataclasses import dataclass
from typing import Callable

import numpy as np

from .cell import Abstain, Cell, SeedCache, run_focal
from .metrics import harm
from .policies.families import Family, exact_key
from .policies.honest import HonestMax
from .search import Objective, SearchResult, SearchSettings, best_archived, cma_search

REFERENCE_ORDER = ("abstain", "honest_max", "twin_search", "attack_projection", "archive_clip1", "archive_truthful_clip0", "bank")


@dataclass(frozen=True)
class Candidate:
    name: str
    policy_factory: Callable
    knobs: dict | None
    known_profit: np.ndarray | None = None
    known_normalized: np.ndarray | None = None


@dataclass
class ReferenceChoice:
    candidate: Candidate
    per_seed_profit: np.ndarray
    per_seed_normalized: np.ndarray
    scores: dict


def twin_search(cell: Cell, family: Family, cache: SeedCache, settings: SearchSettings, seed: int) -> SearchResult:
    starts = family.registered_starts({"near_corner": settings.near_corner, "sobol_seed": settings.sobol_seed}, twin=True)
    return cma_search(Objective(cell, family, cache, force_clip=True), family, settings, seed, starts=starts)


def attack_search(cell: Cell, family: Family, cache: SeedCache, settings: SearchSettings, seed: int, twin: SearchResult) -> SearchResult:
    """Attack search with the twin best and the honest-max point as registered incumbents (spec 5.2)."""
    return cma_search(Objective(cell, family, cache), family, settings, seed,
                      incumbents={"twin_best": twin.best_knobs, "honest_point": family.honest_point()})


def _factory(family: Family, knobs: dict) -> Callable:
    return lambda: family.make(knobs)


def _known(entry) -> dict:
    return {} if entry is None else {"known_profit": entry.per_seed_profit, "known_normalized": entry.per_seed_normalized}


def reference_candidates(cell: Cell, family: Family, attack: SearchResult, twin: SearchResult,
                         bank_members: list[dict], order=REFERENCE_ORDER) -> list[Candidate]:
    """Every reference candidate in projected form, in registered tie order (spec 5.2); de-duplicated by exact key."""
    n = len(cell.seeds)
    groups: dict[str, list[Candidate]] = {}
    groups["abstain"] = [Candidate("abstain", Abstain, None, np.zeros(n), np.zeros(n))]
    groups["honest_max"] = [Candidate("honest_max", HonestMax, None)]
    tw = family.project(twin.best_knobs)
    groups["twin_search"] = [Candidate("twin_search", _factory(family, tw), tw, **_known(twin.archive.get(exact_key(tw))))]
    proj = family.project(attack.best_knobs)
    groups["attack_projection"] = [Candidate("attack_projection", _factory(family, proj), proj, **_known(attack.archive.get(exact_key(proj))))]
    e1 = best_archived(attack.archive, clip=1)
    groups["archive_clip1"] = [] if e1 is None else [Candidate("archive_clip1", _factory(family, e1.knobs), dict(e1.knobs), **_known(e1))]
    e0 = best_archived(attack.archive, clip=0, truthful_only=True)
    if e0 is None:
        groups["archive_truthful_clip0"] = []
    else:   # never inflated on dev-train: its projection has the same trajectory, so its observed values are its projected values
        p0 = family.project(e0.knobs)
        groups["archive_truthful_clip0"] = [Candidate("archive_truthful_clip0", _factory(family, p0), p0, **_known(e0))]
    groups["bank"] = [Candidate(f"bank_{i}", _factory(family, family.project(m)), family.project(m)) for i, m in enumerate(bank_members)]
    out, seen = [], set()
    for g in order:
        for c in groups.get(g, []):
            key = exact_key(c.knobs) if c.knobs is not None else ("name", c.name)
            if key in seen:
                continue
            seen.add(key); out.append(c)
    return out


def select_reference(cell: Cell, candidates: list[Candidate], cache: SeedCache) -> ReferenceChoice:
    """Highest mean normalized profit on the cell's seeds; ties to the earlier candidate; known values need no run."""
    best, scores = None, {}
    for c in candidates:
        if c.known_normalized is not None and len(c.known_normalized) == len(cell.seeds):
            profit, norm = c.known_profit, c.known_normalized
        else:
            fr = run_focal(cell, c.policy_factory, cache)
            profit, norm = fr.profit, fr.normalized
        score = float(norm.mean())
        scores[c.name] = score
        if best is None or score > best[0]:
            best = (score, c, profit, norm)
    _, c, profit, norm = best
    return ReferenceChoice(candidate=c, per_seed_profit=np.asarray(profit, dtype=float), per_seed_normalized=np.asarray(norm, dtype=float), scores=scores)


