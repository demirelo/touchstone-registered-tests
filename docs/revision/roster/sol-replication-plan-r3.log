        R.train_cell, R.select_reference, R.reference_of = _ORIG["train_cell"], _ORIG["select_reference"], _ORIG["reference_of"]
        _ORIG.clear(); _REF_CACHE.clear()


def churn_job(job: dict, p: float) -> dict:
    rid = f"{job['id']}|churn{p:g}"
    return {**job, "id": rid, "churn": float(p), "provenance": {**job["provenance"], "id": rid, "churn": float(p)}}


def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, p: float, markets=MARKETS, rules=RULES, smoke: bool = False) -> list[dict]:
    jobs = []
    for m in markets:
        mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
        jobs += [churn_job(R.job(mkt, r, "D2+H3", "profit", smoke=smoke, params=params), p) for r in rules]
    return jobs


def _init_worker() -> None:
    install()


def run_stage(stage: str, jobs: list[dict], out, workers: int = 1) -> list[str]:
    install()
    if workers <= 1 or len(jobs) <= 1:
        return [R._run_one(stage, j, str(out), F.CUTS, F.H4_EXCLUDED, jobs) for j in jobs]
    with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
        n = len(jobs)
        return list(ex.map(R._run_one, [stage] * n, jobs, [str(out)] * n, [F.CUTS] * n, [F.H4_EXCLUDED] * n, [jobs] * n))


def _newest_by_first_offer(r, focal: int) -> float:
    """The mechanism-relevant statistic (sim/mechanisms/factorial.py: R3 ages an identity from its first offer and ranks
    the identities holding assigned jobs): over the rounds in which the focal identity holds assigned jobs, the share in
    which its first-offer round is strictly the latest among the identities holding assigned jobs."""
    first: dict = {}; hits = n = 0
    for t, h in enumerate(r.history):
        for i in getattr(h, "offers", {}) or {}:
            first.setdefault(int(i), t)
        holders = {int(i) for i in h.assignment.values()}
        mine = [i for i in holders if r.entity_of[i] == focal]
        if not mine:
            continue
        n += 1; f = first.get(mine[0], t); latest = max(first.get(i, t) for i in holders)
        hits += int(f == latest and sum(1 for i in holders if first.get(i, t) == latest) == 1)
    return hits / n if n else 0.0


def _uniquely_newest(r, focal: int) -> float:
    """Creation-time newest among the current identities: the share of rounds in which the focal provider's current
    identity has strictly the latest creation round (initial identities tie at round 0). Not the order R3 uses."""
    T = len(r.history); born = list(r.identity_round); ent = list(r.entity_of); hits = 0
    for t in range(T):
        cur = {}
        for i, (e, b) in enumerate(zip(ent, born)):
            if b <= t:
                cur[e] = i                                              # identities are numbered in creation order
        newest = max(born[i] for i in cur.values()); f = born[cur[focal]]
        hits += int(f == newest and sum(1 for i in cur.values() if born[i] == newest) == 1)
    return hits / T if T else 0.0



def newcomer_shares(results, focal: int, edges=AGE_EDGES) -> dict:
    """Audited share of served jobs by identity age (rounds since creation) for honest replacement identities, honest
    initial identities, and the focal provider's identities: per episode [served, audited] counts per age bin, and the
    pooled share per bin (None, "unavailable", when no job was served in the bin); honest replacements per episode; and
    per episode the share of rounds in which the focal identity is uniquely the newest."""
    cats = ("honest_replacement", "honest_initial", "focal"); nb = len(edges) - 1
    per, reps, newest, offer_newest = [], [], [], []
    for r in results:
        cnt = {c: [[0, 0] for _ in range(nb)] for c in cats}
        reps.append(sum(1 for i, e in enumerate(r.entity_of) if e != focal and r.identity_generation[i] > 0))
        cat = lambda i: "focal" if r.entity_of[i] == focal else ("honest_replacement" if r.identity_generation[i] > 0 else "honest_initial")
        for t, h in enumerate(r.history):
            def put(i, k):
                age = t - r.identity_round[i]
                for b in range(nb):
                    if edges[b] <= age < edges[b + 1]:
                        cnt[cat(i)][b][k] += 1; return
            for i in h.assignment.values():
                put(i, 0)
            for a in h.audits:
                put(a.provider, 1)
        per.append(cnt); newest.append(_uniquely_newest(r, focal)); offer_newest.append(_newest_by_first_offer(r, focal))
    out = {}
    for c in cats:
        rows = []
        for b in range(nb):
            sv = sum(e[c][b][0] for e in per); au = sum(e[c][b][1] for e in per)
            rows.append({"age": [edges[b], edges[b + 1]], "served": sv, "audited": au, "share": (au / sv if sv else None)})
        out[c] = rows
    out["per_episode"] = per
    out["honest_replacements_per_episode"] = float(sum(reps) / len(reps)) if reps else 0.0
    out["focal_newest_by_creation"] = newest
    out["focal_newest_by_first_offer_assigned"] = offer_newest
    return out


def pool_markets(by_market: dict, cat: str) -> list:
    """Equal market weights: per age bin, the mean of the market shares over the markets where the share is available."""
    nb = len(next(iter(by_market.values()))[cat]); res = []
    for b in range(nb):
        v = [m[cat][b]["share"] for m in by_market.values() if m[cat][b]["share"] is not None]
        res.append({"share": (sum(v) / len(v) if v else None), "markets": len(v)})
    return res


def _diag_one(job: dict, out: str) -> tuple:
    import numpy as np
    from sim.cell import SeedCache, run_focal
    install(); j = job
    T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j)
    pols = {"base": read(R.path_of(out, j["id"]))["attack"]["best_knobs"],
            "doubled": read(Path(out) / "doubling" / (R._safe(j["id"]) + ".json"))["heldout"]["knobs"]}
    row = {}
    for k, knobs in pols.items():
        fr = run_focal(cell, lambda knobs=knobs: fam.make(dict(knobs)), SeedCache())
        row[k] = {"knobs": knobs, "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
                  "mean_normalized": float(np.mean(fr.normalized)), "shares": newcomer_shares(fr.results, cell.focal)}
    return f"{j['context']}|{j['rule']}", row


def diagnostics(out, jobs: list[dict], workers: int = 1) -> dict:
    """Plan section 4 (draft 2): the base and the doubled winner of each churn cell rerun on the evaluation seeds under
    churn, with per-seed normalised profits and newcomer audit counts; and, per rule and winner, the age-bin shares pooled
    over markets with equal weights."""
def install_salt(root: str, out: Path) -> Path:
    """Write the fresh root's identity salt under --out and point the harness at it before any episode."""
    p = Path(out) / "salt.hex"; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(INST.identity_salt_hex(root))
    os.environ[SALT_ENV] = str(p)
    return p


@lru_cache(maxsize=4)
def _fresh(root: str) -> tuple:
    return tuple(m["cfg"] for m in INST.markets(root, 6))


@lru_cache(maxsize=32)
def _market_cfg(label: str, root: str, rho: float):
    if label == "headline":
        return cell_config(market_config_from_locked(load_locked()), load_calibration(ROOT / "experiments/calibration.json"), rho=rho, beta=0.05)
    if label.startswith("dev"):
        base = INST.dev_markets()[int(label[3:])]["cfg"]
    elif label.startswith("fresh"):
        base = _fresh(root)[int(label[5:])]
    else:
        raise ValueError(f"unknown market {label!r}")
    return INST.calibrated(base, rho=rho)


def market(label: str, root: str, rho: float = 0.2, dev: bool = False, smoke: bool = False, cfg=None, commit: str | None = None,
           salt_sha256: str | None = None) -> dict:
    """`cfg`, `commit`, and `salt_sha256` come from recorded inputs when given (the verify stage), so no calibration
    episode, git process, or salt read happens."""
    cfg = cfg if cfg is not None else _market_cfg(label, root, float(rho))
    train, val = list(range(1000, 1005)), list(range(2000, 2020))
    ev = val if dev else INST.eval_seeds(root, label)
    if smoke:
        train, ev = train[: SMOKE[2]], ev[: SMOKE[3]]
    out = {"label": label, "root": root, "rho": float(rho), "dev": bool(dev), "smoke": bool(smoke), "cfg": cfg, "focal": int(positions(cfg)["median"]),
           "seeds_train": train, "seeds_val": val, "seeds_eval": list(ev), "context": MAN.context(label, float(rho))}
    if commit is not None:
        out["commit"] = str(commit)
    if salt_sha256 is not None:
        out["salt_sha256"] = str(salt_sha256)
    return out


def manifest_ctx(ctx: str) -> str:
    """Development contexts run the fresh0 template of the manifest."""
    label, rest = ctx.split("@", 1)
    return f"fresh0@{rest}" if label.startswith("dev") else ctx


def rule_spec(rule: str, params: dict | None) -> dict:
    p = params or {}
    if rule in FIXED:
        spec = {"tol": 0.16, "L": 10}
    elif rule == "B2":
        b2 = registered_b2_params(); spec = {"tol": float(b2["tol"]), "L": int(b2["L"]), "b2": b2}
    else:
        t = (p.get("tuned") or {}).get(rule)
        if t is None:
            raise SystemExit(f"{rule}: no tuned parameters in --params")
        spec = {"tol": float(t["tol"]), "L": int(t["L"])}
    if rule.startswith("C*"):
        if not p.get("cred"):
            raise SystemExit(f"{rule}: no comparator (cred) in --params")
        spec["cred"] = dict(p["cred"])
    return spec


def rule_factory(job: dict):
    s = job["spec"]
    return lambda: make_rule(job["rule"], s["tol"], s["L"], cred=s.get("cred"), b2_params=s.get("b2"))


def constants(job: dict) -> tuple[int, int]:
    rule = rule_factory(job)()
    pc = public_constants(rule, job["mkt"]["cfg"])
    return pc["T"], pc["L"]


@lru_cache(maxsize=8)
def _h4(path: str, sha: str):
    return load_h4(Path(path), sha)


def family_for(name: str, T: int, L: int, h4: dict | None = None) -> Family:
    if name == "H4":
        src = _h4(h4["dir"], h4["sha"]) if h4 else Excluded("no bundle")
        if isinstance(src, Excluded):
            raise SystemExit(f"H4 excluded: {src.reason}")
        return FV2.family_for(name, T, L, src)
    return FV2.family_for(name, T, L)


def cell_id(ctx: str, rule: str, family: str, objective: str, c=None, schedule=None) -> str:
    return f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")


@lru_cache(maxsize=1)
def _cells_by_id() -> dict:
    return {c["id"]: c for c in MAN.cells()}


def job(mkt: dict, rule: str, family: str, objective: str = "profit", c: int | None = None, schedule: str | None = None,
        smoke: bool = False, params: dict | None = None, h4: dict | None = None, block: str | None = None) -> dict:
    lk = load_locked(); s = lk["search"]
    R, E, n_train, n_eval = SMOKE if (smoke or mkt["smoke"]) else (int(s["restarts"]), int(s["evals_per_restart"]), len(mkt["seeds_train"]), len(mkt["seeds_eval"]))
    if family in ("X7-SC", "H4"):                   # H4 is priced and searched as an X7-SC cell (design draft 7, 5.3)
        E *= 2
    spec = rule_spec(rule, params)
    j = {"id": cell_id(mkt["context"], rule, family, objective, c, schedule), "context": mkt["context"], "rule": rule, "family": family,
         "objective": objective, "c": c, "schedule": schedule, "budget": [R, E, n_train, n_eval], "spec": spec, "mkt": mkt,
         "h4": h4 if family == "H4" else None}
    cell = _cells_by_id().get(j["id"].replace(j["context"], manifest_ctx(j["context"]), 1))
    j["block"] = block or (cell or {}).get("block"); j["priority"] = MAN.priority(cell) if cell else 3      # execution priority (design 8.2)
    j["provenance"] = context_provenance(mkt) | {"budget": j["budget"], "rule_params_sha256": _sha_json(spec), "id": j["id"]}
    if family == "H4" and h4:
        j["provenance"]["h4_sha256"] = str(h4["sha"])
    return j


def context_provenance(mkt: dict) -> dict:
    return {"git_commit": mkt.get("commit") or git_commit(), "runner_sha256": _sha(Path(__file__).read_bytes()), "cfg_sha256": _sha_json(cfg_to_dict(mkt["cfg"])),
            "salt_sha256": mkt.get("salt_sha256") or _sha(load_identity_salt()), "root": mkt["root"], "seeds_train": mkt["seeds_train"],
            "seeds_val": mkt["seeds_val"], "seeds_eval": mkt["seeds_eval"], "context": mkt["context"]}


def settings(job: dict) -> SearchSettings:
    R, E, _, _ = job["budget"]
    return replace(settings_from_locked(load_locked()), restarts=int(R), evals_per_restart=int(E))


def train_cell(job: dict, others: tuple = ()) -> Cell:
    m = job["mkt"]
    return Cell(cfg=m["cfg"], rule_factory=rule_factory(job), focal=m["focal"], seeds=tuple(m["seeds_train"]), name=job["id"], others=others)


def eval_cell(job: dict) -> Cell:
    return replace(train_cell(job), seeds=tuple(job["mkt"]["seeds_eval"]))


# ---- record paths ------------------------------------------------------------------------------------------------------

def stage_search(job: dict, out: Path) -> dict:
    T, L = constants(job); fam = family_for(job["family"], T, L, job.get("h4")); cache = SeedCache(); st = settings(job); cell = train_cell(job)
    upstream = {}
    if job["objective"] == "W0":
        extra, upstream = _welfare_extra(job, out, T)
        obj = WelfareObjective(cell, fam, cache)
        res = cma_search(obj, fam, st, 1, incumbents={"honest_point": fam.honest_point(), **extra})
        controls(obj, fam)
        best = max(obj.archive.values(), key=lambda e: e.f)
        return _welfare_record(obj, res, dict(best.knobs), upstream, T, L)
    tw = twin_search(cell, fam, cache, st, seed=0)
    extra = {}
    if job["family"] == "X7-SC":
        rid = _menu_id(job["context"], job["rule"], "D2+H3"); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"{job['id']}: needs {rid} first")
        extra["embedded_h3"] = embed_h3(rec["attack"]["best_knobs"], T); upstream[rid] = sha_file(path_of(out, rid))
    at = search_family(cell, fam, cache, st, tw, extra)
    obj = Objective(cell, fam, cache); obj.archive.update(at.archive)
    ctrl = controls(obj, fam)
    best_ctrl = max(ctrl, key=lambda kf: kf[1]) if ctrl else None
    at.archive.update(obj.archive)
    rec = {"twin": search_to_json(tw), "attack": search_to_json(at), "controls": [{"knobs": k, "f": f} for k, f in ctrl],
           "upstream": upstream, "T": T, "L": L, "runs": cache.runs}
    if best_ctrl is not None and best_ctrl[1] > at.best_f:
        rec["attack"]["best_knobs"], rec["attack"]["best_f"], rec["attack"]["best_source"] = dict(best_ctrl[0]), float(best_ctrl[1]), "control"
    return rec


def cand_to_json(c: Candidate, family: str | None, T: int, L: int) -> dict:
    return {"name": c.name, "family": family, "T": T, "L": L, "knobs": c.knobs}


def cand_from_json(d: dict, h4: dict | None = None) -> Candidate:
    if d.get("family") == "H4":
        return FV2.cand_from_json(d, _h4(h4["dir"], h4["sha"]))
    return FV2.cand_from_json(d)


def menu(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> tuple[list, list, dict]:
    """The reference menu of the job's rule in its context (design 6.4): candidates, their family names, upstream hashes."""
    ctx, rule = job["context"], job["rule"]; T, L = constants(job); cell = train_cell(job)
    groups: dict[tuple, list] = {}; upstream = {}; fnames = MAN.menu_families(manifest_ctx(ctx), rule)
    for fname in fnames:
        rid = _menu_id(ctx, rule, fname); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"reference {ctx}/{rule}: needs {rid}")
        upstream[rid] = sha_file(path_of(out, rid))
        fam = family_for(fname, T, L)
        bank = []
        if rule in FIXED:
            for other in MAN.bank_rules(manifest_ctx(ctx), fname, cuts, h4_excluded):
                if other == rule:
                    continue
                orid = _menu_id(ctx, other, fname); orec = read(path_of(out, orid))
                if orec is None:
                    raise SystemExit(f"reference {ctx}/{rule}: needs bank source {orid}")
                upstream[orid] = sha_file(path_of(out, orid)); bank.append(fam.project(orec["attack"]["best_knobs"]))
        lk = load_locked()
        cands = reference_candidates(cell, fam, search_from_json(rec["attack"]), search_from_json(rec["twin"]), bank, tuple(lk["reference_order"]))
        for c in cands:
            cat = "bank" if c.name.startswith("bank_") else c.name
            groups.setdefault((cat, fname), []).append(c)
    out_c, fams = merge_menu(groups, fnames)
    return out_c, fams, upstream


def merge_menu(groups: dict, family_order) -> tuple[list, list]:
    """Candidates in the registered category order, families in the given order within a category, de-duplicated by
    (family, exact key); abstain and honest-max once."""
    out_c, fams, seen = [], [], set()
    for cat in CATEGORIES:
        for fname in family_order:
            for c in groups.get((cat, fname), []):
                key = ("name", c.name) if c.knobs is None else (fname, exact_key(c.knobs))
                if key in seen:
                    continue
                seen.add(key); out_c.append(c); fams.append(None if c.knobs is None else fname)
    return out_c, fams


def stage_reference(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cands, fams, upstream = menu(job, out, cuts, h4_excluded)
    choice = select_reference(train_cell(job), cands, SeedCache())
    idx = next(i for i, c in enumerate(cands) if c is choice.candidate)
    return {"candidates": [cand_to_json(c, f, T, L) for c, f in zip(cands, fams)], "choice": idx, "scores": choice.scores,
            "per_seed_normalized": [float(v) for v in choice.per_seed_normalized], "upstream": upstream, "T": T, "L": L,
            "menu_families": list(MAN.menu_families(manifest_ctx(job["context"]), job["rule"]))}


def reference_provenance(job: dict) -> dict:
    return aux_provenance(job["mkt"], rule=job["rule"], rule_params_sha256=_sha_json(job["spec"]))


def reference_of(job: dict, out: Path) -> tuple[Candidate, dict, Path]:
    p = path_of(out, f"reference/{job['context']}/{job['rule']}"); rec = read(p)
    if rec is None:
        raise SystemExit(f"{job['id']}: needs the rule's reference")
    return cand_from_json(rec["candidates"][rec["choice"]]), rec, p


