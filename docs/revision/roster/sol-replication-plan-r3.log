 succeeded in 0ms:
"""The protocol-v2 manifest (design draft 7: 8.1, 8.1a, 8.2, 6.5, 6.6, 6.7), read from experiments/revision-v2-manifest.yaml:
the 287 search cells and 3 diagnostic cells, the 98 doubling checks, the 14 fixed-attack cross-evaluations, the execution
priority, the pre-stated cut order, per context the records a final freeze requires and the reference-bank rules, the
distinct-rule check (design 3.4), and the question-to-cell map (design 8.1a)."""
from __future__ import annotations

from functools import lru_cache
from pathlib import Path

import json
import math

import yaml

ROOT = Path(__file__).resolve().parents[1]
PATH = ROOT / "experiments/revision-v2-manifest.yaml"
Q1_Q4_RULES = ("F000", "F111", "C*")
FACTORIAL = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111")
MATCHED = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111", "C*", "C*/S0")
FIXED = MATCHED + ("C*/S2", "R4")                    # rules at the fixed pair (R4 and C*/S2 only in the rho = 1 repair block)
MENU_FAMILIES = ("D2+H3", "X7-SC")
SECONDARY = ("B3-t", "R3-t", "C*-t")
CORE = ("F000", "F111", "C*")
J, L_FIXED = 50, 10


@lru_cache(maxsize=1)
def doc() -> dict:
    return yaml.safe_load(PATH.read_text())


CUT_ORDER = tuple(doc()["cut_order"])


def context(market: str, rho: float = 0.2) -> str:
    return f"{market}@rho{rho:g}" if rho != 0.2 else f"{market}@rho0.2"


def _cell(block, market, rho, rule, family, objective, c=None, schedule=None) -> dict:
    ctx = context(market, rho)
    cid = f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")
    return {"id": cid, "block": block, "market": market, "context": ctx, "rho": rho, "rule": rule, "family": family, "objective": objective,
            "c": c, "schedule": schedule}


def _families(b: dict, market: str) -> list:
    if "families_by_market" in b:
        return b["families_by_market"]["headline" if market == "headline" else "fresh"]
    return b["families"]


def headline_a_tot(rho: float) -> int:
    """A_tot = floor(beta S_hat / (rho m)) = floor((beta / rho) n_FB) on the headline calibration (design 3.4)."""
    n_fb = float(json.loads((ROOT / "experiments/calibration.json").read_text())["n_FB"])
    return int(math.floor(0.05 / float(rho) * n_fb + 1e-12))


def _descriptor(rule: str, a_tot: int) -> tuple:
    """(selection, pacing schedule) of a rule at the fixed pair; rules with their own parameters are unique."""
    if rule in FACTORIAL:
        pacing = ("reserve", min(J * L_FIXED, a_tot)) if rule[3] == "1" else ("spread",)
        return (("factorial", rule[1], rule[2]), pacing)
    if rule == "R4":
        return (("factorial", "1", "1"), ("reserve", min(J * L_FIXED, a_tot // 2)))
    if rule in ("C*", "C*/S0", "C*/S2"):
        pacing = {"C*": ("reserve", min(J * L_FIXED, a_tot)), "C*/S0": ("spread",), "C*/S2": ("reserve", min(J * L_FIXED, a_tot // 2))}[rule]
        return (("credibility",), pacing)
    return (("own", rule), ("own", rule))


def distinct_rule_problems(cs: list[dict], a_tot: dict) -> list[str]:
    """Design 3.4: no two rules compared in one block and context may have the same selection and pacing schedule."""
    seen: dict = {}; out = []
    for c in cs:
        key = (c["block"], c["context"], _descriptor(c["rule"], int(a_tot[c["context"]])))
        other = seen.setdefault(key, c["rule"])
        if other != c["rule"]:
            out.append(f"{c['block']} {c['context']}: {other} and {c['rule']} have the same selection and pacing")
    return sorted(set(out))


def cells() -> list[dict]:
    d = doc(); out = []
    for name, b in d["blocks"].items():
        markets = d["markets"] if b["markets"] == "all" else b["markets"]
        rho = float(b.get("rho", 0.2))
        objectives = b.get("objectives", [b.get("objective")])
        for m in markets:
            for r in b["rules"]:
                for f in _families(b, m):
                    for o in objectives:
                        if "c" in b:
                            out.extend(_cell(name, m, rho, r, f, o, c, s) for c in b["c"] for s in b["schedules"])
                        else:
                            out.append(_cell(name, m, rho, r, f, o))
    problems = distinct_rule_problems(out, {c["context"]: headline_a_tot(c["rho"]) for c in out})
    if problems:
        raise ValueError(f"manifest refused: {problems}")
    return out


def menu_families(ctx: str, rule: str) -> tuple[str, ...]:
    """Design 6.4: the secondary whole systems on fresh markets have the reduced D2+H3 menu; every other reference both."""
    return ("D2+H3",) if rule in SECONDARY and ctx.startswith("fresh") else MENU_FAMILIES


def _cut(cell: dict, spec: dict) -> bool:
    if spec.get("markets") == "fresh" and not cell["market"].startswith("fresh"):
        return False
    return all(cell[k] == v for k, v in (("block", spec.get("block")), ("family", spec.get("family")), ("rule", spec.get("rule"))) if v is not None)


def effective(cuts: int = 0, h4_excluded: bool = False) -> list[dict]:
    out = cells()
    for spec in CUT_ORDER[: int(cuts)]:
        out = [c for c in out if not _cut(c, spec)]
    if h4_excluded:
        out = [c for c in out if c["family"] != "H4"]
    return out


def doublings() -> list[str]:
    out = []
    for c in cells():
        if c["market"] == "headline" and c["rho"] == 0.2 and c["block"] in ("matched", "welfare", "coalition", "coalition_roles"):
            out.append(c["id"])
        elif c["market"].startswith("fresh") and c["block"] == "matched" and c["rule"] in Q1_Q4_RULES:
            out.append(c["id"])
    return out


def cross_evaluations() -> list[tuple[str, str]]:
    return [(context(m), f) for m in doc()["markets"] for f in MENU_FAMILIES]


def priority(cell: dict) -> int:
    if cell["block"] == "matched":
        return 0 if cell["rule"] in Q1_Q4_RULES else 1
    if cell["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic") or (cell["block"] == "extras" and cell["family"] in ("X5-AG/v2", "H4")):
        return 2
    return 3


def bank_rules(ctx: str, family: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    present = {c["rule"] for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["family"] == family and c["objective"] == "profit"}
    return [r for r in FIXED if r in present]


def required(ctx: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    cs = [c for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["block"] != "diagnostic"]   # diagnostics run after the freeze
    req = [c["id"] for c in cs]
    rules = sorted({c["rule"] for c in cs if c["objective"] != "coalition"}, key=lambda r: (r not in FIXED, r))
    req += [f"reference/{ctx}/{r}" for r in rules]
    groups: dict = {}
    for c in cs:
        if c["objective"] in ("total", "min"):
            groups.setdefault(f"{c['rule']}_c{c['c']}", set()).add(c["schedule"] if c["family"] == "X6-SE/v2" else None)
    for tag, schedules in groups.items():                  # design draft 7, 6.3: one coalition group per rule and c
        req += [f"joint_twin/{ctx}/{tag}_{s}" for s in ("synchronised", "staggered") if s in schedules]
        req += [f"{kind}/{ctx}/{tag}" for kind in ("joint_reference_pre", "joint_reference", "coalition_select")]
    env_rules = sorted({c["rule"] for c in cs if c["block"] == "extras"})
    req += [f"envelope/{ctx}/{r}" for r in env_rules]
    if any(c["block"] == "matched" for c in cs) and ctx in {context(m) for m in doc()["markets"]}:
        req += [f"bank/{ctx}/{f}" for f in MENU_FAMILIES]
        req += [f"bank_train/{ctx}/{f}" for f in MENU_FAMILIES]                          # design draft 7, 6.6: before the freeze
        req += [f"envelope_select/{ctx}/{r}/{f}" for f in MENU_FAMILIES for r in FACTORIAL
                if any(c["rule"] == r and c["family"] == f and c["block"] == "matched" for c in cs)]
    req += sorted({f"welfare_select/{ctx}/{c['rule']}/{c['objective']}" for c in cs if c["block"] == "welfare"},
                  key=lambda x: (CORE.index(x.split("/")[2]), x))                         # design draft 7, 6.2
    return req


def _ids(pred, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    return [c["id"] for c in effective(cuts, h4_excluded) if pred(c)]


def _fresh(c: dict) -> bool:
    return c["market"].startswith("fresh")


QUESTIONS = {
    "Q1": {"cells": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F111", "C*") and c["family"] in MENU_FAMILIES,
           "checks": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F111", "C*") and c["family"] in MENU_FAMILIES},
    "Q2": {"cells": lambda c: c["block"] == "matched" and c["rule"] in FACTORIAL and c["rho"] == 0.2,
           "checks": lambda c: c["market"] == "headline" and c["block"] == "matched" and c["rule"] in FACTORIAL},
    "Q3": {"cells": lambda c: c["rho"] == 0.2 and c["rule"] in CORE and (c["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic")
                                                                         or c["family"] in ("D2+H3", "X7-SC", "X5-AG/v2", "H4") and c["block"] in ("matched", "extras")),
           "checks": lambda c: c["rule"] in CORE and c["rho"] == 0.2 and (c["block"] in ("welfare", "coalition", "coalition_roles") or c["block"] == "matched")},
    "Q4": {"cells": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F000", "F111") and c["family"] == "D2+H3",
           "checks": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F000", "F111") and c["family"] == "D2+H3"},
    "repair": {"cells": lambda c: c["block"] == "repair", "checks": lambda c: False},
    "whole": {"cells": lambda c: c["block"] == "tuned", "checks": lambda c: False},
}


def question_cells(name: str, cuts: int = 0, h4_excluded: bool = False) -> dict:
    """Design 8.1a: the cells a question needs and the scheduled doubling checks it depends on (cross-evaluations for Q2)."""
    q = QUESTIONS[name]; dbl = set(doublings())
    out = {"cells": _ids(q["cells"], cuts, h4_excluded), "checks": [i for i in _ids(q["checks"], cuts, h4_excluded) if i in dbl]}
    if name == "Q2":
        out["cross"] = [f"cross/{ctx}/{f}" for ctx, f in cross_evaluations()]
    return out

"""Run A (docs/revision/followup2/runner-up-plan.md): the full-budget runner-up comparator C-thr(K=12) on the six fresh
markets at rho 0.2, under D2+H3 and X7-SC, with the frozen stage functions of scripts/revision_v2.py.

The frozen code identifies a rule by its label and reads its parameters from `params["cred"]`. The runner-up therefore
runs under the label "C*" with the runner-up's credibility parameters, in its own output directory; its records differ
from the registered C* records by `rule_params_sha256`, and `label.json` names the rule. The driver refuses an output
that contains a copy of a registered C* record. Its reference is selected by the frozen reference stage from the
registered C* menu construction: its own D2+H3 and X7-SC searches plus the cuts-3 bank of the other rules' registered
winners (the registered C* winner is excluded, as C* excluded itself).

Order: bank inputs (hash-checked against the original freeze), preflight, searches (D2+H3, then X7-SC), references,
the follow-up freeze, acceptance, evaluation, acceptance, doubling, analysis, inventory. Exploratory; no registered
estimate or decision changes."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(ROOT / "scripts")); sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(HERE.parent / "followup")); sys.path.insert(0, str(HERE))

import common as C  # noqa: E402
import guards as G  # noqa: E402
import reset_followup_v2 as F  # noqa: E402
import revision_v2 as R  # noqa: E402
from sim import manifest_v2 as MAN  # noqa: E402
from sim.records_v2 import read, sha_file, write  # noqa: E402

LABEL = "C*"
FAMS = ("D2+H3", "X7-SC")
MARKETS = tuple(f"fresh{i}" for i in range(6))
CUTS, H4_EXCLUDED = F.CUTS, F.H4_EXCLUDED
LOG = ROOT / "experiments" / "v2" / "log" / 'Cstar__{"L":10,"cred":{"K":12,"M":null,"variant":"thr"},"tol":0.16}__recheck.json'
DEVIATIONS = ("a rule outside the registered manifest: the full-budget development runner-up C-thr(K=12), run under the label C* in its own output",
              "its reference menu: its own searches plus the cuts-3 bank of the other rules' registered winners, without the registered C* winner",
              "follow-up freeze and acceptance of this script replace revision_v2.accept; exploratory, after the report")


def _refuse(msg: str):
    raise SystemExit(f"runner-up follow-up refused: {msg}")


def runner_up_cred() -> dict:
    rec = read(LOG)
    if rec is None or not rec.get("recheck"):
        _refuse(f"no full-budget recheck record at {LOG}")
    return dict(rec["spec"]["cred"])


def runner_up_params(base: dict) -> dict:
    return {**base, "cred": runner_up_cred()}


def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, markets=MARKETS, smoke: bool = False) -> list[dict]:
    jobs = []
    for m in markets:
        mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
        jobs += [R.job(mkt, LABEL, fam, "profit", smoke=smoke, params=params) for fam in FAMS]
    return jobs


def bank_inputs(src, contexts) -> dict[str, str]:
    """The other rules' registered winners that the frozen menu reads for a C*-labelled rule, with their original freeze hashes."""
    need = {}
    for ctx in sorted(set(contexts)):
        fr = read(R.path_of(src, f"freeze/{ctx}"))
        if fr is None or fr.get("cuts") != CUTS or fr.get("h4_excluded") != H4_EXCLUDED:
            _refuse(f"the original freeze of {ctx} is missing or not cuts {CUTS} with H4 loaded")
        for fam in MAN.menu_families(R.manifest_ctx(ctx), LABEL):
            for other in MAN.bank_rules(R.manifest_ctx(ctx), fam, CUTS, H4_EXCLUDED):
                if other == LABEL:
                    continue
                rid = R.cell_id(ctx, other, fam, "profit")
                if rid not in fr["records"]:
                    _refuse(f"{rid} is not in the original freeze of {ctx}")
                need[rid] = fr["records"][rid]
    return need


def check_no_registered_cstar(src, out) -> None:
    """No file under the output may be a byte copy of a registered C* record (the label is shared)."""
    out, src = Path(out), Path(src)
    if not out.exists():
        return
    for q in out.rglob("*.json"):
        if "__Cstar__" not in q.name and q.stem != "Cstar":       # the C* label exactly; C*/S0 (Cstar~S0) is a bank input
            continue
        p = src / q.relative_to(out)
        if p.exists() and sha_file(p) == sha_file(q):
            _refuse(f"{q} is a copy of a registered C* record")


def check_pairing_rule(src, jobs: list[dict]) -> None:
    """Each job matches the registered C* reference's provenance on every pairing key except the rule parameters, which
    must differ (otherwise the job is the registered C*)."""
    keys = [k for k in F.PAIRED_KEYS if k != "rule_params_sha256"]
    for j in jobs:
        ref = read(R.path_of(src, f"reference/{j['context']}/{LABEL}"))
        if ref is None:
            _refuse(f"{j['id']}: no registered C* reference to pair with")
        if bad := [k for k in keys if j["provenance"].get(k) != ref["provenance"].get(k)]:
            _refuse(f"{j['id']}: provenance differs from the registered C* reference in {bad}")
        if j["provenance"].get("rule_params_sha256") == ref["provenance"].get("rule_params_sha256"):
            _refuse(f"{j['id']}: rule parameters equal the registered C*'s")


def preflight(out, src, jobs, salt_sha256: str, container: dict, smoke: bool = False) -> None:
    F.check_salt(out, salt_sha256, jobs); F.check_commit(jobs); F.check_code(); F.check_configs(jobs, container)
    check_no_registered_cstar(src, out)
    if not smoke:
        check_pairing_rule(src, jobs)


def run_searches(jobs, out, workers: int = 1) -> None:
    for fam in FAMS:
        R._pool("search", [j for j in jobs if j["family"] == fam], Path(out), workers, CUTS, H4_EXCLUDED, jobs)


def run_references(jobs, out) -> None:
    for item in R._menu_items(jobs):
        R._run_reference(item, Path(out), CUTS, H4_EXCLUDED, jobs)


def _expected(rid: str, jobs: list[dict]) -> set:
    return R.expected_upstream(rid, jobs, CUTS, H4_EXCLUDED)


def _ref_provenance(jobs: list[dict], ctx: str) -> dict:
    return R.reference_provenance(next(j for j in jobs if j["context"] == ctx))


def _validate_new(out, rid: str, stage: str, prov: dict, jobs: list[dict]) -> str:
    """A new record of this run: its stage, its current provenance, its dependency ids, and each dependency's current hash."""
    p = R.path_of(out, rid); rec = read(p)
    if rec is None or rec.get("stage") != stage:
        _refuse(f"{rid}: no {stage} record")
    if rec.get("provenance") != prov:
        _refuse(f"{rid}: provenance is not the current job's")
    up = rec.get("upstream") or {}
    if set(up) != _expected(rid, jobs):
        _refuse(f"{rid}: dependency set {sorted(up)} is not the expected one")
    for u, h in up.items():
# Honest-churn arm, amendment 1: rates 0.02 and 0.03 (2026-11-13; for internal review; no spend yet)

**Why.** External review round 4 (Fable 5.2, `docs/revision/roster/fable52-paper-r4.md`, section 4c and "Saturation")
found that the two rates of draft 6 lie on either side of the rate at which honest newcomers' jobs exceed R3's audit
quota: R3 audits 0.880 of honest replacements' jobs in their first ten rounds at p = 0.01 and 0.571 at p = 0.05
(`docs/revision/posthoc/churn.json`, pooled first bin, frozen winners), and the reviewer's arithmetic puts the crossing
near p = 0.028 for these parameters. The paper cannot say where between 0.01 and 0.05 R3's measured advantage ends. The
author chose on 2026-11-13 (board card `touchstone-churn-mid-rates`, answered in chat) to add p = 0.02 and p = 0.03
before Runs A and B.

**Status.** Exploratory follow-up outside the registered protocol. Written after the p = 0.01 and p = 0.05 results and
the round-4 review were seen; no p = 0.02 or p = 0.03 simulation has run, and no timing check was made at these rates.

## 1. What changes

Only the rate set. Everything else in draft 6 applies unchanged: the churn model, estimand (section 2), cells per rate
(B3, R3, C* x fresh0..fresh5 at rho 0.2, D2+H3, registered search budget, 200 evaluation seeds, a doubling check per cell),
the execution contract and gate (section 3), diagnostics (section 4), analysis (section 5), and the cost controls
(section 7). **Rates p in {0.02, 0.03}**: mean identity lifetimes 50 and about 33 rounds. 36 cells plus the p = 0 gate cell.

- Driver: `docs/revision/churn/churn_v2.py --rates 0.02,0.03` (no code change; its cost admission prices every p > 0 at
  the p = 0.05 slowdown, 1.33, which over-states these rates).
- Launcher: the reviewed `docs/revision/churn/churn_pod.sh` with `RATES=0.02,0.03` (a new environment setting, default
  0.01,0.05, refused unless every rate is in {0.01, 0.02, 0.03, 0.05} and none repeats; it passes `--rates` to every
  driver call and verifies each rate directory after RUN OK). The same review covers a defensive change to the end-state
  parse (it takes the last capitalised marker of the polled tail; the old parse gave the same result, because only end
  states start with a capital letter). Harness
  `test_churn_pod_harness.sh`, three new scenarios.
- Local output `results/v2/followup-churn-mid/` (the first arm's records are not touched). Run tag `churn-mid`; PRIOR 0.

## 2. Pre-specified expectations (written now, before any p = 0.02 or p = 0.03 search)

Scored as in draft 6 section 6: met (holds under both the frozen and the doubled searches, each against its own
values), failed (fails under both), not established (the two disagree); on point estimates; pooled values are
equal-weight means over the six markets. The p = 0.01 and p = 0.05 values are those of `churn.json`.

5. The pooled audited share of honest replacement identities in their first ten rounds under R3 is below its p = 0.01
   value and above its p = 0.05 value at both new rates, and lower at p = 0.03 than at p = 0.02.
6. Pooled C* minus R3 is lower at p = 0.03 than at p = 0.02.
7. Pooled g_0.02(R3) is below the midpoint of the no-churn and p = 0.05 values of pooled g(R3) (frozen: 0.168;
   doubled: 0.170).
8. B3 minus R3 is positive on at least five of the six markets at p = 0.02.

A failure is not read as evidence of a particular cause. The reviewer's crossing near p = 0.028 is an approximation; none
of these expectations depends on it holding exactly.

## 3. Analysis

`docs/revision/posthoc/churn_block.py` gains a `--rates` option (default 0.01,0.05), tested first; with `--rates
0.02,0.03` it reads the new records and writes `churn_mid.json` with the same statistics, pairing and bootstrap (the same
fixed seed), and the scoring of expectations 5 to 8. A combined table lists the five conditions p = 0, 0.01, 0.02, 0.03,
0.05 for both search versions. The analysis code is committed before any run on the new records.

## 4. Cost

The first arm cost 4.99 USD (8.87 billed hours at 0.56 USD/h) for p = 0.01 and 0.05, whose measured slowdowns sum to
2.463. Interpolating the slowdown linearly in p (1.182 at 0.02, 1.232 at 0.03; sum 2.414) gives about 8.7 billed hours,
**about 4.9 USD**. Stop cap 8 USD, as in draft 6; watchdog bound 1.3 x 8 = 10.40 USD; reservation
`python3 docs/revision/followup/budget_followup.py --reserve churn-mid-pod 8.32` (grant 10.40). Ledger: 57.51 USD spent
of the 123 USD limit; follow-up category 6.64 of 72 USD.

## 5. Steps

1. Internal review of this amendment and the launcher change to consensus; commit.
2. Reserve; dry-run guard; one pod: the gate, then the 36 cells; delete and verify; record the spend after the author's
   billing check.
3. Analysis (code first), paper text after review.

