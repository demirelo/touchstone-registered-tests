def search_family(cell: Cell, family: Family, cache: SeedCache, st: SearchSettings, twin, extra_incumbents: dict | None = None):
    inc = {"twin_best": twin.best_knobs, "honest_point": family.honest_point(), **(extra_incumbents or {})}
    return cma_search(Objective(cell, family, cache), family, st, 1, incumbents=inc)


BOUNDED_CONTROLS = ("X7-SC", "H4")                # design draft 7, 5.2 and 5.3: Sobol corner controls, never every corner


def controls(objective, family: Family) -> list:
    if family.name in BOUNDED_CONTROLS:
        vecs = corner_vectors(family)
    else:
        if family.dim > 8:
            raise AssertionError(f"{family.name}: {family.dim} knobs is too many for exhaustive corners")
        vecs = family.corners()
    return [(k, float(objective.eval_knobs(k, source="corner"))) for k in vecs]


def continue_search(objective, family: Family, st: SearchSettings, original, seed: int = 1):
    """Doubling (design 6.5): as many new restarts as registered, with restart seeds after the registered ones, on the
    merged archive (old entries kept), the previous best as an incumbent."""
    objective.archive.update(original.archive)
    return cma_search(objective, family, st, int(seed) + int(st.restarts), incumbents={"previous_best": dict(original.best_knobs)})


# ---- stages ------------------------------------------------------------------------------------------------------------

def _menu_id(ctx, rule, fam):
    return cell_id(ctx, rule, fam, "profit")
def _by_id(catalog: list[dict]) -> dict:
    return {j["id"]: j for j in catalog}


def _first(catalog, **kw):
    return next((j for j in catalog if all(j.get(k) == v for k, v in kw.items())), None)


def expected_upstream(rid: str, catalog: list[dict], cuts: int = 0, h4_excluded: bool = False) -> set:
    """The dependency ids a record must list (design 6.4 order), derived independently of the record."""
    by = _by_id(catalog)
    if "|" in rid:
        j = by[rid]; ctx, rule, fam, obj = j["context"], j["rule"], j["family"], j["objective"]
        if obj == "profit":
            return {_menu_id(ctx, rule, "D2+H3")} if fam == "X7-SC" else set()
        if obj == "W0":
            return {cell_id(ctx, rule, "D2+H3", "W0")} if fam == "X7-SC" else set()
        if obj == "W1":
            return {f"reference/{ctx}/{rule}"} | ({cell_id(ctx, rule, "D2+H3", "W1")} if fam == "X7-SC" else set())
        if obj == "total":
            return {_twin_id(ctx, _coalition_tag(j), j["schedule"])} if fam == "X6-SE/v2" else set()
        return {f"joint_reference_pre/{ctx}/{_coalition_tag(j)}"}
    kind, ctx, rest = rid.split("/", 2)
    if kind == "reference":
        ids = {_menu_id(ctx, rest, f) for f in MAN.menu_families(manifest_ctx(ctx), rest)}
        if rest in FIXED:
            ids |= {_menu_id(ctx, o, f) for f in MENU for o in MAN.bank_rules(manifest_ctx(ctx), f, cuts, h4_excluded) if o != rest}
        return ids
    if kind == "envelope":
        return {f"reference/{ctx}/{rest}"} | {cell_id(ctx, rest, f, "profit") for f in MAN.doc()["envelope_families"] if cell_id(ctx, rest, f, "profit") in by}
    if kind == "bank":
        return {cell_id(ctx, r, rest, "profit") for r in MAN.FACTORIAL if cell_id(ctx, r, rest, "profit") in by}
    if kind == "bank_train":
        return {f"bank/{ctx}/{rest}"} | {f"reference/{ctx}/{r}" for r in MAN.FACTORIAL if cell_id(ctx, r, rest, "profit") in by}
    if kind == "envelope_select":
        return {f"bank_train/{ctx}/{rest.rsplit('/', 1)[1]}"}
    if kind == "welfare_select":
        rule, obj = rest.rsplit("/", 1)
        return {cell_id(ctx, rule, f, obj) for f in MENU if cell_id(ctx, rule, f, obj) in by}
    if kind in COALITION_STEPS:
        group = _group(_group_job(kind, ctx, rest, catalog), catalog)
        tot = {j["id"] for j in group if j["objective"] == "total"}; mins = {j["id"] for j in group if j["objective"] == "min"}
        if kind == "joint_twin":
            return set()
        if kind == "joint_reference_pre":
            return {_twin_id(ctx, rest, s) for s in _x6_schedules(group)} | tot
        if kind == "joint_reference":
            return {f"joint_reference_pre/{ctx}/{rest}"} | mins
        return {f"joint_reference/{ctx}/{rest}"} | mins
    raise ValueError(rid)


"""Stage records of the v2 runner: atomic JSON writes, tolerant reads (a missing or truncated file is absent), and
validation of a record's stage, provenance, and upstream hashes against the current files."""
from __future__ import annotations

import hashlib
import json
import os
import secrets
from pathlib import Path


def write(path, rec: dict) -> None:
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")       # unique per writer
    with open(tmp, "w") as f:
        json.dump(rec, f, default=float); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, p)


def read(path) -> dict | None:
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def sha_file(path) -> str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def validate(job: dict, stage: str, rec: dict, upstream: dict) -> None:
    """`upstream` maps each upstream record id to its current path; raises ValueError on any mismatch."""
    if rec.get("stage") != stage:
        raise ValueError(f"record stage {rec.get('stage')!r} is not {stage!r}")
    if rec.get("provenance") != job.get("provenance"):
        raise ValueError("record provenance differs from the job's")
    for rid, sha in (rec.get("upstream") or {}).items():
        p = upstream.get(rid)
        if p is None or not Path(p).exists() or sha_file(p) != sha:
            raise ValueError(f"upstream {rid} changed or is missing")

