   173	def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, attempts, ledger=None, tag: str | None = None, clock=time.time,
   174	                   stop_file=None, soft_deadline=None) -> CostStop:
   175	    """A paid run must state the pod allocation time, a positive rate (the price ceiling), the launcher's attempts file,
   176	    and the ledger with the run's tag: closed attempts of this launch and recorded spend of earlier launches count toward
   177	    the cap (no default of zero)."""
   178	    if started is None:
   179	        _refuse("a paid run needs --started-at (the pod allocation time)")
   180	    if not (math.isfinite(float(usd_per_hour)) and usd_per_hour > 0 and math.isfinite(float(cap_usd)) and cap_usd > 0):
   181	        _refuse("a paid run needs a finite positive rate and cap")
   182	    if attempts is None:
   183	        _refuse("a paid run needs --attempts (the launcher's attempts file)")
   184	    if not tag:
   185	        _refuse("a paid run needs --run-tag and --ledger (spend of earlier launches)")
   186	    att = attempts_spend(attempts, usd_per_hour, started, clock())
   187	    prior = att["closed_usd"] + ledger_spend(ledger, tag)
   188	    return CostStop(cap_usd, usd_per_hour, att["open_start"], clock, prior, stop_file, soft_deadline)   # counted from the recorded open event
