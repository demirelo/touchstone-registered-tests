   152	def compare_round1(registered: dict, r1: dict) -> dict:
   153	    """Round 1 against the registered doubling record: exact on the seeds and discrete held-out knobs; 1e-9 on the
   154	    continuous knobs, both changes and the held-out gains; every value finite."""
