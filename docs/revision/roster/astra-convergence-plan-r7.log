"""Pod safety primitives for the follow-up launchers (internal reviews r8-r9 of reset_pod.sh). Every function fails
closed: a failed listing counts as "pods may still exist", and success needs a successful listing that shows no pod.
Time limits are measured in elapsed seconds, never in loop counts.

CLI (exit 0 = success):
  podctl.py reconcile NAME [KEEP_ID]          delete every pod named NAME except KEEP_ID; verified by a fresh listing
  podctl.py delete ID SECONDS                 delete one pod and verify it is gone within SECONDS
  podctl.py watchdog NAME HARD_TS DONE_FILE   after DONE_FILE, or from HARD_TS (also writes NAME.blocked): delete every
                                              pod named NAME; exits only with DONE_FILE and SETTLE s of empty listings
  podctl.py record-price NAME ID              print ID's price and raise NAME.acct to it; unknown -> NAME.unpriced, exit 1; not listed -> exit 2
  podctl.py may-create NAME HARD_TS           exit 0 only before HARD_TS and while NAME.blocked does not exist
  podctl.py remaining UNTIL_TS                print the seconds left (0 when past)
"""
from __future__ import annotations

import fcntl
import json
import math
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
PY = sys.executable


def _run(args, timeout=60):
    try:
        r = subprocess.run([PY, os.path.join(HERE, "runpod.py")] + args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except subprocess.TimeoutExpired:
        return 124, ""


def list_pods(run=_run, timeout=60):
    """The pods as a list, or None when the listing failed (never an empty list on failure). The timeout stays
    fractional so a command never outlives a sub-second budget (r11 Astra 5)."""
    if float(timeout) <= 0:
        return None                      # no budget left: no command, and no listing counts (r12 Sol 5 / Astra 4)
    rc, out = run(["list"], timeout=float(timeout))
    if rc != 0:
        return None
    try:
        pods = json.loads(out)
    except ValueError:
        return None
    return pods if isinstance(pods, list) else None


def named(pods, name):
    return [p["id"] for p in pods if p.get("name") == name]


def delete_verified(pid, seconds, run=_run, clock=time.time, sleep=time.sleep):
    """Delete PID until a successful listing no longer shows it, within SECONDS of elapsed time."""
    end = clock() + seconds
    while clock() < end:
        run(["delete", pid], timeout=min(60.0, end - clock()))
        if clock() >= end:
            break
        pods = list_pods(run, min(60, end - clock()))
        if clock() < end + 1e-9 and pods is not None and pid not in [p["id"] for p in pods]:
            return clock() <= end
        sleep(min(15, max(0.0, end - clock())))
    return False


def reconcile(name, keep="", seconds=600, run=_run, clock=time.time, sleep=time.sleep, here=HERE):
    """Delete every pod named NAME except KEEP, recording each one's price first (r13: every deletion path records it);
    True only when a successful listing shows none left."""
    end = clock() + seconds
    while clock() < end:
        pods = list_pods(run, min(60, end - clock()))
        if pods is not None and clock() <= end:
            extra = [i for i in named(pods, name) if i != keep]
            if not extra:
                return True
            for i in extra:
                if clock() >= end:
                    break
                record_price(name, i, run, here, pods)
                delete_verified(i, end - clock(), run, clock, sleep)
        sleep(min(15, max(0.0, end - clock())))
    return False


def may_create(name, hard_ts, clock=time.time, here=HERE):
    return clock() < hard_ts and not os.path.exists(os.path.join(here, f"{name}.blocked"))


SETTLE = 300            # seconds of consecutive empty listings, counted only after DONE, before the watchdog ends
AMBIGUOUS_SETTLE = 1800  # the same after an ambiguous creation answer (NAME.ambiguous): assumed service bound for a late pod


def classify_creation(answer, exc=None):
    """(pod id, ambiguous) for one creation request. Only a clear client refusal (HTTP 4xx other than 408 and 429) is
    unambiguous; a timeout, exception, server or gateway error, or unreadable answer may still create a pod (r11)."""
    if exc is not None:
        return "", True
    if isinstance(answer, dict) and answer.get("id"):
        return str(answer["id"]), False
    if isinstance(answer, dict) and isinstance(answer.get("error"), int):
        code = answer["error"]
        return "", not (400 <= code < 500 and code not in (408, 429))
    return "", True


def price_of(pod):
    """The pod's price in USD/h when it is finite and positive, else None (missing, null, zero or unreadable: r12)."""
    try:
        v = float(pod.get("costPerHr"))
    except (TypeError, ValueError):
        return None
    return v if math.isfinite(v) and v > 0 else None


ABSENT = "absent"


def record_price(name, pid, run=_run, here=HERE, pods=None):
    """Raise the rate in NAME.acct to PID's observed price; if the price is unknown (or the listing failed) write
    NAME.unpriced, so no spend bound is claimed. Returns the price or None."""
    if pods is None:
        pods = list_pods(run)
    pod = next((p for p in pods or [] if p.get("id") == pid), None)
    if pods is not None and pod is None:
        return ABSENT                    # a good listing without the pod: it no longer bills; whoever deleted it priced it
    price = price_of(pod) if pod is not None else None
    if price is None:
        open(os.path.join(here, f"{name}.unpriced"), "a").write(f"{pid}\n")
        return None
    acct = os.path.join(here, f"{name}.acct")
    with open(os.path.join(here, f"{name}.lock"), "w") as lk:   # r14: launcher and watchdog record concurrently
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            tfirst, rate = open(acct).read().split()[:2]
            if price > float(rate):
                open(acct, "w").write(f"{tfirst} {price}")
        except (OSError, ValueError):
            open(os.path.join(here, f"{name}.unpriced"), "a").write(f"{pid} (no acct)\n")
    return price


def _final_bound(here, name):
    if os.path.exists(os.path.join(here, f"{name}.unpriced")):
        return "UNRESOLVED BILLING: a pod had an unknown price; check the Runpod console for the spend"
    try:
        tfirst, rate = open(os.path.join(here, f"{name}.acct")).read().split()[:2]
        secs = max(0.0, time.time() - float(tfirst))
        return f"final spend bound: {int(secs)}s at {rate} USD/h = {round(secs / 3600 * float(rate), 3)} USD"
    except (OSError, ValueError):
        return "final spend bound: no creation request recorded"


def watchdog(name, hard_ts, done_file, run=_run, clock=time.time, sleep=time.sleep, here=HERE, settle=SETTLE):
    """Ends only when DONE_FILE exists and successful listings show no pod named NAME for the settle time, counted from
    DONE onwards (r11 Sol 3); after an ambiguous creation answer the settle time is at least AMBIGUOUS_SETTLE. After
    DONE (the launcher reconciles first) any pod named NAME is an orphan and is deleted. From HARD_TS it also blocks
    creation and deletes every pod named NAME, with no retry limit. On exit it prints the final spend bound."""
    blocked = False
    empty_since = None
    while True:
        if not blocked and clock() >= hard_ts:
            open(os.path.join(here, f"{name}.blocked"), "w").write(str(int(clock())))
            print(f"{time.strftime('%H:%M')} WATCHDOG: hard deadline; creation blocked; deleting every pod named {name}", flush=True)
            blocked = True
        done = os.path.exists(done_file)
        need = max(settle, AMBIGUOUS_SETTLE) if os.path.exists(os.path.join(here, f"{name}.ambiguous")) else settle
        if done or blocked:
            pods = list_pods(run)
            if pods is None:
                empty_since = None
            else:
                ids = named(pods, name)
                if ids:
                    empty_since = None
                    for i in ids:
                        record_price(name, i, run, here, pods)   # r12: a late pod's price enters the bound
                        print(f"{time.strftime('%H:%M')} WATCHDOG: deleting {i}", flush=True)
                        delete_verified(i, 120, run, clock, sleep)
                elif done:
                    empty_since = clock() if empty_since is None else empty_since
                    if clock() - empty_since >= need:
                        print(f"{time.strftime('%H:%M')} WATCHDOG: no pod named {name} for {need}s after the launcher was done; {_final_bound(here, name)}", flush=True)
                        return 0
                else:
                    empty_since = None
        sleep(30 if blocked else min(30, max(0.0, hard_ts - clock())) or 30)


def main(argv) -> int:
    cmd, a = argv[0], argv[1:]
    if cmd == "reconcile":
        return 0 if reconcile(a[0], a[1] if len(a) > 1 else "") else 1
    if cmd == "delete":
        return 0 if delete_verified(a[0], float(a[1])) else 1
    if cmd == "watchdog":
        return watchdog(a[0], float(a[1]), a[2])
    if cmd == "record-price":
        p = record_price(a[0], a[1], here=a[2] if len(a) > 2 else HERE)
        if p is ABSENT:
            print("absent"); return 2
        print(p if p is not None else "unknown"); return 0 if p is not None else 1
    if cmd == "may-create":
        return 0 if may_create(a[0], float(a[1])) else 1
    if cmd == "remaining":
        print(max(0, int(float(a[0]) - time.time()))); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

