def _resign(d):
    inv = read(d / "inventory.json")
    inv["records"] = {str(p.relative_to(d)): G.sha_file(p) for p in sorted(d.rglob("*")) if p.is_file() and p.name != "inventory.json"}
    write(d / "inventory.json", inv)


