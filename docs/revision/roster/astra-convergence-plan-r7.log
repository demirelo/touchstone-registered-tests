   158	        problems.append("nonfinite value")
   159	    if ha["seeds"] != hb["seeds"]:
   160	        problems.append("seeds differ")
   161	    ka, kb = ha["knobs"], hb["knobs"]; disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   162	    if set(ka) != set(kb) or any(ka[k] != kb[k] for k in disc):
   163	        problems.append("discrete knob differs")
   164	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   165	    chg = max(abs(registered[k] - r1[k]) for k in ("attack_change", "reference_change"))
