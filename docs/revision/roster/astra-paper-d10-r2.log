"""Draft 10 churn float data (outline-draft10.md, sections 4 and 5): the C* - R3 and B3 - R3 curves against the churn
rate (figure) and the audit allocation per rate (table), from churn.json (p = 0, 0.01, 0.05) and churn_mid.json
(p = 0.02, 0.03). Exploratory, after the report; descriptive. --write regenerates, --check refuses stale outputs.
Usage: churn_paper.py --first churn.json --mid churn_mid.json --figdir <dir> --tabdir <dir> [--summary churn_paper.json] (--write | --check)"""
import argparse
import json
import sys
from pathlib import Path

RULES = (("F111", "R3"), ("C*", "C$^*$"), ("F000", "B3"))
VERS = ("base", "doubled")


def _stats(first: dict, mid: dict, ver: str) -> dict:
    s = dict(first["statistics"][ver]); s.update({k: v for k, v in mid["statistics"][ver].items() if k != "0"})
    return s


def _r4(first: dict, mid: dict, key: str) -> dict:
    out = {}
    for src in (first, mid):
        for k, v in src["review_r4"][key].items():
            if isinstance(v, dict):
                out.setdefault(k, {}).update(v)
    return out


def data(first: dict, mid: dict) -> dict:
    rates = sorted({float(k) for v in VERS for k in _stats(first, mid, v)})
    curves = {}
    for ver in VERS:
        s = _stats(first, mid, ver)
        curves[ver] = {c: [{"p": p, "estimate": s[_key(p)][c]["pooled"]["estimate"], "lo": s[_key(p)][c]["pooled"]["ci95"][0],
                            "hi": s[_key(p)][c]["pooled"]["ci95"][1]} for p in rates] for c in ("d", "q")}
    alloc, eff = _r4(first, mid, "audit_allocation"), _r4(first, mid, "eff_attack")
    rows = []
    for p in [r for r in rates if r > 0]:
        for rule, name in RULES:
            a, ad = alloc[_key(p)][f"{rule}|base"], alloc[_key(p)][f"{rule}|doubled"]
            rows.append({"p": p, "rule": name, "focal_audit_rate": a["focal_audit_rate"], "focal_audit_rate_doubled": ad["focal_audit_rate"],
                         "x_off_doubled": sum(1 for x in ad["x_by_market"].values() if x == 0), "eff_doubled": eff["doubled"][_key(p)][rule],
                         "young_honest_job_share": a["young_honest_job_share"],
                         "young_honest_audit_share": a["young_honest_audit_share"], "established_honest_audit_rate": a["established_honest_audit_rate"],
                         "x_off": sum(1 for x in a["x_by_market"].values() if x == 0), "markets": a["markets"],
                         "eff_attack": eff["base"][_key(p)][rule]})
    return {"label": "exploratory, after the report; frozen searches unless stated", "rates": rates, "curves": curves, "allocation": rows}


def summary(first: dict, mid: dict, runnerup: dict | None = None) -> dict:
    """Aggregates that the paper cites and the records hold only per cell: the doubling flags' largest attack change,
    the reselection diagnostic (reference_change), and per rate and rule the audit allocation, the selected attacks
    without replacement (x_off) and the gross efficiency under attack (frozen searches)."""
    cells = {**first["flags"], **mid["flags"]}
    top = max(cells, key=lambda k: cells[k]["attack_change"])
    alloc, eff = _r4(first, mid, "audit_allocation"), _r4(first, mid, "eff_attack")
    rates = {}
    for p, rows in alloc.items():
        rates[p] = {}
        for rule, name in RULES:
            a = rows[f"{rule}|base"]
            rates[p][name.replace("$^*$", "*")] = {
                "focal_audit_rate": a["focal_audit_rate"], "young_honest_job_share": a["young_honest_job_share"],
                "young_honest_audit_share": a["young_honest_audit_share"], "established_honest_audit_rate": a["established_honest_audit_rate"],
                "x_off": sum(1 for x in a["x_by_market"].values() if x == 0), "markets": a["markets"], "eff": eff["base"][p][rule]}
            ad = rows.get(f"{rule}|doubled")
            if ad:   # Fable round 5, problem 4 and 5: the doubled winners beside the frozen ones
                rates[p][name.replace("$^*$", "*")].update(focal_audit_rate_doubled=ad["focal_audit_rate"],
                    x_off_doubled=sum(1 for x in ad["x_by_market"].values() if x == 0), eff_doubled=eff["doubled"][p][rule])
    r5 = first.get("review_r5", {})
    r3 = {}
    if r5:   # Fable round 5, problems 5 and 8: R3 at p = 0.05 per market (frozen searches)
        fa = r5["focal_audit_rate_by_market"]["0.05"]["F111|base"]; xs = alloc["0.05"]["F111|base"]["x_by_market"]
        rep = [fa[m] for m in fa if xs.get(m) == 1]
        e = r5["eff_by_market"]["base"]["0.05"]["F111"]
        r3 = {"replacing_audit_min": min(rep), "replacing_audit_max": max(rep), "replacing_markets": len(rep),
              "eff_min": min(e.values()), "eff_min_market": min(e, key=e.get)}
    ru = {}
    for fam, vers in (runnerup or {}).items():
        if not isinstance(vers, dict):
            continue
        for v in ("base", "doubled"):
            ms = (vers.get(v) or {}).get("runner_up_minus_r3", {}).get("markets")
            if ms:   # Fable round 5, problem 1: runner-up minus R3 per market (positive: R3 lower)
                ru[f"{fam}|{v}"] = {"positive": sum(1 for g in ms.values() if g > 0), "negative": sum(1 for g in ms.values() if g < 0),
                                    "min": min(ms.values()), "min_market": min(ms, key=ms.get)}
    return {"label": "exploratory, after the report; aggregates of churn.json and churn_mid.json", "r3_p05": r3, "runner_up": ru,
            "flags": {"cells": len(cells), "max_attack_change": cells[top]["attack_change"], "max_attack_cell": top,
                      "reselected": sum(1 for c in cells.values() if c["reference_change"] != 0),
                      "max_reference_change": max(abs(c["reference_change"]) for c in cells.values()),
                      "incomplete_n": first["flag_summary"]["incomplete_n"] + mid["flag_summary"]["incomplete_n"]},
            "rates": rates}


def _key(p: float) -> str:
    return "0" if p == 0 else f"{p:g}"


def _f(x: float) -> str:
    s = f"{x:.3f}"
    return s.replace("-", "$-$")


def audit_table(d: dict) -> str:
    head = ("\\begin{tabular}{llcccccc}\n\\toprule\n$p$ & Rule & attacker's jobs audited & young honest jobs & "
            "audits to young honest & established honest audited & winners without replacement & efficiency \\\\\n\\midrule\n")
    body = "".join(f"{r['p']:g} & {r['rule']} & {_f(r['focal_audit_rate'])} / {_f(r['focal_audit_rate_doubled'])} & {_f(r['young_honest_job_share'])} & "
                   f"{_f(r['young_honest_audit_share'])} & {_f(r['established_honest_audit_rate'])} & {r['x_off']} / {r['x_off_doubled']} of {r['markets']} & "
                   f"{_f(r['eff_attack'])} / {_f(r['eff_doubled'])} \\\\\n" for r in d["allocation"])
    return head + body + "\\bottomrule\n\\end{tabular}\n"


def _draw(d: dict, path: Path) -> None:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=(5.5, 2.8))
    style = {("d", "base"): ("o-", "#20675a", "C$^*$ $-$ R3"), ("q", "base"): ("s-", "#b0471b", "B3 $-$ R3"),
             ("d", "doubled"): ("o--", "#20675a", "C$^*$ $-$ R3, doubled"), ("q", "doubled"): ("s--", "#b0471b", "B3 $-$ R3, doubled")}
    for (c, ver), (fmt, col, lab) in style.items():
        pts = d["curves"][ver][c]
        ax.plot([p["p"] for p in pts], [p["estimate"] for p in pts], fmt, color=col, label=lab, ms=4, mfc="white" if ver == "doubled" else col)
    ax.axhline(0, color="#1c2421", lw=0.6)
    ax.set_xlabel("honest churn rate $p$ (per round)"); ax.set_ylabel("gain difference")
    ax.legend(fontsize=7, frameon=False); fig.tight_layout()
    fig.savefig(path, metadata={"CreationDate": None}); plt.close(fig)   # no timestamp: the bytes depend only on the data (Astra d10-r1, 8)


def _same_pdf(d: dict, path: Path) -> bool:
    """The PDF on disk equals a fresh rendering of the data, byte for byte."""
    import tempfile
    if not path.exists():
        return False
    with tempfile.TemporaryDirectory() as t:
        fresh = Path(t) / "fig.pdf"; _draw(d, fresh)
        return fresh.read_bytes() == path.read_bytes()


def write(d: dict, figdir, tabdir, summary_path=None, summary=None) -> None:
    fd, td = Path(figdir), Path(tabdir)
    if summary_path is not None:
        Path(summary_path).write_text(json.dumps(summary, indent=1, sort_keys=True) + "\n")
    (fd / "fig_churn.data.json").write_text(json.dumps(d, indent=1, sort_keys=True))
    _draw(d, fd / "fig_churn.pdf")
    (td / "posthoc_churn_audit.tex").write_text(audit_table(d))


def check(d: dict, figdir, tabdir, summary_path=None, summary=None) -> list:
    fd, td = Path(figdir), Path(tabdir); bad = []
    if summary_path is not None:
        sp = Path(summary_path)
        if not sp.exists() or json.loads(sp.read_text()) != json.loads(json.dumps(summary, sort_keys=True)):
            bad.append(f"{sp.name}: stale or missing; run --write")
    f = fd / "fig_churn.data.json"
    if not f.exists() or json.loads(f.read_text()) != json.loads(json.dumps(d, sort_keys=True)) or not _same_pdf(d, fd / "fig_churn.pdf"):
        bad.append("fig_churn: stale or missing; run --write")
    t = td / "posthoc_churn_audit.tex"
    if not t.exists() or t.read_text() != audit_table(d):
        bad.append("posthoc_churn_audit.tex: stale or missing; run --write")
    return bad


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--first", required=True); ap.add_argument("--mid", required=True)
    ap.add_argument("--figdir", required=True); ap.add_argument("--tabdir", required=True); ap.add_argument("--summary", default=None); ap.add_argument("--runnerup", default=None)
    g = ap.add_mutually_exclusive_group(required=True); g.add_argument("--write", action="store_true"); g.add_argument("--check", action="store_true")
    a = ap.parse_args(argv)
    first, mid = json.loads(Path(a.first).read_text()), json.loads(Path(a.mid).read_text())
    ru = json.loads(Path(a.runnerup).read_text()) if a.runnerup else None
    d, s = data(first, mid), summary(first, mid, ru)
    if a.write:
        write(d, a.figdir, a.tabdir, a.summary, s); return 0
    bad = check(d, a.figdir, a.tabdir, a.summary, s); print("\n".join(bad) or "ok"); return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
import churn_paper as P  # noqa: E402

HERE = Path(__file__).parent
FIRST = json.loads((HERE / "churn.json").read_text())
MID = json.loads((HERE / "churn_mid.json").read_text())


def test_curves_cover_five_rates_and_match_the_records():
    d = P.data(FIRST, MID)
    assert d["rates"] == [0.0, 0.01, 0.02, 0.03, 0.05]
    d05 = [p for p in d["curves"]["base"]["d"] if p["p"] == 0.05][0]
    assert d05["estimate"] == FIRST["statistics"]["base"]["0.05"]["d"]["pooled"]["estimate"]
    q03 = [p for p in d["curves"]["doubled"]["q"] if p["p"] == 0.03][0]
    assert q03["estimate"] == MID["statistics"]["doubled"]["0.03"]["q"]["pooled"]["estimate"]


def test_allocation_rows_come_from_review_r4():
    d = P.data(FIRST, MID)
    assert len(d["allocation"]) == 12
    r = [x for x in d["allocation"] if x["p"] == 0.02 and x["rule"] == "R3"][0]
    a = MID["review_r4"]["audit_allocation"]["0.02"]["F111|base"]
    assert r["focal_audit_rate"] == a["focal_audit_rate"] and r["x_off"] == sum(v == 0 for v in a["x_by_market"].values())
    assert r["eff_attack"] == MID["review_r4"]["eff_attack"]["base"]["0.02"]["F111"]


def test_check_refuses_stale_outputs(tmp_path):
    d = P.data(FIRST, MID)
    assert len(P.check(d, tmp_path, tmp_path)) == 2
    P.write(d, tmp_path, tmp_path)
    assert P.check(d, tmp_path, tmp_path) == []
    (tmp_path / "posthoc_churn_audit.tex").write_text("x")
    assert any("audit" in b for b in P.check(d, tmp_path, tmp_path))


def test_summary_aggregates_flags_reselection_and_rules():
    s = P.summary(FIRST, MID)
    cells = {**FIRST["flags"], **MID["flags"]}
    assert s["flags"]["cells"] == len(cells) == 72
    assert s["flags"]["max_attack_change"] == max(c["attack_change"] for c in cells.values())
    assert s["flags"]["reselected"] == sum(1 for c in cells.values() if c["reference_change"] != 0)
    assert s["flags"]["max_reference_change"] == max(abs(c["reference_change"]) for c in cells.values())
    r = s["rates"]["0.05"]["R3"]
    a = FIRST["review_r4"]["audit_allocation"]["0.05"]["F111|base"]
    assert r["x_off"] == sum(v == 0 for v in a["x_by_market"].values()) and r["focal_audit_rate"] == a["focal_audit_rate"]
    assert r["eff"] == FIRST["review_r4"]["eff_attack"]["base"]["0.05"]["F111"]
    assert set(s["rates"]) == {"0.01", "0.02", "0.03", "0.05"}


def test_check_refuses_a_stale_summary(tmp_path):
    d = P.data(FIRST, MID); s = P.summary(FIRST, MID); out = tmp_path / "churn_paper.json"
    P.write(d, tmp_path, tmp_path, summary_path=out, summary=s)
    assert P.check(d, tmp_path, tmp_path, summary_path=out, summary=s) == []
    out.write_text("{}")
    assert any("churn_paper.json" in b for b in P.check(d, tmp_path, tmp_path, summary_path=out, summary=s))


def test_check_refuses_a_replaced_figure(tmp_path):
    # Astra paper-d10-r1, correction 8: a PDF that no longer matches its data must be refused
    d = P.data(FIRST, MID)
    P.write(d, tmp_path, tmp_path)
    assert P.check(d, tmp_path, tmp_path) == []
    (tmp_path / "fig_churn.pdf").write_bytes(b"%PDF-1.4 not the figure")
    assert any("fig_churn" in b for b in P.check(d, tmp_path, tmp_path))


RUNNERUP = json.loads((HERE.parent / "followup2" / "runnerup_analysis.json").read_text())


def test_summary_round5_fields():
    # Fable round 5: doubled values beside frozen, the R3 per-market values at p = 0.05, Run A's market signs
    s = P.summary(FIRST, MID, RUNNERUP)
    r = s["rates"]["0.01"]["R3"]
    a = FIRST["review_r4"]["audit_allocation"]["0.01"]["F111|doubled"]
    assert r["focal_audit_rate_doubled"] == a["focal_audit_rate"]
    assert r["x_off_doubled"] == sum(v == 0 for v in a["x_by_market"].values())
    assert s["rates"]["0.05"]["R3"]["eff_doubled"] == FIRST["review_r4"]["eff_attack"]["doubled"]["0.05"]["F111"]
    r5 = FIRST["review_r5"]
    fa, x = r5["focal_audit_rate_by_market"]["0.05"]["F111|base"], FIRST["review_r4"]["audit_allocation"]["0.05"]["F111|base"]["x_by_market"]
    rep = [fa[m] for m in fa if x[m] == 1]
    assert s["r3_p05"]["replacing_audit_min"] == min(rep) and s["r3_p05"]["replacing_audit_max"] == max(rep)
    e = r5["eff_by_market"]["base"]["0.05"]["F111"]
    assert s["r3_p05"]["eff_min"] == min(e.values()) and s["r3_p05"]["eff_min_market"] == min(e, key=e.get)
    ru = RUNNERUP["D2+H3"]["base"]["runner_up_minus_r3"]["markets"]
    assert s["runner_up"]["D2+H3|base"]["positive"] == sum(v > 0 for v in ru.values())
    assert s["runner_up"]["D2+H3|base"]["min_market"] == min(ru, key=ru.get) and s["runner_up"]["D2+H3|base"]["min"] == min(ru.values())
    assert s["flags"]["incomplete_n"] == FIRST["flag_summary"]["incomplete_n"] + MID["flag_summary"]["incomplete_n"]
"""Tests for numbers.py: the paper's evaluation-2 numbers come only from report.json."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import numbers_v2 as N  # noqa: E402

REPORT = {"q4": {"k": 5, "passing": ["fresh0", "fresh1"], "markets": {"fresh0": {"gain_diff": 0.27149, "eff_lower": 0.99512}}},
          "q1": {"tests": {"C*-F111|D2+H3": {"estimate": -0.0123, "interval": [-0.031, 0.0069], "category": "equivalent, direction R3 lower",
                                             "better": None}}},
          "confirmatory": True}
TEX = r"""\section{Results}
% BEGIN-EV2
Replicated on \rvk{count}{q4.k} of six markets; d is \rvk{gain}{q1.tests.C*-F111|D2+H3.estimate}.
% END-EV2
Evaluation 1 gains were 0.570 and 0.353.
"""


def _v(old, new):
    """Edit the fixture; fail if the target text is absent (a silent no-op would make the test pass vacuously)."""
    assert old in TEX, old
    return TEX.replace(old, new)


def _setup(tmp_path, tex=TEX, report=REPORT):
    (tmp_path / "report.json").write_text(json.dumps(report)); (tmp_path / "main.tex").write_text(tex)
    N.write(tmp_path / "report.json", tmp_path / "numbers.tex")
    return tmp_path


def test_flatten_formats_numbers_and_escapes_text():
    m = N.macros(REPORT)
    assert m["q4.k"] == "5"
    assert m["q4.markets.fresh0.gain_diff"] == "0.271"
    assert m["q1.tests.C*-F111|D2+H3.estimate"] == r"\ensuremath{-0.012}"
    assert m["q1.tests.C*-F111|D2+H3.interval.1"] == "0.007"
    assert m["q1.tests.C*-F111|D2+H3.better"] == "n/a"
    assert m["confirmatory"] == "yes"
    assert m["q4.passing.0"] == "fresh0"


def test_check_passes_on_consistent_files(tmp_path):
    d = _setup(tmp_path)
    assert N.check(d / "report.json", d / "numbers.tex", d / "main.tex") == []


def test_check_fails_on_unknown_path(tmp_path):
    d = _setup(tmp_path, tex=_v(r"\rvk{count}{q4.k}", r"\rvk{count}{q4.kk}"))
    assert any("q4.kk" in p for p in N.check(d / "report.json", d / "numbers.tex", d / "main.tex"))


def test_check_fails_on_bare_number_in_ev2_block(tmp_path):
    d = _setup(tmp_path, tex=_v(r"\rvk{count}{q4.k} of six", r"\rvk{count}{q4.k} of six, gap 0.271"))
    assert any("0.271" in p for p in N.check(d / "report.json", d / "numbers.tex", d / "main.tex"))


def test_check_ignores_numbers_outside_ev2_blocks(tmp_path):
    d = _setup(tmp_path)
    assert not any("0.570" in p for p in N.check(d / "report.json", d / "numbers.tex", d / "main.tex"))


def test_check_fails_on_stale_numbers_file(tmp_path):
    d = _setup(tmp_path)
    changed = json.loads(json.dumps(REPORT)); changed["q4"]["k"] = 4
    (d / "report.json").write_text(json.dumps(changed))
    assert any("stale" in p for p in N.check(d / "report.json", d / "numbers.tex", d / "main.tex"))


def test_check_fails_on_unclosed_block(tmp_path):
    d = _setup(tmp_path, tex=_v("% END-EV2\n", ""))
    assert any("unclosed" in p for p in N.check(d / "report.json", d / "numbers.tex", d / "main.tex"))


def test_check_fails_on_bare_integer_and_percentage(tmp_path):
    for bad in ("replicated on 5 of the markets", "a 27% reduction"):
        d = _setup(tmp_path, tex=_v(r"Replicated on \rvk{count}{q4.k} of six markets", bad))
        assert any("bare number" in p for p in N.check(d / "report.json", d / "numbers.tex", d / "main.tex")), bad


def test_check_ignores_identifiers_constants_and_references(tmp_path):
    ok = (r"F111 and X7-SC and D2+H3 under H4, Q1, W0, C-mem at \const{$\rho = 1$} (Table~\ref{tab:q4}, \cite{holm1979}, "
          r"\label{sec:r2}) with \includegraphics[width=0.8\linewidth]{f1.png} of six markets")
    d = _setup(tmp_path, tex=_v(r"Replicated on \rvk{count}{q4.k} of six markets", r"Replicated on \rvk{count}{q4.k}; " + ok))
    assert N.check(d / "report.json", d / "numbers.tex", d / "main.tex") == []


def test_render_refuses_nonfinite_values():
    import pytest
    for bad in (float("nan"), float("inf")):
        with pytest.raises(ValueError):
            N.render({"q4": {"x": bad}})


