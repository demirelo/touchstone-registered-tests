TEX2 = r"""% BEGIN-EV2
Replicated on \rvk{count}{q4.k} of six markets; d is \rvk{gain}{q1.tests.C*-F111|D2+H3.estimate} (\rvk{label}{q1.tests.C*-F111|D2+H3.category}).
