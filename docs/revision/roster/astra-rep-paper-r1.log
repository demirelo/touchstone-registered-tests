    49	def _continued(cells: list) -> dict:
    50	    rule = lambda c: "C-thr" if c["kind"] == "cthr" else POLICY[c["policy"]]
    51	    out = {"all": {"cells": len(cells)}, "rules": {r: {"cells": sum(rule(c) == r for c in cells)} for r in RULES}}
    52	    out.update({p: {"cells": sum(c["rate"] == p for c in cells)} for p in RATES})
    53	    return out
