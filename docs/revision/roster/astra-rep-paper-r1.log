    24	def _audit(au: dict) -> dict:
    25	    out = {}
    26	    for p in RATES:
    27	        sh = [s for s in (_share(c) for c in au.get(p, {}).values()) if s is not None]
    28	        out[p] = {"markets": len(sh), "focal_audit_min": min(sh) if sh else None, "focal_audit_max": max(sh) if sh else None}
    29	    below = 0
    30	    for m, c5 in au.get("0.05", {}).items():
    31	        s0, s5 = _share(au.get("0", {}).get(m)), _share(c5)
    32	        below += int(s0 is not None and s5 is not None and s5 < s0)
    33	    out["below"] = {"markets": below}
    34	    return out
