    37	def _eff(terms: dict) -> dict:
    38	    out = {}
    39	    for p in RATES:
    40	        out[p] = {}
    41	        for r in RULES:
    42	            v = [terms[p][m][r]["eff_attack"] for m in sorted(terms[p])]
    43	            if not all(math.isfinite(x) for x in v):
    44	                raise ValueError(f"nonfinite efficiency at {p} {r}")
    45	            out[p][r] = {"eff": sum(v) / len(v), "eff_min": min(v)}
    46	    return out
    47	
