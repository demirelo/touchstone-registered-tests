     1	"""Post-analysis extract for the paper (not part of the stamped manifest): R3's audit counts per winner set, rate and
     2	market, exactly as the committed collector (rep_collect.collect) builds them for expectation 5, and the list of cells
     3	that received continued search, read from the run's continuation directory. Usage:
     4	replication_extract.py --out <followup3-rep dir> --manifest <manifest> --draw <draw.json> --write <json>"""
     5	import argparse
     6	import json
     7	import sys
     8	from pathlib import Path
     9	
    10	HERE = Path(__file__).resolve().parent
    11	sys.path.insert(0, str(HERE))
    12	
    13	
    14	def continued_cells(out: Path) -> list:
    15	    """File stems of the continued cells (one record per flagged cell); the gate and diagnostics folders are excluded."""
    16	    return sorted(p.stem for p in (out / "continuation").glob("*.json"))
    17	
    18	
    19	def parse_cell(stem: str) -> dict:
    20	    """'menu-p0.05__fresh3@rho0.2__F111__D2+H3__profit__churn0.05' -> kind, rate, market index, policy."""
    21	    parts = stem.split("__")
    22	    kind, rate = parts[0].split("-p")
    23	    return {"kind": kind, "rate": rate, "market": "rep" + parts[1].split("@")[0].removeprefix("fresh"), "policy": parts[2]}
    24	
    25	
    26	def main(argv=None) -> int:
    27	    ap = argparse.ArgumentParser()
    28	    ap.add_argument("--out", required=True); ap.add_argument("--manifest", required=True); ap.add_argument("--draw", required=True)
    29	    ap.add_argument("--write", required=True)
    30	    a = ap.parse_args(argv)
    31	    import rep_v2 as V
    32	    import rep_collect as C
    33	    ns = V.main.__globals__["argparse"].Namespace(out=a.out, manifest=a.manifest, draw=a.draw, smoke=False,
    34	                                                  params=str(V.ROOT / "experiments/v2/params.json"))
    35	    V._require(ns)
    36	    c = V._context(ns); jobs = V._jobs_by_dir(c, False)
    37	    col = C.collect(Path(a.out), jobs, gate=V.gate_item(jobs, a.out), smoke=False)
    38	    cells = continued_cells(Path(a.out))
    39	    res = {"audit": {s: {rk: {m: list(v) for m, v in sorted(ms.items())} for rk, ms in sorted(col["audit"][s].items())}
    40	                     for s in ("frozen", "primary")},
    41	           "counts": col["counts"], "continued": [dict(parse_cell(s), stem=s) for s in cells]}
    42	    Path(a.write).write_text(json.dumps(res, indent=1, sort_keys=True) + "\n")
    43	    return 0
    44	
    45	
    46	if __name__ == "__main__":
    47	    sys.exit(main())
## 8. What the outcome would change in the paper

- Expectations 1 to 3 met: the deterioration replicates on new markets under the descriptive criterion; "material" is
  claimed only where the companion also holds.
- Expectation 4 met: the deterioration is not specific to C*; the comparator caveat narrows.
- Expectation 4 not met: "runner-up deterioration not supported", reported without a causal reading.
- Expectations 1 or 2 not met: the draft-10 churn result does not replicate on these markets; the paper reports that as
  its main caveat. An expectation that is not scorable is reported as "not scorable", never as met or not met.
- Every claim is restricted to the generator's market neighbourhood, the four rules, the D2+H3 family and the prescribed
  finite searches.

