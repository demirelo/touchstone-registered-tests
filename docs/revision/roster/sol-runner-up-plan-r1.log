     1	"""Shared descriptive analysis of the follow-up runs in docs/revision/followup2 (exploratory, after the report).
     2	
     3	The registered Q1 machinery used studentized bootstrap intervals with calibrated tails and Holm; these follow-up runs
     4	are not registered, so they use a nominal paired percentile bootstrap (seeds resampled within each market, the same
     5	resampled indices for both rules, equal market weights) and apply the registered Q1 category rules to that nominal
     6	interval, labelled exploratory. d = g(comparator) - g(R3); positive means R3 leaves the lower gain."""
     7	from __future__ import annotations
     8	
     9	import numpy as np
    10	
    11	MARGIN = 0.05                                       # the registered Q1 margin (design 9.3)
    12	RESAMPLES, SEED = 9999, 0
    13	
    14	
    15	def pooled_paired(a: dict, b: dict, resamples: int = RESAMPLES, seed: int = SEED, level: float = 0.95) -> dict:
    16	    """`a`, `b`: market -> per-seed gains on the same seeds in the same order. Pooled = mean of the market means."""
    17	    markets = sorted(a)
    18	    if sorted(b) != markets:
    19	        raise ValueError("the two rules cover different markets")
    20	    diffs = {}
    21	    for m in markets:
    22	        x, y = np.asarray(a[m], float), np.asarray(b[m], float)
    23	        if x.shape != y.shape:
    24	            raise ValueError(f"{m}: unequal seed counts")
    25	        diffs[m] = x - y
    26	    rng = np.random.default_rng(seed); reps = np.empty(resamples)
    27	    for i in range(resamples):
    28	        reps[i] = np.mean([d[rng.integers(0, len(d), len(d))].mean() for d in (diffs[m] for m in markets)])
    29	    q = (1 - level) / 2
    30	    return {"markets": {m: float(diffs[m].mean()) for m in markets}, "estimate": float(np.mean([diffs[m].mean() for m in markets])),
    31	            "interval": [float(np.quantile(reps, q)), float(np.quantile(reps, 1 - q))], "resamples": resamples, "seed": seed, "level": level}
    32	
    33	
    34	def q1_category(interval) -> str:
    35	    """The registered Q1 categories (design 9.3), applied descriptively to a nominal interval."""
    36	    lo, hi = interval
    37	    if lo > MARGIN:
    38	        return "materially lower (R3 lower)"
    39	    if hi < -MARGIN:
    40	        return "materially lower (comparator lower)"
    41	    if -MARGIN <= lo and hi <= MARGIN:
    42	        if lo > 0:
    43	            return "equivalent, direction R3 lower"
    44	        if hi < 0:
    45	            return "equivalent, direction comparator lower"
    46	        return "equivalent"
    47	    if lo > 0 or hi < 0:
    48	        return "ordered, size not established"
    49	    return "inconclusive"

