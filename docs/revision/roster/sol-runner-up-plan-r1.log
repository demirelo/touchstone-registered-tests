from __future__ import annotations

import hashlib
import json
from pathlib import Path

import yaml

from .config import MarketConfig, ProviderParams

import os

DEFAULT_PATH = Path(__file__).resolve().parents[1] / "experiments" / "locked.yaml"


def load_locked(path: str | Path | None = None) -> dict:
    """The locked file; TOUCHSTONE_LOCKED (read at call time) exists for synthetic tests only, and scripts/check_claim.py
    refuses to run with it set."""
    path = Path(path) if path is not None else Path(os.environ.get("TOUCHSTONE_LOCKED") or DEFAULT_PATH)
    with open(path) as f:
        return yaml.safe_load(f)


def seeds(locked: dict, namespace: str) -> list[int]:
    v = locked["seeds"].get(namespace)
    if v is None and namespace == "final_eval":
        from .registry import SEALED_DIR
        if (SEALED_DIR / "final_eval_seeds.json").exists():
            from .sealed import final_eval_seeds, verify_bundle
            verify_bundle(SEALED_DIR, locked)                 # the seeds count only from a bundle that matches the lock commitment
            return final_eval_seeds(SEALED_DIR)
    if v is None:
        raise ValueError(f"seed namespace {namespace!r} is not available (final-eval seeds are released with the sealed bundle)")
    return [int(x) for x in v]


def sha256_file(path: str | Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def settings_hash(locked: dict) -> str:
    """Hash of every experimental setting: the whole file except the version label and the blocks written at the lock
    (tuned, calibration, the coverage report hash and consequences, the comprehension fixture hash, and the sealed
    bundle hash by the lock tooling; identity_salt_sha256 by the separate session; h1.cost_cap_usd from the token
    pilot), so installing them at the lock keeps the pre-lock artifacts valid."""
    skip = ("version", "tuned", "calibration", "identity_salt_sha256", "sealed_bundle_sha256", "coverage_report_sha256",
            "comprehension_fixture_sha256", "coverage_consequences")
    bound = {k: v for k, v in locked.items() if k not in skip}
    if isinstance(bound.get("h1"), dict):
        bound["h1"] = {k: v for k, v in bound["h1"].items() if k not in ("cost_cap_usd", "prices")}   # measured figures, never results
    return hashlib.sha256(json.dumps(bound, sort_keys=True).encode()).hexdigest()


def market_config_from_locked(locked: dict) -> MarketConfig:
    mk = locked["market"]; pt = mk["providers"]
    providers = tuple(ProviderParams(q_max=float(q), a=float(a), b=float(b), k=int(k))
                      for q, a, b, k in zip(pt["q_max"], pt["a"], pt["b"], pt["k"]))
    return MarketConfig(N=int(mk["N"]), J=int(mk["J"]), T=int(mk["T"]), sigma=float(mk["sigma"]), e=float(mk["e"]),
                        v_min=float(mk["v_min"]), v_max=float(mk["v_max"]), providers=providers, alpha=0.0, budget=0.0)
"""Market instances and seed streams of the revision program (design 7.1, 7.2). A synthetic neighbourhood of the headline
market: N 10, J 50, T 200, sigma 0.05, no entry cost, v_min 0.6, beta 0.05, rho 0.2; per draw, sorted quality ceilings,
cost slopes falling with quality (plus noise), fixed costs, capacities, and the value ceiling. Every random input comes
from a domain-separated SHA-256 digest of a root: "dev-20261022" for the public development instances, the Bitcoin block
hash at height H for the fresh ones. Draw order inside an attempt: q_max (10), b_lo, b_hi, b noise (10), a (10), k (10),
v_max; attempts repeat in the same stream until the configuration validates."""
from __future__ import annotations

import hashlib

import numpy as np

from .calibrate import calibrate, cell_config
from .config import MarketConfig, ProviderParams

DEV_ROOT = "dev-20261022"
EVAL_RANGE = (30_000_000, 40_000_000)
COVERAGE_RANGE = (40_000_000, 60_000_000)
CALIBRATION_SEEDS = tuple(range(4000, 4020))
LIMIT = 10_000


class InstanceLimit(RuntimeError):
    pass


def digest(root: str, domain: str, n: int) -> bytes:
    return hashlib.sha256(f"{root}|touchstone-v2|{domain}|{int(n)}".encode("ascii")).digest()


def stream(root: str, i: int) -> np.random.Generator:
    return np.random.Generator(np.random.PCG64(int.from_bytes(digest(root, "instance", i)[:16], "big")))


def draw_instance(rng: np.random.Generator, limit: int = LIMIT) -> tuple[MarketConfig, int]:
    for rejections in range(int(limit)):
        q = np.sort(rng.uniform(0.55, 1.0, 10)); b_lo = rng.uniform(0.18, 0.26); b_hi = rng.uniform(0.34, 0.46)
        noise = rng.uniform(-0.02, 0.02, 10); a = rng.uniform(0.0, 0.05, 10); k = rng.integers(4, 9, size=10); v_max = rng.uniform(1.2, 1.6)
        b = [b_hi - (b_hi - b_lo) * r / 9 + noise[r] for r in range(10)]
        providers = tuple(ProviderParams(q_max=float(q[r]), a=float(a[r]), b=float(b[r]), k=int(k[r])) for r in range(10))
        cfg = MarketConfig(N=10, J=50, T=200, sigma=0.05, e=0.0, v_min=0.6, v_max=float(v_max), providers=providers, alpha=0.05, budget=0.0)
        try:
            cfg.validate()
        except ValueError:
            continue
        return cfg, rejections
    raise InstanceLimit(f"no valid instance in {limit} draws")


def _draw_stream(root: str, i: int, limit: int) -> tuple[MarketConfig, int]:
    return draw_instance(stream(root, i), limit)


def markets(root: str, count: int, prefix: str = "fresh", limit: int = LIMIT) -> list[dict]:
    """Label <prefix><i> uses stream i; a stream that hits the limit gives its label the next unused index >= count."""
    out, spare = [], int(count)
    for i in range(int(count)):
        idx = i
        while True:
            try:
                cfg, rej = _draw_stream(root, idx, limit); break
            except InstanceLimit:
                idx, spare = spare, spare + 1
        out.append({"label": f"{prefix}{i}", "stream_index": idx, "cfg": cfg, "rejections": rej})
    return out


def dev_markets() -> list[dict]:
    return markets(DEV_ROOT, 2, prefix="dev")


def calibrated(cfg: MarketConfig, rho: float = 0.2, beta: float = 0.05) -> MarketConfig:
    return cell_config(cfg, calibrate(cfg, list(CALIBRATION_SEEDS)), rho=rho, beta=beta)


def _seeds(root: str, domain: str, n: int, lo: int, width: int) -> list[int]:
    out, seen, c = [], set(), 0
    while len(out) < int(n):
        v = lo + int.from_bytes(digest(root, domain, c)[:8], "big") % width; c += 1
        if v not in seen:
            seen.add(v); out.append(v)
    return out


def eval_seeds(root: str, label: str, n: int = 200) -> list[int]:
    return _seeds(root, "seeds/" + label, n, EVAL_RANGE[0], EVAL_RANGE[1] - EVAL_RANGE[0])


def coverage_pool(label: str, n: int = 20_000) -> list[int]:
    return _seeds(DEV_ROOT, "coverage/" + label, n, COVERAGE_RANGE[0], COVERAGE_RANGE[1] - COVERAGE_RANGE[0])


def identity_salt_hex(root: str) -> str:
    return digest(root, "salt", 0).hex()
"""Loader of the sealed, independently authored family H4 (design 5.3). The bundle's h4/family.py exports
make_family(T, L) -> Family and BINARY (the binary knob names, clip included); the loader verifies the bundle hash, imports
the module by absolute path, and checks the family at two constant pairs (a Family named H4, clip last, bounds for every
non-binary knob). Any failure excludes H4 and is reported; there is no repair after the lock."""
from __future__ import annotations

import hashlib
import importlib.util
from dataclasses import dataclass
from pathlib import Path

import math

from .policies.families import Family

BUNDLE_FILES = ("h4/family.py", "h4/containment.md", "h4/check.json")
CHECK_CONSTANTS = ((200, 10), (100, 20))
MAX_KNOBS = 15                                   # design draft 7, 5.3: the resource envelope


def bundle_sha(bundle_dir) -> str:
    h = hashlib.sha256()
    for rel in BUNDLE_FILES:
        h.update(rel.encode()); h.update(b"\0"); h.update(hashlib.sha256((Path(bundle_dir) / rel).read_bytes()).hexdigest().encode()); h.update(b"\n")
    return h.hexdigest()


@dataclass(frozen=True)
class Excluded:
    reason: str


class H4Source:
    def __init__(self, module) -> None:
        self.module = module

    def family(self, T: int, L: int) -> Family:
        return self.module.make_family(int(T), int(L))


def _check(fam, binary) -> str | None:
    if not isinstance(fam, Family):
        return "make_family did not return a Family"
    if fam.name != "H4":
        return f"family name {fam.name!r} is not H4"
    if not fam.knobs or fam.knobs[-1] != "clip" or "clip" in fam.bounds:
        return "clip must be the last, binary knob"
    if len(fam.knobs) > MAX_KNOBS:
        return f"{len(fam.knobs)} knobs: the envelope allows at most {MAX_KNOBS} knobs"
    if not callable(getattr(fam, "project", None)):
        return "the family has no callable project (truthful projection)"
    missing = [k for k in fam.knobs if k not in fam.bounds and k not in binary]
    if missing:
        return f"no bounds for non-binary knob(s) {missing}"
    if any(not (math.isfinite(float(lo)) and math.isfinite(float(hi))) for lo, hi in fam.bounds.values()):
        return "knob bounds must be finite"
    if any(not (float(lo) < float(hi)) for lo, hi in fam.bounds.values()):
        return "empty knob bounds"
    return None


def load(bundle_dir, expected_sha256: str) -> H4Source | Excluded:
    d = Path(bundle_dir)
    try:
        got = bundle_sha(d)
    except OSError as e:
        return Excluded(f"bundle unreadable: {e}")
    if got != expected_sha256:
        return Excluded(f"bundle hash {got} differs from the protocol's {expected_sha256}")
    try:
        spec = importlib.util.spec_from_file_location("touchstone_sealed_h4", d / "h4/family.py")
        mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
        make, binary = getattr(mod, "make_family"), tuple(getattr(mod, "BINARY"))
        for T, L in CHECK_CONSTANTS:
            problem = _check(make(T, L), binary)
            if problem:
                return Excluded(problem)
    except Exception as e:                       # the family is untrusted code: any failure excludes it
        return Excluded(f"load failed: {type(e).__name__}: {e}")
    return H4Source(mod)
