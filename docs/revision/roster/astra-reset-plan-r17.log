   196	def watchdog(name, hard_ts, done_file, run=_run, clock=time.time, sleep=time.sleep, here=HERE, settle=SETTLE,
   197	             mono=time.monotonic):
   198	    """Ends only when DONE_FILE exists and successful listings show no pod named NAME for the settle time, counted from
   199	    DONE onwards (r11); while NAME.request is "pending" (an outstanding or ambiguous creation request) the settle time is
   200	    at least AMBIGUOUS_SETTLE. After DONE (the launcher reconciles first) any pod named NAME is an orphan and is deleted.
   201	    From HARD_TS it also blocks creation and deletes every pod named NAME, with no retry limit. On exit it writes
   202	    NAME.wdend and releases NAME.launchlock (it is the last process of a launch). Wall time (CLOCK) is used only for the
   203	    hard deadline; the settle time and deletion budgets use MONO, so a clock change cannot shorten them (r16)."""
   204	    blocked = False
   205	    empty_since = None
   206	    while True:
   207	        if not blocked and clock() >= hard_ts:
   208	            open(os.path.join(here, f"{name}.blocked"), "w").write(str(int(clock())))
   209	            print(f"{time.strftime('%H:%M')} WATCHDOG: hard deadline; creation blocked; deleting every pod named {name}", flush=True)
   210	            blocked = True
   211	        done = os.path.exists(done_file)
   212	        need = max(settle, AMBIGUOUS_SETTLE) if _request_pending(here, name) else settle
   213	        if done or blocked:
   214	            pods = list_pods(run)
   215	            if pods is None:
   216	                empty_since = None
   217	            else:
   218	                ids = named(pods, name)
   219	                if ids:
   220	                    empty_since = None
   221	                    for i in ids:
   222	                        print(f"{time.strftime('%H:%M')} WATCHDOG: deleting {i}", flush=True)
   223	                        delete_verified(i, 120, run, mono, sleep)
   224	                elif done:
   225	                    empty_since = mono() if empty_since is None else empty_since
   226	                    if mono() - empty_since >= need:
   227	                        open(os.path.join(here, f"{name}.wdend"), "w").write(str(time.time()))
   228	                        try:
   229	                            os.rmdir(os.path.join(here, f"{name}.launchlock"))
   230	                        except OSError:
   231	                            pass
   232	                        print(f"{time.strftime('%H:%M')} WATCHDOG: no pod named {name} for {need}s after the launcher was done; "
   233	                              f"record the spend with `podctl.py spend {name}` from {WAIT_AFTER_WATCHDOG}s after now", flush=True)
   234	                        return 0
   235	                else:
   236	                    empty_since = None
   237	        sleep(30 if blocked else min(30, max(0.0, hard_ts - clock())) or 30)
   238	
