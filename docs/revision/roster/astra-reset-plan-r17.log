   240	def main(argv) -> int:
   241	    cmd, a = argv[0], argv[1:]
   242	    if cmd == "reconcile":
   243	        return 0 if reconcile(a[0], a[1] if len(a) > 1 else "") else 1
   244	    if cmd == "delete":
   245	        return 0 if delete_verified(a[0], float(a[1])) else 1
