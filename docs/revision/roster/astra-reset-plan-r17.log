   156	def spend(name, run=_run, clock=time.time, here=HERE):
   157	    """(USD rounded up to a cent, note) or (None, reason); on success also writes NAME.spent. Needs NAME.bal0, NAME.wdend
   158	    at least WAIT_AFTER_WATCHDOG s old, a successful listing with no pod named NAME, a readable balance, and a balance
   159	    that did not rise (a rise proves a credit or deposit). The difference is valid only if no deposit or credit was
   160	    added in the window (r16): the author confirms that on the Runpod billing page; the note names the window."""
   161	    f0 = os.path.join(here, f"{name}.bal0")
   162	    try:
   163	        bal0 = Decimal(open(f0).read().split()[0]); t0 = os.path.getmtime(f0)
   164	    except (OSError, IndexError, InvalidOperation):
   165	        return None, "no starting balance (NAME.bal0)"
   166	    try:
   167	        wdend = float(open(os.path.join(here, f"{name}.wdend")).read().split()[0])
   168	    except (OSError, ValueError, IndexError):
   169	        return None, "the watchdog has not ended"
   170	    if clock() - wdend < WAIT_AFTER_WATCHDOG:
   171	        return None, f"wait until {WAIT_AFTER_WATCHDOG} s after the watchdog ended"
   172	    pods = list_pods(run)
   173	    if pods is None or named(pods, name):
   174	        return None, "a pod named NAME may still exist"
   175	    b = balance(run)
   176	    if b is None:
   177	        return None, "balance unknown"
   178	    now = Decimal(str(b[0]))
   179	    if now > bal0:
   180	        return None, "the balance rose (a credit or deposit was added); take the spend from the Runpod billing page"
   181	    usd = float((bal0 - now).quantize(Decimal("0.01"), rounding=ROUND_CEILING))
   182	    note = (f"balance difference; valid only if no deposit or credit was added between {_utc(t0)} and {_utc(clock())} "
   183	            f"(check the Runpod billing page)"
   184	            + (f"; the account still bills {b[1]} USD/h elsewhere, so this overstates" if b[1] > 0 else ""))
   185	    open(os.path.join(here, f"{name}.spent"), "w").write(f"{usd} USD {note}\n")
   186	    return usd, note
