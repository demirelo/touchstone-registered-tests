   104	def classify_creation(answer, exc=None):
   105	    """(pod id, ambiguous) for one creation request. Only a clear client refusal (HTTP 4xx other than 408 and 429) is
   106	    unambiguous; a timeout, exception, server or gateway error, or unreadable answer may still create a pod (r11)."""
   107	    if exc is not None:
   108	        return "", True
   109	    if isinstance(answer, dict) and answer.get("id"):
   110	        return str(answer["id"]), False
   111	    if isinstance(answer, dict) and isinstance(answer.get("error"), int):
   112	        code = answer["error"]
   113	        return "", not (400 <= code < 500 and code not in (408, 429))
   114	    return "", True
