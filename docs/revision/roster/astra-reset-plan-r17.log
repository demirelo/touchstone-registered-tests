   137	def balance(run=_run):
   138	    """(balance USD, account spend USD/h) from `runpod.py balance`, or None when either is missing or unreadable."""
   139	    rc, out = run(["balance"], timeout=60)
   140	    if rc != 0:
   141	        return None
   142	    try:
   143	        d = json.loads(out)
   144	    except ValueError:
   145	        return None
   146	    if not isinstance(d, dict):
   147	        return None
   148	    b, s = _finite(d.get("balance"), -math.inf), _finite(d.get("spendPerHr"), 0)
   149	    return None if b is None or s is None else (b, s)
