   126	def _write(tmp, seeds_d2=None, n=40):
   127	    ev, rs = tmp / "eval", tmp / "reset"
   128	    for d in (ev / "evaluate", rs / "evaluate", rs / "doubling"):
   129	        d.mkdir(parents=True, exist_ok=True)
   130	    seeds = list(range(n))
   131	    for m in M6:
   132	        for rule in RB.RULES:
   133	            for fam, root, s in (("D2+H3", ev, seeds), ("D2", rs, seeds_d2 or seeds)):
   134	                rid = f"{m}@rho0.2|{rule}|{fam}|profit"
   135	                (root / "evaluate" / (RB.safe(rid) + ".json")).write_text(json.dumps({"id": rid, "seeds": s, "gain": [0.1] * n}))
   136	            rid = f"{m}@rho0.2|{rule}|D2|profit"
   137	            (rs / "doubling" / (RB.safe(rid) + ".json")).write_text(json.dumps({"id": rid, "attack_change": 0.01, "reference_change": 0.0,
   138	                                                                                "incomplete": False, "heldout": {"seeds": seeds_d2 or seeds, "gain": [0.2] * n}}))
