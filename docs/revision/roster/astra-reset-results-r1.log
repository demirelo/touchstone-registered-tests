M6 = tuple(f"fresh{i}" for i in range(6))


def _cells(i_b3=0.3, i_r3=0.01, i_c=0.05, g_r3_d2h3=0.05, g_r3_d2=0.03, n=40, noise=0.0, seed=0):
    """Synthetic per-seed gains: D2+H3 gains are D2 gains plus I; B3-R3 gap under D2 is 0.01 by construction."""
    rng = np.random.default_rng(seed); cells = {}
    for m in M6:
        e = rng.normal(0, noise, n) if noise else np.zeros(n)
        d2 = {"F111": g_r3_d2 + e, "F000": g_r3_d2 + 0.01 + e, "C*": g_r3_d2 + 0.005 + e}
        d2h3 = {"F111": d2["F111"] + i_r3, "F000": d2["F000"] + i_b3, "C*": d2["C*"] + i_c}
        cells[m] = {"D2+H3": d2h3, "D2": d2}
    return cells


def test_point_estimates_of_i_contrasts_gaps_and_share():
    s = RB.statistics(_cells())
    assert s["I"]["F000"]["pooled"] == pytest.approx(0.3) and s["I"]["F111"]["pooled"] == pytest.approx(0.01)
    assert s["contrast"]["B3-R3"]["pooled"] == pytest.approx(0.29) and s["contrast"]["C*-R3"]["pooled"] == pytest.approx(0.04)
    assert s["G"]["D2"]["pooled"] == pytest.approx(0.01) and s["G"]["D2+H3"]["pooled"] == pytest.approx(0.30)
    assert s["S"]["pooled"] == pytest.approx(1 - 0.01 / 0.30)


def test_pooled_is_the_equal_weight_mean_of_market_means():
    c = _cells(); c["fresh0"]["D2+H3"]["F000"] = c["fresh0"]["D2+H3"]["F000"] + 0.6   # I(B3) = 0.9 at fresh0 only
    s = RB.statistics(c)
    assert s["I"]["F000"]["markets"]["fresh0"] == pytest.approx(0.9)
    assert s["I"]["F000"]["pooled"] == pytest.approx((0.9 + 5 * 0.3) / 6)


def test_share_undefined_when_the_denominator_lower_bound_is_at_or_below_005():
    c = _cells(i_b3=0.04, i_r3=0.01, noise=0.02)          # pooled G(D2+H3) = 0.04: lower bound below 0.05
    r = RB.analyse(c, b=999, seed=1)
    assert r["S"]["pooled"]["value"] is None and r["S"]["pooled"]["reason"].startswith("not defined")
    assert r["G"]["D2+H3"]["pooled"]["estimate"] == pytest.approx(0.04)  # the gaps are reported anyway


def test_share_defined_and_not_clipped():
    c = _cells(i_b3=0.3, i_r3=0.01)
    for m in M6:                                           # G(D2) negative, so S > 1
        c[m]["D2"]["F000"] = c[m]["D2"]["F111"] - 0.05; c[m]["D2+H3"]["F000"] = c[m]["D2"]["F000"] + 0.3
    r = RB.analyse(c, b=199, seed=1)
    assert r["S"]["pooled"]["value"] > 1


def test_bootstrap_uses_the_same_seed_indices_for_every_rule_and_family_of_a_market():
    c = _cells(noise=0.05, seed=3)                         # identical noise in every rule and family of a market
    r = RB.analyse(c, b=499, seed=2)
    lo, hi = r["G"]["D2"]["pooled"]["ci95"]               # the shared noise cancels in a paired contrast
    assert hi - lo == pytest.approx(0.0, abs=1e-12)
    lo, hi = r["I"]["F000"]["pooled"]["ci95"]
    assert hi - lo == pytest.approx(0.0, abs=1e-12)


def test_bootstrap_is_reproducible_and_has_9999_resamples_by_default():
    assert RB.B == 9999
    c = _cells(noise=0.05, seed=4)
    for m in M6:                                           # break the pairing so intervals have width
        c[m]["D2"]["F111"] = c[m]["D2"]["F111"] + np.random.default_rng(9).normal(0, 0.05, 40)
    a, b = RB.analyse(c, b=299, seed=5), RB.analyse(c, b=299, seed=5)
    assert a["G"]["D2"]["pooled"]["ci95"] == b["G"]["D2"]["pooled"]["ci95"]
    lo, hi = a["G"]["D2"]["pooled"]["ci95"]
    assert lo < a["G"]["D2"]["pooled"]["estimate"] < hi


def test_market_sensitivity_sign_counts_and_leave_one_out_share():
    c = _cells(); c["fresh2"]["D2+H3"]["F000"] = c["fresh2"]["D2"]["F000"] - 0.02     # I(B3) < I(R3) at fresh2
    r = RB.analyse(c, b=199, seed=1)
    assert r["sensitivity"]["signs"]["B3-R3"] == {"positive": 5, "n": 6}
    assert r["sensitivity"]["signs"]["C*-R3"] == {"positive": 6, "n": 6}
    loo = r["sensitivity"]["S_leave_one_out"]
    assert set(loo) == set(M6) and all(v["value"] is not None for v in loo.values())


def test_leave_one_out_has_its_own_five_market_gate():
    c = _cells(i_b3=0.3)
    for m in M6[1:]:                                       # only fresh0 carries a B3 - R3 gap under D2+H3
        c[m]["D2+H3"]["F000"] = c[m]["D2+H3"]["F111"] + 0.0
    r = RB.analyse(c, b=199, seed=1)
    assert r["sensitivity"]["S_leave_one_out"]["fresh0"]["value"] is None     # five markets left: no gap
    assert r["sensitivity"]["S_leave_one_out"]["fresh1"]["value"] is not None  # fresh0 kept: 0.30 / 5 = 0.06 > 0.05


def test_missing_cell_is_reported_not_imputed():
    c = _cells(); del c["fresh3"]["D2"]["C*"]
    r = RB.analyse(c, b=99, seed=1)
    assert "fresh3|C*|D2" in r["missing"]
    assert "fresh3" not in r["I"]["C*"]["markets"]


def test_seed_mismatch_refused(tmp_path):
    ev, rs = _write(tmp_path, seeds_d2=list(range(1, 41)))
    with pytest.raises(ValueError, match="seeds"):
        RB.load(ev, rs, _report(tmp_path, ev), M6)


def test_expectation_scoring_met_failed_not_established():
    base = {"all_markets": {"B3-R3": True, "C*-R3": True}, "S": 0.8}
    dbl = {"all_markets": {"B3-R3": True, "C*-R3": False}, "S": 0.4}
    e = RB.score(base, dbl)
    assert e["B3-R3 on all six"] == "met"
    assert e["C*-R3 on all six"] == "not established (search-sensitive)"
    assert e["pooled S > 0.5"] == "not established (search-sensitive)"
    e = RB.score({"all_markets": {"B3-R3": False, "C*-R3": False}, "S": None}, {"all_markets": {"B3-R3": False, "C*-R3": False}, "S": None})
    assert e["B3-R3 on all six"] == "failed" and e["pooled S > 0.5"] == "S not defined"


def test_expectations_need_all_six_markets():
    c = _cells(); del c["fresh1"]["D2"]["F000"]
    r = RB.analyse(c, b=99, seed=1)
    assert r["expectation_inputs"]["all_markets"]["B3-R3"] is None    # a missing cell is not a pass


# ---- loading from records ----
"""Evaluation-2 numbers for the paper, generated from report.json (paper draft 9 outline, "Rules for the text").

--write flattens report.json into one LaTeX macro per path: the text writes \\rv{q4.k} or \\rv{q1.tests.C*-F111|D2+H3.estimate}.
--check fails when a path used in the text is not in the report, when numbers.tex is stale, or when a bare decimal
number (decimal, integer, or percentage, outside identifiers such as F111) appears between `% BEGIN-EV2` and `% END-EV2` (evaluation-2 result text must use macros)."""
from __future__ import annotations

import argparse
import json
import math
import re
import sys
from pathlib import Path

DIGITS = 3
BARE = re.compile(r"(?<![A-Za-z0-9_.])-?(?:\d+(?:\.\d+)?|\.\d+)%?")       # decimals, integers, percentages; not F111, X7-SC, D2+H3
# Stripped before the bare-number scan: \const{} (protocol constants, marked explicitly) and arguments of references.
EXEMPT = re.compile(r"_\{[0-9]+\}|_[0-9]|\\(?:const|evone)\{[^}]*\}|\\(?:ref|eqref|cite|citep|citet|label|input|include|includegraphics|url|href)(?:\[[^\]]*\])?\{[^}]*\}")
USE = re.compile(r"\\rv\{([^}]*)\}")
USEK = re.compile(r"\\rvk\{(\w+)\}\{([^}]*)\}")
SITE = re.compile(r"\\site\{([^}]*)\}")
SECTION = re.compile(r"\\section\*?\s*\{([^}]*)\}(?:\s*\\label\{sec:([^}]*)\})?")
FULL = ("abstract", "results")       # sections that must lie wholly inside result regions
NOBARE = REQUIRED = ("abstract", "intro", "results", "discussion", "conclusion")   # no unmarked number outside regions; captions likewise
LABEL = re.compile(r"\\label\{sec:([^}]*)\}")
COMMENT = re.compile(r"(?<!\\)%.*")
INPUT = re.compile(r"\\(?:input|include)\{([^}]*)\}")
P_LEAVES = {"p", "p_gain", "p_eff", "calibrated", "holm_adjusted", "calibrated_gain", "calibrated_eff"}
# Kinds for prose in result regions: the field name and the value type must fit the sentence's statistic.
COUNT_LEAVES = {"k", "fulfilled", "failed", "not assessed",           # Q4's k; the prediction tallies (score_v2.py)
                "positive", "n", "embedded_identical", "cells", "flagged", "checks", "over_threshold"}    # Fable 5.2 review counts (posthoc)
KINDS = {"count": lambda leaf, v: leaf in COUNT_LEAVES and isinstance(v, int) and not isinstance(v, bool),
         "p": lambda leaf, v: leaf in P_LEAVES and isinstance(v, float) and 0 <= v <= 1,
         "gain": lambda leaf, v: leaf in {"estimate", "gain_diff", "gain_diff_lower", "attacker_gain", "0", "1", "q1_frozen", "q1_doubled",
                                          "q4_frozen", "q4_doubled", "mean_gain", "mean", "difference", "pooled", "max_shortfall", "fresh1"} and isinstance(v, float),
         "ratio": lambda leaf, v: leaf == "relative" and isinstance(v, float),
         "share_s": lambda leaf, v: leaf == "value" and isinstance(v, float),          # reset follow-up S (not clipped)
         "share": lambda leaf, v: leaf == "audited_share" and isinstance(v, float) and 0 <= v <= 1,
         "eff": lambda leaf, v: leaf in {"eff", "eff_lower", "efficiency", "0", "1"} and isinstance(v, float),
         "label": lambda leaf, v: isinstance(v, str)}
HEADER = "% Generated by docs/revision/paper-v2/numbers_v2.py from report.json; do not edit.\n"
PREAMBLE = "\\providecommand{\\const}[1]{#1}\n\\providecommand{\\evone}[1]{#1}\n\\providecommand{\\rvk}[2]{\\rv{#2}}\n\\providecommand{\\site}[1]{\\ifcsname site@#1\\endcsname\\csname site@#1\\endcsname\\else\\textbf{??#1}\\fi}\n\\providecommand{\\rv}[1]{\\ifcsname rv@#1\\endcsname\\csname rv@#1\\endcsname\\else\\textbf{??#1}\\fi}\n"


def _fmt(v) -> str:
    if v is None:
        return "n/a"
    if isinstance(v, bool):
        return "yes" if v else "no"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        if not math.isfinite(v):
            raise ValueError(f"nonfinite value in the report: {v}")
        s = f"{v:.{DIGITS}f}"
        return f"\\ensuremath{{{s}}}" if s.startswith("-") else s
    return re.sub(r"([&%$#_{}])", r"\\\1", str(v))


def _fmt_p(v) -> str:
    """p-values: four significant digits; small values in scientific form, so a nonzero p never prints as 0.000."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return _fmt(v)
    if not math.isfinite(v):
        raise ValueError(f"nonfinite value in the report: {v}")
    s = f"{float(v):.4g}"
    if "e" in s:
        m, e = s.split("e")
        return f"\\ensuremath{{{m}\\times10^{{{int(e)}}}}}"
    return s


def flat(report, prefix: str = "") -> dict:
    """Report path to raw value."""
    out = {}
    items = report.items() if isinstance(report, dict) else enumerate(report)
    for k, v in items:
        path = f"{prefix}{k}"
        out.update(flat(v, path + ".")) if isinstance(v, (dict, list)) else out.__setitem__(path, v)
    return out


def _is_p(path: str) -> bool:
    parts = path.split(".")
    return parts[-1] in P_LEAVES or (len(parts) >= 2 and parts[-2] in P_LEAVES)


def macros(report: dict) -> dict:
    return {p: (_fmt_p(v) if _is_p(p) else _fmt(v)) for p, v in flat(report).items()}


def render(report: dict, sites: dict | None = None) -> str:
    m = macros(report)
    # With a site manifest the text uses only \\site{}, so only site macros are written (the full path list ran to
    # 219k lines and overflowed pdfLaTeX's string pool, 2026-11-05).
    lines = [] if sites is not None else [f"\\expandafter\\def\\csname rv@{p}\\endcsname{{{v}}}" for p, v in sorted(m.items())]
    lines += [f"\\expandafter\\def\\csname site@{n}\\endcsname{{{m.get(d['path'], '??' + n)}}}" for n, d in sorted((sites or {}).items())]
    return HEADER + PREAMBLE + "\n".join(lines) + "\n"


def _sites(path) -> dict | None:
    """The result-site manifest: site name -> {path, kind, section}; read from beside the given file when present."""
    f = Path(path).parent / "sites.json"
    return json.loads(f.read_text()) if f.exists() else None


def load(report_path, extra: dict | None = None) -> dict:
    """report.json at the top level; each extra source (name -> path: cells.json, scoring.json) under its own name."""
    data = json.loads(Path(report_path).read_text())
    for name, path in (extra or {}).items():
        if name in data:
            raise ValueError(f"extra source name {name} collides with a report key")
        data[name] = json.loads(Path(path).read_text())
    return data


def write(report_path, numbers_path, extra: dict | None = None) -> None:
    Path(numbers_path).write_text(render(load(report_path, extra), _sites(numbers_path)))


def _blocks(tex: str) -> tuple[list[str], list[str]]:
    blocks, problems, cur = [], [], None
    for n, line in enumerate(tex.splitlines(), 1):
        s = line.strip()
        if s == "% BEGIN-EV2":
            if cur is not None:
                problems.append(f"line {n}: nested BEGIN-EV2")
            cur = []
        elif s == "% END-EV2":
            if cur is None:
                problems.append(f"line {n}: END-EV2 without BEGIN-EV2")
            else:
                blocks.append("\n".join(cur)); cur = None
        elif cur is not None and not s.startswith("%"):
            cur.append(line)
    if cur is not None:
        problems.append("unclosed BEGIN-EV2 block")
    return blocks, problems


def strip_comments(text: str) -> str:
    """Remove LaTeX comments (a % after an even number of backslashes), keeping the region marker lines."""
    out = []
    for line in text.splitlines():
        if line.strip() in ("% BEGIN-EV2", "% END-EV2"):
            out.append(line.strip()); continue
        cut, i = len(line), 0
        while i < len(line):
            if line[i] == "%":
                k = i
                while k > 0 and line[k - 1] == "\\":
                    k -= 1
                if (i - k) % 2 == 0:
                    cut = i; break
            i += 1
        out.append(line[:cut])
    return "\n".join(out) + "\n"


def sources(tex_path, numbers_path=None) -> str:
    """The text with every \\input or \\include file inlined, except the generated numbers file and generated tables
    (checked by tables_v2.py --check)."""
    base = Path(tex_path).parent; skip = {Path(numbers_path).name} if numbers_path else set()
    def inline(m):
        name = m.group(1); f = base / (name if name.endswith(".tex") else name + ".tex")
        if f.name in skip or name.startswith("tables/") or not f.exists():
            return m.group(0)
        return sources(f, numbers_path)
    return INPUT.sub(inline, strip_comments(Path(tex_path).read_text()))      # comments first: a commented \\input is not followed


def _report_numbers(raw: dict) -> set:
    return {f"{v:.3f}" for v in raw.values() if isinstance(v, float) and not isinstance(v, bool) and math.isfinite(v)}


def check(report_path, numbers_path, tex_path, extra: dict | None = None) -> list[str]:
    report = load(report_path, extra); known = macros(report); raw = flat(report)
    tex = sources(tex_path, numbers_path); problems = []
    sites = _sites(tex_path)
    if not Path(numbers_path).exists() or Path(numbers_path).read_text() != render(report, sites):
        problems.append(f"{numbers_path}: stale or missing; run --write")
    used = set(USE.findall(tex)) | {p for _, p in USEK.findall(tex)}
    problems += [f"unknown report path in the text: {p}" for p in sorted(used) if p not in known]
    for kind, p in USEK.findall(tex):
        if kind not in KINDS:
            problems.append(f"unknown kind {kind} for {p}")
        elif p in raw and not KINDS[kind](p.split(".")[-1], raw[p]):
            problems.append(f"kind {kind} does not fit {p} (value {raw[p]!r})")
    blocks, bp = _blocks(tex); problems += bp
    for b in blocks:
        problems += [f"plain \\rv in an evaluation-2 block (use \\rvk with a kind): {p}" for p in USE.findall(b)]
        bare = BARE.findall(EXEMPT.sub("", USEK.sub("", USE.sub("", b))))
        problems += [f"bare number in an evaluation-2 block: {x}" for x in bare]
    outside = tex
    for b in blocks:
        outside = outside.replace(b, "")
    if sites is not None:
        problems += [f"\\rv{{{p}}} used with a site manifest (sites.json): use \\site{{}}" for p in USE.findall(tex)]
        problems += [f"\\rv{{{p}}} used with a site manifest (sites.json): use \\site{{}}" for _, p in USEK.findall(tex)]
        return problems + _site_checks(tex, sites, raw, known, outside, tex_path)
    vals = _report_numbers(raw)
    for x in BARE.findall(EXEMPT.sub("", USEK.sub("", USE.sub("", outside)))):
        if re.fullmatch(r"-?\d*\.\d{3,}", x) and f"{float(x):.3f}" in vals:
            problems.append(f"number outside the evaluation-2 regions equals a report value (mark it, or wrap evaluation-1 values in \\evone): {x}")
    return problems


def _scan(tex: str):
    """Per line of comment-free text: (section key, inside a result region, text), and problems. Every \\section needs
    a \\label{sec:...} on its line or the next; sec: labels elsewhere are refused and do not change the section."""
   pods named ts-r-TAG the next day and relaunch only after that check. Spend record (launcher review r16): the account
   balance difference, `podctl.py spend ts-r-TAG`, at least one hour after the watchdog ends; it can only overstate the
   spend (other usage on the account is included), provided no deposit or credit was added in the window. The author
   confirms that on the Runpod billing page before the record enters the ledger (r17); a balance that rose is refused.
   The next launch with the same name is refused until the spend is recorded. The launcher's numbers are estimates.
5. On the Mac after retrieval: the diagnostics of all 18 D2 winners and their reverse switches (`--stage diagnostics`),
   checked against the pod's spot-check cell. The three headline cells (registered D2 records) run on the Mac before the
   pod (`--headline-diagnostics`, 200 seeds); with the 18 fresh cells this gives the 63 policies and 42 switch
   comparisons of section 4 plus the 21 reverse switches.
6. Analysis: a new `reset` block in `posthoc_v2.py` (tested first), a table, and a paragraph in section 9 with sites; the
   section-1 headline numbers enter at the same time, labelled exploratory.
7. Internal review of the paper change, then the next external package.

