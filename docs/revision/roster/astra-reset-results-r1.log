diff --git a/docs/revision/paper-v2/tables/posthoc_reset.tex b/docs/revision/paper-v2/tables/posthoc_reset.tex
new file mode 100644
index 0000000..5d91c3d
--- /dev/null
+++ b/docs/revision/paper-v2/tables/posthoc_reset.tex
@@ -0,0 +1,16 @@
+\begin{tabular}{lll}
+\hline
+Statistic & frozen searches & doubled searches \\
+\hline
+I(B3) & 0.228 [0.226, 0.229] & 0.221 [0.219, 0.222] \\
+I(R3) & 0.045 [0.044, 0.046] & 0.047 [0.046, 0.048] \\
