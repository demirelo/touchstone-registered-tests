   191	def _diag(eff0, eff1, resets_d2=0.0, mr=50.0):
   192	    cell = lambda e, key: {"mean_resets": mr if key == "switch_x0" else resets_d2, "p_any_reset": 1.0 if key == "switch_x0" else 0.0,
   193	                           "mean_ban_rounds": 3.0, key: {"effect": e, "per_seed": [e] * 4, **({"identical": False} if key == "switch_x0" else {})}}
   194	    return {f"{m}@rho0.2|{r}": {"d2h3_base": cell(eff0, "switch_x0"), "d2h3_doubled": cell(eff0 / 2, "switch_x0"), "d2_base": cell(eff1, "switch_x1")}
   195	            for m in M6 for r in RB.RULES}
