   100	def market(label: str, root: str, rho: float = 0.2, dev: bool = False, smoke: bool = False, cfg=None, commit: str | None = None,
   101	           salt_sha256: str | None = None) -> dict:
   102	    """`cfg`, `commit`, and `salt_sha256` come from recorded inputs when given (the verify stage), so no calibration
   103	    episode, git process, or salt read happens."""
   104	    cfg = cfg if cfg is not None else _market_cfg(label, root, float(rho))
