   387	def stage_reference(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
   388	    T, L = constants(job); cands, fams, upstream = menu(job, out, cuts, h4_excluded)
   389	    choice = select_reference(train_cell(job), cands, SeedCache())
   390	    idx = next(i for i, c in enumerate(cands) if c is choice.candidate)
   391	    return {"candidates": [cand_to_json(c, f, T, L) for c, f in zip(cands, fams)], "choice": idx, "scores": choice.scores,
   392	            "per_seed_normalized": [float(v) for v in choice.per_seed_normalized], "upstream": upstream, "T": T, "L": L,
   393	            "menu_families": list(MAN.menu_families(manifest_ctx(job["context"]), job["rule"]))}
