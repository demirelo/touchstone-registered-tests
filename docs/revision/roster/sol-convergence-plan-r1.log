   109	    out = {"label": label, "root": root, "rho": float(rho), "dev": bool(dev), "smoke": bool(smoke), "cfg": cfg, "focal": int(positions(cfg)["median"]),
   110	           "seeds_train": train, "seeds_val": val, "seeds_eval": list(ev), "context": MAN.context(label, float(rho))}
   111	    if commit is not None:
   112	        out["commit"] = str(commit)
   113	    if salt_sha256 is not None:
