    16	@dataclass(frozen=True)
    17	class Calibration:
    18	    S_hat: float
    19	    n_FB: float
    20	    m: float
    21	    market_key: str
    22	    T: int
    23	    seeds: tuple
    24	
    25	    def as_dict(self) -> dict:
    26	        d = asdict(self); d["seeds"] = list(self.seeds); return d
