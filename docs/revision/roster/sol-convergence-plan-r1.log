   254	def continue_search(objective, family: Family, st: SearchSettings, original, seed: int = 1):
   255	    """Doubling (design 6.5): as many new restarts as registered, with restart seeds after the registered ones, on the
   256	    merged archive (old entries kept), the previous best as an incumbent."""
   257	    objective.archive.update(original.archive)
   258	    return cma_search(objective, family, st, int(seed) + int(st.restarts), incumbents={"previous_best": dict(original.best_knobs)})
