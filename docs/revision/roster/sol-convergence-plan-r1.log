   154	            _refuse(f"the original freeze of {ctx} does not state cuts {CUTS} with H4 loaded")
   155	        rid = f"reference/{ctx}/{j['rule']}"
   156	        if rid not in fr["records"]:
   157	            _refuse(f"{rid} is not in the original freeze of {ctx}")
   158	        ref = read(R.path_of(src, rid))
   159	        if ref is None:
   160	            _refuse(f"{rid} is missing in {src}")
   161	        want = _expected_reference_upstream(rid)
   162	        if want is not None and set(ref.get("upstream") or {}) != want:
   163	            _refuse(f"{rid}: its dependencies are not the registered menu and cuts-{CUTS} bank")
   164	        need[rid] = fr["records"][rid]; todo = dict(ref["upstream"])
   165	        while todo:
   166	            u, s = todo.popitem()
   167	            if need.setdefault(u, s) != s:
   168	                _refuse(f"{u}: two original records hold different hashes")
   169	            if u not in fr["records"]:
   170	                _refuse(f"{u}: not in the original freeze of {ctx}")
   171	            if fr["records"][u] != s:
   172	                _refuse(f"{u}: its hash differs from the original freeze of {ctx}")
   173	            for k, v in ((read(R.path_of(src, u)) or {}).get("upstream") or {}).items():
   174	                if need.get(k, v) != v or todo.get(k, v) != v:
   175	                    _refuse(f"{k}: two original records hold different hashes")
   176	                if k not in need:
   177	                    todo[k] = v
   178	    return need
   179	
   180	
   181	def copy_inputs(src, out, need: dict[str, str]) -> None:
   182	    """Copy each input read-only, checked against its recorded hash; an existing identical copy is kept."""
   183	    for rid, sha in sorted(need.items()):
   184	        p, q = R.path_of(src, rid), R.path_of(out, rid)
   185	        if not p.exists():
   186	            _refuse(f"input {rid} is missing in {src}")
   187	        if sha_file(p) != sha:
   188	            _refuse(f"input {rid} differs from the hash in the original records")
   189	        if q.exists():
   190	            if sha_file(q) != sha:
   191	                _refuse(f"{q} exists and differs from the original {rid}")
   192	            continue
   193	        q.parent.mkdir(parents=True, exist_ok=True); shutil.copyfile(p, q); q.chmod(0o444)
   194	    prev = read(Path(out) / "inputs.json")
   195	    if prev is not None and prev != {**prev, **need}:
   196	        _refuse("inputs.json lists other hashes for the same records")
   197	    write(Path(out) / "inputs.json", {**(prev or {}), **need})
   198	
