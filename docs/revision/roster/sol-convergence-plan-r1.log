   103	def cma_search(objective, family: Family, settings: SearchSettings, seed: int,
   104	               incumbents: dict[str, dict] | None = None, starts: list | None = None) -> SearchResult:
   105	    """CMA-ES maximization with registered restarts and a fixed evaluation budget
   106	    per restart (incumbent re-evaluations count). Registered incumbents and the
   107	    projection of the best point are evaluated exactly, outside the budget."""
   108	    if starts is None:
   109	        starts = family.registered_starts({"near_corner": settings.near_corner, "sobol_seed": settings.sobol_seed})
   110	    best_x, best_knobs, best_f, best_source = None, None, -np.inf, ""
   111	    restart_bests, trace, evals = [], [], 0
   112	    for r in range(settings.restarts):
   113	        x0 = starts[r % len(starts)]
   114	        es = cma.CMAEvolutionStrategy(x0, settings.sigma0,
   115	                                      {"popsize": settings.popsize, "seed": int(seed) + 1 + r, "verbose": -9, "verb_log": 0})
   116	        used, it = 0, 0
   117	        r_best_x, r_best_f = x0.copy(), objective(x0)
   118	        used += 1; evals += 1
   119	        while used < settings.evals_per_restart:
   120	            X = es.ask()
   121	            n = min(len(X), settings.evals_per_restart - used)
   122	            X = X[:n]
   123	            F = [objective(np.asarray(x)) for x in X]
   124	            used += n; evals += n
   125	            if n == settings.popsize:
   126	                es.tell(X, [-f for f in F])
   127	            for x, f in zip(X, F):
   128	                if f > r_best_f:
   129	                    r_best_x, r_best_f = np.asarray(x).copy(), f
   130	            it += 1
   131	            if it % settings.reeval_every == 0 and used < settings.evals_per_restart:
   132	                f_re = objective(r_best_x)
   133	                used += 1; evals += 1
   134	                r_best_f = min(r_best_f, f_re)   # a deterministic objective returns the same value
   135	            trace.append((evals, r_best_f))
   136	        restart_bests.append(r_best_f)
   137	        if r_best_f > best_f:
   138	            best_x, best_knobs, best_f, best_source = r_best_x.copy(), objective.knobs_of(r_best_x), r_best_f, f"restart_{r}"
   139	    incumbent_scores: dict[str, float] = {}
   140	    for name, k in (incumbents or {}).items():
   141	        f = objective.eval_knobs(k, source=f"incumbent:{name}")
   142	        incumbent_scores[name] = float(f)
   143	        if f > best_f:
   144	            best_x, best_knobs, best_f, best_source = family.inverse(k, settings.near_corner), dict(k), float(f), f"incumbent:{name}"
   145	    proj = family.project(best_knobs)
   146	    projection_f = float(objective.eval_knobs(proj, source="projection"))
   147	    replaced = projection_f > best_f
   148	    if replaced:
   149	        best_x, best_knobs, best_f, best_source = family.inverse(proj, settings.near_corner), proj, projection_f, "projection"
   150	    return SearchResult(best_x=best_x, best_knobs=best_knobs, best_f=float(best_f), best_source=best_source,
   151	                        restart_bests=restart_bests, evals=evals, trace=trace, incumbent_scores=incumbent_scores,
   152	                        projection_f=projection_f, replaced_by_projection=replaced, archive=objective.archive, evaluations=list(getattr(objective, "log", [])))
