   124	def rule_spec(rule: str, params: dict | None) -> dict:
   125	    p = params or {}
   126	    if rule in FIXED:
   127	        spec = {"tol": 0.16, "L": 10}
   128	    elif rule == "B2":
   129	        b2 = registered_b2_params(); spec = {"tol": float(b2["tol"]), "L": int(b2["L"]), "b2": b2}
   130	    else:
   131	        t = (p.get("tuned") or {}).get(rule)
   132	        if t is None:
   133	            raise SystemExit(f"{rule}: no tuned parameters in --params")
   134	        spec = {"tol": float(t["tol"]), "L": int(t["L"])}
   135	    if rule.startswith("C*"):
   136	        if not p.get("cred"):
   137	            raise SystemExit(f"{rule}: no comparator (cred) in --params")
   138	        spec["cred"] = dict(p["cred"])
   139	    return spec
