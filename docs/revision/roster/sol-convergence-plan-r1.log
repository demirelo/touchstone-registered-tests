    14	
    15	from scripts import budget_v2 as BV  # noqa: E402
    16	
    17	OP = "followup"
    18	Refused = BV.Refused
    19	
    20	
    21	def approve(path, new_limit: float, cap: float, text: str) -> None:
    22	    new_limit = BV._amount(new_limit, "approval limit", positive=True); cap = BV._amount(cap, f"cap {OP}", positive=True)
    23	    if not str(text).strip():
    24	        raise Refused("an approval needs the author's written text")
    25	    if not Path(path).exists():
    26	        raise Refused(f"no ledger at {path}")
    27	    with BV._locked(path) as d:
    28	        if OP in d["caps"]:
    29	            raise Refused(f"the {OP} category already has a cap of {d['caps'][OP]} USD")
    30	        if new_limit + 1e-9 < BV._used(d) + cap:
    31	            raise Refused(f"the limit {new_limit} is below the spend and reservations ({BV._used(d):.3f}) plus the new cap {cap}")
    32	        if d.get("approval"):
    33	            d.setdefault("approval_history", []).append(d["approval"])
    34	        d["caps"][OP] = cap
    35	        d["approval"] = {"limit": new_limit, "text": str(text)}
    36	
    37	
    38	def reserve(path, tag: str, estimate: float) -> float:
    39	    with BV._locked(path) as d:
    40	        if OP not in d["caps"]:
    41	            raise Refused(f"no cap for {OP!r}: record the author's approval first (--approve LIMIT CAP TEXT)")
    42	    return BV.reserve(path, OP, tag, estimate)
    43	
    44	
    45	def main(argv=None) -> int:
    46	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    47	    ap.add_argument("--ledger", default=str(BV.DEFAULT))
    48	    g = ap.add_mutually_exclusive_group(required=True)
    49	    g.add_argument("--approve", nargs=3, metavar=("LIMIT", "CAP", "TEXT")); g.add_argument("--reserve", nargs=2, metavar=("TAG", "ESTIMATE"))
    50	    a = ap.parse_args(argv)
    51	    try:
    52	        if a.approve:
    53	            approve(a.ledger, float(a.approve[0]), float(a.approve[1]), a.approve[2])
    54	        else:
    55	            print(f"{reserve(a.ledger, a.reserve[0], float(a.reserve[1])):.2f}")
    56	    except Refused as e:
    57	        print(f"refused: {e}", file=sys.stderr)
    58	        return 1
