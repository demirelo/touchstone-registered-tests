    28	
    29	def first_best_served(cfg: MarketConfig, values_t: np.ndarray) -> int:
    30	    q_full = np.array([p.q_max for p in cfg.providers]); cost_full = cfg.cost_full
    31	    owner = np.repeat(np.arange(cfg.N), [p.k for p in cfg.providers])
    32	    w = np.maximum(values_t[None, :] * q_full[owner][:, None] - cost_full[owner][:, None], 0.0)
    33	    rows, cols = linear_sum_assignment(w, maximize=True)
    34	    return int((w[rows, cols] > 0).sum())
    35	
    36	
    37	def calibrate(cfg_base: MarketConfig, seeds) -> Calibration:
    38	    """S_hat and n_FB on the calibration seeds (spec 3). Refuses an invalid market or no seeds."""
    39	    cfg_base.validate()
    40	    seeds = [int(s) for s in seeds]
    41	    if not seeds:
    42	        raise ValueError("calibration needs at least one seed")
    43	    totals, served = [], []
    44	    for s in seeds:
    45	        d = make_draws(cfg_base, s)
    46	        totals.append(first_best_episode(cfg_base, d))
    47	        served.append(sum(first_best_served(cfg_base, d.values[t]) for t in range(cfg_base.T)))
    48	    S_hat = float(np.mean(totals)); n_FB = float(np.mean(served))
    49	    if n_FB <= 0:
    50	        raise ValueError("no job has positive first-best surplus: calibration is undefined for this market")
    51	    return Calibration(S_hat=S_hat, n_FB=n_FB, m=S_hat / n_FB, market_key=market_key(cfg_base), T=int(cfg_base.T), seeds=tuple(seeds))
