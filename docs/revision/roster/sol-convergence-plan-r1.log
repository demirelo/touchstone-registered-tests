    58	    cfg = MarketConfig(N=cfg_base.N, J=cfg_base.J, T=cfg_base.T, sigma=cfg_base.sigma, e=cfg_base.e, v_min=cfg_base.v_min,
    59	                       v_max=cfg_base.v_max, providers=cfg_base.providers, alpha=float(rho) * cal.m, budget=float(beta) * cal.S_hat)
    60	    cfg.validate()
