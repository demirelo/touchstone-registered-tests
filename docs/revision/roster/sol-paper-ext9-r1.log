"""Exploratory analyses on the second test's evaluation records, after the report (external review round 4, 2026-11-05).
None of them is registered; none changes a registered estimate or decision. Gains follow the records' definition,
g = (attacked profit - truthful reference profit) / (S*/N) with N = 10 (checked against the stored gain).

1. Q1 split: the pooled d = g_C* - g_F111 as an attacked-profit term plus a reference-profit term, equal market weights.
2. Welfare mixtures: an episode-level lottery between the selected W0 attack and a profitable attack of the same rule at
   the headline market (same frozen reference), with the largest W0 weight whose mean gain keeps a nonnegative one-sided
   95 percent lower bound on the evaluation seeds. This checks whether the W1 policy class is closed under randomisation;
   the weight is chosen on the evaluation seeds, so it is not an out-of-sample estimate.
3. Q4 diagnostics per fresh market: the B3 - R3 gain difference split into its two terms, and R3's audit spending and
   served share under the selected attack.
4. Stability: the registered-configuration re-evaluation (deviation/stability-result.json) beside the report.

Usage: posthoc_v2.py --records EVAL/all --report report.json --stability stability-result.json --out posthoc.json --tables DIR
"""
import argparse
import json
import sys
from pathlib import Path

import numpy as np

FRESH = tuple(f"fresh{i}" for i in range(6))
N = 10
Z = 1.645
PROFIT_FAMS = ("D2+H3", "X7-SC", "X5-AG/v2", "H4", "D2")


def safe(rid: str) -> str:
    return rid.replace("|", "__").replace("/", "~").replace("*", "star")      # revision_v2._safe


def _rec(out, rid):
    p = Path(out) / "evaluate" / (safe(rid) + ".json")
    return json.loads(p.read_text()) if p.exists() else None


def _terms(r):
    s = np.asarray(r["sstar"], dtype=float) / N
    return np.asarray(r["profit_attack"], dtype=float) / s, np.asarray(r["profit_ref"], dtype=float) / s


def split(out, markets, a: str, b: str, fam: str, n: int = N) -> dict:
    """d = g_a - g_b per market and pooled with equal market weights, as attacked term + reference term."""
    rows = {}
    for m in markets:
        ra, rb = _rec(out, f"{m}@rho0.2|{a}|{fam}|profit"), _rec(out, f"{m}@rho0.2|{b}|{fam}|profit")
        if ra is None or rb is None:
            continue
        (pa, ta), (pb, tb) = _terms(ra), _terms(rb)
        att, ref = pa - pb, -(ta - tb)
        rows[m] = {"estimate": float(np.mean(att + ref)), "attacked": float(np.mean(att)), "reference": float(np.mean(ref))}
    pooled = {k: float(np.mean([v[k] for v in rows.values()])) for k in ("estimate", "attacked", "reference")} if rows else {}
    return {"markets": rows, "pooled": pooled}


def mixture(gw0, ew0, gp, ep, grid: int = 2001) -> dict:
    """The largest W0 weight w with mean(w gw0 + (1-w) gp) - Z se >= 0, and the mixture's mean gain and efficiency."""
    gw0, ew0, gp, ep = (np.asarray(x, dtype=float) for x in (gw0, ew0, gp, ep))
    best = 0.0
    for w in np.linspace(0.0, 1.0, grid):
        g = w * gw0 + (1 - w) * gp
        if g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g)) >= 0:
            best = float(w)
    if best == 0.0 and not ((gp.mean() - Z * gp.std(ddof=1) / np.sqrt(len(gp))) >= 0):
        return {"weight": 0.0, "estimate": float(gp.mean()), "efficiency": float(ep.mean())}
    g, e = best * gw0 + (1 - best) * gp, best * ew0 + (1 - best) * ep
    return {"weight": best, "estimate": float(g.mean()), "lower": float(g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g))),
            "efficiency": float(e.mean())}


def feasible_mixture(gw0, ew0, gp, ep, g0_train: float, gp_train: float, grid: int = 2001) -> dict:
    """The largest W0 weight on the grid at which both empirical checks hold: the evaluation lower bound and the training
    mean gain (W1's registered constraint) are non-negative (external review round 6)."""
    gw0, ew0, gp, ep = (np.asarray(x, dtype=float) for x in (gw0, ew0, gp, ep))
    best = None
    for w in np.linspace(0.0, 1.0, grid):
        g = w * gw0 + (1 - w) * gp
        if g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g)) >= 0 and train_mix(g0_train, gp_train, w) >= 0:
            best = float(w)
    if best is None:
        return {"weight": None}
    g, e = best * gw0 + (1 - best) * gp, best * ew0 + (1 - best) * ep
    return {"weight": best, "estimate": float(g.mean()), "lower": float(g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g))),
            "efficiency": float(e.mean()), "train_mix": train_mix(g0_train, gp_train, best)}


def test_welfare_table_adds_the_training_feasible_row_beside_the_failed_one():
    fm = {"weight": 0.4765, "estimate": 0.00093096, "lower": 0.00069945, "efficiency": 0.922401, "train_mix": 0.00004745}
    mx = {"weight": 0.48, "estimate": 0.00029715, "lower": 0.0000668, "efficiency": 0.921852, "train_mix": -0.00057978,
          "train_feasible_mixture": fm}
    res = {"q1_split": {}, "q4_diag": {}, "stability": {"q1": {}},
           "welfare": {"C*": {"w1": {"efficiency": 0.997}, "w0": {"efficiency": 0.840}, "mixtures": {"D2+H3": mx}}}}
    t = P.tables(res)["welfare_mix"]
    assert "D2+H3 & 0.4800" in t and "D2+H3, training-feasible & 0.4765" in t       # the failed row stays
    assert "0.0000475" in t and "0.000931" in t and "0.9224" in t


def _report_doubling(cells):
    return {"doubling": {rid: {"heldout": {"gain": g, "seeds": [1, 2]}} for rid, g in cells.items()}}


def test_doubled_winners_pair_the_heldout_gains_against_the_frozen_search(tmp_path):
    # external review round 9: the doubled-search winners, evaluated on the same seeds, beside the frozen searches
    for rule, g in (("C*", [0.10, 0.12]), ("F111", [0.14, 0.16]), ("F000", [0.40, 0.42])):
        _rec(tmp_path, f"m0@rho0.2|{rule}|D2+H3|profit", gain=g, seeds=[1, 2])
    rep = _report_doubling({"m0@rho0.2|C*|D2+H3|profit": [0.20, 0.22], "m0@rho0.2|F111|D2+H3|profit": [0.14, 0.16],
                            "m0@rho0.2|F000|D2+H3|profit": [0.40, 0.42]})
    got = P.doubled(tmp_path, rep, ["m0"], fams=("D2+H3",))
    row = got["D2+H3"]["markets"]["m0"]
    assert row["q1_frozen"] == pytest.approx(-0.04) and row["q1_doubled"] == pytest.approx(0.06)       # C* - F111 changes sign
    assert row["q4_frozen"] == pytest.approx(0.26) and row["q4_doubled"] == pytest.approx(0.26)         # F000 - F111
    assert got["D2+H3"]["pooled"]["q1_doubled"] == pytest.approx(0.06)
    assert got["D2+H3"]["absolute"] == {"C*": {"mean_gain": pytest.approx(0.11)}, "F111": {"mean_gain": pytest.approx(0.15)}}


def test_doubled_refuses_a_heldout_evaluation_on_other_seeds(tmp_path):
    for rule in ("C*", "F111", "F000"):
        _rec(tmp_path, f"m0@rho0.2|{rule}|D2+H3|profit", gain=[0.1, 0.1], seeds=[1, 2])
    rep = _report_doubling({f"m0@rho0.2|{r}|D2+H3|profit": [0.1, 0.1] for r in ("C*", "F111", "F000")})
    rep["doubling"]["m0@rho0.2|C*|D2+H3|profit"]["heldout"]["seeds"] = [3, 4]
    with pytest.raises(ValueError):
        P.doubled(tmp_path, rep, ["m0"], fams=("D2+H3",))


def test_honest_profile_keeps_unrounded_values_and_the_r3_minus_cstar_difference():
    bins = lambda a, p: [{"age": [0, 10], "audited_share": a, "profit_per_round": p, "false_refund": 1e-5},
                         {"age": [10, 20], "audited_share": a / 2, "profit_per_round": p, "false_refund": 1e-5}]
    rep = {"q3": {"diagnostic": {"F111": {"replace_at": 50, "bins": bins(1.0, 0.000280)},
                                 "C*": {"replace_at": 50, "bins": bins(0.4, 0.000286)},
                                 "F000": {"replace_at": 50, "bins": bins(0.25, 0.000287)}}}}
    got = P.honest(rep)
    assert got["F111"]["bins"][0]["audited_share"] == 1.0 and got["F111"]["mean_profit_per_round"] == pytest.approx(0.000280)
    assert got["r3_minus_cstar_profit_per_round"] == pytest.approx(-0.000006)


def test_tables_show_doubled_winners_and_the_honest_profile():
    res = {"q1_split": {}, "welfare": {}, "q4_diag": {}, "stability": {"q1": {}},
           "doubled": {"D2+H3": {"markets": {"fresh3": {"q1_frozen": -0.0382, "q1_doubled": 0.0149, "q4_frozen": 0.2626, "q4_doubled": 0.2600}}},
                       "X7-SC": {"markets": {"fresh3": {"q1_frozen": 0.01, "q1_doubled": 0.01}}}},
           "honest": {r: {"bins": [{"age": [0, 10], "audited_share": a, "profit_per_round": 0.00028, "false_refund": 2e-5}] * 3,
                          "mean_profit_per_round": 0.00028, "mean_false_refund": 2e-5} for r, a in (("F000", 0.25), ("F111", 1.0), ("C*", 0.428))}}
    t = P.tables(res)
    assert "fresh3 & $-0.038$ & $0.015$ & $0.010$ & $0.010$ & $0.263$ & $0.260$" in t["doubled"]
    assert "C* & 0.428" in t["honest"] and "R3 (F111) & 1.000" in t["honest"] and "2.80" in t["honest"] and "2.00" in t["honest"]
\paragraph{Deviations from the protocol.} Two arose during the evaluation. First, the runner recalibrates each fresh market where it runs, and the evaluation ran on Linux x86 machines, while the registered instance file holds the calibration computed on the author's arm64 machine. In each fresh market, between \const{1} and \const{6} provider parameters differ between the two in the last binary digit (one unit in the last place, a relative difference near $10^{\const{-16}}$); the headline market is unaffected. The runner's verification compares configuration hashes exactly and refuses these records. We kept them: a container on the evaluation platform reproduces each run's configuration hash, every differing value is within one unit in the last place of the registered one, and verification passes on every other check when given the reproduced configuration. The check is a script in the artifact. It establishes that the configurations match, not that the decisions are unchanged, since small input differences can change discrete simulation branches; the re-evaluation below holds the selected attacks and references fixed and does not repeat search or reference selection under the registered configurations. We therefore re-evaluated the frozen policies of every fresh-market cell that Q1 and Q4 use on the registration platform with the registered configurations, against the frozen references: per-seed gains change in every cell, cell means move by less than one hundredth, and every Q1 and Q4 decision is unchanged (\texttt{docs/revision/deviation/stability.py}; Table~\ref{tab:ph-stability}). The report's addendum lists the hashes, states the interval labels, and traces search-flag dependencies through each cell's references, which qualifies three further decisions as about the prescribed search procedure. Second, the fresh-market runs cost about ten percent more than estimated, and the author raised the evaluation cap from \const{40} to \const{43} USD and the written authorisation from \const{52} to \const{55} USD so that every registered cell could run; no analysis changed.

\section{The second test: results}\label{sec:results}
% BEGIN-EV2
The registered estimates and decisions below come from the report that the tagged code wrote; the addendum beside it (Section~\ref{sec:design}) adds labels and disclosures. Tables~\ref{tab:ph-q1}, \ref{tab:ph-doubled}, \ref{tab:ph-honest}, \ref{tab:ph-q4}, \ref{tab:ph-welfare}, and~\ref{tab:ph-welfare-sens} report exploratory analyses of existing records, and Tables~\ref{tab:ph-stability} and~\ref{tab:ph-q4-stability} the separate registered-configuration stability check; none of these changes a registered estimate or decision. Gains are normalised attacker gains; intervals are those of Table~\ref{tab:rules-v2}. Some descriptive fixed-reference contrasts on fresh1 (\site{r_ext_n} interval entries in the report's per-market Q2 rows) have numerically extreme studentized intervals: the reference-profit contrast there is above rounding scale on only \site{r_ext_seeds} of \site{r_ext_total} seeds (the others are at most \site{r_ext_round} in absolute value), and \site{r_ext_cnt} of the \site{r_ext_tot} frozen resamples (\site{r_ext_share}) omit all three, so their standard error is of rounding size and their bootstrap-t statistics are huge. We retain these frozen outputs, list them in the audit file, and draw no inferential conclusion from them; no other interval in the report has a bound beyond $\const{1000}$ in absolute value.

\paragraph{Age-ranked versus history-based checking (Q1).} Pooled over the six fresh markets, the prescribed searches leave the identity-replacement attacker a measured gain against C$^*$ higher than against R3 by \site{r_q1_d_est} under D2+H3 and by \site{r_q1_x_est} under X7-SC; the mean gains are \site{r_abs_cs} against C$^*$ and \site{r_abs_r3} against R3 under D2+H3, and \site{r_abs_cs_x} and \site{r_abs_r3_x} under X7-SC. Both direction tests reject $d = \const{0}$ (calibrated input $p' = $ \site{r_q1_d_p}; Holm-adjusted $p = $ \site{r_q1_holm} for each). Both intervals lie inside the registered margin of $\pm\const{0.05}$: the categories are ``\site{r_q1_d_cat}'' (D2+H3) and ``\site{r_q1_x_cat}'' (X7-SC), and the separate efficiency label is ``\site{r_q1_d_eff}''. Under the registered margin, R3 is not materially better than the development-selected comparator; the margin of $\pm\const{0.05}$ is half the first test's comparative margin, not an estimated threshold of buyer indifference, and a narrower margin could order the two rules. The difference changes sign across markets: per market (descriptive), it ranges from \site{r_q1_f3_d} on fresh3 to \site{r_q1_f1_d} on fresh1 under D2+H3. Search uncertainty matters at this level: evaluating the doubled-search winners on the same seeds against the same frozen references (Table~\ref{tab:ph-doubled}, exploratory) changes fresh3's difference from \site{r_dbl_f3} to \site{r_dbl_f3_d}, and the pooled differences to \site{r_dbl_pool_d} under D2+H3 and \site{r_dbl_pool_x} under X7-SC; no decision is recomputed. The two rules differ more in whom they burden than in the attacker's gain. In the registered descriptive honest-replacement diagnostic at the headline market (Table~\ref{tab:ph-honest}), an honest provider replaces its identity at round \const{50}: R3 audits \site{r_hon_r3_0} and \site{r_hon_r3_1} of the replacement's served jobs in its first two ten-round age bins, C$^*$ audits \site{r_hon_cs_0} and \site{r_hon_cs_1}, and B3 about \site{r_hon_b3_0}. Under R3 the replacement earns slightly less per round and receives more refunds on false audit failures, and the operator pays for the extra audits. Both decisions are about the prescribed search procedure: the D2+H3 test uses search-flagged cells, and the X7-SC test uses them through its references (addendum); their nominal error guarantees are not established on the fresh, selected-rule distributions (Section~\ref{sec:design}). The paired descriptive differences in Table~\ref{tab:q1-side} are small for efficiency, audit spending, refunds on false audit failures, and the market service fraction; the reference-profit column is in raw profit units. Splitting $d$ with the same normalisation into the attacked-profit term and the reference-profit term (Table~\ref{tab:ph-q1}, exploratory) shows that almost all of it is attacked profit: the attacker earns more under C$^*$ when it deviates, not when it is truthful.
