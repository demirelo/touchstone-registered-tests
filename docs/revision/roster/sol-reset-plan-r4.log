   144	def copy_inputs(src, out, need: dict[str, str]) -> None:
   145	    """Copy each input read-only, checked against its recorded hash; an existing identical copy is kept."""
   146	    for rid, sha in sorted(need.items()):
   147	        p, q = R.path_of(src, rid), R.path_of(out, rid)
   148	        if not p.exists():
   149	            _refuse(f"input {rid} is missing in {src}")
   150	        if sha_file(p) != sha:
   151	            _refuse(f"input {rid} differs from the hash in the original records")
   152	        if q.exists():
   153	            if sha_file(q) != sha:
   154	                _refuse(f"{q} exists and differs from the original {rid}")
   155	            continue
   156	        q.parent.mkdir(parents=True, exist_ok=True); shutil.copyfile(p, q); q.chmod(0o444)
   157	    prev = read(Path(out) / "inputs.json")
   158	    if prev is not None and prev != {**prev, **need}:
   159	        _refuse("inputs.json lists other hashes for the same records")
   160	    write(Path(out) / "inputs.json", {**(prev or {}), **need})
