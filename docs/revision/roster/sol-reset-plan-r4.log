   192	def accept(out, jobs: list[dict], salt_sha256: str, container: dict, src=None) -> None:
   193	    """Run before evaluation and before doubling: the freeze exists and every record in it, and every copied input,
   194	    still has its hash; the identity salt and the configurations are the recorded ones; with `src`, inputs.json holds
   195	    every input recomputed from the original records."""
   196	    check_salt(out, salt_sha256, jobs)
   197	    check_configs(jobs, container)
   198	    if src is not None:
   199	        have = read(Path(out) / "inputs.json") or {}
   200	        if bad := sorted(r for r, s in inputs(src, jobs).items() if have.get(r) != s):
   201	            _refuse(f"inputs.json lacks or differs on {bad[:3]}")
   202	    for ctx in sorted({j["context"] for j in jobs}):
   203	        fr = read(R.path_of(out, f"freeze/{ctx}"))
   204	        if fr is None or not fr.get("followup"):
   205	            _refuse(f"{ctx}: no follow-up freeze")
   206	        want = {**_ctx_inputs(out, ctx), **{j["id"]: None for j in jobs if j["context"] == ctx}}
   207	        if missing := sorted(set(want) - set(fr["records"])):
   208	            _refuse(f"{ctx}: the freeze lacks {missing}")
   209	        for r, sha in fr["records"].items():
   210	            p = R.path_of(out, r)
   211	            if not p.exists() or sha_file(p) != sha or (want.get(r) not in (None, sha)):
   212	                _refuse(f"{ctx}: {r} differs from the freeze")
