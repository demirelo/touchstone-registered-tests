   219	def inventory(out) -> dict:
   220	    """Every output file with its hash, written after the outputs, so no record lists itself."""
   221	    out = Path(out)
   222	    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
   223	            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
   224	    import platform
   225	    import numpy
   226	    env = {"python": platform.python_version(), "numpy": numpy.__version__, "machine": platform.machine(), "platform": platform.platform(),
   227	           "processor": platform.processor(), "driver_sha256": sha_file(Path(__file__))}
   228	    inv = {"stage": "inventory", "deviations": list(DEVIATIONS), "environment": env, "records": recs}
   229	    write(out / "inventory.json", inv)
   230	    return inv
