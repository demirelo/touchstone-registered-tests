   236	KNOB_TOL, GAIN_TOL = 1e-9, 1e-9                      # plan draft 5, section 3 (a)
   237	
   238	
   239	def compare(src, out, rid: str = REPRO) -> dict:
   240	    """Validation (a), plan draft 5: exact on the episode count, archive size, `best_source`, discrete knobs, budget,
   241	    configuration hash, dependency set and seeds; continuous knobs within KNOB_TOL relative and per-seed gains within
   242	    GAIN_TOL absolute. `identical` reports bit identity separately."""
   243	    a, b = read(R.path_of(src, rid)), read(R.path_of(out, rid)); ea, eb = read(R.eval_path(src, rid)), read(R.eval_path(out, rid))
   244	    if None in (a, b, ea, eb):
   245	        return {"pass": False, "identical": False, "problems": ["a record is missing"]}
   246	    problems = []
   247	    ka, kb = a["attack"]["best_knobs"], b["attack"]["best_knobs"]
   248	    if set(ka) != set(kb):
   249	        problems.append("knob names differ")
   250	    disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   251	    if any(ka[k] != kb.get(k) for k in disc):
   252	        problems.append("discrete knob differs")
   253	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   254	    if rel > KNOB_TOL:
   255	        problems.append(f"knob tolerance exceeded ({rel:.3g})")
   256	    for what, x, y in (("episode count", a.get("runs"), b.get("runs")), ("best_source", a["attack"].get("best_source"), b["attack"].get("best_source")),
   257	                       ("archive size", len(a["attack"].get("archive", [])), len(b["attack"].get("archive", []))),
   258	                       ("budget", a["provenance"].get("budget"), b["provenance"].get("budget")),
   259	                       ("configuration hash", a["provenance"].get("cfg_sha256"), b["provenance"].get("cfg_sha256")),
   260	                       ("dependency set", sorted(a.get("upstream") or {}), sorted(b.get("upstream") or {})), ("seeds", ea["seeds"], eb["seeds"])):
   261	        if x != y:
   262	            problems.append(f"{what} differs")
   263	    gd = max((abs(x - y) for x, y in zip(ea["gain"], eb["gain"])), default=0.0) if len(ea["gain"]) == len(eb["gain"]) else float("inf")
   264	    if gd > GAIN_TOL:
   265	        problems.append(f"gain tolerance exceeded ({gd:.3g})")
   266	    return {"pass": not problems, "identical": ka == kb and ea["gain"] == eb["gain"], "max_knob_rel": rel, "max_gain_abs": gd, "problems": problems}
