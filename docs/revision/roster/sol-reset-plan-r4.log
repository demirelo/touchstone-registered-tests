   284	def main(argv=None) -> int:
   285	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   286	    ap.add_argument("--src", default=str(EVAL_ALL)); ap.add_argument("--out", required=True)
   287	    ap.add_argument("--draw", default=str(ROOT / "results/v2/draw/draw.json")); ap.add_argument("--instances", default=str(ROOT / "results/v2/draw/instances.json"))
   288	    ap.add_argument("--cfgs", default=str(ROOT / "results/v2/deviation/cfg_linux.json")); ap.add_argument("--addendum", default=str(ROOT / "results/v2/report/addendum.json"))
   289	    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   290	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "inventory", "all"))
   291	    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--smoke", action="store_true")
   292	    ap.add_argument("--reproduce", action="store_true", help=f"validation (a): rerun {REPRO} and compare exactly")
   293	    a = ap.parse_args(argv); out = Path(a.out); check_out(out, a.src)
   294	    from sim.records import cfg_from_dict
   295	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   296	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   297	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   298	    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   299	    if a.reproduce:
   300	        rep = reproduce(a.src, out, root, json.loads(Path(a.params).read_text()), salt_sha, a.workers)
   301	        print(json.dumps({"reproduce": REPRO, **rep}))
   302	        return 0 if rep["pass"] else 1
   303	    jobs = build_jobs(root, cfgs, json.loads(Path(a.params).read_text()), salt_sha, tuple(a.markets.split(",")), a.smoke)
   304	    check_configs(jobs, container); check_salt(out, salt_sha, jobs); check_commit(jobs); check_code()
   305	    if not a.smoke:
   306	        check_pairing(a.src, jobs)
   307	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "inventory") if a.stage == "all" else (a.stage,)
   308	    for st in steps:
   309	        if st == "inputs":
   310	            copy_inputs(a.src, out, inputs(a.src, jobs))
   311	        elif st == "search":
   312	            run_stage("search", jobs, out, a.workers)
   313	        elif st == "freeze":
   314	            prefreeze(out, jobs)
   315	        elif st in ("evaluate", "doubling"):
   316	            accept(out, jobs, salt_sha, container, src=a.src); run_stage(st, jobs, out, a.workers)
   317	        else:
   318	            inventory(out)
   319	        print(json.dumps({"stage": st, "jobs": len(jobs)}), flush=True)
   320	    return 0
