   111	def inputs(src, jobs: list[dict]) -> dict[str, str]:
   112	    """Every record the frozen evaluation and doubling stages read for `jobs`, with the hash the original records hold:
   113	    the reference from the context's original freeze, its menu and bank records from the reference's `upstream`, and
   114	    (recursively) the `upstream` of each copied search record."""
   115	    need: dict[str, str] = {}
   116	    for j in jobs:
   117	        ctx = j["context"]; fr = read(R.path_of(src, f"freeze/{ctx}"))
   118	        if fr is None:
   119	            _refuse(f"the original freeze of {ctx} is missing")
   120	        if fr.get("cuts", CUTS) != CUTS or fr.get("h4_excluded", H4_EXCLUDED) != H4_EXCLUDED:
   121	            _refuse(f"the original freeze of {ctx} is not cuts {CUTS} with H4 loaded")
   122	        rid = f"reference/{ctx}/{j['rule']}"
   123	        if rid not in fr["records"]:
   124	            _refuse(f"{rid} is not in the original freeze of {ctx}")
   125	        ref = read(R.path_of(src, rid))
   126	        if ref is None:
   127	            _refuse(f"{rid} is missing in {src}")
   128	        want = _expected_reference_upstream(rid)
   129	        if want is not None and set(ref.get("upstream") or {}) != want:
   130	            _refuse(f"{rid}: its dependencies are not the registered menu and cuts-{CUTS} bank")
   131	        need[rid] = fr["records"][rid]; todo = dict(ref["upstream"])
   132	        while todo:
   133	            u, s = todo.popitem()
   134	            if need.setdefault(u, s) != s:
   135	                _refuse(f"{u}: two original records hold different hashes")
   136	            for k, v in ((read(R.path_of(src, u)) or {}).get("upstream") or {}).items():
   137	                if need.get(k, v) != v or todo.get(k, v) != v:
   138	                    _refuse(f"{k}: two original records hold different hashes")
   139	                if k not in need:
   140	                    todo[k] = v
   141	    return need
