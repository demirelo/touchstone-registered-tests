   269	def reproduce(src, out, root: str, params: dict, salt_sha256: str, workers: int = 1) -> dict:
   270	    """Rerun the registered headline F111 D2 search and evaluation through this script's path (input copies, freeze,
   271	    acceptance) and compare with the registered records."""
   272	    mkt = R.market("headline", root, 0.2, salt_sha256=salt_sha256)
   273	    j = R.job(mkt, "F111", "D2", "profit", params=params)
   274	    reg = read(R.path_of(src, REPRO))
   275	    if reg is None or reg["provenance"]["cfg_sha256"] != j["provenance"]["cfg_sha256"]:
   276	        _refuse("the headline configuration on this machine is not the registered one")
   277	    copy_inputs(src, out, inputs(src, [j]))
   278	    run_stage("search", [j], out, workers); prefreeze(out, [j])
   279	    accept(out, [j], salt_sha256, {"headline": {"container_hash": reg["provenance"]["cfg_sha256"]}})
   280	    run_stage("evaluate", [j], out, workers)
   281	    return compare(src, out)
