   175	def prefreeze(out, jobs: list[dict]) -> None:
   176	    """The pre-evaluation freeze of each context: its copied inputs and its new search records, with their hashes."""
   177	    for ctx in sorted({j["context"] for j in jobs}):
   178	        recs = dict(_ctx_inputs(out, ctx))
   179	        for j in (j for j in jobs if j["context"] == ctx):
   180	            p = R.path_of(out, j["id"]); rec = read(p)
   181	            if rec is None or rec.get("stage") != "search" or rec.get("provenance") != j["provenance"]:
   182	                _refuse(f"{j['id']}: no current search record to freeze")
   183	            recs[j["id"]] = sha_file(p)
   184	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED, "records": recs}
   185	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   186	        if old is not None and old != body:
   187	            _refuse(f"{p} exists with other records")
   188	        if old is None:
   189	            write(p, body)
