    16	def test_the_18_cells_are_exactly_the_cut_d2_cells():
    17	    cs = F.restored_cells()
    18	    assert len(cs) == 18 and {c["family"] for c in cs} == {"D2"} and {c["rule"] for c in cs} == {"F000", "F111", "C*"}
    19	    assert {c["market"] for c in cs} == {f"fresh{i}" for i in range(6)} and {c["rho"] for c in cs} == {0.2}
    20	    from sim import manifest_v2 as MAN
    21	    kept = {c["id"] for c in MAN.effective(F.CUTS, F.H4_EXCLUDED)}
    22	    assert not kept & {c["id"] for c in cs}                                   # every one was removed by cut 3
