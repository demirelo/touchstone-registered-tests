    25	def test_an_output_inside_eval_all_is_refused(tmp_path, monkeypatch):
    26	    monkeypatch.setattr(F, "EVAL_ALL", tmp_path / "eval" / "all")
    27	    for bad in (tmp_path / "eval" / "all", tmp_path / "eval" / "all" / "followup"):
