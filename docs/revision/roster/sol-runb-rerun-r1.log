    93	def reserve(path, op: str, tag: str, estimate: float, decision_h4=DECISION_H4) -> float:
    94	    estimate = _amount(estimate, "estimate", positive=True)
    95	    with _locked(path) as d:
    96	        _gate(d, op, decision_h4)
    97	        if any(r["tag"] == tag for r in d["reservations"] + d["spent"]):
    98	            raise Refused(f"tag {tag!r} is already in the ledger")
    99	        grant = min(float(estimate) * HEADROOM, float(d["caps"][op]) - _used(d, op))
   100	        if grant < float(estimate):
   101	            raise Refused(f"{op}: {grant:.2f} USD left under the cap, below the estimate {float(estimate):.2f}")
   102	        if _used(d) + grant > limit(d) + 1e-9:
   103	            raise Refused(f"the combined spend and reservations would reach {_used(d) + grant:.2f} USD, above the approved {limit(d):.2f}")
   104	        d["reservations"].append({"op": op, "tag": tag, "cap": round(grant, 6)})
   105	        return grant
