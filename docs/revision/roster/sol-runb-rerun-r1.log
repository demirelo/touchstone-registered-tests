   339	def main(argv=None) -> int:
   340	    argv = list(sys.argv[1:] if argv is None else argv)
   341	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   342	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True); ap.add_argument("--report", required=True)
   343	    ap.add_argument("--posthoc", default=str(HERE.parent / "posthoc" / "posthoc.json"), help="its `nesting` block adds X7-SC cells")
   344	    ap.add_argument("--draw", required=True); ap.add_argument("--instances", required=True); ap.add_argument("--cfgs", required=True); ap.add_argument("--addendum", required=True)
   345	    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--cells", default=None, help="comma list; default the whole run")
   346	    ap.add_argument("--max-rounds", dest="max_rounds", type=int, default=MAX_ROUNDS); ap.add_argument("--workers", type=int, default=1)
   347	    ap.add_argument("--smoke", action="store_true"); ap.add_argument("--gate", action="store_true", help="round 1 only, compared with the registered doubling")
   348	    ap.add_argument("--site", choices=("mac", "pod"), default="pod", help="where this runs; a pod run is paid and needs --started-at")
   349	    ap.add_argument("--evidence", action="append", default=[], help="gate records (Mac and pod) for the gate cells (full runs)")
   350	    ap.add_argument("--cap-usd", dest="cap", type=float, default=4.25); ap.add_argument("--usd-per-hour", dest="rate", type=float, default=0.56)
   351	    ap.add_argument("--started-at", dest="started", type=float, default=None)
   352	    ap.add_argument("--attempts", default=None, help="the launcher's attempts file (closed attempts count toward the cap); required for a paid run")
   353	    ap.add_argument("--ledger", default=str(ROOT / "docs/revision/budget-ledger.json"), help="recorded spend of earlier launches")
   354	    ap.add_argument("--run-tag", dest="run_tag", default=None, help="ledger tag prefix of this run's launches (e.g. convergence); required for a paid run")
   355	    ap.add_argument("--stop-file", dest="stop_file", default=None, help="the launcher's STOP file, checked before each stage or round")
   356	    ap.add_argument("--soft-deadline", dest="soft", type=float, default=None, help="the launcher's soft deadline (epoch seconds)")
   357	    a = ap.parse_args(argv)
   358	    G.pin_settings(); out = Path(a.out); F.check_out(out, a.src)
   359	    if not 1 <= a.max_rounds <= MAX_ROUNDS:
   360	        _refuse(f"--max-rounds must be 1 to {MAX_ROUNDS}")
   361	    from sim.records import cfg_from_dict
   362	    report = json.loads(Path(a.report).read_text()); nesting = json.loads(Path(a.posthoc).read_text())["nesting"]
   363	    root = json.loads(Path(a.draw).read_text())["hash"]; salt = json.loads(Path(a.instances).read_text())["salt_sha256"]
   364	    params = json.loads(Path(a.params).read_text()); cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   365	    plan = cells_for(report, nesting); check_rounds(a.max_rounds, a.gate, plan["nesting"])
   366	    cells = a.cells.split(",") if a.cells else plan["cells"]
   367	    if bad := [c for c in cells if c not in plan["cells"]]:
   368	        _refuse(f"not cells of this run: {bad}")
   369	    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   370	    jobs = [job_for(c, root, cfgs, params, salt, a.smoke) for c in cells]
   371	    container = dict(json.loads(Path(a.addendum).read_text())["deviations"]["configs"])
   372	    for j in jobs:                                               # headline: the registered record's configuration hash
   373	        if j["mkt"]["label"] == "headline":
   374	            container["headline"] = {"container_hash": read(R.path_of(a.src, j["id"]))["provenance"]["cfg_sha256"]}
   375	    F.check_salt(out, salt, jobs); F.check_commit(jobs); F.check_code(); F.check_configs(jobs, container)
   376	    if not a.smoke:
   377	        F.check_pairing(a.src, jobs)
   378	        for j in jobs:
   379	            G.check_budget(j, R.path_of(a.src, j["id"]))
   380	    needs = {j["id"]: cell_inputs(a.src, j) for j in jobs}
   381	    F.copy_inputs(a.src, out, merge_inputs(list(needs.values())))     # one call: the helper refuses added keys
   382	    drv = sha_file(Path(__file__))
   383	    emb = lambda j: (report["doubling"].get(R.cell_id(j["context"], j["rule"], "D2+H3", "profit")) or {}).get("heldout", {}).get("knobs") if j["id"] in plan["nesting"] else None
   384	    dbl_rec = lambda j: Path(a.src) / "doubling" / (R._safe(j["id"]) + ".json")
   385	    def bind_for(j, inputs, smoke, gate):
   386	        st = {"max_rounds": 1 if gate else a.max_rounds, "threshold": THRESHOLD, "seeds": "1+(k-1)R", "gate": gate,
   387	              "nesting": (j["id"] in plan["nesting"]) and not gate}
   388	        return G.binding(inputs_sha=G.sha_json(inputs), provenance=j["provenance"], smoke=smoke, settings=st, driver_sha=drv,
   389	                         deps=deps_for(a.report, a.posthoc, dbl_rec(j), None if gate else emb(j)))
   390	    bind = lambda j: bind_for(j, needs[j["id"]], a.smoke, a.gate)
   391	    if not a.smoke and not a.gate:
   392	        gj = {c: job_for(c, root, cfgs, params, salt, False) for c in GATE_CELLS}
   393	        check_run_evidence(a.evidence, a.smoke, a.gate, {c: bind_for(j, cell_inputs(a.src, j), False, True) for c, j in gj.items()})
   394	    t = json.loads((ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]; ev = t["eval160"]["profit"] * 200 / 160
   395	    hours = lambda j: ((t["doubling_x7"] if j["family"] == "X7-SC" else t["doubling"]) + ev) / 3600 + 0.1     # a round, its evaluation, shutdown
   396	    paid = a.site == "pod" and not a.smoke
   397	    stop = G.paid_cost_stop(a.cap, a.rate, a.started, a.attempts, a.ledger, a.run_tag, stop_file=a.stop_file, soft_deadline=a.soft) if paid else None
   398	    cargs = worker_cost_args(stop) if paid else None
   399	    files = {"driver": Path(__file__), "plan": HERE / "convergence-plan.md", "report": Path(a.report), "posthoc": Path(a.posthoc)}
   400	    if a.gate:
   401	        res = {}
   402	        for j in jobs:                                           # serial; admission before each gate cell
   403	            if stop and not stop.allow(f"gate {j['id']}", hours(j)):
   404	                write(out / "cost_stop.json", stop.report()); G.inventory(out, DEVIATIONS, files, argv); return 3
   405	            res[j["id"]] = gate_cell(j, out, a.src, a.site, bind(j), cargs, hours(j))
   406	            if res[j["id"]]["cost_stopped"]:                     # shared launcher review r1: exit 3 (a stop), and no gate record
   407	                write(out / "cost_stop.json", {**(stop.report() if stop else {}), "inner": res[j["id"]]["cost"], "cell": j["id"]})
   408	                G.inventory(out, DEVIATIONS, files, argv); return 3
   409	            write(out / "gate" / (R._safe(j["id"]) + f"__{a.site}.json"), res[j["id"]])
   410	            if not res[j["id"]]["pass"]:                         # review r2: a measured mismatch ends the gate at once (exit 4);
   411	                G.inventory(out, DEVIATIONS, files, argv); return 4   # no later cell starts, so no later stop can mask it
   412	        G.inventory(out, DEVIATIONS, files, argv)
   413	        return 0 if all(r["pass"] for r in res.values()) else 4
   414	    path = lambda j: out / "convergence" / (R._safe(j["id"]) + ".json")
   415	    todo = sorted((j for j in jobs if not G.reusable(path(j), bind(j))), key=lambda j: j["family"] != "X7-SC")   # longest first
   416	    minr = lambda j: 2 if j["id"] in plan["nesting"] else 1
   417	    args = [(j, out, a.max_rounds, None if a.smoke else a.src, cargs, hours(j), emb(j), minr(j)) for j in todo]
   418	    lost = run_cells(run_cell, todo, args, a.workers, lambda j, rec: write(path(j), {**rec, "binding": bind(j)}))
   419	    if lost:                                                     # exit 5: a worker was lost; a restart runs only these cells
   420	        write(out / "lost_cells.json", {"lost": lost, "saved": [j["id"] for j in todo if j["id"] not in lost]})
   421	        G.inventory(out, DEVIATIONS, files, argv); return 5
   422	    status = {j["id"]: read(path(j))["status"] for j in jobs}
   423	    mismatch = [k for k, v in status.items() if v.startswith("stopped: round 1")]
   424	    if not a.smoke and not mismatch:
   425	        done = {j["id"]: bind(j) for j in jobs if "heldout" in read(path(j))}           # cost-stopped cells keep their frozen estimates
   426	        nest_done = {k: read(out / "convergence" / (R._safe(k) + ".json"))["heldout"]["gain"] for k in plan["nesting"] if k in done}
   427	        write(out / "recompute.json", {**recompute(a.src, out, expected=done), "nesting_shortfall": shortfall_report(nesting, nest_done)})
   428	    G.inventory(out, DEVIATIONS, files, argv)
   429	    print(json.dumps({"cells": len(jobs), "status": status}))
   430	    return 4 if mismatch else 0
