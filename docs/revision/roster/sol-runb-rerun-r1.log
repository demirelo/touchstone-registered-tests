   260	def run_cells(fn, todo: list, args: list, workers: int, save) -> list:
   261	    """Run the cells and save each one the moment it ends (Run B lost all 17 cells to one killed worker because results were
   262	    written only after every cell ended). Returns the ids of cells with no result: a lost worker breaks the pool, so every
   263	    cell unfinished at that moment is lost; the saved cells are skipped on restart (guards.reusable)."""
   264	    if workers <= 1 or len(todo) <= 1:
   265	        for j, x in zip(todo, args):
   266	            save(j, fn(*x))
   267	        return []
   268	    from concurrent.futures import ProcessPoolExecutor, as_completed
   269	    from concurrent.futures.process import BrokenProcessPool
   270	    done = set()
   271	    with ProcessPoolExecutor(max_workers=workers) as ex:
   272	        futs = {ex.submit(fn, *x): j for j, x in zip(todo, args)}
   273	        for f in as_completed(futs):
   274	            try:
   275	                rec = f.result()
   276	            except BrokenProcessPool:
   277	                continue
   278	            save(futs[f], rec); done.add(futs[f]["id"])
   279	    return [j["id"] for j in todo if j["id"] not in done]
