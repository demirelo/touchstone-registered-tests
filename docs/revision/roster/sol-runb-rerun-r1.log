   290	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   291	    """Gate mode: round 1 only. On the Mac it is compared with the frozen doubling stage run on the same machine (flagged
   292	    cells diverge across platforms); on the pod, with the registered doubling record. Saved full-budget evidence bound to
   293	    the cell's inputs, this driver, the site, and the environment."""
   294	    ref = frozen_doubling(job, out) if site == "mac" else None
   295	    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours, reference=ref)
   296	    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
   297	    stopped = r.get("round1_gate") == "not run"        # refused by the cell's own admission before round 1: a cost stop, not a mismatch
   298	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "cost_stopped": stopped, "cost": r.get("cost") if stopped else None, "site": site, "compared_with": "frozen stage, same machine" if ref else "registered record",
   299	            "comparison": r["round1_gate"],
   300	            "round1": (r.get("rounds") or [None])[0],
   301	            "binding": bind, "environment": G.environment()}
