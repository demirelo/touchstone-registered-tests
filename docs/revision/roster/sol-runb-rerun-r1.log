   304	def _cell_gains(src, conv, rid: str, expected: dict):
   305	    f = read(R.eval_path(src, rid))
   306	    if rid not in expected:
   307	        return f["gain"], f["gain"], False
   308	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   309	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   310	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   311	    g = c["heldout"]["gain"]
   312	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   313	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   314	    return f["gain"], g, True
