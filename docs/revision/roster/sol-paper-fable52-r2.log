+\title{Checking Newcomers When Identities Are Free:\\Two Registered Tests of an Audit Rule}
+\author{Ömer Demirel}
+\date{Draft 9, November 2026}
+\begin{document}
+\maketitle
+
+\begin{abstract}
+% BEGIN-EV2
+A buyer of computation often cannot see the quality of delivered work and can afford to check only a sample of it. We study a repeated procurement market with noisy delivery, costly exact audits, and free identity replacement, in a mechanism class without entry fees, identity certification, or collateral before receipts; a failed audit refunds the job's escrow and bans the serving identity for a finite number of rounds. For the uniform-audit baselines with refund-and-ban enforcement and no bonds, immediate free replacement makes the ban costless against honest rivals whose play does not depend on the focal identity, when re-entry comes before the next allocation. The rule we study, R3, checks every job of a new identity while the round's audits allow it, and after that window keeps targeting the newest identities, so a replacement can stay under heavy inspection: persistent age-ranked targeting rather than release by age. We report two registered tests. In the first, the original comparative claim failed; an amended claim, registered after development results were seen, passed on the public identity-replacement family. The second test compares R3 with a verified-history comparator C$^*$ at matched budget, payment, tolerance, ban, pacing, and sanctions, decomposes R3 into its three parts, adds stronger attacks, and repeats the B3--R3 comparison on six market instances drawn after the lock from a Bitcoin block hash.
+
+class WelfareObjective(Objective):
+    def __init__(self, cell: Cell, family: Family, cache: SeedCache, ref_normalized=None) -> None:
+        super().__init__(cell, family, cache)
+        self.ref = None if ref_normalized is None else np.asarray(ref_normalized, dtype=float)
+        self.extra: dict[tuple, dict] = {}
+
+    def eval_knobs(self, knobs: dict, source: str = "search") -> float:
+        knobs = dict(knobs)
+        fr = run_focal(self.cell, lambda: self.family.make(knobs), self.cache)
+        eff = gross_efficiency(fr.results); f = -float(eff.mean()); key = exact_key(knobs)
+        if key not in self.archive:
+            self.archive[key] = ArchiveEntry(knobs=dict(knobs), f=f, per_seed_profit=fr.profit, per_seed_normalized=fr.normalized,
+                                             inflated=fr.inflated, source=source)
+            self.extra[key] = {"eff": float(eff.mean()), "per_seed_eff": eff.tolist(),
+                               "constraint": None if self.ref is None else float((fr.normalized - self.ref).mean())}
+        self.log.append({"knobs": dict(knobs), "f": f, "source": source})
+        self.evals += 1
+        return f
+
+
+def select_w1(objective) -> dict | None:
+    """Among evaluated points with a non-negative training constraint mean, the lowest training efficiency (highest f),
+    ties to the earlier point; None reports "no feasible candidate found"."""
+    best = None
+    for key, e in objective.archive.items():
+        c = objective.extra[key]["constraint"]
+        if c is not None and c >= 0 and (best is None or e.f > best.f):
+            best = e
+    return None if best is None else dict(best.knobs)
+
+
+def coalition_score(member_g, kind: str) -> float:
+    means = [float(np.mean(g)) for g in member_g]
+    if kind == "total":
+        return float(sum(means))
+from __future__ import annotations
+
+import numpy as np
+
+from .base import AuditRecord, Consequences, StateView
+
+
+def spread_audit_count(allowance_left: int, t: int, T: int, served_count: int, cap_per_round: int, audit_u: float) -> int:
+    """Spec 4.1 spread schedule on an integer allowance; t is zero-based."""
+    if allowance_left <= 0:
+        return 0
+    target = allowance_left / (T - t)
+    base = int(np.floor(target))
+    n = base + (1 if audit_u < target - base else 0)
+    return max(0, min(n, int(served_count), int(cap_per_round), int(allowance_left)))
+
+
+class RandomAuditMixin:
+    tol: float
+    L: int
+    cap_per_round: int = 1
+    T: int = 1
+
+    def bind(self, cfg) -> None:
+        self.T = int(cfg.T)
+        self.cap_per_round = max(1, int(np.floor(2.0 * cfg.budget / (cfg.T * cfg.alpha)))) if cfg.alpha > 0 else 0
+
+    def audit(self, assignment: dict[int, int], view: StateView) -> list[int]:
+        jobs = np.fromiter(assignment.keys(), dtype=np.int64, count=len(assignment))
+        n = spread_audit_count(view.audits_left, view.t, self.T, len(jobs), self.cap_per_round, view.audit_u)
+        if n == 0:
+            return []
+        order = np.argsort(view.audit_key[jobs], kind="stable")
+        return jobs[order[:n]].tolist()
+
+    def enforce(self, records: tuple[AuditRecord, ...], view: StateView) -> Consequences:
+        cons = Consequences()
+        for r in records:
+            if r.failed:
+                cons.refunds[r.job] = float(view.escrow[r.job])
+                if self.L > 0:
+                    cons.bans[r.provider] = max(cons.bans.get(r.provider, 0), int(self.L))
+        return cons
+from __future__ import annotations
+
+import numpy as np
+
+from .base import AuditRecord, Consequences, Mechanism, Offers, StateView
+
+TIERS = ((0.0, 0.5), (0.5, 0.8), (0.8, 1.0001))
+
+
+class PostedPrices(Mechanism):
+    """B1 (spec 4.1). Tie-breaks use the precomputed key view.memory['tie_key'][j, i]."""
+    name = "B1_posted"
+    tol = None
+
+    def __init__(self, P1: float, P2: float, P3: float) -> None:
+        if not (0.0 < P1 < P2 < P3):
+            raise ValueError("need 0 < P1 < P2 < P3")
+        self.prices = (float(P1), float(P2), float(P3))
+
+    @staticmethod
+    def tier_of(claim: float) -> int:
+        for k, (lo, hi) in enumerate(TIERS):
+            if lo <= claim < hi:
+                return k
+        return 2
+
+    def allocate(self, values_t: np.ndarray, offers: Offers, view: StateView) -> dict[int, int]:
+        # Ten providers: plain Python per job beats NumPy small-array overhead.
+        cap = view.capacity.tolist()
+        tie = view.memory["tie_key"]
+        by_tier: list[list[tuple[int, float]]] = [[], [], []]   # (provider, acceptance threshold v >= P/claim)
+        for i, off in offers.items():
+            if view.is_active(i) and cap[i] > 0:
+                k = self.tier_of(off.claim)
+                thr = self.prices[k] / off.claim if off.claim > 0 else float("inf")
+                by_tier[k].append((i, thr))
+        out: dict[int, int] = {}
+        for j in np.argsort(-values_t, kind="stable").tolist():
+            v = float(values_t[j])
+            row = tie[j]
+            for k in (2, 1, 0):
+                best = -1; best_key = 2.0
+                for i, thr in by_tier[k]:
+                    if cap[i] > 0 and v >= thr:
+                        key = float(row[i])
+                        if key < best_key:
+                            best, best_key = i, key
+                if best >= 0:
+                    out[j] = best
+                    cap[best] -= 1
+                    break
+        return out
+
+    def price(self, assignment, values_t, offers, view) -> dict[int, float]:
+        tier_price = {i: self.prices[self.tier_of(off.claim)] for i, off in offers.items()}
+        return {j: tier_price[i] for j, i in assignment.items()}
+
+    def audit(self, assignment, view) -> list[int]:
+        return []
+
+    def enforce(self, records: tuple[AuditRecord, ...], view: StateView) -> Consequences:
+        return Consequences()
+
+    def describe(self) -> dict:
+        return {"allocation_order": "jobs in descending value; each job goes to the highest posted tier that has an offer with capacity whose claim times the job value reaches the tier price, at random among those offers; tiers by claim: below 0.5, 0.5 to below 0.8, 0.8 and above",
+                "eligibility": "active offers with capacity", "payment": "the posted price of the tier the job was allocated in",
+                "audit_selection": "none", "audit_tolerance": "none", "failed_audit": "none", "ban_length": "none", "holdback": "none",
+                "parameters": {}}
+
