+
+
+def envelope_difference(report: dict, markets) -> dict:
+    """Fable 5.2 review: C* minus R3 with each rule's training-selected strongest family (report q3.envelope); descriptive."""
+    e = report["q3"]["envelope"]; rows = {}
+    for m in markets:
