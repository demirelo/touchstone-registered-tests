+            rows[m] = {"difference": e["C*"][m]["estimate"] - e["F111"][m]["estimate"], "family_cstar": e["C*"][m]["family"], "family_r3": e["F111"][m]["family"]}
+    return {"markets": rows, "pooled": float(np.mean([v["difference"] for v in rows.values()]))}
