+def stability(report: dict, stab: dict) -> dict:
+    q1 = {k: {"estimate_report": report["q1"]["tests"][k]["estimate"], "estimate_registered_cfg": v["estimate"],
+              "category_report": report["q1"]["tests"][k]["category"], "category_registered_cfg": v["category"]}
