   396	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   397	    if (why := cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=dbl[gdest], search=srch[gdest])) is not None:
   398	        return {"run": run, "exit": 6, "gate": f"the gate record fails its checks: {why}"}
