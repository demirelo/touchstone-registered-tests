   348	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   349	              smoke: bool = False) -> dict:
   350	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   351	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   352	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   353	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   354	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   355	    cost-stopped ones."""
   356	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   357	    import revision_v2 as R
   358	    if gate is None:
   359	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   360	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   361	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   362	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   363	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   364	    saved = {d: _d(read_record(d)) for _, d in items}                   # a non-object root counts as no record
   365	    dbl = {d: doubling_of(c["dir"], c["job"]["id"]) for c, d in items}; srch = {d: search_of(c["dir"], c["job"]["id"]) for c, d in items}
   366	    other = [c["id"] for c, d in items if saved[d] is not None and _foreign(saved[d].get("provenance"), c["job"].get("provenance"))]
   367	    if other:                                                            # plan section 5: reuse only this run's records
   368	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   369	    if any(_mismatch(saved[d], dbl[d], srch[d]) for _, d in items):     # a measured disagreement included (review rep-impl-r5)
   370	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   371	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   372	    # review rep-impl-r3: a saved record is reused only if it passes the same checks collect applies; any other record
   373	    # (incomplete, malformed, nonfinite) means "no passing record" and its cell is rerun (plan section 4: a resume
   374	    # continues from the first cell without a passing record); the old record is set aside, never deleted
   375	    # (an unknown status included: review rep-impl-r4; a measured round-1 mismatch stopped above and is never rerun)
   376	    invalid = lambda c, d, mr: saved[d] is not None and not cost_stopped(saved[d]) and \
   377	        cont_problem(saved[d], c["id"], c["job"], smoke, mr, dbl[d], srch[d]) is not None
   378	    rerun = lambda c, d, mr: saved[d] is None or cost_stopped(saved[d]) or invalid(c, d, mr)
   379	    run = 0
   380	    if rerun(gate, gdest, 1):
   381	        _set_aside(cdir, gdest)
   382	        lost, failed = run_cells(_cont_one, [gate], [(gate["job"], gate["dir"], 1, cost, hours[gate["id"]])], 1, [gdest],
   383	                                 [{"id": gate["id"], "gate": True}])
   384	        run += 1
   385	        if failed:
   386	            return {"run": run, "failed": failed, "exit": 6, "gate": "the gate cell raised an error"}
   387	        if lost:
   388	            _lost(cdir, lost, hours, 1)
   389	            return {"run": run, "lost": lost, "exit": 5, "gate": "the gate cell's worker was lost"}
   390	    g = _d(read_record(gdest))
   391	    if _mismatch(g, dbl[gdest], srch[gdest]):
   392	        return {"run": run, "exit": 4, "gate": "round-1 mismatch at the gate: continuation stopped"}
   393	    if cost_stopped(g):
   394	        return {"run": run, "exit": 3, "gate": "the gate cell was refused at the cost cap: no further cell started"}
   395	    if not smoke and _gate_wellformed((g or {}).get("round1_gate")) and not identical(g):   # a measured, not identical gate
   396	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   397	    if (why := cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=dbl[gdest], search=srch[gdest])) is not None:
   398	        return {"run": run, "exit": 6, "gate": f"the gate record fails its checks: {why}"}
   399	    todo = [c for c in queue if rerun(c, dest(c), max_rounds)]          # same order; completed, valid cells reused
   400	    for c in todo:
   401	        _set_aside(cdir, dest(c))
   402	    lost, failed = ([], {}) if not todo else run_cells(
   403	        _cont_one, todo, [(c["job"], c["dir"], max_rounds, cost, hours[c["id"]]) for c in todo], workers,   # module-level fn
   404	        [dest(c) for c in todo], [{"id": c["id"]} for c in todo])
   405	    recs = [_d(read_record(dest(c))) for c in todo]
   406	    mismatch = [c["id"] for c, r in zip(todo, recs) if _mismatch(r, dbl[dest(c)], srch[dest(c)])]
   407	    stopped = [c["id"] for c, r in zip(todo, recs) if cost_stopped(r)]
   408	    if lost and not mismatch and not failed:
   409	        _lost(cdir, lost, hours, max_rounds)
   410	    code = 4 if mismatch else 6 if failed else 5 if lost else 3 if stopped else 0
   411	    return {"run": run + len(todo), "lost": lost, "failed": failed, "mismatch": mismatch, "stopped": stopped, "exit": code}
