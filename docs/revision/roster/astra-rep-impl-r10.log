   263	@_checked
   264	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3, doubling=None, search=None) -> str | None:
   265	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   266	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   267	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   268	    job's ordered evaluation seeds; a measured round 1 must agree with this cell's doubling record (`doubling`;
   269	    _round1_problem). The job must carry its evaluation seeds: no check is skipped."""
   270	    seeds = (job.get("mkt") or {}).get("seeds_eval")
   271	    if not seeds:
   272	        return "the job has no evaluation seeds to check against"
   273	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or not _same(rec.get("id"), key):
   274	        return "not a continuation record of this cell"
   275	    if not _same(rec.get("provenance"), job.get("provenance")):
   276	        return "continuation record of another job or run"
   277	    st = rec.get("status")
   278	    if st not in STATUSES:
   279	        return f"unknown continuation status {st!r}"
   280	    if st == STATUSES[3] and not _mismatch(rec, doubling, search):      # reviews rep-impl-r7, r8: the status needs
   281	        return "a round-1 mismatch status without measured evidence"    # measured evidence (a failing comparison or values)
   282	    if st in STATUSES[:2]:
   283	        g = rec.get("round1_gate")
   284	        if not (identical(rec) or (smoke and g == SMOKE_GATE)):
   285	            return "a continued winner without its own identical round-1 comparison"
   286	        if isinstance(g, dict) and not (_knobs_ok(g.get("heldout_knobs")) and _finite([g.get("heldout_mean")])):
   287	            return "round-1 comparison without a finite round-1 winner"
   288	        h = rec.get("heldout")
   289	        if not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   290	            return "held-out result missing, nonfinite, on other seeds or with a zero normalizer"
   291	        if (n := _n_of(job)) is None or safe_terms(h, n) is None:          # review rep-impl-r6: the same normalizer and
   292	            return "held-out normalizer not positive after division by N, or a term not finite"   # term checks as scoring
   293	        if x := _rounds_problem(rec, max_rounds):
   294	            return x
   295	        if isinstance(g, dict) and (x := _round1_problem(rec, doubling, search)):
   296	            return x
   297	    return None
