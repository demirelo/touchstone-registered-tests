   241	        return "round-1 changes differ from the doubling record's"
   242	    if not any(_same(r1.get("best_knobs"), k) for k in (h["knobs"], search["attack"]["best_knobs"])):
   243	        return "round-1 best knobs are neither the doubling winner nor the frozen winner"
   244	    fh = rec.get("heldout")
   245	    if isinstance(fh, dict) and _same(fh.get("knobs"), h["knobs"]) and not _same(fh.get("gain"), h["gain"]):
   246	        return "the doubling winner's held-out gains differ from the doubling record's"
   247	    return None
