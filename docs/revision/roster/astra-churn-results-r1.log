        g = evaluate_gain(cell, fam, dict(knobs), cand, cache)
    finally:
        REF.run_focal = orig
    return {**{k: [float(v) for v in getattr(g, k)] for k in BASE_FIELDS}, **extras(kept[0], kept[2], cell.cfg, cell.focal)}


