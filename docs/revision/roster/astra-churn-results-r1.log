   192	def _diag(sh):
   193	    """Driver-shaped pooled diagnostics: sh[(rule, winner)] is the first-bin honest-replacement share."""
   194	    pooled = {}
   195	    for (rule, w), v in sh.items():
   196	        bins = [{"share": v, "markets": 6 if v is not None else 0}] + [{"share": 0.1, "markets": 6}] * 3
   197	        pooled[f"{rule}|{w}"] = {"honest_replacement": bins, "honest_initial": bins, "focal": bins}
   198	    return {"cells": {}, "pooled": pooled}
