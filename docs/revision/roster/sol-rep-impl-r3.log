   343	def collect(base: Path, jobs_by_dir: dict, gate: dict | None, smoke: bool = False) -> dict:
   344	    """Records for both winner sets (recs[rate][market][rule] with gains, attack and reference terms, efficiency and
   345	    seeds), R3's audit counts for both sets, and the winner counts. Every record is checked before use (review
   346	    rep-impl-r2): a cell whose evaluation or doubling record fails base_problem is unscorable (plan section 4); a frozen
   347	    diagnostics row that fails diag_ok gives no audit count. Only flagged cells look at a continuation record; a flagged
   348	    cell without one is "not continued". The primary set is unavailable after a round-1 mismatch in any continuation
   349	    record, without this run's identical gate record (also when no cell is flagged), or when a flagged cell's
   350	    continuation record fails cont_problem. A continued R3 winner's audit count needs its checked continued diagnostics."""
   351	    import convergence_v2  # noqa: F401
   352	    import revision_v2 as R
   353	    base = Path(base); cdir = base / "continuation"
   354	    allrec = [read_record(q) for q in sorted(cdir.glob("*.json")) + sorted((cdir / "gate").glob("*.json")) if q.name != "lost_cells.json"]
   355	    mismatch = any(_mismatch(r) for r in allrec)
   356	    g = read_record(cdir / "gate" / (R._safe(gate["id"]) + ".json")) if gate else None
   357	    gjob = {**(gate or {}).get("job", {}), "mkt": None}
   358	    gate_ok = g is not None and cont_problem(g, gate["id"], gjob, smoke, max_rounds=1) is None and \
   359	        g.get("status") in STATUSES[:2] and (identical(g) or (smoke and g.get("round1_gate") == SMOKE_GATE))
   360	    frozen, primary, problems, unscorable = {}, {}, [], []
   361	    counts = {"frozen": 0, "continued": 0, "unresolved": 0, "stopped": 0, "not continued": 0}
   362	    audit = {"frozen": {}, "primary": {}}
   363	    bad_cont = False
   364	    for (kind, p), jobs in jobs_by_dir.items():
   365	        rk = "0" if p == 0 else f"{p:g}"; d = base / f"{kind}-p{p:g}"
   366	        diag = (read_record(d / "diagnostics.json") or {}).get("cells") or {} if kind == "menu" else {}
   367	        for j in jobs:
   368	            m, r = j["mkt"]["label"].replace("fresh", "rep"), analysis_rule(kind, j["rule"])
   369	            ev = read_record(R.eval_path(d, j["id"])); db = read_record(d / "doubling" / (R._safe(j["id"]) + ".json"))
   370	            seeds = j["mkt"]["seeds_eval"]
   371	            if (why := base_problem(d, j, ev, db)) is not None:
   372	                unscorable.append(f"{kind}-p{p:g}|{j['id']}: {why}"); continue
   373	            n = _n_agents(j); fz = terms_of(ev, n)
   374	            frozen.setdefault(rk, {}).setdefault(m, {})[r] = fz
   375	            fa = None
   376	            if r == "R3" and kind == "menu":
   377	                ck = f"{j['context']}|{j['rule']}"
   378	                row = (diag.get(ck) or {}).get("base")
   379	                sr = read_record(R.path_of(d, j["id"])) or {}
   380	                if diag_ok(row, seeds, (sr.get("attack") or {}).get("best_knobs")):
   381	                    fa = _audit_of(row["shares"]); audit["frozen"].setdefault(rk, {})[m] = fa
   382	                elif ck in diag:
   383	                    problems.append(f"{kind}-p{p:g}|{j['id']}: frozen diagnostics fail their checks")
   384	            win, kw, crec = fz, "frozen", None
   385	            key = _key(kind, p, j["id"])
   386	            if db["incomplete"]:
   387	                crec = read_record(cdir / (R._safe(key) + ".json"))
   388	                if crec is None:
   389	                    kw = "not continued"
   390	                elif (why := cont_problem(crec, key, j, smoke)) is not None:
   391	                    problems.append(f"{key}: {why}"); bad_cont = True; kw = "not continued"
   392	                else:
   393	                    try:
   394	                        _, kw = select_winner(fz["gain"], crec)
   395	                    except Round1Mismatch:
   396	                        kw = "frozen"
   397	                    if kw in ("continued", "unresolved"):
   398	                        win = terms_of(crec["heldout"], n)
   399	            counts[kw] += 1
   400	            primary.setdefault(rk, {}).setdefault(m, {})[r] = win
   401	            if r == "R3" and kind == "menu" and fa is not None:
   402	                if kw in ("continued", "unresolved"):
   403	                    cd = read_record(cdir / "diagnostics" / (R._safe(key) + ".json"))
   404	                    if cont_diag_ok(cd, key, j, crec["heldout"]["knobs"]):
   405	                        audit["primary"].setdefault(rk, {})[m] = _audit_of(cd["shares"])
   406	                    elif cd is not None:
   407	                        problems.append(f"{key}: continued diagnostics fail their checks")
   408	                else:
   409	                    audit["primary"].setdefault(rk, {})[m] = fa
   410	    if not gate_ok:
   411	        problems.append("no identical gate record of this run's gate cell")
   412	    bad = mismatch or not gate_ok or bad_cont
   413	    return {"frozen": frozen, "primary": None if bad else primary, "audit": audit, "counts": counts,
   414	            "round1_mismatch": mismatch, "gate_ok": gate_ok, "problems": problems, "unscorable": unscorable}
   415	
   416	
   417	def _diag_cont(job: dict, knobs: dict) -> dict:
   418	    """In a worker: the churn arm's diagnostic run (churn_v2._diag_one) for a continued winner's knobs on the evaluation
   419	    seeds under the cell's churn: per-seed normalised profits and newcomer audit counts (plan section 3, expectation 5
   420	    on the primary winners)."""
   421	    import churn_v2
   422	    import numpy as np
   423	    import revision_v2 as R
   424	    from sim.cell import SeedCache, run_focal
   425	    churn_v2.install()
   426	    T, L = R.constants(job); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(job)
