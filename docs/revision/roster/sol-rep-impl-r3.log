   279	def run_cells(fn, todo: list, args: list, workers: int, dests: list, extras: list) -> tuple:
   280	    """Run the cells, each in a worker process (also with one worker: a kill must not take the driver), and let each worker
   281	    save its own record the moment the cell ends. Run B lost all 17 cells to one killed worker because results were written
   282	    only after every cell ended. A lost worker breaks the pool (at submission or later); every cell with no record on disk
   283	    is lost, and saved cells are skipped on restart (guards.reusable). An ordinary exception in a cell is not a lost
   284	    worker: it is returned with its message and never restarted (Sol and Astra, rerun review r2). Returns (lost, failed)."""
   285	    from concurrent.futures import ProcessPoolExecutor, wait
   286	    from concurrent.futures.process import BrokenProcessPool
   287	    with ProcessPoolExecutor(max_workers=max(1, workers)) as ex:
   288	        futs = []
   289	        try:
   290	            for x, d, e in zip(args, dests, extras):
   291	                futs.append(ex.submit(_run_and_save, fn, x, d, e))
   292	        except BrokenProcessPool:
   293	            pass
   294	        wait(futs)                                               # a broken pool fails the rest; the disk says what is saved
   295	    failed = {}
   296	    for j, f in zip(todo, futs):
   297	        e = f.exception()
   298	        if e is not None and not isinstance(e, BrokenProcessPool):
   299	            failed[j["id"]] = f"{type(e).__name__}: {e}"
   300	    return [j["id"] for j, d in zip(todo, dests) if read(d) is None and j["id"] not in failed], failed
