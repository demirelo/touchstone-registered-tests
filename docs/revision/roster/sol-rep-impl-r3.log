   207	def _deps(d, job):
   208	    """The records an evaluation and a doubling record depend on (freeze, reference with its menu, the cell's search),
   209	    written once; returns the evaluation and the doubling dependency hashes."""
   210	    import convergence_v2  # noqa: F401
   211	    import revision_v2 as R
   212	    from sim.records_v2 import sha_file
   213	    ctx = job["context"]; menu = f"{ctx}|F000|D2+H3|profit"; fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   214	    for k, obj in ((fz, {"stage": "freeze"}), (menu, {"stage": "search", "attack": {"best_knobs": {"u0": 2.0, "x": 1}}}),
   215	                   (job["id"], {"stage": "search", "attack": {"best_knobs": KNOBS}})):
   216	        if not R.path_of(d, k).exists():
   217	            _w(R.path_of(d, k), obj)
   218	    if not R.path_of(d, rid).exists():
   219	        _w(R.path_of(d, rid), {"stage": "reference", "upstream": {menu: sha_file(R.path_of(d, menu))}})
   220	    h = lambda ks: {k: sha_file(R.path_of(d, k)) for k in ks}
   221	    return h([fz, rid, job["id"]]), h([fz, rid, job["id"], menu])
   222	
   223	
   224	def _cell(base, job, p, kind="menu", gain=(0.1, 0.3), incomplete=False, ev_prov=None, seeds=None, doubling=True, ev=True):
   225	    import convergence_v2  # noqa: F401
   226	    import revision_v2 as R
   227	    d = base / f"{kind}-p{p:g}"
   228	    h = {"seeds": list(seeds or job["mkt"]["seeds_eval"]), "gain": list(gain), "profit_attack": [g + 1 for g in gain],
   229	         "profit_ref": [1.0] * len(gain), "sstar": [4.0] * len(gain), "eff_attack": [0.9] * len(gain)}
   230	    eup, dup = _deps(d, job)
   231	    if ev:
   232	        _w(R.eval_path(d, job["id"]), {"stage": "evaluate", "id": job["id"], "provenance": ev_prov or job["provenance"], **h,
   233	                                       "upstream": eup})
   234	    if doubling:
   235	        _w(d / "doubling" / (R._safe(job["id"]) + ".json"), {"stage": "doubling", "id": job["id"], "provenance": job["provenance"],
   236	                                                             "kind": "profit", "attack_change": 0.01 if incomplete else 0.0,
   237	                                                             "reference_change": 0.0, "incomplete": incomplete,
   238	                                                             "heldout": {"knobs": dict(KNOBS), **h}, "upstream": dup})
   239	    return d
   240	
