    24	def _mean(xs):
    25	    return sum(xs) / len(xs)
    26	
    27	
    28	def _finite(xs) -> bool:
    29	    return bool(xs) and all(isinstance(x, (int, float)) and math.isfinite(x) for x in xs)
    30	
    31	
    32	def _check(gains: dict) -> None:
    33	    """Every present cell finite; within a market every rule and rate has the same number of seeds."""
    34	    for m in MARKETS:
    35	        lens = set()
    36	        for p in ALL_RATES:
    37	            for r, xs in (gains.get(p, {}).get(m) or {}).items():
    38	                if not _finite(xs):
    39	                    raise ValueError(f"{p} {m} {r}: missing or nonfinite gains")
    40	                lens.add(len(xs))
    41	        if len(lens) > 1:
    42	            raise ValueError(f"{m}: unequal seed vectors {sorted(lens)}")
    43	
    44	
    45	def _check_recs(recs: dict) -> None:
    46	    for m in MARKETS:
    47	        seeds = None
    48	        for p in ALL_RATES:
    49	            for r, c in (recs.get(p, {}).get(m) or {}).items():
    50	                for f in FIELDS:
