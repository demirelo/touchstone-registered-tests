    92	                a, b = contrast(_cell(gains, p, m), comp), contrast(_cell(gains, "0", m), comp)
    93	                if a is not None and b is not None:
    94	                    ms[m] = a - b
    95	            vals = list(ms.values())
    96	            out[p][x] = {"markets": ms, "complete": len(ms) == len(MARKETS),
    97	                         "mean": _mean(vals) if vals else None, "t95": _t95(vals) if len(vals) > 1 else None,
    98	                         "lower": sum(1 for v in vals if v < 0)}
