   250	def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
   251	    import revision_v2 as R
   252	    from sim.records_v2 import sha_file
   253	    up = rec.get("upstream")
   254	    if not isinstance(up, dict) or set(up) != set(want):
   255	        return "dependency set differs"
   256	    for u, h in up.items():
   257	        q = R.path_of(d, u)
   258	        if not q.is_file() or sha_file(q) != h:
   259	            return f"dependency hash differs: {u}"
   260	    return None
