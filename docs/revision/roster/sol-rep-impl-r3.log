   207	def _deps(d, job):
   208	    """The records an evaluation and a doubling record depend on (freeze, reference with its menu, the cell's search),
   209	    written once; returns the evaluation and the doubling dependency hashes."""
   210	    import convergence_v2  # noqa: F401
   211	    import revision_v2 as R
   212	    from sim.records_v2 import sha_file
   213	    ctx = job["context"]; menu = f"{ctx}|F000|D2+H3|profit"; fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   214	    for k, obj in ((fz, {"stage": "freeze"}), (menu, {"stage": "search", "attack": {"best_knobs": {"u0": 2.0, "x": 1}}}),
   215	                   (job["id"], {"stage": "search", "attack": {"best_knobs": KNOBS}})):
   216	        if not R.path_of(d, k).exists():
   217	            _w(R.path_of(d, k), obj)
   218	    if not R.path_of(d, rid).exists():
   219	        _w(R.path_of(d, rid), {"stage": "reference", "upstream": {menu: sha_file(R.path_of(d, menu))}})
   220	    h = lambda ks: {k: sha_file(R.path_of(d, k)) for k in ks}
   221	    return h([fz, rid, job["id"]]), h([fz, rid, job["id"], menu])
