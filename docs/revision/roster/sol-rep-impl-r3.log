   160	def _mismatch(rec) -> bool:
   161	    """A measured round 1 that differs from the doubling record at all. A cell refused before round 1 ("not run") or a
   162	    smoke run ("not compared") measured nothing."""
   163	    if rec is None:
   164	        return False
   165	    if str(rec.get("status", "")).startswith("stopped: round 1"):
   166	        return True
   167	    return isinstance(rec.get("round1_gate"), dict) and not identical(rec)
