   116	def _pool(calls, outcome=None):
   117	    """A fake Run B pool: records every call; outcome maps an id to "lost", "fail" or a record override."""
   118	    outcome = outcome or {}
   119	    def f(fn, todo, args, w, dests, extras):
   120	        calls.append([c["id"] for c in todo]); lost, failed = [], {}
   121	        for c, a, d, e in zip(todo, args, dests, extras):
   122	            o = outcome.get(c["id"])
   123	            if o == "lost":
   124	                lost.append(c["id"])
   125	            elif o == "fail":
   126	                failed[c["id"]] = "ValueError: x"
   127	            else:
   128	                D.write_record(d, {**fn(*a), **e, **(o or {})})
   129	        return lost, failed
   130	    return f
