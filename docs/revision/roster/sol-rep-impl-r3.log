    58	def flagged_cells(base: Path, jobs_by_dir: dict) -> list:
    59	    """Every cell whose doubling record says incomplete, as queue items (rate, market, rule, id, job, dir)."""
    60	    import revision_v2 as R
    61	    from sim.records_v2 import read
    62	    out = []
    63	    for (kind, p), jobs in jobs_by_dir.items():
    64	        d = Path(base) / f"{kind}-p{p:g}"
    65	        for j in jobs:
    66	            rec = read(d / "doubling" / (R._safe(j["id"]) + ".json"))
    67	            if rec is not None and rec.get("incomplete"):
    68	                out.append({"rate": p, "market": j["mkt"]["label"], "rule": "Cthr" if kind == "cthr" else j["rule"],
    69	                            "id": _key(kind, p, j["id"]), "job": j, "dir": str(d)})
    70	    return out
