     8	# The churn replication on new markets (docs/revision/followup3/replication-plan.md, plan section 5 to 7) on two Runpod CPU
     9	# pods, one after the other. Generated from followup2_pod.sh (Run B, reviewed in follow-up launcher rounds r1-r3 and the
    10	# rerun rounds; itself from churn_pod.sh and the reviewed reset_pod.sh, rounds r9-r18): pod safety, launch lock, price
    11	# ceiling, watchdog, spend records, request-time attempts, the ledger snapshot, deadlines net of PRIOR, per-step
    12	# admission, and verification of every pulled directory on every end state are unchanged. What differs (rep-launcher-notes.md):
    13	# - The first argument selects the pod: 1 (instances, calibration, menus and references, C-thr(12)) or 2 (p = 0
    14	#   evaluation, the churn-zero gate, churn searches and evaluation, continuation). Both pods share one run tag, one stop
    15	#   cap (the spend card) and one pod name, ts-rep (implementation review r1): one launch lock for the whole replication,
    16	#   and pod 2 is refused while pod 1's spend is unrecorded; pod 2 names pod 1's launch tag (POD1TAG), whose spend row
    17	#   must be in the ledger and whose output must name it; the two launch tags differ.
    18	# - Pod 1's bundle is the stamped manifest, its proof and the draw record; the code guard also requires that the manifest's
    19	#   commit is an ancestor of EXPECT and that every file the manifest lists matches its hash in the tarball.
    20	# - Pod 2's bundle adds pod 1's pulled output; the launcher verifies its inventory, that the calibration ran on Linux and
    21	#   that the saved configurations match the calibration record, before any marker.
    22	# - The driver (rep_v2.py) gets the stop cap, the ceiling, the pod's request time, PRIOR plus the closed attempts at the
    23	#   ceiling, and the STOP file and soft deadline; its stage admissions (churn stages, continuation rounds) run inside each step.
    24	# - After each pod, every file of the output directory is in its root inventory and verifies; every failure or stop exit
    25	#   of the remote script writes the inventory first, and a pull that fails on a failure state is retried before deletion.
    26	# - The launcher checks its own bytes against the manifest's rep_pod.sh before any marker.
    27	# Spending (the author: do not kill jobs): at the cap the pod stops BETWEEN steps; only at HARD x the cap is the pod deleted
    28	# mid-step (the watchdog). An EXIT/INT/TERM trap pulls what exists (only if the run started), deletes the pod and verifies
    29	# it. Spend (r16): the record is the account balance difference (podctl.py spend NAME, at least an hour after the watchdog
    30	# ends); this launcher prints only estimates. One launch per NAME at a time (NAME.launchlock; the watchdog releases it).
    31	# Usage: rep_pod.sh <1|2> <code_tgz> <bundle_tgz> <tag> <cap_usd> <local_out>   (no spaces in paths)
    32	# Env: EXPECT (commit inside the code tarball), MAXCPH, POD1TAG (pod 2 only: pod 1's launch tag), PUBH (the manifest's publication height, or "none": the draw is then
    33	# recorded as nonconfirmatory), optional MINMEM (default 28), HARD (default 1.3), LEDGER (default the worktree's
    34	# docs/revision/budget-ledger.json).
    35	set -u
    36	PY=/opt/homebrew/bin/python3; P=/Users/oemer.demirel/Projects/touchstone/results/pods
    37	RUN=${1:?pod 1 or 2}; TGZ=${2:?code tarball}; BTGZ=${3:?bundle tarball}; TAG=${4:?tag}; CAP=${5:?cap_usd}; LOUT=${6:?local_out}; cd $P
    38	case "$TGZ$BTGZ$TAG$LOUT" in *[[:space:]]*) echo "refused: a path or tag contains whitespace"; exit 1 ;; esac
    39	# PLANCAP: the conservative estimate with 1.25 headroom at flag share 0.5 (cost_estimate.py: 32.13 USD), rounded up; the
    40	# spend card sets the stop cap at or below it. One run tag for both pods, so the cap covers the whole replication.
    41	case "$RUN" in
    42	  1) NAME=ts-rep; RUNTAG=replication; PLANCAP=33.00; OUTS="followup3-rep"; POD1TAG="" ;;
    43	  2) NAME=ts-rep; RUNTAG=replication; PLANCAP=33.00; OUTS="followup3-rep"; POD1TAG=${POD1TAG:-}
    44	     [ -n "$POD1TAG" ] || { echo "refused: pod 2 needs POD1TAG, pod 1's launch tag"; exit 1; }
    45	     case "$POD1TAG" in *[!A-Za-z0-9_.-]*) echo "refused: POD1TAG has characters other than letters, digits, _ . -"; exit 1 ;; esac
    46	     [ "$POD1TAG" != "$TAG" ] || { echo "refused: pod 2's launch tag must differ from pod 1's ($POD1TAG)"; exit 1 ;} ;;
