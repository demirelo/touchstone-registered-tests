   222	def diagnostics(out, jobs: list[dict], workers: int = 1) -> dict:
   223	    """Plan section 4 (draft 2): the base and the doubled winner of each churn cell rerun on the evaluation seeds under
   224	    churn, with per-seed normalised profits and newcomer audit counts; and, per rule and winner, the age-bin shares pooled
   225	    over markets with equal weights."""
