   337	def _rw(path, **change):
   338	    """Rewrite one record with fields changed (None removes the field)."""
   339	    import json
   340	    r = json.loads(path.read_text())
   341	    for k, v in change.items():
   342	        if v is None:
   343	            r.pop(k, None)
   344	        else:
   345	            r[k] = v
   346	    path.write_text(json.dumps(r))
