   127	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3) -> str | None:
   128	    """A continuation record (review rep-impl-r2): stage, id, provenance, a known status; a winner it supplies ("passed"
   129	    or "not passed at the cap") needs its own identical round-1 comparison (smoke: not compared), one to max_rounds
   130	    rounds and a finite held-out result on the job's ordered evaluation seeds with finite knobs."""
   131	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or rec.get("id") != key:
   132	        return "not a continuation record of this cell"
   133	    if rec.get("provenance") != job.get("provenance"):
   134	        return "continuation record of another job or run"
   135	    st = rec.get("status")
   136	    if st not in STATUSES:
   137	        return f"unknown continuation status {st!r}"
   138	    if st in STATUSES[:2]:
   139	        if not (identical(rec) or (smoke and rec.get("round1_gate") == SMOKE_GATE)):
   140	            return "a continued winner without its own identical round-1 comparison"
   141	        rounds = rec.get("rounds")
   142	        if not isinstance(rounds, list) or not 1 <= len(rounds) <= max_rounds:
   143	            return "rounds missing or beyond the cap"
   144	        h = rec.get("heldout")
   145	        seeds = (job.get("mkt") or {}).get("seeds_eval")
   146	        if seeds is not None and not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   147	            return "held-out result missing, nonfinite or on other seeds"
   148	    return None
