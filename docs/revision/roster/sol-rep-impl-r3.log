   228	        rows = [_diag_one(j, str(out)) for j in jobs]
   229	    else:
   230	        with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
   231	            rows = list(ex.map(_diag_one, jobs, [str(out)] * len(jobs)))
