   151	def _set_aside(cdir: Path, dest: Path) -> None:
   152	    """Move a record that will be rerun out of the way (no deletion), so that a lost worker shows as a missing record and
   153	    is never masked by the old one (review rep-impl-r2)."""
   154	    if dest.exists():
   155	        sup = cdir / "superseded"; sup.mkdir(parents=True, exist_ok=True)
   156	        n = len(list(sup.glob(dest.stem + ".*.json")))
   157	        dest.rename(sup / f"{dest.stem}.{n}.json")
