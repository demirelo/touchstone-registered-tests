   198	def _job(m="fresh0", rule="F111", p=0.0):
   199	    jid = f"{m}@rho0.2|{rule}|D2+H3|profit" + (f"|churn{p:g}" if p else "")
   200	    return {"id": jid, "rule": rule, "context": f"{m}@rho0.2", "mkt": {"label": m, "seeds_eval": [11, 12], "cfg": {"N": 4}},
   201	            "provenance": {"id": jid, "b": 1}}
