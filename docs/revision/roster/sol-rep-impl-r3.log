   242	def _cont(base, kind, p, job, status="passed", gain=(0.5, 0.7), gate=EXACT, sub=""):
   243	    import convergence_v2  # noqa: F401
   244	    import revision_v2 as R
   245	    key = D._key(kind, p, job["id"])
   246	    h = {"knobs": {"u0": 3.0, "x": 2}, "seeds": job["mkt"]["seeds_eval"], "gain": list(gain), "profit_attack": [g + 1 for g in gain],
   247	         "profit_ref": [1.0] * len(gain), "sstar": [4.0] * len(gain), "eff_attack": [0.8] * len(gain)}
   248	    _w(base / "continuation" / sub / (R._safe(key) + ".json"), {"stage": "convergence", "id": key, "status": status,
   249	                                                               "provenance": job["provenance"], "round1_gate": gate,
   250	                                                               "rounds": [{"round": 1}], "heldout": h})
   251	    return key
