    94	def _cont_one(job: dict, rate_dir: str, max_rounds: int, cost, hours: float) -> dict:
    95	    """In a worker: install the churn-aware adapter, then continue one cell; round 1 is compared with this run's
    96	    doubling record in the same rate directory. Every round is admitted with `hours` against the cost stop."""
    97	    from continuation import install_continuation
    98	    install_continuation()
    99	    import convergence_v2 as B
   100	    return B.run_cell(job, rate_dir, max_rounds=max_rounds, src=rate_dir, cost=cost, round_hours=hours)
