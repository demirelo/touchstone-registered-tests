   162	def newcomer_shares(results, focal: int, edges=AGE_EDGES) -> dict:
   163	    """Audited share of served jobs by identity age (rounds since creation) for honest replacement identities, honest
   164	    initial identities, and the focal provider's identities: per episode [served, audited] counts per age bin, and the
   165	    pooled share per bin (None, "unavailable", when no job was served in the bin); honest replacements per episode; and
   166	    per episode the share of rounds in which the focal identity is uniquely the newest."""
   167	    cats = ("honest_replacement", "honest_initial", "focal"); nb = len(edges) - 1
   168	    per, reps, newest, offer_newest = [], [], [], []
   169	    for r in results:
   170	        cnt = {c: [[0, 0] for _ in range(nb)] for c in cats}
   171	        reps.append(sum(1 for i, e in enumerate(r.entity_of) if e != focal and r.identity_generation[i] > 0))
   172	        cat = lambda i: "focal" if r.entity_of[i] == focal else ("honest_replacement" if r.identity_generation[i] > 0 else "honest_initial")
   173	        for t, h in enumerate(r.history):
   174	            def put(i, k):
   175	                age = t - r.identity_round[i]
   176	                for b in range(nb):
   177	                    if edges[b] <= age < edges[b + 1]:
   178	                        cnt[cat(i)][b][k] += 1; return
   179	            for i in h.assignment.values():
   180	                put(i, 0)
   181	            for a in h.audits:
   182	                put(a.provider, 1)
   183	        per.append(cnt); newest.append(_uniquely_newest(r, focal)); offer_newest.append(_newest_by_first_offer(r, focal))
   184	    out = {}
   185	    for c in cats:
   186	        rows = []
   187	        for b in range(nb):
   188	            sv = sum(e[c][b][0] for e in per); au = sum(e[c][b][1] for e in per)
   189	            rows.append({"age": [edges[b], edges[b + 1]], "served": sv, "audited": au, "share": (au / sv if sv else None)})
   190	        out[c] = rows
   191	    out["per_episode"] = per
   192	    out["honest_replacements_per_episode"] = float(sum(reps) / len(reps)) if reps else 0.0
   193	    out["focal_newest_by_creation"] = newest
   194	    out["focal_newest_by_first_offer_assigned"] = offer_newest
   195	    return out
