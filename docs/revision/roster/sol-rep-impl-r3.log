   263	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   264	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   265	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   266	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   267	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   268	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   269	    import revision_v2 as R
   270	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   271	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   272	    if ev is None:
   273	        return "no evaluation record"
   274	    if ev.get("stage") != "evaluate" or ev.get("id") != job["id"] or ev.get("provenance") != job["provenance"]:
   275	        return "evaluation record of another stage, cell or run"
   276	    if not _valid_held(ev, seeds):
   277	        return "evaluation values nonfinite or on other seeds"
   278	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
   279	        return "evaluation: " + x
   280	    if db is None:
   281	        return "no doubling record"
   282	    if db.get("stage") != "doubling" or db.get("id") != job["id"] or db.get("provenance") != job["provenance"] or db.get("kind") != "profit":
   283	        return "doubling record of another stage, cell, run or kind"
   284	    ch = [db.get("attack_change"), db.get("reference_change")]
   285	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   286	        return "doubling changes nonfinite or flag missing"
   287	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   288	        return "doubling flag differs from its changes"
   289	    h = db.get("heldout")
   290	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   291	        return "doubling held-out result missing, nonfinite or on other seeds"
   292	    ref = read_record(R.path_of(d, rid))
   293	    if ref is None or not isinstance(ref.get("upstream"), dict):
   294	        return "no reference record"
   295	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   296	        return "doubling: " + x
   297	    return None
