    52	                        raise ValueError(f"{p} {m} {r}: missing or nonfinite {f}")
    53	                if len({len(c[f]) for f in FIELDS} | {len(c["seeds"])}) != 1:
    54	                    raise ValueError(f"{p} {m} {r}: fields of unequal length")
    55	                if seeds is None:
    56	                    seeds = list(c["seeds"])
    57	                elif list(c["seeds"]) != seeds:
    58	                    raise ValueError(f"{p} {m} {r}: seeds differ from the market's other cells")
    59	
