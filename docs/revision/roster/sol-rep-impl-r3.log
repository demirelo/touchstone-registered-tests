   108	def identical(rec) -> bool:
   109	    """Round 1 equals this run's doubling record exactly (plan section 5: "required identical"); Run B's comparison
   110	    allowed 1e-9 on the continuous values, so its pass alone is not enough."""
   111	    g = (rec or {}).get("round1_gate")
   112	    return isinstance(g, dict) and g.get("pass") is True and all(g.get(k) == 0.0 for k in ("max_knob_rel", "max_change_abs", "max_gain_abs"))
