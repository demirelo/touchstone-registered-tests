    82	def paired_changes(gains: dict) -> dict:
    83	    """Delta_x(m, p) = x(m, p) - x(m, 0) per contrast and positive rate over the six named markets; mean, market t interval
    84	    and markets lower. A market missing a needed rule at either rate leaves that contrast incomplete."""
    85	    _check(gains)
    86	    out = {}
    87	    for p in RATES:
    88	        out[p] = {}
    89	        for x, comp in CONTRASTS.items():
    90	            ms = {}
