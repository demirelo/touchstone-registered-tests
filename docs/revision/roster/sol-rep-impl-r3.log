   178	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   179	              smoke: bool = False) -> dict:
   180	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   181	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   182	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   183	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   184	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   185	    cost-stopped ones."""
   186	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   187	    import revision_v2 as R
   188	    if gate is None:
   189	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   190	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   191	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   192	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   193	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   194	    saved = {d: read_record(d) for _, d in items}
   195	    other = [c["id"] for c, d in items if saved[d] is not None and saved[d].get("provenance") != c["job"].get("provenance")]
   196	    if other:                                                            # plan section 5: reuse only this run's records
   197	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   198	    if any(_mismatch(r) for r in saved.values()):
   199	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   200	    bad = [(c["id"], saved[d].get("status")) for c, d in items if saved[d] is not None and saved[d].get("status") not in STATUSES]
   201	    if bad:                                                              # review rep-impl-r2: no reuse of an unknown record
   202	        raise SystemExit(f"replication refused: saved continuation records with an unknown status: {bad[:3]}")
   203	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   204	    run = 0
   205	    if saved[gdest] is None or cost_stopped(saved[gdest]):
   206	        _set_aside(cdir, gdest)
   207	        lost, failed = run_cells(_cont_one, [gate], [(gate["job"], gate["dir"], 1, cost, hours[gate["id"]])], 1, [gdest],
   208	                                 [{"id": gate["id"], "gate": True}])
   209	        run += 1
   210	        if failed:
   211	            return {"run": run, "failed": failed, "exit": 6, "gate": "the gate cell raised an error"}
   212	        if lost:
   213	            _lost(cdir, lost, hours, 1)
   214	            return {"run": run, "lost": lost, "exit": 5, "gate": "the gate cell's worker was lost"}
   215	    g = read_record(gdest)
   216	    if _mismatch(g):
   217	        return {"run": run, "exit": 4, "gate": "round-1 mismatch at the gate: continuation stopped"}
   218	    if cost_stopped(g):
   219	        return {"run": run, "exit": 3, "gate": "the gate cell was refused at the cost cap: no further cell started"}
   220	    if not smoke and not identical(g):                                   # the gate must prove identity, not just not fail
   221	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   222	    todo = [c for c in queue if saved[dest(c)] is None or cost_stopped(saved[dest(c)])]   # same order; completed cells reused
   223	    for c in todo:
   224	        _set_aside(cdir, dest(c))
   225	    lost, failed = ([], {}) if not todo else run_cells(
   226	        _cont_one, todo, [(c["job"], c["dir"], max_rounds, cost, hours[c["id"]]) for c in todo], workers,   # module-level fn
   227	        [dest(c) for c in todo], [{"id": c["id"]} for c in todo])
   228	    recs = [read_record(dest(c)) for c in todo]
   229	    mismatch = [c["id"] for c, r in zip(todo, recs) if _mismatch(r)]
   230	    stopped = [c["id"] for c, r in zip(todo, recs) if cost_stopped(r)]
   231	    if lost and not mismatch and not failed:
   232	        _lost(cdir, lost, hours, max_rounds)
   233	    code = 4 if mismatch else 6 if failed else 5 if lost else 3 if stopped else 0
   234	    return {"run": run + len(todo), "lost": lost, "failed": failed, "mismatch": mismatch, "stopped": stopped, "exit": code}
   235	
