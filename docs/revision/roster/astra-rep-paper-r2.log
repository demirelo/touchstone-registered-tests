    21	CATS = ("honest_replacement", "honest_initial", "focal")
    22	STEM = re.compile(r"^(menu|cthr)-p(0|0\.03|0\.05)__fresh([0-5])@rho0\.2__(F111|Cstar|F000)__D2\+H3__profit(__churn(0\.03|0\.05))?$")
    23	WINNER_KINDS = ("continued", "unresolved")
