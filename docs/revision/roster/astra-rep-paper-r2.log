   126	def summary(analysis: dict, extract: dict, analysis_sha: str) -> dict:
   127	    _validate(analysis, extract, analysis_sha)
   128	    res = {"continued": _continued(extract["continued"])}
   129	    for s, _ in SETS:
   130	        if isinstance(analysis[s], str):
   131	            raise ValueError(f"winner set {s} not available")
   132	        a = analysis[s]
   133	        res[s] = {"audit": _audit(extract["audit"][s]), "alloc": _alloc(extract["alloc"][s]), "eff": _eff(a["terms"]),
   134	                  "absneg": {p: {x: {"negative": sum(v["estimate"] < 0 for v in a["absolute"][p][x]["markets"].values())}
   135	                                 for x, _ in X} for p in RATES},
   136	                  "spread": {p: {x: _spread(a["paired_changes"][p][x]) for x, _ in X} for p in ("0.03", "0.05")},
   137	                  "criteria": {k: {"cells": sum(c[k] for p in a["criteria"] for c in a["criteria"][p].values())}
   138	                               for k in ("support", "material")}}
   139	        v = [e["verdict"] for e in a["expectations"].values()]
   140	        if any(x not in ("met", "not met") for x in v):
   141	            raise ValueError(f"expectation not scorable in {s}")
   142	        res[s]["exp"] = {"fulfilled": v.count("met"), "failed": v.count("not met")}
   143	        if (res[s]["audit"]["below"]["markets"] >= 5) != (a["expectations"]["5"]["verdict"] == "met"):
   144	            raise ValueError(f"the audit counts disagree with expectation 5 ({s})")
   145	    res["setdiff"] = {p: {x: {"difference": analysis["primary"]["absolute"][p][x]["mean"] - analysis["frozen"]["absolute"][p][x]["mean"]}
   146	                          for x, _ in X} for p in RATES}
   147	    return res
