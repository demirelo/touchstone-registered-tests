    30	def allocation(shares: dict) -> dict:
    31	    """The draft-10 audit allocation (docs/revision/posthoc/churn_block.py, audit_allocation) for one winner: per-episode
    32	    [served, audited] counts summed over episodes; young = the first age bin (younger than ten rounds); established =
    33	    the other bins. A zero denominator gives None."""
    34	    per = shares["per_episode"]
    35	    nb = len(per[0]["focal"]) if per else 0
    36	    t = {c: [[sum(e[c][b][j] for e in per) for j in (0, 1)] for b in range(nb)] for c in CATS}
    37	    served = sum(t[c][b][0] for c in CATS for b in range(nb))
    38	    audits = sum(t[c][b][1] for c in CATS for b in range(nb))
    39	    yh = [t["honest_replacement"][0][j] + t["honest_initial"][0][j] for j in (0, 1)]
    40	    eh = [sum(t[c][b][j] for c in ("honest_replacement", "honest_initial") for b in range(1, nb)) for j in (0, 1)]
    41	    fo = [sum(t["focal"][b][j] for b in range(nb)) for j in (0, 1)]
    42	    div = lambda a, b: a / b if b else None
    43	    return {"young_honest_job_share": div(yh[0], served), "young_honest_audit_share": div(yh[1], audits),
    44	            "established_honest_audit_rate": div(eh[1], eh[0]), "focal_job_share": div(fo[0], served),
    45	            "focal_audit_rate": div(fo[1], fo[0])}
    46	
