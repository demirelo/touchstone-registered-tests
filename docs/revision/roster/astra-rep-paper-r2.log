   150	def _f(v) -> str:
   151	    return "--" if v is None else f"{v:.3f}".replace("-", "$-$")
   152	
   153	
   154	def _ci(c) -> str:
   155	    return f"[{_f(c[0])}, {_f(c[1])}]"
