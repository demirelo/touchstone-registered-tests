    48	def _audit(au: dict) -> dict:
    49	    out = {}
    50	    for p in RATES:
    51	        sh = [s for s in (_share(c) for c in au.get(p, {}).values()) if s is not None]
    52	        out[p] = {"markets": len(sh), "focal_audit_min": min(sh) if sh else None, "focal_audit_max": max(sh) if sh else None}
    53	    below = 0
    54	    for m, c5 in au.get("0.05", {}).items():
    55	        s0, s5 = _share(au.get("0", {}).get(m)), _share(c5)
    56	        below += int(s0 is not None and s5 is not None and s5 < s0)
    57	    out["below"] = {"markets": below}
    58	    return out
    59	
    60	
    61	def _alloc(al: dict) -> dict:
    62	    out = {}
    63	    for p in RATES:
    64	        rows = list(al.get(p, {}).values())
    65	        mean = lambda k: (sum(r[k] for r in rows if r[k] is not None) / sum(r[k] is not None for r in rows)
    66	                          if any(r[k] is not None for r in rows) else None)
    67	        out[p] = {k: mean(k) for k in ALLOC}
    68	        out[p]["markets"] = len(rows)
    69	    return out
    70	
    71	
    72	def _eff(terms: dict) -> dict:
    73	    out = {}
    74	    for p in RATES:
    75	        out[p] = {}
    76	        for r in RULES:
    77	            v = [terms[p][m][r]["eff_attack"] for m in sorted(terms[p])]
    78	            if not all(math.isfinite(x) for x in v):
    79	                raise ValueError(f"nonfinite efficiency at {p} {r}")
    80	            out[p][r] = {"eff": sum(v) / len(v), "eff_min": min(v)}
    81	    return out
    82	
    83	
    84	def _spread(pc: dict) -> dict:
    85	    """The two most negative market changes, their markets, and the range of the other four."""
    86	    v = sorted(pc["markets"].items(), key=lambda kv: kv[1])
    87	    rest = [x for _, x in v[2:]]
    88	    return {"top": {"0": v[0][1], "1": v[1][1]}, "top_markets": sorted(m for m, _ in v[:2]), "rest": {"min": min(rest), "max": max(rest)}}
    89	
    90	
    91	def _continued(cells: list) -> dict:
    92	    rule = lambda c: "C-thr" if c["kind"] == "cthr" else POLICY[c["policy"]]
    93	    out = {"all": {"cells": len(cells)}, "rules": {r: {"cells": sum(rule(c) == r for c in cells)} for r in RULES}}
    94	    out.update({p: {"cells": sum(c["rate"] == p for c in cells)} for p in RATES})
    95	    return out
