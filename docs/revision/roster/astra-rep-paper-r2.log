    98	def _validate(analysis: dict, extract: dict, analysis_sha: str) -> None:
    99	    if analysis.get("problems") or analysis.get("unscorable") or analysis.get("round1_mismatch") or not analysis.get("gate_ok"):
   100	        raise ValueError("the analysis reports problems, unscorable cells, a round-1 mismatch or a failed gate")
   101	    if analysis.get("confirmatory") is not True:
   102	        raise ValueError("the analysis is not the confirmatory run")
   103	    if (extract.get("binding") or {}).get("analysis") != analysis_sha:
   104	        raise ValueError("the extract is not bound to this analysis file")
   105	    if extract.get("status") != {k: analysis.get(k) for k in STATUS}:
   106	        raise ValueError("the extract's collector status differs from the analysis")
   107	    if analysis["counts"] != extract["counts"]:
   108	        raise ValueError("the extract's counts differ from the analysis")
   109	    stems = [c["stem"] for c in extract["continued"]]
   110	    if len(set(stems)) != len(stems):
   111	        raise ValueError("duplicate continued cell")
   112	    for c in extract["continued"]:
   113	        if dict(parse_cell(c["stem"]), stem=c["stem"]) != c:
   114	            raise ValueError(f"continued cell fields disagree with its identity: {c['stem']}")
   115	    if len(stems) != analysis["counts"]["continued"] + analysis["counts"].get("unresolved", 0):
   116	        raise ValueError("the continued-cell list does not match the continued count")
   117	    for s, _ in SETS:
   118	        for part in ("audit", "alloc"):
   119	            for p, ms in extract[part][s].items():
   120	                if p not in RATES or not set(ms) <= set(MARKETS):
   121	                    raise ValueError(f"unexpected rate or market in the extract's {part} ({s}, {p})")
   122	        if {p: set(ms) for p, ms in extract["audit"][s].items()} != {p: set(ms) for p, ms in extract["alloc"][s].items()}:
   123	            raise ValueError(f"audit counts and allocation cover different cells ({s})")
   124	
