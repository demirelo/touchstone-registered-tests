   242	
   243	def outputs(analysis, extract, analysis_sha, summary_path, table_path) -> dict:
   244	    s = summary(analysis, extract, analysis_sha)
   245	    d = Path(table_path).parent
   246	    return {Path(summary_path): _dump(s), Path(table_path): table(analysis),
   247	            d / "replication_markets.tex": table_markets(analysis), d / "replication_absolute.tex": table_absolute(analysis),
   248	            d / "replication_terms.tex": table_terms(analysis), d / "replication_alloc.tex": table_alloc(s)}
   249	
   250	
   251	def write(analysis, extract, analysis_sha, summary_path, table_path) -> None:
   252	    for path, text in outputs(analysis, extract, analysis_sha, summary_path, table_path).items():
   253	        path.write_text(text)
   254	
   255	
   256	def check(analysis, extract, analysis_sha, summary_path, table_path) -> list:
   257	    return [f"stale: {p} (run replication_paper.py --write)"
   258	            for p, want in outputs(analysis, extract, analysis_sha, summary_path, table_path).items()
   259	            if not p.exists() or p.read_text() != want]
   260	
   261	
   262	def main(argv=None) -> int:
   263	    ap = argparse.ArgumentParser()
   264	    for k in ("analysis", "extract", "summary", "table"):
   265	        ap.add_argument(f"--{k}", required=True)
   266	    g = ap.add_mutually_exclusive_group(required=True); g.add_argument("--write", action="store_true"); g.add_argument("--check", action="store_true")
   267	    a = ap.parse_args(argv)
   268	    an, ex = (json.loads(Path(p).read_text()) for p in (a.analysis, a.extract))
   269	    sha = sha_file(a.analysis)
   270	    if a.write:
   271	        write(an, ex, sha, a.summary, a.table); return 0
   272	    probs = check(an, ex, sha, a.summary, a.table)
   273	    print("\n".join(probs) or "ok")
   274	    return 1 if probs else 0
   275	
   276	
   277	if __name__ == "__main__":
   278	    sys.exit(main())

