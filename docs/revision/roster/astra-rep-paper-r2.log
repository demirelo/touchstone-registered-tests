   158	def table(analysis: dict) -> str:
   159	    cols = "ll" + "rr" * len(X)
   160	    head = " & ".join(["Winners", "$p$"] + [f"\\multicolumn{{2}}{{c}}{{{lab}}}" for _, lab in X])
   161	    lines = [f"\\begin{{tabular}}{{{cols}}}", "\\toprule", head + " \\\\",
   162	             "\\midrule", f"\\multicolumn{{{len(cols)}}}{{l}}{{\\emph{{Paired change from the market's no-churn value: mean [market $t$ interval], markets lower}}}} \\\\"]
   163	    for s, lab in SETS:
   164	        for p in ("0.03", "0.05"):
   165	            cells = []
   166	            for x, _ in X:
   167	                c = analysis[s]["paired_changes"][p][x]
   168	                cells += [f"{_f(c['mean'])} {_ci(c['t95'])}", f"{c['lower']}/6"]
   169	            lines.append(" & ".join([lab, p] + cells) + " \\\\")
   170	    lines += ["\\midrule", f"\\multicolumn{{{len(cols)}}}{{l}}{{\\emph{{Absolute contrast: mean [market $t$ interval]}}}} \\\\"]
   171	    for s, lab in SETS:
   172	        for p in RATES:
   173	            cells = []
   174	            for x, _ in X:
   175	                c = analysis[s]["absolute"][p][x]
   176	                cells += [f"\\multicolumn{{2}}{{r}}{{{_f(c['mean'])} {_ci(c['t95'])}}}"]
   177	            lines.append(" & ".join([lab, p] + cells) + " \\\\")
   178	    lines += ["\\bottomrule", "\\end{tabular}", ""]
   179	    return "\n".join(lines)
   180	
