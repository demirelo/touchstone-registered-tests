 POLICY = {"F111": "R3", "Cstar": "C*", "F000": "B3"}   # menu policies; every cthr-directory cell is C-thr
-SETS = (("primary", "Primary winners"), ("frozen", "All-frozen winners"))
+SETS = (("primary", "Primary"), ("frozen", "All-frozen"))
 X = (("d", "$d$ (C$^*$)"), ("q", "$q$ (B3)"), ("u", "$u$ (C-thr)"))
