    62	def build(col: dict, winners: dict, safe, hashes: dict) -> dict:
    63	    """The extract from the collector output, the recorded winner kind per continuation key, the collector's file-name
    64	    function and the input hashes. The continued list holds the flagged cells whose primary winner is the continued
    65	    one; its length must equal the collector's continued plus unresolved counts."""
    66	    stems = sorted(safe(k) for k, kw in winners.items() if kw in WINNER_KINDS)
    67	    if len(set(stems)) != len(stems):
    68	        raise ValueError("duplicate continued cell")
    69	    if len(stems) != sum(col["counts"].get(k, 0) for k in WINNER_KINDS):
    70	        raise ValueError("the continued list disagrees with the collector's counts")
    71	    sets = ("frozen", "primary")
    72	    return {"audit": {s: {rk: {m: [v[0], v[1]] for m, v in sorted(ms.items())} for rk, ms in sorted(col["audit"][s].items())} for s in sets},
    73	            "alloc": {s: {rk: {m: v.alloc for m, v in sorted(ms.items())} for rk, ms in sorted(col["audit"][s].items())} for s in sets},
    74	            "counts": col["counts"], "continued": [dict(parse_cell(s), stem=s) for s in stems],
    75	            "status": {k: col[k] for k in ("problems", "unscorable", "round1_mismatch", "gate_ok")}, "binding": hashes}
    76	
