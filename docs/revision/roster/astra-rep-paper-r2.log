+STATUS = ("problems", "unscorable", "round1_mismatch", "gate_ok")
+APPENDIX = ("markets", "absolute", "terms", "alloc")
+
+
+def sha_file(p) -> str:
+    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
 
 
