    53	def parse_cell(stem: str) -> dict:
    54	    """'menu-p0.05__fresh3@rho0.2__F111__D2+H3__profit__churn0.05' -> kind, rate, market, policy. Refuses any other
    55	    shape, a churn suffix that disagrees with the rate, or a churn suffix at p = 0."""
    56	    m = STEM.match(stem)
    57	    if not m or (m.group(2) == "0") != (m.group(6) is None) or (m.group(6) and m.group(6) != m.group(2)):
    58	        raise ValueError(f"unexpected cell identity: {stem}")
    59	    return {"kind": m.group(1), "rate": m.group(2), "market": "rep" + m.group(3), "policy": m.group(4)}
