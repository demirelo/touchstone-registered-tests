   182	def table_markets(analysis: dict) -> str:
   183	    """Per-market paired changes, both sets, both churn rates, all three contrasts."""
   184	    lines = ["\\begin{tabular}{lll" + "r" * (len(MARKETS) + 1) + "}", "\\toprule",
   185	             " & ".join(["Winners", "$p$", "Contrast"] + list(MARKETS) + ["Mean"]) + " \\\\", "\\midrule"]
   186	    for s, lab in SETS:
   187	        for p in ("0.03", "0.05"):
   188	            for x, xl in X:
   189	                c = analysis[s]["paired_changes"][p][x]
   190	                lines.append(" & ".join([lab, p, xl] + [_f(c["markets"][m]) for m in MARKETS] + [_f(c["mean"])]) + " \\\\")
   191	    return "\n".join(lines + ["\\bottomrule", "\\end{tabular}", ""])
   192	
   193	
   194	def table_absolute(analysis: dict) -> str:
   195	    """Per-market absolute contrasts with their seed-bootstrap intervals (second line), and the pooled mean with its
   196	    pooled seed-bootstrap interval."""
   197	    lines = ["\\begin{tabular}{lll" + "r" * (len(MARKETS) + 1) + "}", "\\toprule",
   198	             " & ".join(["Winners", "$p$", "Contrast"] + list(MARKETS) + ["Pooled"]) + " \\\\", "\\midrule"]
   199	    for s, lab in SETS:
   200	        for p in RATES:
   201	            for x, xl in X:
   202	                c = analysis[s]["absolute"][p][x]
   203	                lines.append(" & ".join([lab, p, xl] + [_f(c["markets"][m]["estimate"]) for m in MARKETS] + [_f(c["mean"])]) + " \\\\")
   204	                lines.append(" & ".join(["", "", ""] + [f"{{\\scriptsize {_ci(c['markets'][m]['ci95'])}}}" for m in MARKETS]
   205	                                        + [f"{{\\scriptsize {_ci(c['pooled_ci95'])}}}"]) + " \\\\")
   206	    return "\n".join(lines + ["\\bottomrule", "\\end{tabular}", ""])
   207	
   208	
   209	def table_terms(analysis: dict) -> str:
   210	    """Equal-weight means over the six markets of each rule's normalised attacked profit, reference profit and gain, and
   211	    its gross efficiency under the selected attack (mean and lowest market)."""
   212	    lines = ["\\begin{tabular}{lllrrrrr}", "\\toprule",
   213	             "Winners & $p$ & Rule & Attack & Reference & Gain & Efficiency & Lowest \\\\", "\\midrule"]
   214	    for s, lab in SETS:
   215	        for p in RATES:
   216	            t = analysis[s]["terms"][p]
   217	            for r in RULES:
   218	                v = {k: [t[m][r][k] for m in MARKETS] for k in ("attack", "reference", "gain", "eff_attack")}
   219	                mean = lambda k: sum(v[k]) / len(v[k])
   220	                lines.append(" & ".join([lab, p, r.replace("C*", "C$^*$"), _f(mean("attack")), _f(mean("reference")), _f(mean("gain")),
   221	                                         _f(mean("eff_attack")), _f(min(v["eff_attack"]))]) + " \\\\")
   222	    return "\n".join(lines + ["\\bottomrule", "\\end{tabular}", ""])
   223	
   224	
   225	def table_alloc(summ: dict) -> str:
   226	    """R3's audit allocation per set and rate: equal-weight means over the markets with diagnostics, and the range of
   227	    the audited share of the attacker's jobs over those markets."""
   228	    lines = ["\\begin{tabular}{llrrrrrrr}", "\\toprule",
   229	             "Winners & $p$ & Markets & Young honest jobs & Young honest audits & Established honest rate & Attacker jobs & "
   230	             "Attacker rate & Attacker range \\\\", "\\midrule"]
   231	    for s, lab in SETS:
   232	        for p in RATES:
   233	            a, au = summ[s]["alloc"][p], summ[s]["audit"][p]
   234	            lines.append(" & ".join([lab, p, f"{a['markets']}/6"] + [_f(a[k]) for k in ALLOC]
   235	                                    + [f"{_f(au['focal_audit_min'])}--{_f(au['focal_audit_max'])}"]) + " \\\\")
   236	    return "\n".join(lines + ["\\bottomrule", "\\end{tabular}", ""])
   237	
   238	
   239	def _dump(d: dict) -> str:
   240	    return json.dumps(d, indent=1, sort_keys=True) + "\n"
