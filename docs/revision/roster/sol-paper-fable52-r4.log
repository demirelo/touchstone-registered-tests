\adjustbox{max width=\linewidth}{\input{tables/posthoc_q1_split.tex}}
\caption{Exploratory, after the report: the pooled Q1 difference split into the attacked-profit term and the reference-profit term, with the normalisation of the gain and equal market weights.}\label{tab:ph-q1}

\begin{table}[t]\centering\small
\adjustbox{max width=\linewidth}{\input{tables/q2_x7sc.tex}}
