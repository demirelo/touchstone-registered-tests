    14	    mk = lambda v: {f"rep{i}": v + 0.01 * i for i in range(6)}
    15	    pc = lambda mean: {"complete": True, "lower": 5, "markets": mk(mean), "mean": mean, "t95": [mean - 0.1, mean + 0.1]}
    16	    ab = lambda mean: {"complete": True, "markets": {}, "mean": mean, "pooled_ci95": [mean - 0.01, mean + 0.01],
    17	                       "t95": [mean - 0.2, mean + 0.2]}
    18	    terms = {p: {f"rep{i}": {r: {"attack": 0.3, "eff_attack": e, "gain": 0.1, "reference": 0.2}
    19	                             for r, e in (("R3", 0.95 - float(p)), ("C*", 0.99), ("C-thr", 0.98), ("B3", 0.97))}
    20	                 for i in range(6)} for p in ("0", "0.03", "0.05")}
    21	    s = {"paired_changes": {p: {x: pc(-0.1 if p == "0.05" else -0.05) for x in "dqu"} for p in ("0.03", "0.05")},
    22	         "absolute": {p: {x: ab(0.02 - float(p) * 4) for x in "dqu"} for p in ("0", "0.03", "0.05")},
    23	         "criteria": {p: {x: {"material": True, "support": True} for x in "dqu"} for p in ("0.03", "0.05")},
    24	         "expectations": {str(k): {"text": "t", "verdict": "met"} for k in range(1, 6)}, "terms": terms}
    25	    return {"primary": s, "frozen": json.loads(json.dumps(s)), "counts": {"continued": 3, "frozen": 69},
    26	            "gate_ok": True, "problems": [], "unscorable": [], "round1_mismatch": False, "confirmatory": True}
    27	
