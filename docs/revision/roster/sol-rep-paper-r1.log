HEADER = "% Generated by docs/revision/paper-v2/numbers_v2.py from report.json; do not edit.\n"
PREAMBLE = "\\providecommand{\\const}[1]{#1}\n\\providecommand{\\evone}[1]{#1}\n\\providecommand{\\rvk}[2]{\\rv{#2}}\n\\providecommand{\\site}[1]{\\ifcsname site@#1\\endcsname\\csname site@#1\\endcsname\\else\\textbf{??#1}\\fi}\n\\providecommand{\\rv}[1]{\\ifcsname rv@#1\\endcsname\\csname rv@#1\\endcsname\\else\\textbf{??#1}\\fi}\n"


def _fmt(v) -> str:
    if v is None:
        return "n/a"
    if isinstance(v, bool):
        return "yes" if v else "no"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        if not math.isfinite(v):
            raise ValueError(f"nonfinite value in the report: {v}")
        s = f"{v:.{DIGITS}f}"
        return f"\\ensuremath{{{s}}}" if s.startswith("-") else s
    return re.sub(r"([&%$#_{}])", r"\\\1", str(v))


def _fmt_p(v) -> str:
    """p-values: four significant digits; small values in scientific form, so a nonzero p never prints as 0.000."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return _fmt(v)
    if not math.isfinite(v):
        raise ValueError(f"nonfinite value in the report: {v}")
    s = f"{float(v):.4g}"
    if "e" in s:
        m, e = s.split("e")
        return f"\\ensuremath{{{m}\\times10^{{{int(e)}}}}}"
    return s


def flat(report, prefix: str = "") -> dict:
    """Report path to raw value."""
    out = {}
    items = report.items() if isinstance(report, dict) else enumerate(report)
    for k, v in items:
        path = f"{prefix}{k}"
        out.update(flat(v, path + ".")) if isinstance(v, (dict, list)) else out.__setitem__(path, v)
    return out


def _is_p(path: str) -> bool:
    parts = path.split(".")
    return parts[-1] in P_LEAVES or (len(parts) >= 2 and parts[-2] in P_LEAVES)


def macros(report: dict) -> dict:
    return {p: (_fmt_p(v) if _is_p(p) else _fmt(v)) for p, v in flat(report).items()}


def render(report: dict, sites: dict | None = None) -> str:
    m = macros(report)
    # With a site manifest the text uses only \\site{}, so only site macros are written (the full path list ran to
    # 219k lines and overflowed pdfLaTeX's string pool, 2026-11-05).
    lines = [] if sites is not None else [f"\\expandafter\\def\\csname rv@{p}\\endcsname{{{v}}}" for p, v in sorted(m.items())]
    lines += [f"\\expandafter\\def\\csname site@{n}\\endcsname{{{m.get(d['path'], '??' + n)}}}" for n, d in sorted((sites or {}).items())]
    return HEADER + PREAMBLE + "\n".join(lines) + "\n"


def _sites(path) -> dict | None:
    """The result-site manifest: site name -> {path, kind, section}; read from beside the given file when present."""
    f = Path(path).parent / "sites.json"
    return json.loads(f.read_text()) if f.exists() else None


def load(report_path, extra: dict | None = None) -> dict:
    """report.json at the top level; each extra source (name -> path: cells.json, scoring.json) under its own name."""
    data = json.loads(Path(report_path).read_text())
    for name, path in (extra or {}).items():
        if name in data:
            raise ValueError(f"extra source name {name} collides with a report key")
        data[name] = json.loads(Path(path).read_text())
    return data


def write(report_path, numbers_path, extra: dict | None = None) -> None:
    Path(numbers_path).write_text(render(load(report_path, extra), _sites(numbers_path)))


def _blocks(tex: str) -> tuple[list[str], list[str]]:
    blocks, problems, cur = [], [], None
    for n, line in enumerate(tex.splitlines(), 1):
        s = line.strip()
        if s == "% BEGIN-EV2":
            if cur is not None:
                problems.append(f"line {n}: nested BEGIN-EV2")
            cur = []
        elif s == "% END-EV2":
            if cur is None:
                problems.append(f"line {n}: END-EV2 without BEGIN-EV2")
            else:
                blocks.append("\n".join(cur)); cur = None
        elif cur is not None and not s.startswith("%"):
            cur.append(line)
    if cur is not None:
        problems.append("unclosed BEGIN-EV2 block")
    return blocks, problems


def strip_comments(text: str) -> str:
    """Remove LaTeX comments (a % after an even number of backslashes), keeping the region marker lines."""
    out = []
    for line in text.splitlines():

def run_diagnostics(base: Path, jobs_by_dir: dict, workers: int, smoke: bool = False) -> dict:
    """The diagnostics of R3's continued winners (menu cells at p = 0 and 0.05 whose continuation passed or reached the
    cap) in Run B's pool; records under continuation/diagnostics/, reused on resume when bound to the same job."""
    import convergence_v2  # noqa: F401
    import revision_v2 as R
    cdir = Path(base) / "continuation"; todo, args, dests, extras = [], [], [], []
    for (kind, p), jobs in jobs_by_dir.items():
        if kind != "menu" or p not in (0.0, 0.05):
            continue
        for j in jobs:
            if j["rule"] != "F111":
                continue
            key = _key(kind, p, j["id"]); crec = _d(read_record(cdir / (R._safe(key) + ".json")))
            d = Path(base) / f"{kind}-p{p:g}"
            if crec is None or cont_problem(crec, key, j, smoke, doubling=doubling_of(d, j["id"]), search=search_of(d, j["id"])) is not None or crec["status"] not in STATUSES[:2]:
                continue
            dest = cdir / "diagnostics" / (R._safe(key) + ".json"); old = _d(read_record(dest))
            if cont_diag_ok(old, key, j, crec["heldout"]["knobs"]):
                continue
            _set_aside(cdir / "diagnostics", dest)              # a stale or foreign record is rerun, never reused
            todo.append({"id": key}); args.append((j, crec["heldout"]["knobs"])); dests.append(dest); extras.append({"id": key})
    lost, failed = ([], {}) if not todo else run_cells(_diag_cont, todo, args, workers, dests, extras)
    if lost and not failed:                                     # the launcher's restart reads this estimate (exit 5)
        _lost(cdir, lost, {k: DIAG_HOURS for k in lost}, 1)
    return {"run": len(todo), "lost": lost, "failed": failed, "exit": 6 if failed else 5 if lost else 0}
"""Draft 10 churn float data (outline-draft10.md, sections 4 and 5): the C* - R3 and B3 - R3 curves against the churn
rate (figure) and the audit allocation per rate (table), from churn.json (p = 0, 0.01, 0.05) and churn_mid.json
(p = 0.02, 0.03). Exploratory, after the report; descriptive. --write regenerates, --check refuses stale outputs.
Usage: churn_paper.py --first churn.json --mid churn_mid.json --figdir <dir> --tabdir <dir> [--summary churn_paper.json --runnerup runnerup_analysis.json] (--write | --check)"""
import argparse
import json
import sys
from pathlib import Path

RULES = (("F111", "R3"), ("C*", "C$^*$"), ("F000", "B3"))
VERS = ("base", "doubled")


def _stats(first: dict, mid: dict, ver: str) -> dict:
    s = dict(first["statistics"][ver]); s.update({k: v for k, v in mid["statistics"][ver].items() if k != "0"})
    return s


def _r4(first: dict, mid: dict, key: str) -> dict:
    out = {}
    for src in (first, mid):
        for k, v in src["review_r4"][key].items():
            if isinstance(v, dict):
                out.setdefault(k, {}).update(v)
    return out


def data(first: dict, mid: dict) -> dict:
    rates = sorted({float(k) for v in VERS for k in _stats(first, mid, v)})
    curves = {}
    for ver in VERS:
        s = _stats(first, mid, ver)
        curves[ver] = {c: [{"p": p, "estimate": s[_key(p)][c]["pooled"]["estimate"], "lo": s[_key(p)][c]["pooled"]["ci95"][0],
                            "hi": s[_key(p)][c]["pooled"]["ci95"][1]} for p in rates] for c in ("d", "q")}
    alloc, eff = _r4(first, mid, "audit_allocation"), _r4(first, mid, "eff_attack")
    rows = []
    for p in [r for r in rates if r > 0]:
        for rule, name in RULES:
            a, ad = alloc[_key(p)][f"{rule}|base"], alloc[_key(p)][f"{rule}|doubled"]
            rows.append({"p": p, "rule": name, "focal_audit_rate": a["focal_audit_rate"], "focal_audit_rate_doubled": ad["focal_audit_rate"],
                         "x_off_doubled": sum(1 for x in ad["x_by_market"].values() if x == 0), "eff_doubled": eff["doubled"][_key(p)][rule],
                         "young_honest_job_share": a["young_honest_job_share"], "young_honest_job_share_doubled": ad["young_honest_job_share"],
                         "young_honest_audit_share": a["young_honest_audit_share"], "young_honest_audit_share_doubled": ad["young_honest_audit_share"],
                         "established_honest_audit_rate": a["established_honest_audit_rate"],
                         "established_honest_audit_rate_doubled": ad["established_honest_audit_rate"],
                         "x_off": sum(1 for x in a["x_by_market"].values() if x == 0), "markets": a["markets"],
                         "eff_attack": eff["base"][_key(p)][rule]})
    return {"label": "exploratory, after the report; frozen searches unless stated", "rates": rates, "curves": curves, "allocation": rows}


def summary(first: dict, mid: dict, runnerup: dict | None = None) -> dict:
    """Aggregates that the paper cites and the records hold only per cell: the doubling flags' largest attack change,
    the reselection diagnostic (reference_change), and per rate and rule the audit allocation, the selected attacks
    without replacement (x_off) and the gross efficiency under attack (frozen searches)."""
    cells = {**first["flags"], **mid["flags"]}
    top = max(cells, key=lambda k: cells[k]["attack_change"])
    alloc, eff = _r4(first, mid, "audit_allocation"), _r4(first, mid, "eff_attack")
    rates = {}
    for p, rows in alloc.items():
        rates[p] = {}
        for rule, name in RULES:
            a = rows[f"{rule}|base"]
            rates[p][name.replace("$^*$", "*")] = {
                "focal_audit_rate": a["focal_audit_rate"], "young_honest_job_share": a["young_honest_job_share"],
                "young_honest_audit_share": a["young_honest_audit_share"], "established_honest_audit_rate": a["established_honest_audit_rate"],
                "x_off": sum(1 for x in a["x_by_market"].values() if x == 0), "markets": a["markets"], "eff": eff["base"][p][rule]}
            ad = rows.get(f"{rule}|doubled")
            if ad:   # Fable round 5, problem 4 and 5: the doubled winners beside the frozen ones
                rates[p][name.replace("$^*$", "*")].update(focal_audit_rate_doubled=ad["focal_audit_rate"],
                    x_off_doubled=sum(1 for x in ad["x_by_market"].values() if x == 0), eff_doubled=eff["doubled"][p][rule])
    r5 = first.get("review_r5", {})
    r3 = {}
    if r5:   # Fable round 5, problems 5 and 8: R3 at p = 0.05 per market (frozen searches)
        fa = r5["focal_audit_rate_by_market"]["0.05"]["F111|base"]; xs = alloc["0.05"]["F111|base"]["x_by_market"]
