    29	def _extract():
    30	    au = {"0": {f"rep{i}": [80, 100] for i in range(6)}, "0.05": {f"rep{i}": [2 + i, 100] for i in range(6)},
    31	          "0.03": {"rep0": [5, 100]}}
    32	    return {"audit": {"primary": au, "frozen": au}, "counts": {"continued": 3, "frozen": 69},
    33	            "continued": [{"kind": "menu", "rate": "0", "market": "rep2", "policy": "F111", "stem": "a"},
    34	                          {"kind": "menu", "rate": "0.05", "market": "rep1", "policy": "Cstar", "stem": "b"},
