    28	def pin_settings() -> None:
    29	    """The locked search settings and the manifest are those of protocol-v2, with no TOUCHSTONE_LOCKED override."""
    30	    if os.environ.get("TOUCHSTONE_LOCKED"):
    31	        _refuse("TOUCHSTONE_LOCKED is set; the locked settings must be the registered file")
    32	    r = subprocess.run(["git", "diff", "--quiet", "protocol-v2", "--", *PINNED], cwd=ROOT)
    33	    if r.returncode != 0:
    34	        _refuse(f"{PINNED} differ from protocol-v2 (or the tag is missing)")
