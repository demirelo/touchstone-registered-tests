   160	def check_run_evidence(paths, smoke: bool, gate: bool, cells: dict) -> None:
   161	    """A full run needs, for each gate cell, a passing full-budget gate record from the Mac and one from this machine,
   162	    bound to the cell's current inputs and this driver."""
   163	    if smoke or gate:
   164	        return
   165	    if not paths:
   166	        _refuse("no reproduction evidence given for a full run")
   167	    G.check_gate_evidence(paths, cells)
