    76	def inventory(out, deviations, files: dict, args) -> dict:
    77	    """Every output file with its hash; this run's deviations; hashes of this driver, the shared modules, the imported
    78	    helpers, the plan and the report; the run arguments and the environment."""
    79	    out = Path(out)
    80	    fixed = {"common.py": HERE / "common.py", "guards.py": HERE / "guards.py", "reset_followup_v2.py": HERE.parent / "followup" / "reset_followup_v2.py",
    81	             "revision_v2.py": ROOT / "scripts" / "revision_v2.py"}
    82	    hashes = {k: sha_file(Path(p)) for k, p in {**fixed, **files}.items() if Path(p).exists()}
    83	    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
    84	            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
    85	    inv = {"stage": "inventory", "deviations": list(deviations), "files": hashes, "args": list(args), "environment": environment(), "records": recs}
    86	    write(out / "inventory.json", inv)
    87	    return inv
