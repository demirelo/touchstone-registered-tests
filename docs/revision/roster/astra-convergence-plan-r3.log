   170	def merge_inputs(needs: list[dict]) -> dict:
   171	    merged = {}
   172	    for n in needs:
   173	        for k, v in n.items():
   174	            if merged.setdefault(k, v) != v:
   175	                _refuse(f"{k}: two cells list different hashes")
