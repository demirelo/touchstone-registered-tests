    37	def check_budget(job: dict, frozen_record) -> None:
    38	    rec = read(frozen_record)
    39	    if rec is None or list(rec["provenance"]["budget"]) != list(job["budget"]):
    40	        _refuse(f"{job['id']}: search budget {job['budget']} is not the frozen record's {None if rec is None else rec['provenance']['budget']}")
    41	
    42	
    43	def binding(inputs_sha: str, provenance: dict, smoke: bool, settings: dict, driver_sha: str) -> dict:
    44	    b = {"inputs_sha": inputs_sha, "provenance": provenance, "smoke": bool(smoke), "settings": settings, "driver_sha": driver_sha}
    45	    return json.loads(json.dumps(b, default=float))              # the form it has when read back (tuples become lists)
    46	
    47	
    48	def reusable(path, b: dict) -> bool:
    49	    """False if nothing is saved; True if the saved result has this exact binding; refused otherwise (never overwritten)."""
    50	    rec = read(path)
    51	    if rec is None:
    52	        return False
    53	    if rec.get("binding") != b:
    54	        _refuse(f"{path}: a saved result with another binding exists")
    55	    return True
