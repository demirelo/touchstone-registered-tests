   234	
   235	def _cell_gains(src, conv, rid: str, expected: dict):
   236	    f = read(R.eval_path(src, rid))
   237	    if rid not in expected:
   238	        return f["gain"], f["gain"], False
   239	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   240	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   241	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   242	    g = c["heldout"]["gain"]
   243	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   244	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   245	    return f["gain"], g, True
