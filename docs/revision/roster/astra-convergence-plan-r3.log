def market(label: str, root: str, rho: float = 0.2, dev: bool = False, smoke: bool = False, cfg=None, commit: str | None = None,
           salt_sha256: str | None = None) -> dict:
    """`cfg`, `commit`, and `salt_sha256` come from recorded inputs when given (the verify stage), so no calibration
    episode, git process, or salt read happens."""
    cfg = cfg if cfg is not None else _market_cfg(label, root, float(rho))
    train, val = list(range(1000, 1005)), list(range(2000, 2020))
    ev = val if dev else INST.eval_seeds(root, label)
    if smoke:
        train, ev = train[: SMOKE[2]], ev[: SMOKE[3]]
    out = {"label": label, "root": root, "rho": float(rho), "dev": bool(dev), "smoke": bool(smoke), "cfg": cfg, "focal": int(positions(cfg)["median"]),
           "seeds_train": train, "seeds_val": val, "seeds_eval": list(ev), "context": MAN.context(label, float(rho))}
    if commit is not None:
        out["commit"] = str(commit)
    if salt_sha256 is not None:
        out["salt_sha256"] = str(salt_sha256)
    return out


def manifest_ctx(ctx: str) -> str:
    """Development contexts run the fresh0 template of the manifest."""
    label, rest = ctx.split("@", 1)
    return f"fresh0@{rest}" if label.startswith("dev") else ctx


def rule_spec(rule: str, params: dict | None) -> dict:
    p = params or {}
    if rule in FIXED:
        spec = {"tol": 0.16, "L": 10}
    elif rule == "B2":
        b2 = registered_b2_params(); spec = {"tol": float(b2["tol"]), "L": int(b2["L"]), "b2": b2}
    else:
        t = (p.get("tuned") or {}).get(rule)
        if t is None:
            raise SystemExit(f"{rule}: no tuned parameters in --params")
        spec = {"tol": float(t["tol"]), "L": int(t["L"])}
    if rule.startswith("C*"):
        if not p.get("cred"):
            raise SystemExit(f"{rule}: no comparator (cred) in --params")
        spec["cred"] = dict(p["cred"])
    return spec


def rule_factory(job: dict):
    s = job["spec"]
    return lambda: make_rule(job["rule"], s["tol"], s["L"], cred=s.get("cred"), b2_params=s.get("b2"))


def constants(job: dict) -> tuple[int, int]:
    rule = rule_factory(job)()
    pc = public_constants(rule, job["mkt"]["cfg"])
    return pc["T"], pc["L"]


@lru_cache(maxsize=8)
def _h4(path: str, sha: str):
    return load_h4(Path(path), sha)


def family_for(name: str, T: int, L: int, h4: dict | None = None) -> Family:
    if name == "H4":
        src = _h4(h4["dir"], h4["sha"]) if h4 else Excluded("no bundle")
        if isinstance(src, Excluded):
            raise SystemExit(f"H4 excluded: {src.reason}")
        return FV2.family_for(name, T, L, src)
    return FV2.family_for(name, T, L)


def cell_id(ctx: str, rule: str, family: str, objective: str, c=None, schedule=None) -> str:
    return f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")


@lru_cache(maxsize=1)
def _cells_by_id() -> dict:
    return {c["id"]: c for c in MAN.cells()}


def job(mkt: dict, rule: str, family: str, objective: str = "profit", c: int | None = None, schedule: str | None = None,
        smoke: bool = False, params: dict | None = None, h4: dict | None = None, block: str | None = None) -> dict:
    lk = load_locked(); s = lk["search"]
    R, E, n_train, n_eval = SMOKE if (smoke or mkt["smoke"]) else (int(s["restarts"]), int(s["evals_per_restart"]), len(mkt["seeds_train"]), len(mkt["seeds_eval"]))
    if family in ("X7-SC", "H4"):                   # H4 is priced and searched as an X7-SC cell (design draft 7, 5.3)
        E *= 2
    spec = rule_spec(rule, params)
    j = {"id": cell_id(mkt["context"], rule, family, objective, c, schedule), "context": mkt["context"], "rule": rule, "family": family,
         "objective": objective, "c": c, "schedule": schedule, "budget": [R, E, n_train, n_eval], "spec": spec, "mkt": mkt,
         "h4": h4 if family == "H4" else None}
    cell = _cells_by_id().get(j["id"].replace(j["context"], manifest_ctx(j["context"]), 1))
    j["block"] = block or (cell or {}).get("block"); j["priority"] = MAN.priority(cell) if cell else 3      # execution priority (design 8.2)
    j["provenance"] = context_provenance(mkt) | {"budget": j["budget"], "rule_params_sha256": _sha_json(spec), "id": j["id"]}
    if family == "H4" and h4:
        j["provenance"]["h4_sha256"] = str(h4["sha"])
    return j


def context_provenance(mkt: dict) -> dict:
    return {"git_commit": mkt.get("commit") or git_commit(), "runner_sha256": _sha(Path(__file__).read_bytes()), "cfg_sha256": _sha_json(cfg_to_dict(mkt["cfg"])),
            "salt_sha256": mkt.get("salt_sha256") or _sha(load_identity_salt()), "root": mkt["root"], "seeds_train": mkt["seeds_train"],
            "seeds_val": mkt["seeds_val"], "seeds_eval": mkt["seeds_eval"], "context": mkt["context"]}


def settings(job: dict) -> SearchSettings:
    R, E, _, _ = job["budget"]
    return replace(settings_from_locked(load_locked()), restarts=int(R), evals_per_restart=int(E))


def train_cell(job: dict, others: tuple = ()) -> Cell:
    m = job["mkt"]
    return Cell(cfg=m["cfg"], rule_factory=rule_factory(job), focal=m["focal"], seeds=tuple(m["seeds_train"]), name=job["id"], others=others)


def eval_cell(job: dict) -> Cell:
    return replace(train_cell(job), seeds=tuple(job["mkt"]["seeds_eval"]))


# ---- record paths ------------------------------------------------------------------------------------------------------

def _safe(s: str) -> str:
    return s.replace("|", "__").replace("/", "~").replace("*", "star")


def path_of(out: Path, rid: str) -> Path:
    if rid.startswith("freeze/"):
        return Path(out) / "freeze" / (rid.split("/", 1)[1] + ".json")
    if "|" in rid:
        objective = rid.split("|")[3]
        return Path(out) / ("dependent" if objective in ("W1", "total", "min") else "search") / (_safe(rid) + ".json")
    kind, ctx, rest = rid.split("/", 2)
    return Path(out) / kind / ctx / (_safe(rest) + ".json")


def eval_path(out: Path, rid: str) -> Path:
    return Path(out) / "evaluate" / (_safe(rid) + ".json")


# ---- search adapters ---------------------------------------------------------------------------------------------------

def search_family(cell: Cell, family: Family, cache: SeedCache, st: SearchSettings, twin, extra_incumbents: dict | None = None):
    inc = {"twin_best": twin.best_knobs, "honest_point": family.honest_point(), **(extra_incumbents or {})}
    return cma_search(Objective(cell, family, cache), family, st, 1, incumbents=inc)


BOUNDED_CONTROLS = ("X7-SC", "H4")                # design draft 7, 5.2 and 5.3: Sobol corner controls, never every corner


def controls(objective, family: Family) -> list:
    if family.name in BOUNDED_CONTROLS:
        vecs = corner_vectors(family)
    else:
        if family.dim > 8:
            raise AssertionError(f"{family.name}: {family.dim} knobs is too many for exhaustive corners")
        vecs = family.corners()
    return [(k, float(objective.eval_knobs(k, source="corner"))) for k in vecs]


def continue_search(objective, family: Family, st: SearchSettings, original, seed: int = 1):
    """Doubling (design 6.5): as many new restarts as registered, with restart seeds after the registered ones, on the
    merged archive (old entries kept), the previous best as an incumbent."""
    objective.archive.update(original.archive)
    return cma_search(objective, family, st, int(seed) + int(st.restarts), incumbents={"previous_best": dict(original.best_knobs)})


# ---- stages ------------------------------------------------------------------------------------------------------------

def _menu_id(ctx, rule, fam):
    return cell_id(ctx, rule, fam, "profit")

    if best_ctrl is not None and best_ctrl[1] > at.best_f:
        rec["attack"]["best_knobs"], rec["attack"]["best_f"], rec["attack"]["best_source"] = dict(best_ctrl[0]), float(best_ctrl[1]), "control"
    return rec


def cand_to_json(c: Candidate, family: str | None, T: int, L: int) -> dict:
    return {"name": c.name, "family": family, "T": T, "L": L, "knobs": c.knobs}


def cand_from_json(d: dict, h4: dict | None = None) -> Candidate:
    if d.get("family") == "H4":
        return FV2.cand_from_json(d, _h4(h4["dir"], h4["sha"]))
    return FV2.cand_from_json(d)


def menu(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> tuple[list, list, dict]:
    """The reference menu of the job's rule in its context (design 6.4): candidates, their family names, upstream hashes."""
    ctx, rule = job["context"], job["rule"]; T, L = constants(job); cell = train_cell(job)
    groups: dict[tuple, list] = {}; upstream = {}; fnames = MAN.menu_families(manifest_ctx(ctx), rule)
    for fname in fnames:
        rid = _menu_id(ctx, rule, fname); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"reference {ctx}/{rule}: needs {rid}")
        upstream[rid] = sha_file(path_of(out, rid))
        fam = family_for(fname, T, L)
        bank = []
        if rule in FIXED:
            for other in MAN.bank_rules(manifest_ctx(ctx), fname, cuts, h4_excluded):
                if other == rule:
                    continue
                orid = _menu_id(ctx, other, fname); orec = read(path_of(out, orid))
                if orec is None:
                    raise SystemExit(f"reference {ctx}/{rule}: needs bank source {orid}")
                upstream[orid] = sha_file(path_of(out, orid)); bank.append(fam.project(orec["attack"]["best_knobs"]))
        lk = load_locked()
        cands = reference_candidates(cell, fam, search_from_json(rec["attack"]), search_from_json(rec["twin"]), bank, tuple(lk["reference_order"]))
        for c in cands:
            cat = "bank" if c.name.startswith("bank_") else c.name
            groups.setdefault((cat, fname), []).append(c)
    out_c, fams = merge_menu(groups, fnames)
    return out_c, fams, upstream


def merge_menu(groups: dict, family_order) -> tuple[list, list]:
    """Candidates in the registered category order, families in the given order within a category, de-duplicated by
    (family, exact key); abstain and honest-max once."""
    out_c, fams, seen = [], [], set()
    for cat in CATEGORIES:
        for fname in family_order:
            for c in groups.get((cat, fname), []):
                key = ("name", c.name) if c.knobs is None else (fname, exact_key(c.knobs))
                if key in seen:
                    continue
                seen.add(key); out_c.append(c); fams.append(None if c.knobs is None else fname)
    return out_c, fams


def stage_reference(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cands, fams, upstream = menu(job, out, cuts, h4_excluded)
    choice = select_reference(train_cell(job), cands, SeedCache())
    idx = next(i for i, c in enumerate(cands) if c is choice.candidate)
    return {"candidates": [cand_to_json(c, f, T, L) for c, f in zip(cands, fams)], "choice": idx, "scores": choice.scores,
            "per_seed_normalized": [float(v) for v in choice.per_seed_normalized], "upstream": upstream, "T": T, "L": L,
            "menu_families": list(MAN.menu_families(manifest_ctx(job["context"]), job["rule"]))}


def reference_provenance(job: dict) -> dict:
    return aux_provenance(job["mkt"], rule=job["rule"], rule_params_sha256=_sha_json(job["spec"]))


def reference_of(job: dict, out: Path) -> tuple[Candidate, dict, Path]:
    p = path_of(out, f"reference/{job['context']}/{job['rule']}"); rec = read(p)
    if rec is None:
        raise SystemExit(f"{job['id']}: needs the rule's reference")
    return cand_from_json(rec["candidates"][rec["choice"]]), rec, p


def _coalition_tag(job):
    """The coalition group of a cell (design draft 7, 6.3): one per context, rule, and c; X6-SE/v2 schedules and X8-DB share it."""
    return f"{job['rule']}_c{job['c']}"



# ---- doubling ----------------------------------------------------------------------------------------------------------

def doubling_report(kind: str, old: dict, new: dict) -> dict:
    """Changes in the objective's units (design 6.5): profit (attack and reference normalised profit), welfare (gross
    efficiency, lower is a better attack), w1 (efficiency and feasibility), coalition (objective)."""
    rep = {"kind": kind}
    if kind == "profit":
        rep["attack_change"] = float(new["attack_f"] - old["attack_f"]); rep["reference_change"] = float(new["ref_f"] - old["ref_f"])
        changes = [rep["attack_change"], rep["reference_change"]]
    elif kind in ("welfare", "w1"):
        rep["efficiency_change"] = float(old["eff"] - new["eff"]) if old.get("eff") is not None and new.get("eff") is not None else 0.0
        changes = [rep["efficiency_change"]]
        if kind == "w1":
            rep["feasibility_transition"] = bool(old.get("feasible") is False and new.get("feasible") is True)
    elif kind == "coalition":
        rep["objective_change"] = float(new["f"] - old["f"]); changes = [rep["objective_change"]]
    else:
        raise ValueError(kind)
    rep["incomplete"] = bool(any(c >= THRESHOLD - 1e-12 for c in changes) or rep.get("feasibility_transition", False))
    return rep


def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
        _, rrec, _ = reference_of(job, out)
        cands, fams, _ = menu(job, out, cuts, h4_excluded)
        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
    if job["objective"] in ("W0", "W1"):
        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
        continue_search(obj, fam, st, orig)
    trace: list
    incumbent_scores: dict
    projection_f: float
    replaced_by_projection: bool
    archive: dict = field(default_factory=dict)
    evaluations: list = field(default_factory=list)      # amendment 2: the objective's ordered evaluation log


def cma_search(objective, family: Family, settings: SearchSettings, seed: int,
               incumbents: dict[str, dict] | None = None, starts: list | None = None) -> SearchResult:
    """CMA-ES maximization with registered restarts and a fixed evaluation budget
    per restart (incumbent re-evaluations count). Registered incumbents and the
    projection of the best point are evaluated exactly, outside the budget."""
    if starts is None:
        starts = family.registered_starts({"near_corner": settings.near_corner, "sobol_seed": settings.sobol_seed})
    best_x, best_knobs, best_f, best_source = None, None, -np.inf, ""
    restart_bests, trace, evals = [], [], 0
    for r in range(settings.restarts):
        x0 = starts[r % len(starts)]
        es = cma.CMAEvolutionStrategy(x0, settings.sigma0,
                                      {"popsize": settings.popsize, "seed": int(seed) + 1 + r, "verbose": -9, "verb_log": 0})
        used, it = 0, 0
        r_best_x, r_best_f = x0.copy(), objective(x0)
        used += 1; evals += 1
        while used < settings.evals_per_restart:
            X = es.ask()
            n = min(len(X), settings.evals_per_restart - used)
            X = X[:n]
            F = [objective(np.asarray(x)) for x in X]
            used += n; evals += n
            if n == settings.popsize:
                es.tell(X, [-f for f in F])
            for x, f in zip(X, F):
                if f > r_best_f:
                    r_best_x, r_best_f = np.asarray(x).copy(), f
            it += 1
            if it % settings.reeval_every == 0 and used < settings.evals_per_restart:
                f_re = objective(r_best_x)
                used += 1; evals += 1
                r_best_f = min(r_best_f, f_re)   # a deterministic objective returns the same value
            trace.append((evals, r_best_f))
        restart_bests.append(r_best_f)
        if r_best_f > best_f:
            best_x, best_knobs, best_f, best_source = r_best_x.copy(), objective.knobs_of(r_best_x), r_best_f, f"restart_{r}"
    incumbent_scores: dict[str, float] = {}
    for name, k in (incumbents or {}).items():
        f = objective.eval_knobs(k, source=f"incumbent:{name}")
        incumbent_scores[name] = float(f)
        if f > best_f:
            best_x, best_knobs, best_f, best_source = family.inverse(k, settings.near_corner), dict(k), float(f), f"incumbent:{name}"
    proj = family.project(best_knobs)
    projection_f = float(objective.eval_knobs(proj, source="projection"))
    replaced = projection_f > best_f
    if replaced:
        best_x, best_knobs, best_f, best_source = family.inverse(proj, settings.near_corner), proj, projection_f, "projection"
    return SearchResult(best_x=best_x, best_knobs=best_knobs, best_f=float(best_f), best_source=best_source,
                        restart_bests=restart_bests, evals=evals, trace=trace, incumbent_scores=incumbent_scores,
                        projection_f=projection_f, replaced_by_projection=replaced, archive=objective.archive, evaluations=list(getattr(objective, "log", [])))


def corner_controls(objective, family: Family) -> list[tuple[dict, float]]:
    """Exact corners (knobs at 0 or 1), one evaluation each, outside the search budget (spec 5.3)."""
from __future__ import annotations

from dataclasses import dataclass
from typing import Callable

import numpy as np

from .cell import Abstain, Cell, SeedCache, run_focal
from .metrics import harm
from .policies.families import Family, exact_key
from .policies.honest import HonestMax
from .search import Objective, SearchResult, SearchSettings, best_archived, cma_search

REFERENCE_ORDER = ("abstain", "honest_max", "twin_search", "attack_projection", "archive_clip1", "archive_truthful_clip0", "bank")


@dataclass(frozen=True)
class Candidate:
    name: str
    policy_factory: Callable
    knobs: dict | None
    known_profit: np.ndarray | None = None
    known_normalized: np.ndarray | None = None


@dataclass
class ReferenceChoice:
    candidate: Candidate
    per_seed_profit: np.ndarray
    per_seed_normalized: np.ndarray
    scores: dict


def twin_search(cell: Cell, family: Family, cache: SeedCache, settings: SearchSettings, seed: int) -> SearchResult:
    starts = family.registered_starts({"near_corner": settings.near_corner, "sobol_seed": settings.sobol_seed}, twin=True)
    return cma_search(Objective(cell, family, cache, force_clip=True), family, settings, seed, starts=starts)


def attack_search(cell: Cell, family: Family, cache: SeedCache, settings: SearchSettings, seed: int, twin: SearchResult) -> SearchResult:
    """Attack search with the twin best and the honest-max point as registered incumbents (spec 5.2)."""
    return cma_search(Objective(cell, family, cache), family, settings, seed,
                      incumbents={"twin_best": twin.best_knobs, "honest_point": family.honest_point()})


def _factory(family: Family, knobs: dict) -> Callable:
    return lambda: family.make(knobs)


def _known(entry) -> dict:
    return {} if entry is None else {"known_profit": entry.per_seed_profit, "known_normalized": entry.per_seed_normalized}


def reference_candidates(cell: Cell, family: Family, attack: SearchResult, twin: SearchResult,
                         bank_members: list[dict], order=REFERENCE_ORDER) -> list[Candidate]:
    """Every reference candidate in projected form, in registered tie order (spec 5.2); de-duplicated by exact key."""
    n = len(cell.seeds)
    groups: dict[str, list[Candidate]] = {}
    groups["abstain"] = [Candidate("abstain", Abstain, None, np.zeros(n), np.zeros(n))]
    groups["honest_max"] = [Candidate("honest_max", HonestMax, None)]
    tw = family.project(twin.best_knobs)
    groups["twin_search"] = [Candidate("twin_search", _factory(family, tw), tw, **_known(twin.archive.get(exact_key(tw))))]
    proj = family.project(attack.best_knobs)
    groups["attack_projection"] = [Candidate("attack_projection", _factory(family, proj), proj, **_known(attack.archive.get(exact_key(proj))))]
    e1 = best_archived(attack.archive, clip=1)
    groups["archive_clip1"] = [] if e1 is None else [Candidate("archive_clip1", _factory(family, e1.knobs), dict(e1.knobs), **_known(e1))]
    e0 = best_archived(attack.archive, clip=0, truthful_only=True)
    if e0 is None:
        groups["archive_truthful_clip0"] = []
    else:   # never inflated on dev-train: its projection has the same trajectory, so its observed values are its projected values
        p0 = family.project(e0.knobs)
        groups["archive_truthful_clip0"] = [Candidate("archive_truthful_clip0", _factory(family, p0), p0, **_known(e0))]
    groups["bank"] = [Candidate(f"bank_{i}", _factory(family, family.project(m)), family.project(m)) for i, m in enumerate(bank_members)]
    out, seen = [], set()
    for g in order:
        for c in groups.get(g, []):
            key = exact_key(c.knobs) if c.knobs is not None else ("name", c.name)
            if key in seen:
                continue
            seen.add(key); out.append(c)
    return out


def select_reference(cell: Cell, candidates: list[Candidate], cache: SeedCache) -> ReferenceChoice:
    """Highest mean normalized profit on the cell's seeds; ties to the earlier candidate; known values need no run."""
    best, scores = None, {}
    for c in candidates:
        if c.known_normalized is not None and len(c.known_normalized) == len(cell.seeds):
            profit, norm = c.known_profit, c.known_normalized
        else:
            fr = run_focal(cell, c.policy_factory, cache)
            profit, norm = fr.profit, fr.normalized
        score = float(norm.mean())
        scores[c.name] = score
        if best is None or score > best[0]:
            best = (score, c, profit, norm)
    _, c, profit, norm = best
    return ReferenceChoice(candidate=c, per_seed_profit=np.asarray(profit, dtype=float), per_seed_normalized=np.asarray(norm, dtype=float), scores=scores)


