"""Tests for replication_extract.py: the allocation, the cell parser, the extract builder and the committed binding."""
import hashlib
import json
from pathlib import Path

import pytest

import replication_extract as RE

HERE = Path(__file__).resolve().parent


def _shares():
    # two episodes, two age bins; [served, audited]
    e = {"honest_replacement": [[10, 4], [20, 1]], "honest_initial": [[5, 1], [15, 3]], "focal": [[4, 2], [6, 0]]}
    return {"per_episode": [e, e]}


def test_allocation_matches_hand_count():
    a = RE.allocation(_shares())
    served, audits = 2 * (10 + 20 + 5 + 15 + 4 + 6), 2 * (4 + 1 + 1 + 3 + 2 + 0)
    assert a["young_honest_job_share"] == pytest.approx(2 * 15 / served)
    assert a["young_honest_audit_share"] == pytest.approx(2 * 5 / audits)
    assert a["established_honest_audit_rate"] == pytest.approx(4 / 35)
    assert a["focal_job_share"] == pytest.approx(20 / served)
    assert a["focal_audit_rate"] == pytest.approx(4 / 20)


def test_allocation_zero_denominator_is_none():
    e = {"honest_replacement": [[0, 0], [0, 0]], "honest_initial": [[0, 0], [0, 0]], "focal": [[0, 0], [0, 0]]}
    a = RE.allocation({"per_episode": [e]})
    assert all(v is None for v in a.values())


def test_parse_cell_accepts_the_run_shapes():
    assert RE.parse_cell("menu-p0.05__fresh3@rho0.2__F111__D2+H3__profit__churn0.05") == \
        {"kind": "menu", "rate": "0.05", "market": "rep3", "policy": "F111"}
    assert RE.parse_cell("cthr-p0__fresh0@rho0.2__Cstar__D2+H3__profit")["rate"] == "0"


@pytest.mark.parametrize("stem", ["menu-p0.05__fresh3@rho0.2__F111__D2+H3__profit__churn0.03",   # suffix disagrees
                                  "menu-p0__fresh3@rho0.2__F111__D2+H3__profit__churn0.05",      # churn at p = 0
                                  "menu-p0.05__fresh3@rho0.2__F111__D2+H3__profit",              # suffix missing
                                  "menu-p0.05__fresh6@rho0.2__F111__D2+H3__profit__churn0.05",   # no such market
                                  "menu-p0.05__fresh3@rho0.2__F222__D2+H3__profit__churn0.05",   # no such policy
                                  "menu-p0.02__fresh3@rho0.2__F111__D2+H3__profit__churn0.02"])  # no such rate
def test_parse_cell_refuses_other_shapes(stem):
    with pytest.raises(ValueError):
        RE.parse_cell(stem)


def _col(continued=2):
    c0, c1 = RE.Counts((5, 10)), RE.Counts((1, 10))
    c0.alloc, c1.alloc = {"focal_audit_rate": 0.5}, {"focal_audit_rate": 0.1}
    return {"audit": {"frozen": {"0": {"rep0": c0}, "0.05": {"rep0": c1}}, "primary": {"0": {"rep0": c0}}},
            "counts": {"continued": continued, "frozen": 1, "unresolved": 0}, "problems": [], "unscorable": [],
            "round1_mismatch": False, "gate_ok": True}


SAFE = lambda k: k.replace("|", "__")
WIN = {"menu-p0.05|fresh3@rho0.2__F111__D2+H3__profit__churn0.05": "continued",
       "cthr-p0|fresh0@rho0.2__Cstar__D2+H3__profit": "continued",
       "menu-p0|fresh1@rho0.2__F111__D2+H3__profit": "frozen"}


def test_build_keeps_counts_alloc_status_and_only_winning_continuations():
    r = RE.build(_col(), WIN, SAFE, {"analysis": "a"})
    assert r["audit"]["frozen"]["0.05"]["rep0"] == [1, 10]
    assert r["alloc"]["frozen"]["0"]["rep0"] == {"focal_audit_rate": 0.5}
    assert [c["market"] for c in r["continued"]] == ["rep0", "rep3"]          # the "frozen" outcome is not listed
    assert r["status"] == {"problems": [], "unscorable": [], "round1_mismatch": False, "gate_ok": True}
    assert r["binding"] == {"analysis": "a"}


def test_build_refuses_a_count_mismatch():
    with pytest.raises(ValueError):
        RE.build(_col(continued=3), WIN, SAFE, {})


def test_build_refuses_a_duplicate_identity():
    with pytest.raises(ValueError):
        RE.build(_col(), {"a|x": "continued", "a__x": "continued"}, lambda k: "menu-p0__fresh1@rho0.2__F111__D2+H3__profit", {})


def test_committed_extract_is_bound_to_the_committed_analysis():
    ex = json.loads((HERE / "replication-extract.json").read_text())
    assert ex["binding"]["analysis"] == hashlib.sha256((HERE / "replication-analysis.json").read_bytes()).hexdigest()
    assert ex["status"] == {"problems": [], "unscorable": [], "round1_mismatch": False, "gate_ok": True}
"""Tests for replication_paper.py: the paper summary and tables built from the committed analysis and extract."""
import json
from pathlib import Path

import pytest

import replication_paper as RP

HERE = Path(__file__).resolve().parent
SHA = "a" * 64
XOFF = {"d": 0.0, "q": 0.3, "u": 0.6}            # distinct values per contrast, so that a column swap is visible


def _analysis():
    mk = lambda v: {f"rep{i}": v + 0.01 * i for i in range(6)}
    pc = lambda mean: {"complete": True, "lower": 5, "markets": mk(mean), "mean": mean, "t95": [mean - 0.1, mean + 0.1]}
    ab = lambda mean: {"complete": True, "markets": {f"rep{i}": {"estimate": mean, "ci95": [mean - 0.002, mean + 0.002]} for i in range(6)},
                       "mean": mean, "pooled_ci95": [mean - 0.01, mean + 0.01], "t95": [mean - 0.2, mean + 0.2]}
    terms = {p: {f"rep{i}": {r: {"attack": 0.3, "eff_attack": e, "gain": 0.1, "reference": 0.2}
                             for r, e in (("R3", 0.95 - float(p)), ("C*", 0.99), ("C-thr", 0.98), ("B3", 0.97))}
                 for i in range(6)} for p in ("0", "0.03", "0.05")}
    s = {"paired_changes": {p: {x: pc((-0.1 if p == "0.05" else -0.05) - XOFF[x]) for x in "dqu"} for p in ("0.03", "0.05")},
         "absolute": {p: {x: ab(0.02 - float(p) * 4 - XOFF[x]) for x in "dqu"} for p in ("0", "0.03", "0.05")},
         "criteria": {p: {x: {"material": True, "support": True} for x in "dqu"} for p in ("0.03", "0.05")},
         "expectations": {str(k): {"text": "t", "verdict": "met"} for k in range(1, 6)}, "terms": terms}
    return {"primary": s, "frozen": json.loads(json.dumps(s)), "counts": {"continued": 3, "frozen": 69, "unresolved": 0},
            "gate_ok": True, "problems": [], "unscorable": [], "round1_mismatch": False, "confirmatory": True}


def _alloc(rate):
    return {"young_honest_job_share": 0.1 + float(rate), "young_honest_audit_share": 0.2 + 10 * float(rate),
            "established_honest_audit_rate": 0.2, "focal_job_share": 0.08, "focal_audit_rate": None if rate == "0.03" else 0.5}


def _extract():
    au = {"0": {f"rep{i}": [80, 100] for i in range(6)}, "0.05": {f"rep{i}": [2 + i, 100] for i in range(6)},
          "0.03": {"rep0": [5, 100]}}
    al = {p: {m: _alloc(p) for m in ms} for p, ms in au.items()}
    return {"audit": {"primary": au, "frozen": au}, "alloc": {"primary": al, "frozen": al},
            "counts": {"continued": 3, "frozen": 69, "unresolved": 0},
            "status": {"problems": [], "unscorable": [], "round1_mismatch": False, "gate_ok": True}, "binding": {"analysis": SHA},
            "continued": [{"kind": "menu", "rate": "0", "market": "rep2", "policy": "F111", "stem": "menu-p0__fresh2@rho0.2__F111__D2+H3__profit"},
                          {"kind": "menu", "rate": "0.05", "market": "rep1", "policy": "Cstar",
                           "stem": "menu-p0.05__fresh1@rho0.2__Cstar__D2+H3__profit__churn0.05"},
                          {"kind": "cthr", "rate": "0.05", "market": "rep3", "policy": "Cstar",
                           "stem": "cthr-p0.05__fresh3@rho0.2__Cstar__D2+H3__profit__churn0.05"}]}


def _sum(an=None, ex=None, sha=SHA):
    return RP.summary(an or _analysis(), ex or _extract(), sha)


def test_audit_shares_min_max_and_count_below():
    a = _sum()["primary"]["audit"]
    assert a["0"]["focal_audit_min"] == pytest.approx(0.8) and a["0"]["focal_audit_max"] == pytest.approx(0.8)
    assert a["0.05"]["focal_audit_min"] == pytest.approx(0.02) and a["0.05"]["focal_audit_max"] == pytest.approx(0.07)
    assert a["0.05"]["markets"] == 6 and a["below"]["markets"] == 6
    assert a["0.03"]["markets"] == 1                      # missing counts are not imputed


def test_zero_denominator_counts_as_not_below():
    ex = _extract(); ex["audit"]["primary"]["0.05"]["rep0"] = [0, 0]
    assert _sum(ex=ex)["primary"]["audit"]["below"]["markets"] == 5


def test_allocation_means_and_market_count():
    a = _sum()["primary"]["alloc"]
    assert a["0.05"]["young_honest_job_share"] == pytest.approx(0.15) and a["0.05"]["markets"] == 6
    assert a["0.03"]["markets"] == 1 and a["0.03"]["focal_audit_rate"] is None


def test_efficiency_means_per_rule():
    e = _sum()["primary"]["eff"]
    assert e["0.05"]["R3"]["eff"] == pytest.approx(0.90) and e["0"]["C*"]["eff"] == pytest.approx(0.99)
    assert e["0.05"]["R3"]["eff_min"] == pytest.approx(0.90)


def test_spread_two_most_negative_and_rest():
    sp = _sum()["primary"]["spread"]["0.05"]["q"]
    assert sp["top"] == {"0": pytest.approx(-0.4), "1": pytest.approx(-0.39)} and sp["top_markets"] == ["rep0", "rep1"]
    assert sp["rest"] == {"min": pytest.approx(-0.38), "max": pytest.approx(-0.35)}


def test_setdiff_and_criteria_counts():
    an = _analysis(); an["frozen"]["absolute"]["0.05"]["d"]["mean"] -= 0.04; an["frozen"]["criteria"]["0.03"]["d"]["support"] = False
    s = _sum(an=an)
    assert s["setdiff"]["0.05"]["d"]["difference"] == pytest.approx(0.04) and s["setdiff"]["0"]["q"]["difference"] == 0
    assert s["frozen"]["criteria"] == {"support": {"cells": 5}, "material": {"cells": 6}}


def test_continued_split_by_rate_and_rule():
    c = _sum()["continued"]
    assert c["all"]["cells"] == 3 and c["0"]["cells"] == 1 and c["0.05"]["cells"] == 2 and c["0.03"]["cells"] == 0
    assert c["rules"]["R3"]["cells"] == 1 and c["rules"]["C-thr"]["cells"] == 1 and c["rules"]["C*"]["cells"] == 1


@pytest.mark.parametrize("mutate", [
    lambda an, ex: ex.update(counts={"continued": 4, "frozen": 68, "unresolved": 0}),
    lambda an, ex: an.update(problems=["x"]),
    lambda an, ex: an.update(confirmatory=False),
    lambda an, ex: ex.update(binding={"analysis": "b" * 64}),                        # stale extract, equal counts
    lambda an, ex: ex["status"].update(problems=["y"]),
    lambda an, ex: ex["continued"].append(dict(ex["continued"][0])),                 # duplicate identity
    lambda an, ex: ex["continued"][1].update(rate="0.03"),                           # fields disagree with the stem
    lambda an, ex: ex["audit"]["primary"].update({"0.02": {"rep0": [1, 2]}}),        # unplanned rate
    lambda an, ex: ex["alloc"]["primary"]["0.05"].pop("rep5"),                       # allocation misses a cell
    lambda an, ex: an["primary"]["expectations"]["5"].update(verdict="not met"),     # audit counts say met
])
def test_refusals(mutate):
    an, ex = _analysis(), _extract()
    mutate(an, ex)
    with pytest.raises(ValueError):
        RP.summary(an, ex, SHA)


def test_table_columns_follow_the_contrasts():
    t = RP.table(_analysis())
    row = next(l for l in t.splitlines() if l.startswith("Primary & 0.05"))
    assert row.index("$-$0.100") < row.index("$-$0.400") < row.index("$-$0.700")       # d, q, u in that order
    assert "All-frozen" in t and "nan" not in t.lower() and "5/6" in t


def test_appendix_tables_have_every_row():
    an = _analysis()
    assert RP.table_markets(an).count("\\\\") == 1 + 2 * 2 * 3 and "rep5" in RP.table_markets(an)
    assert RP.table_absolute(an).count("\\\\") == 1 + 2 * 3 * 3 * 2
    assert RP.table_terms(an).count("\\\\") == 1 + 2 * 3 * 4 and "C-thr" in RP.table_terms(an)
    assert RP.table_alloc(_sum()).count("\\\\") == 1 + 2 * 3 and "1/6" in RP.table_alloc(_sum())


def test_check_reports_stale_files(tmp_path):
    an, ex = _analysis(), _extract()
    RP.write(an, ex, SHA, tmp_path / "s.json", tmp_path / "t.tex")
    assert RP.check(an, ex, SHA, tmp_path / "s.json", tmp_path / "t.tex") == []
    (tmp_path / "replication_terms.tex").write_text("stale")
    assert RP.check(an, ex, SHA, tmp_path / "s.json", tmp_path / "t.tex")


def test_committed_files_are_current():
    p = HERE / "replication-analysis.json"
    an, ex = json.loads(p.read_text()), json.loads((HERE / "replication-extract.json").read_text())
    tex = HERE.parent / "paper-v2" / "tables" / "replication.tex"
    assert RP.check(an, ex, RP.sha_file(p), HERE / "replication_paper.json", tex) == []


def test_expectation_tally():
    an = _analysis(); an["frozen"]["expectations"]["3"]["verdict"] = "not met"
    s = _sum(an=an)
    assert s["primary"]["exp"] == {"fulfilled": 5, "failed": 0} and s["frozen"]["exp"] == {"fulfilled": 4, "failed": 1}

