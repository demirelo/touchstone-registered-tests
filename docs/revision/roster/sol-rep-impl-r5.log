   440	def terms_of(h: dict, n: int) -> dict:
   441	    """Per seed: gain = attack term - reference term, each normalised by S*/N (sim/reference.evaluate_gain)."""
   442	    sc = [x / n for x in h["sstar"]]
   443	    return {"gain": list(h["gain"]), "attack": [a / s for a, s in zip(h["profit_attack"], sc)],
   444	            "reference": [r / s for r, s in zip(h["profit_ref"], sc)], "eff_attack": list(h["eff_attack"]), "seeds": list(h["seeds"])}
   445	
   446	
   447	def _audit_of(shares: dict) -> tuple:
   448	    per = shares["per_episode"]
   449	    fo = [sum(e["focal"][b][i] for e in per for b in range(len(e["focal"]))) for i in (0, 1)]
   450	    return fo[1], fo[0]                                                   # (audited, served)
