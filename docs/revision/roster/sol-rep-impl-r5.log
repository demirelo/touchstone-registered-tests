   463	    import convergence_v2  # noqa: F401
   464	    import revision_v2 as R
   465	    base = Path(base); cdir = base / "continuation"
   466	    allrec = [read_record(q) for q in sorted(cdir.glob("*.json")) + sorted((cdir / "gate").glob("*.json")) if q.name != "lost_cells.json"]
   467	    mismatch = any(_mismatch(r) for r in allrec)
   468	    g = read_record(cdir / "gate" / (R._safe(gate["id"]) + ".json")) if gate else None
   469	    gdb = doubling_of(gate.get("dir") or base / "menu-p0.05", gate["job"]["id"]) if gate else None
   470	    gate_ok = g is not None and cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=gdb) is None and \
   471	        g.get("status") in STATUSES[:2] and (identical(g) or (smoke and g.get("round1_gate") == SMOKE_GATE))
   472	    frozen, primary, problems, unscorable = {}, {}, [], []
   473	    counts = {"frozen": 0, "continued": 0, "unresolved": 0, "stopped": 0, "not continued": 0}
   474	    audit = {"frozen": {}, "primary": {}}
   475	    for (kind, p), jobs in jobs_by_dir.items():
   476	        rk = "0" if p == 0 else f"{p:g}"; d = base / f"{kind}-p{p:g}"
   477	        diag = (read_record(d / "diagnostics.json") or {}).get("cells") or {} if kind == "menu" else {}
   478	        for j in jobs:
   479	            m, r = j["mkt"]["label"].replace("fresh", "rep"), analysis_rule(kind, j["rule"])
   480	            ev = read_record(R.eval_path(d, j["id"])); db = read_record(d / "doubling" / (R._safe(j["id"]) + ".json"))
   481	            seeds = j["mkt"]["seeds_eval"]
   482	            if (why := base_problem(d, j, ev, db)) is not None:
   483	                unscorable.append(f"{kind}-p{p:g}|{j['id']}: {why}"); continue
   484	            n = _n_agents(j); fz = terms_of(ev, n)
   485	            frozen.setdefault(rk, {}).setdefault(m, {})[r] = fz
   486	            fa = None
   487	            if r == "R3" and kind == "menu":
   488	                ck = f"{j['context']}|{j['rule']}"
   489	                row = (diag.get(ck) or {}).get("base")
   490	                sr = read_record(R.path_of(d, j["id"])) or {}
   491	                if diag_bound(d, kind, p, ck, j) and diag_ok(row, seeds, (sr.get("attack") or {}).get("best_knobs")):
   492	                    fa = _audit_of(row["shares"]); audit["frozen"].setdefault(rk, {})[m] = fa
   493	                elif ck in diag:
   494	                    problems.append(f"{kind}-p{p:g}|{j['id']}: frozen diagnostics fail their checks")
   495	            win, kw, crec = fz, "frozen", None
   496	            key = _key(kind, p, j["id"])
   497	            if db["incomplete"]:
   498	                crec = read_record(cdir / (R._safe(key) + ".json"))
   499	                if crec is None:
   500	                    kw = "not continued"
   501	                elif (why := cont_problem(crec, key, j, smoke, doubling=db)) is not None:   # plan section 4: invalid output keeps
   502	                    problems.append(f"{key}: {why}"); kw = "not continued"     # the validated frozen winner
   503	                else:
   504	                    try:
   505	                        _, kw = select_winner(fz["gain"], crec)
   506	                    except Round1Mismatch:
   507	                        kw = "frozen"
   508	                    if kw in ("continued", "unresolved"):
   509	                        win = terms_of(crec["heldout"], n)
   510	            counts[kw] += 1
