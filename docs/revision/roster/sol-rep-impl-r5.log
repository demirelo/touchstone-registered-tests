   421	
   422	def diag_bound(d: Path, kind: str, p: float, ck: str, job: dict) -> bool:
   423	    """The frozen diagnostics of cell `ck` belong to this job, rate and run: the binding names this rate, the current
   424	    diagnostics.json, this job's id and provenance, and the current search and doubling records."""
   425	    import revision_v2 as R
   426	    from sim.records_v2 import sha_file
   427	    b = read_record(Path(d) / BINDING); c = ((b or {}).get("cells") or {}).get(ck)
   428	    q = Path(d) / "diagnostics.json"
   429	    return isinstance(c, dict) and b.get("stage") == "diagnostics binding" and b.get("kind") == kind and b.get("rate") == float(p) and \
   430	        q.is_file() and b.get("diagnostics") == sha_file(q) and c.get("id") == job["id"] and c.get("provenance") == job["provenance"] and \
   431	        R.path_of(d, job["id"]).is_file() and c.get("search") == sha_file(R.path_of(d, job["id"])) and \
   432	        c.get("doubling") == sha_file(Path(d) / "doubling" / (R._safe(job["id"]) + ".json"))
