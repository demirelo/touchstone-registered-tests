   246	
   247	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   248	              smoke: bool = False) -> dict:
   249	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   250	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   251	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   252	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   253	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   254	    cost-stopped ones."""
   255	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   256	    import revision_v2 as R
   257	    if gate is None:
   258	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   259	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   260	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   261	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   262	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   263	    saved = {d: read_record(d) for _, d in items}
   264	    other = [c["id"] for c, d in items if saved[d] is not None and saved[d].get("provenance") != c["job"].get("provenance")]
   265	    if other:                                                            # plan section 5: reuse only this run's records
   266	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   267	    if any(_mismatch(r) for r in saved.values()):
   268	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   269	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   270	    # review rep-impl-r3: a saved record is reused only if it passes the same checks collect applies; any other record
   271	    # (incomplete, malformed, nonfinite) means "no passing record" and its cell is rerun (plan section 4: a resume
   272	    # continues from the first cell without a passing record); the old record is set aside, never deleted
   273	    # (an unknown status included: review rep-impl-r4; a measured round-1 mismatch stopped above and is never rerun)
   274	    invalid = lambda c, d, mr: saved[d] is not None and not cost_stopped(saved[d]) and \
   275	        cont_problem(saved[d], c["id"], c["job"], smoke, mr, doubling_of(c["dir"], c["job"]["id"])) is not None
   276	    rerun = lambda c, d, mr: saved[d] is None or cost_stopped(saved[d]) or invalid(c, d, mr)
   277	    run = 0
   278	    if rerun(gate, gdest, 1):
   279	        _set_aside(cdir, gdest)
   280	        lost, failed = run_cells(_cont_one, [gate], [(gate["job"], gate["dir"], 1, cost, hours[gate["id"]])], 1, [gdest],
   281	                                 [{"id": gate["id"], "gate": True}])
   282	        run += 1
   283	        if failed:
   284	            return {"run": run, "failed": failed, "exit": 6, "gate": "the gate cell raised an error"}
   285	        if lost:
   286	            _lost(cdir, lost, hours, 1)
   287	            return {"run": run, "lost": lost, "exit": 5, "gate": "the gate cell's worker was lost"}
   288	    g = read_record(gdest)
   289	    if _mismatch(g):
   290	        return {"run": run, "exit": 4, "gate": "round-1 mismatch at the gate: continuation stopped"}
   291	    if cost_stopped(g):
   292	        return {"run": run, "exit": 3, "gate": "the gate cell was refused at the cost cap: no further cell started"}
   293	    if not smoke and not identical(g):                                   # the gate must prove identity, not just not fail
   294	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   295	    if (why := cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=doubling_of(gate["dir"], gate["job"]["id"]))) is not None:
   296	        return {"run": run, "exit": 6, "gate": f"the gate record fails its checks: {why}"}
   297	    todo = [c for c in queue if rerun(c, dest(c), max_rounds)]          # same order; completed, valid cells reused
   298	    for c in todo:
   299	        _set_aside(cdir, dest(c))
   300	    lost, failed = ([], {}) if not todo else run_cells(
   301	        _cont_one, todo, [(c["job"], c["dir"], max_rounds, cost, hours[c["id"]]) for c in todo], workers,   # module-level fn
   302	        [dest(c) for c in todo], [{"id": c["id"]} for c in todo])
   303	    recs = [read_record(dest(c)) for c in todo]
   304	    mismatch = [c["id"] for c, r in zip(todo, recs) if _mismatch(r)]
   305	    stopped = [c["id"] for c, r in zip(todo, recs) if cost_stopped(r)]
   306	    if lost and not mismatch and not failed:
   307	        _lost(cdir, lost, hours, max_rounds)
   308	    code = 4 if mismatch else 6 if failed else 5 if lost else 3 if stopped else 0
   309	    return {"run": run + len(todo), "lost": lost, "failed": failed, "mismatch": mismatch, "stopped": stopped, "exit": code}
   310	
