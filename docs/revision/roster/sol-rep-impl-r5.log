   339	
   340	@_checked
   341	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   342	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   343	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   344	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   345	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   346	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   347	    import revision_v2 as R
   348	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   349	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   350	    if ev is None:
   351	        return "no evaluation record"
   352	    if ev.get("stage") != "evaluate" or ev.get("id") != job["id"] or ev.get("provenance") != job["provenance"]:
   353	        return "evaluation record of another stage, cell or run"
   354	    if not _valid_held(ev, seeds):
   355	        return "evaluation values nonfinite or on other seeds"
   356	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
   357	        return "evaluation: " + x
   358	    if db is None:
   359	        return "no doubling record"
   360	    if db.get("stage") != "doubling" or db.get("id") != job["id"] or db.get("provenance") != job["provenance"] or db.get("kind") != "profit":
   361	        return "doubling record of another stage, cell, run or kind"
   362	    ch = [db.get("attack_change"), db.get("reference_change")]
   363	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   364	        return "doubling changes nonfinite or flag missing"
   365	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   366	        return "doubling flag differs from its changes"
   367	    h = db.get("heldout")
   368	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   369	        return "doubling held-out result missing, nonfinite or on other seeds"
   370	    ref = read_record(R.path_of(d, rid))
   371	    if ref is None or not isinstance(ref.get("upstream"), dict):
   372	        return "no reference record"
   373	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   374	        return "doubling: " + x
   375	    return None
   376	
   377	
   378	def _n_bins() -> int:
   379	    from churn_v2 import AGE_EDGES
   380	    return len(AGE_EDGES) - 1
   381	
   382	
   383	def _shares_ok(sh, n_episodes: int) -> bool:
   384	    """Newcomer audit counts (churn_v2.newcomer_shares): one episode per evaluation seed, each with the prescribed number
   385	    of age bins of [served, audited], finite and nonnegative, audited at most served (review rep-impl-r3)."""
   386	    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
   387	    if not isinstance(per, list) or len(per) != n_episodes:
   388	        return False
   389	    nb = _n_bins()
   390	    for e in per:
   391	        f = e.get("focal") if isinstance(e, dict) else None
   392	        if not isinstance(f, list) or len(f) != nb:
   393	            return False
   394	        for b in f:
   395	            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
   396	                return False
   397	    return True
