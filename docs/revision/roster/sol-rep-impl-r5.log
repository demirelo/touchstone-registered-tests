   186	
   187	@_checked
   188	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3, doubling=None) -> str | None:
   189	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   190	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   191	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   192	    job's ordered evaluation seeds; a measured round 1 must agree with this cell's doubling record (`doubling`;
   193	    _round1_problem). The job must carry its evaluation seeds: no check is skipped."""
   194	    seeds = (job.get("mkt") or {}).get("seeds_eval")
   195	    if not seeds:
   196	        return "the job has no evaluation seeds to check against"
   197	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or rec.get("id") != key:
   198	        return "not a continuation record of this cell"
   199	    if rec.get("provenance") != job.get("provenance"):
   200	        return "continuation record of another job or run"
   201	    st = rec.get("status")
   202	    if st not in STATUSES:
   203	        return f"unknown continuation status {st!r}"
   204	    if st in STATUSES[:2]:
   205	        g = rec.get("round1_gate")
   206	        if not (identical(rec) or (smoke and g == SMOKE_GATE)):
   207	            return "a continued winner without its own identical round-1 comparison"
   208	        if isinstance(g, dict) and not (_knobs_ok(g.get("heldout_knobs")) and _finite([g.get("heldout_mean")])):
   209	            return "round-1 comparison without a finite round-1 winner"
   210	        h = rec.get("heldout")
   211	        if not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   212	            return "held-out result missing, nonfinite, on other seeds or with a zero normalizer"
   213	        if x := _rounds_problem(rec, max_rounds):
   214	            return x
   215	        if isinstance(g, dict) and (x := _round1_problem(rec, doubling)):
   216	            return x
   217	    return None
