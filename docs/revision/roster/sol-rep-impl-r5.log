   320	def _valid_held(h, seeds) -> bool:
   321	    """Finite per-seed values on the ordered seeds, and a positive normalizer S* on every seed (terms_of divides by it;
   322	    review rep-impl-r3)."""
   323	    return isinstance(h, dict) and isinstance(h.get("seeds"), list) and h["seeds"] == list(seeds) and \
   324	        all(_finite(h.get(f)) and len(h[f]) == len(seeds) for f in FIELDS) and all(x > 0 for x in h["sstar"])
