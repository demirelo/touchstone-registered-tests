   452	
   453	def collect(base: Path, jobs_by_dir: dict, gate: dict | None, smoke: bool = False) -> dict:
   454	    """Records for both winner sets (recs[rate][market][rule] with gains, attack and reference terms, efficiency and
   455	    seeds), R3's audit counts for both sets, and the winner counts. Every record is checked before use (review
   456	    rep-impl-r2): a cell whose evaluation or doubling record fails base_problem is unscorable (plan section 4); a frozen
   457	    diagnostics row that fails diag_ok gives no audit count. Only flagged cells look at a continuation record; a flagged
   458	    cell without one is "not continued". The primary set is unavailable after a round-1 mismatch in any continuation
   459	    record or without this run's identical gate record (also when no cell is flagged). A flagged cell whose continuation
   460	    record fails cont_problem keeps its validated frozen winner and counts as not continued (plan section 4; review
   461	    rep-impl-r3). A frozen R3 audit count needs diagnostics bound to this job, rate and run (diag_bound) and complete
   462	    (diag_ok); a continued R3 winner's audit count needs its checked continued diagnostics."""
   463	    import convergence_v2  # noqa: F401
   464	    import revision_v2 as R
   465	    base = Path(base); cdir = base / "continuation"
   466	    allrec = [read_record(q) for q in sorted(cdir.glob("*.json")) + sorted((cdir / "gate").glob("*.json")) if q.name != "lost_cells.json"]
   467	    mismatch = any(_mismatch(r) for r in allrec)
   468	    g = read_record(cdir / "gate" / (R._safe(gate["id"]) + ".json")) if gate else None
   469	    gdb = doubling_of(gate.get("dir") or base / "menu-p0.05", gate["job"]["id"]) if gate else None
   470	    gate_ok = g is not None and cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=gdb) is None and \
   471	        g.get("status") in STATUSES[:2] and (identical(g) or (smoke and g.get("round1_gate") == SMOKE_GATE))
   472	    frozen, primary, problems, unscorable = {}, {}, [], []
   473	    counts = {"frozen": 0, "continued": 0, "unresolved": 0, "stopped": 0, "not continued": 0}
   474	    audit = {"frozen": {}, "primary": {}}
   475	    for (kind, p), jobs in jobs_by_dir.items():
   476	        rk = "0" if p == 0 else f"{p:g}"; d = base / f"{kind}-p{p:g}"
   477	        diag = (read_record(d / "diagnostics.json") or {}).get("cells") or {} if kind == "menu" else {}
   478	        for j in jobs:
   479	            m, r = j["mkt"]["label"].replace("fresh", "rep"), analysis_rule(kind, j["rule"])
   480	            ev = read_record(R.eval_path(d, j["id"])); db = read_record(d / "doubling" / (R._safe(j["id"]) + ".json"))
   481	            seeds = j["mkt"]["seeds_eval"]
   482	            if (why := base_problem(d, j, ev, db)) is not None:
   483	                unscorable.append(f"{kind}-p{p:g}|{j['id']}: {why}"); continue
   484	            n = _n_agents(j); fz = terms_of(ev, n)
   485	            frozen.setdefault(rk, {}).setdefault(m, {})[r] = fz
   486	            fa = None
   487	            if r == "R3" and kind == "menu":
   488	                ck = f"{j['context']}|{j['rule']}"
   489	                row = (diag.get(ck) or {}).get("base")
   490	                sr = read_record(R.path_of(d, j["id"])) or {}
   491	                if diag_bound(d, kind, p, ck, j) and diag_ok(row, seeds, (sr.get("attack") or {}).get("best_knobs")):
   492	                    fa = _audit_of(row["shares"]); audit["frozen"].setdefault(rk, {})[m] = fa
   493	                elif ck in diag:
   494	                    problems.append(f"{kind}-p{p:g}|{j['id']}: frozen diagnostics fail their checks")
   495	            win, kw, crec = fz, "frozen", None
   496	            key = _key(kind, p, j["id"])
   497	            if db["incomplete"]:
   498	                crec = read_record(cdir / (R._safe(key) + ".json"))
   499	                if crec is None:
   500	                    kw = "not continued"
   501	                elif (why := cont_problem(crec, key, j, smoke, doubling=db)) is not None:   # plan section 4: invalid output keeps
   502	                    problems.append(f"{key}: {why}"); kw = "not continued"     # the validated frozen winner
   503	                else:
   504	                    try:
   505	                        _, kw = select_winner(fz["gain"], crec)
   506	                    except Round1Mismatch:
   507	                        kw = "frozen"
   508	                    if kw in ("continued", "unresolved"):
   509	                        win = terms_of(crec["heldout"], n)
   510	            counts[kw] += 1
   511	            primary.setdefault(rk, {}).setdefault(m, {})[r] = win
   512	            if r == "R3" and kind == "menu":                # review rep-impl-r4: the primary count comes from the primary
   513	                if kw in ("continued", "unresolved"):           # winner's own diagnostics; frozen ones only for a frozen winner
   514	                    cd = read_record(cdir / "diagnostics" / (R._safe(key) + ".json"))
   515	                    if cont_diag_ok(cd, key, j, crec["heldout"]["knobs"]):
   516	                        audit["primary"].setdefault(rk, {})[m] = _audit_of(cd["shares"])
   517	                    elif cd is not None:
   518	                        problems.append(f"{key}: continued diagnostics fail their checks")
   519	                elif fa is not None:
   520	                    audit["primary"].setdefault(rk, {})[m] = fa
   521	    if not gate_ok:
   522	        problems.append("no identical gate record of this run's gate cell")
   523	    bad = mismatch or not gate_ok
   524	    return {"frozen": frozen, "primary": None if bad else primary, "audit": audit, "counts": counts,
   525	            "round1_mismatch": mismatch, "gate_ok": gate_ok, "problems": problems, "unscorable": unscorable}
   526	
   527	
   528	def _diag_cont(job: dict, knobs: dict) -> dict:
   529	    """In a worker: the churn arm's diagnostic run (churn_v2._diag_one) for a continued winner's knobs on the evaluation
   530	    seeds under the cell's churn: per-seed normalised profits and newcomer audit counts (plan section 3, expectation 5
   531	    on the primary winners)."""
   532	    import churn_v2
   533	    import numpy as np
   534	    import revision_v2 as R
   535	    from sim.cell import SeedCache, run_focal
   536	    churn_v2.install()
   537	    T, L = R.constants(job); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(job)
   538	    fr = run_focal(cell, lambda: fam.make(dict(knobs)), SeedCache())
   539	    return {"stage": "continued diagnostics", "provenance": job["provenance"], "knobs": dict(knobs),
   540	            "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
   541	            "mean_normalized": float(np.mean(fr.normalized)), "shares": churn_v2.newcomer_shares(fr.results, cell.focal)}
   542	
   543	
   544	def run_diagnostics(base: Path, jobs_by_dir: dict, workers: int, smoke: bool = False) -> dict:
   545	    """The diagnostics of R3's continued winners (menu cells at p = 0 and 0.05 whose continuation passed or reached the
   546	    cap) in Run B's pool; records under continuation/diagnostics/, reused on resume when bound to the same job."""
   547	    import convergence_v2  # noqa: F401
   548	    import revision_v2 as R
   549	    cdir = Path(base) / "continuation"; todo, args, dests, extras = [], [], [], []
   550	    for (kind, p), jobs in jobs_by_dir.items():
   551	        if kind != "menu" or p not in (0.0, 0.05):
   552	            continue
   553	        for j in jobs:
   554	            if j["rule"] != "F111":
   555	                continue
   556	            key = _key(kind, p, j["id"]); crec = read_record(cdir / (R._safe(key) + ".json"))
   557	            d = Path(base) / f"{kind}-p{p:g}"
   558	            if crec is None or cont_problem(crec, key, j, smoke, doubling=doubling_of(d, j["id"])) is not None or crec["status"] not in STATUSES[:2]:
   559	                continue
   560	            dest = cdir / "diagnostics" / (R._safe(key) + ".json"); old = read_record(dest)
   561	            if cont_diag_ok(old, key, j, crec["heldout"]["knobs"]):
   562	                continue
   563	            _set_aside(cdir / "diagnostics", dest)              # a stale or foreign record is rerun, never reused
   564	            todo.append({"id": key}); args.append((j, crec["heldout"]["knobs"])); dests.append(dest); extras.append({"id": key})
   565	    lost, failed = ([], {}) if not todo else run_cells(_diag_cont, todo, args, workers, dests, extras)
   566	    if lost and not failed:                                     # the launcher's restart reads this estimate (exit 5)
   567	        _lost(cdir, lost, {k: DIAG_HOURS for k in lost}, 1)
   568	    return {"run": len(todo), "lost": lost, "failed": failed, "exit": 6 if failed else 5 if lost else 0}

