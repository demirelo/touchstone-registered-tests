   219	
   220	def _set_aside(cdir: Path, dest: Path) -> None:
   221	    """Move a record that will be rerun out of the way (no deletion), so that a lost worker shows as a missing record and
   222	    is never masked by the old one (review rep-impl-r2)."""
   223	    if dest.exists():
   224	        sup = cdir / "superseded"; sup.mkdir(parents=True, exist_ok=True)
   225	        n = len(list(sup.glob(dest.stem + ".*.json")))
   226	        dest.rename(sup / f"{dest.stem}.{n}.json")
   227	
   228	
   229	def _mismatch(rec) -> bool:
   230	    """A measured round 1 that differs from the doubling record at all. A cell refused before round 1 ("not run") or a
   231	    smoke run ("not compared") measured nothing."""
   232	    if rec is None:
   233	        return False
   234	    if str(rec.get("status", "")).startswith("stopped: round 1"):
   235	        return True
   236	    return isinstance(rec.get("round1_gate"), dict) and not identical(rec)
