   512	            if r == "R3" and kind == "menu":                # review rep-impl-r4: the primary count comes from the primary
   513	                if kw in ("continued", "unresolved"):           # winner's own diagnostics; frozen ones only for a frozen winner
   514	                    cd = read_record(cdir / "diagnostics" / (R._safe(key) + ".json"))
   515	                    if cont_diag_ok(cd, key, j, crec["heldout"]["knobs"]):
   516	                        audit["primary"].setdefault(rk, {})[m] = _audit_of(cd["shares"])
   517	                    elif cd is not None:
   518	                        problems.append(f"{key}: continued diagnostics fail their checks")
   519	                elif fa is not None:
   520	                    audit["primary"].setdefault(rk, {})[m] = fa
   521	    if not gate_ok:
   522	        problems.append("no identical gate record of this run's gate cell")
   523	    bad = mismatch or not gate_ok
   524	    return {"frozen": frozen, "primary": None if bad else primary, "audit": audit, "counts": counts,
   525	            "round1_mismatch": mismatch, "gate_ok": gate_ok, "problems": problems, "unscorable": unscorable}
