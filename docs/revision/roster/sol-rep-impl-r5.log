   435	def cont_diag_ok(rec, key: str, job: dict, knobs) -> bool:
   436	    return isinstance(rec, dict) and rec.get("stage") == "continued diagnostics" and rec.get("id") == key and \
   437	        rec.get("provenance") == job["provenance"] and diag_ok(rec, job["mkt"]["seeds_eval"], knobs)
