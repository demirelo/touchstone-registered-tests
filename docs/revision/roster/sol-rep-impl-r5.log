   409	
   410	def diagnostics_binding(d: Path, kind: str, p: float, jobs: list) -> dict:
   411	    """Written by rep_v2's rate stage right after the diagnostics step and before the inventory (review rep-impl-r3): the
   412	    sha256 of diagnostics.json, the rate, and per cell the job id, its provenance (this run's commit, draw and salt) and
   413	    the hashes of the search and doubling records whose winners the diagnostics reran."""
   414	    import revision_v2 as R
   415	    from sim.records_v2 import sha_file
   416	    d = Path(d); h = lambda q: sha_file(q) if q.is_file() else None
   417	    return {"stage": "diagnostics binding", "kind": kind, "rate": float(p), "diagnostics": h(d / "diagnostics.json"),
   418	            "cells": {f"{j['context']}|{j['rule']}": {"id": j["id"], "provenance": j["provenance"], "search": h(R.path_of(d, j["id"])),
   419	                                                       "doubling": h(d / "doubling" / (R._safe(j["id"]) + ".json"))} for j in jobs}}
