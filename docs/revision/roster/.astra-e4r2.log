"""Scores the hashed predictions (docs/revision/predictions-v2.md, scoring table) from report.json and cells.json.
A prediction over several cells is scored cell by cell: failed if any assessed cell fails; fulfilled only if every
required cell is assessed and fulfilled; otherwise not assessed. A cell is not assessed when its value is missing,
cut, refused, or a status string. Descriptive only: predictions change no decision."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

FRESH = tuple(f"fresh{i}" for i in range(6))
MARKETS = FRESH + ("headline",)
NA = "not assessed"


def _num(x):
    return float(x) if isinstance(x, (int, float)) and not isinstance(x, bool) else None


def _cell(name, value, test) -> dict:
    v = _num(value) if not isinstance(value, (tuple, list)) else value
    if v is None or (isinstance(v, (tuple, list)) and any(_num(z) is None for z in v)):
        return {"cell": name, "value": None, "status": NA}
    return {"cell": name, "value": v, "status": "fulfilled" if test(v) else "failed"}


def _combine(cells: list) -> dict:
    st = [c["status"] for c in cells]
    status = "failed" if "failed" in st else "fulfilled" if st and all(s == "fulfilled" for s in st) else NA
    return {"status": status, "cells": cells}


def _get(d, *path):
    for p in path:
        if not isinstance(d, dict) or p not in d:
            return None
        d = d[p]
    return d


def _gain(cells, m, rule, fam):
    return _get(cells, f"{m}@rho0.2|{rule}|{fam}|profit", "gain")


def score(rep: dict, cells: dict) -> dict:
    out = {}
    q1 = lambda f: _get(rep, "q1", "tests", f"C*-F111|{f}") or {}
    cat = lambda f: q1(f).get("category") if isinstance(q1(f).get("category"), str) else None
    c = cat("D2+H3")
    out["Q1-a"] = _combine([{"cell": "D2+H3", "value": c, "status": NA if c is None or c.startswith("not decided") or c == "refused"
                             else "fulfilled" if c == "equivalent, direction R3 lower" else "failed"}])
    est = _num(q1("D2+H3").get("estimate"))
    out["Q1-a-alt"] = _combine([{"cell": "D2+H3", "value": c, "status": NA if c is None or est is None or c.startswith("not decided")
                                 else "fulfilled" if (c == "ordered, size not established" and est > 0) else "failed"}])
    c = cat("X7-SC")
    out["Q1-b"] = _combine([{"cell": "X7-SC", "value": c, "status": NA if c is None or c.startswith("not decided") or c == "refused"
                             else "fulfilled" if c in ("equivalent", "equivalent, direction R3 lower") else "failed"}])
    neg = lambda v: None if v is None else -v                     # the report's side fields are F111 minus C*; Q1-c is C* minus F111
    out["Q1-c"] = _combine([_cell(f, neg(_get(q1(f), "side", "gross_eff_diff")), lambda v: -0.01 <= v <= 0.01) for f in ("D2+H3", "X7-SC")])
    out["Q1-d"] = _combine([{"cell": f, "value": q1(f).get("better"), "status": NA if cat(f) is None or "efficiency" not in q1(f)
                             else "fulfilled" if q1(f).get("better") is None else "failed"} for f in ("D2+H3", "X7-SC")])
    s = lambda kind, f, k: _get(rep, "q2", kind, f, k, "estimate")
    out["Q2-a"] = _combine([_cell(k, s("searched", "D2+H3", k), lambda v: v <= -0.05) for k in ("G", "S")])
    out["Q2-b"] = _combine([_cell("P", s("searched", "D2+H3", "P"), lambda v: abs(v) < 0.03)])
    out["Q2-c"] = _combine([_cell("PG", s("searched", "D2+H3", "PG"), lambda v: abs(v) < 0.03),
                            _cell("PS", s("searched", "D2+H3", "PS"), lambda v: abs(v) < 0.03),
                            _cell("GS", s("searched", "D2+H3", "GS"), lambda v: v <= 0)])
    out["Q2-d"] = _combine([_cell(f"{k} {f}", (s("fixed", f, k), s("searched", f, k)), lambda v: abs(v[0]) < abs(v[1]))
                            for f in ("D2+H3", "X7-SC") for k in ("P", "G", "S")])
    diff = lambda m, r, a, b: (None if _gain(cells, m, r, a) is None or _gain(cells, m, r, b) is None
                               else _gain(cells, m, r, a) - _gain(cells, m, r, b))
    out["Q3-a"] = _combine([_cell(f"{m} {r}", diff(m, r, "X7-SC", "D2+H3"), lambda v: v < 0.05) for m in MARKETS for r in ("F111", "C*")])
    out["Q3-b"] = _combine([_cell("headline F111", diff("headline", "F111", "H4", "X7-SC"), lambda v: v <= 0.05)])
    out["Q3-c"] = _combine([_cell(f"{m} {r}", diff(m, r, "X5-AG/v2", "D2+H3"), lambda v: v < 0) for m in MARKETS for r in ("F111", "C*")])
    groups = ["c2_synchronised", "c2_staggered", "c5_synchronised", "c5_staggered", "c2_roles"]
    co = lambda r, g: _get(rep, "q3", "coalition", r, g)
    out["Q3-d"] = _combine([_cell(f"{r} {g}", (_get(co(r, g), "G_min", "estimate"), _get(co(r, g), "G_tot", "estimate")),
                                  lambda v: v[0] - 0.5 * v[1] <= 0) for r in ("F111", "C*") for g in groups])
    ben = lambda r: (_get(cells, f"headline@rho0.2|{r}|X8-DB|total|c2_roles", "member_gain") or [None])[0]
    out["Q3-e"] = _combine([_cell("headline", (ben("F111"), ben("C*")), lambda v: v[0] > v[1])])
    eff = lambda r, o: _get(rep, "q3", "welfare_selected", r, o, "result", "efficiency")
    out["Q3-f"] = _combine([_cell(f"{r} {o}", eff(r, o), lambda v: v >= 0.90) for o in ("W0", "W1") for r in ("F111", "C*")]
                           + [_cell(f"F000<F111 {o}", (eff("F000", o), eff("F111", o)), lambda v: v[0] < v[1]) for o in ("W0", "W1")])
    rp = lambda r: _get(rep, "secondary", "repair_rho1", r, "D2", "estimate")
    out["Q3-g"] = _combine([_cell("headline rho1", (rp("F111"), rp("R4")), lambda v: v[0] - v[1] >= 0.10)])
    k = _get(rep, "q4", "k")
    out["Q4-a"] = _combine([_cell("k", k, lambda v: v >= 5)])
    mk = _get(rep, "q4", "markets") or {}
    elig = [m for m in (_get(rep, "q4", "failing") or []) if isinstance(mk.get(m), dict)]
    out["Q4-b"] = _combine([_cell(m, (mk[m].get("p_gain"), mk[m].get("p_eff")), lambda v: v[0] > v[1]) for m in elig])
    return out


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(); ap.add_argument("--report", required=True); ap.add_argument("--cells", required=True)
    ap.add_argument("--write", required=True); a = ap.parse_args(argv)
    sc = score(json.loads(Path(a.report).read_text()), json.loads(Path(a.cells).read_text()))
    Path(a.write).write_text(json.dumps(sc, indent=1, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""Evaluation-2 result tables for the paper, generated whole from report.json (paper draft 9 outline, "Rules for the
text"). Each row's label is the key that fetched its values, so a label cannot sit beside another row's numbers. A
string in the report (a status such as "not decided" or "unanswered: missing cell") is printed across the row. Captions
live in main.tex; these files hold only the tabular. --write writes tables/<name>.tex; --check compares them."""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from numbers_v2 import _fmt, _fmt_p  # noqa: E402

FRESH = tuple(f"fresh{i}" for i in range(6))
FAMS = ("D2+H3", "X7-SC")
CORE = ("F000", "F111", "C*")
SIDE = ("gross_eff_diff", "net_eff_diff", "ref_profit_diff", "audit_spend_diff", "false_refund_focal_diff", "false_refund_others_diff",
        "served_share_diff")


def esc(s) -> str:
    return _fmt(str(s))


def num(v) -> str:
    return _fmt(v) if not isinstance(v, str) else esc(v)


def iv(x) -> str:
    return "n/a" if not x or None in x else f"[{num(float(x[0]))}, {num(float(x[1]))}]"


def tabular(cols: str, header: list[str], rows: list[tuple[str, object]]) -> str:
    """rows: (label, list of cells) or (label, status string); a status spans the remaining columns."""
    n = len(header); out = [f"\\begin{{tabular}}{{@{{}}{cols}@{{}}}}\\toprule", " & ".join(header) + " \\\\\\midrule"]
    for label, cells in rows:
        if isinstance(cells, str):
            out.append(f"{esc(label)} & \\multicolumn{{{n - 1}}}{{l}}{{{esc(cells)}}} \\\\")
        else:
            out.append(" & ".join([esc(label)] + list(cells)) + " \\\\")
    out.append("\\bottomrule\\end{tabular}")
    return "\n".join(out) + "\n"


def q1(r: dict) -> str:
    rows = []
    for f in FAMS:
        t = r["q1"]["tests"][f"C*-F111|{f}"]
        rows.append((f, [num(t.get("estimate")), iv(t.get("interval")), esc(t.get("category")), _fmt_p(t.get("p")),
                         esc(t.get("efficiency") or "n/a"), esc(t.get("better") or "none")]))
    return tabular("lrllrll", ["Family", "$d$", "Interval", "Category", "$p$", "Efficiency", "Better"], rows)


def q1_side(r: dict) -> str:
    rows = []
    for f in FAMS:
        s = r["q1"]["tests"][f"C*-F111|{f}"].get("side")
        rows.append((f, "not available") if not s else (f, [num(s[k]) for k in SIDE]))
    return tabular("l" + "r" * len(SIDE), ["Family", "Gross eff.", "Net eff.", "Ref.\\ profit", "Audit spend", "Refunds (focal)",
                                           "Refunds (others)", "Served share"], rows)


def q4(r: dict) -> str:
    q = r["q4"]; rows = []
    for m in FRESH:
        x = q["markets"][m]
        if isinstance(x, str):
            rows.append((m, x)); continue
        dec = "pass" if m in q.get("passing", []) else "fail" if m in q.get("failing", []) else "not decided"
        rows.append((m, [num(x["gain_diff"]), num(x["gain_diff_lower"]), num(x["eff"]), num(x["eff_lower"]), _fmt_p(x["p_gain"]),
                         _fmt_p(x["p_eff"]), dec + (" (search flagged)" if x.get("search") else "")]))
    return tabular("lrrrrrrl", ["Market", "F000$-$F111", "Lower", "F111 eff.", "Lower", "$p'_{\\mathrm{gain}}$", "$p'_{\\mathrm{eff}}$",
                                "Holm"], rows)


def q2(r: dict, fam: str) -> str:
    q = r["q2"]; s = q["searched"][fam]
    if isinstance(s, str):
        return tabular("ll", ["Contrast", "Status"], [("all", s)])
    rows = []
    for c in s:
        def cell(kind):
            v = q[kind][fam]
            return "n/a" if isinstance(v, str) or c not in v else num(v[c]["estimate"])
        rows.append((c, [num(s[c]["estimate"]), iv(s[c]["interval"]), cell("fixed"), cell("fixed_attack_term"), cell("fixed_reference_term"),
                         cell("searched_eff"), cell("searched_net_eff")]))
    return tabular("lrlrrrrr", ["Contrast", "Searched", "Interval", "Fixed", "Attack term", "Ref.\\ term", "Gross eff.", "Net eff."], rows)


def envelope(r: dict) -> str:
    rows = []
    for rule in CORE:
        for m in FRESH + ("headline",):
            x = r["q3"]["envelope"][rule][m]
            rows.append((f"{rule} {m}", x if isinstance(x, str) else [esc(x["family"]), num(x["estimate"]), iv(x["interval"])]))
    return tabular("llrl", ["Rule, market", "Family", "Gain", "Interval"], rows)


def welfare(r: dict) -> str:
    rows = []
    for rule in CORE:
        for obj in ("W0", "W1"):
            x = r["q3"]["welfare_selected"][rule][obj]
            if x.get("family") is None:
                rows.append((f"{rule} {obj}", x.get("status") or "n/a")); continue
            res, oth = x["result"], x["other_result"]
            if isinstance(res, str):
                rows.append((f"{rule} {obj}", f"{x['family']}: {res}")); continue
            other = esc(oth) if isinstance(oth, str) else num(oth["efficiency"])
            rows.append((f"{rule} {obj}", [esc(x["family"]), num(res["efficiency"]), iv(res["interval"]), num(res["attacker_gain"]),
                                           esc(res.get("w1_class") or "n/a"), esc(x["other_family"]), other]))
    return tabular("llrlrlll", ["Rule, objective", "Selected", "Gross eff.", "Interval", "Attacker gain", "W1 class", "Other", "Other eff."], rows)


def coalitions(r: dict) -> str:
    rows = []
    for rule in CORE:
        for g, x in r["q3"]["coalition"][rule].items():
            if isinstance(x, str):
                rows.append((f"{rule} {g}", x)); continue
            st = x.get("search") or x["G_min"].get("status") or ""
            rows.append((f"{rule} {g}", [num(x["G_tot"]["estimate"]), num(x["G_min"]["estimate"]), iv(x["G_min"]["bounds"]), esc(st or "answered")]))
    return tabular("lrrll", ["Rule, group", "$G_{\\mathrm{tot}}$", "$G_{\\min}$", "$G_{\\min}$ bounds", "Status"], rows)


def repair(r: dict) -> str:
    rows = []
    for rule, fams in r["secondary"]["repair_rho1"].items():
        for f, x in fams.items():
            rows.append((f"{rule} {f}", [num(x["estimate"]), iv(x["interval"])]))
    return tabular("lrl", ["Rule, family ($\\rho = 1$)", "Gain", "Interval"], rows or [("all", "no records")])


PAIR_LABELS = {"Q2-d": ("fixed", "searched"), "Q3-d": ("G_min", "G_tot"), "Q3-e": ("F111", "C*"), "Q3-g": ("R3", "R4"),
               "Q4-b": ("p'_gain", "p'_eff")}     # score_v2.py's pair order


def _p4(x) -> str:
    """Paired values at four decimals, so that close pairs stay distinguishable."""
    if x is None:
        return "n/a"
    t = f"{float(x):.4f}"
    return f"\\ensuremath{{{t}}}" if t.startswith("-") else t


def _pval(pid: str, v) -> str:
    if isinstance(v, (list, tuple)):
        labels = PAIR_LABELS.get(pid, tuple(f"value {i + 1}" for i in range(len(v))))
        return ", ".join(f"{esc(lab)} {_p4(x)}" for lab, x in zip(labels, v))
    return esc(v) if isinstance(v, str) else num(v)


def statements(md: str) -> dict:
    """Prediction id -> 'statistic (scope): fulfilled if', from the registered scoring table of predictions-v2.md."""
    out = {}
    for line in md.splitlines():
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", line.strip())[1:-1]]
        if len(cells) == 4 and re.fullmatch(r"Q\d-[a-z](-alt)?", cells[0]):
            out[cells[0]] = f"{cells[1]} ({cells[2]}): {cells[3]}".replace("\\|", "|")
    alt = re.search(r"\*\*Q1-a,[^\n]*\n\s*Alternative: ([^.]*)\.", md)          # the alternative is registered in the prose list
    if alt and "Q1-a" in out:
        out["Q1-a-alt"] = f"Q1 category, D2+H3 (pooled fresh), alternative to Q1-a: {alt.group(1)}"
    return out


def predictions(sc: dict, st: dict | None = None, ids: tuple | None = None) -> str:
    """The prediction scoring table (score_v2.py): the registered statement, the overall status, then each scored cell with
    its value and status; paired values carry their labels (they are two statistics, not an interval)."""
    rows = []
    for pid in sorted(sc):
        if ids and not pid.startswith(tuple(f"{q}-" for q in ids)):
            continue
        v = sc[pid]
        cells = "; ".join(f"{esc(c['cell'])} {_pval(pid, c['value'])} {esc(c['status'])}" for c in v.get("cells", [])) or "none scored"
        rows.append((pid, [esc((st or {}).get(pid, "")), esc(v["status"]), cells]))
    return tabular("lp{0.36\\linewidth}lp{0.34\\linewidth}", ["Prediction", "Registered statement", "Status", "Scored cells"], rows)


def all_tables(r: dict) -> dict:
    return {"q1": q1(r), "q1_side": q1_side(r), "q4": q4(r), "q2_d2h3": q2(r, "D2+H3"), "q2_x7sc": q2(r, "X7-SC"), "envelope": envelope(r),
            "welfare": welfare(r), "coalitions": coalitions(r), "repair": repair(r)}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--report", required=True); ap.add_argument("--dir", required=True)
    g = ap.add_mutually_exclusive_group(required=True); g.add_argument("--write", action="store_true"); g.add_argument("--check", action="store_true")
    ap.add_argument("--scoring", help="score_v2.py output; adds tables/predictions.tex")
    a = ap.parse_args(argv); tabs = all_tables(json.loads(Path(a.report).read_text())); d = Path(a.dir)
    ap_md = Path(__file__).resolve().parent.parent / "predictions-v2.md"
    if a.scoring:
        sc, st = json.loads(Path(a.scoring).read_text()), (statements(ap_md.read_text()) if ap_md.exists() else None)
        tabs["predictions"] = predictions(sc, st, ids=("Q1", "Q2"))          # two tables: one does not fit a page
        tabs["predictions_b"] = predictions(sc, st, ids=("Q3", "Q4"))
    if a.write:
        d.mkdir(parents=True, exist_ok=True)
        for k, v in tabs.items():
            (d / f"{k}.tex").write_text(v)
        return 0
    bad = [k for k, v in tabs.items() if not (d / f"{k}.tex").exists() or (d / f"{k}.tex").read_text() != v]
    print("\n".join(f"tables/{k}.tex: stale or missing" for k in bad) or "ok")
    return 1 if bad else 0


if __name__ == "__main__":
    sys.exit(main())

