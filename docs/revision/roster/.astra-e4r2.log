     1	"""Exploratory analyses on the second test's evaluation records, after the report (external review round 4, 2026-11-05).
     2	None of them is registered; none changes a registered estimate or decision. Gains follow the records' definition,
     3	g = (attacked profit - truthful reference profit) / (S*/N) with N = 10 (checked against the stored gain).
     4	
     5	1. Q1 split: the pooled d = g_C* - g_F111 as an attacked-profit term plus a reference-profit term, equal market weights.
     6	2. Welfare mixtures: an episode-level lottery between the selected W0 attack and a profitable attack of the same rule at
     7	   the headline market (same frozen reference), with the largest W0 weight whose mean gain keeps a nonnegative one-sided
     8	   95 percent lower bound on the evaluation seeds. This checks whether the W1 policy class is closed under randomisation;
     9	   the weight is chosen on the evaluation seeds, so it is not an out-of-sample estimate.
    10	3. Q4 diagnostics per fresh market: the B3 - R3 gain difference split into its two terms, and R3's audit spending and
    11	   served share under the selected attack.
    12	4. Stability: the registered-configuration re-evaluation (deviation/stability-result.json) beside the report.
    13	
    14	Usage: posthoc_v2.py --records EVAL/all --report report.json --stability stability-result.json --out posthoc.json --tables DIR
    15	"""
    16	import argparse
    17	import json
    18	import sys
    19	from pathlib import Path
    20	
    21	import numpy as np
    22	
    23	FRESH = tuple(f"fresh{i}" for i in range(6))
    24	N = 10
    25	Z = 1.645
    26	PROFIT_FAMS = ("D2+H3", "X7-SC", "X5-AG/v2", "H4", "D2")
    27	
    28	
    29	def safe(rid: str) -> str:
    30	    return rid.replace("|", "__").replace("/", "~").replace("*", "star")      # revision_v2._safe
    31	
    32	
    33	def _rec(out, rid):
    34	    p = Path(out) / "evaluate" / (safe(rid) + ".json")
    35	    return json.loads(p.read_text()) if p.exists() else None
    36	
    37	
    38	def _terms(r):
    39	    s = np.asarray(r["sstar"], dtype=float) / N
    40	    return np.asarray(r["profit_attack"], dtype=float) / s, np.asarray(r["profit_ref"], dtype=float) / s
    41	
    42	
    43	def split(out, markets, a: str, b: str, fam: str, n: int = N) -> dict:
    44	    """d = g_a - g_b per market and pooled with equal market weights, as attacked term + reference term."""
    45	    rows = {}
    46	    for m in markets:
    47	        ra, rb = _rec(out, f"{m}@rho0.2|{a}|{fam}|profit"), _rec(out, f"{m}@rho0.2|{b}|{fam}|profit")
    48	        if ra is None or rb is None:
    49	            continue
    50	        (pa, ta), (pb, tb) = _terms(ra), _terms(rb)
    51	        att, ref = pa - pb, -(ta - tb)
    52	        rows[m] = {"estimate": float(np.mean(att + ref)), "attacked": float(np.mean(att)), "reference": float(np.mean(ref))}
    53	    pooled = {k: float(np.mean([v[k] for v in rows.values()])) for k in ("estimate", "attacked", "reference")} if rows else {}
    54	    return {"markets": rows, "pooled": pooled}
    55	
    56	
    57	def mixture(gw0, ew0, gp, ep, grid: int = 2001) -> dict:
    58	    """The largest W0 weight w with mean(w gw0 + (1-w) gp) - Z se >= 0, and the mixture's mean gain and efficiency."""
    59	    gw0, ew0, gp, ep = (np.asarray(x, dtype=float) for x in (gw0, ew0, gp, ep))
    60	    best = 0.0
    61	    for w in np.linspace(0.0, 1.0, grid):
    62	        g = w * gw0 + (1 - w) * gp
    63	        if g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g)) >= 0:
    64	            best = float(w)
    65	    if best == 0.0 and not ((gp.mean() - Z * gp.std(ddof=1) / np.sqrt(len(gp))) >= 0):
    66	        return {"weight": 0.0, "estimate": float(gp.mean()), "efficiency": float(ep.mean())}
    67	    g, e = best * gw0 + (1 - best) * gp, best * ew0 + (1 - best) * ep
    68	    return {"weight": best, "estimate": float(g.mean()), "lower": float(g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g))),
    69	            "efficiency": float(e.mean())}
    70	
    71	
    72	def weight_label(w: float) -> str:
    73	    """Two decimals in percent: the bound is near zero at the selected weight, and rounding can flip its sign."""
    74	    return f"{100 * w:.2f} percent"
    75	
    76	
    77	def welfare_mixtures(out, rule: str) -> dict:
    78	    ctx = "headline@rho0.2"; w0 = _rec(out, f"{ctx}|{rule}|D2+H3|W0"); w1 = _rec(out, f"{ctx}|{rule}|D2+H3|W1")
    79	    ref = np.asarray(w1["normalized"]) - np.asarray(w1["constraint"]); gw0 = np.asarray(w0["normalized"]) - ref
    80	    res = {"w0": {"estimate": float(gw0.mean()), "efficiency": float(np.mean(w0["eff"]))},
    81	           "w1": {"estimate": float(np.mean(w1["constraint"])), "efficiency": float(np.mean(w1["eff"]))}, "mixtures": {}}
    82	    for fam in PROFIT_FAMS:
    83	        r = _rec(out, f"{ctx}|{rule}|{fam}|profit")
    84	        if r is None or r["seeds"] != w0["seeds"]:
    85	            continue
    86	        mx = mixture(gw0, w0["eff"], r["gain"], r["eff_attack"])
    87	        mx["weight_label"] = weight_label(mx["weight"])
    88	        res["mixtures"][fam] = mx
    89	    feasible = {f: v for f, v in res["mixtures"].items() if v["weight"] > 0}
    90	    if feasible:
    91	        f = min(feasible, key=lambda k: feasible[k]["efficiency"]); res["best"] = {"family": f, **feasible[f]}
    92	    return res
    93	
    94	
    95	def q4_diagnostics(out) -> dict:
    96	    res = {}
    97	    for m in FRESH:
    98	        sp = split(out, [m], "F000", "F111", "D2+H3")["markets"].get(m)
    99	        r = _rec(out, f"{m}@rho0.2|F111|D2+H3|profit")
   100	        if sp is None or r is None:
   101	            continue
   102	        res[m] = {**sp, "audit_spend": float(np.mean(r["audit_spend_attack"])), "served_share": float(np.mean(r["served_share_attack"])),
   103	                  "efficiency": float(np.mean(r["eff_attack"]))}
   104	    return res
   105	
   106	
   107	def stability(report: dict, stab: dict) -> dict:
   108	    q1 = {k: {"estimate_report": report["q1"]["tests"][k]["estimate"], "estimate_registered_cfg": v["estimate"],
   109	              "category_report": report["q1"]["tests"][k]["category"], "category_registered_cfg": v["category"]}
   110	          for k, v in stab["q1_new"].items()}
   111	    shifts = [abs(c["mean_new"] - c["mean_old"]) for c in stab["cells"].values()]
   112	    return {"q1": q1, "q4_k_report": report["q4"]["k"], "q4_k_registered_cfg": stab["q4_new"]["k"],
   113	            "cells": len(shifts), "max_mean_shift": float(max(shifts)), "decisions_unchanged": bool(stab["decisions_unchanged"])}
   114	
   115	
   116	def _f(x, d: int = 3):
   117	    return "n/a" if x is None else (f"\\ensuremath{{{x:.{d}f}}}" if x < 0 else f"{x:.{d}f}")
   118	
   119	
   120	def tables(res: dict) -> dict:
   121	    t = {}
   122	    rows = [f"{fam} & {_f(v['pooled']['estimate'])} & {_f(v['pooled']['attacked'])} & {_f(v['pooled']['reference'])} \\\\"
   123	            for fam, v in res["q1_split"].items()]
   124	    t["q1_split"] = ("\\begin{tabular}{@{}lrrr@{}}\\toprule\nFamily & $d$ & Attacked term & Reference term \\\\\\midrule\n"
   125	                     + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
   126	    rows = []
   127	    for r, v in res["welfare"].items():
   128	        b = v.get("best")
   129	        rows.append(f"{r} & {_f(v['w1']['efficiency'])} & {_f(v['w0']['efficiency'])} & "
   130	                    + (f"{b['family']} & {b['weight_label']} & {_f(b['estimate'])} & {_f(b['efficiency'])}" if b else "none & & &")
   131	                    + " \\\\")
   132	    t["welfare_mix"] = ("\\begin{tabular}{@{}lrrlrrr@{}}\\toprule\nRule & W1 eff. & W0 eff. & Mixed with & W0 weight & Mixed gain & Mixed eff. \\\\\\midrule\n"
   133	                        + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
   134	    rows = [f"{m} & {_f(v['estimate'])} & {_f(v['attacked'])} & {_f(v['reference'])} & {_f(v['audit_spend'])} & {_f(v['served_share'])} \\\\"
   135	            for m, v in res["q4_diag"].items()]
   136	    t["q4_diag"] = ("\\begin{tabular}{@{}lrrrrr@{}}\\toprule\nMarket & B3$-$R3 gain & Attacked term & Reference term & R3 audit spend & R3 served share \\\\\\midrule\n"
   137	                    + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
   138	    rows = [f"{k} & {_f(v['estimate_report'], 4)} & {_f(v['estimate_registered_cfg'], 4)} & {v['category_registered_cfg']} \\\\" for k, v in res["stability"]["q1"].items()]
   139	    t["stability"] = ("\\begin{tabular}{@{}lrrl@{}}\\toprule\nQ1 test & $d$, report & $d$, registered configs & Category, registered configs \\\\\\midrule\n"
   140	                      + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
   141	    return t
   142	
   143	
   144	def main(argv=None) -> int:
   145	    ap = argparse.ArgumentParser()
   146	    for k in ("--records", "--report", "--stability", "--out", "--tables"):
   147	        ap.add_argument(k, required=True)
   148	    a = ap.parse_args(argv)
   149	    out = Path(a.records); report = json.loads(Path(a.report).read_text()); stab = json.loads(Path(a.stability).read_text())
   150	    res = {"label": "exploratory, after the report; not registered",
   151	           "q1_split": {f: split(out, FRESH, "C*", "F111", f) for f in ("D2+H3", "X7-SC")},
   152	           "welfare": {r: welfare_mixtures(out, r) for r in ("F000", "F111", "C*")},
   153	           "q4_diag": q4_diagnostics(out), "stability": stability(report, stab)}
   154	    Path(a.out).write_text(json.dumps(res, indent=1) + "\n")
   155	    d = Path(a.tables); d.mkdir(parents=True, exist_ok=True)
   156	    for k, v in tables(res).items():
   157	        (d / f"posthoc_{k}.tex").write_text(v.replace("C*", "C$^*$"))
   158	    print(json.dumps({r: v.get("best") for r, v in res["welfare"].items()}, indent=1))
   159	    return 0
   160	
   161	
   162	if __name__ == "__main__":
   163	    sys.exit(main())

