    48	def _imports(path: Path) -> set:
    49	    names = set()
    50	    for n in ast.walk(ast.parse(path.read_text(), filename=str(path))):
    51	        if isinstance(n, ast.Import):
    52	            names |= {a.name.split(".")[0] for a in n.names}
    53	        elif isinstance(n, ast.ImportFrom) and n.module and n.level == 0:
    54	            names.add(n.module.split(".")[0])
    55	    return names
    56	
    57	
    58	def import_closure(root, start, search) -> set:
    59	    """Every repo file outside sim/, scripts/ and the virtual environment reachable by imports (at any depth, inside
    60	    functions too) from the start files, resolved along `search` as the drivers' sys.path does; paths relative to root."""
    61	    root = Path(root).resolve(); seen, todo = set(), [root / f for f in start]
    62	    while todo:
    63	        p = todo.pop().resolve(); rel = str(p.relative_to(root))
    64	        if rel in seen:
    65	            continue
    66	        seen.add(rel)
    67	        for name in _imports(p):
    68	            for d in [p.parent, *map(Path, search)]:
    69	                q = (Path(d) / f"{name}.py").resolve()
    70	                if q.is_file():
    71	                    r = q.relative_to(root).parts
    72	                    if r[0] not in (*FROZEN, ".venv"):
    73	                        todo.append(q)
    74	                    break
    75	    return seen
