    20	        for i, m in enumerate(MK):
    21	            base = {"R3": 0.10, "C*": 0.12, "C-thr": 0.11, "B3": 0.30}
    22	            g = {r: [v + 0.001 * ((s + i) % 5) for s in range(n)] for r, v in base.items()}
    23	            g["R3"] = [x + shift[p] + 0.002 * i for x in g["R3"]]
    24	            out[p][m] = g
