    13	def ruling_problems(notes: str, plan: str) -> list:
    14	    sec = notes.split("## Rulings", 1)[1].split("\n## ", 1)[0] if "## Rulings" in notes else ""
    15	    items = re.split(r"\n(?=\d+\. )", "\n" + sec)
    16	    out, plan_n = [], _norm(plan)
    17	    for it in [i for i in items if re.match(r"\d+\. ", i.strip())]:
    18	        n = it.strip().split(".", 1)[0]
    19	        quotes = re.findall(r'Plan: "([^"]+)"', it)
    20	        if not quotes:
    21	            out.append(f"ruling {n}: no quoted plan text")
    22	        out += [f"ruling {n}: quote not in the plan: {q[:60]}" for q in quotes if _norm(q) not in plan_n]
    23	    if not items or not any(re.match(r"\d+\. ", i.strip()) for i in items):
    24	        out.append("no rulings section")
    25	    return out
    26	
