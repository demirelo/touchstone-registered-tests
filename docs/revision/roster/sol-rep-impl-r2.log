    45	def continuation_queue(flagged: list[dict]) -> list[dict]:
    46	    """The flagged cells in the fixed order: rate 0.05, 0.03, 0; markets fresh0..5; rules R3, C*, C-thr, B3.
    47	    Each item: {"rate": float, "market": str, "rule": "F111" | "C*" | "Cthr" | "F000", ...}."""
    48	    rk = {r: i for i, r in enumerate(CONT_RATE_ORDER)}; uk = {r: i for i, r in enumerate(CONT_RULE_ORDER)}
    49	    bad = [c for c in flagged if c["rate"] not in rk or c["rule"] not in uk or c["market"] not in MARKETS]
    50	    if bad:
