def _refuse(msg: str):
    raise SystemExit(f"runner-up follow-up refused: {msg}")


def runner_up_cred() -> dict:
    rec = read(LOG)
    if rec is None or not rec.get("recheck"):
        _refuse(f"no full-budget recheck record at {LOG}")
    return dict(rec["spec"]["cred"])


def runner_up_params(base: dict) -> dict:
    return {**base, "cred": runner_up_cred()}


def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, markets=MARKETS, smoke: bool = False) -> list[dict]:
    jobs = []
    for m in markets:
        mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
        jobs += [R.job(mkt, LABEL, fam, "profit", smoke=smoke, params=params) for fam in FAMS]
    return jobs


def bank_inputs(src, contexts) -> dict[str, str]:
def _run_one(stage: str, job: dict, out: str, cuts: int, h4_excluded: bool, catalog: list | None = None) -> str:
    out = Path(out); catalog = catalog or [job]
    if stage == "reference":
        return _run_reference(job, out, cuts, h4_excluded, catalog)
    if stage == "cross":
        return _run_cross(job, out, catalog)
    if stage in COALITION_STEPS:
        return coalition_step(stage, job, out, catalog)
    p = _stage_record_path(stage, job, out); rec = read(p)
    want = stage_upstream(stage, job, catalog, cuts, h4_excluded)
    def check():
        if set(rec.get("upstream") or {}) != want:
            raise ValueError("dependency set")
        validate(job, stage, rec, {u: path_of(out, u) for u in want})
        if stage == "evaluate":                                         # a damaged current record is recomputed, not skipped
            bad = _schema_problems(job, rec, len(job["mkt"]["seeds_eval"]))
            if bad:
                raise ValueError(bad)
        if stage == "doubling" and "heldout" not in rec:
            raise ValueError("doubling record without its held-out diagnostic")
    if reusable(p, rec, job["provenance"], check):
        return "skipped"
    body = {"search": stage_search, "dependent": stage_dependent, "evaluate": stage_evaluate}.get(stage)
    rec = body(job, out) if body else stage_doubling(job, out, cuts, h4_excluded)
    upstream = rec.pop("upstream", None)
    if stage in ("evaluate", "doubling") or upstream is None:
        upstream = {u: sha_file(path_of(out, u)) for u in sorted(want)}
    write(p, {"stage": stage, "id": job["id"], "provenance": job["provenance"], "upstream": upstream, **rec})
    return "done"

def _run_rate(out, jobs, steps, a, salt_sha, container, p, started) -> None:
    F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
    if not a.smoke:
        F.check_pairing(a.src, jobs)
    slow = 1.33 if p > 0 else 1.0
    lim = None if a.smoke else memory_limit()                                   # review r4: the limit persists across commands
    sv = saved_workers(out, lim); w_mem = min(a.workers_eval, sv) if sv else a.workers_eval
    cap = lambda need: check_cap(started, need, a.stop_usd, a.usd_per_hour, prior_usd=a.prior_usd)
    for st in steps:
        if st == "inputs":
            F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
        elif st == "search":
            cap(STAGE_SECONDS["search"] * slow * _waves(len(jobs), a.workers_search)); run_stage("search", jobs, out, a.workers_search)
        elif st == "freeze":
            F.prefreeze(out, jobs)
        elif st in ("evaluate", "doubling"):
            sec = STAGE_SECONDS[st] * slow
            k = len(preflight_sample(st, jobs)) if (not a.smoke and len(jobs) > 1) else 0
            cap(sec * (k + _waves(len(jobs) - k, w_mem)))                       # admission includes the serial preflight tasks
            F.accept(out, jobs, salt_sha, container, src=a.src)
            if k:
                mp = memory_preflight(st, jobs, out, w_mem)
                w_mem = save_workers(out, min(w_mem, mp["workers"]), mp.get("limit_bytes", lim), st)
                fresh = set() if mp.get("reused") else set(mp["measured"])      # just run in this command: their records exist
                cap(sec * _waves(len(jobs) - len(fresh), w_mem))                 # admission again with the chosen workers
            run_stage(st, jobs, out, w_mem)       # review r5: every job passes through _run_one, which skips a valid record
                                                  # and recomputes a missing or damaged one
        elif st == "diagnostics":
            if not a.smoke and len(jobs) > 1:
                sv = saved_workers(out, lim)
                if sv is None:
                    raise SystemExit("churn arm refused: diagnostics needs memory evidence (an evaluate or doubling preflight "
                                     "of this output on this memory limit)")
                w_mem = min(w_mem, sv)
            cap(STAGE_SECONDS["diagnostics"] * slow * _waves(len(jobs), w_mem))
            write(Path(out) / "diagnostics.json", diagnostics(out, jobs, w_mem))
        else:
            inventory(out, p)
        print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs), "workers_memory": w_mem}), flush=True)


def main(argv=None) -> int:
def _num(x) -> bool:
    return isinstance(x, (int, float)) and not isinstance(x, bool) and bool(np.isfinite(x))


def _schema_problems(j: dict, rec: dict, n: int) -> str | None:
    """The evaluate record's complete shape for its objective (stage_evaluate's fields, n seeds, finite numbers only), or
    what is wrong."""
    obj = j["objective"]; ln = lambda k: isinstance(rec.get(k), list) and len(rec[k]) == n and all(_num(x) for x in rec[k])
    if obj == "diagnostic":
        bins = rec.get("bins")
        ok = isinstance(bins, list) and bins and all(all(_num(b.get(k)) for k in ("audited_share", "profit_per_round", "false_refund")) for b in bins)
        return None if ok and len(rec.get("seeds") or []) == n else "diagnostic bins missing, nonfinite, or of the wrong seed count"
    if obj == "profit":
        bad = [k for k in GAIN_FIELDS if not ln(k)]
        return f"profit fields missing or of the wrong length: {bad}" if bad else None
    if obj in ("W0", "W1"):
        if rec.get("no_feasible_candidate") is True:
            return None
        bad = [k for k in ("eff", "normalized") + (("constraint",) if obj == "W1" else ()) if not ln(k)]
        return f"welfare fields missing or of the wrong length: {bad}" if bad else None
    mg = rec.get("member_gain")
    if not (isinstance(mg, list) and len(mg) == int(j["c"]) and all(isinstance(r, list) and len(r) == n and all(_num(x) for x in r) for r in mg)):
        return f"member_gain is not {j['c']} members x {n} finite seeds"
    if not (_num(rec.get("total")) and _num(rec.get("min"))):
        return "the stored total and minimum must be finite numbers"
    means = [float(np.mean(r)) for r in mg]
    if abs(float(rec["total"]) - sum(means)) > 1e-9 or abs(float(rec["min"]) - min(means)) > 1e-9:
        return "the stored total or minimum differs from the member gains"
    return None


def _cross_problems(rec: dict, rules: list[str], n: int) -> str | None:
    """A cross record covers every (attack, rule) pair of the bank with n seeds, and its matrix holds the row means."""
    if list(rec.get("attacks") or []) != list(rules) or list(rec.get("rules") or []) != list(rules):
        return "attacks or rules differ from the bank's factorial rules"
    rows = rec.get("per_seed") or {}
    if set(rows) != {f"{a}>{r}" for a in rules for r in rules} or any(not isinstance(v, list) or len(v) != n for v in rows.values()):
        return "per-seed rows are incomplete or of the wrong length"
    if not all(_num(x) for v in rows.values() for x in v):
        return "per-seed rows must hold finite numbers"
    mat = rec.get("matrix") or []
    if not (isinstance(mat, list) and all(isinstance(row, list) and all(_num(x) for x in row) for row in mat)):
        return "the matrix must hold finite numbers"
    if len(mat) != len(rules) or any(len(row) != len(rules) for row in mat) or any(
            abs(float(mat[i][k]) - float(np.mean(rows[f"{a}>{r}"]))) > 1e-9 for i, a in enumerate(rules) for k, r in enumerate(rules)):
        return "the matrix differs from the per-seed row means"
    pr = rec.get("profit_rows") or {}
    if set(pr) != set(rows) or any(not all(isinstance(v.get(k), list) and len(v[k]) == n and all(_num(x) for x in v[k])
                                           for k in ("profit_attack", "profit_ref", "eff_attack", "net_eff_attack")) for v in pr.values()):
        return "profit rows (design 6.6 decomposition) are missing or incomplete"
    return None


def _check_evaluate(j: dict, rec: dict, out: Path, catalog: list[dict], cuts: int, h4_excluded: bool, seeds: list | None) -> None:
    want = stage_upstream("evaluate", j, catalog, cuts, h4_excluded)
    if rec.get("stage") != "evaluate" or set(rec.get("upstream") or {}) != want:
        raise ValueError("stage or dependency set")
    validate(j, "evaluate", rec, {u: path_of(out, u) for u in want})
    n = len(j["mkt"]["seeds_eval"])
    if rec.get("seeds") != list(j["mkt"]["seeds_eval"]) or (seeds is not None and list(seeds[:n]) != rec.get("seeds")):
        raise ValueError("seeds differ from the instance's")
    problem = _schema_problems(j, rec, n)
    if problem:
        raise ValueError(problem)
    if not _numbers_ok(rec):
        raise ValueError("nonfinite values")


def verify(out: Path, catalog: list[dict], selected: list[dict], instances: dict | None, protocol: dict | None, h4: dict | None,
                c["stale"].append(item["id"])
        for _, items in _waves("doubling", sel, catalog):
            for j in items:
                p = _stage_record_path("doubling", j, out); rec = read(p)
                if rec is None:
                    c["missing_doubling"].append(j["id"]); continue
                if rec.get("provenance") != j["provenance"]:
                    c["foreign"].append(p.name); continue
                want = stage_upstream("doubling", j, catalog, cuts, h4_excluded)
                try:
                    if rec.get("stage") != "doubling" or set(rec.get("upstream") or {}) != want:
