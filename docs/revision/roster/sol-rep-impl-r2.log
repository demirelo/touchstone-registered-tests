    17	EV = T["eval160"]["profit"] * 200 / 160
    18	DIAG = 60.0
    19	
    20	
    21	def waves(n: int, w: int) -> int:
    22	    return math.ceil(n / w) if n else 0
    23	
    24	
    25	DIRS = {"menu": (MARKETS * 3, 3), "cthr": (MARKETS, 1)}   # rate directories: (jobs, rules) of R3, C*, B3 and of C-thr(12)
    26	
    27	
    28	def _dir_eval_doubling(n: int, rules: int, slow: float) -> tuple:
    29	    """(core s, schedule s) of one directory's evaluation and doubling: the churn arm first runs one evaluation task per
    30	    rule and one doubling task serially as its memory preflight (churn_v2.preflight_sample), then the rest in waves."""
    31	    core = n * (EV + T["doubling"]) * slow
    32	    sched = ((rules + waves(n - rules, W_EVAL)) * EV + (1 + waves(n - 1, W_EVAL)) * T["doubling"]) * slow
    33	    return core, sched
    34	
    35	
    36	def estimate(flag_share: float, rounds: int = 3) -> dict:
    37	    cells = (1 + len(RATES)) * MARKETS * RULES                      # 72 evaluation cells
    38	    menu_d2 = MARKETS * (MENU_RULES + 1)                            # ten matched rules plus C-thr(12), D2+H3
    39	    menu_x7 = MARKETS * (MENU_RULES + 1)                            # the same in X7-SC; menu X7-SC winners get no doubling
    40	    flagged = round(flag_share * cells)
    41	    cont_round = (T["doubling"] + EV) * SLOW                        # one continuation round; round 1 repeats the doubling
    42	    p0 = [_dir_eval_doubling(n, k, 1.0) for n, k in DIRS.values()]
    43	    churn = [_dir_eval_doubling(n, k, SLOW) for _ in RATES for n, k in DIRS.values()]
    44	    search = [(n * T["d2h3_cell"] * SLOW, waves(n, W_SEARCH) * T["d2h3_cell"] * SLOW) for _ in RATES for n, _ in DIRS.values()]
    45	    diag_dirs = [(n * 2 * DIAG * s, waves(n, W_EVAL) * DIAG * s) for s in (1.0, SLOW, SLOW) for n, _ in DIRS.values()]
