   102	def _git(root, *a) -> subprocess.CompletedProcess:
   103	    return subprocess.run(["git", "-C", str(root), *a], capture_output=True, text=True)
   104	
   105	
   106	def frozen_problems(root, commit: str) -> list:
   107	    out = []
   108	    paths = [*FROZEN, *[f for f in FROZEN_INPUTS if (Path(root) / f).exists() or _git(root, "cat-file", "-e", f"{commit}:{f}").returncode == 0]]
   109	    changed = _git(root, "diff", "--name-only", commit, "--", *paths).stdout.split()
   110	    if changed:
   111	        out.append(f"differ from commit {commit}: {', '.join(changed[:5])}")
   112	    untracked = _git(root, "ls-files", "--others", "--exclude-standard", "--", *paths).stdout.split()
   113	    if untracked:
   114	        out.append(f"untracked files under {', '.join(FROZEN)}: {', '.join(untracked[:5])}")
   115	    out += [f"environment override set: {v}" for v in OVERRIDES if os.environ.get(v)]
   116	    return out
   117	
   118	
   119	def require(root, manifest, required=None) -> None:
   120	    m = json.loads(Path(manifest).read_text())
   121	    bad = frozen_problems(root, m["commit"]) + verify(root, manifest, required)
   122	    if bad:
   123	        raise SystemExit("commitment check failed:\n" + "\n".join(bad))
   124	
   125	
   126	def main(argv) -> int:
   127	    root = Path(_git(".", "rev-parse", "--show-toplevel").stdout.strip())
   128	    if argv[0] == "build":
   129	        Path(argv[1]).write_bytes(build(root, argv[3:], argv[2])); print("manifest written"); return 0
   130	    require(root, argv[1]); print("commitment ok"); return 0
   131	
   132	
   133	if __name__ == "__main__":
   134	    sys.exit(main(sys.argv[1:]))
