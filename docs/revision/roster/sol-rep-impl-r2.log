    23	
    24	def _mean(xs):
    25	    return sum(xs) / len(xs)
    26	
    27	
    28	def _finite(xs) -> bool:
    29	    return bool(xs) and all(isinstance(x, (int, float)) and math.isfinite(x) for x in xs)
    30	
    31	
    32	def _check(gains: dict) -> None:
    33	    """Every present cell finite; within a market every rule and rate has the same number of seeds."""
    34	    for m in MARKETS:
    35	        lens = set()
    36	        for p in ALL_RATES:
