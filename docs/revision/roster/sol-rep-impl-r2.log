   346	            steps = ("inputs", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if p == 0 else \
   347	                    ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory")
   348	            churn_v2._run_rate(out, rate_jobs(c, kind, p, a.smoke), steps, _rate_args(a, src), c.salt, c.container, p, a.started)
