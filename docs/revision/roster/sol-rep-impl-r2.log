    78	def build(root, files, commit: str, required=None, search=None) -> bytes:
    79	    root = Path(root); files = sorted(set(files))
    80	    need = set(REQUIRED if required is None else required)
    81	    py = [f for f in files if f.endswith(".py")]
    82	    need |= import_closure(root, py, search_dirs(root) if search is None else search)
    83	    if missing := sorted(need - set(files)):
    84	        raise SystemExit(f"manifest refused: required or imported files not listed: {missing}")
    85	    body = {"commit": commit, "files": {f: _sha(root / f) for f in sorted(set(files))},
    86	            "note": "churn replication commitment; docs/revision/followup3/replication-plan.md"}
    87	    return (json.dumps(body, indent=1, sort_keys=True) + "\n").encode()
    88	
    89	
    90	def verify(root, manifest, required=None) -> list:
    91	    root = Path(root); m = json.loads(Path(manifest).read_text())
    92	    out = [f"{f}: required but not listed" for f in (REQUIRED if required is None else required) if f not in m["files"]]
    93	    for f, h in m["files"].items():
    94	        p = root / f
    95	        if not p.exists():
    96	            out.append(f"{f}: missing")
    97	        elif _sha(p) != h:
    98	            out.append(f"{f}: hash differs from the manifest")
    99	    return out
