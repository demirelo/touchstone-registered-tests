   373	def cost_stop(a):
   374	    """The continuation's per-round admission (Run B's worker cost stop): the stop cap, the price ceiling, the pod's
   375	    request time, earlier spend, and the launcher's STOP file and soft deadline. None in smoke runs."""
   376	    from guards import CostStop
