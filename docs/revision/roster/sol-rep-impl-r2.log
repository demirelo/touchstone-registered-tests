    49	        # the serial memory preflight of each directory; the gate round always run; continued-winner diagnostics)
    50	        "calibration": (CALIB_H * 3600, CALIB_H * 3600),
    51	        "menu_d2h3": (menu_d2 * T["d2h3_cell"], waves(menu_d2, W_SEARCH) * T["d2h3_cell"]),
    52	        "menu_x7": (menu_x7 * T["x7_cell"], waves(menu_x7, W_SEARCH) * T["x7_cell"]),     # needs the embedded D2+H3 winner
    53	        "references": (MARKETS * RULES * T["reference"], MARKETS * RULES * T["reference"]),               # serial, as Run A
    54	        "p0_eval_doubling": tuple(map(sum, zip(*p0))),
