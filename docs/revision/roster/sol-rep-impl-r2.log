   316	def rate_jobs(c, rules_kind: str, p: float, smoke: bool) -> list[dict]:
   317	    """The evaluation jobs of one branch (targets in menu/, or C-thr in cthr/) at one rate; p = 0 jobs are ordinary jobs
   318	    (their search record is the menu record), p > 0 jobs carry churn."""
   319	    import churn_v2
   320	    import revision_v2 as R
   321	    import runnerup_v2 as U
   322	    params = U.runner_up_params(c.params) if rules_kind == "cthr" else c.params
   323	    rules = ("C*",) if rules_kind == "cthr" else TARGETS
   324	    if p == 0:
   325	        jobs = []
   326	        for m in MARKETS:
   327	            mkt = R.market(m, c.root, 0.2, smoke=smoke, cfg=c.cfgs[m], salt_sha256=c.salt)
   328	            jobs += [R.job(mkt, r, "D2+H3", "profit", smoke=smoke, params=params) for r in rules]
   329	        return jobs
   330	    return churn_v2.build_jobs(c.root, c.cfgs, params, c.salt, p, MARKETS, rules, smoke)
