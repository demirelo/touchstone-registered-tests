    42	def search_dirs(root) -> list:
    43	    """The drivers' import path outside the standard library (rep_v2.py, rep_collect.py): their own folders and the repo."""
    44	    root = Path(root)
    45	    return [root / F3, root / CH, root / F2, root / F1, root, root / "scripts"]
