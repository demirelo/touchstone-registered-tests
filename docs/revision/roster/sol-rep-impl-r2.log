    63	def admit_workers(requested: int, limit_bytes: int | None, peak_bytes: float, parent_bytes: float = 2e9, headroom: float = 1.25) -> int:
    64	    """Pod-memory admission (plan section 5): the largest worker count whose measured peak with 25 percent headroom,
    65	    plus the parent, fits the pod's cgroup limit; at least 1 only if one task fits, else refuse."""
    66	    if limit_bytes is None:
    67	        return requested
    68	    fit = int((limit_bytes - parent_bytes) // (peak_bytes * headroom))
    69	    if fit < 1:
