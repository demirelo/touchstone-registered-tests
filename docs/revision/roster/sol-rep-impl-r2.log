   269	def _menu_freeze(out: Path, jobs: list[dict]) -> None:
   270	    """A follow-up freeze per context: every search record and the targets' references, each validated (stage,
   271	    provenance, dependency set and hashes), so the reset driver's input and pairing checks can read this directory."""
   272	    import revision_v2 as R
   273	    from reset_followup_v2 import CUTS, DEVIATIONS, H4_EXCLUDED
   274	    from runnerup_v2 import _validate_new
   275	    from sim.records_v2 import read, write
   276	    for ctx in sorted({j["context"] for j in jobs}):
   277	        cj = [j for j in jobs if j["context"] == ctx]
   278	        recs = {j["id"]: _validate_new(out, j["id"], "search", j["provenance"], jobs) for j in cj}
   279	        for t in TARGETS:
   280	            rid = f"reference/{ctx}/{t}"
   281	            recs[rid] = _validate_new(out, rid, "reference", R.reference_provenance(next(j for j in cj if j["rule"] == t)), jobs)
   282	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS,
   283	                "h4_excluded": H4_EXCLUDED, "records": recs}
   284	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   285	        if old is not None and old != body:
   286	            _refuse(f"{p} exists with other records")
   287	        if old is None:
   288	            write(p, body)
