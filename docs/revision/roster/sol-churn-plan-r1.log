   835	
   836	def stage_cross(ctx: str, family: str, catalog: list[dict], out: Path) -> dict:
   837	    bank = read(path_of(out, f"bank/{ctx}/{family}")); by_rule, rules = _cross_rules(ctx, family, catalog, bank); cache = SeedCache(); mat, rows, prof = [], {}, {}
   838	    prov, ids = cross_expected(ctx, family, catalog, out)
   839	    up = {u: sha_file(path_of(out, u)) for u in sorted(ids)}
   840	    for a in rules:
   841	        row = []
   842	        for r in rules:
   843	            j = by_rule[r]; T, L = constants(j); fam = family_for(family, T, L); cell = eval_cell(j)
   844	            cand, _, _ = reference_of(j, out)
   845	            att = run_focal(cell, lambda: fam.make(dict(bank["attacks"][a])), cache); ref = run_focal(cell, cand.policy_factory, cache)
   846	            scale = np.array([x.sstar for x in att.results]) / cell.cfg.N; gain = (att.profit - ref.profit) / scale
   847	            rows[f"{a}>{r}"] = gain.tolist(); row.append(float(gain.mean()))
   848	            prof[f"{a}>{r}"] = {"profit_attack": (att.profit / scale).tolist(), "profit_ref": (ref.profit / scale).tolist(),     # design 6.6 terms
   849	                                "eff_attack": gross_efficiency(att.results).tolist(), "net_eff_attack": [float(x) for x in _net_eff(att.results)]}
   850	        mat.append(row)
   851	    env = {r: (read(path_of(out, f"envelope_select/{ctx}/{r}/{family}")) or {}).get("choice") for r in rules}
   852	    return {"stage": "cross", "provenance": prov, "upstream": up, "context": ctx, "family": family, "attacks": rules, "rules": rules,
   853	            "matrix": mat, "per_seed": rows, "profit_rows": prof, "envelope": env}
