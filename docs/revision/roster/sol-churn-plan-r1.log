   818	def _cross_rules(ctx: str, family: str, catalog: list[dict], bank: dict) -> tuple[dict, list]:
   819	    by_rule = {j["rule"]: j for j in catalog if j["context"] == ctx and j["family"] == family and j["objective"] == "profit" and j["rule"] in MAN.FACTORIAL}
   820	    return by_rule, [r for r in MAN.FACTORIAL if r in by_rule and r in bank["attacks"]]
