   862	# ---- doubling ----------------------------------------------------------------------------------------------------------
   863	
   864	def doubling_report(kind: str, old: dict, new: dict) -> dict:
   865	    """Changes in the objective's units (design 6.5): profit (attack and reference normalised profit), welfare (gross
   866	    efficiency, lower is a better attack), w1 (efficiency and feasibility), coalition (objective)."""
   867	    rep = {"kind": kind}
   868	    if kind == "profit":
   869	        rep["attack_change"] = float(new["attack_f"] - old["attack_f"]); rep["reference_change"] = float(new["ref_f"] - old["ref_f"])
   870	        changes = [rep["attack_change"], rep["reference_change"]]
   871	    elif kind in ("welfare", "w1"):
   872	        rep["efficiency_change"] = float(old["eff"] - new["eff"]) if old.get("eff") is not None and new.get("eff") is not None else 0.0
   873	        changes = [rep["efficiency_change"]]
   874	        if kind == "w1":
   875	            rep["feasibility_transition"] = bool(old.get("feasible") is False and new.get("feasible") is True)
   876	    elif kind == "coalition":
   877	        rep["objective_change"] = float(new["f"] - old["f"]); changes = [rep["objective_change"]]
   878	    else:
   879	        raise ValueError(kind)
   880	    rep["incomplete"] = bool(any(c >= THRESHOLD - 1e-12 for c in changes) or rep.get("feasibility_transition", False))
   881	    return rep
