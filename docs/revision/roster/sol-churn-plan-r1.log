    62	def test_churn_jobs_have_their_own_ids_and_provenance():
    63	    j = {"id": "fresh0@rho0.2|F111|D2+H3|profit", "context": "fresh0@rho0.2", "rule": "F111", "family": "D2+H3",
    64	         "provenance": {"id": "fresh0@rho0.2|F111|D2+H3|profit", "cfg_sha256": "c"}}
    65	    k = C.churn_job(j, 0.05)
    66	    assert k["id"] == "fresh0@rho0.2|F111|D2+H3|profit|churn0.05" and k["provenance"]["id"] == k["id"] and k["provenance"]["churn"] == 0.05
    67	    assert C.R.path_of(Path("/o"), k["id"]) != C.R.path_of(Path("/o"), j["id"]) and k["churn"] == 0.05 and "churn" not in j
