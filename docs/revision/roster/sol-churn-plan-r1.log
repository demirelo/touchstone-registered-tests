    26	def test_churn_policy_is_honest_and_exits_at_rate_p():
    27	    pol = C.HonestChurn(0.05); honest = HonestMax().act(_view(1))
    28	    acts = [pol.act(_view(s)) for s in range(4000)]
    29	    assert all(a.effort == honest.effort and a.offer == honest.offer for a in acts)          # truthful delivery and offer
    30	    rate = np.mean([a.exit for a in acts])
    31	    assert 0.04 < rate < 0.06                                                                  # 4000 draws: sd about 0.0034
    32	    assert [pol.act(_view(s)).exit for s in range(50)] == [C.HonestChurn(0.05).act(_view(s)).exit for s in range(50)]   # deterministic
    33	
    34	
    35	def test_churn_zero_is_honest_max():
    36	    assert not any(C.HonestChurn(0.0).act(_view(s)).exit for s in range(500))
