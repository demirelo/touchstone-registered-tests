   823	def cross_expected(ctx: str, family: str, catalog: list[dict], out: Path) -> tuple[dict, set]:
   824	    """The provenance and dependency ids of a cross record, derived independently of any stored record."""
   825	    bank = read(path_of(out, f"bank/{ctx}/{family}"))
   826	    if bank is None:
   827	        raise SystemExit(f"cross {ctx}/{family}: no fixed-attack bank")
   828	    if read(path_of(out, f"bank_train/{ctx}/{family}")) is None:
   829	        raise SystemExit(f"cross {ctx}/{family}: no training-seed bank matrix (frozen before the evaluation)")
   830	    _, rules = _cross_rules(ctx, family, catalog, bank)
   831	    ids = {f"freeze/{ctx}", f"bank/{ctx}/{family}", f"bank_train/{ctx}/{family}"} | {f"reference/{ctx}/{r}" for r in rules}
   832	    ids |= {f"envelope_select/{ctx}/{r}/{family}" for r in rules if path_of(out, f"envelope_select/{ctx}/{r}/{family}").exists()}
   833	    return aux_provenance(_first(catalog, context=ctx)["mkt"], family=family), ids
