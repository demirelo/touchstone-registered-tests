   884	def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
   885	    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
   886	    if job["objective"] == "profit":
   887	        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
   888	        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
   889	        _, rrec, _ = reference_of(job, out)
   890	        cands, fams, _ = menu(job, out, cuts, h4_excluded)
   891	        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
   892	        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
   893	        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
   894	        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
   895	                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
   896	                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
   897	                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
   898	    if job["objective"] in ("W0", "W1"):
   899	        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
   900	        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
   901	        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
   902	        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
   903	        continue_search(obj, fam, st, orig)
   904	        sel_old = rec["selected"]
   905	        old_eff = obj.extra[exact_key(sel_old)]["eff"] if sel_old is not None else None
   906	        sel = select_w1(obj) if job["objective"] == "W1" else dict(max(obj.archive.values(), key=lambda e: e.f).knobs)
   907	        new_eff = obj.extra[exact_key(sel)]["eff"] if sel is not None else None
   908	        held = None
   909	        if sel is not None:
   910	            fr = run_focal(eval_cell(job), lambda: fam.make(dict(sel)), SeedCache())
   911	            held = {"knobs": dict(sel), "seeds": list(eval_cell(job).seeds), "eff": gross_efficiency(fr.results).tolist()}
   912	        return {**doubling_report("w1" if job["objective"] == "W1" else "welfare", {"eff": old_eff, "feasible": sel_old is not None},
   913	                                  {"eff": new_eff, "feasible": sel is not None}), "heldout": held}
   914	    m = job["mkt"]; fam = family_for(job["family"], T, L); orig = search_from_json(rec["coalition"])
   915	    if job["objective"] == "total":
   916	        obj = _coalition_objective(job, "total", np.zeros((len(_members(job)), len(m["seeds_train"]))), cache)
   917	        new = continue_search(obj, fam, st, orig)
   918	        return {**doubling_report("coalition", {"f": orig.best_f}, {"f": max(new.best_f, orig.best_f)}),
   919	                "heldout": _coalition_heldout(job, _desc(job, new.best_knobs), out)}
   920	    ctx, tag = job["context"], _coalition_tag(job)                  # G_min: every score against the final reference (design 6.3)
   921	    ref = np.asarray(read(path_of(out, f"joint_reference/{ctx}/{tag}"))["member_normalized"])
   922	    sel = read(path_of(out, f"coalition_select/{ctx}/{tag}"))["winners"][job["id"]]
   923	    orig = rescore_min(orig, rec["rows"], ref)
   924	    obj = _coalition_objective(job, "min", ref, cache)
   925	    new = continue_search(obj, fam, st, orig)
   926	    win, f = (_desc(job, new.best_knobs), new.best_f) if new.best_f > sel["score"] else (sel["descriptor"], sel["score"])   # step 6's winner stays in
   927	    return {**doubling_report("coalition", {"f": sel["score"]}, {"f": f}), "heldout": _coalition_heldout(job, win, out)}
