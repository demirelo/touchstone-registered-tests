    45	def test_install_adds_churning_opponents_to_training_and_evaluation_cells(monkeypatch):
    46	    calls = {}
    47	    def fake_train_cell(job, others=()):
    48	        from sim.cell import Cell
    49	        return Cell(cfg=job["_cfg"], rule_factory=None, focal=job["_focal"], seeds=(1,), name="x", others=others)
    50	    monkeypatch.setattr(C.R, "train_cell", fake_train_cell)
    51	    C.install()
    52	    try:
    53	        cell = C.R.train_cell(_job())
    54	        assert [e for e, _ in cell.others] == [e for e in range(10) if e != 3]
    55	        assert all(f().p == 0.05 for _, f in cell.others)
    56	        assert C.R.train_cell({**_job(), "churn": None}).others == ()
    57	    finally:
    58	        C.uninstall()
    59	    assert C.R.train_cell is fake_train_cell
