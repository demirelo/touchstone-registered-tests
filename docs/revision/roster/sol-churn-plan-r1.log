   417	def reproduce_doubling(src, out, rid: str, root: str, cfgs: dict, params: dict, salt_sha256: str) -> dict:
   418	    """Rerun the registered doubling check of one fresh-market D2+H3 cell with the frozen stage, against copies of its inputs."""
   419	    label, rest = rid.split("@", 1); rule = rid.split("|")[1]
   420	    j = R.job(R.market(label, root, 0.2, cfg=cfgs[label], salt_sha256=salt_sha256), rule, "D2+H3", "profit", params=params)
   421	    reg = read(R.path_of(src, rid))
   422	    preflight(out, src, [j], salt_sha256, {label: {"container_hash": (reg or {}).get("provenance", {}).get("cfg_sha256")}})
   423	    need = inputs(src, [j]); need[j["id"]] = sha_file(R.path_of(src, j["id"]))
   424	    copy_inputs(src, out, need)
   425	    rec = R.stage_doubling(j, out, CUTS, H4_EXCLUDED)
   426	    write(Path(out) / "doubling" / (R._safe(rid) + ".json"),
   427	          {"stage": "doubling", "id": rid, "provenance": j["provenance"], "upstream": {u: sha_file(R.path_of(out, u)) for u in sorted(need)}, **rec})
   428	    rep = compare_doubling(src, out, rid); write(Path(out) / "gate.json", {"stage": "doubling gate", "cell": rid, **rep}); inventory(out)
   429	    return rep
