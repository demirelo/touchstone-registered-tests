   432	def reproduce(src, out, root: str, params: dict, salt_sha256: str, workers: int = 1) -> dict:
   433	    """Rerun the registered headline F111 D2 search and evaluation through this script's path (input copies, freeze,
   434	    acceptance) and compare with the registered records."""
   435	    mkt = R.market("headline", root, 0.2, salt_sha256=salt_sha256)
   436	    j = R.job(mkt, "F111", "D2", "profit", params=params)
   437	    reg = read(R.path_of(src, REPRO))
   438	    container = {"headline": {"container_hash": (reg or {}).get("provenance", {}).get("cfg_sha256")}}
   439	    preflight(out, src, [j], salt_sha256, container)
   440	    copy_inputs(src, out, inputs(src, [j]))
   441	    run_stage("search", [j], out, workers); prefreeze(out, [j])
   442	    accept(out, [j], salt_sha256, {"headline": {"container_hash": reg["provenance"]["cfg_sha256"]}})
   443	    run_stage("evaluate", [j], out, workers)
   444	    rep = compare(src, out); write(Path(out) / "gate.json", {"stage": "reproduction gate", "cell": REPRO, **rep}); inventory(out)
   445	    return rep
