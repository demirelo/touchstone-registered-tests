   150	def participant_diagnostics(res, cfg, focal: int) -> dict:
   151	    """Spec 7 scripted-participant diagnostics from one episode: audits on the focal entity's identities and on
   152	    the others, bans on the others (false bans: the others are honest-max), rounds the focal entity spent banned,
   153	    and the capacity the others lost while banned (sum over banned identity-rounds of k_i). A ban on a retired
   154	    focal identity does not count: the entity acts through its current identity."""
   155	    ids_f = {i for i, e in enumerate(res.entity_of) if e == focal}
   156	    k_of = [cfg.providers[e].k for e in res.entity_of]
   157	    created = sorted((r, i) for i, (e, r) in enumerate(zip(res.entity_of, res.identity_round)) if e == focal)
   158	    banned_until: dict[int, int] = {}
   159	    out = {"focal_audited": 0, "others_audited": 0, "others_bans": 0, "focal_bans": 0, "focal_banned_rounds": 0, "others_lost_capacity": 0,
   160	           "refunds_focal": float(sum(res.ledger.refunds[:, i].sum() for i in ids_f)),
   161	           "forfeits_focal": float(sum(res.ledger.forfeits[:, i].sum() for i in ids_f))}
   162	    for rec in res.history:
   163	        current = max((i for r, i in created if r <= rec.t), key=lambda i: (res.identity_round[i], res.identity_generation[i]))   # the entity's identity this round
   164	        for i, until in banned_until.items():
   165	            if rec.t < until:
   166	                if i == current:
   167	                    out["focal_banned_rounds"] += 1      # a ban on a retired identity excludes nothing
   168	                elif i not in ids_f:
   169	                    out["others_lost_capacity"] += k_of[i]
   170	        for r in rec.audits:
   171	            out["focal_audited" if r.provider in ids_f else "others_audited"] += 1
   172	        for i, rounds in rec.consequences.bans.items():
   173	            out["focal_bans" if i in ids_f else "others_bans"] += 1
   174	            banned_until[i] = max(banned_until.get(i, 0), rec.t + int(rounds) + 1)
   175	    return out
