   150	def inventory(out, p: float) -> dict:
   151	    inv = F.inventory(out)
   152	    inv["environment"]["churn_driver_sha256"] = sha_file(Path(__file__)); inv["churn"] = float(p); inv["deviations"] = list(DEVIATIONS)
   153	    write(Path(out) / "inventory.json", inv)
   154	    return inv
