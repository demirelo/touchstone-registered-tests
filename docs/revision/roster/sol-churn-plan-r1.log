   157	def main(argv=None) -> int:
   158	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   159	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True)
   160	    ap.add_argument("--draw", default=str(F.ROOT / "results/v2/draw/draw.json")); ap.add_argument("--instances", default=str(F.ROOT / "results/v2/draw/instances.json"))
   161	    ap.add_argument("--cfgs", default=str(F.ROOT / "results/v2/deviation/cfg_linux.json")); ap.add_argument("--addendum", default=str(F.ROOT / "results/v2/report/addendum.json"))
   162	    ap.add_argument("--params", default=str(F.ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   163	    ap.add_argument("--rules", default=",".join(RULES)); ap.add_argument("--rates", default=",".join(f"{p:g}" for p in RATES))
   164	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
   165	    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--smoke", action="store_true")
   166	    a = ap.parse_args(argv); base = Path(a.out); F.check_out(base, a.src)
   167	    from sim.records import cfg_from_dict
   168	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   169	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   170	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   171	    params = json.loads(Path(a.params).read_text())
   172	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if a.stage == "all" else (a.stage,)
   173	    install()
   174	    for p in (float(x) for x in a.rates.split(",")):
   175	        out = base / f"p{p:g}"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   176	        jobs = build_jobs(root, cfgs, params, salt_sha, p, tuple(a.markets.split(",")), tuple(a.rules.split(",")), a.smoke)
   177	        F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
   178	        if not a.smoke:
   179	            F.check_pairing(a.src, jobs)
   180	        for st in steps:
   181	            if st == "inputs":
   182	                F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
   183	            elif st == "search":
   184	                run_stage("search", jobs, out, a.workers)
   185	            elif st == "freeze":
   186	                F.prefreeze(out, jobs)
   187	            elif st in ("evaluate", "doubling"):
   188	                F.accept(out, jobs, salt_sha, container, src=a.src); run_stage(st, jobs, out, a.workers)
   189	            elif st == "diagnostics":
   190	                write(out / "diagnostics.json", diagnostics(out, jobs))
   191	            else:
   192	                inventory(out, p)
   193	            print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs)}), flush=True)
   194	    return 0
