    89	def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, p: float, markets=MARKETS, rules=RULES, smoke: bool = False) -> list[dict]:
    90	    jobs = []
    91	    for m in markets:
    92	        mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
    93	        jobs += [churn_job(R.job(mkt, r, "D2+H3", "profit", smoke=smoke, params=params), p) for r in rules]
    94	    return jobs
    95	
    96	
    97	def _init_worker() -> None:
    98	    install()
    99	
   100	
   101	def run_stage(stage: str, jobs: list[dict], out, workers: int = 1) -> list[str]:
   102	    install()
   103	    if workers <= 1 or len(jobs) <= 1:
   104	        return [R._run_one(stage, j, str(out), F.CUTS, F.H4_EXCLUDED, jobs) for j in jobs]
   105	    with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
   106	        n = len(jobs)
   107	        return list(ex.map(R._run_one, [stage] * n, jobs, [str(out)] * n, [F.CUTS] * n, [F.H4_EXCLUDED] * n, [jobs] * n))
   108	
   109	
   110	def newcomer_shares(results, focal: int, edges=AGE_EDGES) -> dict:
   111	    """Audited share of served jobs by identity age (rounds since creation), for honest replacement identities, honest
   112	    initial identities, and the focal provider's identities, pooled over episodes; plus honest replacements per episode."""
   113	    cats = ("honest_replacement", "honest_initial", "focal")
   114	    cnt = {c: [[0, 0] for _ in edges[:-1]] for c in cats}
   115	    reps = []
   116	    for r in results:
   117	        reps.append(sum(1 for i, e in enumerate(r.entity_of) if e != focal and r.identity_generation[i] > 0))
   118	        def cat(i):
   119	            if r.entity_of[i] == focal:
   120	                return "focal"
   121	            return "honest_replacement" if r.identity_generation[i] > 0 else "honest_initial"
   122	        for t, h in enumerate(r.history):
   123	            def put(i, k):
   124	                age = t - r.identity_round[i]
   125	                for b in range(len(edges) - 1):
   126	                    if edges[b] <= age < edges[b + 1]:
   127	                        cnt[cat(i)][b][k] += 1; return
   128	            for i in h.assignment.values():
   129	                put(i, 0)
   130	            for a in h.audits:
   131	                put(a.provider, 1)
   132	    out = {c: [{"age": [edges[b], edges[b + 1]], "served": s, "audited": a, "share": (a / s if s else 0.0)} for b, (s, a) in enumerate(cnt[c])] for c in cats}
   133	    out["honest_replacements_per_episode"] = float(sum(reps) / len(reps)) if reps else 0.0
   134	    return out
   135	
   136	
   137	def diagnostics(out, jobs: list[dict]) -> dict:
   138	    """The selected attack of each churn cell rerun on the evaluation seeds under churn, with the newcomer audit shares."""
   139	    import numpy as np
   140	    from sim.cell import SeedCache, run_focal
   141	    install(); res = {}
   142	    for j in jobs:
   143	        T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j)
   144	        knobs = read(R.path_of(out, j["id"]))["attack"]["best_knobs"]
   145	        fr = run_focal(cell, lambda: fam.make(dict(knobs)), SeedCache())
   146	        res[f"{j['context']}|{j['rule']}"] = {"knobs": knobs, "mean_normalized": float(np.mean(fr.normalized)), "shares": newcomer_shares(fr.results, cell.focal)}
   147	    return res
