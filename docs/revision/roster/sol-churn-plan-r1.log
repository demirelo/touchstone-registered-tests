   797	        return {"seeds": list(cell.seeds), **gain_fields(cell, fam, rec["attack"]["best_knobs"], cand, cache)}
   798	    if job["objective"] in ("W0", "W1"):
   799	        if rec["selected"] is None:
   800	            return {"seeds": list(cell.seeds), "no_feasible_candidate": True}
   801	        fam = family_for(job["family"], T, L); fr = run_focal(cell, lambda: fam.make(dict(rec["selected"])), cache)
   802	        out_ = {"seeds": list(cell.seeds), "eff": gross_efficiency(fr.results).tolist(), "normalized": fr.normalized.tolist()}
   803	        if job["objective"] == "W1":
   804	            cand, _, _ = reference_of(job, out); ref = run_focal(cell, cand.policy_factory, cache)
   805	            out_["constraint"] = (fr.normalized - ref.normalized).tolist()
   806	        return out_
   807	    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}"))
   808	    if job["objective"] == "min":
   809	        win = read(path_of(out, f"coalition_select/{job['context']}/{_coalition_tag(job)}"))["winners"][job["id"]]["descriptor"]
   810	    else:
   811	        win = _desc(job, rec["selected"])
   812	    rows = _rows_of(job, win, cell.seeds, cache); ref_rows = _rows_of(job, jrec["descriptor"], cell.seeds, cache)
   813	    g = rows - ref_rows
   814	    return {"seeds": list(cell.seeds), "member_gain": g.tolist(), "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min()),
   815	            "winner": win, "reference": jrec["descriptor"]}
