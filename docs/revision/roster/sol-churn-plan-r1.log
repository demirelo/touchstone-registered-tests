    84	def churn_job(job: dict, p: float) -> dict:
    85	    rid = f"{job['id']}|churn{p:g}"
    86	    return {**job, "id": rid, "churn": float(p), "provenance": {**job["provenance"], "id": rid, "churn": float(p)}}
