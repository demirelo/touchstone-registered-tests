    43	class HonestChurn:
    44	    """Honest-max delivery and offer; retires its identity and re-enters under a fresh one with probability p per round."""
    45	
    46	    def __init__(self, p: float) -> None:
    47	        self.p = float(p); self.name = f"honest_churn({self.p:g})"
    48	
    49	    def act(self, view) -> Action:
    50	        q = view.params.q_max
    51	        return Action(effort=q, offer=Offer(claim=q, bid=view.params.a + view.params.b * q), exit=bool(self.p > 0 and view.rng.random() < self.p))
    52	
    53	
    54	def _churn_factory(p: float):
    55	    return lambda: HonestChurn(p)
    56	
    57	
    58	_ORIG = None
    59	
    60	
    61	def install() -> None:
    62	    """Wrap revision_v2.train_cell so a job with a `churn` rate gets churning opponents (idempotent)."""
    63	    global _ORIG
    64	    if _ORIG is not None:
    65	        return
    66	    _ORIG = R.train_cell
    67	
    68	    def train_cell(job, others=()):
    69	        cell = _ORIG(job, others)
    70	        p = job.get("churn")
    71	        if p is None or others:
    72	            return cell
    73	        from dataclasses import replace
    74	        return replace(cell, others=tuple((e, _churn_factory(p)) for e in range(cell.cfg.N) if e != cell.focal))
    75	    R.train_cell = train_cell
    76	
    77	
    78	def uninstall() -> None:
    79	    global _ORIG
    80	    if _ORIG is not None:
    81	        R.train_cell = _ORIG; _ORIG = None
    82	
