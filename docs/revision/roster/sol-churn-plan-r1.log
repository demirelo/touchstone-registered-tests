    84	def test_smoke_path_for_one_fresh_cell_under_churn(tmp_path):
    85	    out = tmp_path / "churn"
    86	    args = ["--src", str(MAIN / "eval/all"), "--out", str(out), "--draw", str(MAIN / "draw/draw.json"), "--instances", str(MAIN / "draw/instances.json"),
    87	            "--cfgs", str(MAIN / "deviation/cfg_linux.json"), "--addendum", str(MAIN / "report/addendum.json"),
    88	            "--markets", "fresh0", "--rules", "F111", "--rates", "0.05", "--smoke"]
    89	    assert C.main(args) == 0
    90	    d = out / "p0.05"; rid = "fresh0@rho0.2|F111|D2+H3|profit|churn0.05"
    91	    ev = read(C.R.eval_path(d, rid)); db = read(d / "doubling" / (C.R._safe(rid) + ".json")); inv = read(d / "inventory.json")
    92	    dg = read(d / "diagnostics.json")["fresh0@rho0.2|F111"]
    93	    assert ev["stage"] == "evaluate" and ev["provenance"]["churn"] == 0.05 and len(ev["gain"]) == 2
    94	    assert db["stage"] == "doubling" and "freeze/fresh0@rho0.2" in ev["upstream"] and f"reference/fresh0@rho0.2/F111" in ev["upstream"]
    95	    assert dg["shares"]["honest_replacements_per_episode"] > 0                                  # churn happened in the evaluated episodes
    96	    assert inv["churn"] == 0.05 and "churn_driver_sha256" in inv["environment"]

