   930	def _coalition_heldout(job: dict, desc: dict, out: Path) -> dict:
   333	def _finite(*xs) -> bool:
   334	    import math
   335	    return all(math.isfinite(v) for x in xs for v in (x if isinstance(x, (list, tuple)) else [x]) if isinstance(v, (int, float)))
