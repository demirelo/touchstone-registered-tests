    70	def test_newcomer_audit_shares_by_age():
    71	    rec = lambda assign, audits: NS(assignment=assign, audits=tuple(NS(provider=p) for p in audits))
    72	    # identities 0 (focal entity 0, initial), 1 (honest entity 1, initial), 2 (honest entity 1, replacement born at t=1)
    73	    ep = NS(entity_of=(0, 1, 1), identity_generation=(0, 0, 1), identity_round=(0, 0, 1),
    74	            history=(rec({0: 0, 1: 1}, [1]), rec({0: 0, 1: 2, 2: 2}, [2, 2]), rec({0: 2, 1: 2}, [2])))
    75	    got = C.newcomer_shares([ep], focal=0, edges=(0, 1, 50))
    76	    assert got["honest_replacement"][0] == {"age": [0, 1], "served": 2, "audited": 2, "share": 1.0}
    77	    assert got["honest_replacement"][1] == {"age": [1, 50], "served": 2, "audited": 1, "share": 0.5}
    78	    assert got["honest_initial"][0]["served"] == 1 and got["honest_initial"][0]["share"] == 1.0
    79	    assert got["focal"][0]["served"] == 1 and got["focal"][1]["served"] == 1 and got["focal"][1]["share"] == 0.0
    80	    assert got["honest_replacements_per_episode"] == 1.0
