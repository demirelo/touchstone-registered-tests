    src = _src(tmp_path); fr = F.R.path_of(src, f"freeze/{CTX}"); f = read(fr); f["records"].pop(f"{CTX}|F000|D2+H3|profit"); write(fr, f)
    with pytest.raises(SystemExit, match="not in the original freeze"):
