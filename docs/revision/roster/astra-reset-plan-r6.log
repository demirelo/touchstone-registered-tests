    F.require_zero_resets(F.reset_stats(ok, focal=1), "x")
    bad = [_Ep((0, 1, 1), (0, 0, 1), (0, 0, 3), [0.5, nan, 0.5, 0.5], [{}, {1: 10}, {}, {}])]
    with pytest.raises(SystemExit, match="resets"):
