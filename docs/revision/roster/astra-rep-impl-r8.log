   901	def _put(rec, path, value):
   902	    import copy
   903	    if not path:
   904	        return value
   905	    r = copy.deepcopy(rec); x = r
   906	    for k in path[:-1]:
   907	        x = x[k]
   908	    x[path[-1]] = value
   909	    return r
