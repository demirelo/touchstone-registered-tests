   182	def _rounds_problem(rec: dict, max_rounds: int) -> str | None:
   183	    """Run B's rounds (convergence_v2.run_cell; review rep-impl-r3): numbered 1..k with k <= max_rounds, finite search and
   184	    reference values with finite knobs; "passed" exactly when the last round is the first that passes the doubling
   185	    threshold, "not passed at the cap" when k equals the cap and no round passes; the held-out winner is the last round's."""
   186	    from convergence_v2 import _passes
   187	    rounds = rec.get("rounds")
   188	    if not isinstance(rounds, list) or not 1 <= len(rounds) <= max_rounds:
   189	        return "rounds missing or beyond the cap"
   190	    for i, r in enumerate(rounds):
   191	        if not isinstance(r, dict) or type(r.get("round")) is not int or r["round"] != i + 1 or not _finite([r.get(k) for k in ("attack_f", "attack_change", "reference_f", "reference_change")]) \
   192	                or not _knobs_ok(r.get("best_knobs")):
   193	            return f"round {i + 1} malformed or nonfinite"
   194	    ok = [_passes(r) for r in rounds]
   195	    if rec["status"] == "passed" and not (ok[-1] and not any(ok[:-1])):
   196	        return "status passed without a final passing round"
   197	    if rec["status"] == STATUSES[1] and (len(rounds) != max_rounds or any(ok)):
   198	        return "status at the cap without the capped, unpassed rounds"
   199	    if not _same((rec.get("heldout") or {}).get("knobs"), rounds[-1]["best_knobs"]):
   200	        return "held-out winner differs from the last round's winner"
   201	    return None
