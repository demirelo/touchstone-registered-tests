   204	def _round1_ready(rec, doubling, search) -> bool:
   205	    """Round 1 was measured and both records it is compared with are well-formed: then any disagreement below is a
   206	    round-1 mismatch, not a malformed record."""
   207	    rec, doubling, search = _d(rec), _d(doubling), _d(search)
   208	    if rec is None or doubling is None or search is None or not isinstance(rec.get("round1_gate"), dict):
   209	        return False
   210	    rounds, h, g = rec.get("rounds"), doubling.get("heldout"), rec["round1_gate"]
   211	    if not (isinstance(rounds, list) and rounds and isinstance(rounds[0], dict) and isinstance(h, dict) and
   212	            _finite(h.get("gain")) and _knobs_ok(h.get("knobs")) and isinstance(search.get("attack"), dict) and
   213	            _knobs_ok(search["attack"].get("best_knobs"))):
   214	        return False
   215	    r1, fh = rounds[0], rec.get("heldout")                  # the measured values and both doubling changes must be
   216	    if not (_finite([doubling.get("attack_change"), doubling.get("reference_change")]) and   # well-formed (review r7)
   217	            _finite([r1.get("attack_change"), r1.get("reference_change"), g.get("heldout_mean")]) and
   218	            _knobs_ok(r1.get("best_knobs")) and _knobs_ok(g.get("heldout_knobs"))):
   219	        return False
   220	    return not (isinstance(fh, dict) and _same(fh.get("knobs"), h["knobs"])) or _finite(fh.get("gain"))
   221	
   222	
   223	def _round1_problem(rec: dict, doubling, search=None) -> str | None:
   224	    """Round 1 against this cell's own doubling record and frozen search (reviews rep-impl-r4, r5): with zero
   225	    differences, the comparison's round-1 winner equals the doubling's held-out knobs, its held-out mean equals the mean
   226	    of the doubling's held-out gains (the same np.mean of the same values), and round 1's two changes equal the
   227	    doubling's; round 1's best knobs are the doubling's winner or the frozen search winner (the better of the two); and a
   228	    final winner equal to the doubling's winner has the doubling's held-out gains exactly. All five hold on every Run B
   229	    record with an identical round 1 (76 records; 48 with that final winner)."""
   230	    import numpy as np
   231	    if not _round1_ready(rec, doubling, search):
   232	        return "no valid doubling or search record to check round 1 against"
   233	    g, r1, h = rec["round1_gate"], rec["rounds"][0], doubling["heldout"]
   234	    if not _same(g.get("heldout_knobs"), h["knobs"]):
   235	        return "round-1 winner differs from the doubling record's held-out winner"
   236	    if not _same(g.get("heldout_mean"), float(np.mean(h["gain"]))):
   237	        return "round-1 held-out mean differs from the doubling record's"
   238	    if not (_same(r1.get("attack_change"), doubling.get("attack_change")) and _same(r1.get("reference_change"), doubling.get("reference_change"))):
   239	        return "round-1 changes differ from the doubling record's"
   240	    if not any(_same(r1.get("best_knobs"), k) for k in (h["knobs"], search["attack"]["best_knobs"])):
   241	        return "round-1 best knobs are neither the doubling winner nor the frozen winner"
   242	    fh = rec.get("heldout")
   243	    if isinstance(fh, dict) and _same(fh.get("knobs"), h["knobs"]) and not _same(fh.get("gain"), h["gain"]):
   244	        return "the doubling winner's held-out gains differ from the doubling record's"
   245	    return None
