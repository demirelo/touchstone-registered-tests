   261	@_checked
   262	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3, doubling=None, search=None) -> str | None:
   263	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   264	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   265	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   266	    job's ordered evaluation seeds; a measured round 1 must agree with this cell's doubling record (`doubling`;
   267	    _round1_problem). The job must carry its evaluation seeds: no check is skipped."""
   268	    seeds = (job.get("mkt") or {}).get("seeds_eval")
   269	    if not seeds:
   270	        return "the job has no evaluation seeds to check against"
   271	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or not _same(rec.get("id"), key):
   272	        return "not a continuation record of this cell"
   273	    if not _same(rec.get("provenance"), job.get("provenance")):
   274	        return "continuation record of another job or run"
   275	    st = rec.get("status")
   276	    if st not in STATUSES:
   277	        return f"unknown continuation status {st!r}"
   278	    if st == STATUSES[3] and not (_gate_wellformed(rec.get("round1_gate")) and not identical(rec)):   # review rep-impl-r7
   279	        return "a round-1 mismatch status without its failing comparison"
   280	    if st in STATUSES[:2]:
   281	        g = rec.get("round1_gate")
   282	        if not (identical(rec) or (smoke and g == SMOKE_GATE)):
   283	            return "a continued winner without its own identical round-1 comparison"
   284	        if isinstance(g, dict) and not (_knobs_ok(g.get("heldout_knobs")) and _finite([g.get("heldout_mean")])):
   285	            return "round-1 comparison without a finite round-1 winner"
   286	        h = rec.get("heldout")
   287	        if not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   288	            return "held-out result missing, nonfinite, on other seeds or with a zero normalizer"
   289	        if (n := _n_of(job)) is None or safe_terms(h, n) is None:          # review rep-impl-r6: the same normalizer and
   290	            return "held-out normalizer not positive after division by N, or a term not finite"   # term checks as scoring
   291	        if x := _rounds_problem(rec, max_rounds):
   292	            return x
   293	        if isinstance(g, dict) and (x := _round1_problem(rec, doubling, search)):
   294	            return x
   295	    return None
