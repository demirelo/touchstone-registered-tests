   345	
   346	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   347	              smoke: bool = False) -> dict:
   348	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   349	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   350	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   351	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   352	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   353	    cost-stopped ones."""
   354	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   355	    import revision_v2 as R
   356	    if gate is None:
   357	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   358	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   359	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   360	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   361	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   362	    saved = {d: _d(read_record(d)) for _, d in items}                   # a non-object root counts as no record
   363	    dbl = {d: doubling_of(c["dir"], c["job"]["id"]) for c, d in items}; srch = {d: search_of(c["dir"], c["job"]["id"]) for c, d in items}
   364	    other = [c["id"] for c, d in items if saved[d] is not None and _foreign(saved[d].get("provenance"), c["job"].get("provenance"))]
   365	    if other:                                                            # plan section 5: reuse only this run's records
   366	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   367	    if any(_mismatch(saved[d], dbl[d], srch[d]) for _, d in items):     # a measured disagreement included (review rep-impl-r5)
   368	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   369	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   370	    # review rep-impl-r3: a saved record is reused only if it passes the same checks collect applies; any other record
   371	    # (incomplete, malformed, nonfinite) means "no passing record" and its cell is rerun (plan section 4: a resume
   372	    # continues from the first cell without a passing record); the old record is set aside, never deleted
   373	    # (an unknown status included: review rep-impl-r4; a measured round-1 mismatch stopped above and is never rerun)
   374	    invalid = lambda c, d, mr: saved[d] is not None and not cost_stopped(saved[d]) and \
   375	        cont_problem(saved[d], c["id"], c["job"], smoke, mr, dbl[d], srch[d]) is not None
   376	    rerun = lambda c, d, mr: saved[d] is None or cost_stopped(saved[d]) or invalid(c, d, mr)
   377	    run = 0
   378	    if rerun(gate, gdest, 1):
   379	        _set_aside(cdir, gdest)
   380	        lost, failed = run_cells(_cont_one, [gate], [(gate["job"], gate["dir"], 1, cost, hours[gate["id"]])], 1, [gdest],
   381	                                 [{"id": gate["id"], "gate": True}])
   382	        run += 1
   383	        if failed:
   384	            return {"run": run, "failed": failed, "exit": 6, "gate": "the gate cell raised an error"}
   385	        if lost:
   386	            _lost(cdir, lost, hours, 1)
   387	            return {"run": run, "lost": lost, "exit": 5, "gate": "the gate cell's worker was lost"}
   388	    g = _d(read_record(gdest))
   389	    if _mismatch(g, dbl[gdest], srch[gdest]):
   390	        return {"run": run, "exit": 4, "gate": "round-1 mismatch at the gate: continuation stopped"}
   391	    if cost_stopped(g):
   392	        return {"run": run, "exit": 3, "gate": "the gate cell was refused at the cost cap: no further cell started"}
   393	    if not smoke and _gate_wellformed((g or {}).get("round1_gate")) and not identical(g):   # a measured, not identical gate
   394	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   395	    if (why := cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=dbl[gdest], search=srch[gdest])) is not None:
   396	        return {"run": run, "exit": 6, "gate": f"the gate record fails its checks: {why}"}
   397	    todo = [c for c in queue if rerun(c, dest(c), max_rounds)]          # same order; completed, valid cells reused
   398	    for c in todo:
   399	        _set_aside(cdir, dest(c))
   400	    lost, failed = ([], {}) if not todo else run_cells(
   401	        _cont_one, todo, [(c["job"], c["dir"], max_rounds, cost, hours[c["id"]]) for c in todo], workers,   # module-level fn
   402	        [dest(c) for c in todo], [{"id": c["id"]} for c in todo])
   403	    recs = [_d(read_record(dest(c))) for c in todo]
   404	    mismatch = [c["id"] for c, r in zip(todo, recs) if _mismatch(r, dbl[dest(c)], srch[dest(c)])]
   405	    stopped = [c["id"] for c, r in zip(todo, recs) if cost_stopped(r)]
   406	    if lost and not mismatch and not failed:
   407	        _lost(cdir, lost, hours, max_rounds)
   408	    code = 4 if mismatch else 6 if failed else 5 if lost else 3 if stopped else 0
   409	    return {"run": run + len(todo), "lost": lost, "failed": failed, "mismatch": mismatch, "stopped": stopped, "exit": code}
   410	
