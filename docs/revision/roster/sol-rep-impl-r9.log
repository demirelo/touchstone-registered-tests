   527	def diag_bound(d: Path, kind: str, p: float, ck: str, job: dict) -> bool:
   528	    """The frozen diagnostics of cell `ck` belong to this job, rate and run: the binding names this rate, the current
   529	    diagnostics.json, this job's id and provenance, and the current search and doubling records."""
   530	    import revision_v2 as R
   531	    from sim.records_v2 import sha_file
   532	    b = _d(read_record(Path(d) / BINDING)); c = (_d((b or {}).get("cells")) or {}).get(ck)
   533	    q = Path(d) / "diagnostics.json"
   534	    return isinstance(c, dict) and b.get("stage") == "diagnostics binding" and b.get("kind") == kind and _same(b.get("rate"), float(p)) and \
   535	        q.is_file() and b.get("diagnostics") == sha_file(q) and _same(c.get("id"), job["id"]) and _same(c.get("provenance"), job["provenance"]) and \
   536	        R.path_of(d, job["id"]).is_file() and c.get("search") == sha_file(R.path_of(d, job["id"])) and \
   537	        c.get("doubling") == sha_file(Path(d) / "doubling" / (R._safe(job["id"]) + ".json"))
