   552	
   553	def safe_terms(h: dict, n: int):
   554	    """terms_of, or None when a normalizer S*/N is not positive after the division or any term is not finite (review
   555	    rep-impl-r5: S* = 5e-324 passed as positive, then became 0 after division by N)."""
   556	    try:
   557	        if not all(x / n > 0 for x in h["sstar"]):
   558	            return None
   559	        t = terms_of(h, n)
   560	        return t if _finite(t["attack"]) and _finite(t["reference"]) and _finite(t["gain"]) else None
   561	    except (ZeroDivisionError, OverflowError, TypeError, KeyError):
   562	        return None
   563	
   564	
   565	def terms_of(h: dict, n: int) -> dict:
   566	    """Per seed: gain = attack term - reference term, each normalised by S*/N (sim/reference.evaluate_gain)."""
   567	    sc = [x / n for x in h["sstar"]]
   568	    return {"gain": list(h["gain"]), "attack": [a / s for a, s in zip(h["profit_attack"], sc)],
   569	            "reference": [r / s for r, s in zip(h["profit_ref"], sc)], "eff_attack": list(h["eff_attack"]), "seeds": list(h["seeds"])}
   570	
   571	
   572	def _audit_of(shares: dict) -> tuple:
   573	    per = shares["per_episode"]
   574	    fo = [sum(e["focal"][b][i] for e in per for b in range(len(e["focal"]))) for i in (0, 1)]
   575	    return fo[1], fo[0]                                                   # (audited, served)
