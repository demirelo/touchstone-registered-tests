   439	
   440	@_checked
   441	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   442	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   443	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   444	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   445	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   446	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   447	    import revision_v2 as R
   448	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   449	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   450	    if ev is None:
   451	        return "no evaluation record"
   452	    if ev.get("stage") != "evaluate" or not _same(ev.get("id"), job["id"]) or not _same(ev.get("provenance"), job["provenance"]):
   453	        return "evaluation record of another stage, cell or run"
   454	    if not _valid_held(ev, seeds):
   455	        return "evaluation values nonfinite or on other seeds"
   456	    if (n := _n_of(job)) is None or safe_terms(ev, n) is None:
   457	        return "evaluation normalizer not positive after division by N, or a term not finite"
   458	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
   459	        return "evaluation: " + x
   460	    if db is None:
   461	        return "no doubling record"
   462	    if db.get("stage") != "doubling" or not _same(db.get("id"), job["id"]) or not _same(db.get("provenance"), job["provenance"]) or db.get("kind") != "profit":
   463	        return "doubling record of another stage, cell, run or kind"
   464	    ch = [db.get("attack_change"), db.get("reference_change")]
   465	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   466	        return "doubling changes nonfinite or flag missing"
   467	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   468	        return "doubling flag differs from its changes"
   469	    h = db.get("heldout")
   470	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   471	        return "doubling held-out result missing, nonfinite or on other seeds"
   472	    if safe_terms(h, n) is None:
   473	        return "doubling normalizer not positive after division by N, or a term not finite"
   474	    ref = read_record(R.path_of(d, rid))
   475	    if ref is None or not isinstance(ref.get("upstream"), dict):
   476	        return "no reference record"
   477	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   478	        return "doubling: " + x
   479	    return None
