   504	def diag_ok(row, seeds, knobs) -> bool:
   505	    """A diagnostics row (frozen: diagnostics.json cells[...]["base"]; continued: its own record) for this winner: its
   506	    knobs, the job's ordered evaluation seeds, finite per-seed profits and well-formed audit counts (review rep-impl-r2)."""
   507	    return isinstance(row, dict) and _same(row.get("knobs"), knobs) and isinstance(row.get("seeds"), list) and \
   508	        _same(row["seeds"], list(seeds)) and _finite(row.get("normalized")) and len(row["normalized"]) == len(seeds) and \
   509	        _shares_ok(row.get("shares"), len(seeds))
