   660	
   661	def _diag_cont(job: dict, knobs: dict) -> dict:
   662	    """In a worker: the churn arm's diagnostic run (churn_v2._diag_one) for a continued winner's knobs on the evaluation
   663	    seeds under the cell's churn: per-seed normalised profits and newcomer audit counts (plan section 3, expectation 5
   664	    on the primary winners)."""
   665	    import churn_v2
   666	    import numpy as np
   667	    import revision_v2 as R
   668	    from sim.cell import SeedCache, run_focal
   669	    churn_v2.install()
   670	    T, L = R.constants(job); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(job)
   671	    fr = run_focal(cell, lambda: fam.make(dict(knobs)), SeedCache())
   672	    return {"stage": "continued diagnostics", "provenance": job["provenance"], "knobs": dict(knobs),
   673	            "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
   674	            "mean_normalized": float(np.mean(fr.normalized)), "shares": churn_v2.newcomer_shares(fr.results, cell.focal)}
   675	
   676	
   677	def run_diagnostics(base: Path, jobs_by_dir: dict, workers: int, smoke: bool = False) -> dict:
   678	    """The diagnostics of R3's continued winners (menu cells at p = 0 and 0.05 whose continuation passed or reached the
   679	    cap) in Run B's pool; records under continuation/diagnostics/, reused on resume when bound to the same job."""
   680	    import convergence_v2  # noqa: F401
   681	    import revision_v2 as R
   682	    cdir = Path(base) / "continuation"; todo, args, dests, extras = [], [], [], []
   683	    for (kind, p), jobs in jobs_by_dir.items():
   684	        if kind != "menu" or p not in (0.0, 0.05):
   685	            continue
   686	        for j in jobs:
   687	            if j["rule"] != "F111":
   688	                continue
   689	            key = _key(kind, p, j["id"]); crec = _d(read_record(cdir / (R._safe(key) + ".json")))
   690	            d = Path(base) / f"{kind}-p{p:g}"
   691	            if crec is None or cont_problem(crec, key, j, smoke, doubling=doubling_of(d, j["id"]), search=search_of(d, j["id"])) is not None or crec["status"] not in STATUSES[:2]:
   692	                continue
   693	            dest = cdir / "diagnostics" / (R._safe(key) + ".json"); old = _d(read_record(dest))
   694	            if cont_diag_ok(old, key, j, crec["heldout"]["knobs"]):
   695	                continue
   696	            _set_aside(cdir / "diagnostics", dest)              # a stale or foreign record is rerun, never reused
   697	            todo.append({"id": key}); args.append((j, crec["heldout"]["knobs"])); dests.append(dest); extras.append({"id": key})
   698	    lost, failed = ([], {}) if not todo else run_cells(_diag_cont, todo, args, workers, dests, extras)
   699	    if lost and not failed:                                     # the launcher's restart reads this estimate (exit 5)
   700	        _lost(cdir, lost, {k: DIAG_HOURS for k in lost}, 1)
   701	    return {"run": len(todo), "lost": lost, "failed": failed, "exit": 6 if failed else 5 if lost else 0}

