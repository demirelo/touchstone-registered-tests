   577	
   578	def collect(base: Path, jobs_by_dir: dict, gate: dict | None, smoke: bool = False) -> dict:
   579	    """Records for both winner sets (recs[rate][market][rule] with gains, attack and reference terms, efficiency and
   580	    seeds), R3's audit counts for both sets, and the winner counts. Every record is checked before use (review
   581	    rep-impl-r2): a cell whose evaluation or doubling record fails base_problem is unscorable (plan section 4); a frozen
   582	    diagnostics row that fails diag_ok gives no audit count. Only flagged cells look at a continuation record; a flagged
   583	    cell without one is "not continued". The primary set is unavailable after a round-1 mismatch in any continuation
   584	    record or without this run's identical gate record (also when no cell is flagged). A flagged cell whose continuation
   585	    record fails cont_problem keeps its validated frozen winner and counts as not continued (plan section 4; review
   586	    rep-impl-r3). A frozen R3 audit count needs diagnostics bound to this job, rate and run (diag_bound) and complete
   587	    (diag_ok); a continued R3 winner's audit count needs its checked continued diagnostics."""
   588	    import convergence_v2  # noqa: F401
   589	    import revision_v2 as R
   590	    base = Path(base); cdir = base / "continuation"
   591	    allrec = [_d(read_record(q)) for q in sorted(cdir.glob("*.json")) + sorted((cdir / "gate").glob("*.json")) if q.name != "lost_cells.json"]
