   515	def diagnostics_binding(d: Path, kind: str, p: float, jobs: list) -> dict:
   516	    """Written by rep_v2's rate stage right after the diagnostics step and before the inventory (review rep-impl-r3): the
   517	    sha256 of diagnostics.json, the rate, and per cell the job id, its provenance (this run's commit, draw and salt) and
   518	    the hashes of the search and doubling records whose winners the diagnostics reran."""
   519	    import revision_v2 as R
   520	    from sim.records_v2 import sha_file
   521	    d = Path(d); h = lambda q: sha_file(q) if q.is_file() else None
   522	    return {"stage": "diagnostics binding", "kind": kind, "rate": float(p), "diagnostics": h(d / "diagnostics.json"),
   523	            "cells": {f"{j['context']}|{j['rule']}": {"id": j["id"], "provenance": j["provenance"], "search": h(R.path_of(d, j["id"])),
   524	                                                       "doubling": h(d / "doubling" / (R._safe(j["id"]) + ".json"))} for j in jobs}}
