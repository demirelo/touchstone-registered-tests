   426	
   427	def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
   428	    import revision_v2 as R
   429	    from sim.records_v2 import sha_file
   430	    up = rec.get("upstream")
   431	    if not isinstance(up, dict) or set(up) != set(want):
   432	        return "dependency set differs"
   433	    for u, h in up.items():
   434	        q = R.path_of(d, u)
   435	        if not q.is_file() or sha_file(q) != h:
   436	            return f"dependency hash differs: {u}"
   437	    return None
