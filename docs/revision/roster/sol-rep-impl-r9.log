   297	
   298	def _set_aside(cdir: Path, dest: Path) -> None:
   299	    """Move a record that will be rerun out of the way (no deletion), so that a lost worker shows as a missing record and
   300	    is never masked by the old one (review rep-impl-r2)."""
   301	    if dest.exists():
   302	        sup = cdir / "superseded"; sup.mkdir(parents=True, exist_ok=True)
   303	        n = len(list(sup.glob(dest.stem + ".*.json")))
   304	        dest.rename(sup / f"{dest.stem}.{n}.json")
   305	
   306	
   307	def _prov_wellformed(prov, like) -> bool:
   308	    """A provenance shaped like this job's own: the same fields, each of the same JSON type and not empty (review
   309	    rep-impl-r7: {} or an id of None or [] is a malformed record, not another run's binding)."""
   310	    if not isinstance(prov, dict) or not isinstance(like, dict) or set(prov) != set(like):
   311	        return False
   312	    kind = lambda v: "bool" if isinstance(v, bool) else "num" if isinstance(v, (int, float)) else type(v).__name__
   313	    return all(prov[k] is not None and kind(prov[k]) == kind(like[k]) and (not isinstance(prov[k], (str, list, dict)) or prov[k])
   314	               for k in like)
   315	
   316	
   317	def _foreign(prov, like) -> bool:
   318	    """Plan section 5 ("reuse only this run's records"): a well-formed provenance that names another job or run refuses
   319	    the resume; a missing or malformed one is an invalid record, rerun."""
   320	    return _prov_wellformed(prov, like) and not _same(prov, like)
   321	
   322	
   323	def _mismatch(rec, doubling=None, search=None) -> bool:
   324	    """A measured round 1 that differs from the doubling record at all: the recorded status, a comparison that is not
   325	    identical, or (with the cell's doubling and search records) any recorded round-1 value that disagrees with them
   326	    (_round1_problem; review rep-impl-r5). A cell refused before round 1 ("not run") or a smoke run ("not compared")
   327	    measured nothing."""
   328	    rec = _d(rec)
   329	    if rec is None:
   330	        return False
   331	    if not _gate_wellformed(rec.get("round1_gate")):      # no comparison, or a malformed one: an invalid record, whatever
   332	        return False                                      # the status says (review rep-impl-r7: a status proves nothing)
   333	    if not identical(rec):                                # a failing comparison, whatever the status
   334	        return True                                       # (review rep-impl-r8: no status shortcut either way)
   335	    return _round1_ready(rec, doubling, search) and _round1_problem(rec, doubling, search) is not None
   336	
