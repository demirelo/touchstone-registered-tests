   482	def _n_bins() -> int:
   483	    from churn_v2 import AGE_EDGES
   484	    return len(AGE_EDGES) - 1
   485	
   486	
   487	def _shares_ok(sh, n_episodes: int) -> bool:
   488	    """Newcomer audit counts (churn_v2.newcomer_shares): one episode per evaluation seed, each with the prescribed number
   489	    of age bins of [served, audited], finite and nonnegative, audited at most served (review rep-impl-r3)."""
   490	    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
   491	    if not isinstance(per, list) or len(per) != n_episodes:
   492	        return False
   493	    nb = _n_bins()
   494	    for e in per:
   495	        f = e.get("focal") if isinstance(e, dict) else None
   496	        if not isinstance(f, list) or len(f) != nb:
   497	            return False
   498	        for b in f:
   499	            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
   500	                return False
   501	    return True
