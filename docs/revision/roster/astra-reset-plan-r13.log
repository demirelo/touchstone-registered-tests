   115	def record_price(name, pid, run=_run, here=HERE, pods=None):
   116	    """Raise the rate in NAME.acct to PID's observed price; if the price is unknown (or the listing failed) write
   117	    NAME.unpriced, so no spend bound is claimed. Returns the price or None."""
   118	    if pods is None:
   119	        pods = list_pods(run)
   120	    pod = next((p for p in pods or [] if p.get("id") == pid), None)
   121	    price = price_of(pod) if pod is not None else None
   122	    if price is None:
   123	        open(os.path.join(here, f"{name}.unpriced"), "a").write(f"{pid}\n")
   124	        return None
   125	    acct = os.path.join(here, f"{name}.acct")
   126	    try:
   127	        tfirst, rate = open(acct).read().split()[:2]
   128	        if price > float(rate):
   129	            open(acct, "w").write(f"{tfirst} {price}")
   130	    except (OSError, ValueError):
   131	        open(os.path.join(here, f"{name}.unpriced"), "a").write(f"{pid} (no acct)\n")
