    68	def reconcile(name, keep="", seconds=600, run=_run, clock=time.time, sleep=time.sleep):
    69	    """Delete every pod named NAME except KEEP; True only when a successful listing shows none left."""
    70	    end = clock() + seconds
    71	    while clock() < end:
    72	        pods = list_pods(run, min(60, end - clock()))
    73	        if pods is not None and clock() <= end:
    74	            extra = [i for i in named(pods, name) if i != keep]
    75	            if not extra:
    76	                return True
    77	            for i in extra:
    78	                if clock() >= end:
    79	                    break
    80	                delete_verified(i, end - clock(), run, clock, sleep)
    81	        sleep(min(15, max(0.0, end - clock())))
    82	    return False
