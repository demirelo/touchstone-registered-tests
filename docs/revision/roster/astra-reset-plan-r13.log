    93	def classify_creation(answer, exc=None):
    94	    """(pod id, ambiguous) for one creation request. Only a clear client refusal (HTTP 4xx other than 408 and 429) is
    95	    unambiguous; a timeout, exception, server or gateway error, or unreadable answer may still create a pod (r11)."""
