    70	def run_profile(cfg: MarketConfig, rule_factory: Callable, factories: list, seeds, cache: SeedCache) -> list[EpisodeResult]:
    71	    out = []
    72	    for seed in seeds:
    73	        d, sstar = cache.get(cfg, seed)
    74	        pols = [f() for f in factories]
    75	        out.append(run_episode(cfg, rule_factory(), pols, int(seed), draws=d, sstar=sstar))
    76	        cache.runs += 1
    77	    return out
    78	
    79	
    80	def run_focal(cell: Cell, policy_factory: Callable, cache: SeedCache) -> FocalRun:
    81	    factories: list = [HonestMax for _ in range(cell.cfg.N)]
    82	    for e, f in cell.others:
    83	        factories[e] = f
    84	    factories[cell.focal] = policy_factory
    85	    results = run_profile(cell.cfg, cell.rule_factory, factories, cell.seeds, cache)
    86	    profits = np.array([float(r.profit[cell.focal]) for r in results])
    87	    norms = np.array([float(r.profit[cell.focal] / (r.sstar / cell.cfg.N)) for r in results])
    88	    infl = np.array([bool(np.any(r.claims[:, cell.focal] > r.efforts[:, cell.focal])) for r in results])   # nan claims (no offer) compare False
    89	    return FocalRun(profit=profits, normalized=norms, inflated_per_seed=infl, inflated=bool(infl.any()), results=results)

