   332	def memory_preflight(job: dict, out, requested: int) -> dict:
   333	    """Pod-side, before the nine-worker stages: one full evaluate task (four 200-seed profiles) for `job`, in a child
   334	    process, measured by its peak RSS; the parent's own RSS; the limit; and the workers that fit."""
   335	    import resource
   336	    import subprocess
   337	    import pickle
   338	    jp = Path(out) / "memory_preflight_job.pkl"; jp.write_bytes(pickle.dumps(job))
   339	    r = subprocess.run([sys.executable, str(HERE / "churn_memory.py"), "--task", str(jp), str(out)], capture_output=True, text=True)
   340	    if r.returncode != 0:
   341	        raise SystemExit(f"churn arm refused: memory preflight failed: {r.stderr[-300:]}")
   342	    peak = int(json.loads(r.stdout.strip().splitlines()[-1])["peak_rss_bytes"])
   343	    parent = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == "darwin" else 1024)   # bytes on macOS, KiB on Linux
   344	    limit = memory_limit(); w = plan_workers(limit, peak, parent, requested)
   345	    rec = {"limit_bytes": limit, "task_peak_bytes": peak, "parent_bytes": parent, "requested": requested, "workers": w}
   346	    write(Path(out) / "memory_preflight.json", rec)
   347	    return rec
