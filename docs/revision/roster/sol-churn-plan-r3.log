    44	class FactorialRule(Mechanism):
    45	    def __init__(self, P: int, G: int, S: int, tol: float, L: int, reserve: str = "full") -> None:
    46	        if any(v not in (0, 1) for v in (P, G, S)):
    47	            raise ValueError("P, G, S must be 0 or 1")
    48	        self.P, self.G, self.S, self.tol, self.L, self.reserve = int(P), int(G), int(S), float(tol), int(L), str(reserve)
    49	        if self.reserve != "full" and not (self.P and self.G and self.S):
    50	            raise ValueError("the half reserve is R4 only")
    51	        self.name = "R4" if self.reserve == "half" else f"F{self.P}{self.G}{self.S}"
    52	        self._b3 = SecondScore(self.tol, self.L)
    53	        self._pacing = ReservePacing(self.reserve, self.L)
    54	        self.T, self.cap = 1, 1
    55	
    56	    def bind(self, cfg) -> None:
    57	        self.T, self.cap = int(cfg.T), spread_cap(cfg)
    58	        self._pacing.bind(cfg)
    59	
    60	    @staticmethod
    61	    def _memory(view: StateView) -> tuple[dict, dict, dict]:
    62	        m = view.memory
    63	        return m.setdefault("first_round", {}), m.setdefault("audits", {}), m.setdefault("served", {})
    64	
    65	    def allocate(self, values_t: np.ndarray, offers: Offers, view: StateView) -> dict[int, int]:
    66	        first_round, _, served = self._memory(view)
    67	        for i in offers:
    68	            if view.is_active(i):
    69	                first_round.setdefault(int(i), int(view.t))
    70	                served.setdefault(int(i), 0)
    71	        out = self._b3.allocate(values_t, offers, view)
    72	        for i in out.values():
    73	            served[int(i)] = served.get(int(i), 0) + 1
    74	        return out
    75	
    76	    def price(self, assignment, values_t, offers, view) -> dict[int, float]:
    77	        return self._b3.price(assignment, values_t, offers, view)
    78	
    79	    def audit(self, assignment: dict[int, int], view: StateView) -> list[int]:
    80	        first_round, audits, _ = self._memory(view)
    81	        n = len(assignment)
    82	        k = self._pacing.count(view, n) if self.S else spread_count(view, self.T, self.cap, n)
    83	        if k <= 0:
    84	            return []
    85	        by_identity: dict[int, list[int]] = {}
    86	        for j, i in assignment.items():
    87	            by_identity.setdefault(int(i), []).append(int(j))
    88	        chosen = select(by_identity, view.audit_key, first_round, view.t, self.L, k, self.P, self.G, order=[int(j) for j in assignment])
    89	        for j in chosen:
    90	            i = int(assignment[j]); audits[i] = audits.get(i, 0) + 1
    91	        return chosen
    92	
    93	    def enforce(self, records: tuple[AuditRecord, ...], view: StateView) -> Consequences:
    94	        cons = Consequences()
    95	        for r in records:
    96	            if r.failed:
    97	                cons.refunds[r.job] = float(view.escrow[r.job])
    98	                cons.bans[r.provider] = max(cons.bans.get(r.provider, 0), int(self.L))
    99	        return cons
   100	
   101	    def describe(self) -> dict:
   102	        d = dict(self._b3.describe())
   103	        if self.name != "F000":
   104	            d["audit_selection"] = "not expressible"
   105	        d["parameters"] = {"audit_tolerance": float(self.tol), "ban_length": int(self.L)}
   106	        return d
   107	
   108	
   109	def make_factorial(name: str, tol: float, L: int) -> FactorialRule:
   110	    if name == "R4":
   111	        return FactorialRule(1, 1, 1, tol, L, reserve="half")
   112	    if name not in NAMES:
   113	        raise ValueError(f"unknown factorial cell {name!r}")
   114	    return FactorialRule(int(name[1]), int(name[2]), int(name[3]), tol, L)
