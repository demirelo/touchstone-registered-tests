    24	class SeedCache:
    25	    """Draws and S* per (market, seed): computed once, shared by every cell. Counts episodes run."""
    26	
    27	    def __init__(self) -> None:
    28	        self._store: dict[tuple[str, int], tuple[Draws, float]] = {}
    29	        self.hits = 0
    30	        self.misses = 0
    31	        self.runs = 0
    32	
    33	    def get(self, cfg: MarketConfig, seed: int) -> tuple[Draws, float]:
    34	        key = (market_key(cfg), int(seed))
    35	        if key in self._store:
    36	            self.hits += 1
    37	            return self._store[key]
    38	        self.misses += 1
    39	        d = make_draws(cfg, seed)
    40	        self._store[key] = (d, first_best_episode(cfg, d))
    41	        return self._store[key]
