    39	def attack_search(cell: Cell, family: Family, cache: SeedCache, settings: SearchSettings, seed: int, twin: SearchResult) -> SearchResult:
    40	    """Attack search with the twin best and the honest-max point as registered incumbents (spec 5.2)."""
    41	    return cma_search(Objective(cell, family, cache), family, settings, seed,
    42	                      incumbents={"twin_best": twin.best_knobs, "honest_point": family.honest_point()})
