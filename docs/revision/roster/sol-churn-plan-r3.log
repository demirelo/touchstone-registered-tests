    52	
    53	def reference_candidates(cell: Cell, family: Family, attack: SearchResult, twin: SearchResult,
    54	                         bank_members: list[dict], order=REFERENCE_ORDER) -> list[Candidate]:
    55	    """Every reference candidate in projected form, in registered tie order (spec 5.2); de-duplicated by exact key."""
    56	    n = len(cell.seeds)
    57	    groups: dict[str, list[Candidate]] = {}
    58	    groups["abstain"] = [Candidate("abstain", Abstain, None, np.zeros(n), np.zeros(n))]
    59	    groups["honest_max"] = [Candidate("honest_max", HonestMax, None)]
    60	    tw = family.project(twin.best_knobs)
    61	    groups["twin_search"] = [Candidate("twin_search", _factory(family, tw), tw, **_known(twin.archive.get(exact_key(tw))))]
    62	    proj = family.project(attack.best_knobs)
    63	    groups["attack_projection"] = [Candidate("attack_projection", _factory(family, proj), proj, **_known(attack.archive.get(exact_key(proj))))]
    64	    e1 = best_archived(attack.archive, clip=1)
    65	    groups["archive_clip1"] = [] if e1 is None else [Candidate("archive_clip1", _factory(family, e1.knobs), dict(e1.knobs), **_known(e1))]
    66	    e0 = best_archived(attack.archive, clip=0, truthful_only=True)
    67	    if e0 is None:
    68	        groups["archive_truthful_clip0"] = []
    69	    else:   # never inflated on dev-train: its projection has the same trajectory, so its observed values are its projected values
    70	        p0 = family.project(e0.knobs)
    71	        groups["archive_truthful_clip0"] = [Candidate("archive_truthful_clip0", _factory(family, p0), p0, **_known(e0))]
    72	    groups["bank"] = [Candidate(f"bank_{i}", _factory(family, family.project(m)), family.project(m)) for i, m in enumerate(bank_members)]
    73	    out, seen = [], set()
    74	    for g in order:
    75	        for c in groups.get(g, []):
    76	            key = exact_key(c.knobs) if c.knobs is not None else ("name", c.name)
    77	            if key in seen:
    78	                continue
    79	            seen.add(key); out.append(c)
    80	    return out
