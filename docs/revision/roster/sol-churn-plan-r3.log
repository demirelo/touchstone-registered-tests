    34	def twin_search(cell: Cell, family: Family, cache: SeedCache, settings: SearchSettings, seed: int) -> SearchResult:
    35	    starts = family.registered_starts({"near_corner": settings.near_corner, "sobol_seed": settings.sobol_seed}, twin=True)
    36	    return cma_search(Objective(cell, family, cache, force_clip=True), family, settings, seed, starts=starts)
