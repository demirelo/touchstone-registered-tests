    83	def select_reference(cell: Cell, candidates: list[Candidate], cache: SeedCache) -> ReferenceChoice:
    84	    """Highest mean normalized profit on the cell's seeds; ties to the earlier candidate; known values need no run."""
    85	    best, scores = None, {}
    86	    for c in candidates:
    87	        if c.known_normalized is not None and len(c.known_normalized) == len(cell.seeds):
    88	            profit, norm = c.known_profit, c.known_normalized
    89	        else:
    90	            fr = run_focal(cell, c.policy_factory, cache)
    91	            profit, norm = fr.profit, fr.normalized
    92	        score = float(norm.mean())
    93	        scores[c.name] = score
    94	        if best is None or score > best[0]:
    95	            best = (score, c, profit, norm)
    96	    _, c, profit, norm = best
    97	    return ReferenceChoice(candidate=c, per_seed_profit=np.asarray(profit, dtype=float), per_seed_normalized=np.asarray(norm, dtype=float), scores=scores)
