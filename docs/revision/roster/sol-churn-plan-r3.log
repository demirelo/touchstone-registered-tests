    44	
    45	def _factory(family: Family, knobs: dict) -> Callable:
    46	    return lambda: family.make(knobs)
    47	
    48	
    49	def _known(entry) -> dict:
    50	    return {} if entry is None else {"known_profit": entry.per_seed_profit, "known_normalized": entry.per_seed_normalized}
