    17	def market_key(cfg: MarketConfig) -> str:
    18	    """Hash of the market primitives; alpha and budget excluded (draws and S* do not depend on them)."""
    19	    parts = (cfg.N, cfg.J, cfg.T, cfg.sigma, cfg.e, cfg.v_min, cfg.v_max,
    20	             tuple((p.q_max, p.a, p.b, p.k) for p in cfg.providers))
    21	    return hashlib.sha256(repr(parts).encode()).hexdigest()[:16]
