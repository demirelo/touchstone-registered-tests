    51	@dataclass(frozen=True)
    52	class Cell:
    53	    cfg: MarketConfig
    54	    rule_factory: Callable
    55	    focal: int
    56	    seeds: tuple[int, ...]
    57	    name: str
    58	    others: tuple = ()      # ((entity, policy_factory), ...) for non-focal entities not on honest-max
