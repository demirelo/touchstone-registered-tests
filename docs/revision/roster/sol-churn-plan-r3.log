   186	def evaluate_gain(cell: Cell, family: Family, attack_knobs: dict, reference: Candidate, cache: SeedCache) -> GainResult:
   187	    attack = run_focal(cell, _factory(family, dict(attack_knobs)), cache)
   188	    clipped = run_focal(cell, _factory(family, family.project(attack_knobs)), cache)
   189	    ref = run_focal(cell, reference.policy_factory, cache)
   190	    honest = run_focal(cell, HonestMax, cache)
   191	    N, f = cell.cfg.N, cell.focal
   192	    sstar = np.array([r.sstar for r in attack.results])
   193	    scale = sstar / N
   194	    inflation = (attack.profit - clipped.profit) / scale
   195	    selection = (clipped.profit - ref.profit) / scale
   196	    hm = np.array([harm(a, r, f) for a, r in zip(attack.results, ref.results)])
   197	    diag = [participant_diagnostics(r, cell.cfg, f) for r in attack.results]
   198	    served = np.array([int(r.served[:, f].sum()) for r in attack.results])
   199	    audited = np.array([int(r.audits.sum()) for r in attack.results])
   200	    total_served = np.array([int(r.served.sum()) for r in attack.results])
   201	    return GainResult(
   202	        gain=inflation + selection, inflation_term=inflation, selection_term=selection,
   203	        profit_attack=attack.profit, profit_clip=clipped.profit, profit_ref=ref.profit, profit_honest=honest.profit, sstar=sstar,
   204	        eff_attack=_gross(attack.results), eff_clip=_gross(clipped.results), eff_ref=_gross(ref.results), eff_honest=_gross(honest.results),
   205	        net_eff_attack=_net(attack.results), net_eff_ref=_net(ref.results),
   206	        audit_cost_attack=np.array([r.audit_cost for r in attack.results]),
   207	        audit_spend_attack=np.array([r.audit_cost / r.sstar for r in attack.results]),
   208	        audited_fraction_attack=np.where(total_served > 0, audited / np.maximum(total_served, 1), 0.0),
   209	        harm_accounting=hm[:, 0], harm_direct=hm[:, 1],
   210	        served_focal_attack=served, failures_focal_attack=np.array([int(r.failures[:, f].sum()) for r in attack.results]),
   211	        entry_attack=np.array([r.entry for r in attack.results]),
   212	        n_identities_attack=np.array([r.n_identities for r in attack.results]),
