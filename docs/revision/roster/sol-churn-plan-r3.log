    62	def install() -> None:
    63	    """Wrap three revision_v2 names (idempotent): `train_cell`, so a job with a `churn` rate gets churning opponents in
    64	    every cell built from it; `select_reference`, so a cell with churning opponents never reuses a candidate's stored
    65	    no-churn training profits (internal review r1, blocker 1); and `reference_of`, so a churn job's frozen reference
    66	    carries its training-seed score evaluated under the same churn, which the doubling stage's reference_change subtracts."""
    67	    if _ORIG:
    68	        return
    69	    _ORIG.update(train_cell=R.train_cell, select_reference=R.select_reference, reference_of=R.reference_of)
    70	
    71	    def train_cell(job, others=()):
    72	        cell = _ORIG["train_cell"](job, others)
    73	        p = job.get("churn")
    74	        if p is None or others:
    75	            return cell
    76	        from dataclasses import replace
    77	        return replace(cell, others=tuple((e, _churn_factory(p)) for e in range(cell.cfg.N) if e != cell.focal))
    78	
    79	    def select_reference(cell, candidates, cache):
    80	        if cell.others:
    81	            from dataclasses import replace
    82	            candidates = [c if c.name == "abstain" else replace(c, known_profit=None, known_normalized=None) for c in candidates]
    83	        return _ORIG["select_reference"](cell, candidates, cache)
    84	
    85	    def reference_of(job, out):
    86	        cand, rrec, path = _ORIG["reference_of"](job, out)
    87	        if job.get("churn") is None:
    88	            return cand, rrec, path
    89	        key = (job["id"], str(path))
    90	        if key not in _REF_CACHE:
    91	            from sim.cell import SeedCache, run_focal
    92	            fr = run_focal(R.train_cell(job), cand.policy_factory, SeedCache())
    93	            _REF_CACHE[key] = [float(x) for x in fr.normalized]
    94	        return cand, {**rrec, "per_seed_normalized": list(_REF_CACHE[key]), "churn_reevaluated": True}, path
    95	
    96	    R.train_cell, R.select_reference, R.reference_of = train_cell, select_reference, reference_of
