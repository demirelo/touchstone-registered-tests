   311	def plan_workers(limit: int, task_peak: int, parent: int, requested: int, headroom: float = 0.9) -> int:
   312	    """Workers for the four-profile stages that fit the memory limit: floor((headroom x limit - parent) / task peak)."""
   313	    n = int((headroom * limit - parent) // task_peak)
   314	    if n < 1:
   315	        raise SystemExit(f"churn arm refused: memory limit {limit} bytes holds no {task_peak}-byte task")
   316	    return min(int(requested), n)
   317	
   318	
   319	def memory_limit() -> int:
   320	    """The cgroup memory limit (v2 or v1), else the physical memory."""
   321	    import os
   322	    for f in ("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory/memory.limit_in_bytes"):
   323	        try:
   324	            v = Path(f).read_text().strip()
   325	            if v.isdigit() and int(v) < 2 ** 60:
   326	                return int(v)
   327	        except OSError:
   328	            pass
   329	    return os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
