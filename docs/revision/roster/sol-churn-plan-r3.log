   353	def _run_rate(out, jobs, steps, a, salt_sha, container, p, started) -> None:
   354	    F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
   355	    if not a.smoke:
   356	        F.check_pairing(a.src, jobs)
   357	    slow = 1.33 if p > 0 else 1.0
   358	    for st in steps:
   359	        w = a.workers_search if st == "search" else a.workers_eval
   360	        if st in STAGE_SECONDS:
   361	            check_cap(started, STAGE_SECONDS[st] * slow * -(-len(jobs) // max(1, w)), a.stop_usd, a.usd_per_hour, prior_usd=a.prior_usd)
   362	        if st == "inputs":
   363	            F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
   364	        elif st == "search":
   365	            run_stage("search", jobs, out, w)
   366	        elif st == "freeze":
   367	            F.prefreeze(out, jobs)
   368	        elif st in ("evaluate", "doubling"):
   369	            F.accept(out, jobs, salt_sha, container, src=a.src)
   370	            if not a.smoke and len(jobs) > 1:
   371	                w = memory_preflight(jobs[0], out, w)["workers"]
   372	            run_stage(st, jobs, out, w)
   373	        elif st == "diagnostics":
   374	            write(Path(out) / "diagnostics.json", diagnostics(out, jobs, w))
   375	        else:
   376	            inventory(out, p)
   377	        print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs)}), flush=True)
