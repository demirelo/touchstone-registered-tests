   163	def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, attempts, ledger=None, tag: str | None = None, clock=time.time,
   164	                   stop_file=None, soft_deadline=None) -> CostStop:
   165	    """A paid run must state the pod allocation time, a positive rate (the price ceiling), the launcher's attempts file,
   166	    and the ledger with the run's tag: closed attempts of this launch and recorded spend of earlier launches count toward
   167	    the cap (no default of zero)."""
   168	    if started is None:
   169	        _refuse("a paid run needs --started-at (the pod allocation time)")
   170	    if not usd_per_hour > 0 or not cap_usd > 0:
   171	        _refuse("a paid run needs a positive rate and cap")
   172	    if attempts is None:
   173	        _refuse("a paid run needs --attempts (the launcher's attempts file)")
   174	    if not tag:
   175	        _refuse("a paid run needs --run-tag and --ledger (spend of earlier launches)")
   176	    prior = attempts_spend(attempts, usd_per_hour, started, clock())["closed_usd"] + ledger_spend(ledger, tag)
   177	    return CostStop(cap_usd, usd_per_hour, started, clock, prior, stop_file, soft_deadline)
