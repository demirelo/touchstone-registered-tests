def rule_spec(rule: str, params: dict | None) -> dict:
    p = params or {}
    if rule in FIXED:
        spec = {"tol": 0.16, "L": 10}
    elif rule == "B2":
        b2 = registered_b2_params(); spec = {"tol": float(b2["tol"]), "L": int(b2["L"]), "b2": b2}
    else:
        t = (p.get("tuned") or {}).get(rule)
        if t is None:
            raise SystemExit(f"{rule}: no tuned parameters in --params")
        spec = {"tol": float(t["tol"]), "L": int(t["L"])}
    if rule.startswith("C*"):
        if not p.get("cred"):
            raise SystemExit(f"{rule}: no comparator (cred) in --params")
        spec["cred"] = dict(p["cred"])
    return spec


def rule_factory(job: dict):
    s = job["spec"]
    return lambda: make_rule(job["rule"], s["tol"], s["L"], cred=s.get("cred"), b2_params=s.get("b2"))


def constants(job: dict) -> tuple[int, int]:
    rule = rule_factory(job)()
    pc = public_constants(rule, job["mkt"]["cfg"])
    return pc["T"], pc["L"]


@lru_cache(maxsize=8)
def _h4(path: str, sha: str):
    return load_h4(Path(path), sha)


def family_for(name: str, T: int, L: int, h4: dict | None = None) -> Family:
    if name == "H4":
        src = _h4(h4["dir"], h4["sha"]) if h4 else Excluded("no bundle")
        if isinstance(src, Excluded):
            raise SystemExit(f"H4 excluded: {src.reason}")
        return FV2.family_for(name, T, L, src)
    return FV2.family_for(name, T, L)


def cell_id(ctx: str, rule: str, family: str, objective: str, c=None, schedule=None) -> str:
    return f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")


@lru_cache(maxsize=1)
def _cells_by_id() -> dict:
    return {c["id"]: c for c in MAN.cells()}


def job(mkt: dict, rule: str, family: str, objective: str = "profit", c: int | None = None, schedule: str | None = None,
        smoke: bool = False, params: dict | None = None, h4: dict | None = None, block: str | None = None) -> dict:
    lk = load_locked(); s = lk["search"]
    R, E, n_train, n_eval = SMOKE if (smoke or mkt["smoke"]) else (int(s["restarts"]), int(s["evals_per_restart"]), len(mkt["seeds_train"]), len(mkt["seeds_eval"]))
    if family in ("X7-SC", "H4"):                   # H4 is priced and searched as an X7-SC cell (design draft 7, 5.3)
        E *= 2
    spec = rule_spec(rule, params)
    j = {"id": cell_id(mkt["context"], rule, family, objective, c, schedule), "context": mkt["context"], "rule": rule, "family": family,
         "objective": objective, "c": c, "schedule": schedule, "budget": [R, E, n_train, n_eval], "spec": spec, "mkt": mkt,
         "h4": h4 if family == "H4" else None}
    cell = _cells_by_id().get(j["id"].replace(j["context"], manifest_ctx(j["context"]), 1))
    j["block"] = block or (cell or {}).get("block"); j["priority"] = MAN.priority(cell) if cell else 3      # execution priority (design 8.2)
    j["provenance"] = context_provenance(mkt) | {"budget": j["budget"], "rule_params_sha256": _sha_json(spec), "id": j["id"]}
    if family == "H4" and h4:
        j["provenance"]["h4_sha256"] = str(h4["sha"])
    return j


def context_provenance(mkt: dict) -> dict:
"""Stage records of the v2 runner: atomic JSON writes, tolerant reads (a missing or truncated file is absent), and
validation of a record's stage, provenance, and upstream hashes against the current files."""
from __future__ import annotations

import hashlib
import json
import os
import secrets
from pathlib import Path


def write(path, rec: dict) -> None:
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")       # unique per writer
    with open(tmp, "w") as f:
        json.dump(rec, f, default=float); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, p)


def read(path) -> dict | None:
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def sha_file(path) -> str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def validate(job: dict, stage: str, rec: dict, upstream: dict) -> None:
    """`upstream` maps each upstream record id to its current path; raises ValueError on any mismatch."""
    if rec.get("stage") != stage:
        raise ValueError(f"record stage {rec.get('stage')!r} is not {stage!r}")
    if rec.get("provenance") != job.get("provenance"):
        raise ValueError("record provenance differs from the job's")
    for rid, sha in (rec.get("upstream") or {}).items():
        p = upstream.get(rid)
        if p is None or not Path(p).exists() or sha_file(p) != sha:
            raise ValueError(f"upstream {rid} changed or is missing")
"""JSON records for the sweep stages: configs, search results with archives, candidates."""
from __future__ import annotations

import numpy as np

from .cell import Abstain
from .config import MarketConfig, ProviderParams
from .policies.families import Family, exact_key
from .policies.honest import HonestMax
from .reference import Candidate
from .search import ArchiveEntry, SearchResult


def cfg_to_dict(cfg: MarketConfig) -> dict:
    return {"N": cfg.N, "J": cfg.J, "T": cfg.T, "sigma": cfg.sigma, "e": cfg.e, "v_min": cfg.v_min, "v_max": cfg.v_max,
            "providers": [[p.q_max, p.a, p.b, p.k] for p in cfg.providers], "alpha": cfg.alpha, "budget": cfg.budget}


def cfg_from_dict(d: dict) -> MarketConfig:
    return MarketConfig(N=int(d["N"]), J=int(d["J"]), T=int(d["T"]), sigma=float(d["sigma"]), e=float(d["e"]), v_min=float(d["v_min"]),
                        v_max=float(d["v_max"]), providers=tuple(ProviderParams(float(q), float(a), float(b), int(k)) for q, a, b, k in d["providers"]),
                        alpha=float(d["alpha"]), budget=float(d["budget"]))


def search_to_json(res: SearchResult) -> dict:
    return {"best_x": [float(v) for v in np.asarray(res.best_x)], "best_knobs": res.best_knobs, "best_f": res.best_f, "best_source": res.best_source,
            "restart_bests": [float(v) for v in res.restart_bests], "evals": res.evals, "incumbent_scores": res.incumbent_scores,
            "projection_f": res.projection_f, "replaced_by_projection": res.replaced_by_projection,
            "trace": [[int(e), float(f)] for e, f in res.trace], "evaluations": list(res.evaluations),            # amendment 2
            "archive": [{"knobs": e.knobs, "f": e.f, "per_seed_profit": [float(v) for v in e.per_seed_profit],
                         "per_seed_normalized": [float(v) for v in e.per_seed_normalized], "inflated": bool(e.inflated), "source": e.source}
                        for e in res.archive.values()]}


def search_from_json(d: dict) -> SearchResult:
    archive = {exact_key(e["knobs"]): ArchiveEntry(knobs=e["knobs"], f=float(e["f"]), per_seed_profit=np.array(e["per_seed_profit"]),
                                                   per_seed_normalized=np.array(e["per_seed_normalized"]), inflated=bool(e["inflated"]), source=e["source"])
               for e in d["archive"]}
    return SearchResult(best_x=np.array(d["best_x"]), best_knobs=d["best_knobs"], best_f=float(d["best_f"]), best_source=d["best_source"],
                        restart_bests=list(d["restart_bests"]), evals=int(d["evals"]), trace=[(int(e), float(f)) for e, f in d.get("trace", [])],
                        incumbent_scores=dict(d["incumbent_scores"]), projection_f=float(d["projection_f"]), replaced_by_projection=bool(d["replaced_by_projection"]),
                        archive=archive, evaluations=list(d.get("evaluations", [])))


def candidate_to_json(c: Candidate) -> dict:
    return {"name": c.name, "knobs": c.knobs}


def candidate_from_record(family: Family, d: dict) -> Candidate:
    if d["knobs"] is None:
        return Candidate(d["name"], Abstain if d["name"] == "abstain" else HonestMax, None)
    knobs = dict(d["knobs"])
    return Candidate(d["name"], lambda: family.make(knobs), knobs)
