   223	        if fr is None or fr.get("stage") != "freeze" or fr.get("followup") is not True or fr.get("cuts") != F.CUTS or fr.get("h4_excluded") != F.H4_EXCLUDED \
   224	                or not fr.get("records") or fr["records"] != want or not _deps_ok(d, fr["records"], set(want)):
   225	            out.append("freeze empty, incomplete, or stale")
   226	        if ev is None or ev.get("stage") != "evaluate" or ev.get("provenance") != (srch or {}).get("provenance") \
   227	                or not _deps_ok(d, ev.get("upstream") or {}, {cell, f"reference/{ctx}/{cell.split('|')[1]}", f"freeze/{ctx}"}):
   228	            out.append("evaluation record: stage, provenance, or dependencies wrong")
   229	    else:
   230	        db = read(d / "doubling" / (F.R._safe(cell) + ".json"))
   231	        if db is None or db.get("stage") != "doubling" or db.get("id") != cell or not _deps_ok(d, db.get("upstream") or {}, set(inp)) \
   232	                or (reg is not None and any((db.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV)):
   233	            out.append("doubling record: stage, provenance, or dependencies wrong")
   234	    return out
