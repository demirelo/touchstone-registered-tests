   213	def _supporting_problems(d: Path, stage: str, cell: str, inp: dict, srch, src) -> list:
   214	    """The supporting records' stages, provenance, dependency sets, dependency hashes, and the freeze contents."""
   215	    out, ctx = [], cell.split("|")[0]
   216	    reg = read(F.R.path_of(src, cell)) if src is not None else None
   217	    if reg is not None and srch is not None and any((srch.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV):
   218	        out.append("search provenance differs from the registered record")
   219	    if stage == "reproduction gate":
   220	        fr, ev = read(d / "freeze" / f"{ctx}.json"), read(F.R.eval_path(d, cell))
   221	        want = {r: h for r, h in inp.items() if r.startswith(ctx) or f"/{ctx}/" in r}
   222	        want[cell] = sha_file(F.R.path_of(d, cell)) if F.R.path_of(d, cell).exists() else None
   223	        if fr is None or fr.get("stage") != "freeze" or fr.get("followup") is not True or fr.get("cuts") != F.CUTS or fr.get("h4_excluded") != F.H4_EXCLUDED \
   224	                or not fr.get("records") or fr["records"] != want or not _deps_ok(d, fr["records"], set(want)):
   225	            out.append("freeze empty, incomplete, or stale")
   226	        if ev is None or ev.get("stage") != "evaluate" or ev.get("provenance") != (srch or {}).get("provenance") \
   227	                or not _deps_ok(d, ev.get("upstream") or {}, {cell, f"reference/{ctx}/{cell.split('|')[1]}", f"freeze/{ctx}"}):
   228	            out.append("evaluation record: stage, provenance, or dependencies wrong")
   229	    else:
