   174	                if need.get(k, v) != v or todo.get(k, v) != v:
   175	                    _refuse(f"{k}: two original records hold different hashes")
   176	                if k not in need:
   177	                    todo[k] = v
   178	    return need
   179	
   180	
   181	def copy_inputs(src, out, need: dict[str, str]) -> None:
   182	    """Copy each input read-only, checked against its recorded hash; an existing identical copy is kept."""
   183	    for rid, sha in sorted(need.items()):
   184	        p, q = R.path_of(src, rid), R.path_of(out, rid)
   185	        if not p.exists():
   186	            _refuse(f"input {rid} is missing in {src}")
   187	        if sha_file(p) != sha:
   188	            _refuse(f"input {rid} differs from the hash in the original records")
   189	        if q.exists():
   190	            if sha_file(q) != sha:
   191	                _refuse(f"{q} exists and differs from the original {rid}")
   192	            continue
   193	        q.parent.mkdir(parents=True, exist_ok=True); shutil.copyfile(p, q); q.chmod(0o444)
   194	    prev = read(Path(out) / "inputs.json")
   195	    if prev is not None and any(prev[k] != v for k, v in need.items() if k in prev):
   196	        _refuse("inputs.json lists other hashes for the same records")
   197	    write(Path(out) / "inputs.json", {**(prev or {}), **need})
   198	
   199	
   200	def check_configs(jobs: list[dict], container: dict) -> None:
   201	    """Each job's configuration hash equals the recorded container hash (addendum.json deviations.configs)."""
   202	    for j in jobs:
   203	        label = j["mkt"]["label"]; want = (container.get(label) or {}).get("container_hash")
   204	        if j["provenance"]["cfg_sha256"] != want:
   205	            _refuse(f"{j['id']}: configuration hash {j['provenance']['cfg_sha256']} is not the container hash {want}")
   206	
   207	
   208	def _ctx_inputs(out, ctx: str) -> dict[str, str]:
   209	    return {r: s for r, s in (read(Path(out) / "inputs.json") or {}).items() if ctx in r}
   210	
   211	
   212	def prefreeze(out, jobs: list[dict]) -> None:
   213	    """The pre-evaluation freeze of each context: its copied inputs and its new search records, with their hashes."""
   214	    for ctx in sorted({j["context"] for j in jobs}):
   215	        recs = dict(_ctx_inputs(out, ctx))
   216	        for j in (j for j in jobs if j["context"] == ctx):
   217	            p = R.path_of(out, j["id"]); rec = read(p)
   218	            if rec is None or rec.get("stage") != "search" or rec.get("provenance") != j["provenance"]:
   219	                _refuse(f"{j['id']}: no current search record to freeze")
   220	            recs[j["id"]] = sha_file(p)
   221	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED, "records": recs}
   222	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   223	        if old is not None and old != body:
   224	            _refuse(f"{p} exists with other records")
   225	        if old is None:
   226	            write(p, body)
   227	
   228	
   229	def accept(out, jobs: list[dict], salt_sha256: str, container: dict, src=None) -> None:
   230	    """Run before evaluation and before doubling: the freeze exists and every record in it, and every copied input,
   231	    still has its hash; the identity salt and the configurations are the recorded ones; with `src`, inputs.json holds
   232	    every input recomputed from the original records."""
   233	    check_salt(out, salt_sha256, jobs)
   234	    check_configs(jobs, container)
   235	    if src is not None:
   236	        have = read(Path(out) / "inputs.json") or {}
   237	        if bad := sorted(r for r, s in inputs(src, jobs).items() if have.get(r) != s):
   238	            _refuse(f"inputs.json lacks or differs on {bad[:3]}")
   239	    for ctx in sorted({j["context"] for j in jobs}):
   240	        fr = read(R.path_of(out, f"freeze/{ctx}"))
   241	        if fr is None or not fr.get("followup"):
   242	            _refuse(f"{ctx}: no follow-up freeze")
   243	        want = {**_ctx_inputs(out, ctx), **{j["id"]: None for j in jobs if j["context"] == ctx}}
   244	        if missing := sorted(set(want) - set(fr["records"])):
   245	            _refuse(f"{ctx}: the freeze lacks {missing}")
   246	        for r, sha in fr["records"].items():
   247	            p = R.path_of(out, r)
   248	            if not p.exists() or sha_file(p) != sha or (want.get(r) not in (None, sha)):
   249	                _refuse(f"{ctx}: {r} differs from the freeze")
   250	
   251	
   252	def run_stage(stage: str, jobs: list[dict], out, workers: int = 1) -> list[str]:
   253	    return R._pool(stage, jobs, Path(out), workers, CUTS, H4_EXCLUDED, jobs)
   254	
   255	
   256	def inventory(out) -> dict:
   257	    """Every output file with its hash, written after the outputs, so no record lists itself."""
   258	    out = Path(out)
   259	    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
   260	            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
   261	    inv = {"stage": "inventory", "deviations": list(DEVIATIONS), "environment": environment(), "records": recs}
   262	    write(out / "inventory.json", inv)
   263	    return inv
   264	
   265	
   266	def reset_stats(results, focal: int) -> dict:
   267	    """Plan section 4: per episode, the focal provider's identity replacements, the rounds they were created, the rounds
   268	    without a focal offer (banned or waiting), and the ban rounds imposed on its identities."""
   269	    import numpy as np
   270	    resets, rounds, no_offer, bans = [], [], [], []
   271	    for r in results:
   272	        mine = [i for i, e in enumerate(r.entity_of) if e == focal]
   273	        new = [i for i in mine if r.identity_generation[i] > 0]
   274	        resets.append(len(new)); rounds.append([int(r.identity_round[i]) for i in new])
   275	        no_offer.append(int(np.isnan(r.claims[:, focal]).sum()))
   276	        bans.append(int(sum(v for h in r.history for i, v in h.consequences.bans.items() if i in mine)))
   277	    return {"resets": resets, "reset_rounds": rounds, "no_offer_rounds": no_offer, "ban_rounds": bans,
   278	            "mean_resets": float(np.mean(resets)), "p_any_reset": float(np.mean([x > 0 for x in resets])),
   279	            "mean_no_offer_rounds": float(np.mean(no_offer)), "mean_ban_rounds": float(np.mean(bans))}
   280	
   281	
   282	def require_zero_resets(stats: dict, what: str) -> None:
   283	    """Plan section 4: a D2 winner (x = 0) must never replace its identity; anything else is a construction error."""
   284	    if any(stats["resets"]):
   285	        _refuse(f"{what}: the D2 winner has resets in {sum(1 for r in stats['resets'] if r)} episodes")
   286	
