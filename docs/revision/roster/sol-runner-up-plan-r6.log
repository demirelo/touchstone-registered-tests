     1	"""Pod safety primitives for the follow-up launchers (internal reviews r8-r9 of reset_pod.sh). Every function fails
     2	closed: a failed listing counts as "pods may still exist", and success needs a successful listing that shows no pod.
     3	Time limits are measured in elapsed seconds, never in loop counts.
     4	
     5	CLI (exit 0 = success):
     6	  podctl.py reconcile NAME [KEEP_ID]          delete every pod named NAME except KEEP_ID; verified by a fresh listing
     7	  podctl.py delete ID SECONDS                 delete one pod and verify it is gone within SECONDS
     8	  podctl.py watchdog NAME HARD_TS DONE_FILE   after DONE_FILE, or from HARD_TS (also writes NAME.blocked): delete every
     9	                                              pod named NAME; exits only with DONE_FILE and SETTLE s of empty listings
    10	  podctl.py may-create NAME HARD_TS           exit 0 only before HARD_TS and while NAME.blocked does not exist
    11	  podctl.py remaining UNTIL_TS                print the seconds left (0 when past)
    12	"""
    13	from __future__ import annotations
    14	
    15	import json
    16	import os
    17	import subprocess
    18	import sys
    19	import time
    20	
    21	HERE = os.path.dirname(os.path.abspath(__file__))
    22	PY = sys.executable
    23	
    24	
    25	def _run(args, timeout=60):
    26	    try:
    27	        r = subprocess.run([PY, os.path.join(HERE, "runpod.py")] + args, capture_output=True, text=True, timeout=timeout)
    28	        return r.returncode, r.stdout
    29	    except subprocess.TimeoutExpired:
    30	        return 124, ""
    31	
    32	
    33	def list_pods(run=_run, timeout=60):
    34	    """The pods as a list, or None when the listing failed (never an empty list on failure). The timeout stays
    35	    fractional so a command never outlives a sub-second budget (r11 Astra 5)."""
    36	    rc, out = run(["list"], timeout=max(0.01, float(timeout)))
    37	    if rc != 0:
    38	        return None
    39	    try:
    40	        pods = json.loads(out)
    41	    except ValueError:
    42	        return None
    43	    return pods if isinstance(pods, list) else None
    44	
    45	
    46	def named(pods, name):
    47	    return [p["id"] for p in pods if p.get("name") == name]
    48	
    49	
    50	def delete_verified(pid, seconds, run=_run, clock=time.time, sleep=time.sleep):
    51	    """Delete PID until a successful listing no longer shows it, within SECONDS of elapsed time."""
    52	    end = clock() + seconds
    53	    while clock() < end:
    54	        run(["delete", pid], timeout=max(0.01, min(60.0, end - clock())))
    55	        if clock() >= end:
    56	            break
    57	        pods = list_pods(run, min(60, end - clock()))
    58	        if clock() < end + 1e-9 and pods is not None and pid not in [p["id"] for p in pods]:
    59	            return clock() <= end
    60	        sleep(min(15, max(0.0, end - clock())))
    61	    return False
    62	
    63	
    64	def reconcile(name, keep="", seconds=600, run=_run, clock=time.time, sleep=time.sleep):
    65	    """Delete every pod named NAME except KEEP; True only when a successful listing shows none left."""
    66	    end = clock() + seconds
    67	    while clock() < end:
    68	        pods = list_pods(run, min(60, end - clock()))
    69	        if pods is not None and clock() <= end:
    70	            extra = [i for i in named(pods, name) if i != keep]
    71	            if not extra:
    72	                return True
    73	            for i in extra:
    74	                if clock() >= end:
    75	                    break
    76	                delete_verified(i, end - clock(), run, clock, sleep)
    77	        sleep(min(15, max(0.0, end - clock())))
    78	    return False
    79	
    80	
    81	def may_create(name, hard_ts, clock=time.time, here=HERE):
    82	    return clock() < hard_ts and not os.path.exists(os.path.join(here, f"{name}.blocked"))
    83	
    84	
    85	SETTLE = 300            # seconds of consecutive empty listings, counted only after DONE, before the watchdog ends
    86	AMBIGUOUS_SETTLE = 1800  # the same after an ambiguous creation answer (NAME.ambiguous): assumed service bound for a late pod
    87	
    88	
    89	def classify_creation(answer, exc=None):
    90	    """(pod id, ambiguous) for one creation request. Only a clear client refusal (HTTP 4xx other than 408 and 429) is
    91	    unambiguous; a timeout, exception, server or gateway error, or unreadable answer may still create a pod (r11)."""
    92	    if exc is not None:
    93	        return "", True
    94	    if isinstance(answer, dict) and answer.get("id"):
    95	        return str(answer["id"]), False
    96	    if isinstance(answer, dict) and isinstance(answer.get("error"), int):
    97	        code = answer["error"]
    98	        return "", not (400 <= code < 500 and code not in (408, 429))
    99	    return "", True
   100	
   101	
   102	def _final_bound(here, name):
   103	    try:
   104	        tfirst, rate = open(os.path.join(here, f"{name}.acct")).read().split()[:2]
   105	        secs = max(0.0, time.time() - float(tfirst))
   106	        return f"final spend bound: {int(secs)}s at {rate} USD/h = {round(secs / 3600 * float(rate), 3)} USD"
   107	    except (OSError, ValueError):
   108	        return "final spend bound: no creation request recorded"
   109	
   110	
   111	def watchdog(name, hard_ts, done_file, run=_run, clock=time.time, sleep=time.sleep, here=HERE, settle=SETTLE):
   112	    """Ends only when DONE_FILE exists and successful listings show no pod named NAME for the settle time, counted from
   113	    DONE onwards (r11 Sol 3); after an ambiguous creation answer the settle time is at least AMBIGUOUS_SETTLE. After
   114	    DONE (the launcher reconciles first) any pod named NAME is an orphan and is deleted. From HARD_TS it also blocks
   115	    creation and deletes every pod named NAME, with no retry limit. On exit it prints the final spend bound."""
   116	    blocked = False
   117	    empty_since = None
   118	    while True:
   119	        if not blocked and clock() >= hard_ts:
   120	            open(os.path.join(here, f"{name}.blocked"), "w").write(str(int(clock())))
   121	            print(f"{time.strftime('%H:%M')} WATCHDOG: hard deadline; creation blocked; deleting every pod named {name}", flush=True)
   122	            blocked = True
   123	        done = os.path.exists(done_file)
   124	        need = max(settle, AMBIGUOUS_SETTLE) if os.path.exists(os.path.join(here, f"{name}.ambiguous")) else settle
   125	        if done or blocked:
   126	            pods = list_pods(run)
   127	            if pods is None:
   128	                empty_since = None
   129	            else:
   130	                ids = named(pods, name)
   131	                if ids:
   132	                    empty_since = None
   133	                    for i in ids:
   134	                        print(f"{time.strftime('%H:%M')} WATCHDOG: deleting {i}", flush=True)
   135	                        delete_verified(i, 120, run, clock, sleep)
   136	                elif done:
   137	                    empty_since = clock() if empty_since is None else empty_since
   138	                    if clock() - empty_since >= need:
   139	                        print(f"{time.strftime('%H:%M')} WATCHDOG: no pod named {name} for {need}s after the launcher was done; {_final_bound(here, name)}", flush=True)
   140	                        return 0
   141	                else:
   142	                    empty_since = None
   143	        sleep(30 if blocked else min(30, max(0.0, hard_ts - clock())) or 30)
   144	
   145	
   146	def main(argv) -> int:
   147	    cmd, a = argv[0], argv[1:]
   148	    if cmd == "reconcile":
   149	        return 0 if reconcile(a[0], a[1] if len(a) > 1 else "") else 1
   150	    if cmd == "delete":
   151	        return 0 if delete_verified(a[0], float(a[1])) else 1
   152	    if cmd == "watchdog":
   153	        return watchdog(a[0], float(a[1]), a[2])
   154	    if cmd == "may-create":
   155	        return 0 if may_create(a[0], float(a[1])) else 1
   156	    if cmd == "remaining":
   157	        print(max(0, int(float(a[0]) - time.time()))); return 0
   158	    print(__doc__); return 2
   159	
   160	
   161	if __name__ == "__main__":
   162	    sys.exit(main(sys.argv[1:]))

