   273	def check_reset_evidence(mac_dir, pod_dir, dbl_dir, want: dict) -> None:
   274	    """Run A: the reset driver's reproduction gate for headline F111 D2 passed on the Mac and bit-identically on this
   275	    machine (same numerical stack), and its doubling gate for fresh0 F111 D2+H3 passed; each directory verified by
   276	    `_verified_dir`, with the comparisons recomputed against the registered records (`want["src"]`)."""
   277	    src = want.get("src")
   278	    _verified_dir(mac_dir, "reproduction gate", REPRO_CELL, want["repro_inputs"], want["budget"], "mac", src)
   279	    pod = _verified_dir(pod_dir, "reproduction gate", REPRO_CELL, want["repro_inputs"], want["budget"], "pod", src)
   280	    if pod["gate"].get("identical") is not True or (pod["recomputed"] or {}).get("identical") is False or not same_environment(pod["environment"], environment()):
   281	        _refuse(f"pod evidence in {pod_dir}: not bit-identical on this machine's numerical stack")
   282	    _verified_dir(dbl_dir, "doubling gate", DBL_CELL, want["dbl_inputs"], want["budget"], "doubling", src)
