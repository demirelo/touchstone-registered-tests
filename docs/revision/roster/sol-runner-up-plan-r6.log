    assert G.main(base + ["--hours", "0.9"]) == 3                                          # 2.00 + 0.56 + 0.504 = 3.06 > 3.00
    assert G.main(base[:-2] + ["--now", "4000", "--hours", "0.6", "--stop-file", str(f)]) == 3   # the STOP file exists


