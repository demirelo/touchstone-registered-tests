   303	def main(argv=None) -> int:
   304	    """`guards.py admit ...`: the spend admission check a launcher runs before any paid step (including the reset gate);
   305	    exit 0 when the step may start, 3 when it may not."""
   306	    import argparse
   307	    ap = argparse.ArgumentParser(); ap.add_argument("cmd", choices=("admit",))
   308	    ap.add_argument("--cap-usd", dest="cap", type=float, required=True); ap.add_argument("--usd-per-hour", dest="rate", type=float, required=True)
   309	    ap.add_argument("--started-at", dest="started", type=float, required=True); ap.add_argument("--attempts", required=True)
   310	    ap.add_argument("--ledger", required=True); ap.add_argument("--run-tag", dest="tag", required=True); ap.add_argument("--hours", type=float, required=True)
   311	    ap.add_argument("--stop-file", dest="stop_file", default=None); ap.add_argument("--soft-deadline", dest="soft", type=float, default=None)
   312	    ap.add_argument("--now", type=float, default=None, help="for tests")
   313	    a = ap.parse_args(argv)
   314	    clock = (lambda: a.now) if a.now is not None else time.time
   315	    c = paid_cost_stop(a.cap, a.rate, a.started, a.attempts, a.ledger, a.tag, clock=clock, stop_file=a.stop_file, soft_deadline=a.soft)
   316	    ok = c.allow("next step", a.hours); print(json.dumps(c.report()))
   317	    return 0 if ok else 3
   318	
   319	
   320	if __name__ == "__main__":
   321	    sys.exit(main())

