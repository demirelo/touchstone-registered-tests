   242	def test_r15_record_price_waits_for_the_accounting_lock_and_keeps_the_maximum(tmp_path):
   243	    # r14 Sol 4: launcher and watchdog can record at the same time; a read-modify-write without a lock lowered 9.0 to 1.0
   244	    import fcntl, threading
   245	    (tmp_path / "n.acct").write_text("0 9.0")
   246	    f = Fake({"a": "n"}, prices={"a": 1.0})
   247	    lock = open(tmp_path / "n.lock", "w"); fcntl.flock(lock, fcntl.LOCK_EX)
   248	    done = threading.Event()
   249	    t = threading.Thread(target=lambda: (C.record_price("n", "a", f.run, here=str(tmp_path)), done.set()))
   250	    t.start()
   251	    assert not done.wait(0.5), "record_price did not wait for the accounting lock"
   252	    fcntl.flock(lock, fcntl.LOCK_UN); lock.close(); t.join(5)
   253	    assert done.is_set() and (tmp_path / "n.acct").read_text().split()[1] == "9.0"
