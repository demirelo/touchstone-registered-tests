   181	    except (OSError, IndexError, InvalidOperation):
   182	        return None, "no starting balance (NAME.bal0)"
   183	    try:
   184	        wdend, wdmono = (float(x) for x in open(os.path.join(here, f"{name}.wdend")).read().split()[:2])
   185	    except (OSError, ValueError):
