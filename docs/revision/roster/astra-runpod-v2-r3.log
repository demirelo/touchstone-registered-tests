    90	            if not extra:
    91	                return True
    92	            for i in extra:
    93	                if clock() >= end:
    94	                    break
    95	                delete_verified(i, end - clock(), run, clock, sleep)
    96	        sleep(min(15, max(0.0, end - clock())))
    97	    return False
