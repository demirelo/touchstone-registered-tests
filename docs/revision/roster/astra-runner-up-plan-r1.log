   164	def _gains(base, rule: str, fam: str, markets) -> dict:
   165	    res = {}
   166	    for m in markets:
   167	        rec = read(R.eval_path(base, R.cell_id(MAN.context(m), rule, fam, "profit")))
   168	        if rec is None:
   169	            raise ValueError(f"no evaluation of {m} {rule} {fam} in {base}")
   170	        res[m] = (rec["seeds"], rec["gain"])
   171	    return res
   172	
