   189	def main(argv=None) -> int:
   190	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   191	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True)
   192	    ap.add_argument("--draw", required=True); ap.add_argument("--instances", required=True); ap.add_argument("--cfgs", required=True); ap.add_argument("--addendum", required=True)
   193	    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   194	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "reference", "freeze", "evaluate", "doubling", "analysis", "inventory", "all"))
   195	    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--smoke", action="store_true")
   196	    a = ap.parse_args(argv); out = Path(a.out); F.check_out(out, a.src)
   197	    from sim.records import cfg_from_dict
   198	    root = json.loads(Path(a.draw).read_text())["hash"]; salt = json.loads(Path(a.instances).read_text())["salt_sha256"]
   199	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   200	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   201	    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   202	    write(out / "label.json", {"rule_label": LABEL, "rule": "C-thr", "cred": runner_up_cred(), "source": str(LOG.relative_to(ROOT)), "deviations": list(DEVIATIONS)})
   203	    markets = tuple(a.markets.split(","))
   204	    jobs = build_jobs(root, cfgs, runner_up_params(json.loads(Path(a.params).read_text())), salt, markets, a.smoke)
   205	    preflight(out, a.src, jobs, salt, container, a.smoke)
   206	    steps = ("inputs", "search", "reference", "freeze", "evaluate", "doubling", "analysis", "inventory") if a.stage == "all" else (a.stage,)
   207	    for st in steps:
   208	        if st == "inputs":
   209	            F.copy_inputs(a.src, out, bank_inputs(a.src, [j["context"] for j in jobs]))
   210	        elif st == "search":
   211	            run_searches(jobs, out, a.workers)
   212	        elif st == "reference":
   213	            run_references(jobs, out)
   214	        elif st == "freeze":
   215	            prefreeze(out, jobs)
   216	        elif st in ("evaluate", "doubling"):
   217	            accept(out, jobs, salt, container, a.src); run_stage(st, jobs, out, a.workers)
   218	        elif st == "analysis":
   219	            if not a.smoke:                                       # smoke evaluations use two seeds, not the registered 200
   220	                write(out / "analysis.json", analysis(out, a.src, markets))
   221	        else:
   222	            F.inventory(out)
   223	        print(json.dumps({"stage": st, "jobs": len(jobs)}), flush=True)
   224	    return 0
