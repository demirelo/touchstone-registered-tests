   144	def accept(out, jobs, salt_sha256: str, container: dict, src) -> None:
   145	    F.check_salt(out, salt_sha256, jobs); F.check_configs(jobs, container); check_no_registered_cstar(src, out)
   146	    have = read(Path(out) / "inputs.json") or {}
   147	    if bad := sorted(r for r, s in bank_inputs(src, [j["context"] for j in jobs]).items() if have.get(r) != s):
   148	        _refuse(f"inputs.json lacks or differs on {bad[:3]}")
   149	    for ctx in sorted({j["context"] for j in jobs}):
   150	        fr = read(R.path_of(out, f"freeze/{ctx}"))
   151	        if fr is None or not fr.get("followup"):
   152	            _refuse(f"{ctx}: no follow-up freeze")
   153	        for r, sha in fr["records"].items():
   154	            p = R.path_of(out, r)
   155	            if not p.exists() or sha_file(p) != sha:
   156	                _refuse(f"{ctx}: {r} differs from the freeze")
