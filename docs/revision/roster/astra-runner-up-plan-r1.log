   126	def prefreeze(out, jobs) -> None:
   127	    inp = read(Path(out) / "inputs.json") or {}
   128	    for ctx in sorted({j["context"] for j in jobs}):
   129	        ids = [j["id"] for j in jobs if j["context"] == ctx] + [f"reference/{ctx}/{LABEL}"]
   130	        recs = {r: s for r, s in inp.items() if ctx in r}
   131	        for i in ids:
   132	            p = R.path_of(out, i)
   133	            if not p.exists():
   134	                _refuse(f"{i}: missing before the freeze")
   135	            recs[i] = sha_file(p)
   136	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED, "records": recs}
   137	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   138	        if old is not None and old != body:
   139	            _refuse(f"{p} exists with other records")
   140	        if old is None:
   141	            write(p, body)
   142	
