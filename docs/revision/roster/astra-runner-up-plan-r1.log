                menus[k] = {**j, "id": f"reference/{k[0]}/{k[1]}", "priority": min(j.get("priority", 3), (m or {}).get("priority", 3))}
            else:
                m["priority"] = min(m["priority"], j.get("priority", 3))
    return list(menus.values())


