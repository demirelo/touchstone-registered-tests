   174	def analysis(out, src, markets=MARKETS, fams=FAMS, resamples: int = C.RESAMPLES) -> dict:
   175	    """d' = g(runner-up) - g(R3) and g(C*) - g(runner-up) per family, paired on the evaluation seeds; exploratory."""
   176	    res = {}
   177	    for fam in fams:
   178	        ru, r3, cs = _gains(out, LABEL, fam, markets), _gains(src, "F111", fam, markets), _gains(src, "C*", fam, markets)
   179	        for m in markets:
   180	            if not (ru[m][0] == r3[m][0] == cs[m][0]):
   181	                raise ValueError(f"{m} {fam}: evaluation seeds differ")
   182	        g = lambda d: {m: d[m][1] for m in markets}
   183	        a = C.pooled_paired(g(ru), g(r3), resamples); b = C.pooled_paired(g(cs), g(ru), resamples)
   184	        res[fam] = {"label": "exploratory, after the report; nominal paired percentile bootstrap; not registered",
   185	                    "runner_up_minus_r3": {**a, "category": C.q1_category(a["interval"])}, "cstar_minus_runner_up": b}
   186	    return res
   187	
