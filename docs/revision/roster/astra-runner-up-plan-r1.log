from __future__ import annotations

import hashlib
import json
from pathlib import Path

import yaml

from .config import MarketConfig, ProviderParams

import os

DEFAULT_PATH = Path(__file__).resolve().parents[1] / "experiments" / "locked.yaml"


def load_locked(path: str | Path | None = None) -> dict:
    """The locked file; TOUCHSTONE_LOCKED (read at call time) exists for synthetic tests only, and scripts/check_claim.py
    refuses to run with it set."""
    path = Path(path) if path is not None else Path(os.environ.get("TOUCHSTONE_LOCKED") or DEFAULT_PATH)
    with open(path) as f:
        return yaml.safe_load(f)


def seeds(locked: dict, namespace: str) -> list[int]:
    v = locked["seeds"].get(namespace)
    if v is None and namespace == "final_eval":
        from .registry import SEALED_DIR
        if (SEALED_DIR / "final_eval_seeds.json").exists():
            from .sealed import final_eval_seeds, verify_bundle
            verify_bundle(SEALED_DIR, locked)                 # the seeds count only from a bundle that matches the lock commitment
            return final_eval_seeds(SEALED_DIR)
    if v is None:
        raise ValueError(f"seed namespace {namespace!r} is not available (final-eval seeds are released with the sealed bundle)")
    return [int(x) for x in v]


def sha256_file(path: str | Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def settings_hash(locked: dict) -> str:
    """Hash of every experimental setting: the whole file except the version label and the blocks written at the lock
    (tuned, calibration, the coverage report hash and consequences, the comprehension fixture hash, and the sealed
    bundle hash by the lock tooling; identity_salt_sha256 by the separate session; h1.cost_cap_usd from the token
    pilot), so installing them at the lock keeps the pre-lock artifacts valid."""
    skip = ("version", "tuned", "calibration", "identity_salt_sha256", "sealed_bundle_sha256", "coverage_report_sha256",
            "comprehension_fixture_sha256", "coverage_consequences")
    bound = {k: v for k, v in locked.items() if k not in skip}
    if isinstance(bound.get("h1"), dict):
        bound["h1"] = {k: v for k, v in bound["h1"].items() if k not in ("cost_cap_usd", "prices")}   # measured figures, never results
    return hashlib.sha256(json.dumps(bound, sort_keys=True).encode()).hexdigest()


def market_config_from_locked(locked: dict) -> MarketConfig:
    mk = locked["market"]; pt = mk["providers"]
    providers = tuple(ProviderParams(q_max=float(q), a=float(a), b=float(b), k=int(k))
                      for q, a, b, k in zip(pt["q_max"], pt["a"], pt["b"], pt["k"]))
    return MarketConfig(N=int(mk["N"]), J=int(mk["J"]), T=int(mk["T"]), sigma=float(mk["sigma"]), e=float(mk["e"]),
                        v_min=float(mk["v_min"]), v_max=float(mk["v_max"]), providers=providers, alpha=0.0, budget=0.0)
"""The revision-program rule set (design draft 7, 3.5): the factorial cells, R4 (rho = 1 only), the credibility comparator C* with its pacing
variants, the tuned whole systems, and B2 at its registered parameters. Public constants (design 5.1): the horizon T from
the market configuration (public by spec 4.0) and the ban length L from the rule's describe record."""
from __future__ import annotations

import json
from pathlib import Path

from .mechanisms.credibility import Credibility
from .mechanisms.factorial import NAMES as FACTORIAL_NAMES, make_factorial
from .mechanisms.proposed import Proposed
from .mechanisms.second_score import SecondScore

ROOT = Path(__file__).resolve().parents[1]
MATCHED = ["F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111", "C*", "C*/S0"]
FIXED = MATCHED + ["C*/S2", "R4"]               # rules at the fixed pair, whatever their block (R4, C*/S2: rho = 1 only)
CORE = ["F000", "F111", "C*"]
TUNED = ["B3-t", "R3-t", "C*-t"]
COMPARATOR_PACING = {"C*": "S1", "C*/S0": "S0", "C*/S2": "S2", "C*-t": "S1"}


def registered_b2_params() -> dict:
    return dict(json.loads((ROOT / "experiments/tuned/tuned_B2.json").read_text())["best_params"])


def make_rule(name: str, tol: float = 0.16, L: int = 10, cred: dict | None = None, b2_params: dict | None = None):
    if name in FACTORIAL_NAMES:
        return make_factorial(name, tol, L)
    if name in COMPARATOR_PACING:
        if cred is None:
            raise ValueError(f"{name} needs the comparator's variant, K, and M")
        return Credibility(cred["variant"], int(cred["K"]), tol, L, COMPARATOR_PACING[name], cred.get("M"))
    if name == "B3-t":
        return SecondScore(tol, L)
    if name == "R3-t":
        return Proposed("A", "T1", tol, L)
    if name == "B2":
        from .tuning import rule_from_params
        return rule_from_params("B2", b2_params if b2_params is not None else registered_b2_params())
    raise ValueError(f"unknown rule {name!r}")


def public_constants(rule, cfg) -> dict:
    return {"T": int(cfg.T), "L": int(rule.describe()["parameters"]["ban_length"])}
"""The protocol-v2 manifest (design draft 7: 8.1, 8.1a, 8.2, 6.5, 6.6, 6.7), read from experiments/revision-v2-manifest.yaml:
the 287 search cells and 3 diagnostic cells, the 98 doubling checks, the 14 fixed-attack cross-evaluations, the execution
priority, the pre-stated cut order, per context the records a final freeze requires and the reference-bank rules, the
distinct-rule check (design 3.4), and the question-to-cell map (design 8.1a)."""
from __future__ import annotations

from functools import lru_cache
from pathlib import Path

import json
import math

import yaml

ROOT = Path(__file__).resolve().parents[1]
PATH = ROOT / "experiments/revision-v2-manifest.yaml"
Q1_Q4_RULES = ("F000", "F111", "C*")
FACTORIAL = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111")
MATCHED = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111", "C*", "C*/S0")
FIXED = MATCHED + ("C*/S2", "R4")                    # rules at the fixed pair (R4 and C*/S2 only in the rho = 1 repair block)
MENU_FAMILIES = ("D2+H3", "X7-SC")
SECONDARY = ("B3-t", "R3-t", "C*-t")
CORE = ("F000", "F111", "C*")
J, L_FIXED = 50, 10


@lru_cache(maxsize=1)
def doc() -> dict:
    return yaml.safe_load(PATH.read_text())


CUT_ORDER = tuple(doc()["cut_order"])


def context(market: str, rho: float = 0.2) -> str:
    return f"{market}@rho{rho:g}" if rho != 0.2 else f"{market}@rho0.2"


def _cell(block, market, rho, rule, family, objective, c=None, schedule=None) -> dict:
    ctx = context(market, rho)
    cid = f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")
    return {"id": cid, "block": block, "market": market, "context": ctx, "rho": rho, "rule": rule, "family": family, "objective": objective,
            "c": c, "schedule": schedule}


def _families(b: dict, market: str) -> list:
    if "families_by_market" in b:
        return b["families_by_market"]["headline" if market == "headline" else "fresh"]
    return b["families"]


def headline_a_tot(rho: float) -> int:
    """A_tot = floor(beta S_hat / (rho m)) = floor((beta / rho) n_FB) on the headline calibration (design 3.4)."""
    n_fb = float(json.loads((ROOT / "experiments/calibration.json").read_text())["n_FB"])
    return int(math.floor(0.05 / float(rho) * n_fb + 1e-12))


def _descriptor(rule: str, a_tot: int) -> tuple:
    """(selection, pacing schedule) of a rule at the fixed pair; rules with their own parameters are unique."""
    if rule in FACTORIAL:
        pacing = ("reserve", min(J * L_FIXED, a_tot)) if rule[3] == "1" else ("spread",)
        return (("factorial", rule[1], rule[2]), pacing)
    if rule == "R4":
        return (("factorial", "1", "1"), ("reserve", min(J * L_FIXED, a_tot // 2)))
    if rule in ("C*", "C*/S0", "C*/S2"):
        pacing = {"C*": ("reserve", min(J * L_FIXED, a_tot)), "C*/S0": ("spread",), "C*/S2": ("reserve", min(J * L_FIXED, a_tot // 2))}[rule]
        return (("credibility",), pacing)
    return (("own", rule), ("own", rule))



