    91	class CostStop:
    92	    """Checked between stages: a stage starts only if the billed time so far plus its estimate stays within the cap.
    93	    A running stage is never interrupted (the author: do not kill jobs); the run stops and reports instead."""
    94	
    95	    def __init__(self, cap_usd: float, usd_per_hour: float, started: float, clock=time.time, prior_usd: float = 0.0,
    96	                 stop_file=None, soft_deadline: float | None = None):
    97	        self.cap, self.rate, self.started, self.clock, self.stopped, self.log = float(cap_usd), float(usd_per_hour), float(started), clock, None, []
    98	        self.prior = float(prior_usd)                                    # earlier attempts and launches of the same run count toward the cap
    99	        self.stop_file, self.soft = (Path(stop_file) if stop_file else None), soft_deadline     # the launcher's STOP file and soft deadline
   100	
   101	    def allow(self, stage: str, est_hours: float) -> bool:
   102	        spent = self.prior + (self.clock() - self.started) / 3600 * self.rate; ok = spent + est_hours * self.rate <= self.cap + 1e-9
   103	        if (self.stop_file is not None and self.stop_file.exists()) or (self.soft is not None and self.clock() >= self.soft):
   104	            ok = False
   105	        self.log.append({"stage": stage, "spent_usd": round(spent, 4), "next_usd": round(est_hours * self.rate, 4), "allowed": ok})
   106	        if not ok and self.stopped is None:
   107	            self.stopped = stage
   108	        return ok
   109	
   110	    def report(self) -> dict:
   111	        return {"cap_usd": self.cap, "usd_per_hour": self.rate, "prior_usd": self.prior, "stopped_before": self.stopped, "log": self.log,
   112	                "note": "an admission limit checked before each stage or round; a running stage finishes, so billing can exceed the cap by that stage"}
   113	
   114	
   115	def attempts_spend(path, usd_per_hour: float, started: float | None = None, now: float | None = None) -> dict:
   116	    """The launcher's attempts file (results/pods/reset_pod.sh: one line per event, `<pod> <epoch> start` or
   117	    `<pod> <epoch> deleted`), validated: finite epochs in nondecreasing order, every deletion after its pod's start, and
   118	    exactly one open attempt (the current pod). A closed attempt is billed at `usd_per_hour` (the price ceiling); the open
   119	    one is the caller's, counted from `started`, which must lie between the open start and `now`."""
   120	    p = Path(path) if path else None
   121	    if p is None or not p.exists():
   122	        _refuse(f"no launcher attempts file at {path}")
   123	    starts, closed, last = {}, 0.0, -math.inf
   124	    for line in p.read_text().splitlines():
   125	        if not line.strip():
   126	            continue
   127	        parts = line.split()
   128	        if len(parts) != 3 or parts[2] not in ("start", "deleted"):
   129	            _refuse(f"unreadable line in the attempts file {p}: {line!r}")
   130	        try:
   131	            t = float(parts[1])
   132	        except ValueError:
   133	            t = math.nan
   134	        if not math.isfinite(t) or t < last:
   135	            _refuse(f"a nonfinite or out-of-order epoch in the attempts file {p}: {line!r}")
   136	        last = t; pod, ev = parts[0], parts[2]
   137	        if ev == "start":
   138	            if pod in starts:
   139	                _refuse(f"two starts of {pod} in the attempts file {p}")
   140	            starts[pod] = t
   141	        else:
   142	            if pod not in starts:
   143	                _refuse(f"a deletion of {pod} without an earlier start in the attempts file {p}")
   144	            closed += (t - starts.pop(pod)) / 3600 * usd_per_hour
   145	    if len(starts) != 1:
   146	        _refuse(f"the attempts file {p} must have exactly one open attempt, the current pod; it has {sorted(starts)}")
   147	    (pod, t_open), = starts.items()
   148	    if started is not None:
   149	        now = time.time() if now is None else now
   150	        if not (t_open <= float(started) <= now):
   151	            _refuse(f"the allocation time {started} is not between the open attempt's start {t_open} and now {now}")
   152	    return {"closed_usd": closed, "open": [pod], "open_start": t_open}
   153	
