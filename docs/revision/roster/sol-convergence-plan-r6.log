   237	def _verified_dir(d, stage: str, cell: str, inputs: dict, budget, site: str, src=None) -> dict:
   238	    """A reset-driver evidence directory: the gate record names this stage and cell and passed; the inventory lists every
   239	    required record and every listed hash equals its file; the reset driver is the current one; the inputs equal those
   240	    recomputed from the original records; the search record has the full budget; and, with `src`, the comparison is
   241	    recomputed against the registered records and passes."""
   242	    d = Path(d); g, inv, inp = read(d / "gate.json"), read(d / "inventory.json"), read(d / "inputs.json")
   243	    srch = read(F.R.path_of(d, cell)); drv = sha_file(HERE.parent / "followup" / "reset_followup_v2.py")
   244	    recs = (inv or {}).get("records") or {}; env = (inv or {}).get("environment") or {}
   245	    problems = []
   246	    if g is None or g.get("stage") != stage or g.get("cell") != cell or g.get("pass") is not True:
   247	        problems.append("gate record missing, unrelated, or failed")
   248	    if missing := [r for r in _required_records(d, stage, cell) if r not in recs or not (d / r).exists()]:
   249	        problems.append(f"required records missing or unlisted: {missing}")
   250	    if bad := [r for r, h in recs.items() if not (d / r).exists() or sha_file(d / r) != h]:
   251	        problems.append(f"inventory hashes differ from the files: {bad[:3]}")
   252	    if env.get("driver_sha256") != drv:
   253	        problems.append("made by another reset driver")
   254	    if inp != inputs:
   255	        problems.append("inputs differ from the current original records")
   256	    if srch is None or list((srch.get("provenance") or {}).get("budget") or []) != list(budget):
   257	        problems.append("not the registered full budget")
   258	    for r, h in (inp or {}).items():                              # every copied input present with its recorded hash
   259	        q = F.R.path_of(d, r)
   260	        if not q.exists() or sha_file(q) != h:
   261	            problems.append(f"copied input {r} missing or changed"); break
   262	    problems += _supporting_problems(d, stage, cell, inp or {}, srch, src)
   263	    rep = None
   264	    if not problems and src is not None:
   265	        rep = F.compare(src, d) if stage == "reproduction gate" else F.compare_doubling(src, d, cell)
   266	        if not rep.get("pass"):
   267	            problems.append(f"the recomputed comparison fails: {rep.get('problems')}")
   268	    if problems:
   269	        _refuse(f"{site} evidence in {d}: {problems}")
   270	    return {"gate": g, "environment": env, "recomputed": rep}
