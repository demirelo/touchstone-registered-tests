    bad = {"empty": [], "reverse order": ["p1 1000 start", "p1 4600 deleted", "p2 4000 start"], "two open": ["p1 1000 start", "p2 2000 start"],
           "nan time": ["p1 nan start"], "none open": ["p1 1000 start", "p1 2000 deleted"]}
