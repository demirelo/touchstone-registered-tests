def attempts_spend(path, usd_per_hour: float, started: float | None = None, now: float | None = None) -> dict:
    """The launcher's attempts file (results/pods/reset_pod.sh: one line per event, `<pod> <epoch> start` or
    `<pod> <epoch> deleted`), validated: finite epochs in nondecreasing order, every deletion after its pod's start, and
    exactly one open attempt (the current pod). A closed attempt is billed at `usd_per_hour` (the price ceiling); the open
    one is the caller's, counted from `started`, which must lie between the open start and `now`."""
    p = Path(path) if path else None
    if p is None or not p.exists():
        _refuse(f"no launcher attempts file at {path}")
    starts, closed, last = {}, 0.0, -math.inf
    for line in p.read_text().splitlines():
        if not line.strip():
            continue
        parts = line.split()
        if len(parts) != 3 or parts[2] not in ("start", "deleted"):
            _refuse(f"unreadable line in the attempts file {p}: {line!r}")
        try:
            t = float(parts[1])
        except ValueError:
            t = math.nan
        if not math.isfinite(t) or t < last:
            _refuse(f"a nonfinite or out-of-order epoch in the attempts file {p}: {line!r}")
        last = t; pod, ev = parts[0], parts[2]
        if ev == "start":
            if pod in starts:
                _refuse(f"two starts of {pod} in the attempts file {p}")
            starts[pod] = t
        else:
            if pod not in starts:
                _refuse(f"a deletion of {pod} without an earlier start in the attempts file {p}")
            closed += (t - starts.pop(pod)) / 3600 * usd_per_hour
    if len(starts) != 1:
        _refuse(f"the attempts file {p} must have exactly one open attempt, the current pod; it has {sorted(starts)}")
    (pod, t_open), = starts.items()
    if started is not None:
        now = time.time() if now is None else now
        if not (t_open <= float(started) <= now):
            _refuse(f"the allocation time {started} is not between the open attempt's start {t_open} and now {now}")
    return {"closed_usd": closed, "open": [pod], "open_start": t_open}


def ledger_spend(ledger, tag_prefix: str) -> float:
    """Spend recorded in the budget ledger for earlier launches of this run (the launcher truncates its attempts file)."""
    d = read(ledger) if ledger else None
    if d is None:
        _refuse(f"no budget ledger at {ledger}")
    return float(sum(r["usd"] for r in d.get("spent", []) if str(r.get("tag", "")).startswith(tag_prefix)))


def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, attempts, ledger=None, tag: str | None = None, clock=time.time,
                   stop_file=None, soft_deadline=None) -> CostStop:
    """A paid run must state the pod allocation time, a positive rate (the price ceiling), the launcher's attempts file,
    and the ledger with the run's tag: closed attempts of this launch and recorded spend of earlier launches count toward
    the cap (no default of zero)."""
    if started is None:
        _refuse("a paid run needs --started-at (the pod allocation time)")
    if not usd_per_hour > 0 or not cap_usd > 0:
        _refuse("a paid run needs a positive rate and cap")
    if attempts is None:
        _refuse("a paid run needs --attempts (the launcher's attempts file)")
    if not tag:
        _refuse("a paid run needs --run-tag and --ledger (spend of earlier launches)")
    prior = attempts_spend(attempts, usd_per_hour, started, clock())["closed_usd"] + ledger_spend(ledger, tag)
    return CostStop(cap_usd, usd_per_hour, started, clock, prior, stop_file, soft_deadline)


ENV_KEYS = ("cpu", "machine", "platform", "python", "numpy", "scipy", "cma", "blas")


def same_environment(a: dict, b: dict) -> bool:
    return all(a.get(k) == b.get(k) for k in ENV_KEYS)


def check_gate_evidence(paths, want: dict) -> None:
    """Run B: for every gate cell, a passing gate record from the Mac and one from this machine (same numerical stack),
    each with exactly the expected binding (full-budget provenance, gate settings, input hashes, driver, dependencies)."""
    recs = [read(p) for p in paths]; here = environment()
    for cell, b in want.items():
        for site in ("mac", "pod"):
            ok = [r for r in recs if r and r.get("stage") == "convergence gate" and r.get("cell") == cell and r.get("site") == site
                  and r.get("pass") is True and r.get("binding") == b and (site == "mac" or same_environment(r.get("environment") or {}, here))]
            if not ok:
                _refuse(f"no valid {site} gate evidence for {cell}")


REPRO_CELL, DBL_CELL = "headline@rho0.2|F111|D2|profit", "fresh0@rho0.2|F111|D2+H3|profit"


def _required_records(d: Path, stage: str, cell: str) -> list:
    if stage == "reproduction gate":
        return ["gate.json", "inputs.json", str(F.R.path_of(d, cell).relative_to(d)), str(F.R.eval_path(d, cell).relative_to(d)),
                f"freeze/{cell.split('|')[0]}.json"]
    return ["gate.json", "inputs.json", str(F.R.path_of(d, cell).relative_to(d)), f"doubling/{F.R._safe(cell)}.json"]


def _deps_ok(d: Path, up: dict, want_ids: set) -> bool:
    return set(up) == set(want_ids) and all(F.R.path_of(d, u).exists() and sha_file(F.R.path_of(d, u)) == h for u, h in up.items())


def _supporting_problems(d: Path, stage: str, cell: str, inp: dict, srch, src) -> list:
    """The supporting records' stages, provenance, dependency sets, dependency hashes, and the freeze contents."""
    out, ctx = [], cell.split("|")[0]
    reg = read(F.R.path_of(src, cell)) if src is not None else None
    if reg is not None and srch is not None and any((srch.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV):
        out.append("search provenance differs from the registered record")
    if stage == "reproduction gate":
        fr, ev = read(d / "freeze" / f"{ctx}.json"), read(F.R.eval_path(d, cell))
        want = {r: h for r, h in inp.items() if r.startswith(ctx) or f"/{ctx}/" in r}
        want[cell] = sha_file(F.R.path_of(d, cell)) if F.R.path_of(d, cell).exists() else None
        if fr is None or fr.get("stage") != "freeze" or fr.get("followup") is not True or fr.get("cuts") != F.CUTS or fr.get("h4_excluded") != F.H4_EXCLUDED \
                or not fr.get("records") or fr["records"] != want or not _deps_ok(d, fr["records"], set(want)):
            out.append("freeze empty, incomplete, or stale")
        if ev is None or ev.get("stage") != "evaluate" or ev.get("provenance") != (srch or {}).get("provenance") \
                or not _deps_ok(d, ev.get("upstream") or {}, {cell, f"reference/{ctx}/{cell.split('|')[1]}", f"freeze/{ctx}"}):
            out.append("evaluation record: stage, provenance, or dependencies wrong")
    else:
        db = read(d / "doubling" / (F.R._safe(cell) + ".json"))
        if db is None or db.get("stage") != "doubling" or db.get("id") != cell or not _deps_ok(d, db.get("upstream") or {}, set(inp)) \
                or (reg is not None and any((db.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV)):
            out.append("doubling record: stage, provenance, or dependencies wrong")
    return out


def _verified_dir(d, stage: str, cell: str, inputs: dict, budget, site: str, src=None) -> dict:
    """A reset-driver evidence directory: the gate record names this stage and cell and passed; the inventory lists every
    required record and every listed hash equals its file; the reset driver is the current one; the inputs equal those
    recomputed from the original records; the search record has the full budget; and, with `src`, the comparison is
    recomputed against the registered records and passes."""
    d = Path(d); g, inv, inp = read(d / "gate.json"), read(d / "inventory.json"), read(d / "inputs.json")
    srch = read(F.R.path_of(d, cell)); drv = sha_file(HERE.parent / "followup" / "reset_followup_v2.py")
    recs = (inv or {}).get("records") or {}; env = (inv or {}).get("environment") or {}
    problems = []
    if g is None or g.get("stage") != stage or g.get("cell") != cell or g.get("pass") is not True:
        problems.append("gate record missing, unrelated, or failed")
    if missing := [r for r in _required_records(d, stage, cell) if r not in recs or not (d / r).exists()]:
        problems.append(f"required records missing or unlisted: {missing}")
    if bad := [r for r, h in recs.items() if not (d / r).exists() or sha_file(d / r) != h]:
        problems.append(f"inventory hashes differ from the files: {bad[:3]}")
    if env.get("driver_sha256") != drv:
        problems.append("made by another reset driver")
    if inp != inputs:
        problems.append("inputs differ from the current original records")
    if srch is None or list((srch.get("provenance") or {}).get("budget") or []) != list(budget):
        problems.append("not the registered full budget")
    for r, h in (inp or {}).items():                              # every copied input present with its recorded hash
        q = F.R.path_of(d, r)
        if not q.exists() or sha_file(q) != h:
            problems.append(f"copied input {r} missing or changed"); break
    problems += _supporting_problems(d, stage, cell, inp or {}, srch, src)
    rep = None
    if not problems and src is not None:
        rep = F.compare(src, d) if stage == "reproduction gate" else F.compare_doubling(src, d, cell)
        if not rep.get("pass"):
            problems.append(f"the recomputed comparison fails: {rep.get('problems')}")
    if problems:
        _refuse(f"{site} evidence in {d}: {problems}")
    return {"gate": g, "environment": env, "recomputed": rep}


def check_reset_evidence(mac_dir, pod_dir, dbl_dir, want: dict) -> None:
    """Run A: the reset driver's reproduction gate for headline F111 D2 passed on the Mac and bit-identically on this
    machine (same numerical stack), and its doubling gate for fresh0 F111 D2+H3 passed; each directory verified by
    `_verified_dir`, with the comparisons recomputed against the registered records (`want["src"]`)."""
    src = want.get("src")
    _verified_dir(mac_dir, "reproduction gate", REPRO_CELL, want["repro_inputs"], want["budget"], "mac", src)
    pod = _verified_dir(pod_dir, "reproduction gate", REPRO_CELL, want["repro_inputs"], want["budget"], "pod", src)
    if pod["gate"].get("identical") is not True or (pod["recomputed"] or {}).get("identical") is False or not same_environment(pod["environment"], environment()):
        _refuse(f"pod evidence in {pod_dir}: not bit-identical on this machine's numerical stack")
    _verified_dir(dbl_dir, "doubling gate", DBL_CELL, want["dbl_inputs"], want["budget"], "doubling", src)


def check_evidence(paths) -> None:
    for p in paths:
        rec = read(p)
        if rec is None or rec.get("pass") is not True:
            _refuse(f"reproduction evidence {p} is missing or did not pass")


def sha_json(obj) -> str:
    import hashlib
    return hashlib.sha256(json.dumps(obj, sort_keys=True, default=float).encode()).hexdigest()


def reservation_input(cap_usd: float) -> float:
    """The estimate to pass to `budget_followup.py reserve` so that the grant (estimate x HEADROOM) equals the stop cap."""
    from scripts import budget_v2 as BV
    return round(float(cap_usd) / BV.HEADROOM, 6)
"""Run B (docs/revision/followup2/convergence-plan.md, draft 3): the 14 search-flagged profit cells of the report and the
X7-SC cells with a nesting shortfall of at least 0.005 (posthoc `nesting`) searched further, one round of R restarts at a
time, until a round's check passes or the cap is reached; nesting cells run at least two rounds and, from round 2, also
start from the doubled D2+H3 winner embedded in X7-SC.

Round k continues the search from the best result so far with as many new restarts as registered (revision_v2
`continue_search`, restart seeds after every earlier round's), then reselects the reference from the frozen menu plus
the new candidates as the registered doubling stage does. A round passes when both changes against the previous round,
attacker and reference normalised profit on the training seeds, are below the registered threshold 0.005. Round 1
recomputes the registered doubling check (its changes are compared with the report's). The cap is three rounds, four
times the registered restarts in all. The final winner (best training value over all rounds) is evaluated on the
evaluation seeds against the unchanged frozen reference. The frozen estimates stay primary; these are a sensitivity.
The 7 flagged coalition cells are not in this run (plan, section 3)."""
from __future__ import annotations

import argparse
import json
import sys
from dataclasses import replace
from pathlib import Path

import numpy as np

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(ROOT / "scripts")); sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(HERE.parent / "followup")); sys.path.insert(0, str(HERE))

import common as C  # noqa: E402
import guards as G  # noqa: E402
import reset_followup_v2 as F  # noqa: E402
import revision_v2 as R  # noqa: E402
from sim.records_v2 import read, sha_file, write  # noqa: E402

THRESHOLD = R.THRESHOLD                            # 0.005, the registered doubling threshold (design 6.5)
MAX_ROUNDS = 3
CUTS, H4_EXCLUDED = F.CUTS, F.H4_EXCLUDED
FRESH = tuple(f"fresh{i}" for i in range(6))


def _refuse(msg: str):
    raise SystemExit(f"convergence follow-up refused: {msg}")


def flagged(report: dict) -> dict:
    d = report["doubling"]; f = [k for k, v in d.items() if v.get("incomplete")]
    return {"profit": [k for k in f if d[k].get("kind") == "profit"], "coalition": [k for k in f if d[k].get("kind") != "profit"]}


def cells_for(report: dict, nesting: dict) -> dict:
    """The run's cells: the flagged profit cells, then every X7-SC cell whose nesting shortfall (posthoc `nesting`) is at
    least the doubling threshold (draft 3, Fable 5.2 r2 new problem 2)."""
    base = sorted(flagged(report)["profit"])
    nest = sorted(f"{k}|X7-SC|profit" for k, v in nesting["cells"].items() if v["shortfall"] >= THRESHOLD - 1e-12)
    return {"cells": base + [c for c in nest if c not in base], "nesting": nest}


def round_incumbents(k: int, prev_knobs: dict, embedded: dict | None) -> dict:
    """Round 1 keeps the registered doubling's incumbent; from round 2 a nesting cell also gets the doubled D2+H3 winner
    embedded in X7-SC (a deviation, so that the nesting gap can close)."""
    inc = {"previous_best": dict(prev_knobs)}
    if k >= 2 and embedded is not None:
        inc["embedded_doubled_d2h3"] = dict(embedded)
    return inc


def shortfall_report(nesting: dict, final_gains: dict) -> dict:
    res = {}
    for rid, g in final_gains.items():
        c = nesting["cells"][rid.rsplit("|", 2)[0]]
        res[rid] = {"before": c["shortfall"], "after": c["best_d2h3"] - float(np.mean(g)), "best_d2h3": c["best_d2h3"]}
    return res


def round_seed(k: int, restarts: int) -> int:
    """`continue_search` seed of round k; round 1 is the registered doubling's seed 1."""
    return 1 + (k - 1) * restarts


def cma_seeds(k: int, restarts: int) -> set:
    s = round_seed(k, restarts) + restarts                     # continue_search passes seed + restarts to cma_search
    return set(range(s + 1, s + 1 + restarts))                 # cma_search uses seed + 1 + r


def _passes(r: dict) -> bool:
    return r["attack_change"] < THRESHOLD - 1e-12 and r["reference_change"] < THRESHOLD - 1e-12


def passed_round(rounds: list, min_rounds: int = 1) -> int | None:
    """The first eligible passing round (from `min_rounds`)."""
    return next((r["round"] for r in rounds if r["round"] >= min_rounds and _passes(r)), None)


def final_status(rounds: list, outcome: str, min_rounds: int = 1) -> tuple:
    """The reported status and pass round agree with the final outcome."""
    status = {"passed": "passed", "round cap": "not passed at the cap", "cost cap": "stopped at the cost cap",
              "round-1 mismatch": "stopped: round 1 differs from the registered doubling"}[outcome]
    return status, (passed_round(rounds, min_rounds) if outcome == "passed" else None)


def place_heldout(status: str, held: dict) -> dict:
    """A cost-stopped cell keeps its frozen estimate as primary; its partial result goes to a separate field."""
    return {"partial": held} if status == "stopped at the cost cap" else {"heldout": held}


def check_rounds(max_rounds: int, gate: bool, nesting: list) -> None:
    if not gate and nesting and max_rounds < 2:
        _refuse("--max-rounds must be at least 2 for a continuation run with nesting cells")


def deps_for(report, posthoc, registered_doubling, embedded) -> dict:
    """What a result depends on besides its inputs and driver: helpers, plan, report, posthoc, the registered doubling
    record of the cell, and the embedded doubled D2+H3 incumbent (nesting cells)."""
    h = lambda p: sha_file(p) if p is not None and Path(p).exists() else None
    return {"reset_followup_v2.py": h(HERE.parent / "followup" / "reset_followup_v2.py"), "guards.py": h(HERE / "guards.py"), "common.py": h(HERE / "common.py"),
            "plan": h(HERE / "convergence-plan.md"), "report": h(report), "posthoc": h(posthoc), "registered_doubling": h(registered_doubling),
            "embedded_incumbent": G.sha_json(embedded) if embedded is not None else None}


def round1_agrees(r1: dict, registered: dict, tol: float = 1e-9) -> bool:
    return all(abs(r1[k] - registered[k]) <= tol for k in ("attack_change", "reference_change"))


def job_for(rid: str, root: str, cfgs: dict, params: dict, salt: str, smoke: bool) -> dict:
    ctx, rule, fam, _ = rid.split("|"); label = ctx.split("@")[0]
    mkt = R.market(label, root, 0.2, smoke=smoke, cfg=cfgs.get(label), salt_sha256=salt)
    return R.job(mkt, rule, fam, "profit", smoke=smoke, params=params)


def cell_inputs(src, job: dict) -> dict:
    need = F.inputs(src, [job]); p = R.path_of(src, job["id"])
    fr = read(R.path_of(src, f"freeze/{job['context']}"))
    if job["id"] not in fr["records"] or fr["records"][job["id"]] != sha_file(p):
        _refuse(f"{job['id']}: its search record differs from the original freeze")
    need[job["id"]] = fr["records"][job["id"]]
    for u, s in (read(p).get("upstream") or {}).items():
        if need.setdefault(u, s) != s:
            _refuse(f"{u}: two original records hold different hashes")
    return need


CLAIM = ("a cell that passes 'passed the registered incremental check within three rounds' (a capped search extension "
         "of R restarts per round); this is not convergence, not optimality, and not a bound on the remaining search error")
DEVIATIONS = ("continued searches of the 14 flagged profit cells and of the X7-SC cells with a nesting shortfall of at least 0.005, "
              "beyond the registered doubling, up to three rounds of R restarts",
              "from round 2 a nesting cell's X7-SC search also starts from the doubled D2+H3 winner embedded in X7-SC, and such a cell runs at least two rounds",
              "the final winner is evaluated against the unchanged frozen reference; reselected references are diagnostics only",
              "unflagged cells, frozen banks and X7-SC's original D2+H3 incumbents are unchanged; the 7 flagged coalition cells and "
              "the unchecked fresh factorial cells are not in this run", "exploratory sensitivity after the report; the frozen estimates stay primary")
KNOB_TOL, VAL_TOL = 1e-9, 1e-9


def compare_round1(registered: dict, r1: dict) -> dict:
    """Round 1 against the registered doubling record: exact on the seeds and discrete held-out knobs; 1e-9 on the
    continuous knobs, both changes and the held-out gains; every value finite."""
    problems = []
    ha, hb = registered["heldout"], r1["heldout"]
    if not G.finite(ha["gain"], hb["gain"], hb["knobs"], [r1["attack_change"], r1["reference_change"]]):
        problems.append("nonfinite value")
    if ha["seeds"] != hb["seeds"]:
        problems.append("seeds differ")
    ka, kb = ha["knobs"], hb["knobs"]; disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
    if set(ka) != set(kb) or any(ka[k] != kb[k] for k in disc):
        problems.append("discrete knob differs")
    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
    chg = max(abs(registered[k] - r1[k]) for k in ("attack_change", "reference_change"))
    gd = max((abs(x - y) for x, y in zip(ha["gain"], hb["gain"])), default=0.0) if len(ha["gain"]) == len(hb["gain"]) else float("inf")
    if not (rel <= KNOB_TOL and chg <= VAL_TOL and gd <= VAL_TOL):
        problems.append(f"tolerance exceeded (knobs {rel:.3g}, changes {chg:.3g}, gains {gd:.3g})")
    return {"pass": not problems, "max_knob_rel": rel, "max_change_abs": chg, "max_gain_abs": gd, "problems": problems}



