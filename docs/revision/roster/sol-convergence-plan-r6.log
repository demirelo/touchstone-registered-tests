   155	def ledger_spend(ledger, tag_prefix: str) -> float:
   156	    """Spend recorded in the budget ledger for earlier launches of this run (the launcher truncates its attempts file)."""
   157	    d = read(ledger) if ledger else None
   158	    if d is None:
   159	        _refuse(f"no budget ledger at {ledger}")
   160	    return float(sum(r["usd"] for r in d.get("spent", []) if str(r.get("tag", "")).startswith(tag_prefix)))
