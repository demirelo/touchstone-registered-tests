   324	
   325	def memory_limit() -> int:
   326	    """The cgroup memory limit (v2 or v1), else the physical memory."""
   327	    import os
   328	    for f in ("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory/memory.limit_in_bytes"):
   329	        try:
   330	            v = Path(f).read_text().strip()
   331	            if v.isdigit() and int(v) < 2 ** 60:
   332	                return int(v)
   333	        except OSError:
   334	            pass
   335	    return os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
