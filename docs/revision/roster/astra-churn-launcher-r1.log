   492	                    raise SystemExit("churn arm refused: diagnostics needs memory evidence (an evaluate or doubling preflight "
   493	                                     "of this output on this memory limit)")
   494	                w_mem = min(w_mem, sv)
   495	            cap(STAGE_SECONDS["diagnostics"] * slow * _waves(len(jobs), w_mem))
   496	            write(Path(out) / "diagnostics.json", diagnostics(out, jobs, w_mem))
   497	        else:
   498	            inventory(out, p)
   499	        print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs), "workers_memory": w_mem}), flush=True)
