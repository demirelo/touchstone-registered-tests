+        c[m]["D2"]["C*"] = c[m]["D2"]["F111"] + 0.01 * (k - 2)
+        c[m]["D2+H3"]["F000"] = c[m]["D2"]["F000"] + 0.3
+        c[m]["D2+H3"]["C*"] = c[m]["D2"]["C*"] + 0.05
+    return c
