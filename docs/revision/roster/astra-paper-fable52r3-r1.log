+    assert r["Cstar_minus_R3"]["D2+H3"]["estimate"] == pytest.approx(0.005 + 0.05 - 0.01)
+    assert r["Cstar_minus_R3"]["D2"]["positive"] == 3
+
+
+def test_nesting_lists_cells_where_d2h3_falls_below_d2():
