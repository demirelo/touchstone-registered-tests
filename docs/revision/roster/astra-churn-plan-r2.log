   139	def _expected_reference_upstream(rid: str) -> set:
   140	    """The registered menu and cuts-3 bank of a reference (revision_v2.expected_upstream)."""
   141	    return R.expected_upstream(rid, [], CUTS, H4_EXCLUDED)
