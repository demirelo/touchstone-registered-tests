   264	def inventory(out, p: float) -> dict:
   265	    inv = F.inventory(out)
   266	    inv["environment"]["churn_driver_sha256"] = sha_file(Path(__file__)); inv["churn"] = float(p); inv["deviations"] = list(DEVIATIONS)
   267	    write(Path(out) / "inventory.json", inv)
   268	    return inv
