   900	        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
   901	        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
   902	        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
   903	        continue_search(obj, fam, st, orig)
   904	        sel_old = rec["selected"]
