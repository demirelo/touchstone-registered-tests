   725	def check_complete(ctx: str, catalog: list[dict], out: Path, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
   726	    problems = []
   727	    for r in MAN.required(manifest_ctx(ctx), cuts, h4_excluded):
