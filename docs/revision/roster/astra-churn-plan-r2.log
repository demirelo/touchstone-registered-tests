   306	def stage_search(job: dict, out: Path) -> dict:
   307	    T, L = constants(job); fam = family_for(job["family"], T, L, job.get("h4")); cache = SeedCache(); st = settings(job); cell = train_cell(job)
   308	    upstream = {}
   309	    if job["objective"] == "W0":
   310	        extra, upstream = _welfare_extra(job, out, T)
   311	        obj = WelfareObjective(cell, fam, cache)
   312	        res = cma_search(obj, fam, st, 1, incumbents={"honest_point": fam.honest_point(), **extra})
   313	        controls(obj, fam)
   314	        best = max(obj.archive.values(), key=lambda e: e.f)
   315	        return _welfare_record(obj, res, dict(best.knobs), upstream, T, L)
   316	    tw = twin_search(cell, fam, cache, st, seed=0)
   317	    extra = {}
   318	    if job["family"] == "X7-SC":
   319	        rid = _menu_id(job["context"], job["rule"], "D2+H3"); rec = read(path_of(out, rid))
   320	        if rec is None:
   321	            raise SystemExit(f"{job['id']}: needs {rid} first")
   322	        extra["embedded_h3"] = embed_h3(rec["attack"]["best_knobs"], T); upstream[rid] = sha_file(path_of(out, rid))
   323	    at = search_family(cell, fam, cache, st, tw, extra)
   324	    obj = Objective(cell, fam, cache); obj.archive.update(at.archive)
   325	    ctrl = controls(obj, fam)
   326	    best_ctrl = max(ctrl, key=lambda kf: kf[1]) if ctrl else None
   327	    at.archive.update(obj.archive)
   328	    rec = {"twin": search_to_json(tw), "attack": search_to_json(at), "controls": [{"knobs": k, "f": f} for k, f in ctrl],
   329	           "upstream": upstream, "T": T, "L": L, "runs": cache.runs}
   330	    if best_ctrl is not None and best_ctrl[1] > at.best_f:
   331	        rec["attack"]["best_knobs"], rec["attack"]["best_f"], rec["attack"]["best_source"] = dict(best_ctrl[0]), float(best_ctrl[1]), "control"
   332	    return rec
