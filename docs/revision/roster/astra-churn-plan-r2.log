# ---- context ---------------------------------------------------------------------------------------------------------

def git_commit() -> str:
    try:
        return subprocess.run(["git", "rev-parse", "HEAD"], cwd=ROOT, capture_output=True, text=True, check=True).stdout.strip()
    except Exception:
        return "unknown"


def _sha(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def _sha_json(obj) -> str:
    return _sha(json.dumps(obj, sort_keys=True, default=float).encode())


def install_salt(root: str, out: Path) -> Path:
    """Write the fresh root's identity salt under --out and point the harness at it before any episode."""
    p = Path(out) / "salt.hex"; p.parent.mkdir(parents=True, exist_ok=True); p.write_text(INST.identity_salt_hex(root))
    os.environ[SALT_ENV] = str(p)
    return p


@lru_cache(maxsize=4)
def _fresh(root: str) -> tuple:
    return tuple(m["cfg"] for m in INST.markets(root, 6))


@lru_cache(maxsize=32)
def _market_cfg(label: str, root: str, rho: float):
    if label == "headline":
        return cell_config(market_config_from_locked(load_locked()), load_calibration(ROOT / "experiments/calibration.json"), rho=rho, beta=0.05)
    if label.startswith("dev"):
        base = INST.dev_markets()[int(label[3:])]["cfg"]
    elif label.startswith("fresh"):
        base = _fresh(root)[int(label[5:])]
    else:
        raise ValueError(f"unknown market {label!r}")
    return INST.calibrated(base, rho=rho)


def market(label: str, root: str, rho: float = 0.2, dev: bool = False, smoke: bool = False, cfg=None, commit: str | None = None,
           salt_sha256: str | None = None) -> dict:
    """`cfg`, `commit`, and `salt_sha256` come from recorded inputs when given (the verify stage), so no calibration
    episode, git process, or salt read happens."""
    cfg = cfg if cfg is not None else _market_cfg(label, root, float(rho))
    train, val = list(range(1000, 1005)), list(range(2000, 2020))
    ev = val if dev else INST.eval_seeds(root, label)
    if smoke:
        train, ev = train[: SMOKE[2]], ev[: SMOKE[3]]
    out = {"label": label, "root": root, "rho": float(rho), "dev": bool(dev), "smoke": bool(smoke), "cfg": cfg, "focal": int(positions(cfg)["median"]),
           "seeds_train": train, "seeds_val": val, "seeds_eval": list(ev), "context": MAN.context(label, float(rho))}
    if commit is not None:
        out["commit"] = str(commit)
    if salt_sha256 is not None:
        out["salt_sha256"] = str(salt_sha256)
    return out


def manifest_ctx(ctx: str) -> str:
    """Development contexts run the fresh0 template of the manifest."""
    label, rest = ctx.split("@", 1)
    return f"fresh0@{rest}" if label.startswith("dev") else ctx


def rule_spec(rule: str, params: dict | None) -> dict:
    p = params or {}
    if rule in FIXED:
        spec = {"tol": 0.16, "L": 10}
    elif rule == "B2":
        b2 = registered_b2_params(); spec = {"tol": float(b2["tol"]), "L": int(b2["L"]), "b2": b2}
    else:
        t = (p.get("tuned") or {}).get(rule)
        if t is None:
            raise SystemExit(f"{rule}: no tuned parameters in --params")
        spec = {"tol": float(t["tol"]), "L": int(t["L"])}
    if rule.startswith("C*"):
        if not p.get("cred"):
            raise SystemExit(f"{rule}: no comparator (cred) in --params")
        spec["cred"] = dict(p["cred"])
    return spec

"""The follow-up budget category of the reset experiment (docs/revision/reset-experiment-plan.md, draft 4, section 7).

scripts/budget_v2.py is frozen (code freeze 627a2de) and has no way to add a category, so this module adds one under the
same lock and validation: the author's written approval sets the program limit and the new `followup` cap together.
Reservations and spend then go through budget_v2.reserve and budget_v2.record unchanged."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT))

from scripts import budget_v2 as BV  # noqa: E402

OP = "followup"
Refused = BV.Refused


def approve(path, new_limit: float, cap: float, text: str) -> None:
    new_limit = BV._amount(new_limit, "approval limit", positive=True); cap = BV._amount(cap, f"cap {OP}", positive=True)
    if not str(text).strip():
        raise Refused("an approval needs the author's written text")
    if not Path(path).exists():
        raise Refused(f"no ledger at {path}")
    with BV._locked(path) as d:
        if OP in d["caps"]:
            raise Refused(f"the {OP} category already has a cap of {d['caps'][OP]} USD")
        if new_limit + 1e-9 < BV._used(d) + cap:
            raise Refused(f"the limit {new_limit} is below the spend and reservations ({BV._used(d):.3f}) plus the new cap {cap}")
        if d.get("approval"):
            d.setdefault("approval_history", []).append(d["approval"])
        d["caps"][OP] = cap
        d["approval"] = {"limit": new_limit, "text": str(text)}


def reserve(path, tag: str, estimate: float) -> float:
    with BV._locked(path) as d:
        if OP not in d["caps"]:
            raise Refused(f"no cap for {OP!r}: record the author's approval first (--approve LIMIT CAP TEXT)")
    return BV.reserve(path, OP, tag, estimate)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--ledger", default=str(BV.DEFAULT))
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--approve", nargs=3, metavar=("LIMIT", "CAP", "TEXT")); g.add_argument("--reserve", nargs=2, metavar=("TAG", "ESTIMATE"))
    a = ap.parse_args(argv)
    try:
        if a.approve:
            approve(a.ledger, float(a.approve[0]), float(a.approve[1]), a.approve[2])
        else:
            print(f"{reserve(a.ledger, a.reserve[0], float(a.reserve[1])):.2f}")
    except Refused as e:
        print(f"refused: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
