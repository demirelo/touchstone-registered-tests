   891	        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
   892	        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
   893	        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
   894	        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
   895	                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
   896	                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
   897	                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
   898	    if job["objective"] in ("W0", "W1"):
