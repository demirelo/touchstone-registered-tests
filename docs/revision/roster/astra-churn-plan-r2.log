   765	GAIN_FIELDS = ("gain", "eff_attack", "eff_ref", "net_eff_attack", "net_eff_ref", "profit_attack", "profit_ref", "audit_spend_attack", "sstar",
   766	               "served_share_attack", "served_share_ref", "false_refund_focal_attack", "false_refund_others_attack",       # design draft 7, 9.3
   767	               "false_refund_focal_ref", "false_refund_others_ref")
