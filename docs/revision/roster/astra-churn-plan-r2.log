    96	def environment() -> dict:
    97	    """The numerical stack of the run (plan draft 5): interpreter, numpy with its BLAS and LAPACK, SciPy, CMA, the CPU."""
    98	    import platform
    99	    import subprocess
   100	    import numpy
   101	    def ver(m):
   102	        try:
   103	            return __import__(m).__version__
   104	        except Exception as e:
   105	            return f"unavailable: {type(e).__name__}"
   106	    try:
   107	        cfg = numpy.show_config(mode="dicts")["Build Dependencies"]; blas = {k: {kk: cfg[k].get(kk) for kk in ("name", "version")} for k in ("blas", "lapack") if k in cfg}
   108	    except Exception as e:
   109	        blas = f"unavailable: {type(e).__name__}"
   110	    cpu = platform.processor()
   111	    for cmd in (["sysctl", "-n", "machdep.cpu.brand_string"], ["sh", "-c", "grep -m1 'model name' /proc/cpuinfo"]):
   112	        try:
   113	            r = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
   114	            if r.returncode == 0 and r.stdout.strip():
   115	                cpu = r.stdout.strip(); break
   116	        except Exception:
   117	            pass
   118	    return {"python": platform.python_version(), "numpy": numpy.__version__, "scipy": ver("scipy"), "cma": ver("cma"), "blas": blas, "cpu": cpu,
   119	            "machine": platform.machine(), "platform": platform.platform(), "driver_sha256": sha_file(Path(__file__))}
