   919	                "heldout": _coalition_heldout(job, _desc(job, new.best_knobs), out)}
   920	    ctx, tag = job["context"], _coalition_tag(job)                  # G_min: every score against the final reference (design 6.3)
   921	    ref = np.asarray(read(path_of(out, f"joint_reference/{ctx}/{tag}"))["member_normalized"])
