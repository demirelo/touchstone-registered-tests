   939	def rescore_min(orig, rows: list[dict], ref: np.ndarray):
   940	    """The search's archive with every G_min score recomputed against `ref` from the stored member rows (design 6.3)."""
   941	    by = {exact_key(e["knobs"]): np.asarray(e["member_rows"]) for e in rows}
   942	    arch = {}
   943	    for k, e in orig.archive.items():
   944	        f = float((by[k] - ref).mean(axis=1).min()) if k in by else e.f
   945	        arch[k] = replace(e, f=f)
   946	    best = max(arch.values(), key=lambda e: e.f)
   947	    return replace(orig, archive=arch, best_knobs=dict(best.knobs), best_f=best.f)
