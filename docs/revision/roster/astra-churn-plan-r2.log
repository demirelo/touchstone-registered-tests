   906	        sel = select_w1(obj) if job["objective"] == "W1" else dict(max(obj.archive.values(), key=lambda e: e.f).knobs)
   907	        new_eff = obj.extra[exact_key(sel)]["eff"] if sel is not None else None
   908	        held = None
