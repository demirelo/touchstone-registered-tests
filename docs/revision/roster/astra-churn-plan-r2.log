   345	def menu(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> tuple[list, list, dict]:
   346	    """The reference menu of the job's rule in its context (design 6.4): candidates, their family names, upstream hashes."""
   347	    ctx, rule = job["context"], job["rule"]; T, L = constants(job); cell = train_cell(job)
   348	    groups: dict[tuple, list] = {}; upstream = {}; fnames = MAN.menu_families(manifest_ctx(ctx), rule)
   349	    for fname in fnames:
   350	        rid = _menu_id(ctx, rule, fname); rec = read(path_of(out, rid))
   351	        if rec is None:
   352	            raise SystemExit(f"reference {ctx}/{rule}: needs {rid}")
   353	        upstream[rid] = sha_file(path_of(out, rid))
   354	        fam = family_for(fname, T, L)
   355	        bank = []
   356	        if rule in FIXED:
   357	            for other in MAN.bank_rules(manifest_ctx(ctx), fname, cuts, h4_excluded):
   358	                if other == rule:
   359	                    continue
   360	                orid = _menu_id(ctx, other, fname); orec = read(path_of(out, orid))
   361	                if orec is None:
   362	                    raise SystemExit(f"reference {ctx}/{rule}: needs bank source {orid}")
   363	                upstream[orid] = sha_file(path_of(out, orid)); bank.append(fam.project(orec["attack"]["best_knobs"]))
   364	        lk = load_locked()
   365	        cands = reference_candidates(cell, fam, search_from_json(rec["attack"]), search_from_json(rec["twin"]), bank, tuple(lk["reference_order"]))
   366	        for c in cands:
   367	            cat = "bank" if c.name.startswith("bank_") else c.name
   368	            groups.setdefault((cat, fname), []).append(c)
   369	    out_c, fams = merge_menu(groups, fnames)
   370	    return out_c, fams, upstream
