   130	def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, markets=MARKETS, smoke: bool = False) -> list[dict]:
   131	    """The frozen `job` for each restored cell, on the recorded (container) configuration of its market."""
   132	    jobs = []
   133	    for m in markets:
   134	        mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
   135	        jobs += [R.job(mkt, c["rule"], "D2", "profit", smoke=smoke, params=params, block=c["block"]) for c in restored_cells((m,))]
   136	    return jobs
