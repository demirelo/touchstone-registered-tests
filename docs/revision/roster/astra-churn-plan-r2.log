   372	
   373	def merge_menu(groups: dict, family_order) -> tuple[list, list]:
   374	    """Candidates in the registered category order, families in the given order within a category, de-duplicated by
   375	    (family, exact key); abstain and honest-max once."""
   376	    out_c, fams, seen = [], [], set()
   377	    for cat in CATEGORIES:
   378	        for fname in family_order:
   379	            for c in groups.get((cat, fname), []):
   380	                key = ("name", c.name) if c.knobs is None else (fname, exact_key(c.knobs))
   381	                if key in seen:
   382	                    continue
   383	                seen.add(key); out_c.append(c); fams.append(None if c.knobs is None else fname)
   384	    return out_c, fams
