   910	            fr = run_focal(eval_cell(job), lambda: fam.make(dict(sel)), SeedCache())
   911	            held = {"knobs": dict(sel), "seeds": list(eval_cell(job).seeds), "eff": gross_efficiency(fr.results).tolist()}
   912	        return {**doubling_report("w1" if job["objective"] == "W1" else "welfare", {"eff": old_eff, "feasible": sel_old is not None},
   913	                                  {"eff": new_eff, "feasible": sel is not None}), "heldout": held}
   914	    m = job["mkt"]; fam = family_for(job["family"], T, L); orig = search_from_json(rec["coalition"])
