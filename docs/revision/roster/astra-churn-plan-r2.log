# ---- orchestration -----------------------------------------------------------------------------------------------------

def _stage_record_path(stage: str, job: dict, out: Path) -> Path:
    if stage in ("search", "dependent"):
        return path_of(out, job["id"])
    if stage == "evaluate":
        return eval_path(out, job["id"])
    return Path(out) / "doubling" / (_safe(job["id"]) + ".json")


def _inputs(job: dict) -> set:
    """The records an evaluation or a doubling check depends on (the diagnostic has none but the freeze)."""
    if job["objective"] == "diagnostic":
        return set()
    ids = {job["id"]}
    if job["objective"] in ("W0", "W1"):
        ids.add(f"welfare_select/{job['context']}/{job['rule']}/{job['objective']}")
    if job["objective"] in ("profit", "W1"):
        ids.add(f"reference/{job['context']}/{job['rule']}")
    if job["objective"] in ("total", "min"):
        ids.add(f"joint_reference/{job['context']}/{_coalition_tag(job)}")
    if job["objective"] == "min":
        ids.add(f"coalition_select/{job['context']}/{_coalition_tag(job)}")
    return ids


def stage_upstream(stage: str, job: dict, catalog: list[dict], cuts: int, h4_excluded: bool) -> set:
    if stage in ("search", "dependent"):
        return expected_upstream(job["id"], catalog, cuts, h4_excluded)
    ids = _inputs(job) | {f"freeze/{job['context']}"}
    if stage == "doubling" and job["objective"] == "profit":                  # the profit check reselects from the rule's menu
        ids |= expected_upstream(f"reference/{job['context']}/{job['rule']}", catalog, cuts, h4_excluded)
    return ids


def _tiers(items: list) -> list[list]:
    return [[i for i in items if i.get("priority", 3) == t] for t in range(4)]


def _menu_items(jobs: list[dict]) -> list[dict]:
    menus = {}
    for j in jobs:
        if j["objective"] == "profit" and j["family"] in MENU:
            k = (j["context"], j["rule"]); m = menus.get(k)
            if m is None or (j["family"] == "D2+H3" and m["family"] != "D2+H3"):
                menus[k] = {**j, "id": f"reference/{k[0]}/{k[1]}", "priority": min(j.get("priority", 3), (m or {}).get("priority", 3))}
            else:
                m["priority"] = min(m["priority"], j.get("priority", 3))
    return list(menus.values())


def _cross_items(jobs: list[dict]) -> list[dict]:
    ok = {c for c, _ in MAN.cross_evaluations()}
    return [{"id": f"cross/{ctx}/{fam}", "context": ctx, "family": fam, "priority": 1}
            for ctx in sorted({j["context"] for j in jobs}) if manifest_ctx(ctx) in ok or ctx.startswith("dev") for fam in MENU]


def _waves(stage: str, jobs: list[dict], catalog: list[dict]) -> list[tuple[str, list]]:
    """The (stage, items) calls `run` makes, in order: priority tiers 0 to 3 (design 8.2), and inside a tier the dependency
    waves. Each call is a completion barrier: it returns only when all its items have finished."""
    out = []
    add = lambda st, items: out.append((st, items)) if items else None
    if stage == "search":
        for t in _tiers([j for j in jobs if j["objective"] in ("profit", "W0")]):
            add("search", [j for j in t if j["family"] != "X7-SC"]); add("search", [j for j in t if j["family"] == "X7-SC"])
    elif stage == "reference":
        for t in _tiers(_menu_items(jobs)):
            add("reference", t)
    elif stage == "dependent":
        for t in _tiers([j for j in jobs if j["objective"] in ("W1", "total", "min")]):
            add("dependent", [j for j in t if j["objective"] == "W1" and j["family"] != "X7-SC"])
            add("dependent", [j for j in t if j["objective"] == "W1" and j["family"] == "X7-SC"])
            co = [j for j in t if j["objective"] in ("total", "min")]; groups = {}
            for j in co:
                groups.setdefault((j["context"], _coalition_tag(j)), j)
            step = lambda kind, g, suffix="": {**g, "id": f"{kind}/{g['context']}/{_coalition_tag(g)}{suffix}", "record_id": f"{kind}/{g['context']}/{_coalition_tag(g)}{suffix}"}
            add("joint_twin", [step("joint_twin", g, f"_{s}") for g in groups.values() for s in _x6_schedules(_group(g, catalog))])
            add("dependent", [j for j in co if j["objective"] == "total"])
            add("joint_reference_pre", [step("joint_reference_pre", g) for g in groups.values()])
            add("dependent", [j for j in co if j["objective"] == "min"])
            add("joint_reference", [step("joint_reference", g) for g in groups.values()])
            add("coalition_select", [step("coalition_select", g) for g in groups.values()])
    elif stage == "evaluate":
        for t in _tiers(jobs):
            add("evaluate", t)
    elif stage == "cross":
        for t in _tiers(_cross_items(jobs)):
            add("cross", t)
    elif stage == "doubling":
        dbl = set(MAN.doublings())
        for t in _tiers([j for j in jobs if j["id"].replace(j["context"], manifest_ctx(j["context"]), 1) in dbl]):
            add("doubling", t)
    return out


def dispatch_plan(stage: str, jobs: list[dict], catalog: list[dict] | None = None) -> list[list[str]]:
    """The ids of every `_pool` call `run(stage, jobs)` makes, in order (Task 4's cost model bills these waves)."""
    return [[i["id"] for i in items] for _, items in _waves(stage, jobs, catalog if catalog is not None else jobs)]


def _run_cross(item: dict, out: Path, catalog: list[dict]) -> str:
