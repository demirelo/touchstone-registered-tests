   273	
   274	def _run_rate(out, jobs, steps, a, salt_sha, container, p, started) -> None:
   275	    F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
   276	    if not a.smoke:
   277	        F.check_pairing(a.src, jobs)
   278	    slow = 1.33 if p > 0 else 1.0
   279	    for st in steps:
   280	        w = a.workers_search if st == "search" else a.workers_eval
   281	        if st in STAGE_SECONDS:
   282	            check_cap(started, STAGE_SECONDS[st] * slow * -(-len(jobs) // max(1, w)), a.stop_usd, a.usd_per_hour)
   283	        if st == "inputs":
   284	            F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
   285	        elif st == "search":
   286	            run_stage("search", jobs, out, w)
   287	        elif st == "freeze":
   288	            F.prefreeze(out, jobs)
   289	        elif st in ("evaluate", "doubling"):
   290	            F.accept(out, jobs, salt_sha, container, src=a.src); run_stage(st, jobs, out, w)
   291	        elif st == "diagnostics":
   292	            write(Path(out) / "diagnostics.json", diagnostics(out, jobs, w))
   293	        else:
   294	            inventory(out, p)
   295	        print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs)}), flush=True)
