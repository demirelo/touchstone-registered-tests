   934	    g = _rows_of(job, desc, seeds, cache) - _rows_of(job, jrec["descriptor"], seeds, cache)
   935	    return {"descriptor": desc, "knobs": None if desc["knobs"] is None else dict(desc["knobs"]), "seeds": seeds, "member_gain": g.tolist(),
   936	            "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min())}
