   388	def compare_doubling(src, out, rid: str) -> dict:
   389	    """Validation (d), plan draft 5: a doubling record against the registered one; exact on the flag, the seeds, and the
   390	    discrete knobs; 1e-9 on the continuous knobs, the changes, and the held-out per-seed gains."""
   391	    p = lambda b: Path(b) / "doubling" / (R._safe(rid) + ".json")
   392	    a, b = read(p(src)), read(p(out))
   393	    if a is None or b is None:
   394	        return {"pass": False, "problems": ["a record is missing"]}
   395	    problems = []
   396	    need = ("incomplete", "attack_change", "reference_change", "heldout")
   397	    if any(k not in x for x in (a, b) for k in need) or any(k not in x["heldout"] for x in (a, b) for k in ("knobs", "seeds", "gain")):
   398	        return {"pass": False, "problems": ["missing field"]}
   399	    if not _finite(a["attack_change"], b["attack_change"], a["reference_change"], b["reference_change"], a["heldout"]["gain"], b["heldout"]["gain"],
   400	                   list(a["heldout"]["knobs"].values()), list(b["heldout"]["knobs"].values())):
   401	        problems.append("nonfinite value")
   402	    if bool(a["incomplete"]) != bool(b["incomplete"]):
   403	        problems.append("flag differs")
   404	    ha, hb = a["heldout"], b["heldout"]
   405	    if ha["seeds"] != hb["seeds"]:
   406	        problems.append("seeds differ")
   407	    ka, kb = ha["knobs"], hb["knobs"]; disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   408	    if set(ka) != set(kb) or any(ka[k] != kb[k] for k in disc):
   409	        problems.append("discrete knob differs")
   410	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   411	    chg = max(abs(a[k] - b[k]) for k in ("attack_change", "reference_change"))
   412	    gd = max((abs(x - y) for x, y in zip(ha["gain"], hb["gain"])), default=0.0) if len(ha["gain"]) == len(hb["gain"]) else float("inf")
   413	    if not (rel <= KNOB_TOL and chg <= GAIN_TOL and gd <= GAIN_TOL):
   414	        problems.append(f"tolerance exceeded (knobs {rel:.3g}, changes {chg:.3g}, gains {gd:.3g})")
   415	    return {"pass": not problems, "max_knob_rel": rel, "max_change_abs": chg, "max_gain_abs": gd, "problems": problems}
