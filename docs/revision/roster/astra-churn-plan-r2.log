"""The 2 x 2 x 2 decomposition of R3 (design 3.2) and the repaired R3, R4 (design 3.4). Every cell is B3's allocation and
payment with refund-and-ban enforcement; cells differ in pacing (S: B3's spread count or R3's reserve schedule) and in
selection (P: the priority phase over identities younger than L rounds; G: the newest-first half of the residual). F000 is
B3, F111 is R3, F011 is the killed amendment-2 rule (tests/oracles). Ties: when P = G = 0 the uniform order is B3's (stable
order of the audit key over jobs in assignment order); otherwise R3's (audit key, then job)."""
from __future__ import annotations

import numpy as np

from .base import AuditRecord, Consequences, Mechanism, Offers, StateView
from .pacing import ReservePacing, spread_cap, spread_count
from .second_score import SecondScore

NAMES = tuple(f"F{p}{g}{s}" for p in (0, 1) for g in (0, 1) for s in (0, 1)) + ("R4",)


def select(jobs_by_identity: dict, audit_key, first_round: dict, t: int, L: int, k: int, P: int, G: int, order: list | None = None) -> list:
    """k audited jobs in order. Priority phase (P = 1): the jobs of identities with 0 <= t - first_round < L, by (-first_round,
    audit_key, job). Residual r: with G = 1, ceil(r / 2) picks by (-first_round, audit_key, job), then uniform by (audit_key, job);
    with G = 0, all uniform. With P = G = 0, uniform is B3's stable audit-key order over `order` (jobs in assignment order)."""
    remaining = {int(j): int(i) for i, jobs in jobs_by_identity.items() for j in jobs}
    k = max(0, min(int(k), len(remaining)))
    if not P and not G:
        jobs = np.asarray(order if order is not None else list(remaining), dtype=np.int64)
        idx = np.argsort(np.asarray(audit_key)[jobs], kind="stable")
        return jobs[idx[:k]].tolist()
    born = lambda i: int(first_round.get(i, t))
    newest = lambda j: (-born(remaining[j]), float(audit_key[j]), j)
    chosen: list = []
    if P:
        fresh = sorted((j for j, i in remaining.items() if 0 <= int(t) - born(i) < int(L)), key=newest)
        for j in fresh[:k]:
            remaining.pop(j); chosen.append(j)
    r = k - len(chosen)
    k_t = (r + 1) // 2 if G else 0
    for _ in range(k_t):
        pick = min(remaining, key=newest)
        remaining.pop(pick); chosen.append(pick)
    rest = sorted(remaining, key=lambda j: (float(audit_key[j]), j))
    chosen.extend(rest[: r - k_t])
    return chosen


class FactorialRule(Mechanism):
    def __init__(self, P: int, G: int, S: int, tol: float, L: int, reserve: str = "full") -> None:
        if any(v not in (0, 1) for v in (P, G, S)):
            raise ValueError("P, G, S must be 0 or 1")
        self.P, self.G, self.S, self.tol, self.L, self.reserve = int(P), int(G), int(S), float(tol), int(L), str(reserve)
        if self.reserve != "full" and not (self.P and self.G and self.S):
            raise ValueError("the half reserve is R4 only")
        self.name = "R4" if self.reserve == "half" else f"F{self.P}{self.G}{self.S}"
        self._b3 = SecondScore(self.tol, self.L)
        self._pacing = ReservePacing(self.reserve, self.L)
        self.T, self.cap = 1, 1

    def bind(self, cfg) -> None:
        self.T, self.cap = int(cfg.T), spread_cap(cfg)
        self._pacing.bind(cfg)

    @staticmethod
    def _memory(view: StateView) -> tuple[dict, dict, dict]:
        m = view.memory
        return m.setdefault("first_round", {}), m.setdefault("audits", {}), m.setdefault("served", {})

    def allocate(self, values_t: np.ndarray, offers: Offers, view: StateView) -> dict[int, int]:
        first_round, _, served = self._memory(view)
        for i in offers:
            if view.is_active(i):
                first_round.setdefault(int(i), int(view.t))
                served.setdefault(int(i), 0)
        out = self._b3.allocate(values_t, offers, view)
        for i in out.values():
            served[int(i)] = served.get(int(i), 0) + 1
        return out

    def price(self, assignment, values_t, offers, view) -> dict[int, float]:
        return self._b3.price(assignment, values_t, offers, view)

    def audit(self, assignment: dict[int, int], view: StateView) -> list[int]:
        first_round, audits, _ = self._memory(view)
        n = len(assignment)
        k = self._pacing.count(view, n) if self.S else spread_count(view, self.T, self.cap, n)
        if k <= 0:
            return []
        by_identity: dict[int, list[int]] = {}
        for j, i in assignment.items():
            by_identity.setdefault(int(i), []).append(int(j))
        chosen = select(by_identity, view.audit_key, first_round, view.t, self.L, k, self.P, self.G, order=[int(j) for j in assignment])
        for j in chosen:
            i = int(assignment[j]); audits[i] = audits.get(i, 0) + 1
        return chosen

    def enforce(self, records: tuple[AuditRecord, ...], view: StateView) -> Consequences:
        cons = Consequences()
        for r in records:
            if r.failed:
                cons.refunds[r.job] = float(view.escrow[r.job])
                cons.bans[r.provider] = max(cons.bans.get(r.provider, 0), int(self.L))
        return cons

    def describe(self) -> dict:
        d = dict(self._b3.describe())
        if self.name != "F000":
            d["audit_selection"] = "not expressible"
        d["parameters"] = {"audit_tolerance": float(self.tol), "ban_length": int(self.L)}
        return d


def make_factorial(name: str, tol: float, L: int) -> FactorialRule:
    if name == "R4":
        return FactorialRule(1, 1, 1, tol, L, reserve="half")
    if name not in NAMES:
        raise ValueError(f"unknown factorial cell {name!r}")
    return FactorialRule(int(name[1]), int(name[2]), int(name[3]), tol, L)
"""The proposed rule R*, exactly as the registered design block of experiments/amendment-2026-10-17.yaml prescribes
(amendment 1, design and tuning; the orchestration of amendment 2). Allocation A reimplements B3's descending-value
sequential second-score allocation and payment; allocation B reimplements B1's tier allocation at the locked B2 prices
(bids ignored). The audit count follows the registered schedule (terminal reserve of the last L rounds, cumulative
early quota with carry); the audit selection is half targeted (T1: newest identity first; T2: lowest audits per served
job, recomputed after every selection), half uniform by audit key; enforcement is a full refund of the failed job's
escrow and a ban of L rounds; no hold-back. The rule reads only offers, job values, purchased audit results, its own
memory, and the constants of bind(cfg). Amendment 3 (after the F2 kill of the amendment-2 selection) adds the priority
phase: the served jobs of identities younger than L rounds are audited first, newest identity first, before the registered
split of what remains. Its audit selection is not expressible in the locked vocabulary (the ruling of both review seats),
so the describe record says so."""
from __future__ import annotations

import math

import numpy as np

from sim.mechanisms.base import AuditRecord, Consequences, Mechanism, Offers, StateView

ALLOCATIONS = ("A", "B")
TARGETINGS = ("T1", "T2")
TOLS = (0.12, 0.14, 0.16)
BAN_LENGTHS = (3, 10, 20)
TIERS = ((0.0, 0.5), (0.5, 0.8), (0.8, 1.0001))          # B1's tiers by claim


# ------------------------------------------------------------------------------------------------ the registered schedule
def terminal(t: int, T: int, L: int) -> bool:
    """Rounds T - L .. T - 1 are terminal: every served job is audited while audits remain."""
    return int(t) >= int(T) - int(L)


def _reserve(J: int, L: int, A_tot: int) -> int:
    return min(int(J) * int(L), int(A_tot))


def _cumulative(t: int, E: int, early_rounds: int) -> int:
    """C(t) = floor(E (t + 1) / (T - L)); C(-1) = 0."""
    if t < 0:
        return 0
    return (int(E) * (int(t) + 1)) // int(early_rounds)


def audit_quota(t: int, T: int, L: int, J: int, A_tot: int, carry: int) -> int:
    """The available quota of round t before the served-jobs and audits-left caps: in an early round C(t) - C(t - 1)
    plus the carried unspent quota; in a terminal round the whole allowance (the caller caps it by the served jobs and
    by audits_left, so every served job is audited while audits remain)."""
    if terminal(t, T, L):
        return int(A_tot)
    early_rounds = int(T) - int(L)
    E = int(A_tot) - _reserve(J, L, A_tot)
    return _cumulative(t, E, early_rounds) - _cumulative(t - 1, E, early_rounds) + int(carry)


def split_counts(k: int) -> tuple[int, int]:
    """k_t = ceil(k / 2) targeted, the rest uniform."""
    k_t = (int(k) + 1) // 2
    return k_t, int(k) - k_t


def select_audits(jobs_by_identity: dict, audit_key, first_round: dict, audits: dict, served: dict, targeting: str, k: int, t: int, L: int) -> list:
    """Amendment 3: pure job-level selection of k audits in order. Priority phase: every served job of a fresh identity
    (0 <= t - first_round < L), newest identity first, then ascending audit_key, then job index, up to k; these count in
    their identities' audit totals before anything else. Residual phase on r = k - q: ceil(r / 2) targeted picks one
    job at a time (T1 by descending first_round then ascending audit_key; T2 by ascending audits_i / served_i recomputed
    after every pick, served_i = 0 giving 0, then ascending audit_key), then floor(r / 2) uniform picks among the remaining
    jobs by ascending audit_key. No job twice, never more than the served jobs. The caller's counts are not changed."""
    remaining = {int(j): int(i) for i, jobs in jobs_by_identity.items() for j in jobs}
    counts = {int(i): int(a) for i, a in audits.items()}
    k = max(0, min(int(k), len(remaining)))
    chosen: list = []

    def born(i: int) -> int:
        return int(first_round.get(i, t))

    def fresh(i: int) -> bool:
        return 0 <= int(t) - born(i) < int(L)

    priority = sorted((j for j, i in remaining.items() if fresh(i)), key=lambda j: (-born(remaining[j]), float(audit_key[j]), j))
    for j in priority[:k]:
        i = remaining.pop(j)
        counts[i] = counts.get(i, 0) + 1
        chosen.append(j)

    def ratio(i: int) -> float:
        s = int(served.get(i, 0))
        return (counts.get(i, 0) / s) if s > 0 else 0.0

    k_t, k_u = split_counts(k - len(chosen))
    for _ in range(k_t):
        if not remaining:
            break
        if targeting == "T1":
            pick = min(remaining, key=lambda j: (-born(remaining[j]), float(audit_key[j]), j))
        else:
            pick = min(remaining, key=lambda j: (ratio(remaining[j]), float(audit_key[j]), j))
        i = remaining.pop(pick)
        counts[i] = counts.get(i, 0) + 1
        chosen.append(pick)
    rest = sorted(remaining, key=lambda j: (float(audit_key[j]), j))
    chosen.extend(rest[: max(0, int(k_u))])
    return chosen


