   298	def main(argv=None) -> int:
   299	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   300	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True)
   301	    ap.add_argument("--draw", default=str(F.ROOT / "results/v2/draw/draw.json")); ap.add_argument("--instances", default=str(F.ROOT / "results/v2/draw/instances.json"))
   302	    ap.add_argument("--cfgs", default=str(F.ROOT / "results/v2/deviation/cfg_linux.json")); ap.add_argument("--addendum", default=str(F.ROOT / "results/v2/report/addendum.json"))
   303	    ap.add_argument("--params", default=str(F.ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   304	    ap.add_argument("--rules", default=",".join(RULES)); ap.add_argument("--rates", default=",".join(f"{p:g}" for p in RATES))
   305	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
   306	    ap.add_argument("--workers-search", dest="workers_search", type=int, default=16); ap.add_argument("--workers-eval", dest="workers_eval", type=int, default=9)
   307	    ap.add_argument("--started", type=float, default=None, help="epoch seconds of pod allocation; spend is billed from it")
   308	    ap.add_argument("--stop-usd", dest="stop_usd", type=float, default=STOP_USD); ap.add_argument("--usd-per-hour", dest="usd_per_hour", type=float, default=POD_USD_PER_HOUR)
   309	    ap.add_argument("--gate", choices=("first", "only", "skip"), default="first", help="the p = 0 reproduction gate (plan section 3 c)")
   310	    ap.add_argument("--smoke", action="store_true")
   311	    a = ap.parse_args(argv); base = Path(a.out); F.check_out(base, a.src)
   312	    from sim.records import cfg_from_dict
   313	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   314	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   315	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   316	    params = json.loads(Path(a.params).read_text())
   317	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if a.stage == "all" else (a.stage,)
   318	    install()
   319	    if a.gate != "skip" and a.stage == "all":
   320	        out = base / "gate-p0"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   321	        jobs = build_jobs(root, cfgs, params, salt_sha, 0.0, (GATE_CELL[0],), (GATE_CELL[1],), a.smoke)
   322	        _run_rate(out, jobs, ("inputs", "search", "freeze", "evaluate", "doubling", "inventory"), a, salt_sha, container, 0.0, a.started)
   323	        rid = R.cell_id(f"{GATE_CELL[0]}@rho0.2", GATE_CELL[1], "D2+H3", "profit")
   324	        g = gate_compare(a.src, out, rid, jobs[0]["id"]); inventory(out, 0.0)
   325	        print(json.dumps({"gate": g["pass"], "search": g["search"].get("problems"), "doubling": g["doubling"].get("problems")}), flush=True)
   326	        if not g["pass"] and not a.smoke:
   327	            print("churn arm stopped: the p = 0 gate failed", file=sys.stderr)
   328	            return 1
   329	        if a.gate == "only":
   330	            return 0 if g["pass"] else 1
   331	    for p in (float(x) for x in a.rates.split(",")):
   332	        out = base / f"p{p:g}"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   333	        jobs = build_jobs(root, cfgs, params, salt_sha, p, tuple(a.markets.split(",")), tuple(a.rules.split(",")), a.smoke)
   334	        _run_rate(out, jobs, steps, a, salt_sha, container, p, a.started)
   335	    return 0
