   736	def stage_freeze(ctx: str, catalog: list[dict], out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
   737	    derived_records(ctx, catalog, out, cuts, h4_excluded)
   738	    problems = check_complete(ctx, catalog, out, cuts, h4_excluded)
   739	    if problems:
   740	        raise SystemExit(f"freeze {ctx} refused: {problems[:5]}{' ...' if len(problems) > 5 else ''}")
   741	    recs = [r.replace(manifest_ctx(ctx), ctx, 1) for r in MAN.required(manifest_ctx(ctx), cuts, h4_excluded)]
   742	    rec = {"stage": "freeze", "context": ctx, "cuts": cuts, "h4_excluded": h4_excluded, "records": {r: sha_file(path_of(out, r)) for r in recs}}
   743	    write(path_of(out, f"freeze/{ctx}"), rec)
   744	    return rec
