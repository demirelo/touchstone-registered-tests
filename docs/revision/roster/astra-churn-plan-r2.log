   747	def accept(ctx: str, catalog: list[dict], out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
   748	    fr = read(path_of(out, f"freeze/{ctx}"))
   749	    if fr is None:
   750	        raise SystemExit(f"{ctx}: no freeze; evaluation refused")
   751	    for r, sha in fr["records"].items():
   752	        p = path_of(out, r)
   753	        if not p.exists() or sha_file(p) != sha:
   754	            raise SystemExit(f"{ctx}: {r} differs from the freeze; evaluation refused")
   755	    problems = check_complete(ctx, catalog, out, cuts, h4_excluded)
   756	    missing = [r.replace(manifest_ctx(ctx), ctx, 1) for r in MAN.required(manifest_ctx(ctx), cuts, h4_excluded)
   757	               if r.replace(manifest_ctx(ctx), ctx, 1) not in fr["records"]]
   758	    if problems or missing:
   759	        raise SystemExit(f"{ctx}: freeze incomplete or stale; evaluation refused: {(problems + missing)[:5]}")
   760	    return fr
