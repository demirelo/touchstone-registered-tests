   248	STOP_USD, POD_USD_PER_HOUR = 8.00, 0.56            # author, 2026-11-10: stop cap 8 USD for this arm (category followup)
   249	
   250	
   251	def check_cap(started: float | None, need_s: float, cap: float = STOP_USD, usd_per_hour: float = POD_USD_PER_HOUR, now: float | None = None) -> None:
   252	    """No running stage is ever killed (author, 2026-11-10). Between stages: refuse to dispatch the next stage if the pod
   253	    time already billed since `started` plus the stage's estimate would pass the stop cap; the driver then stops and
   254	    reports."""
   255	    import time
   256	    if started is None:
   257	        return
   258	    spent = ((now if now is not None else time.time()) - float(started)) / 3600 * usd_per_hour
   259	    need = float(need_s) / 3600 * usd_per_hour
   260	    if spent + need > cap:
   261	        raise SystemExit(f"churn arm stopped between stages: {spent:.2f} USD billed + {need:.2f} USD for the next stage would pass the {cap:.2f} USD cap")
   262	
