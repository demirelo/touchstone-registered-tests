   275	def reusable(p: Path, rec: dict | None, prov: dict, check) -> bool:
   276	    """The resume rule for every record (plan Review Focus 5): a missing, damaged, or stale record under the current
   277	    provenance is recomputed (False); one that passes `check` is reused (True); a record with another provenance is
   278	    refused, never overwritten."""
   279	    if rec is None:
   280	        return False
   281	    if rec.get("provenance") != prov:
   282	        raise SystemExit(f"{p}: a record with another provenance exists; refusing to overwrite")
   283	    try:
   284	        check()
   285	        return True
   286	    except (ValueError, KeyError, StopIteration, TypeError):
   287	        return False
