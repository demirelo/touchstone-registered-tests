   216	def tally(sc: dict) -> dict:
   217	    st = [v["status"] for v in sc.values()]
   218	    return {s: st.count(s) for s in ("fulfilled", "failed", NA)}
   219	
   220	
   221	def eligibility_map(sc: dict, flagged, deps: dict | None = None) -> dict:
   222	    """Tallies with dependencies (the readings) and with direct inputs only (as in external review round 7); every cell
   223	    with its direct inputs, flagged required searches, and status under each reading."""
   224	    by = {s: eligibility(sc, flagged, s, deps) for s in SCOPES}
   225	    direct = {s: tally(eligibility(sc, flagged, s)) for s in SCOPES}
   226	    cells = lambda pid: {c["cell"]: {"inputs": inputs(pid, c["cell"]), "required": c["required"], "flagged": c["flagged"],
   227	                                     "status": {s: next(d["status"] for d in by[s][pid]["cells"] if d["cell"] == c["cell"]) for s in SCOPES}}
   228	                         for c in by["numerical"][pid].get("cells", [])}
   229	    return {"flagged": sorted(set(flagged)), "dependencies_traced": deps is not None,
   230	            "tally": {s: tally(by[s]) for s in SCOPES}, "tally_direct_inputs": direct,
   231	            "targets": {pid: {"decision": pid in DECISIONS, "status": {s: by[s][pid]["status"] for s in SCOPES},
   232	                              "flagged": sorted({x for c in by["numerical"][pid].get("cells", []) for x in c["flagged"]}),
   233	                              "cells": cells(pid)}
   234	                        for pid in sorted(sc)}}
   235	
   236	
   237	def main(argv=None) -> int:
   238	    ap = argparse.ArgumentParser(); ap.add_argument("--report", required=True); ap.add_argument("--cells", required=True)
   239	    ap.add_argument("--write", required=True)
   240	    ap.add_argument("--eligibility", help="also write the eligibility map (flagged inputs, three readings) here")
   241	    ap.add_argument("--records", help="evaluation records (eval/all); with --eligibility, trace recorded dependencies")
   242	    a = ap.parse_args(argv); rep = json.loads(Path(a.report).read_text())
   243	    sc = score(rep, json.loads(Path(a.cells).read_text()))
   244	    Path(a.write).write_text(json.dumps(sc, indent=1, sort_keys=True))
   245	    if a.eligibility:
   246	        ids = sorted({x for pid, v in sc.items() for c in v.get("cells", []) for x in inputs(pid, c["cell"])})
   247	        deps = dependencies(a.records, ids) if a.records else None
   248	        em = eligibility_map(sc, rep.get("search_flagged") or [], deps)
   249	        Path(a.eligibility).write_text(json.dumps(em, indent=1, sort_keys=True))
   250	    return 0
   251	
   252	
   253	if __name__ == "__main__":
   254	    sys.exit(main())
