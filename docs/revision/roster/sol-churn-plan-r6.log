   146	def test_r1_frozen_reference_score_is_recomputed_under_churn(tmp_path):
   147	    """Blocker 1: reference_change compares two churn scores; the frozen reference's stored no-churn score is replaced by
   148	    its evaluation under churn on the training seeds."""
   149	    from sim.cell import SeedCache, run_focal
   150	    j, root = _full_churn_job(); C.R.install_salt(root, tmp_path); C.install()
   151	    C.F.copy_inputs(MAIN / "eval/all", tmp_path, C.F.inputs(MAIN / "eval/all", [j]))
   152	    cand, rrec, _ = C.R.reference_of(j, tmp_path)
   153	    want = run_focal(C.R.train_cell(j), cand.policy_factory, SeedCache()).normalized
   154	    assert rrec["per_seed_normalized"] == [float(x) for x in want] and rrec["churn_reevaluated"] is True
   155	    stored = read(C.R.path_of(tmp_path, f"reference/{j['context']}/F111"))["per_seed_normalized"]
