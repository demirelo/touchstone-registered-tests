   298	def _gate_records(tmp_path, gain_out, knob_out=0.5):
   299	    from sim.records_v2 import write
   300	    rid = "fresh0@rho0.2|F111|D2+H3|profit"; cid = rid + "|churn0"
   301	    prov = {"cfg_sha256": "c", "budget": [5, 300, 5, 200], "runner_sha256": "r", "salt_sha256": "s", "rule_params_sha256": "p", "root": "h",
   302	            "seeds_train": [7], "seeds_val": [8], "seeds_eval": [1, 2], "context": "fresh0@rho0.2", "git_commit": "x"}
   303	    def put(base, i, gain, u0):
   304	        k = {"u0": u0, "x": 1, "clip": 0}
   305	        write(C.R.path_of(base, i), {"stage": "search", "id": i, "attack": {"best_knobs": k, "best_f": 0.1, "best_source": "r", "archive": [0]},
   306	                                     "twin": {"archive": [0], "best_f": 0.05}, "runs": 9, "upstream": {}, "provenance": {**prov, "id": i}})
   307	        write(C.R.eval_path(base, i), {"stage": "evaluate", "seeds": [1, 2], "gain": gain,
   308	                                       "upstream": {i: "a", "reference/fresh0@rho0.2/F111": "ref", "freeze/fresh0@rho0.2": "f"}})
   309	        write(base / "doubling" / (C.R._safe(i) + ".json"), {"stage": "doubling", "incomplete": False, "attack_change": 0.0, "reference_change": 0.0,
   310	                                                               "heldout": {"knobs": k, "seeds": [1, 2], "gain": gain}})
   311	    put(tmp_path / "src", rid, [0.1, 0.2], 0.5); put(tmp_path / "out", cid, gain_out, knob_out)
   312	    return rid, cid
