   360	
   361	def _preflight_groups(stage: str, jobs: list[dict]) -> list[list[dict]]:
   362	    """Candidates per measurement, in job order: one group per rule for evaluate, one group for doubling."""
   363	    if stage == "evaluate":
   364	        groups: dict = {}
   365	        for j in jobs:
   366	            groups.setdefault(j.get("rule"), []).append(j)
   367	        return list(groups.values())
