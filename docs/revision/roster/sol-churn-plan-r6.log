   125	@pytest.mark.skipif(not (MAIN / "eval/all/freeze").is_dir(), reason="needs the registered evaluation records")
   126	def test_r1_menu_candidates_are_rerun_under_churn_on_five_training_seeds(tmp_path):
   127	    """Blocker 1: the copied menu candidates carry no-churn profits on the five training seeds; under churn they must be
   128	    run again, so every selection score equals a fresh churn evaluation of that candidate."""
   129	    from sim.cell import SeedCache, run_focal
   130	    import sim.reference as REF
   131	    j, root = _full_churn_job(); C.R.install_salt(root, tmp_path); C.install()
   132	    C.F.copy_inputs(MAIN / "eval/all", tmp_path, C.F.inputs(MAIN / "eval/all", [j]))
   133	    cands, _, _ = C.R.menu(j, tmp_path, C.F.CUTS, C.F.H4_EXCLUDED)
   134	    cell = C.R.train_cell(j); assert len(cell.seeds) == 5 and cell.others
   135	    known = [c for c in cands if c.known_normalized is not None and len(c.known_normalized) == 5 and c.name != "abstain"]
   136	    assert known                                                                              # the defect needs cached values to exist
   137	    differ = 0                                                                                # names repeat across families: one candidate at a time
   138	    for c in known:
   139	        want = float(run_focal(cell, c.policy_factory, SeedCache()).normalized.mean())
   140	        assert C.R.select_reference(cell, [c], SeedCache()).scores[c.name] == want
   141	        differ += REF.select_reference(cell, [c], SeedCache()).scores[c.name] != want
   142	    assert differ > 0
