   198	def pool_markets(by_market: dict, cat: str) -> list:
   199	    """Equal market weights: per age bin, the mean of the market shares over the markets where the share is available."""
   200	    nb = len(next(iter(by_market.values()))[cat]); res = []
   201	    for b in range(nb):
   202	        v = [m[cat][b]["share"] for m in by_market.values() if m[cat][b]["share"] is not None]
   203	        res.append({"share": (sum(v) / len(v) if v else None), "markets": len(v)})
   204	    return res
