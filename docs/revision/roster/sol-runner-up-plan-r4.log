     1	"""Shared descriptive analysis of the follow-up runs in docs/revision/followup2 (exploratory, after the report).
     2	
     3	The registered Q1 machinery used studentized bootstrap intervals with calibrated tails and Holm; these follow-up runs
     4	are not registered, so they use a nominal paired percentile bootstrap (seeds resampled within each market, the same
     5	resampled indices for both rules, equal market weights) and apply the registered Q1 category rules to that nominal
     6	interval, labelled exploratory. d = g(comparator) - g(R3); positive means R3 leaves the lower gain."""
     7	from __future__ import annotations
     8	
     9	import numpy as np
    10	
    11	MARGIN = 0.05                                       # the registered Q1 margin (design 9.3)
    12	RESAMPLES, SEED = 9999, 0
    13	SCOPE = ("nominal paired percentile bootstrap over seeds, conditional on these markets and the selected policies and references; "
    14	         "no search or market-sampling uncertainty; no registered calibration or Holm guarantee")
    15	
    16	
    17	def pooled_paired(a: dict, b: dict, resamples: int = RESAMPLES, seed: int = SEED, level: float = 0.95) -> dict:
    18	    """`a`, `b`: market -> per-seed gains on the same seeds in the same order. Pooled = mean of the market means."""
    19	    markets = sorted(a)
    20	    if sorted(b) != markets:
    21	        raise ValueError("the two rules cover different markets")
    22	    diffs = {}
    23	    for m in markets:
    24	        x, y = np.asarray(a[m], float), np.asarray(b[m], float)
    25	        if x.shape != y.shape:
    26	            raise ValueError(f"{m}: unequal seed counts")
    27	        diffs[m] = x - y
    28	    rng = np.random.default_rng(seed); per = {m: np.empty(resamples) for m in markets}
    29	    for i in range(resamples):
    30	        for m in markets:
    31	            d = diffs[m]; per[m][i] = d[rng.integers(0, len(d), len(d))].mean()
    32	    reps = np.mean([per[m] for m in markets], axis=0)
    33	    q = (1 - level) / 2; iv = lambda r: [float(np.quantile(r, q)), float(np.quantile(r, 1 - q))]
    34	    return {"markets": {m: float(diffs[m].mean()) for m in markets}, "market_intervals": {m: iv(per[m]) for m in markets},
    35	            "estimate": float(np.mean([diffs[m].mean() for m in markets])), "interval": iv(reps), "resamples": resamples, "seed": seed, "level": level,
    36	            "scope": SCOPE}
    37	
    38	
    39	def q1_category(interval) -> str:
    40	    """The registered Q1 categories (design 9.3), applied descriptively to a nominal interval."""
    41	    lo, hi = interval
    42	    if lo > MARGIN:
    43	        return "materially lower (R3 lower)"
    44	    if hi < -MARGIN:
    45	        return "materially lower (comparator lower)"
    46	    if -MARGIN <= lo and hi <= MARGIN:
    47	        if lo > 0:
    48	            return "equivalent, direction R3 lower"
    49	        if hi < 0:
    50	            return "equivalent, direction comparator lower"
    51	        return "equivalent"
    52	    if lo > 0 or hi < 0:
    53	        return "ordered, size not established"
    54	    return "inconclusive"
"""Cost estimates of Run A (draft 3) and Run B (draft 3) from experiments/v2/benchmark/timings.json.
Usage (repository root): python3 docs/revision/followup2/cost_estimate.py"""
import json

t = json.load(open("experiments/v2/benchmark/timings.json"))["timings"]; u = 0.108; pod = 0.56; prep = 0.3
ev = lambda k: t["eval160"][k] * 200 / 160
h = lambda s: s / 3600
# Run A
a_core = 6 * (t["d2h3_cell"] + ev("profit") + t["doubling"] + t["x7_cell"] + ev("x7") + t["doubling_x7"] + t["reference"])
gate_a = t["d2h3_cell"] + ev("profit")                                   # the reset driver's reproduction gate on the pod
crit_a = t["d2h3_cell"] + t["x7_cell"] + 6 * t["reference"] + ev("x7") + t["doubling_x7"]   # six serial reference calls
billed_a = (h(gate_a) + h(crit_a) + prep) * pod
est_a = max(h(a_core) * u + h(gate_a) * u, billed_a)
print(f"A: {h(a_core):.2f} core-h ({h(a_core) * u:.2f} USD at 0.108); gate {h(gate_a):.2f} h; billed path {h(gate_a) + h(crit_a) + prep:.2f} h = {billed_a:.2f} USD; "
      f"estimate {est_a:.2f}, x1.25 {est_a * 1.25:.2f}; stop cap and reservation 3.00")
# Run B (draft 3): 10 D2+H3 and 9 X7-SC cells (14 flagged + 5 nesting X7-SC cells), up to 3 rounds, each round with
# its held-out evaluation allowance; the gate cells (headline X7-SC, fresh D2+H3) run serially first
rd = lambda x7: (t["doubling_x7"] if x7 else t["doubling"]) + ev("profit")
b_core = 3 * (10 * rd(False) + 9 * rd(True))
gate_b = rd(True) + rd(False)
crit_b = 3 * rd(True)                                                     # 16 workers: the 9 X7-SC cells start first
billed_b = (h(gate_b) + h(crit_b) + prep) * pod
est_b = max(h(b_core + gate_b) * u, billed_b)
print(f"B: {h(b_core):.2f} core-h ({h(b_core) * u:.2f} USD at 0.108); gate {h(gate_b):.2f} h serial; billed path {h(gate_b) + h(crit_b) + prep:.2f} h = {billed_b:.2f} USD; "
