# One creation request at a time (create_one.py, no hidden retries). Before EVERY request: reconciliation must succeed (no
# untracked pod), the watchdog must allow creation, and the soft deadline must be ahead. An ambiguous answer is followed by
# a 30 s wait and reconciliation before the next request; an unambiguous refusal (no capacity) tries the next flavor.
req=0; tries=0
while [ $tries -lt 3 ] && [ $req -lt 36 ]; do
  $PY podctl.py reconcile $NAME 600 || { state="RECONCILE FAILED BEFORE REQUEST $((req+1))"; exit 1; }
  $PY podctl.py may-create $NAME $hard || { state="CREATION BLOCKED (hard deadline)"; exit 1; }
  [ "$(date +%s)" -lt "$soft" ] || { state="SOFT DEADLINE BEFORE START"; exit 1; }
  [ "$tfirst" -gt 0 ] || tfirst=$(date +%s)
  out=$(tmo 120 $PY create_one.py $NAME $(( req % 12 )) 2>/dev/null | tail -n 1); req=$((req+1))
  id=$(echo "$out" | $PY -c 'import sys,json; print(json.loads(sys.stdin.read()).get("id",""))' 2>/dev/null)
  amb=$(echo "$out" | $PY -c 'import sys,json; d=json.loads(sys.stdin.read() or "{}"); print(1 if d.get("ambiguous", True) else 0)' 2>/dev/null || echo 1)
  if [ -z "$id" ]; then
    if [ "$amb" = 1 ]; then echo "$(date +%H:%M) ambiguous creation answer; reconciling"; sleep 30; $PY podctl.py reconcile $NAME 600 || { state="RECONCILE FAILED AFTER AN AMBIGUOUS ANSWER"; exit 1; }; tries=$((tries+1)); fi
    continue
  fi
  v=16; echo "$id $(date +%s) start" >> "$ATT"
  cph=$(tmo 60 $PY runpod.py list 2>/dev/null | $PY -c "import sys,json; print(next((p.get('costPerHr') or 0) for p in json.load(sys.stdin) if p['id']=='$id'))" 2>/dev/null)
  $PY -c "import sys; sys.exit(0 if 0<float('${cph:-0}' or 0)<=float('$MAXCPH') else 1)" || { state="PRICE ${cph:-unknown} NOT IN (0, $MAXCPH]"; exit 1; }
  a0=$(date +%s); up=""; while [ "$(date +%s)" -lt "$soft" ] && [ $(( $(date +%s) - a0 )) -lt 240 ]; do r=$(tmo 30 $PY runpod.py ssh $id 'echo up' 2>/dev/null | head -c 2); [ "$r" = up ] && { up=1; break; }; sleep 10; done
  [ -n "$up" ] && break
  echo "$(date +%H:%M) $id unreachable; deleting"; $PY podctl.py delete $id 600 || { state="UNREACHABLE POD NOT DELETED"; exit 1; }; echo "$id $(date +%s) deleted" >> "$ATT"; id=""; tries=$((tries+1))
done
[ -z "$id" ] && { state="NO POD"; exit 1; }
echo "$(date +%H:%M) pod $id ($v vCPU, $cph USD/h): soft stop in $(( soft - $(date +%s) ))s, hard stop in $(( hard - $(date +%s) ))s (cap $CAP USD)"
