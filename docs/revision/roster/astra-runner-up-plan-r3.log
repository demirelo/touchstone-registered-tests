"""Shared descriptive analysis of the follow-up runs in docs/revision/followup2 (exploratory, after the report).

The registered Q1 machinery used studentized bootstrap intervals with calibrated tails and Holm; these follow-up runs
are not registered, so they use a nominal paired percentile bootstrap (seeds resampled within each market, the same
resampled indices for both rules, equal market weights) and apply the registered Q1 category rules to that nominal
interval, labelled exploratory. d = g(comparator) - g(R3); positive means R3 leaves the lower gain."""
from __future__ import annotations

import numpy as np

MARGIN = 0.05                                       # the registered Q1 margin (design 9.3)
RESAMPLES, SEED = 9999, 0
SCOPE = ("nominal paired percentile bootstrap over seeds, conditional on these markets and the selected policies and references; "
         "no search or market-sampling uncertainty; no registered calibration or Holm guarantee")


def pooled_paired(a: dict, b: dict, resamples: int = RESAMPLES, seed: int = SEED, level: float = 0.95) -> dict:
    """`a`, `b`: market -> per-seed gains on the same seeds in the same order. Pooled = mean of the market means."""
    markets = sorted(a)
    if sorted(b) != markets:
        raise ValueError("the two rules cover different markets")
    diffs = {}
    for m in markets:
        x, y = np.asarray(a[m], float), np.asarray(b[m], float)
        if x.shape != y.shape:
            raise ValueError(f"{m}: unequal seed counts")
        diffs[m] = x - y
    rng = np.random.default_rng(seed); per = {m: np.empty(resamples) for m in markets}
    for i in range(resamples):
        for m in markets:
            d = diffs[m]; per[m][i] = d[rng.integers(0, len(d), len(d))].mean()
    reps = np.mean([per[m] for m in markets], axis=0)
    q = (1 - level) / 2; iv = lambda r: [float(np.quantile(r, q)), float(np.quantile(r, 1 - q))]
    return {"markets": {m: float(diffs[m].mean()) for m in markets}, "market_intervals": {m: iv(per[m]) for m in markets},
            "estimate": float(np.mean([diffs[m].mean() for m in markets])), "interval": iv(reps), "resamples": resamples, "seed": seed, "level": level,
            "scope": SCOPE}


def q1_category(interval) -> str:
    """The registered Q1 categories (design 9.3), applied descriptively to a nominal interval."""
    lo, hi = interval
    if lo > MARGIN:
        return "materially lower (R3 lower)"
    if hi < -MARGIN:
        return "materially lower (comparator lower)"
    if -MARGIN <= lo and hi <= MARGIN:
        if lo > 0:
            return "equivalent, direction R3 lower"
        if hi < 0:
            return "equivalent, direction comparator lower"
        return "equivalent"
    if lo > 0 or hi < 0:
        return "ordered, size not established"
    return "inconclusive"
"""Cost estimates of Run A (draft 3) and Run B (draft 3) from experiments/v2/benchmark/timings.json.
Usage (repository root): python3 docs/revision/followup2/cost_estimate.py"""
import json

t = json.load(open("experiments/v2/benchmark/timings.json"))["timings"]; u = 0.108; pod = 0.56; prep = 0.3
ev = lambda k: t["eval160"][k] * 200 / 160
h = lambda s: s / 3600
# Run A
a_core = 6 * (t["d2h3_cell"] + ev("profit") + t["doubling"] + t["x7_cell"] + ev("x7") + t["doubling_x7"] + t["reference"])
gate_a = t["d2h3_cell"] + ev("profit")                                   # the reset driver's reproduction gate on the pod
crit_a = t["d2h3_cell"] + t["x7_cell"] + 6 * t["reference"] + ev("x7") + t["doubling_x7"]   # six serial reference calls
billed_a = (h(gate_a) + h(crit_a) + prep) * pod
est_a = max(h(a_core) * u + h(gate_a) * u, billed_a)
print(f"A: {h(a_core):.2f} core-h ({h(a_core) * u:.2f} USD at 0.108); gate {h(gate_a):.2f} h; billed path {h(gate_a) + h(crit_a) + prep:.2f} h = {billed_a:.2f} USD; "
      f"estimate {est_a:.2f}, x1.25 {est_a * 1.25:.2f}; stop cap and reservation 3.00")
# Run B (draft 3): 10 D2+H3 and 9 X7-SC cells (14 flagged + 5 nesting X7-SC cells), up to 3 rounds, each round with
# its held-out evaluation allowance; the gate cells (headline X7-SC, fresh D2+H3) run serially first
rd = lambda x7: (t["doubling_x7"] if x7 else t["doubling"]) + ev("profit")
b_core = 3 * (10 * rd(False) + 9 * rd(True))
gate_b = rd(True) + rd(False)
crit_b = 3 * rd(True)                                                     # 16 workers: the 9 X7-SC cells start first
billed_b = (h(gate_b) + h(crit_b) + prep) * pod
est_b = max(h(b_core + gate_b) * u, billed_b)
print(f"B: {h(b_core):.2f} core-h ({h(b_core) * u:.2f} USD at 0.108); gate {h(gate_b):.2f} h serial; billed path {h(gate_b) + h(crit_b) + prep:.2f} h = {billed_b:.2f} USD; "
      f"estimate {est_b:.2f}, x1.25 {est_b * 1.25:.2f}; stop cap and reservation 4.25")
"""Run A (docs/revision/followup2/runner-up-plan.md): the full-budget runner-up comparator C-thr(K=12) on the six fresh
markets at rho 0.2, under D2+H3 and X7-SC, with the frozen stage functions of scripts/revision_v2.py.

The frozen code identifies a rule by its label and reads its parameters from `params["cred"]`. The runner-up therefore
runs under the label "C*" with the runner-up's credibility parameters, in its own output directory; its records differ
from the registered C* records by `rule_params_sha256`, and `label.json` names the rule. The driver refuses an output
that contains a copy of a registered C* record. Its reference is selected by the frozen reference stage from the
registered C* menu construction: its own D2+H3 and X7-SC searches plus the cuts-3 bank of the other rules' registered
winners (the registered C* winner is excluded, as C* excluded itself).

Order: bank inputs (hash-checked against the original freeze), preflight, searches (D2+H3, then X7-SC), references,
the follow-up freeze, acceptance, evaluation, acceptance, doubling, analysis, inventory. Exploratory; no registered
estimate or decision changes."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(ROOT / "scripts")); sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(HERE.parent / "followup")); sys.path.insert(0, str(HERE))

import common as C  # noqa: E402
