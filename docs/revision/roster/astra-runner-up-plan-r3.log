"""Shared guards of the follow-up runs (internal review round 1 of both plans)."""
import json
import sys
from pathlib import Path

import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import guards as G  # noqa: E402
from sim.records_v2 import read, write  # noqa: E402


def test_a_locked_settings_override_is_refused(monkeypatch):
    monkeypatch.setenv("TOUCHSTONE_LOCKED", "/tmp/other.yaml")
    with pytest.raises(SystemExit, match="TOUCHSTONE_LOCKED"):
        G.pin_settings()
    monkeypatch.delenv("TOUCHSTONE_LOCKED")
    G.pin_settings()                                     # locked.yaml and the manifest equal protocol-v2


def test_budgets_must_equal_the_frozen_records(tmp_path):
    write(tmp_path / "rec.json", {"provenance": {"budget": [5, 300, 5, 200]}})
    G.check_budget({"id": "x", "budget": [5, 300, 5, 200]}, tmp_path / "rec.json")
    with pytest.raises(SystemExit, match="budget"):
        G.check_budget({"id": "x", "budget": [5, 150, 5, 200]}, tmp_path / "rec.json")


def test_saved_results_are_reused_only_under_the_same_binding(tmp_path):
    b = G.binding(inputs_sha="i", provenance={"id": "x"}, smoke=False, settings={"max_rounds": 3}, driver_sha="d")
    p = tmp_path / "r.json"
    assert G.reusable(p, b) is False                                            # nothing saved
    write(p, {"binding": b, "x": 1}); assert G.reusable(p, b) is True
    for k, v in (("smoke", True), ("settings", {"max_rounds": 2}), ("inputs_sha", "j"), ("driver_sha", "e")):
        with pytest.raises(SystemExit, match="binding"):
            G.reusable(p, {**b, k: v})


def test_the_inventory_names_this_driver_its_helpers_and_the_run(tmp_path):
    (tmp_path / "a.json").write_text("{}")
    inv = G.inventory(tmp_path, deviations=["d1"], files={"driver": Path(G.__file__)}, args=["--x", "1"])
    assert inv["deviations"] == ["d1"] and inv["files"]["driver"] == G.sha_file(Path(G.__file__)) and inv["args"] == ["--x", "1"]
    assert "a.json" in inv["records"] and "inventory.json" not in inv["records"] and "reset_followup_v2.py" in inv["files"]
    assert {"python", "numpy", "scipy", "cma", "blas", "cpu"} <= set(inv["environment"]) and "driver_sha256" not in inv["environment"]


def test_cost_stop_between_stages_never_kills(tmp_path):
    clock = iter([0.0, 3600.0 * 5]).__next__
    c = G.CostStop(cap_usd=3.0, usd_per_hour=0.56, started=0.0, clock=clock)
    assert c.allow("search", 1.0) is True                                      # 0 h spent + 1 h at 0.56
    assert c.allow("doubling", 1.0) is False and c.stopped == "doubling"        # 5 h = 2.80 USD + 0.56 > 3.00
    assert c.report()["stopped_before"] == "doubling"


def test_evidence_files_must_report_a_pass(tmp_path):
    write(tmp_path / "ok.json", {"pass": True}); write(tmp_path / "bad.json", {"pass": False})
    G.check_evidence([tmp_path / "ok.json"])
    with pytest.raises(SystemExit, match="evidence"):
        G.check_evidence([tmp_path / "ok.json", tmp_path / "bad.json"])
    with pytest.raises(SystemExit, match="evidence"):
        G.check_evidence([tmp_path / "missing.json"])


def test_finite_values_are_required():
    assert G.finite([0.1, 2], {"a": 0.3}) and not G.finite([0.1, float("nan")]) and not G.finite({"a": float("inf")})


def test_a_binding_survives_its_json_round_trip(tmp_path):
    b = G.binding(inputs_sha="i", provenance={"seeds": (1, 2)}, smoke=True, settings={"markets": ("fresh0",)}, driver_sha="d")
    write(tmp_path / "r.json", {"binding": b}); assert G.reusable(tmp_path / "r.json", G.binding("i", {"seeds": (1, 2)}, True, {"markets": ("fresh0",)}, "d"))


# ---- round 2: bound evidence, spending inputs ----

def _gate(path, cell, site, env, ok=True, smoke=False, inputs="i", driver="d"):
    write(path, {"stage": "convergence gate", "cell": cell, "pass": ok, "site": site, "environment": env,
                 "binding": {"smoke": smoke, "inputs_sha": inputs, "driver_sha": driver}})


def test_gate_evidence_needs_both_cells_from_the_mac_and_this_machine(tmp_path):
    here, mac = G.environment(), {"cpu": "Apple M3", "machine": "arm64"}
    cells = {"a": {"inputs_sha": "i", "driver_sha": "d"}, "b": {"inputs_sha": "i", "driver_sha": "d"}}
    ps = []
    for c in cells:
        for site, env in (("mac", mac), ("pod", here)):
            p = tmp_path / f"{c}-{site}.json"; _gate(p, c, site, env); ps.append(p)
    G.check_gate_evidence(ps, cells)
    for drop in ps:                                                               # every one of the four is required
        with pytest.raises(SystemExit, match="evidence"):
            G.check_gate_evidence([p for p in ps if p != drop], cells)
    write(tmp_path / "x.json", {"pass": True})                                    # an unrelated passing file does not count
    with pytest.raises(SystemExit, match="evidence"):
        G.check_gate_evidence([ps[0], tmp_path / "x.json"], cells)
    for kw in ({"smoke": True}, {"inputs": "j"}, {"driver": "e"}, {"ok": False}):
        q = tmp_path / "bad.json"; _gate(q, "a", "pod", here, **kw)
        with pytest.raises(SystemExit, match="evidence"):
            G.check_gate_evidence([q] + [p for p in ps if p.name != "a-pod.json"], cells)
    q = tmp_path / "other-env.json"; _gate(q, "a", "pod", mac)                   # a pod record from another machine
    with pytest.raises(SystemExit, match="evidence"):
        G.check_gate_evidence([q] + [p for p in ps if p.name != "a-pod.json"], cells)


def test_reset_evidence_needs_a_mac_pass_and_an_identical_pod_pass_on_this_machine(tmp_path):
    drv = G.sha_file(G.HERE.parent / "followup" / "reset_followup_v2.py"); here = {**G.environment(), "driver_sha256": drv}
    def put(d, ok=True, ident=True, env=here):
        write(d / "gate.json", {"stage": "reproduction gate", "pass": ok, "identical": ident}); write(d / "inventory.json", {"environment": env})
        return d
    mac, pod = put(tmp_path / "mac", ident=False, env={"cpu": "Apple", "driver_sha256": drv}), put(tmp_path / "pod")
    G.check_reset_evidence(mac, pod)
    for bad in (put(tmp_path / "p1", ident=False), put(tmp_path / "p2", ok=False), put(tmp_path / "p3", env={**here, "cpu": "other"}),
                put(tmp_path / "p4", env={**here, "driver_sha256": "x"})):
        with pytest.raises(SystemExit, match="evidence"):
            G.check_reset_evidence(mac, bad)


def test_paid_runs_need_an_allocation_time_and_count_prior_spend():
    with pytest.raises(SystemExit, match="allocation"):
        G.paid_cost_stop(3.0, 0.56, started=None, prior_usd=0.0)
    with pytest.raises(SystemExit, match="rate"):
        G.paid_cost_stop(3.0, 0.0, started=0.0, prior_usd=0.0)
    c = G.paid_cost_stop(3.0, 0.56, started=100.0, prior_usd=2.9, clock=lambda: 100.0)
    assert c.allow("x", 0.1) is True and c.allow("y", 0.2) is False              # 2.9 failed-attempt spend + 0.112 vs + 0.224
"""Run A (docs/revision/followup2/runner-up-plan.md): the full-budget runner-up comparator C-thr(K=12) on the fresh markets."""
import json
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import runnerup_v2 as A  # noqa: E402
from sim.records_v2 import read, sha_file, write  # noqa: E402

MAIN = Path("/Users/oemer.demirel/Projects/touchstone/results/v2")
CTX = "fresh0@rho0.2"


def test_the_runner_up_is_c_thr_12_from_the_recheck_log():
    assert A.runner_up_cred() == {"variant": "thr", "K": 12, "M": None}
    p = A.runner_up_params({"cred": {"variant": "mem", "K": 6, "M": 20}, "tuned": {}})
    assert p["cred"] == {"variant": "thr", "K": 12, "M": None} and p["tuned"] == {}


def _src(tmp_path, rules=("F000", "F111", "C*", "C*/S0")):
    src = tmp_path / "src"; recs = {}
    for fam in ("D2+H3", "X7-SC"):
        for r in rules:
            rid = A.R.cell_id(CTX, r, fam, "profit"); write(A.R.path_of(src, rid), {"stage": "search", "attack": {"best_knobs": {}}}); recs[rid] = sha_file(A.R.path_of(src, rid))
    write(A.R.path_of(src, f"freeze/{CTX}"), {"stage": "freeze", "cuts": 3, "h4_excluded": False, "records": recs})
    return src


def test_bank_inputs_are_the_other_rules_winners_never_the_registered_cstar(tmp_path, monkeypatch):
    monkeypatch.setattr(A.MAN, "bank_rules", lambda ctx, fam, cuts, h4: ["F000", "F111", "C*", "C*/S0"])
    src = _src(tmp_path); need = A.bank_inputs(src, [CTX])
    assert len(need) == 6 and not any("|C*|" in r for r in need) and all(need[r] == sha_file(A.R.path_of(src, r)) for r in need)


def test_bank_inputs_refuse_a_record_missing_from_the_original_freeze(tmp_path, monkeypatch):
    monkeypatch.setattr(A.MAN, "bank_rules", lambda ctx, fam, cuts, h4: ["F000", "F010"])
    with pytest.raises(SystemExit, match="freeze"):
        A.bank_inputs(_src(tmp_path), [CTX])


def test_a_copy_of_a_registered_cstar_record_in_the_output_is_refused(tmp_path, monkeypatch):
    src = _src(tmp_path); out = tmp_path / "out"; rid = A.R.cell_id(CTX, "C*", "D2+H3", "profit")
    A.check_no_registered_cstar(src, out)
    s0 = A.R.cell_id(CTX, "C*/S0", "D2+H3", "profit"); q0 = A.R.path_of(out, s0); q0.parent.mkdir(parents=True)
    q0.write_bytes(A.R.path_of(src, s0).read_bytes()); A.check_no_registered_cstar(src, out)           # a C*/S0 bank copy is allowed
    q = A.R.path_of(out, rid); q.write_bytes(A.R.path_of(src, rid).read_bytes())
    with pytest.raises(SystemExit, match="registered C"):
        A.check_no_registered_cstar(src, out)


def test_pairing_with_the_registered_cstar_reference_except_the_rule_parameters(tmp_path):
    prov = {"runner_sha256": "r", "salt_sha256": "s", "cfg_sha256": "c", "root": "h", "seeds_train": [1], "seeds_val": [2], "seeds_eval": [3],
            "rule_params_sha256": "registered", "context": CTX, "rule": "C*"}
    src = tmp_path / "src"; write(A.R.path_of(src, f"reference/{CTX}/C*"), {"provenance": prov})
    job = {"id": f"{CTX}|C*|D2+H3|profit", "context": CTX, "provenance": {**prov, "rule_params_sha256": "runner-up"}}
    A.check_pairing_rule(src, [job])
    with pytest.raises(SystemExit, match="registered C"):
        A.check_pairing_rule(src, [{**job, "provenance": prov}])                  # same parameters: this would be C* itself
    with pytest.raises(SystemExit, match="root"):
        A.check_pairing_rule(src, [{**job, "provenance": {**job["provenance"], "root": "x"}}])


def _eval_set(out, src, ru, cs, r3, ru_d=None, cs_d=None, r3_d=None, markets=("fresh0", "fresh1")):
    rep = {"doubling": {}}
    for m in markets:
        for base, rule, g, gd in ((out, "C*", ru, ru_d), (src, "F111", r3, r3_d), (src, "C*", cs, cs_d)):
            rid = f"{m}@rho0.2|{rule}|D2+H3|profit"; write(A.R.eval_path(base, rid), {"seeds": [1, 2], "gain": g})
            held = {"seeds": [1, 2], "gain": gd if gd is not None else g, "knobs": {}}
            if base == out:
                write(out / "doubling" / (A.R._safe(rid) + ".json"), {"heldout": held, "attack_change": 0.001, "reference_change": 0.0, "incomplete": False})
            else:
                rep["doubling"][rid] = {"heldout": held}
    return rep


def test_analysis_has_base_and_doubled_contrasts_and_scores_the_expectation(tmp_path):
    out, src = tmp_path / "out", tmp_path / "src"
    rep = _eval_set(out, src, ru=[0.10, 0.12], cs=[0.15, 0.15], r3=[0.08, 0.08], ru_d=[0.11, 0.13], cs_d=[0.16, 0.16])
    got = A.analysis(out, src, rep, ("fresh0", "fresh1"), fams=("D2+H3",), resamples=199)["D2+H3"]
    assert got["base"]["runner_up_minus_r3"]["estimate"] == pytest.approx(0.03) and got["base"]["cstar_minus_runner_up"]["estimate"] == pytest.approx(0.04)
    assert got["base"]["cstar_minus_r3"]["estimate"] == pytest.approx(0.07) and got["doubled"]["cstar_minus_runner_up"]["estimate"] == pytest.approx(0.04)
    assert got["base"]["runner_up_minus_r3"]["category"] == A.C.q1_category(got["base"]["runner_up_minus_r3"]["interval"])
    assert got["expectation"] == {"statement": A.EXPECTATION, "base": 0.04 > 0, "doubled": True, "score": "met"} or got["expectation"]["score"] == "met"
    assert set(got["flags"]["fresh0"]) == {"attack_change", "reference_change", "incomplete"} and got["label"].startswith("exploratory")


