"""Tests of the reset block (docs/revision/reset-experiment-plan.md, draft 5, sections 5 and 6), written before the code."""
import json
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import reset_block as RB  # noqa: E402

M6 = tuple(f"fresh{i}" for i in range(6))


def _cells(i_b3=0.3, i_r3=0.01, i_c=0.05, g_r3_d2h3=0.05, g_r3_d2=0.03, n=40, noise=0.0, seed=0):
    """Synthetic per-seed gains: D2+H3 gains are D2 gains plus I; B3-R3 gap under D2 is 0.01 by construction."""
    rng = np.random.default_rng(seed); cells = {}
    for m in M6:
        e = rng.normal(0, noise, n) if noise else np.zeros(n)
        d2 = {"F111": g_r3_d2 + e, "F000": g_r3_d2 + 0.01 + e, "C*": g_r3_d2 + 0.005 + e}
        d2h3 = {"F111": d2["F111"] + i_r3, "F000": d2["F000"] + i_b3, "C*": d2["C*"] + i_c}
        cells[m] = {"D2+H3": d2h3, "D2": d2}
    return cells


def test_point_estimates_of_i_contrasts_gaps_and_share():
    s = RB.statistics(_cells())
    assert s["I"]["F000"]["pooled"] == pytest.approx(0.3) and s["I"]["F111"]["pooled"] == pytest.approx(0.01)
    assert s["contrast"]["B3-R3"]["pooled"] == pytest.approx(0.29) and s["contrast"]["C*-R3"]["pooled"] == pytest.approx(0.04)
    assert s["G"]["D2"]["pooled"] == pytest.approx(0.01) and s["G"]["D2+H3"]["pooled"] == pytest.approx(0.30)
    assert s["S"]["pooled"] == pytest.approx(1 - 0.01 / 0.30)


def test_pooled_is_the_equal_weight_mean_of_market_means():
    c = _cells(); c["fresh0"]["D2+H3"]["F000"] = c["fresh0"]["D2+H3"]["F000"] + 0.6   # I(B3) = 0.9 at fresh0 only
    s = RB.statistics(c)
    assert s["I"]["F000"]["markets"]["fresh0"] == pytest.approx(0.9)
    assert s["I"]["F000"]["pooled"] == pytest.approx((0.9 + 5 * 0.3) / 6)


def test_share_undefined_when_the_denominator_lower_bound_is_at_or_below_005():
    c = _cells(i_b3=0.04, i_r3=0.01, noise=0.02)          # pooled G(D2+H3) = 0.04: lower bound below 0.05
    r = RB.analyse(c, b=999, seed=1)
    assert r["S"]["pooled"]["value"] is None and r["S"]["pooled"]["reason"].startswith("not defined")
    assert r["G"]["D2+H3"]["pooled"]["estimate"] == pytest.approx(0.04)  # the gaps are reported anyway


def test_share_defined_and_not_clipped():
    c = _cells(i_b3=0.3, i_r3=0.01)
    for m in M6:                                           # G(D2) negative, so S > 1
        c[m]["D2"]["F000"] = c[m]["D2"]["F111"] - 0.05; c[m]["D2+H3"]["F000"] = c[m]["D2"]["F000"] + 0.3
    r = RB.analyse(c, b=199, seed=1)
    assert r["S"]["pooled"]["value"] > 1


def test_bootstrap_uses_the_same_seed_indices_for_every_rule_and_family_of_a_market():
    c = _cells(noise=0.05, seed=3)                         # identical noise in every rule and family of a market
    r = RB.analyse(c, b=499, seed=2)
    lo, hi = r["G"]["D2"]["pooled"]["ci95"]               # the shared noise cancels in a paired contrast
    assert hi - lo == pytest.approx(0.0, abs=1e-12)
    lo, hi = r["I"]["F000"]["pooled"]["ci95"]
    assert hi - lo == pytest.approx(0.0, abs=1e-12)


def test_bootstrap_is_reproducible_and_has_9999_resamples_by_default():
    assert RB.B == 9999
    c = _cells(noise=0.05, seed=4)
    for m in M6:                                           # break the pairing so intervals have width
        c[m]["D2"]["F111"] = c[m]["D2"]["F111"] + np.random.default_rng(9).normal(0, 0.05, 40)
    a, b = RB.analyse(c, b=299, seed=5), RB.analyse(c, b=299, seed=5)
    assert a["G"]["D2"]["pooled"]["ci95"] == b["G"]["D2"]["pooled"]["ci95"]
    lo, hi = a["G"]["D2"]["pooled"]["ci95"]
    assert lo < a["G"]["D2"]["pooled"]["estimate"] < hi


def test_market_sensitivity_sign_counts_and_leave_one_out_share():
    c = _cells(); c["fresh2"]["D2+H3"]["F000"] = c["fresh2"]["D2"]["F000"] - 0.02     # I(B3) < I(R3) at fresh2
    r = RB.analyse(c, b=199, seed=1)
    assert r["sensitivity"]["signs"]["B3-R3"] == {"positive": 5, "n": 6}
    assert r["sensitivity"]["signs"]["C*-R3"] == {"positive": 6, "n": 6}
    loo = r["sensitivity"]["S_leave_one_out"]
    assert set(loo) == set(M6) and all(v["value"] is not None for v in loo.values())


def test_leave_one_out_has_its_own_five_market_gate():
    c = _cells(i_b3=0.3)
    for m in M6[1:]:                                       # only fresh0 carries a B3 - R3 gap under D2+H3
        c[m]["D2+H3"]["F000"] = c[m]["D2+H3"]["F111"] + 0.0
    r = RB.analyse(c, b=199, seed=1)
    assert r["sensitivity"]["S_leave_one_out"]["fresh0"]["value"] is None     # five markets left: no gap
    assert r["sensitivity"]["S_leave_one_out"]["fresh1"]["value"] is not None  # fresh0 kept: 0.30 / 5 = 0.06 > 0.05


def test_missing_cell_is_reported_not_imputed():
    c = _cells(); del c["fresh3"]["D2"]["C*"]
    r = RB.analyse(c, b=99, seed=1)
    assert "fresh3|C*|D2" in r["missing"]
    assert "fresh3" not in r["I"]["C*"]["markets"]


"""The reset block of the post-hoc analysis (docs/revision/reset-experiment-plan.md, draft 5, sections 5 and 6).

I(r, m) = mean over the evaluation seeds of g(D2+H3 winner) - g(D2 winner), both against the frozen reference of (r, m).
Rules: B3 = F000, R3 = F111, C*. Gaps G(fam) = g_B3 - g_R3 under one family. Share S = 1 - G(D2) / G(D2+H3), pooled,
reported only if the lower bound of pooled G(D2+H3) exceeds 0.05. Intervals: paired seed bootstrap, percentile 95%,
the same resampled seed indices for every rule and family of a market; pooled = equal-weight mean of the market means,
seeds resampled independently within each market. Descriptive; no test, no registered decision changes.
"""
from __future__ import annotations

import json
from pathlib import Path

import numpy as np

RULES = ("F000", "F111", "C*")
FAMS = ("D2+H3", "D2")
B = 9999
SEED = 20261109                       # fixed bootstrap seed (the plan's date of specification)
GATE = 0.05
CONTRASTS = {"B3-R3": ("F000", "F111"), "C*-R3": ("C*", "F111")}


def safe(rid: str) -> str:
    return rid.replace("|", "__").replace("/", "~").replace("*", "star")      # revision_v2._safe


def _read(p: Path):
    return json.loads(p.read_text()) if p.exists() else None


def _valid(src: dict, rid: str, n_seeds: int) -> np.ndarray:
    """Internal review r1: one-dimensional finite gains, one per seed, unique seeds, the expected seed count."""
    g = np.asarray(src["gain"], dtype=float); seeds = list(src["seeds"])
    if g.ndim != 1 or g.size != len(seeds) or len(seeds) != n_seeds:
        raise ValueError(f"{rid}: {g.size} gains for {len(seeds)} seeds (expected {n_seeds})")
    if len(set(seeds)) != len(seeds):
        raise ValueError(f"{rid}: duplicate seed identifiers")
    if not np.all(np.isfinite(g)):
        raise ValueError(f"{rid}: non-finite gain")
    return g


def load(eval_all, reset_dir, report: dict, markets, n_seeds: int = 200) -> dict:
    """Base and doubled per-seed gains, {version: {market: {family: {rule: array}}}}, plus the D2 doubling flags.
    Refuses if the seeds of a market differ between any rule, family or version (the pairing needs one seed list)."""
    base, dbl, flags = {m: {} for m in markets}, {m: {} for m in markets}, {}   # a market with no record stays, empty
    for m in markets:
        seeds = None
        for fam in FAMS:
            for rule in RULES:
                rid = f"{m}@rho0.2|{rule}|{fam}|profit"
                root = Path(eval_all) if fam == "D2+H3" else Path(reset_dir)
                r = _read(root / "evaluate" / (safe(rid) + ".json"))
                if fam == "D2+H3":
                    h = report.get("doubling", {}).get(rid)
                else:
                    d = _read(Path(reset_dir) / "doubling" / (safe(rid) + ".json")); h = d
                    if d is not None:
                        flags[f"{m}|{rule}|D2"] = {k: d[k] for k in ("attack_change", "reference_change", "incomplete")}
                for ver, src, store in (("base", r, base), ("doubled", (h or {}).get("heldout"), dbl)):
                    if src is None:
                        continue
                    if seeds is None:
                        seeds = list(src["seeds"])
                    elif list(src["seeds"]) != seeds:
                        raise ValueError(f"seeds of {rid} ({ver}) differ from the market's seed list")
                    store[m].setdefault(fam, {})[rule] = _valid(src, f"{rid} ({ver})", n_seeds)
    return {"base": base, "doubled": dbl, "flags": flags}


def _complete(cells: dict) -> tuple[dict, list]:
    """Markets with every rule and family, and the list of missing cells (reported, never imputed)."""
    ok, missing = {}, []
    for m, v in cells.items():
        miss = [f"{m}|{r}|{f}" for f in FAMS for r in RULES if r not in v.get(f, {})]
        missing += miss
        ok[m] = v
    return ok, missing


def _market_stats(v: dict, idx=None) -> dict:
    """Per-market means of the statistics for one market (optionally on resampled seed indices)."""
    g = {f: {r: (a if idx is None else a[idx]) for r, a in v.get(f, {}).items()} for f in FAMS}
    out = {}
    for r in RULES:
        if r in g["D2+H3"] and r in g["D2"]:
            out[("I", r)] = float(np.mean(g["D2+H3"][r] - g["D2"][r]))
    for name, (a, b) in CONTRASTS.items():
        if ("I", a) in out and ("I", b) in out:
            out[("C", name)] = out[("I", a)] - out[("I", b)]
    for f in FAMS:
        if "F000" in g[f] and "F111" in g[f]:
            out[("G", f)] = float(np.mean(g[f]["F000"] - g[f]["F111"]))
    return out


def _pool(per_market: dict, key, markets) -> float | None:
    xs = [per_market[m][key] for m in markets if key in per_market[m]]
    return float(np.mean(xs)) if xs and len(xs) == len(markets) else None


def _share(gd2, gd2h3):
    return None if gd2 is None or gd2h3 is None or gd2h3 == 0 else 1 - gd2 / gd2h3


def statistics(cells: dict) -> dict:
    """Point estimates: per market and pooled (pooled only over markets where the statistic exists in all of them)."""
    pm = {m: _market_stats(v) for m, v in cells.items()}; ms = tuple(cells)
    res = {"I": {}, "contrast": {}, "G": {}}
