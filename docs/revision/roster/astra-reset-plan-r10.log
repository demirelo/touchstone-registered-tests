     7	
     8	class Fake:
     9	    """A fake Runpod: pods by id -> name; `fail_list` listings fail; a pod in `stuck` survives `stuck[id]` deletes."""
    10	    def __init__(self, pods=None, fail_list=0, stuck=None):
    11	        self.pods = dict(pods or {}); self.fail_list = fail_list; self.stuck = dict(stuck or {}); self.t = 0.0; self.calls = []
    12	    def run(self, args, timeout=60):
    13	        self.calls.append(args[0]); self.t += 1
    14	        if args[0] == "list":
    15	            if self.fail_list > 0:
    16	                self.fail_list -= 1; return 1, ""
    17	            return 0, json.dumps([{"id": i, "name": n} for i, n in self.pods.items()])
    18	        if args[0] == "delete":
    19	            pid = args[1]
    20	            if self.stuck.get(pid, 0) > 0:
    21	                self.stuck[pid] -= 1
    22	            else:
    23	                self.pods.pop(pid, None)
    24	            return 0, "{}"
    25	        return 0, ""
    26	    def clock(self):
    27	        return self.t
    28	    def sleep(self, s):
    29	        self.t += max(s, 0.01)
    30	
