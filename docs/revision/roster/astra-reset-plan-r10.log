    53	def test_creation_is_blocked_after_the_hard_deadline_or_the_block_file(tmp_path):
    54	    assert C.may_create("n", 10, clock=lambda: 5, here=str(tmp_path))
    55	    assert not C.may_create("n", 10, clock=lambda: 11, here=str(tmp_path))
    56	    (tmp_path / "n.blocked").write_text("1")
    57	    assert not C.may_create("n", 10, clock=lambda: 5, here=str(tmp_path))
