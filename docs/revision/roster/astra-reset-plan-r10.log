    32	def test_a_failed_listing_is_never_an_empty_list():
    33	    f = Fake({"a": "ts-r-x"}, fail_list=1)
    34	    assert C.list_pods(f.run) is None and C.list_pods(f.run) == [{"id": "a", "name": "ts-r-x"}]
    35	
    36	
    37	def test_delete_is_verified_and_bounded_by_elapsed_time():
    38	    f = Fake({"a": "n"}, stuck={"a": 2})
    39	    assert C.delete_verified("a", 100, f.run, f.clock, f.sleep) and "a" not in f.pods
    40	    g = Fake({"a": "n"}, stuck={"a": 10**6})
    41	    assert not C.delete_verified("a", 50, g.run, g.clock, g.sleep) and g.t < 50 + 20     # stops by elapsed time
    42	
    43	
    44	def test_reconcile_fails_closed_on_listing_failures_and_survivors():
    45	    f = Fake({"a": "ts-r-x", "keep": "ts-r-x", "other": "else"}, fail_list=3)
    46	    assert C.reconcile("ts-r-x", "keep", 600, f.run, f.clock, f.sleep) and set(f.pods) == {"keep", "other"}
    47	    g = Fake({"a": "ts-r-x"}, fail_list=10**6)                                          # listing never works
    48	    assert not C.reconcile("ts-r-x", "", 100, g.run, g.clock, g.sleep)
