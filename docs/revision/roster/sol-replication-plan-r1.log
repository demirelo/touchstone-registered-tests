    status, passed = final_status(rounds, outcome, min_rounds)
    res = {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": rounds, "status": status,
           "passed_round": passed, "round1_gate": gate if gate is not None else "not compared (smoke)", "claim": CLAIM,
           "frozen_best_f": float(rec["attack"]["best_f"]), "embedded_doubled_d2h3": emb is not None, "min_rounds": min_rounds,
           "cost": stopper.report() if stopper else None}
    if outcome != "round-1 mismatch":
        held = R.gain_fields(R.eval_cell(job), fam, prev.best_knobs, frozen_ref, SeedCache())
        res.update(place_heldout(status, {"knobs": dict(prev.best_knobs), "seeds": list(R.eval_cell(job).seeds), **held}))
    return res


def restart_hours(hs: list) -> dict:
    """Hours a restart needs for cells of these worst-case hours on 1 to 16 workers: longest first onto the least-loaded
    worker, plus 0.1 h shutdown, rounded up to 0.01 h (Sol and Astra, rerun review r1: not a fixed estimate)."""
    import math
    out = {}
    for w in range(1, 17):
        load = [0.0] * w
        for h in sorted(hs, reverse=True):
            load[load.index(min(load))] += h
        out[str(w)] = math.ceil((max(load) + 0.1) * 100 - 1e-6) / 100
    return out


def _run_and_save(fn, x: tuple, dest, extra: dict) -> None:
    """In the worker: run one cell and write its record (atomic) before anything goes back to the parent, so a sibling's
    death cannot discard a finished result in transit (Sol and Astra, rerun review r1)."""
    write(dest, {**fn(*x), **extra})


def run_cells(fn, todo: list, args: list, workers: int, dests: list, extras: list) -> tuple:
    """Run the cells, each in a worker process (also with one worker: a kill must not take the driver), and let each worker
    save its own record the moment the cell ends. Run B lost all 17 cells to one killed worker because results were written
    only after every cell ended. A lost worker breaks the pool (at submission or later); every cell with no record on disk
    is lost, and saved cells are skipped on restart (guards.reusable). An ordinary exception in a cell is not a lost
    worker: it is returned with its message and never restarted (Sol and Astra, rerun review r2). Returns (lost, failed)."""
    from concurrent.futures import ProcessPoolExecutor, wait
    from concurrent.futures.process import BrokenProcessPool
    with ProcessPoolExecutor(max_workers=max(1, workers)) as ex:
        futs = []
        try:
            for x, d, e in zip(args, dests, extras):
                futs.append(ex.submit(_run_and_save, fn, x, d, e))
        except BrokenProcessPool:
            pass
        wait(futs)                                               # a broken pool fails the rest; the disk says what is saved
    failed = {}
    for j, f in zip(todo, futs):
        e = f.exception()
        if e is not None and not isinstance(e, BrokenProcessPool):
            failed[j["id"]] = f"{type(e).__name__}: {e}"
    return [j["id"] for j, d in zip(todo, dests) if read(d) is None and j["id"] not in failed], failed
