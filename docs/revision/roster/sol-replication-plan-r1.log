def _net_eff(results) -> list:
    """Net efficiency per seed as the frozen reference module computes it."""
    from sim.reference import _net
    return list(_net(results))


# ---- doubling ----------------------------------------------------------------------------------------------------------

def doubling_report(kind: str, old: dict, new: dict) -> dict:
    """Changes in the objective's units (design 6.5): profit (attack and reference normalised profit), welfare (gross
    efficiency, lower is a better attack), w1 (efficiency and feasibility), coalition (objective)."""
    rep = {"kind": kind}
    if kind == "profit":
        rep["attack_change"] = float(new["attack_f"] - old["attack_f"]); rep["reference_change"] = float(new["ref_f"] - old["ref_f"])
        changes = [rep["attack_change"], rep["reference_change"]]
    elif kind in ("welfare", "w1"):
        rep["efficiency_change"] = float(old["eff"] - new["eff"]) if old.get("eff") is not None and new.get("eff") is not None else 0.0
        changes = [rep["efficiency_change"]]
        if kind == "w1":
            rep["feasibility_transition"] = bool(old.get("feasible") is False and new.get("feasible") is True)
    elif kind == "coalition":
        rep["objective_change"] = float(new["f"] - old["f"]); changes = [rep["objective_change"]]
    else:
        raise ValueError(kind)
    rep["incomplete"] = bool(any(c >= THRESHOLD - 1e-12 for c in changes) or rep.get("feasibility_transition", False))
    return rep


def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
        _, rrec, _ = reference_of(job, out)
        cands, fams, _ = menu(job, out, cuts, h4_excluded)
        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
    if job["objective"] in ("W0", "W1"):
        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
        continue_search(obj, fam, st, orig)
        sel_old = rec["selected"]
        old_eff = obj.extra[exact_key(sel_old)]["eff"] if sel_old is not None else None
        sel = select_w1(obj) if job["objective"] == "W1" else dict(max(obj.archive.values(), key=lambda e: e.f).knobs)
        new_eff = obj.extra[exact_key(sel)]["eff"] if sel is not None else None
        held = None
        if sel is not None:
            fr = run_focal(eval_cell(job), lambda: fam.make(dict(sel)), SeedCache())
            held = {"knobs": dict(sel), "seeds": list(eval_cell(job).seeds), "eff": gross_efficiency(fr.results).tolist()}
        return {**doubling_report("w1" if job["objective"] == "W1" else "welfare", {"eff": old_eff, "feasible": sel_old is not None},
                                  {"eff": new_eff, "feasible": sel is not None}), "heldout": held}
    m = job["mkt"]; fam = family_for(job["family"], T, L); orig = search_from_json(rec["coalition"])
    if job["objective"] == "total":
        obj = _coalition_objective(job, "total", np.zeros((len(_members(job)), len(m["seeds_train"]))), cache)
        new = continue_search(obj, fam, st, orig)
        return {**doubling_report("coalition", {"f": orig.best_f}, {"f": max(new.best_f, orig.best_f)}),
                "heldout": _coalition_heldout(job, _desc(job, new.best_knobs), out)}
    ctx, tag = job["context"], _coalition_tag(job)                  # G_min: every score against the final reference (design 6.3)
    ref = np.asarray(read(path_of(out, f"joint_reference/{ctx}/{tag}"))["member_normalized"])
    sel = read(path_of(out, f"coalition_select/{ctx}/{tag}"))["winners"][job["id"]]
    orig = rescore_min(orig, rec["rows"], ref)
    obj = _coalition_objective(job, "min", ref, cache)
    new = continue_search(obj, fam, st, orig)
    win, f = (_desc(job, new.best_knobs), new.best_f) if new.best_f > sel["score"] else (sel["descriptor"], sel["score"])   # step 6's winner stays in
    return {**doubling_report("coalition", {"f": sel["score"]}, {"f": f}), "heldout": _coalition_heldout(job, win, out)}


def _coalition_heldout(job: dict, desc: dict, out: Path) -> dict:
    """The doubled coalition winner (one descriptor, the same one the objective change reports) on the evaluation seeds
    against the final joint reference (design 6.5)."""
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}")); seeds = list(eval_cell(job).seeds); cache = SeedCache()
    g = _rows_of(job, desc, seeds, cache) - _rows_of(job, jrec["descriptor"], seeds, cache)
    return {"descriptor": desc, "knobs": None if desc["knobs"] is None else dict(desc["knobs"]), "seeds": seeds, "member_gain": g.tolist(),
            "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min())}


def rescore_min(orig, rows: list[dict], ref: np.ndarray):
    """The search's archive with every G_min score recomputed against `ref` from the stored member rows (design 6.3)."""
    by = {exact_key(e["knobs"]): np.asarray(e["member_rows"]) for e in rows}
    arch = {}
    for k, e in orig.archive.items():
        f = float((by[k] - ref).mean(axis=1).min()) if k in by else e.f
        arch[k] = replace(e, f=f)
    best = max(arch.values(), key=lambda e: e.f)
    return replace(orig, archive=arch, best_knobs=dict(best.knobs), best_f=best.f)


# ---- orchestration -----------------------------------------------------------------------------------------------------

def _stage_record_path(stage: str, job: dict, out: Path) -> Path:
    if stage in ("search", "dependent"):
        return path_of(out, job["id"])
    if stage == "evaluate":
        return eval_path(out, job["id"])
    return Path(out) / "doubling" / (_safe(job["id"]) + ".json")


def _inputs(job: dict) -> set:
    """The records an evaluation or a doubling check depends on (the diagnostic has none but the freeze)."""
    if job["objective"] == "diagnostic":
        return set()
    ids = {job["id"]}
    if job["objective"] in ("W0", "W1"):
        ids.add(f"welfare_select/{job['context']}/{job['rule']}/{job['objective']}")
    if job["objective"] in ("profit", "W1"):
        ids.add(f"reference/{job['context']}/{job['rule']}")
    if job["objective"] in ("total", "min"):
        ids.add(f"joint_reference/{job['context']}/{_coalition_tag(job)}")
    if job["objective"] == "min":
        ids.add(f"coalition_select/{job['context']}/{_coalition_tag(job)}")
    return ids


def stage_upstream(stage: str, job: dict, catalog: list[dict], cuts: int, h4_excluded: bool) -> set:
    if stage in ("search", "dependent"):
        return expected_upstream(job["id"], catalog, cuts, h4_excluded)
    ids = _inputs(job) | {f"freeze/{job['context']}"}
    if stage == "doubling" and job["objective"] == "profit":                  # the profit check reselects from the rule's menu
        ids |= expected_upstream(f"reference/{job['context']}/{job['rule']}", catalog, cuts, h4_excluded)
    return ids


def _tiers(items: list) -> list[list]:
    return [[i for i in items if i.get("priority", 3) == t] for t in range(4)]


def _menu_items(jobs: list[dict]) -> list[dict]:
    menus = {}
    for j in jobs:
        if j["objective"] == "profit" and j["family"] in MENU:
            k = (j["context"], j["rule"]); m = menus.get(k)
            if m is None or (j["family"] == "D2+H3" and m["family"] != "D2+H3"):
                menus[k] = {**j, "id": f"reference/{k[0]}/{k[1]}", "priority": min(j.get("priority", 3), (m or {}).get("priority", 3))}
            else:
                m["priority"] = min(m["priority"], j.get("priority", 3))
    return list(menus.values())


def _cross_items(jobs: list[dict]) -> list[dict]:
    ok = {c for c, _ in MAN.cross_evaluations()}
    return [{"id": f"cross/{ctx}/{fam}", "context": ctx, "family": fam, "priority": 1}
            for ctx in sorted({j["context"] for j in jobs}) if manifest_ctx(ctx) in ok or ctx.startswith("dev") for fam in MENU]


def _waves(stage: str, jobs: list[dict], catalog: list[dict]) -> list[tuple[str, list]]:
    """The (stage, items) calls `run` makes, in order: priority tiers 0 to 3 (design 8.2), and inside a tier the dependency
    waves. Each call is a completion barrier: it returns only when all its items have finished."""
    out = []
    add = lambda st, items: out.append((st, items)) if items else None
    if stage == "search":
        for t in _tiers([j for j in jobs if j["objective"] in ("profit", "W0")]):
            add("search", [j for j in t if j["family"] != "X7-SC"]); add("search", [j for j in t if j["family"] == "X7-SC"])
    elif stage == "reference":
        for t in _tiers(_menu_items(jobs)):
            add("reference", t)
    elif stage == "dependent":
        for t in _tiers([j for j in jobs if j["objective"] in ("W1", "total", "min")]):
            add("dependent", [j for j in t if j["objective"] == "W1" and j["family"] != "X7-SC"])
            add("dependent", [j for j in t if j["objective"] == "W1" and j["family"] == "X7-SC"])
            co = [j for j in t if j["objective"] in ("total", "min")]; groups = {}
            for j in co:
                groups.setdefault((j["context"], _coalition_tag(j)), j)
            step = lambda kind, g, suffix="": {**g, "id": f"{kind}/{g['context']}/{_coalition_tag(g)}{suffix}", "record_id": f"{kind}/{g['context']}/{_coalition_tag(g)}{suffix}"}
            add("joint_twin", [step("joint_twin", g, f"_{s}") for g in groups.values() for s in _x6_schedules(_group(g, catalog))])
            add("dependent", [j for j in co if j["objective"] == "total"])
            add("joint_reference_pre", [step("joint_reference_pre", g) for g in groups.values()])
            add("dependent", [j for j in co if j["objective"] == "min"])
            add("joint_reference", [step("joint_reference", g) for g in groups.values()])
            add("coalition_select", [step("coalition_select", g) for g in groups.values()])
    elif stage == "evaluate":
        for t in _tiers(jobs):
            add("evaluate", t)
    elif stage == "cross":
        for t in _tiers(_cross_items(jobs)):
            add("cross", t)
    elif stage == "doubling":
        dbl = set(MAN.doublings())
        for t in _tiers([j for j in jobs if j["id"].replace(j["context"], manifest_ctx(j["context"]), 1) in dbl]):
            add("doubling", t)
    return out


def dispatch_plan(stage: str, jobs: list[dict], catalog: list[dict] | None = None) -> list[list[str]]:
    """The ids of every `_pool` call `run(stage, jobs)` makes, in order (Task 4's cost model bills these waves)."""
    return [[i["id"] for i in items] for _, items in _waves(stage, jobs, catalog if catalog is not None else jobs)]


def _run_cross(item: dict, out: Path, catalog: list[dict]) -> str:
    ctx, fam = item["context"], item["family"]
    p = Path(out) / "cross" / ctx / (_safe(fam) + ".json"); old = read(p); prov, ids = cross_expected(ctx, fam, catalog, out)

    def check():
        if set(old.get("upstream") or {}) != ids:
            raise ValueError("dependency set")
        validate({"provenance": prov}, "cross", old, {u: path_of(out, u) for u in ids})
        _, rules = _cross_rules(ctx, fam, catalog, read(path_of(out, f"bank/{ctx}/{fam}")))
        bad = _cross_problems(old, rules, len(_first(catalog, context=ctx)["mkt"]["seeds_eval"]))
        if bad:                                                          # a damaged current record is recomputed, not skipped
            raise ValueError(bad)
    if reusable(p, old, prov, check):
        return "skipped"
    write(p, stage_cross(ctx, fam, catalog, out))
    return "done"


def _run_reference(item: dict, out: Path, cuts: int, h4_excluded: bool, catalog: list[dict]) -> str:
    rid = item["id"]; p = path_of(out, rid); old = read(p)
    if reusable(p, old, reference_provenance(item), lambda: check_record(rid, old, catalog, out, cuts, h4_excluded)):
        return "skipped"
    rec = stage_reference(item, out, cuts, h4_excluded); up = rec.pop("upstream")
    write(p, {"stage": "reference", "provenance": reference_provenance(item), "upstream": up, **rec})
    return "done"


def _run_one(stage: str, job: dict, out: str, cuts: int, h4_excluded: bool, catalog: list | None = None) -> str:
    out = Path(out); catalog = catalog or [job]
    if stage == "reference":
        return _run_reference(job, out, cuts, h4_excluded, catalog)
    if stage == "cross":
        return _run_cross(job, out, catalog)
    if stage in COALITION_STEPS:
        return coalition_step(stage, job, out, catalog)
    p = _stage_record_path(stage, job, out); rec = read(p)
    want = stage_upstream(stage, job, catalog, cuts, h4_excluded)
    def check():
        if set(rec.get("upstream") or {}) != want:
            raise ValueError("dependency set")
        validate(job, stage, rec, {u: path_of(out, u) for u in want})
        if stage == "evaluate":                                         # a damaged current record is recomputed, not skipped
            bad = _schema_problems(job, rec, len(job["mkt"]["seeds_eval"]))
            if bad:
                raise ValueError(bad)
        if stage == "doubling" and "heldout" not in rec:
            raise ValueError("doubling record without its held-out diagnostic")
    if reusable(p, rec, job["provenance"], check):
        return "skipped"
    body = {"search": stage_search, "dependent": stage_dependent, "evaluate": stage_evaluate}.get(stage)
    rec = body(job, out) if body else stage_doubling(job, out, cuts, h4_excluded)
    upstream = rec.pop("upstream", None)
    if stage in ("evaluate", "doubling") or upstream is None:
        upstream = {u: sha_file(path_of(out, u)) for u in sorted(want)}
    write(p, {"stage": stage, "id": job["id"], "provenance": job["provenance"], "upstream": upstream, **rec})
    return "done"


def _pool(stage, jobs, out, workers, cuts, h4_excluded, catalog=None) -> list:
    if workers <= 1 or len(jobs) <= 1:
        return [_run_one(stage, j, str(out), cuts, h4_excluded, catalog) for j in jobs]
    with ProcessPoolExecutor(max_workers=workers) as ex:
        n = len(jobs)
        return list(ex.map(_run_one, [stage] * n, jobs, [str(out)] * n, [cuts] * n, [h4_excluded] * n, [catalog] * n))


def run(stage: str, jobs: list[dict], out: Path, workers: int = 1, cuts: int = 0, h4_excluded: bool = False, catalog: list | None = None) -> dict:
    """`jobs` is the execution subset; `catalog` (default: `jobs`) is the full job list that freeze checks and
    acceptance validate against. Every stage but freeze runs its `_waves` calls in order through `_pool`."""
    out = Path(out); res = {}; catalog = catalog if catalog is not None else jobs
    if stage not in STAGES or stage == "verify":
        raise SystemExit(f"unknown stage {stage!r}")
    if stage == "freeze":
        for ctx in sorted({j["context"] for j in jobs}):
            stage_freeze(ctx, catalog, out, cuts, h4_excluded); res[ctx] = "frozen"
        return res
    calls = _waves(stage, jobs, catalog)
    if stage in ("evaluate", "cross", "doubling"):                        # each only after the context's freeze is accepted again
        for ctx in sorted({i["context"] for _, items in calls for i in items}):
            accept(ctx, catalog, out, cuts, h4_excluded)
    for st, items in calls:
        for item, r in zip(items, _pool(st, items, out, workers, cuts, h4_excluded, catalog)):
            res[item["id"]] = r
    return res


# ---- read-only verification ----------------------------------------------------------------------------------------------

def _numbers_ok(v) -> bool:
    if isinstance(v, bool) or v is None or isinstance(v, str):
        return True
"""The protocol-v2 manifest (design draft 7: 8.1, 8.1a, 8.2, 6.5, 6.6, 6.7), read from experiments/revision-v2-manifest.yaml:
the 287 search cells and 3 diagnostic cells, the 98 doubling checks, the 14 fixed-attack cross-evaluations, the execution
priority, the pre-stated cut order, per context the records a final freeze requires and the reference-bank rules, the
distinct-rule check (design 3.4), and the question-to-cell map (design 8.1a)."""
from __future__ import annotations

from functools import lru_cache
from pathlib import Path

import json
import math

import yaml

ROOT = Path(__file__).resolve().parents[1]
PATH = ROOT / "experiments/revision-v2-manifest.yaml"
Q1_Q4_RULES = ("F000", "F111", "C*")
FACTORIAL = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111")
MATCHED = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111", "C*", "C*/S0")
FIXED = MATCHED + ("C*/S2", "R4")                    # rules at the fixed pair (R4 and C*/S2 only in the rho = 1 repair block)
MENU_FAMILIES = ("D2+H3", "X7-SC")
SECONDARY = ("B3-t", "R3-t", "C*-t")
CORE = ("F000", "F111", "C*")
J, L_FIXED = 50, 10


@lru_cache(maxsize=1)
def doc() -> dict:
    return yaml.safe_load(PATH.read_text())


CUT_ORDER = tuple(doc()["cut_order"])


def context(market: str, rho: float = 0.2) -> str:
    return f"{market}@rho{rho:g}" if rho != 0.2 else f"{market}@rho0.2"


def _cell(block, market, rho, rule, family, objective, c=None, schedule=None) -> dict:
    ctx = context(market, rho)
    cid = f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")
    return {"id": cid, "block": block, "market": market, "context": ctx, "rho": rho, "rule": rule, "family": family, "objective": objective,
            "c": c, "schedule": schedule}


def _families(b: dict, market: str) -> list:
    if "families_by_market" in b:
        return b["families_by_market"]["headline" if market == "headline" else "fresh"]
    return b["families"]


def headline_a_tot(rho: float) -> int:
    """A_tot = floor(beta S_hat / (rho m)) = floor((beta / rho) n_FB) on the headline calibration (design 3.4)."""
    n_fb = float(json.loads((ROOT / "experiments/calibration.json").read_text())["n_FB"])
    return int(math.floor(0.05 / float(rho) * n_fb + 1e-12))


def _descriptor(rule: str, a_tot: int) -> tuple:
    """(selection, pacing schedule) of a rule at the fixed pair; rules with their own parameters are unique."""
    if rule in FACTORIAL:
        pacing = ("reserve", min(J * L_FIXED, a_tot)) if rule[3] == "1" else ("spread",)
        return (("factorial", rule[1], rule[2]), pacing)
    if rule == "R4":
        return (("factorial", "1", "1"), ("reserve", min(J * L_FIXED, a_tot // 2)))
    if rule in ("C*", "C*/S0", "C*/S2"):
        pacing = {"C*": ("reserve", min(J * L_FIXED, a_tot)), "C*/S0": ("spread",), "C*/S2": ("reserve", min(J * L_FIXED, a_tot // 2))}[rule]
        return (("credibility",), pacing)
    return (("own", rule), ("own", rule))


def distinct_rule_problems(cs: list[dict], a_tot: dict) -> list[str]:
    """Design 3.4: no two rules compared in one block and context may have the same selection and pacing schedule."""
    seen: dict = {}; out = []
    for c in cs:
        key = (c["block"], c["context"], _descriptor(c["rule"], int(a_tot[c["context"]])))
        other = seen.setdefault(key, c["rule"])
        if other != c["rule"]:
            out.append(f"{c['block']} {c['context']}: {other} and {c['rule']} have the same selection and pacing")
    return sorted(set(out))


def cells() -> list[dict]:
    d = doc(); out = []
    for name, b in d["blocks"].items():
        markets = d["markets"] if b["markets"] == "all" else b["markets"]
        rho = float(b.get("rho", 0.2))
        objectives = b.get("objectives", [b.get("objective")])
        for m in markets:
            for r in b["rules"]:
                for f in _families(b, m):
                    for o in objectives:
                        if "c" in b:
                            out.extend(_cell(name, m, rho, r, f, o, c, s) for c in b["c"] for s in b["schedules"])
                        else:
                            out.append(_cell(name, m, rho, r, f, o))
    problems = distinct_rule_problems(out, {c["context"]: headline_a_tot(c["rho"]) for c in out})
    if problems:
        raise ValueError(f"manifest refused: {problems}")
    return out


def menu_families(ctx: str, rule: str) -> tuple[str, ...]:
    """Design 6.4: the secondary whole systems on fresh markets have the reduced D2+H3 menu; every other reference both."""
    return ("D2+H3",) if rule in SECONDARY and ctx.startswith("fresh") else MENU_FAMILIES


def _cut(cell: dict, spec: dict) -> bool:
    if spec.get("markets") == "fresh" and not cell["market"].startswith("fresh"):
        return False
    return all(cell[k] == v for k, v in (("block", spec.get("block")), ("family", spec.get("family")), ("rule", spec.get("rule"))) if v is not None)


def effective(cuts: int = 0, h4_excluded: bool = False) -> list[dict]:
    out = cells()
    for spec in CUT_ORDER[: int(cuts)]:
        out = [c for c in out if not _cut(c, spec)]
    if h4_excluded:
        out = [c for c in out if c["family"] != "H4"]
    return out


def doublings() -> list[str]:
    out = []
    for c in cells():
        if c["market"] == "headline" and c["rho"] == 0.2 and c["block"] in ("matched", "welfare", "coalition", "coalition_roles"):
            out.append(c["id"])
        elif c["market"].startswith("fresh") and c["block"] == "matched" and c["rule"] in Q1_Q4_RULES:
            out.append(c["id"])
    return out


def cross_evaluations() -> list[tuple[str, str]]:
    return [(context(m), f) for m in doc()["markets"] for f in MENU_FAMILIES]


def priority(cell: dict) -> int:
    if cell["block"] == "matched":
        return 0 if cell["rule"] in Q1_Q4_RULES else 1
    if cell["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic") or (cell["block"] == "extras" and cell["family"] in ("X5-AG/v2", "H4")):
        return 2
    return 3


def bank_rules(ctx: str, family: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    present = {c["rule"] for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["family"] == family and c["objective"] == "profit"}
    return [r for r in FIXED if r in present]


def required(ctx: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    cs = [c for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["block"] != "diagnostic"]   # diagnostics run after the freeze
    req = [c["id"] for c in cs]
    rules = sorted({c["rule"] for c in cs if c["objective"] != "coalition"}, key=lambda r: (r not in FIXED, r))
    req += [f"reference/{ctx}/{r}" for r in rules]
    groups: dict = {}
    for c in cs:
        if c["objective"] in ("total", "min"):
            groups.setdefault(f"{c['rule']}_c{c['c']}", set()).add(c["schedule"] if c["family"] == "X6-SE/v2" else None)
    for tag, schedules in groups.items():                  # design draft 7, 6.3: one coalition group per rule and c
        req += [f"joint_twin/{ctx}/{tag}_{s}" for s in ("synchronised", "staggered") if s in schedules]
        req += [f"{kind}/{ctx}/{tag}" for kind in ("joint_reference_pre", "joint_reference", "coalition_select")]
    env_rules = sorted({c["rule"] for c in cs if c["block"] == "extras"})
    req += [f"envelope/{ctx}/{r}" for r in env_rules]
    if any(c["block"] == "matched" for c in cs) and ctx in {context(m) for m in doc()["markets"]}:
        req += [f"bank/{ctx}/{f}" for f in MENU_FAMILIES]
        req += [f"bank_train/{ctx}/{f}" for f in MENU_FAMILIES]                          # design draft 7, 6.6: before the freeze
        req += [f"envelope_select/{ctx}/{r}/{f}" for f in MENU_FAMILIES for r in FACTORIAL
                if any(c["rule"] == r and c["family"] == f and c["block"] == "matched" for c in cs)]
    req += sorted({f"welfare_select/{ctx}/{c['rule']}/{c['objective']}" for c in cs if c["block"] == "welfare"},
                  key=lambda x: (CORE.index(x.split("/")[2]), x))                         # design draft 7, 6.2
    return req


def _ids(pred, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    return [c["id"] for c in effective(cuts, h4_excluded) if pred(c)]


def _fresh(c: dict) -> bool:
    return c["market"].startswith("fresh")


QUESTIONS = {
    "Q1": {"cells": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F111", "C*") and c["family"] in MENU_FAMILIES,
           "checks": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F111", "C*") and c["family"] in MENU_FAMILIES},
    "Q2": {"cells": lambda c: c["block"] == "matched" and c["rule"] in FACTORIAL and c["rho"] == 0.2,
           "checks": lambda c: c["market"] == "headline" and c["block"] == "matched" and c["rule"] in FACTORIAL},
    "Q3": {"cells": lambda c: c["rho"] == 0.2 and c["rule"] in CORE and (c["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic")
                                                                         or c["family"] in ("D2+H3", "X7-SC", "X5-AG/v2", "H4") and c["block"] in ("matched", "extras")),
           "checks": lambda c: c["rule"] in CORE and c["rho"] == 0.2 and (c["block"] in ("welfare", "coalition", "coalition_roles") or c["block"] == "matched")},
    "Q4": {"cells": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F000", "F111") and c["family"] == "D2+H3",
           "checks": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F000", "F111") and c["family"] == "D2+H3"},
    "repair": {"cells": lambda c: c["block"] == "repair", "checks": lambda c: False},
    "whole": {"cells": lambda c: c["block"] == "tuned", "checks": lambda c: False},
}


def question_cells(name: str, cuts: int = 0, h4_excluded: bool = False) -> dict:
    """Design 8.1a: the cells a question needs and the scheduled doubling checks it depends on (cross-evaluations for Q2)."""
    q = QUESTIONS[name]; dbl = set(doublings())
    out = {"cells": _ids(q["cells"], cuts, h4_excluded), "checks": [i for i in _ids(q["checks"], cuts, h4_excluded) if i in dbl]}
    if name == "Q2":
        out["cross"] = [f"cross/{ctx}/{f}" for ctx, f in cross_evaluations()]
    return out


