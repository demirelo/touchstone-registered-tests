def restored_cells(markets=MARKETS) -> list[dict]:
    uncut = {c["id"]: c for c in MAN.cells()}; kept = {c["id"] for c in MAN.effective(CUTS, H4_EXCLUDED)}; ids = cell_ids(markets)
    if missing := [i for i in ids if i not in uncut]:
