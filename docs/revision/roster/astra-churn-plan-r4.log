"""The reset follow-up (docs/revision/reset-experiment-plan.md, draft 4, section 3): the 18 D2 cells that cut 3 removed
(F000, F111, C* x fresh0..fresh5 at rho 0.2), run with the frozen stage functions of scripts/revision_v2.py.

Three things of the frozen runner are bypassed, each a recorded deviation (DEVIATIONS): the manifest's cut list, the
hard-coded doubling eligibility, and the original freeze. Everything else is the frozen code: `job`, `stage_search`,
`stage_evaluate`, `stage_doubling`, reached through `revision_v2._run_one`, so the record format and the dependency sets
are the registered ones.

Order: copy the inputs (the frozen references, the menu searches and bank sources they list, each checked against the
hash the original records hold), search, the follow-up freeze, acceptance, evaluation, acceptance, doubling, inventory.
The output directory is never results/v2/eval/all."""
from __future__ import annotations

import argparse
import json
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]          # docs/revision/followup/ (code after the freeze lives under docs/)
sys.path.insert(0, str(ROOT / "scripts")); sys.path.insert(0, str(ROOT))

import revision_v2 as R  # noqa: E402
from sim import manifest_v2 as MAN  # noqa: E402
from sim.records_v2 import read, sha_file, write  # noqa: E402

RULES = ("F000", "F111", "C*")
MARKETS = tuple(f"fresh{i}" for i in range(6))
CUTS, H4_EXCLUDED = 3, False                        # the registered evaluation: cuts 3, H4 loaded (results/v2/draw/h4.json)
EVAL_ALL = ROOT / "results" / "v2" / "eval" / "all"
DEVIATIONS = (
    "manifest cut list bypassed: the 18 D2 cells (F000, F111, C* x fresh0..fresh5, rho 0.2) that cut 3 removed are run",
    "doubling eligibility bypassed: each of the 18 cells gets a doubling check with its held-out evaluation",
    "original freeze bypassed: this script's follow-up freeze and acceptance check replace revision_v2.accept",
)


def _refuse(msg: str):
    raise SystemExit(f"reset follow-up refused: {msg}")


def cell_ids(markets=MARKETS) -> list[str]:
    return [R.cell_id(MAN.context(m), r, "D2", "profit") for m in markets for r in RULES]


def restored_cells(markets=MARKETS) -> list[dict]:
    uncut = {c["id"]: c for c in MAN.cells()}; kept = {c["id"] for c in MAN.effective(CUTS, H4_EXCLUDED)}; ids = cell_ids(markets)
    if missing := [i for i in ids if i not in uncut]:
        _refuse(f"not design cells: {missing}")
    if present := [i for i in ids if i in kept]:
        _refuse(f"not removed by cut {CUTS}: {present}")
    return [uncut[i] for i in ids]


def check_out(out, src=None) -> None:
    o = Path(out).resolve()
    for e in {Path(EVAL_ALL).resolve()} | ({Path(src).resolve()} if src else set()):
        if o == e or e in o.parents:
            _refuse(f"the output {o} is inside {e}")


PAIRED_KEYS = ("runner_sha256", "salt_sha256", "cfg_sha256", "root", "seeds_train", "seeds_val", "seeds_eval", "rule_params_sha256", "context")


def check_pairing(src, jobs: list[dict]) -> None:
    """Each job's provenance equals its frozen reference's provenance on every key the pairing depends on (the commit may
    differ): runner, salt, configuration, root, seeds, rule parameters, context (Fable 5.2 driver review, finding 1)."""
    for j in jobs:
        ref = read(R.path_of(src, f"reference/{j['context']}/{j['rule']}"))
        if ref is None:
            _refuse(f"{j['id']}: no reference record to pair with")
        if bad := [k for k in PAIRED_KEYS if j["provenance"].get(k) != ref["provenance"].get(k)]:
            _refuse(f"{j['id']}: provenance differs from its reference in {bad}")


def check_commit(jobs: list[dict]) -> None:
    if bad := [j["id"] for j in jobs if j["provenance"].get("git_commit") in (None, "", "unknown")]:
        _refuse(f"no git commit recorded for {bad[:3]}")


def check_code() -> None:
    """The frozen runner and simulator are byte-identical to the protocol-v2 tag."""
    import subprocess
    r = subprocess.run(["git", "diff", "--quiet", "protocol-v2", "--", "scripts/revision_v2.py", "sim/"], cwd=ROOT)
    if r.returncode != 0:
        _refuse("scripts/revision_v2.py or sim/ differs from protocol-v2 (or the tag is missing)")


def preflight(out, src, jobs: list[dict], salt_sha256: str, container: dict | None = None) -> None:
    """Every check that must pass before any episode, on every execution path (internal review r4)."""
    check_salt(out, salt_sha256, jobs); check_commit(jobs); check_code(); check_pairing(src, jobs)
    if container is not None:
        check_configs(jobs, container)


def environment() -> dict:
    """The numerical stack of the run (plan draft 5): interpreter, numpy with its BLAS and LAPACK, SciPy, CMA, the CPU."""
    import platform
    import subprocess
    import numpy
    def ver(m):
        try:
            return __import__(m).__version__
        except Exception as e:
            return f"unavailable: {type(e).__name__}"
    try:
        cfg = numpy.show_config(mode="dicts")["Build Dependencies"]; blas = {k: {kk: cfg[k].get(kk) for kk in ("name", "version")} for k in ("blas", "lapack") if k in cfg}
    except Exception as e:
        blas = f"unavailable: {type(e).__name__}"
    cpu = platform.processor()

def copy_inputs(src, out, need: dict[str, str]) -> None:
    """Copy each input read-only, checked against its recorded hash; an existing identical copy is kept."""
    for rid, sha in sorted(need.items()):
        p, q = R.path_of(src, rid), R.path_of(out, rid)
        if not p.exists():
            _refuse(f"input {rid} is missing in {src}")
        if sha_file(p) != sha:
            _refuse(f"input {rid} differs from the hash in the original records")
        if q.exists():
            if sha_file(q) != sha:
                _refuse(f"{q} exists and differs from the original {rid}")
            continue
        q.parent.mkdir(parents=True, exist_ok=True); shutil.copyfile(p, q); q.chmod(0o444)
    prev = read(Path(out) / "inputs.json")
    if prev is not None and any(prev[k] != v for k, v in need.items() if k in prev):
        _refuse("inputs.json lists other hashes for the same records")
    write(Path(out) / "inputs.json", {**(prev or {}), **need})


def check_configs(jobs: list[dict], container: dict) -> None:
    """Each job's configuration hash equals the recorded container hash (addendum.json deviations.configs)."""
    for j in jobs:
        label = j["mkt"]["label"]; want = (container.get(label) or {}).get("container_hash")
        if j["provenance"]["cfg_sha256"] != want:
            _refuse(f"{j['id']}: configuration hash {j['provenance']['cfg_sha256']} is not the container hash {want}")


def _ctx_inputs(out, ctx: str) -> dict[str, str]:
    return {r: s for r, s in (read(Path(out) / "inputs.json") or {}).items() if ctx in r}


def prefreeze(out, jobs: list[dict]) -> None:
    """The pre-evaluation freeze of each context: its copied inputs and its new search records, with their hashes."""
    for ctx in sorted({j["context"] for j in jobs}):
        recs = dict(_ctx_inputs(out, ctx))
        for j in (j for j in jobs if j["context"] == ctx):
            p = R.path_of(out, j["id"]); rec = read(p)
            if rec is None or rec.get("stage") != "search" or rec.get("provenance") != j["provenance"]:
                _refuse(f"{j['id']}: no current search record to freeze")
            recs[j["id"]] = sha_file(p)
        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED, "records": recs}
        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
        if old is not None and old != body:
            _refuse(f"{p} exists with other records")
        if old is None:
            write(p, body)


def accept(out, jobs: list[dict], salt_sha256: str, container: dict, src=None) -> None:
    """Run before evaluation and before doubling: the freeze exists and every record in it, and every copied input,
    still has its hash; the identity salt and the configurations are the recorded ones; with `src`, inputs.json holds
    every input recomputed from the original records."""
    check_salt(out, salt_sha256, jobs)
    check_configs(jobs, container)
    if src is not None:
        have = read(Path(out) / "inputs.json") or {}
        if bad := sorted(r for r, s in inputs(src, jobs).items() if have.get(r) != s):
            _refuse(f"inputs.json lacks or differs on {bad[:3]}")
    for ctx in sorted({j["context"] for j in jobs}):
        fr = read(R.path_of(out, f"freeze/{ctx}"))
        if fr is None or not fr.get("followup"):
            _refuse(f"{ctx}: no follow-up freeze")
        want = {**_ctx_inputs(out, ctx), **{j["id"]: None for j in jobs if j["context"] == ctx}}
        if missing := sorted(set(want) - set(fr["records"])):
            _refuse(f"{ctx}: the freeze lacks {missing}")
        for r, sha in fr["records"].items():
            p = R.path_of(out, r)
            if not p.exists() or sha_file(p) != sha or (want.get(r) not in (None, sha)):
                _refuse(f"{ctx}: {r} differs from the freeze")


def run_stage(stage: str, jobs: list[dict], out, workers: int = 1) -> list[str]:
    return R._pool(stage, jobs, Path(out), workers, CUTS, H4_EXCLUDED, jobs)


def inventory(out) -> dict:
    """Every output file with its hash, written after the outputs, so no record lists itself."""
    out = Path(out)
    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
    inv = {"stage": "inventory", "deviations": list(DEVIATIONS), "environment": environment(), "records": recs}
    write(out / "inventory.json", inv)
    return inv


def reset_stats(results, focal: int) -> dict:
    """Plan section 4: per episode, the focal provider's identity replacements, the rounds they were created, the rounds
    without a focal offer (banned or waiting), and the ban rounds imposed on its identities."""
    import numpy as np
    resets, rounds, no_offer, bans = [], [], [], []
    for r in results:
        mine = [i for i, e in enumerate(r.entity_of) if e == focal]
        new = [i for i in mine if r.identity_generation[i] > 0]
        resets.append(len(new)); rounds.append([int(r.identity_round[i]) for i in new])
        no_offer.append(int(np.isnan(r.claims[:, focal]).sum()))
        bans.append(int(sum(v for h in r.history for i, v in h.consequences.bans.items() if i in mine)))
def train_cell(job: dict, others: tuple = ()) -> Cell:
    m = job["mkt"]
    return Cell(cfg=m["cfg"], rule_factory=rule_factory(job), focal=m["focal"], seeds=tuple(m["seeds_train"]), name=job["id"], others=others)


def eval_cell(job: dict) -> Cell:
    return replace(train_cell(job), seeds=tuple(job["mkt"]["seeds_eval"]))


# ---- record paths ------------------------------------------------------------------------------------------------------

def _safe(s: str) -> str:
    return s.replace("|", "__").replace("/", "~").replace("*", "star")
def stage_search(job: dict, out: Path) -> dict:
    T, L = constants(job); fam = family_for(job["family"], T, L, job.get("h4")); cache = SeedCache(); st = settings(job); cell = train_cell(job)
    upstream = {}
    if job["objective"] == "W0":
        extra, upstream = _welfare_extra(job, out, T)
        obj = WelfareObjective(cell, fam, cache)
        res = cma_search(obj, fam, st, 1, incumbents={"honest_point": fam.honest_point(), **extra})
        controls(obj, fam)
        best = max(obj.archive.values(), key=lambda e: e.f)
        return _welfare_record(obj, res, dict(best.knobs), upstream, T, L)
    tw = twin_search(cell, fam, cache, st, seed=0)
    extra = {}
    if job["family"] == "X7-SC":
        rid = _menu_id(job["context"], job["rule"], "D2+H3"); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"{job['id']}: needs {rid} first")
        extra["embedded_h3"] = embed_h3(rec["attack"]["best_knobs"], T); upstream[rid] = sha_file(path_of(out, rid))
    at = search_family(cell, fam, cache, st, tw, extra)
    obj = Objective(cell, fam, cache); obj.archive.update(at.archive)
    ctrl = controls(obj, fam)
    best_ctrl = max(ctrl, key=lambda kf: kf[1]) if ctrl else None
    at.archive.update(obj.archive)
    rec = {"twin": search_to_json(tw), "attack": search_to_json(at), "controls": [{"knobs": k, "f": f} for k, f in ctrl],
           "upstream": upstream, "T": T, "L": L, "runs": cache.runs}
    if best_ctrl is not None and best_ctrl[1] > at.best_f:
        rec["attack"]["best_knobs"], rec["attack"]["best_f"], rec["attack"]["best_source"] = dict(best_ctrl[0]), float(best_ctrl[1]), "control"
    return rec


def cand_to_json(c: Candidate, family: str | None, T: int, L: int) -> dict:
    return {"name": c.name, "family": family, "T": T, "L": L, "knobs": c.knobs}


def cand_from_json(d: dict, h4: dict | None = None) -> Candidate:
    if d.get("family") == "H4":
        return FV2.cand_from_json(d, _h4(h4["dir"], h4["sha"]))
    return FV2.cand_from_json(d)


def menu(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> tuple[list, list, dict]:
    """The reference menu of the job's rule in its context (design 6.4): candidates, their family names, upstream hashes."""
    ctx, rule = job["context"], job["rule"]; T, L = constants(job); cell = train_cell(job)
    groups: dict[tuple, list] = {}; upstream = {}; fnames = MAN.menu_families(manifest_ctx(ctx), rule)
    for fname in fnames:
        rid = _menu_id(ctx, rule, fname); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"reference {ctx}/{rule}: needs {rid}")
        upstream[rid] = sha_file(path_of(out, rid))
        fam = family_for(fname, T, L)
        bank = []
        if rule in FIXED:
            for other in MAN.bank_rules(manifest_ctx(ctx), fname, cuts, h4_excluded):
                if other == rule:
                    continue
                orid = _menu_id(ctx, other, fname); orec = read(path_of(out, orid))
                if orec is None:
                    raise SystemExit(f"reference {ctx}/{rule}: needs bank source {orid}")
                upstream[orid] = sha_file(path_of(out, orid)); bank.append(fam.project(orec["attack"]["best_knobs"]))
        lk = load_locked()
        cands = reference_candidates(cell, fam, search_from_json(rec["attack"]), search_from_json(rec["twin"]), bank, tuple(lk["reference_order"]))
        for c in cands:
            cat = "bank" if c.name.startswith("bank_") else c.name
            groups.setdefault((cat, fname), []).append(c)
    out_c, fams = merge_menu(groups, fnames)
    return out_c, fams, upstream


def merge_menu(groups: dict, family_order) -> tuple[list, list]:
    """Candidates in the registered category order, families in the given order within a category, de-duplicated by
    (family, exact key); abstain and honest-max once."""
    out_c, fams, seen = [], [], set()
    for cat in CATEGORIES:
        for fname in family_order:
            for c in groups.get((cat, fname), []):
                key = ("name", c.name) if c.knobs is None else (fname, exact_key(c.knobs))
                if key in seen:
                    continue
                seen.add(key); out_c.append(c); fams.append(None if c.knobs is None else fname)
    return out_c, fams


def stage_reference(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cands, fams, upstream = menu(job, out, cuts, h4_excluded)
    choice = select_reference(train_cell(job), cands, SeedCache())
    idx = next(i for i, c in enumerate(cands) if c is choice.candidate)
    return {"candidates": [cand_to_json(c, f, T, L) for c, f in zip(cands, fams)], "choice": idx, "scores": choice.scores,
            "per_seed_normalized": [float(v) for v in choice.per_seed_normalized], "upstream": upstream, "T": T, "L": L,
            "menu_families": list(MAN.menu_families(manifest_ctx(job["context"]), job["rule"]))}


def reference_provenance(job: dict) -> dict:
    return aux_provenance(job["mkt"], rule=job["rule"], rule_params_sha256=_sha_json(job["spec"]))


def reference_of(job: dict, out: Path) -> tuple[Candidate, dict, Path]:
    p = path_of(out, f"reference/{job['context']}/{job['rule']}"); rec = read(p)
    if rec is None:
        raise SystemExit(f"{job['id']}: needs the rule's reference")
    return cand_from_json(rec["candidates"][rec["choice"]]), rec, p


def _coalition_tag(job):
    """The coalition group of a cell (design draft 7, 6.3): one per context, rule, and c; X6-SE/v2 schedules and X8-DB share it."""
    return f"{job['rule']}_c{job['c']}"


def _twin_id(ctx: str, tag: str, schedule: str) -> str:
    return f"joint_twin/{ctx}/{tag}_{schedule}"


def stage_evaluate(job: dict, out: Path) -> dict:
    T, L = constants(job); cache = SeedCache(); m = job["mkt"]; cell = eval_cell(job)
    if job["objective"] == "diagnostic":                 # design 6.7: a fixed profile, no search, no reference
        return {"seeds": list(cell.seeds), **honest_replacement(m["cfg"], rule_factory(job), m["focal"], cell.seeds, cache)}
    rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); cand, _, _ = reference_of(job, out)
        return {"seeds": list(cell.seeds), **gain_fields(cell, fam, rec["attack"]["best_knobs"], cand, cache)}
    if job["objective"] in ("W0", "W1"):
        if rec["selected"] is None:
            return {"seeds": list(cell.seeds), "no_feasible_candidate": True}
        fam = family_for(job["family"], T, L); fr = run_focal(cell, lambda: fam.make(dict(rec["selected"])), cache)
        out_ = {"seeds": list(cell.seeds), "eff": gross_efficiency(fr.results).tolist(), "normalized": fr.normalized.tolist()}
        if job["objective"] == "W1":
            cand, _, _ = reference_of(job, out); ref = run_focal(cell, cand.policy_factory, cache)
            out_["constraint"] = (fr.normalized - ref.normalized).tolist()
        return out_
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}"))
    if job["objective"] == "min":
        win = read(path_of(out, f"coalition_select/{job['context']}/{_coalition_tag(job)}"))["winners"][job["id"]]["descriptor"]
    else:
        win = _desc(job, rec["selected"])
    rows = _rows_of(job, win, cell.seeds, cache); ref_rows = _rows_of(job, jrec["descriptor"], cell.seeds, cache)
    g = rows - ref_rows
    return {"seeds": list(cell.seeds), "member_gain": g.tolist(), "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min()),
            "winner": win, "reference": jrec["descriptor"]}


def _cross_rules(ctx: str, family: str, catalog: list[dict], bank: dict) -> tuple[dict, list]:
    by_rule = {j["rule"]: j for j in catalog if j["context"] == ctx and j["family"] == family and j["objective"] == "profit" and j["rule"] in MAN.FACTORIAL}
    return by_rule, [r for r in MAN.FACTORIAL if r in by_rule and r in bank["attacks"]]


def cross_expected(ctx: str, family: str, catalog: list[dict], out: Path) -> tuple[dict, set]:
    """The provenance and dependency ids of a cross record, derived independently of any stored record."""
    bank = read(path_of(out, f"bank/{ctx}/{family}"))
    if bank is None:
        raise SystemExit(f"cross {ctx}/{family}: no fixed-attack bank")
    if read(path_of(out, f"bank_train/{ctx}/{family}")) is None:
        raise SystemExit(f"cross {ctx}/{family}: no training-seed bank matrix (frozen before the evaluation)")
    _, rules = _cross_rules(ctx, family, catalog, bank)
    ids = {f"freeze/{ctx}", f"bank/{ctx}/{family}", f"bank_train/{ctx}/{family}"} | {f"reference/{ctx}/{r}" for r in rules}
    ids |= {f"envelope_select/{ctx}/{r}/{family}" for r in rules if path_of(out, f"envelope_select/{ctx}/{r}/{family}").exists()}
    return aux_provenance(_first(catalog, context=ctx)["mkt"], family=family), ids


def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
        _, rrec, _ = reference_of(job, out)
        cands, fams, _ = menu(job, out, cuts, h4_excluded)
        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
    if job["objective"] in ("W0", "W1"):
        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
        continue_search(obj, fam, st, orig)
        sel_old = rec["selected"]
        old_eff = obj.extra[exact_key(sel_old)]["eff"] if sel_old is not None else None
        sel = select_w1(obj) if job["objective"] == "W1" else dict(max(obj.archive.values(), key=lambda e: e.f).knobs)
        new_eff = obj.extra[exact_key(sel)]["eff"] if sel is not None else None
        held = None
        if sel is not None:
            fr = run_focal(eval_cell(job), lambda: fam.make(dict(sel)), SeedCache())
            held = {"knobs": dict(sel), "seeds": list(eval_cell(job).seeds), "eff": gross_efficiency(fr.results).tolist()}
        return {**doubling_report("w1" if job["objective"] == "W1" else "welfare", {"eff": old_eff, "feasible": sel_old is not None},
                                  {"eff": new_eff, "feasible": sel is not None}), "heldout": held}
    m = job["mkt"]; fam = family_for(job["family"], T, L); orig = search_from_json(rec["coalition"])
    if job["objective"] == "total":
        obj = _coalition_objective(job, "total", np.zeros((len(_members(job)), len(m["seeds_train"]))), cache)
        new = continue_search(obj, fam, st, orig)
        return {**doubling_report("coalition", {"f": orig.best_f}, {"f": max(new.best_f, orig.best_f)}),
                "heldout": _coalition_heldout(job, _desc(job, new.best_knobs), out)}
    ctx, tag = job["context"], _coalition_tag(job)                  # G_min: every score against the final reference (design 6.3)
    ref = np.asarray(read(path_of(out, f"joint_reference/{ctx}/{tag}"))["member_normalized"])
    sel = read(path_of(out, f"coalition_select/{ctx}/{tag}"))["winners"][job["id"]]
    orig = rescore_min(orig, rec["rows"], ref)
    obj = _coalition_objective(job, "min", ref, cache)
    new = continue_search(obj, fam, st, orig)
    win, f = (_desc(job, new.best_knobs), new.best_f) if new.best_f > sel["score"] else (sel["descriptor"], sel["score"])   # step 6's winner stays in
    return {**doubling_report("coalition", {"f": sel["score"]}, {"f": f}), "heldout": _coalition_heldout(job, win, out)}


def _coalition_heldout(job: dict, desc: dict, out: Path) -> dict:
    """The doubled coalition winner (one descriptor, the same one the objective change reports) on the evaluation seeds
    against the final joint reference (design 6.5)."""
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}")); seeds = list(eval_cell(job).seeds); cache = SeedCache()
    g = _rows_of(job, desc, seeds, cache) - _rows_of(job, jrec["descriptor"], seeds, cache)
    return {"descriptor": desc, "knobs": None if desc["knobs"] is None else dict(desc["knobs"]), "seeds": seeds, "member_gain": g.tolist(),
            "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min())}


def rescore_min(orig, rows: list[dict], ref: np.ndarray):
    """The search's archive with every G_min score recomputed against `ref` from the stored member rows (design 6.3)."""
    by = {exact_key(e["knobs"]): np.asarray(e["member_rows"]) for e in rows}
    arch = {}
    for k, e in orig.archive.items():
        f = float((by[k] - ref).mean(axis=1).min()) if k in by else e.f
        arch[k] = replace(e, f=f)
    best = max(arch.values(), key=lambda e: e.f)
    return replace(orig, archive=arch, best_knobs=dict(best.knobs), best_f=best.f)


# ---- orchestration -----------------------------------------------------------------------------------------------------

def _stage_record_path(stage: str, job: dict, out: Path) -> Path:
    if stage in ("search", "dependent"):
        return path_of(out, job["id"])
    if stage == "evaluate":
        return eval_path(out, job["id"])
    return Path(out) / "doubling" / (_safe(job["id"]) + ".json")


def _inputs(job: dict) -> set:
    """The records an evaluation or a doubling check depends on (the diagnostic has none but the freeze)."""
    if job["objective"] == "diagnostic":
        return set()
    ids = {job["id"]}
    if job["objective"] in ("W0", "W1"):
        ids.add(f"welfare_select/{job['context']}/{job['rule']}/{job['objective']}")
    if job["objective"] in ("profit", "W1"):
        ids.add(f"reference/{job['context']}/{job['rule']}")
    if job["objective"] in ("total", "min"):
        ids.add(f"joint_reference/{job['context']}/{_coalition_tag(job)}")
    if job["objective"] == "min":
        ids.add(f"coalition_select/{job['context']}/{_coalition_tag(job)}")
    return ids


def _run_one(stage: str, job: dict, out: str, cuts: int, h4_excluded: bool, catalog: list | None = None) -> str:
    out = Path(out); catalog = catalog or [job]
    if stage == "reference":
        return _run_reference(job, out, cuts, h4_excluded, catalog)
    if stage == "cross":
        return _run_cross(job, out, catalog)
    if stage in COALITION_STEPS:
        return coalition_step(stage, job, out, catalog)
    p = _stage_record_path(stage, job, out); rec = read(p)
    want = stage_upstream(stage, job, catalog, cuts, h4_excluded)
    def check():
        if set(rec.get("upstream") or {}) != want:
            raise ValueError("dependency set")
        validate(job, stage, rec, {u: path_of(out, u) for u in want})
        if stage == "evaluate":                                         # a damaged current record is recomputed, not skipped
            bad = _schema_problems(job, rec, len(job["mkt"]["seeds_eval"]))
            if bad:
                raise ValueError(bad)
        if stage == "doubling" and "heldout" not in rec:
            raise ValueError("doubling record without its held-out diagnostic")
    if reusable(p, rec, job["provenance"], check):
        return "skipped"
    body = {"search": stage_search, "dependent": stage_dependent, "evaluate": stage_evaluate}.get(stage)
    rec = body(job, out) if body else stage_doubling(job, out, cuts, h4_excluded)
    upstream = rec.pop("upstream", None)
    if stage in ("evaluate", "doubling") or upstream is None:
        upstream = {u: sha_file(path_of(out, u)) for u in sorted(want)}
    write(p, {"stage": stage, "id": job["id"], "provenance": job["provenance"], "upstream": upstream, **rec})
    return "done"


def _pool(stage, jobs, out, workers, cuts, h4_excluded, catalog=None) -> list:
    if workers <= 1 or len(jobs) <= 1:
        return [_run_one(stage, j, str(out), cuts, h4_excluded, catalog) for j in jobs]
    with ProcessPoolExecutor(max_workers=workers) as ex:
        n = len(jobs)
        return list(ex.map(_run_one, [stage] * n, jobs, [str(out)] * n, [cuts] * n, [h4_excluded] * n, [catalog] * n))


def run(stage: str, jobs: list[dict], out: Path, workers: int = 1, cuts: int = 0, h4_excluded: bool = False, catalog: list | None = None) -> dict:
    """`jobs` is the execution subset; `catalog` (default: `jobs`) is the full job list that freeze checks and
    acceptance validate against. Every stage but freeze runs its `_waves` calls in order through `_pool`."""
    out = Path(out); res = {}; catalog = catalog if catalog is not None else jobs
    if stage not in STAGES or stage == "verify":
        raise SystemExit(f"unknown stage {stage!r}")
    if stage == "freeze":
        for ctx in sorted({j["context"] for j in jobs}):
            stage_freeze(ctx, catalog, out, cuts, h4_excluded); res[ctx] = "frozen"
        return res
    calls = _waves(stage, jobs, catalog)
    if stage in ("evaluate", "cross", "doubling"):                        # each only after the context's freeze is accepted again
        for ctx in sorted({i["context"] for _, items in calls for i in items}):
"""Peak resident memory (plan section 7). Usage: churn_memory.py P   (P = none, 0.01 or 0.05): one 200-seed profile on
