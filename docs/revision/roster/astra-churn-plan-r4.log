  338 def preflight_sample(stage: str, jobs: list[dict]) -> list[dict]:
  339     """The tasks the memory preflight runs for real: one evaluate task per rule; one doubling task."""
  340     if stage == "evaluate":
  341         seen, out = set(), []
  342         for j in jobs:
  343             if j.get("rule") not in seen:
  344                 seen.add(j.get("rule")); out.append(j)
  345         return out
  346     return jobs[:1] if stage == "doubling" else []
