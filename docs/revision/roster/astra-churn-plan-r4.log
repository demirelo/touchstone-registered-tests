  361 def memory_preflight(stage: str, jobs: list[dict], out, requested: int, runner=None, limit: int | None = None, parent: int | None = None,
  362                      margin: float = 1.25) -> dict:
  363     """Pod-side, before a four-profile stage (plan section 7): run the sample tasks for real in child processes, take the
  364     largest peak, add a margin of 25 percent for variation across markets, rules and winners, and choose the workers that
  365     fit the memory limit beside the parent. The measured tasks' records are kept and not run again."""
  366     import resource
  367     import time
  368     t0 = time.time(); runner = runner or _measure_child; sample = preflight_sample(stage, jobs)
  369     peaks = {j["id"]: int(runner(stage, j, out, jobs)) for j in sample}
  370     peak = max(peaks.values())
  371     parent = parent if parent is not None else resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == "darwin" else 1024)
  372     limit = limit if limit is not None else memory_limit()
  373     w = plan_workers(limit, int(margin * peak), parent, requested)
  374     rec = {"stage": stage, "limit_bytes": limit, "task_peak_bytes": peak, "peaks": peaks, "margin": margin, "parent_bytes": parent,
  375            "requested": requested, "workers": w, "measured": [j["id"] for j in sample], "seconds": time.time() - t0}
  376     write(Path(out) / f"memory_preflight_{stage}.json", rec)
  377     return rec
  378 
