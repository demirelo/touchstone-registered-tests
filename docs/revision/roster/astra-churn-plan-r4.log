  256 def gate_compare(src, out, rid: str, cid: str, require_identical: bool = False) -> dict:
  257     """The p = 0 gate (plan draft 2, section 3 c): the churn cell `cid` at p = 0 against the registered cell `rid`, by the
  258     reset driver's draft-5 criteria for the search and evaluation (`compare`) and the doubling check (`compare_doubling`)."""
  259     view = Path(out) / "gate_view"; _mapped_view(out, view, cid, rid)
  260     s, d = F.compare(src, view, rid), F.compare_doubling(src, view, rid)
  261     ok = bool(s["pass"] and d["pass"])
  262     same = bool(ok and s.get("identical") and d.get("max_knob_rel") == 0 and d.get("max_change_abs") == 0 and d.get("max_gain_abs") == 0)
  263     res = {"stage": "churn p=0 gate", "registered": rid, "churn": cid, "pass": ok, "identical": same, "require_identical": bool(require_identical),
  264            "gate_ok": F.pod_gate_ok({"pass": ok, "identical": same}, require_identical), "search": s, "doubling": d}
  265     write(Path(out) / "gate.json", res)
  266     return res
