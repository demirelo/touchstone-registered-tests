   296	def inventory(out, p: float) -> dict:
   297	    inv = F.inventory(out)
   298	    inv["environment"]["churn_driver_sha256"] = sha_file(Path(__file__)); inv["churn"] = float(p); inv["deviations"] = list(DEVIATIONS)
   299	    write(Path(out) / "inventory.json", inv)
   300	    return inv
