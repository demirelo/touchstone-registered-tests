   31 R = F.R
   32 RULES = ("F111", "C*", "F000")
   33 MARKETS = F.MARKETS
   34 RATES = (0.01, 0.05)
   35 AGE_EDGES = (0, 10, 20, 50, 200)
   36 DEVIATIONS = (
   37     "follow-up beyond the registered manifest: honest opponents churn with probability p per round (not in the protocol)",
   38     "the frozen truthful reference of each (market, rule) is reused and re-evaluated under churn, not reselected",
   39     "doubling checks for every churn cell; the original freeze is replaced by this script's freeze and acceptance check",
