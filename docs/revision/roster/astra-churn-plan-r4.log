   419	def main(argv=None) -> int:
   420	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   421	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True)
   422	    ap.add_argument("--draw", default=str(F.ROOT / "results/v2/draw/draw.json")); ap.add_argument("--instances", default=str(F.ROOT / "results/v2/draw/instances.json"))
   423	    ap.add_argument("--cfgs", default=str(F.ROOT / "results/v2/deviation/cfg_linux.json")); ap.add_argument("--addendum", default=str(F.ROOT / "results/v2/report/addendum.json"))
   424	    ap.add_argument("--params", default=str(F.ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   425	    ap.add_argument("--rules", default=",".join(RULES)); ap.add_argument("--rates", default=",".join(f"{p:g}" for p in RATES))
   426	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
   427	    ap.add_argument("--workers-search", dest="workers_search", type=int, default=16); ap.add_argument("--workers-eval", dest="workers_eval", type=int, default=9)
   428	    ap.add_argument("--started", type=float, default=None, help="epoch seconds of pod allocation; spend is billed from it")
   429	    ap.add_argument("--stop-usd", dest="stop_usd", type=float, default=STOP_USD)
   430	    ap.add_argument("--usd-per-hour", dest="usd_per_hour", type=float, default=None, help="the pod's actual hourly price (required in production)")
   431	    ap.add_argument("--prior-usd", dest="prior_usd", type=float, default=0.0, help="charges of earlier failed attempts of this arm")
   432	    ap.add_argument("--gate", choices=("first", "only", "skip"), default="first", help="the p = 0 reproduction gate (plan section 3 c)")
   433	    ap.add_argument("--require-identical", dest="req_id", action="store_true", help="the pod gate: bit identity (the author's decision)")
   434	    ap.add_argument("--smoke", action="store_true")
   435	    a = ap.parse_args(argv); base = Path(a.out); F.check_out(base, a.src)
   436	    if not a.smoke:
   437	        check_started(a.started)
   438	        if a.usd_per_hour is None or not a.usd_per_hour > 0:
   439	            raise SystemExit("churn arm refused: --usd-per-hour must be the pod's actual hourly price")
   440	        if a.gate == "skip":
   441	            raise SystemExit("churn arm refused: production runs cannot skip the gate")
   442	        if a.stage != "all":
   443	            require_gate(base, a.req_id)
   444	        base.mkdir(parents=True, exist_ok=True)
   445	        write(base / "run.json", {"started": a.started, "usd_per_hour": a.usd_per_hour, "prior_usd": a.prior_usd, "stop_usd": a.stop_usd})
   446	    if a.usd_per_hour is None:
   447	        a.usd_per_hour = POD_USD_PER_HOUR
   448	    from sim.records import cfg_from_dict
   449	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   450	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   451	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   452	    params = json.loads(Path(a.params).read_text())
   453	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if a.stage == "all" else (a.stage,)
   454	    install()
   455	    if a.gate != "skip" and a.stage == "all":
   456	        out = base / "gate-p0"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   457	        jobs = build_jobs(root, cfgs, params, salt_sha, 0.0, (GATE_CELL[0],), (GATE_CELL[1],), a.smoke)
   458	        _run_rate(out, jobs, ("inputs", "search", "freeze", "evaluate", "doubling", "inventory"), a, salt_sha, container, 0.0, a.started)
   459	        rid = R.cell_id(f"{GATE_CELL[0]}@rho0.2", GATE_CELL[1], "D2+H3", "profit")
   460	        g = gate_compare(a.src, out, rid, jobs[0]["id"], a.req_id); inventory(out, 0.0)
   461	        print(json.dumps({"gate_ok": g["gate_ok"], "identical": g["identical"], "search": g["search"].get("problems"), "doubling": g["doubling"].get("problems")}), flush=True)
   462	        if not g["gate_ok"] and not a.smoke:
   463	            print("churn arm stopped: the p = 0 gate failed", file=sys.stderr)
   464	            return 1
   465	        if a.gate == "only":
   466	            return 0 if g["gate_ok"] else 1
   467	    if not a.smoke:
   468	        require_gate(base, a.req_id)
   469	    for p in (float(x) for x in a.rates.split(",")):
   470	        out = base / f"p{p:g}"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   471	        jobs = build_jobs(root, cfgs, params, salt_sha, p, tuple(a.markets.split(",")), tuple(a.rules.split(",")), a.smoke)
   472	        _run_rate(out, jobs, steps, a, salt_sha, container, p, a.started)
   473	    return 0
