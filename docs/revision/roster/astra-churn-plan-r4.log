  426     ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
  427     ap.add_argument("--workers-search", dest="workers_search", type=int, default=16); ap.add_argument("--workers-eval", dest="workers_eval", type=int, default=9)
  428     ap.add_argument("--started", type=float, default=None, help="epoch seconds of pod allocation; spend is billed from it")
  429     ap.add_argument("--stop-usd", dest="stop_usd", type=float, default=STOP_USD)
