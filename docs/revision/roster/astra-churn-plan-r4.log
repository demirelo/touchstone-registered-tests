  105 def churn_job(job: dict, p: float) -> dict:
  106     rid = f"{job['id']}|churn{p:g}"
  107     return {**job, "id": rid, "churn": float(p), "provenance": {**job["provenance"], "id": rid, "churn": float(p)}}
  108 
  109 
  110 def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, p: float, markets=MARKETS, rules=RULES, smoke: bool = False) -> list[dict]:
  111     jobs = []
  112     for m in markets:
  113         mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
  114         jobs += [churn_job(R.job(mkt, r, "D2+H3", "profit", smoke=smoke, params=params), p) for r in rules]
  115     return jobs
  116 
  117 
  118 def _init_worker() -> None:
  119     install()
  120 
  121 
  122 def run_stage(stage: str, jobs: list[dict], out, workers: int = 1) -> list[str]:
  123     install()
  124     if workers <= 1 or len(jobs) <= 1:
  125         return [R._run_one(stage, j, str(out), F.CUTS, F.H4_EXCLUDED, jobs) for j in jobs]
  126     with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
  127         n = len(jobs)
  128         return list(ex.map(R._run_one, [stage] * n, jobs, [str(out)] * n, [F.CUTS] * n, [F.H4_EXCLUDED] * n, [jobs] * n))
  129 
  130 
  131 def _newest_by_first_offer(r, focal: int) -> float:
  132     """The mechanism-relevant statistic (sim/mechanisms/factorial.py: R3 ages an identity from its first offer and ranks
  133     the identities holding assigned jobs): over the rounds in which the focal identity holds assigned jobs, the share in
  134     which its first-offer round is strictly the latest among the identities holding assigned jobs."""
  135     first: dict = {}; hits = n = 0
  136     for t, h in enumerate(r.history):
  137         for i in getattr(h, "offers", {}) or {}:
  138             first.setdefault(int(i), t)
  139         holders = {int(i) for i in h.assignment.values()}
  140         mine = [i for i in holders if r.entity_of[i] == focal]
  141         if not mine:
  142             continue
  143         n += 1; f = first.get(mine[0], t); latest = max(first.get(i, t) for i in holders)
  144         hits += int(f == latest and sum(1 for i in holders if first.get(i, t) == latest) == 1)
  145     return hits / n if n else 0.0
  146 
  147 
  148 def _uniquely_newest(r, focal: int) -> float:
  149     """Creation-time newest among the current identities: the share of rounds in which the focal provider's current
  150     identity has strictly the latest creation round (initial identities tie at round 0). Not the order R3 uses."""
  151     T = len(r.history); born = list(r.identity_round); ent = list(r.entity_of); hits = 0
  152     for t in range(T):
  153         cur = {}
  154         for i, (e, b) in enumerate(zip(ent, born)):
  155             if b <= t:
  156                 cur[e] = i                                              # identities are numbered in creation order
  157         newest = max(born[i] for i in cur.values()); f = born[cur[focal]]
  158         hits += int(f == newest and sum(1 for i in cur.values() if born[i] == newest) == 1)
  159     return hits / T if T else 0.0
  160 
  161 
  162 def newcomer_shares(results, focal: int, edges=AGE_EDGES) -> dict:
  163     """Audited share of served jobs by identity age (rounds since creation) for honest replacement identities, honest
  164     initial identities, and the focal provider's identities: per episode [served, audited] counts per age bin, and the
  165     pooled share per bin (None, "unavailable", when no job was served in the bin); honest replacements per episode; and
  166     per episode the share of rounds in which the focal identity is uniquely the newest."""
  167     cats = ("honest_replacement", "honest_initial", "focal"); nb = len(edges) - 1
  168     per, reps, newest, offer_newest = [], [], [], []
  169     for r in results:
  170         cnt = {c: [[0, 0] for _ in range(nb)] for c in cats}
  171         reps.append(sum(1 for i, e in enumerate(r.entity_of) if e != focal and r.identity_generation[i] > 0))
  172         cat = lambda i: "focal" if r.entity_of[i] == focal else ("honest_replacement" if r.identity_generation[i] > 0 else "honest_initial")
  173         for t, h in enumerate(r.history):
  174             def put(i, k):
  175                 age = t - r.identity_round[i]
  176                 for b in range(nb):
  177                     if edges[b] <= age < edges[b + 1]:
  178                         cnt[cat(i)][b][k] += 1; return
  179             for i in h.assignment.values():
  180                 put(i, 0)
  181             for a in h.audits:
  182                 put(a.provider, 1)
  183         per.append(cnt); newest.append(_uniquely_newest(r, focal)); offer_newest.append(_newest_by_first_offer(r, focal))
  184     out = {}
  185     for c in cats:
  186         rows = []
  187         for b in range(nb):
