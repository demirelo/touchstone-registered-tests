   304	        write(base / "doubling" / (C.R._safe(i) + ".json"), {"stage": "doubling", "incomplete": False, "attack_change": 0.0, "reference_change": 0.0,
   305	                                                               "heldout": {"knobs": k, "seeds": [1, 2], "gain": gain}})
