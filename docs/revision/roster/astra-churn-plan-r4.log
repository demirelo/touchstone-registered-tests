   131	def _newest_by_first_offer(r, focal: int) -> float:
   132	    """The mechanism-relevant statistic (sim/mechanisms/factorial.py: R3 ages an identity from its first offer and ranks
   133	    the identities holding assigned jobs): over the rounds in which the focal identity holds assigned jobs, the share in
   134	    which its first-offer round is strictly the latest among the identities holding assigned jobs."""
   135	    first: dict = {}; hits = n = 0
   136	    for t, h in enumerate(r.history):
   137	        for i in getattr(h, "offers", {}) or {}:
   138	            first.setdefault(int(i), t)
   139	        holders = {int(i) for i in h.assignment.values()}
   140	        mine = [i for i in holders if r.entity_of[i] == focal]
   141	        if not mine:
   142	            continue
   143	        n += 1; f = first.get(mine[0], t); latest = max(first.get(i, t) for i in holders)
   144	        hits += int(f == latest and sum(1 for i in holders if first.get(i, t) == latest) == 1)
   145	    return hits / n if n else 0.0
   146	
   147	
   148	def _uniquely_newest(r, focal: int) -> float:
   149	    """Creation-time newest among the current identities: the share of rounds in which the focal provider's current
   150	    identity has strictly the latest creation round (initial identities tie at round 0). Not the order R3 uses."""
   151	    T = len(r.history); born = list(r.identity_round); ent = list(r.entity_of); hits = 0
   152	    for t in range(T):
   153	        cur = {}
   154	        for i, (e, b) in enumerate(zip(ent, born)):
   155	            if b <= t:
   156	                cur[e] = i                                              # identities are numbered in creation order
   157	        newest = max(born[i] for i in cur.values()); f = born[cur[focal]]
   158	        hits += int(f == newest and sum(1 for i in cur.values() if born[i] == newest) == 1)
   159	    return hits / T if T else 0.0
