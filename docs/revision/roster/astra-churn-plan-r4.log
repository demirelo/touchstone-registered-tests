   317	def plan_workers(limit: int, task_peak: int, parent: int, requested: int, headroom: float = 0.9) -> int:
   318	    """Workers for the four-profile stages that fit the memory limit: floor((headroom x limit - parent) / task peak)."""
   319	    n = int((headroom * limit - parent) // task_peak)
   320	    if n < 1:
   321	        raise SystemExit(f"churn arm refused: memory limit {limit} bytes holds no {task_peak}-byte task")
   322	    return min(int(requested), n)
   323	
   324	
   325	def memory_limit() -> int:
   326	    """The cgroup memory limit (v2 or v1), else the physical memory."""
   327	    import os
   328	    for f in ("/sys/fs/cgroup/memory.max", "/sys/fs/cgroup/memory/memory.limit_in_bytes"):
   329	        try:
   330	            v = Path(f).read_text().strip()
   331	            if v.isdigit() and int(v) < 2 ** 60:
   332	                return int(v)
   333	        except OSError:
   334	            pass
   335	    return os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES")
   336	
   337	
   338	def preflight_sample(stage: str, jobs: list[dict]) -> list[dict]:
   339	    """The tasks the memory preflight runs for real: one evaluate task per rule; one doubling task."""
   340	    if stage == "evaluate":
   341	        seen, out = set(), []
   342	        for j in jobs:
   343	            if j.get("rule") not in seen:
   344	                seen.add(j.get("rule")); out.append(j)
   345	        return out
   346	    return jobs[:1] if stage == "doubling" else []
   347	
   348	
   349	def _measure_child(stage: str, job: dict, out, catalog: list[dict]) -> int:
   350	    """Run one real stage task of `job` in a child process (its record is written as in production) and return the
   351	    child's peak RSS in bytes."""
   352	    import pickle
   353	    import subprocess
   354	    jp = Path(out) / f"memory_preflight_{stage}.pkl"; jp.write_bytes(pickle.dumps((stage, job, catalog)))
   355	    r = subprocess.run([sys.executable, str(HERE / "churn_memory.py"), "--task", str(jp), str(out)], capture_output=True, text=True)
   356	    if r.returncode != 0:
   357	        raise SystemExit(f"churn arm refused: memory preflight failed: {r.stderr[-300:]}")
   358	    return int(json.loads(r.stdout.strip().splitlines()[-1])["peak_rss_bytes"])
   359	
   360	
   361	def memory_preflight(stage: str, jobs: list[dict], out, requested: int, runner=None, limit: int | None = None, parent: int | None = None,
   362	                     margin: float = 1.25) -> dict:
   363	    """Pod-side, before a four-profile stage (plan section 7): run the sample tasks for real in child processes, take the
   364	    largest peak, add a margin of 25 percent for variation across markets, rules and winners, and choose the workers that
   365	    fit the memory limit beside the parent. The measured tasks' records are kept and not run again."""
   366	    import resource
   367	    import time
   368	    t0 = time.time(); runner = runner or _measure_child; sample = preflight_sample(stage, jobs)
   369	    peaks = {j["id"]: int(runner(stage, j, out, jobs)) for j in sample}
   370	    peak = max(peaks.values())
   371	    parent = parent if parent is not None else resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == "darwin" else 1024)
   372	    limit = limit if limit is not None else memory_limit()
   373	    w = plan_workers(limit, int(margin * peak), parent, requested)
   374	    rec = {"stage": stage, "limit_bytes": limit, "task_peak_bytes": peak, "peaks": peaks, "margin": margin, "parent_bytes": parent,
   375	           "requested": requested, "workers": w, "measured": [j["id"] for j in sample], "seconds": time.time() - t0}
   376	    write(Path(out) / f"memory_preflight_{stage}.json", rec)
   377	    return rec
   378	
   379	
   380	STAGE_SECONDS = {"search": 2084.3, "evaluate": 120.0, "doubling": 997.8, "diagnostics": 60.0}   # benchmark, per job (plan section 7)
   381	
   382	
   383	def _waves(n: int, w: int) -> int:
   384	    return -(-n // max(1, w)) if n > 0 else 0
   385	
   386	
   387	def _run_rate(out, jobs, steps, a, salt_sha, container, p, started) -> None:
   388	    F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
   389	    if not a.smoke:
   390	        F.check_pairing(a.src, jobs)
   391	    slow = 1.33 if p > 0 else 1.0; w_mem = a.workers_eval                     # the memory limit, kept for every later stage
   392	    cap = lambda need: check_cap(started, need, a.stop_usd, a.usd_per_hour, prior_usd=a.prior_usd)
   393	    for st in steps:
   394	        if st == "inputs":
   395	            F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
   396	        elif st == "search":
   397	            cap(STAGE_SECONDS["search"] * slow * _waves(len(jobs), a.workers_search)); run_stage("search", jobs, out, a.workers_search)
   398	        elif st == "freeze":
   399	            F.prefreeze(out, jobs)
   400	        elif st in ("evaluate", "doubling"):
   401	            sec = STAGE_SECONDS[st] * slow
   402	            k = len(preflight_sample(st, jobs)) if (not a.smoke and len(jobs) > 1) else 0
   403	            cap(sec * (k + _waves(len(jobs) - k, w_mem)))                       # admission includes the serial preflight tasks
   404	            F.accept(out, jobs, salt_sha, container, src=a.src)
   405	            rest = jobs
   406	            if k:
   407	                mp = memory_preflight(st, jobs, out, w_mem); w_mem = mp["workers"]
   408	                rest = [j for j in jobs if j["id"] not in set(mp["measured"])]
   409	                cap(sec * _waves(len(rest), w_mem))                             # admission again with the chosen workers
   410	            run_stage(st, rest, out, w_mem)
   411	        elif st == "diagnostics":
   412	            cap(STAGE_SECONDS["diagnostics"] * slow * _waves(len(jobs), w_mem))
   413	            write(Path(out) / "diagnostics.json", diagnostics(out, jobs, w_mem))
   414	        else:
   415	            inventory(out, p)
   416	        print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs), "workers_memory": w_mem}), flush=True)
   417	
