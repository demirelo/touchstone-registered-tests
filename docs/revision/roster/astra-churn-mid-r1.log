   334	def validate_diagnostics(diag: dict, markets, n_seeds: int = 200, seeds: dict | None = None) -> None:
   335	    """Astra r1: before scoring, check the driver's summaries against their own counts. Every (market, rule, winner) cell
   336	    exists with one episode per seed; each bin's served and audited totals equal the sums of the per-episode counts and
   337	    its share is audited / served (None when nothing was served); the market-pooled share per bin is the mean of the
   338	    available market shares, with that count; the newest shares are in [0, 1] or None. Review r2: the four age bins in order
   339	    at every level, finite shares, and unique seed identifiers (equal to the market's evaluation seeds when given)."""
   340	    def finite_share(x, what):
   341	        if x is not None and not (isinstance(x, (int, float)) and math.isfinite(x) and 0 <= x <= 1):
   342	            raise ValueError(f"{what}: share {x} is not a finite value in [0, 1]")
   343	    for r in RULES:
   344	        for w in VERS:
   345	            by_m = {}
   346	            for m in markets:
   347	                cell = (diag.get("cells", {}).get(f"{m}@rho0.2|{r}") or {}).get(w)
   348	                if cell is None:
   349	                    raise ValueError(f"diagnostics cell missing: {m}|{r}|{w}")
   350	                sh = cell["shares"]; per = sh["per_episode"]; cs = list(cell.get("seeds", []))
   351	                if len(cs) != n_seeds or len(set(cs)) != len(cs) or (seeds is not None and cs != list(seeds[m])):
   352	                    raise ValueError(f"{m}|{r}|{w}: seed identifiers are not the market's {n_seeds} unique evaluation seeds")
   353	                if len(per) != n_seeds or len(sh["focal_newest_by_first_offer_assigned"]) != n_seeds:
   354	                    raise ValueError(f"{m}|{r}|{w}: {len(per)} episodes (expected {n_seeds})")
   355	                for x in sh["focal_newest_by_first_offer_assigned"] + sh["focal_newest_by_creation"]:
   356	                    if x is not None and not (math.isfinite(x) and 0 <= x <= 1):
   357	                        raise ValueError(f"{m}|{r}|{w}: newest share {x} outside [0, 1]")
   358	                for c in CATS:
   359	                    if [tuple(row["age"]) for row in sh[c]] != list(AGE_BINS) or any(len(e[c]) != len(AGE_BINS) for e in per):
   360	                        raise ValueError(f"{m}|{r}|{w}|{c}: age bins are not {AGE_BINS} in order")
   361	                    for b, row in enumerate(sh[c]):
   362	                        finite_share(row["share"], f"{m}|{r}|{w}|{c} bin {b}")
   363	                        sv = sum(e[c][b][0] for e in per); au = sum(e[c][b][1] for e in per)
   364	                        if (row["served"], row["audited"]) != (sv, au):
   365	                            raise ValueError(f"{m}|{r}|{w}|{c} bin {b}: totals differ from the per-episode counts")
   366	                        want = au / sv if sv else None
   367	                        if (want is None) != (row["share"] is None) or (want is not None and abs(row["share"] - want) > TOL):
   368	                            raise ValueError(f"{m}|{r}|{w}|{c} bin {b}: share is not audited / served")
   369	                by_m[m] = sh
   370	            pooled = (diag.get("pooled") or {}).get(f"{r}|{w}")
   371	            if pooled is None:
   372	                raise ValueError(f"pooled diagnostics missing: {r}|{w}")
   373	            for c in CATS:
   374	                if len(pooled[c]) != len(AGE_BINS):
   375	                    raise ValueError(f"pooled {r}|{w}|{c}: age bins are not {AGE_BINS} in order")
   376	                for b, row in enumerate(pooled[c]):
   377	                    finite_share(row["share"], f"pooled {r}|{w}|{c} bin {b}")
   378	                    v = [by_m[m][c][b]["share"] for m in markets if by_m[m][c][b]["share"] is not None]
   379	                    want = sum(v) / len(v) if v else None
   380	                    if row["markets"] != len(v) or (want is None) != (row["share"] is None) or (want is not None and abs(row["share"] - want) > TOL):
   381	                        raise ValueError(f"pooled share {r}|{w}|{c} bin {b} differs from the market shares")
   382	
   383	
   384	def diag_summary(diag: dict) -> dict:
   385	    """Per rule and winner: honest replacements per episode, and the share of rounds in which the focal identity's first-offer
   386	    round is strictly the latest among identities holding assigned jobs (ties excluded), averaged over the episodes of a
   387	    market (episodes without such rounds left out) and then over markets with equal weights; not one pooled fraction of
   388	    rounds. The driver's market-pooled age-bin shares are copied (checked by validate_diagnostics)."""
   389	    out = {}
   390	    cells = diag.get("cells", {})
   391	    for r in RULES:
   392	        for w in VERS:
   393	            reps, newest = [], []
   394	            for k, cell in cells.items():
   395	                if k.split("|")[-1] != r or w not in cell:
   396	                    continue
   397	                s = cell[w]["shares"]; reps.append(float(s["honest_replacements_per_episode"]))
   398	                xs = [x for x in s["focal_newest_by_first_offer_assigned"] if x is not None and math.isfinite(x)]
   399	                if xs:
   400	                    newest.append(float(np.mean(xs)))
   401	            out[f"{r}|{w}"] = {"honest_replacements_per_episode": float(np.mean(reps)) if reps else None,
   402	                               "focal_newest_first_offer": float(np.mean(newest)) if newest else None,
   403	                               "markets": len(reps), "pooled_bins": diag.get("pooled", {}).get(f"{r}|{w}")}
   404	    return out
   405	
   406	
   407	def _fmt(e, d: int = 3) -> str:
   408	    p = e["pooled"]
   409	    if p["estimate"] is None:
   410	        return "--"
   411	    lo, hi = p["ci95"] or (None, None)
   412	    n = lambda x: f"{x:.{d}f}".replace("-", "$-$")          # a typeset minus, not a hyphen
   413	    return n(p["estimate"]) + ("" if lo is None else f" [{n(lo)}, {n(hi)}]")
