     1	#!/bin/bash
     2	# Snapshot guard: run a private copy, so an edit to this file cannot reach a running launch.
     3	if [ -z "${LAUNCH_SNAPSHOT:-}" ]; then
     4	  snapf="/Users/oemer.demirel/Projects/touchstone/results/pods/snap_$(basename "$0" .sh)_$$.sh"; cp "$0" "$snapf"
     5	  LAUNCH_SNAPSHOT="$snapf" exec bash "$snapf" "$@"
     6	fi
     7	# Honest-churn arm (docs/revision/churn/churn-plan.md, draft 6) on one Runpod CPU pod: generated from reset_pod.sh after
     8	# its review rounds r9-r18 (pod safety, launch lock, spend records unchanged). Order on the pod: the p = 0 gate through the
     9	# churn path (bit identity, --require-identical; the author's decision), then the 36 churn cells (two rates) stage by
    10	# stage (search with all vCPUs; evaluate, doubling and diagnostics with at most WEVAL workers, the driver's memory
    11	# preflight may choose fewer), then the inventory. The driver also refuses a stage whose admission would pass the cap
    12	# (allocation time, actual price, and PRIOR plus this launch's failed attempts at the ceiling). Spending (the author: do not kill jobs): at the reserved cap the pod stops BETWEEN stages
    13	# (a STOP file the remote script reads before each stage); only at HARD x the cap is the pod deleted mid-stage, as an
    14	# absolute guard. An EXIT/INT/TERM trap pulls what exists (only if the run started), deletes the pod and verifies it.
    15	# Spend (r16): the record is the account balance difference (podctl.py spend NAME, at least an hour after the watchdog
    16	# ends); this launcher prints only estimates. One launch per NAME at a time (NAME.launchlock; the watchdog releases it).
    17	# Usage: churn_pod.sh <code_tgz> <bundle_tgz> <tag> <cap_usd> <local_out>   (no spaces in paths)
    18	# Env: EXPECT (commit inside the code tarball), MAXCPH, optional WEVAL (default 9), MINMEM (default 28), HARD (default 1.3),
    19	# PRIOR (USD recorded for earlier launches of this arm, default 0), RATES (churn rates, default 0.01,0.05; amendment 1 adds
    20	# 0.02,0.03; each rate in {0.01, 0.02, 0.03, 0.05}, at most once).
    21	set -u
    22	PY=/opt/homebrew/bin/python3; P=/Users/oemer.demirel/Projects/touchstone/results/pods
    23	TGZ=${1:?code tarball}; BTGZ=${2:?bundle tarball}; TAG=${3:?tag}; CAP=${4:?cap_usd}; LOUT=${5:?local_out}; cd $P
    24	case "$TGZ$BTGZ$TAG$LOUT" in *[[:space:]]*) echo "refused: a path or tag contains whitespace"; exit 1 ;; esac
    25	EXPECT=${EXPECT:?commit}; MAXCPH=${MAXCPH:?max usd per hour}; WEVAL=${WEVAL:-9}; MINMEM=${MINMEM:-28}; HARD=${HARD:-1.3}; PRIOR=${PRIOR:-0}
    26	RATES=${RATES:-0.01,0.05}
    27	$PY -c "import sys; r=sys.argv[1].split(','); sys.exit(0 if r and len(set(r)) == len(r) and set(r) <= {'0.01','0.02','0.03','0.05'} else 1)" "$RATES" || { echo "refused: RATES must list distinct rates from 0.01,0.02,0.03,0.05"; exit 1; }
    28	$PY -c "import math,sys; x=float(sys.argv[1]); sys.exit(0 if math.isfinite(x) and x >= 0 else 1)" "$PRIOR" 2>/dev/null || { echo "refused: PRIOR must be a non-negative number"; exit 1; }
    29	# PRIOR counts against both deadlines (r1 review), so the arm's bound stays HARD x CAP across launches.
    30	$PY -c "import sys; sys.exit(0 if float(sys.argv[1]) < float(sys.argv[2]) else 1)" "$PRIOR" "$CAP" 2>/dev/null || { echo "refused: PRIOR must be below the cap"; exit 1; }
    31	mkdir -p "$LOUT" logs_c_$TAG
    32	$PY -c "import sys,tarfile; ms=tarfile.open(sys.argv[1]).getmembers(); d=[m.name for m in ms if m.name.split('/')[-1].startswith('._')]; o=[m.name for m in ms if m.uid!=0]; print('tarball guard: %d AppleDouble, %d non-root' % (len(d),len(o))); sys.exit(1 if d or o else 0)" "$TGZ" || { echo "code tarball refused"; exit 1; }
    33	hg=$(mktemp -d); tar xzf "$TGZ" -C "$hg" 2>/dev/null || { echo "code tarball refused: cannot unpack"; exit 1; }
    34	# Code guard (fails closed: every git call's status is checked): HEAD is EXPECT, protocol-v2 is an ancestor, the tree is
    35	# clean, every path changed since the tag is in the code freeze's allowed paths, and scripts/, sim/, tests/ equal the tag.
    36	guard() {
    37	  cd "$1" || return 1
    38	  [ "$(git rev-parse HEAD 2>/dev/null)" = "$EXPECT" ] || { echo "HEAD is not $EXPECT"; return 1; }
    39	  git merge-base --is-ancestor protocol-v2 HEAD || { echo "protocol-v2 is not an ancestor"; return 1; }
    40	  st=$(git status --porcelain) || { echo "git status failed"; return 1; }; [ -z "$st" ] || { echo "tree not clean: $st" | head -c 300; return 1; }
    41	  ch=$(git diff --name-only protocol-v2 HEAD) || { echo "git diff failed"; return 1; }
    42	  bad=$(echo "$ch" | grep -v -e '^docs/' -e '^experiments/v2/' -e '^paper/' -e '^sealed2/h4/' -e '^$' || true); [ -z "$bad" ] || { echo "changed outside the allowed paths: $bad" | head -c 300; return 1; }
    43	  git diff --quiet protocol-v2 -- scripts/ sim/ tests/ || { echo "scripts/, sim/ or tests/ differ from protocol-v2"; return 1; }
    44	  echo "code guard: ok at $(git rev-parse --short HEAD)"
    45	}
    46	( guard "$hg" ); g=$?; mv -- "$hg" ~/.Trash/hg_churn_$$
    47	[ $g -eq 0 ] || { echo "code tarball refused"; exit 1; }
    48	[ -n "${DRYRUN:-}" ] && { echo "dry run: guards passed; no pod created"; exit 0; }
    49	# verify DIR: every record in DIR/inventory.json exists with its hash.
    50	verify() { $PY - "$1" <<'PYV'
    51	import hashlib, json, sys
    52	from pathlib import Path
    53	d = Path(sys.argv[1]); inv = json.loads((d / "inventory.json").read_text())
    54	bad = [k for k, h in inv["records"].items() if not (d / k).is_file() or hashlib.sha256((d / k).read_bytes()).hexdigest() != h]
    55	print(f"verify {d.name}: {len(inv['records'])} records, {len(bad)} bad"); sys.exit(1 if bad else 0)
    56	PYV
    57	}
    58	# verify_run FILE STARTED USD_PER_HOUR PRIOR_USD STOP_USD: the driver's run.json (outside the inventories) parses and
    59	# holds exactly the admission inputs this launcher passed (churn launcher review r2).
    60	verify_run() { $PY - "$@" <<'PYR'
    61	import json, math, sys
    62	f, want = sys.argv[1], dict(zip(("started", "usd_per_hour", "prior_usd", "stop_usd"), map(float, sys.argv[2:6])))
    63	try:
    64	    got = json.loads(open(f).read()); ok = set(got) == set(want) and all(math.isclose(float(got[k]), v, abs_tol=1e-9) for k, v in want.items())
    65	except Exception:
    66	    ok = False
    67	print(f"verify run.json: {'ok' if ok else 'bad'}"); sys.exit(0 if ok else 1)
    68	PYR
    69	}
    70	verify_rates() { local r; for r in ${RATES//,/ }; do verify "$LOUT/followup-churn/p$r" || return 1; done; }   # amendment 1
    71	tmo() { perl -e 'alarm shift; exec @ARGV' "$@"; }
    72	NAME=ts-c-$TAG; DONE=$P/$NAME.done; ATT=$P/$NAME.attempts
    73	rm_ok() { [ -e "$1" ] && mv -- "$1" ~/.Trash/"$(basename "$1").$$"; true; }
    74	# One launch per NAME: the lock is taken before any marker changes; the watchdog (the last process) releases it.
    75	mkdir "$P/$NAME.launchlock" 2>/dev/null || { echo "LOCKED: $NAME.launchlock exists (another launch or its watchdog still runs; remove it only after checking)"; exit 1; }
    76	unlock() { $PY podctl.py unlock $NAME >/dev/null 2>&1; }
    77	# Spend records are never overwritten (r16): a launch is refused while the previous launch's spend is unrecorded; a
    78	# recorded one (NAME.spent, written by podctl.py spend) is moved with its inputs to spend_records/NAME.<time>/.
    79	spent_ok() { grep -Eq '^[0-9]+(\.[0-9]+)? USD ' "$P/$NAME.spent" 2>/dev/null; }   # a complete record only (r17)
    80	if [ -e "$P/$NAME.bal0" ] && ! spent_ok; then echo "refused: the previous launch's spend is not recorded (podctl.py spend $NAME)"; unlock; exit 1; fi
    81	if [ -e "$P/$NAME.spent" ] && ! spent_ok; then echo "refused: $NAME.spent is not a complete spend record"; unlock; exit 1; fi
    82	if spent_ok; then
    83	  arch="$P/spend_records/$NAME.$(date +%s)"; mkdir -p "$arch" || { echo "refused: cannot archive the spend record"; unlock; exit 1; }
    84	  for f in bal0 wdend spent attempts; do [ -e "$P/$NAME.$f" ] && { mv -- "$P/$NAME.$f" "$arch/" || { echo "refused: cannot archive $NAME.$f"; unlock; exit 1; }; }; done
    85	fi
    86	for f in "$DONE" "$P/$NAME.blocked" "$P/$NAME.request" "$P/$NAME.wdend" "$P/$NAME.ambiguous" "$P/$NAME.acct" "$P/$NAME.unpriced"; do rm_ok "$f"; done; : > "$ATT"
    87	b0=$(tmo 90 $PY podctl.py balance) || { echo "refused: account balance unknown"; unlock; exit 1; }
    88	echo "$b0" > "$P/$NAME.bal0" && [ -s "$P/$NAME.bal0" ] || { echo "refused: cannot write $NAME.bal0"; unlock; exit 1; }
    89	id=""; state="NOT STARTED"; rc=1; cph=0; a0=0; tfirst=0; unresolved=""; started=""; req=0; wd=""
    90	# Pod safety lives in podctl.py (test_podctl.py): fail-closed listing, deletion verified within
    91	# elapsed time, reconciliation, a creation block from the hard deadline, and a watchdog that runs on after this launcher
    92	# exits, until no pod named $NAME remains.
    93	cleanup() {
    94	  trap - EXIT INT TERM
    95	  if [ -n "$id" ] && [ -n "$started" ]; then
    96	    try=0
    97	    while :; do   # after RUN OK: keep the pod and retry until both directories verify, or until 2 min before the hard deadline
    98	      try=$((try+1)); ok=1
    99	      for d in followup-churn; do
   100	        t=1800
   101	        rem=$(( hard - 120 - $(date +%s) )); [ $rem -le 0 ] && { ok=0; break; }; [ $rem -lt $t ] && t=$rem
   102	        tmo $t $PY runpod.py pull $id "/root/touchstone/results/v2/$d/" "$LOUT/$d/" >/dev/null 2>&1 || ok=0
   103	      done
   104	      rem=$(( hard - 120 - $(date +%s) )); [ $rem -gt 0 ] && tmo $(( rem < 300 ? rem : 300 )) $PY runpod.py pull $id /root/touchstone/results/logs/ logs_c_$TAG/ >/dev/null 2>&1
   105	      if [ "$state" = "RUN OK" ] && [ $ok = 1 ]; then { verify "$LOUT/followup-churn/gate-p0" && verify_rates && verify_run "$LOUT/followup-churn/run.json" $a0 $cph $PRIORT $CAP; } || ok=0; fi
   106	      [ $ok = 1 ] && break
   107	      echo "$(date +%H:%M) pull or verification failed (try $try)"
   108	      if [ "$state" = "RUN OK" ]; then [ "$(date +%s)" -ge $(( hard - 120 )) ] && break; else [ $try -ge 3 ] && break; fi
   109	      sleep 60
   110	    done
   111	    [ $ok = 1 ] || { [ "$state" = "RUN OK" ] && state="RUN OK BUT RECORDS NOT VERIFIED"; rc=1; }
   112	  fi
   113	  if [ -n "$id" ]; then
   114	    if $PY podctl.py delete $id 1800; then echo "$(date +%H:%M) $id deleted (verified)"; echo "$id $(date +%s) deleted" >> "$ATT"; else echo "$(date +%H:%M) $id: deletion not verified in 30 min; the watchdog keeps trying (billing may continue)"; rc=1; unresolved=1; fi
   115	  fi
   116	  $PY podctl.py reconcile $NAME || { echo "$(date +%H:%M) reconcile failed; the watchdog keeps trying"; rc=1; unresolved=1; }
   117	  grep -qx pending "$P/$NAME.request" 2>/dev/null && { echo "$(date +%H:%M) a creation request is outstanding or ambiguous; the watchdog settles for 30 minutes"; unresolved=1; }
   118	  touch "$DONE"     # the watchdog then deletes any orphan pod and exits only after its settle time of empty listings
   119	  if [ -z "$wd" ] || ! kill -0 "$wd" 2>/dev/null; then
   120	    echo "$(date +%H:%M) WATCHDOG NOT RUNNING"; rc=1
   121	    if [ $req = 0 ]; then unlock; else unresolved=1; echo "$(date +%H:%M) $NAME.launchlock kept: no process deletes a late pod; check the Runpod console"; fi
   122	  fi
   123	  if [ "$req" = 0 ] && [ -e "$P/$NAME.bal0" ]; then   # no request was sent: nothing to record; keep the baseline as unused
   124	    mkdir -p "$P/spend_records" && mv -- "$P/$NAME.bal0" "$P/spend_records/$NAME.$(date +%s).bal0.unused"
   125	  fi
