   227	def accept(out, jobs: list[dict], salt_sha256: str, container: dict, src=None) -> None:
   228	    """Run before evaluation and before doubling: the freeze exists and every record in it, and every copied input,
   229	    still has its hash; the identity salt and the configurations are the recorded ones; with `src`, inputs.json holds
   230	    every input recomputed from the original records."""
   231	    check_salt(out, salt_sha256, jobs)
   232	    check_configs(jobs, container)
   233	    if src is not None:
   234	        have = read(Path(out) / "inputs.json") or {}
   235	        if bad := sorted(r for r, s in inputs(src, jobs).items() if have.get(r) != s):
   236	            _refuse(f"inputs.json lacks or differs on {bad[:3]}")
   237	    for ctx in sorted({j["context"] for j in jobs}):
   238	        fr = read(R.path_of(out, f"freeze/{ctx}"))
   239	        if fr is None or not fr.get("followup"):
   240	            _refuse(f"{ctx}: no follow-up freeze")
   241	        want = {**_ctx_inputs(out, ctx), **{j["id"]: None for j in jobs if j["context"] == ctx}}
   242	        if missing := sorted(set(want) - set(fr["records"])):
   243	            _refuse(f"{ctx}: the freeze lacks {missing}")
   244	        for r, sha in fr["records"].items():
   245	            p = R.path_of(out, r)
   246	            if not p.exists() or sha_file(p) != sha or (want.get(r) not in (None, sha)):
   247	                _refuse(f"{ctx}: {r} differs from the freeze")
   248	
