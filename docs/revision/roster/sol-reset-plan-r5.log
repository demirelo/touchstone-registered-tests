   210	def prefreeze(out, jobs: list[dict]) -> None:
   211	    """The pre-evaluation freeze of each context: its copied inputs and its new search records, with their hashes."""
   212	    for ctx in sorted({j["context"] for j in jobs}):
   213	        recs = dict(_ctx_inputs(out, ctx))
   214	        for j in (j for j in jobs if j["context"] == ctx):
   215	            p = R.path_of(out, j["id"]); rec = read(p)
   216	            if rec is None or rec.get("stage") != "search" or rec.get("provenance") != j["provenance"]:
   217	                _refuse(f"{j['id']}: no current search record to freeze")
   218	            recs[j["id"]] = sha_file(p)
   219	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED, "records": recs}
   220	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   221	        if old is not None and old != body:
   222	            _refuse(f"{p} exists with other records")
   223	        if old is None:
   224	            write(p, body)
