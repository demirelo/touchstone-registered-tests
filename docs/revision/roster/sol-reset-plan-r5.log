   285	def diagnostics(src, out, jobs: list[dict], report: dict) -> dict:
   286	    """Plan section 4 (draft 5), evaluation only: for each D2 job's (context, rule), the base and doubled D2+H3 winners and
   287	    the base D2 winner on the evaluation seeds with reset instrumentation; the switch g(winner) - g(winner with x = 0) for
   288	    the D2+H3 winners and the reverse switch g(D2 winner with x = 1) - g(D2 winner). The reference cancels in each switch,
   289	    so it is a difference of normalised profits."""
   290	    import numpy as np
   291	    from sim.cell import SeedCache, run_focal
   292	    res = {}
   293	    for j in jobs:
   294	        T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j); cache = SeedCache()
   295	        h3 = R.cell_id(j["context"], j["rule"], "D2+H3", "profit")
   296	        pols = {"d2h3_base": read(R.path_of(src, h3))["attack"]["best_knobs"], "d2h3_doubled": report["doubling"][h3]["heldout"]["knobs"],
   297	                "d2_base": with_x(read(R.path_of(out, j["id"]))["attack"]["best_knobs"], 0)}
   298	        runs = {k: run_focal(cell, lambda k=k: fam.make(dict(pols[k])), cache) for k in pols}
   299	        row = {k: {"knobs": pols[k], **reset_stats(runs[k].results, cell.focal), "mean_normalized": float(np.mean(runs[k].normalized))} for k in pols}
   300	        for k in ("d2h3_base", "d2h3_doubled"):
   301	            if int(pols[k].get("x", 0)) == 0:
   302	                row[k]["switch_x0"] = {"identical": True, "effect": 0.0}
   303	            else:
   304	                off = run_focal(cell, lambda k=k: fam.make(with_x(pols[k], 0)), cache)
   305	                row[k]["switch_x0"] = {"identical": False, "effect": float(np.mean(runs[k].normalized - off.normalized))}
   306	        on = run_focal(cell, lambda: fam.make(with_x(pols["d2_base"], 1)), cache)
   307	        row["d2_base"]["switch_x1"] = {"effect": float(np.mean(on.normalized - runs["d2_base"].normalized))}
   308	        res[f"{j['context']}|{j['rule']}"] = row
   309	    return res
