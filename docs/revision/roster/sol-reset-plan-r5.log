def _safe(s: str) -> str:
    return s.replace("|", "__").replace("/", "~").replace("*", "star")


def path_of(out: Path, rid: str) -> Path:
    if rid.startswith("freeze/"):
        return Path(out) / "freeze" / (rid.split("/", 1)[1] + ".json")
    if "|" in rid:
        objective = rid.split("|")[3]
        return Path(out) / ("dependent" if objective in ("W1", "total", "min") else "search") / (_safe(rid) + ".json")
    kind, ctx, rest = rid.split("/", 2)
    return Path(out) / kind / ctx / (_safe(rest) + ".json")


def eval_path(out: Path, rid: str) -> Path:
    return Path(out) / "evaluate" / (_safe(rid) + ".json")


# ---- search adapters ---------------------------------------------------------------------------------------------------

def search_family(cell: Cell, family: Family, cache: SeedCache, st: SearchSettings, twin, extra_incumbents: dict | None = None):
    inc = {"twin_best": twin.best_knobs, "honest_point": family.honest_point(), **(extra_incumbents or {})}
    return cma_search(Objective(cell, family, cache), family, st, 1, incumbents=inc)


BOUNDED_CONTROLS = ("X7-SC", "H4")                # design draft 7, 5.2 and 5.3: Sobol corner controls, never every corner
"""Stage records of the v2 runner: atomic JSON writes, tolerant reads (a missing or truncated file is absent), and
validation of a record's stage, provenance, and upstream hashes against the current files."""
from __future__ import annotations

import hashlib
import json
import os
import secrets
from pathlib import Path


def write(path, rec: dict) -> None:
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")       # unique per writer
    with open(tmp, "w") as f:
        json.dump(rec, f, default=float); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, p)


def read(path) -> dict | None:
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def sha_file(path) -> str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def validate(job: dict, stage: str, rec: dict, upstream: dict) -> None:
    """`upstream` maps each upstream record id to its current path; raises ValueError on any mismatch."""
    if rec.get("stage") != stage:
        raise ValueError(f"record stage {rec.get('stage')!r} is not {stage!r}")
    if rec.get("provenance") != job.get("provenance"):
        raise ValueError("record provenance differs from the job's")
    for rid, sha in (rec.get("upstream") or {}).items():
        p = upstream.get(rid)
        if p is None or not Path(p).exists() or sha_file(p) != sha:
            raise ValueError(f"upstream {rid} changed or is missing")
