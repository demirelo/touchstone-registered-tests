   130	def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, markets=MARKETS, smoke: bool = False) -> list[dict]:
   131	    """The frozen `job` for each restored cell, on the recorded (container) configuration of its market."""
   132	    jobs = []
