   254	def inventory(out) -> dict:
   255	    """Every output file with its hash, written after the outputs, so no record lists itself."""
   256	    out = Path(out)
   257	    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
   258	            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
   259	    inv = {"stage": "inventory", "deviations": list(DEVIATIONS), "environment": environment(), "records": recs}
   260	    write(out / "inventory.json", inv)
   261	    return inv
