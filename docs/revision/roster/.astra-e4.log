"""Exploratory analyses on the second test's evaluation records, after the report (external review round 4, 2026-11-05).
None of them is registered; none changes a registered estimate or decision. Gains follow the records' definition,
g = (attacked profit - truthful reference profit) / (S*/N) with N = 10 (checked against the stored gain).

1. Q1 split: the pooled d = g_C* - g_F111 as an attacked-profit term plus a reference-profit term, equal market weights.
2. Welfare mixtures: an episode-level lottery between the selected W0 attack and a profitable attack of the same rule at
   the headline market (same frozen reference), with the largest W0 weight whose mean gain keeps a nonnegative one-sided
   95 percent lower bound on the evaluation seeds. This checks whether the W1 policy class is closed under randomisation;
   the weight is chosen on the evaluation seeds, so it is not an out-of-sample estimate.
3. Q4 diagnostics per fresh market: the B3 - R3 gain difference split into its two terms, and R3's audit spending and
   served share under the selected attack.
4. Stability: the registered-configuration re-evaluation (deviation/stability-result.json) beside the report.

Usage: posthoc_v2.py --records EVAL/all --report report.json --stability stability-result.json --out posthoc.json --tables DIR
"""
import argparse
import json
import sys
from pathlib import Path

import numpy as np

FRESH = tuple(f"fresh{i}" for i in range(6))
N = 10
Z = 1.645
PROFIT_FAMS = ("D2+H3", "X7-SC", "X5-AG/v2", "H4", "D2")


def safe(rid: str) -> str:
    return rid.replace("|", "__").replace("/", "~").replace("*", "star")      # revision_v2._safe


def _rec(out, rid):
    p = Path(out) / "evaluate" / (safe(rid) + ".json")
    return json.loads(p.read_text()) if p.exists() else None


def _terms(r):
    s = np.asarray(r["sstar"], dtype=float) / N
    return np.asarray(r["profit_attack"], dtype=float) / s, np.asarray(r["profit_ref"], dtype=float) / s


def split(out, markets, a: str, b: str, fam: str, n: int = N) -> dict:
    """d = g_a - g_b per market and pooled with equal market weights, as attacked term + reference term."""
    rows = {}
    for m in markets:
        ra, rb = _rec(out, f"{m}@rho0.2|{a}|{fam}|profit"), _rec(out, f"{m}@rho0.2|{b}|{fam}|profit")
        if ra is None or rb is None:
            continue
        (pa, ta), (pb, tb) = _terms(ra), _terms(rb)
        att, ref = pa - pb, -(ta - tb)
        rows[m] = {"estimate": float(np.mean(att + ref)), "attacked": float(np.mean(att)), "reference": float(np.mean(ref))}
    pooled = {k: float(np.mean([v[k] for v in rows.values()])) for k in ("estimate", "attacked", "reference")} if rows else {}
    return {"markets": rows, "pooled": pooled}


def mixture(gw0, ew0, gp, ep, grid: int = 2001) -> dict:
    """The largest W0 weight w with mean(w gw0 + (1-w) gp) - Z se >= 0, and the mixture's mean gain and efficiency."""
    gw0, ew0, gp, ep = (np.asarray(x, dtype=float) for x in (gw0, ew0, gp, ep))
    best = 0.0
    for w in np.linspace(0.0, 1.0, grid):
        g = w * gw0 + (1 - w) * gp
        if g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g)) >= 0:
            best = float(w)
    if best == 0.0 and not ((gp.mean() - Z * gp.std(ddof=1) / np.sqrt(len(gp))) >= 0):
        return {"weight": 0.0, "estimate": float(gp.mean()), "efficiency": float(ep.mean())}
    g, e = best * gw0 + (1 - best) * gp, best * ew0 + (1 - best) * ep
    return {"weight": best, "estimate": float(g.mean()), "lower": float(g.mean() - Z * g.std(ddof=1) / np.sqrt(len(g))),
            "efficiency": float(e.mean())}


def welfare_mixtures(out, rule: str) -> dict:
    ctx = "headline@rho0.2"; w0 = _rec(out, f"{ctx}|{rule}|D2+H3|W0"); w1 = _rec(out, f"{ctx}|{rule}|D2+H3|W1")
    ref = np.asarray(w1["normalized"]) - np.asarray(w1["constraint"]); gw0 = np.asarray(w0["normalized"]) - ref
    res = {"w0": {"estimate": float(gw0.mean()), "efficiency": float(np.mean(w0["eff"]))},
           "w1": {"estimate": float(np.mean(w1["constraint"])), "efficiency": float(np.mean(w1["eff"]))}, "mixtures": {}}
    for fam in PROFIT_FAMS:
        r = _rec(out, f"{ctx}|{rule}|{fam}|profit")
        if r is None or r["seeds"] != w0["seeds"]:
            continue
        mx = mixture(gw0, w0["eff"], r["gain"], r["eff_attack"])
        mx["weight_label"] = f"{round(100 * mx['weight'])} percent"
        res["mixtures"][fam] = mx
    feasible = {f: v for f, v in res["mixtures"].items() if v["weight"] > 0}
    if feasible:
        f = min(feasible, key=lambda k: feasible[k]["efficiency"]); res["best"] = {"family": f, **feasible[f]}
    return res


def q4_diagnostics(out) -> dict:
    res = {}
    for m in FRESH:
        sp = split(out, [m], "F000", "F111", "D2+H3")["markets"].get(m)
        r = _rec(out, f"{m}@rho0.2|F111|D2+H3|profit")
        if sp is None or r is None:
            continue
        res[m] = {**sp, "audit_spend": float(np.mean(r["audit_spend_attack"])), "served_share": float(np.mean(r["served_share_attack"])),
                  "efficiency": float(np.mean(r["eff_attack"]))}
    return res


def stability(report: dict, stab: dict) -> dict:
    q1 = {k: {"estimate_report": report["q1"]["tests"][k]["estimate"], "estimate_registered_cfg": v["estimate"],
              "category_report": report["q1"]["tests"][k]["category"], "category_registered_cfg": v["category"]}
          for k, v in stab["q1_new"].items()}
    shifts = [abs(c["mean_new"] - c["mean_old"]) for c in stab["cells"].values()]
    return {"q1": q1, "q4_k_report": report["q4"]["k"], "q4_k_registered_cfg": stab["q4_new"]["k"],
            "cells": len(shifts), "max_mean_shift": float(max(shifts)), "decisions_unchanged": bool(stab["decisions_unchanged"])}


def _f(x):
    return "n/a" if x is None else (f"\\ensuremath{{{x:.3f}}}" if x < 0 else f"{x:.3f}")


def tables(res: dict) -> dict:
    t = {}
    rows = [f"{fam} & {_f(v['pooled']['estimate'])} & {_f(v['pooled']['attacked'])} & {_f(v['pooled']['reference'])} \\\\"
            for fam, v in res["q1_split"].items()]
    t["q1_split"] = ("\\begin{tabular}{@{}lrrr@{}}\\toprule\nFamily & $d$ & Attacked term & Reference term \\\\\\midrule\n"
                     + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = []
    for r, v in res["welfare"].items():
        b = v.get("best")
        rows.append(f"{r} & {_f(v['w1']['efficiency'])} & {_f(v['w0']['efficiency'])} & "
                    + (f"{b['family']} & {b['weight_label']} & {_f(b['estimate'])} & {_f(b['efficiency'])}" if b else "none & & &")
                    + " \\\\")
    t["welfare_mix"] = ("\\begin{tabular}{@{}lrrlrrr@{}}\\toprule\nRule & W1 eff. & W0 eff. & Mixed with & W0 weight & Mixed gain & Mixed eff. \\\\\\midrule\n"
                        + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = [f"{m} & {_f(v['estimate'])} & {_f(v['attacked'])} & {_f(v['reference'])} & {_f(v['audit_spend'])} & {_f(v['served_share'])} \\\\"
            for m, v in res["q4_diag"].items()]
    t["q4_diag"] = ("\\begin{tabular}{@{}lrrrrr@{}}\\toprule\nMarket & B3$-$R3 gain & Attacked term & Reference term & R3 audit spend & R3 served share \\\\\\midrule\n"
                    + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    rows = [f"{k} & {_f(v['estimate_report'])} & {_f(v['estimate_registered_cfg'])} & {v['category_registered_cfg']} \\\\" for k, v in res["stability"]["q1"].items()]
    t["stability"] = ("\\begin{tabular}{@{}lrrl@{}}\\toprule\nQ1 test & $d$, report & $d$, registered configs & Category, registered configs \\\\\\midrule\n"
                      + "\n".join(rows) + "\n\\bottomrule\\end{tabular}\n")
    return t


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    for k in ("--records", "--report", "--stability", "--out", "--tables"):
        ap.add_argument(k, required=True)
    a = ap.parse_args(argv)
    out = Path(a.records); report = json.loads(Path(a.report).read_text()); stab = json.loads(Path(a.stability).read_text())
    res = {"label": "exploratory, after the report; not registered",
           "q1_split": {f: split(out, FRESH, "C*", "F111", f) for f in ("D2+H3", "X7-SC")},
           "welfare": {r: welfare_mixtures(out, r) for r in ("F000", "F111", "C*")},
           "q4_diag": q4_diagnostics(out), "stability": stability(report, stab)}
    Path(a.out).write_text(json.dumps(res, indent=1) + "\n")
    d = Path(a.tables); d.mkdir(parents=True, exist_ok=True)
    for k, v in tables(res).items():
        (d / f"posthoc_{k}.tex").write_text(v.replace("C*", "C$^*$"))
    print(json.dumps({r: v.get("best") for r, v in res["welfare"].items()}, indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
"""Tests for posthoc_v2.py (exploratory analyses after the report; external review round 4): the Q1 split into attacked and
reference terms, the episode-mixture welfare frontier, and the per-market Q4 diagnostics."""
import json
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import posthoc_v2 as P  # noqa: E402


def _rec(out, rid, **f):
    p = out / "evaluate" / (P.safe(rid) + ".json"); p.parent.mkdir(parents=True, exist_ok=True); p.write_text(json.dumps(f))


def test_split_terms_add_up_to_the_gain_difference(tmp_path):
    s = [10.0, 10.0]
    _rec(tmp_path, "m0@rho0.2|C*|D2+H3|profit", profit_attack=[3.0, 5.0], profit_ref=[1.0, 1.0], sstar=s)
    _rec(tmp_path, "m0@rho0.2|F111|D2+H3|profit", profit_attack=[2.0, 2.0], profit_ref=[0.5, 0.5], sstar=s)
    got = P.split(tmp_path, ["m0"], "C*", "F111", "D2+H3", n=10)
    # g_C = (2, 4), g_F = (1.5, 1.5): d mean = 1.5; attacked term = (1, 3) mean 2; reference term = -(0.5, 0.5) mean -0.5
    assert got["pooled"]["estimate"] == pytest.approx(1.5)
    assert got["pooled"]["attacked"] == pytest.approx(2.0) and got["pooled"]["reference"] == pytest.approx(-0.5)


def test_mixture_weight_is_the_largest_with_a_nonnegative_lower_bound():
    rng = np.random.default_rng(0)
    gw0, gp = -0.1 + 0.001 * rng.standard_normal(200), 0.06 + 0.001 * rng.standard_normal(200)
    ew0, ep = np.full(200, 0.84), np.full(200, 1.0)
    m = P.mixture(gw0, ew0, gp, ep)
    assert 0.0 < m["weight"] < 0.375                          # 0.375 is where the mean gain reaches zero
    g = m["weight"] * gw0 + (1 - m["weight"]) * gp
    assert g.mean() - 1.645 * g.std(ddof=1) / np.sqrt(len(g)) >= 0
    assert m["efficiency"] == pytest.approx(m["weight"] * 0.84 + (1 - m["weight"]) * 1.0)


def test_no_mixture_when_the_profitable_policy_is_not_profitable():
    z = np.zeros(200)
    assert P.mixture(z - 0.1, z + 0.84, z - 0.01, z + 1.0)["weight"] == 0.0
# Response to the round-4 external review

Thank you for a careful and useful review. Every sentence correction is applied; the four zero-cost analyses you
proposed were run on the existing records and are reported in the paper as exploratory. Two of them changed the paper's
substance (points A and B below). Section numbers refer to the revised draft attached (`main.pdf`).

Your review saw only the PDF. This time the materials are attached as separate files, so the report, the addendum, the
protocol, the predictions, the ledger, and H4's code and containment note can be checked directly.

## What changed in substance

**A. The welfare result was overstated, as you suspected (your Task 2.5).** W1 constrains the mean gain, so an
episode-level lottery between a welfare attack and a profitable attack is feasible. On the evaluation records, a lottery
that plays R3's W0 attack with probability 0.42 and its H4 attack otherwise keeps the mean gain non-negative (one-sided
95 percent lower bound) and lowers R3's gross efficiency to 0.932, against 0.997 under the registered W1 search; for C*
the lottery reaches 0.921 (`posthoc.json`, Table "ph-welfare"). The paper now says that the profit-constrained welfare
result depends on excluding randomised policies and is not a lower bound. The weight is chosen on the evaluation seeds,
so this checks the policy class; it is not an out-of-sample estimate.

**B. The Q1 explanation was wrong (your point 6).** Splitting d = g_C* - g_R3 with the gain's own normalisation into
the attacked-profit and reference-profit terms shows that almost all of d is attacked profit (D2+H3: 0.019 of 0.021;
X7-SC: 0.0225 of 0.024). The paper had said the rules "differ mainly in the attacker's truthful reference profit"; it
now says the opposite, and labels Table 5's reference-profit row as raw profit units.

**C. H4 contains D2+H3 exactly** (its author's containment note, `h4/containment.md`). The paper now calls H4 an
extension of the public family written in a separate session, not a disjoint attack concept.

**D. Related work.** All four references you suggested were verified from primary sources (publisher PDFs and Crossref) and added: Zarkoob, Fu, and Leyton-Brown (2020) in the introduction, as report-dependent checking that our admissible rules could use but we do not study; Wiedenbeck, Cassell, and Wellman (2014) beside the empirical-game method; Berger and Hsu (1996) for the equivalence and intersection-union logic; Morris, White, and Crowther (2019) for the calibration reporting.

## Sentence corrections (your Task 1)

| # | Your point | Change |
|---|---|---|
| 1 | Gain does not isolate the benefit of replacement | Discussion: measured against each rule's frozen reference; does not isolate the replacement benefit; would need replacement disabled |
| 2 | Q1 headline omits margin, X7-SC value, search flags; "only" | Abstract and introduction: pooled, within the registered margin, both families' values, prescribed searches; "only" removed |
| 3 | All Q4 passes are search-qualified | Abstract, introduction, section 9, conclusion |
| 4 | "Loss-accepting" confuses relative and absolute loss | Discussion and conclusion: loss relative to the truthful reference, not necessarily negative profit |
| 5 | Coalition sizes mismatched; decoy family exception | Section 9: matched two- and five-member comparisons, R3's negative worst member, decoy family 0.024 vs 0.025, no ordering claim |
| 6 | Q1 explanation unsupported | Point B above; new exploratory table |
| 7 | W1 "efficiency stays" too broad; B3's W1 | Section 9: W0 and W1 values for B3 and R3, finite-search outcomes, not lower bounds; point A |
| 8 | "The sign is established" | Section 9: registered calibrated procedure; nominal guarantees not established on fresh selected-rule distributions |
| 9 | Uniform auditing alone does not imply costless bans | Abstract, introduction, conclusion: B2 and B3 with refund-and-ban and no bonds (Corollary 1's condition) |
| 10 | Welfare claim covers unevaluated rules; H4 "selected" | Abstract: B3, R3, C* only; "selected" policy |
| 11 | "Stay below" suggests a bound | Introduction and section 9: training-selected envelopes, finite-search comparison, no family-level robustness |
| 12 | Pacing raises gain | Abstract, section 9, discussion: small increase (0.004 D2+H3, 0.005 X7-SC); repair values under D2+H3 |
| 13 | Interaction scale | Section 9: PG contrast defined as half the difference of G's conditional effects; "accounts for most of the measured reduction" |
| 14 | Which first-test clause failed | Abstract: rule clause passed; baseline clauses failed |
| 15 | "Best of four" | Abstract and section 9: development-selected from twelve configurations of four adaptations |
| 16 | Two generalisation statements | Section 9: Q4 does not test the complete amended claim; discussion: shared benefit, no ordering for every variant and market |
| 17 | Stability summary | Sections 8 and 10: frozen policies and references; search and reference selection not repeated; new table |
| 18 | Small shading condition | Limits: first-test parameters, zero-continuation round, same-offer shading |
| 19 | Conclusion | Rewritten along your replacement |
| 20 | Dependencies, H4 provenance, availability, Table 13 | Search-quality paragraph names what the addendum traces (Q1 and Q4) and what is descriptive (Q2, Q3); H4 provenance and containment; availability tense made consistent (future, before publication); Table 13 prints each registered statement and condition, labels paired values, and the text says the count is not a validation score |

## Method (your Task 2)

- **Calibration and intervals** (2.1, 2.2): section 8 now states the role of kappa (it multiplies each nominal tail, so
  kappa < 1 widens intervals), the candidate set {1, 1/2, 1/4}, the fixtures (frozen development attacks and references,
  headline and dev0, 20,000 seeds per market), 10,000 selection and 20,000 validation replications, the Clopper-Pearson
  admission rule, 9,999 bootstrap resamples with seed pairing, what the bootstrap does and does not measure, the scope
  of each multiplicity guarantee, and the economic size of the margin (half a percent of the first-best surplus).
- **Deviations** (2.3): the stability table sets the Q1 estimates beside their re-evaluation (0.0207 vs 0.0209,
  0.0243 vs 0.0245); categories and the Q4 count are unchanged; the largest change of any cell mean is 0.0074. The text
  says search and reference selection were not repeated. The cap change and its timing are in the ledger.
- **Attack strength** (2.4): the paper now states that doubling checks find missed improvements but cannot bound the
  remaining gap, and that the envelope values are finite-search results.
- **Heterogeneity** (your change 7): a per-market table splits Q4's difference; on every market it is almost all
