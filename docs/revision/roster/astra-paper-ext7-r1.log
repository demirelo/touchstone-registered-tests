            if any(R.rec(i) is None for i in ids):
                out["robustness"][r][f] = "unanswered (missing cell)"
            elif f not in CHECKED:
                out["robustness"][r][f] = "no search-quality claim (no scheduled check)"
            else:
                out["robustness"][r][f] = R.search_status(ids) or "answered"
        for m in FRESH + ("headline",):
            env = R.aux(f"envelope/{m}@rho0.2/{r}")
            need = [f for f in fams if R.scheduled(RV.cell_id(f"{m}@rho0.2", r, f, "profit"))]
            if env is None or any(R.get(m, r, f) is None for f in need):
                out["envelope"][r][m] = "unanswered: missing cell"; continue
            rec = R.get(m, r, env["choice"])
            if rec is None:
                out["envelope"][r][m] = "unanswered: missing cell"; continue
            g = np.asarray(rec["gain"]); out["envelope"][r][m] = {"family": env["choice"], "estimate": _est(g), "interval": _interval(g)}
    for r in CORE:
        out["welfare"][r] = {}; out["welfare_selected"][r] = {}
        for f in FAMS:
            out["welfare"][r][f] = {}
            for obj in ("W0", "W1"):
                rec = R.get("headline", r, f, obj); st = R.search_status([RV.cell_id("headline@rho0.2", r, f, obj)])
                if rec is None:
                    out["welfare"][r][f][obj] = "unanswered: missing cell"; continue
                if rec.get("no_feasible_candidate"):
                    out["welfare"][r][f][obj] = "no feasible candidate found" + (f" by the prescribed search; robustness {st}" if st else ""); continue
                eff = np.asarray(rec["eff"]); cell = {"efficiency": float(eff.mean()), "interval": _interval(eff),
                                                      "search": FLAGGED if "flagged" in (st or "") else None, "robustness": st or "answered"}
                if obj == "W0":
                    pr = R.get("headline", r, "D2+H3")
                    if pr is None:
                        out["welfare"][r][f][obj] = "unanswered: missing cell"; continue
                    N = R.jobs[RV.cell_id("headline@rho0.2", r, f, obj)]["mkt"]["cfg"].N
                    gain = np.asarray(rec["normalized"]) - np.asarray(pr["profit_ref"]) / (np.asarray(pr["sstar"]) / N)
                else:
                    gain = np.asarray(rec["constraint"]); ci = _interval(gain); cell["constraint_interval"] = ci
                    cell["w1_class"] = REFUSED if None in ci else w1_class(*ci)
                cell.update(attacker_gain=float(gain.mean()), attacker_gain_interval=_interval(gain)); out["welfare"][r][f][obj] = cell
        for obj in ("W0", "W1"):
            sel = R.aux(f"welfare_select/headline@rho0.2/{r}/{obj}") or {}
            if sel.get("family") is None:
                out["welfare_selected"][r][obj] = {"family": None, "status": sel.get("status", "unanswered: missing selection")}
            else:
                other = "X7-SC" if sel["family"] == "D2+H3" else "D2+H3"
                out["welfare_selected"][r][obj] = {"family": sel["family"], "other_family": other, "result": out["welfare"][r][sel["family"]][obj],
                                                   "other_result": out["welfare"][r][other][obj]}
        out["coalition"][r] = {}
        groups = [(c, sch, "X6-SE/v2") for c in (2, 5) for sch in ("synchronised", "staggered")] + [(2, "roles", "X8-DB")]
        for c, sch, fam in groups:
            tot, mn = R.get("headline", r, fam, "total", c, sch), R.get("headline", r, fam, "min", c, sch)
            if tot is None or mn is None:
                out["coalition"][r][f"c{c}_{sch}"] = "unanswered: missing cell"; continue
            try:
                gm = {"estimate": float(mn["min"]), "bounds": [float(x) for x in gmin_bounds([np.asarray(v, dtype=float) for v in mn["member_gain"]], 0.05)]}
            except NumericalRefusal:
                gm = {"estimate": float(mn["min"]), "bounds": [None, None], "status": REFUSED}
            st = R.search_status([RV.cell_id("headline@rho0.2", r, fam, o, c, sch) for o in ("total", "min")])
            out["coalition"][r][f"c{c}_{sch}"] = {"G_tot": {"estimate": float(tot["total"])}, "G_min": gm, "search": FLAGGED if "flagged" in (st or "") else None,
                                                  "robustness": st or "answered"}
        dg = R.get("headline", r, "HR1", "diagnostic")
        out["diagnostic"][r] = "unanswered: missing cell" if dg is None else {"replace_at": dg["replace_at"], "bins": dg["bins"]}
40:\paragraph{Results in brief.} Q1: pooled over the six fresh markets, R3 and C$^*$ are ``\site{int_q1_cat}'' within the registered margin under X7-SC, and likewise under D2+H3: R3 is not materially better than the development-selected verified-history comparator at the same budget. Q2: in the pooled factorial contrasts, the priority phase and newest-first targeting each lower the measured gain (main effects \site{int_q2_p} and \site{int_q2_g}), and either one alone accounts for most of the reduction. Q3: the training-selected attack envelopes have lower measured gains against R3 than against B3 on every evaluated market, a finite-search comparison that does not establish robustness to the searched families; the selected unconstrained welfare attack lowers R3's gross efficiency to \site{int_q3_w0}, and exploratory lotteries over existing attacks, selected on the evaluation records, reach efficiency well below the \site{int_w1} of the registered W1 search at non-negative estimated gain, with public-family attacks alone; the W1 search therefore supplies no efficiency bound for randomised policies, and the mixtures' population profitability is not established. Q4: the B3--R3 comparison passes on \site{int_q4_k} of six fresh markets, all three passes qualified by search flags; on the other three, R3's estimated advantage is positive but below the registered threshold.
67:\paragraph{Benchmark and metrics.} One focal provider deviates while the others play honestly at full effort with truthful claims; this is a unilateral deviation, not an equilibrium. For a seed with first-best surplus $S^*$, the focal provider's \emph{gain} is its profit under the attack minus its profit under a selected truthful reference, divided by $S^*/N$. \emph{Gross efficiency} is $(W + \text{audit cost})/S^*$, with $W$ the realised social surplus net of audit cost; net efficiency is $W/S^*$. Gain is a difference of two searched values, so search error can bias it either way. The second test adds two objectives at its headline market: welfare attacks that minimise gross efficiency, without a constraint (W0) or subject to a nonnegative mean normalised gain over the attacker's reference on the training seeds (W1), whose profitability is then called supported only if its nominal 95\% lower bound on the evaluation seeds is nonnegative; and coalitions of two or five providers, scored by the total gain $G_{\mathrm{tot}}$ and by the worst member's mean gain $G_{\min}$, both against a coordinated truthful reference. Coalition results say nothing about coalition stability.
70:\paragraph{Baselines.} B2 posts prices for three claim tiers, allocates by those prices, and audits uniformly. B3 allocates each job, in descending order of value, to the offer with remaining capacity and the highest nonnegative score $v_j c_i - \mathrm{bid}_i$, pays $v_j c_i - s_{2,j}$ with $s_{2,j}$ the highest score among the other eligible offers (zero if there is none), and audits uniformly at random among served jobs, spread over the rounds. Both refund a failed job and ban its identity for $L$ rounds.
132:\paragraph{Search quality.} Scheduled cells get a doubling check: the registered search continues with as many restarts again, and the cell is flagged if the doubled search improves the attacker's normalised profit or the reference's normalised profit (profit cells), the welfare attack's efficiency (welfare cells), or the coalition objective by at least \const{0.005}, or if a W1 search finds a feasible candidate where the original found none. A doubled search's winner is reported beside the cell and never replaces its frozen estimate. Cells without a scheduled check carry no search-quality claim. A cell is \emph{missing} if it did not complete or is invalid: not run (a cap stop or a cut), a refused sample, a nonfinite statistic, a search with no finite candidate, or a failed load of H4; a missing cell removes every decision that uses it. A \emph{search-flagged} cell keeps its decision, labelled as a decision about the prescribed search procedure, and leaves that rule's robustness statement for that family unanswered. The search bounds exposure to the searched families and optimiser; it does not certify robustness.
191:\paragraph{Age-ranked versus history-based checking (Q1).} Pooled over the six fresh markets, the prescribed searches leave the identity-replacement attacker a measured gain against C$^*$ higher than against R3 by \site{r_q1_d_est} under D2+H3 and by \site{r_q1_x_est} under X7-SC. Both direction tests reject $d = \const{0}$ (calibrated input $p' = $ \site{r_q1_d_p}; Holm-adjusted $p = $ \site{r_q1_holm} for each). Both intervals lie inside the registered margin of $\pm\const{0.05}$: the categories are ``\site{r_q1_d_cat}'' (D2+H3) and ``\site{r_q1_x_cat}'' (X7-SC), and the separate efficiency label is ``\site{r_q1_d_eff}''. R3 is not materially better than the development-selected comparator. The difference changes sign across markets: per market (descriptive), it ranges from \site{r_q1_f3_d} on fresh3 to \site{r_q1_f1_d} on fresh1 under D2+H3. Both decisions are about the prescribed search procedure: the D2+H3 test uses search-flagged cells, and the X7-SC test uses them through its references (addendum); their nominal error guarantees are not established on the fresh, selected-rule distributions (Section~\ref{sec:design}). The paired descriptive differences in Table~\ref{tab:q1-side} are small for efficiency, audit spending, refunds on false audit failures, and the market service fraction; the reference-profit column is in raw profit units. Splitting $d$ with the same normalisation into the attacked-profit term and the reference-profit term (Table~\ref{tab:ph-q1}, exploratory) shows that almost all of it is attacked profit: the attacker earns more under C$^*$ when it deviates, not when it is truthful.
213:\paragraph{Repeating the comparison on six new markets (Q4).} The registered B3--R3 gain-and-efficiency comparison under D2+H3 passes on \site{r_q4_k} of the six markets (Table~\ref{tab:q4}), and all three passes (fresh1, fresh3, fresh4) are about the prescribed search procedure. On every market the estimated B3 minus R3 gain difference is positive and R3 keeps its efficiency condition; where the comparison fails, the difference is smaller than the registered threshold, not reversed: \site{r_q4_f0} on fresh0, \site{r_q4_f2} on fresh2, and \site{r_q4_f5} on fresh5, against \site{r_q4_f1} on fresh1. R3's efficiency on fresh2, the lowest, is \site{r_q4_f2_eff}. The decisions on fresh0, fresh1, fresh3, and fresh4 are about the prescribed search procedure (fresh0 and fresh3 through their references; addendum). The registered prediction of at least five passing markets failed. Q4 does not test the complete amended claim of the first test. Table~\ref{tab:ph-q4} (exploratory) decomposes each market's gain difference, which is mostly attacked profit. R3's reported audit spending is about five percent of the realised first-best surplus, and the market's service fraction (all jobs served over the first-best number) is near one. The three non-passing markets have smaller attacked-profit reductions; these descriptive diagnostics do not identify their cause.
222:\caption{Q4 per market: B3 minus R3 gain difference and its calibrated lower bound, R3's efficiency and lower bound, the raw one-sided bootstrap $p$-values of the two components, the calibrated market value $\max(p'_{\mathrm{gain}}, p'_{\mathrm{eff}})$ that enters Holm, its Holm-adjusted value, and the decision. The decisions on fresh0, fresh1, fresh3, and fresh4 are about the prescribed search procedure; the table marks the direct flags (fresh1, fresh4), and fresh0 and fresh3 depend on flagged cells through their references (addendum).}\label{tab:q4}
230:\paragraph{Which parts of R3 matter (Q2).} Under separately searched D2+H3 attacks, pooled over the fresh markets, the main effects on the gain are \site{r_q2_p} for the priority phase P and \site{r_q2_g} for newest-first residual targeting G, both reductions, and \site{r_q2_s} for pacing S, a small increase (X7-SC: \site{r_q2_s_x}). The two targeting parts are substitutes: the PG factorial contrast, half the difference between G's conditional effects, is \site{r_q2_pg}; G changes the gain by \site{r_q2_g_p0} without the priority phase and by only \site{r_q2_g_p1} with it. In the pooled contrasts, either P or G alone accounts for most of the measured reduction; adding the other contributes little. The pattern also appears in the fixed-attack contrasts averaged over the eight selected attacks (P: \site{r_q2_fixed_p}). Our registered conjectures (P negligible, the targeting parts additive, S helpful) failed as scored (Table~\ref{tab:predictions}); the stricter eligibility reading of Table~\ref{tab:pred-eligibility} leaves them not assessed, with the estimates unchanged. X7-SC agrees (Table~\ref{tab:q2-x7sc}).
247:\paragraph{Stronger attacks and where R3 fails (Q3).} Table~\ref{tab:q3-envelope} gives each core rule's attack envelope: the family with the highest training gain, evaluated unchanged. These are finite-search results, not bounds on the families. Against B3 the selected envelope reaches \site{r_q3_f000_f1} on fresh1; against R3 it is \site{r_q3_f111_f1} there, and against C$^*$ \site{r_q3_cs_f1}, from \site{r_q3_cs_f1_fam}. H4 was written in a separate session against the frozen defenders and committed by its hash before the lock; its author's containment note states that it contains D2+H3 exactly as a special case, so it extends the public family rather than offering a disjoint attack concept. Evaluated at the headline market only, its selected search gains \site{r_q3_f111_h4} against R3 and \site{r_q3_f000_h4} against B3. Robustness against D2+H3 is unanswered for every core rule because of search flags, and so is R3's robustness against X7-SC; X5-AG/v2 and H4 carry no search-quality claim. Welfare attacks are the clearest weakness. At the headline market, the selected W0 attacks (no profit constraint) yield gross efficiency \site{r_q3_w0_f000} for B3 and \site{r_q3_w0} for R3, with gains relative to the truthful reference of \site{r_q3_w0g_f000} and \site{r_q3_w0g_f111}; C$^*$ is like R3. Under the prescribed W1 searches (mean gain at least zero), the selected feasible attacks yield efficiency \site{r_q3_w1} for R3, while B3 stays at \site{r_q3_w1_f000} (Table~\ref{tab:q3-welfare}). These finite-search results are not lower bounds on efficiency over a broader policy class. An episode-level mixture, which picks a welfare attack or a profitable attack at the start of each episode, satisfies a mean-gain constraint only when its probability-weighted component gains satisfy that constraint; we examine such mixtures on the existing evaluation records. On the records used to select them, W0 weights of \site{r_ph_w_r3} for R3 and \site{r_ph_w_cs} for C$^*$, with the H4 attack as companion, give estimated normalised gains of \site{r_ph_g_r3} and \site{r_ph_g_cs} and gross efficiencies of \site{r_ph_e_r3} and \site{r_ph_e_cs}; with the public D2+H3 attack as companion the efficiencies are \site{r_ph_e_r3_d} and \site{r_ph_e_cs_d} (Tables~\ref{tab:ph-welfare} and~\ref{tab:ph-welfare-sens}). The registered W1 constraint is a non-negative mean gain on the training seeds. Reconstructed from the search archives, the training mean gains of these mixtures, each at its rule--companion pair's weight in Table~\ref{tab:ph-welfare}, are \site{r_ph_t_r3} and \site{r_ph_t_r3_d} for R3 and \site{r_ph_t_cs} and \site{r_ph_t_cs_d} for C$^*$ (H4 and D2+H3 companions): three meet the training constraint, but C$^*$'s public-family mixture does not. At its evaluation-selected weight of \site{r_ph_wd_cs}, C$^*$'s public-family mixture fails the training constraint. At \site{r_ph_fw_cs}, the largest weight on the same grid at which both the training mean gain and the evaluation bound are non-negative, it has training gain \site{r_ph_ft_cs}, estimated evaluation gain \site{r_ph_fg_cs}, and gross efficiency \site{r_ph_fe_cs}, against \site{r_ph_w1_cs} under the registered W1 search (last row of Table~\ref{tab:ph-welfare}). Both rules therefore show substantial empirical efficiency losses with public-family mixtures alone; H4 is not needed for a drop of this size, and population profitability remains unestablished. The evaluation-selected weights are the largest at which a nominal one-sided \const{95} percent normal bound on the mean gain stays non-negative (the training-feasible row also requires a non-negative training mean); that bound is not adjusted for selection, the weight and the companion family were chosen on the evaluation seeds, and the bound is close to zero at the selected weights, so this checks the policy class and is not an out-of-sample estimate. The mixture efficiencies stay above \const{0.90}; the analysis does not touch Q4 or its registered predicate. For coalitions of two synchronised members, the selected total gains are \site{r_q3_coal_f000} against B3 and \site{r_q3_coal_f111_c2} against R3 (search flagged); for five, \site{r_q3_coal_f000_c5} and \site{r_q3_coal_f111} (total objective), while the policy selected for the minimum-member objective leaves R3's worst member a mean gain of \site{r_q3_coal_f111_c5min}; the decoy-and-beneficiary family gives \site{r_q3_db_f000} against B3 and \site{r_q3_db_f111} against R3. These comparisons establish neither coalition stability nor an ordering across every coalition family (Table~\ref{tab:q3-coalitions}). At $\rho = \const{1}$, where R3's terminal reserve collapses, R3 leaves \site{r_rep_f111} under D2+H3; the repair R4 lowers this to \site{r_rep_r4} and C$^*$ with the capped schedule (C$^*$/S2) to \site{r_rep_cs2} (Table~\ref{tab:q3-repair}).
281:\paragraph{Search quality.} No cell is missing. The report lists the search-flagged cells, and the addendum traces the inherited flags of every Q1 and Q4 decision through the records' references. Q2 and Q3 statements are descriptive; the cells they use carry the flags listed in the report. Table~\ref{tab:ph-stability} sets the Q1 estimates beside their re-evaluation with the registered configurations, and Table~\ref{tab:ph-q4-stability} compares the Q4 estimates, calibrated lower bounds, and decisions under both configurations and gives the adjusted market $p$-value under the registered configuration; the largest Q4 change is on fresh4, where the gain difference moves from \site{r_st_f4_old} to \site{r_st_f4_new}, still above the registered \const{0.10}.
293:\paragraph{Predictions.} Tables~\ref{tab:predictions} and~\ref{tab:predictions-b} score every registered prediction from the report. For Q4-b, the original scoring script compared the report's raw component $p$-values, although the prediction is registered on calibrated values; the corrected script compares the calibrated values, \site{r_pred_q4b_g} against \site{r_pred_q4b_e} on each of fresh0, fresh2, and fresh5. The prediction remains fulfilled and the total is unchanged: a scoring correction with no change of verdict, separate from the corrected labels of Tables~\ref{tab:q1} and~\ref{tab:q4}. The scoring script reads the numerical estimates only: it retains the estimates of completed searches whose doubling check was marked incomplete, and counts \site{r_pred_n_ful} predictions fulfilled and \site{r_pred_n_fail} failed. The registered scoring rule also says that an incomplete target, in the sense of the design's search-quality checks, is not assessed; those checks call a search-flagged cell incomplete while keeping its estimate for the prescribed search procedure; it does not say whether a prediction computed from a flagged search is itself incomplete. Table~\ref{tab:pred-eligibility} therefore adds two stricter readings, computed from a map of the searches each prediction cell requires (released with the scorer). If a flagged required search makes a Q3 policy comparison ineligible, Q3-a, Q3-b, and Q3-d are not assessed: \site{r_pred_q_ful} predictions are fulfilled, \site{r_pred_q_fail} fail, and \site{r_pred_q_na} are not assessed. If it makes every descriptive prediction ineligible (all except those that score a confirmatory decision: Q1-a, its alternative, Q1-b, Q1-d, Q4-a, and Q4-b), Q1-c and Q2-a to Q2-c are also not assessed: \site{r_pred_d_ful}, \site{r_pred_d_fail}, and \site{r_pred_d_na}. No reading turns a failed prediction into a fulfilled one or changes a registered decision; the marked rows of Tables~\ref{tab:predictions} and~\ref{tab:predictions-b} are those a stricter reading changes, and their estimates stand as estimates of the prescribed searches. The predictions differ in stakes and are not independent, so the count of fulfilled predictions is not a validation score. The failures are informative: we expected the priority phase to matter little, the replication to hold on at least five markets, X5-AG/v2 to stay below D2+H3, and the unconstrained welfare attack to leave R3's and C$^*$'s efficiency at the registered level, and none of these held (the first is not assessed under the descriptive reading).
297:\caption{Registered predictions for Q1 and Q2, scored from the report. Identifiers and statements as in the registered predictions file (supplement); a pair of values gives two statistics of the scored cell, as labelled, not an interval. Status as scored on the numerical estimates; $\dagger$: not assessed under both stricter eligibility readings of Table~\ref{tab:pred-eligibility}; $\ddagger$: not assessed under the descriptive reading only.}\label{tab:predictions}
302:\caption{Registered predictions for Q3 and Q4, scored from the report, as in Table~\ref{tab:predictions}, with the same marks.}\label{tab:predictions-b}
307:\caption{Prediction tally under three eligibility readings, added after external review. Numerical: the scorer's statuses (Tables~\ref{tab:predictions} and~\ref{tab:predictions-b}). Flagged inputs, Q3: a Q3 cell with a search-flagged required search is not assessed. Flagged inputs, every descriptive: the same for every prediction except those that score a confirmatory decision. Eighteen scored predictions, including the alternative to Q1-a.}\label{tab:pred-eligibility}
324:For the uniform-audit baselines with refund-and-ban enforcement and no bonds, free replacement removes the ban's continuation cost. At the fixed parameters, the prescribed D2+H3 searches yield a lower measured gain for R3 than for B3 on every sampled market, but the registered gain-and-efficiency comparison passes on only three of six fresh markets, all three qualified by search flags. R3 and the development-selected verified-history comparator are pooled-equivalent within the registered margin under both Q1 families. At the headline market, the selected unconstrained welfare attacks yield gross efficiency of about \site{c_w0} against all three core rules and earn less than the truthful reference against R3 and C$^*$. The registered W1 search yields gross efficiency near \site{c_w1} for both rules. Exploratory episode-level mixtures selected on the evaluation records yield, with H4, estimated efficiencies of \site{c_mx_r3} for R3 and \site{c_mx_cs} for C$^*$; public D2+H3 mixtures meeting the empirical training constraint yield \site{c_mx_r3_p} and \site{c_mx_cs_p}, respectively; all at non-negative estimated evaluation gain. The registered W1 search therefore supplies no efficiency bound for randomised policies; the population profitability of the selected mixtures remains unestablished. These conclusions concern frozen searches and references, with interval calibration admitted on development fixtures. The record of both tests, including the original failure, the amendments, the deviations, and the failed predictions, will be released with the paper.
327:\paragraph{Availability.} The paper artifact will have its own release commit and archive hash. It identifies the frozen evaluation code by the signed tag \texttt{protocol-v2} and preserves the original tagged-code report. It contains the code, the tuned files, all records of both tests (including incomplete, failed, and cut cells), the market generator, the block headers, the released H4 bundle, and the deviation evidence, and, separately dated, the decision-stability re-evaluation, the exploratory post hoc analyses with the per-seed evaluation and training inputs of the lottery analysis, the prediction-scoring correction with its regression test, the inference audit, and the paper sources. One command (\texttt{docs/revision/deviation/reproduce\_deviation.py}) checks the artifact against the tag and reproduces the second test's report under the disclosed configuration substitution; the paper's second-test tables and figures are regenerated from the tagged report, the disclosed stability output, and the exploratory post hoc and audit outputs by the scripts in \texttt{docs/revision/paper-v2}, \texttt{docs/revision/posthoc}, and \texttt{docs/revision/audit}, and the first test's records and verdict are in the release as recorded in October~\const{2026}.
