     1	"""Scores the hashed predictions (docs/revision/predictions-v2.md, scoring table) from report.json and cells.json.
     2	A prediction over several cells is scored cell by cell: failed if any assessed cell fails; fulfilled only if every
     3	required cell is assessed and fulfilled; otherwise not assessed. A cell is not assessed when its value is missing,
     4	cut, refused, or a status string. Descriptive only: predictions change no decision."""
     5	from __future__ import annotations
     6	
     7	import argparse
     8	import json
     9	import sys
    10	from pathlib import Path
    11	
    12	FRESH = tuple(f"fresh{i}" for i in range(6))
    13	MARKETS = FRESH + ("headline",)
    14	NA = "not assessed"
    15	KAPPA_Q4 = 0.25                       # experiments/protocol-v2.yaml, admitted Q4 multiplier
    16	
    17	
    18	def _cal(p, kappa: float = KAPPA_Q4):
    19	    """p' = min(1, p / kappa) (design 9.2): Q4-b is registered on the calibrated component p-values."""
    20	    return None if _num(p) is None else min(1.0, float(p) / kappa)
    21	
    22	
    23	def _num(x):
    24	    return float(x) if isinstance(x, (int, float)) and not isinstance(x, bool) else None
    25	
    26	
    27	def _cell(name, value, test) -> dict:
    28	    v = _num(value) if not isinstance(value, (tuple, list)) else value
    29	    if v is None or (isinstance(v, (tuple, list)) and any(_num(z) is None for z in v)):
    30	        return {"cell": name, "value": None, "status": NA}
    31	    return {"cell": name, "value": v, "status": "fulfilled" if test(v) else "failed"}
    32	
    33	
    34	def _combine(cells: list) -> dict:
    35	    st = [c["status"] for c in cells]
    36	    status = "failed" if "failed" in st else "fulfilled" if st and all(s == "fulfilled" for s in st) else NA
    37	    return {"status": status, "cells": cells}
    38	
    39	
    40	def _get(d, *path):
    41	    for p in path:
    42	        if not isinstance(d, dict) or p not in d:
    43	            return None
    44	        d = d[p]
    45	    return d
    46	
    47	
    48	def _gain(cells, m, rule, fam):
    49	    return _get(cells, f"{m}@rho0.2|{rule}|{fam}|profit", "gain")
    50	
    51	
    52	def score(rep: dict, cells: dict) -> dict:
    53	    out = {}
    54	    q1 = lambda f: _get(rep, "q1", "tests", f"C*-F111|{f}") or {}
    55	    cat = lambda f: q1(f).get("category") if isinstance(q1(f).get("category"), str) else None
    56	    c = cat("D2+H3")
    57	    out["Q1-a"] = _combine([{"cell": "D2+H3", "value": c, "status": NA if c is None or c.startswith("not decided") or c == "refused"
    58	                             else "fulfilled" if c == "equivalent, direction R3 lower" else "failed"}])
    59	    est = _num(q1("D2+H3").get("estimate"))
    60	    out["Q1-a-alt"] = _combine([{"cell": "D2+H3", "value": c, "status": NA if c is None or est is None or c.startswith("not decided")
    61	                                 else "fulfilled" if (c == "ordered, size not established" and est > 0) else "failed"}])
    62	    c = cat("X7-SC")
    63	    out["Q1-b"] = _combine([{"cell": "X7-SC", "value": c, "status": NA if c is None or c.startswith("not decided") or c == "refused"
    64	                             else "fulfilled" if c in ("equivalent", "equivalent, direction R3 lower") else "failed"}])
    65	    neg = lambda v: None if v is None else -v                     # the report's side fields are F111 minus C*; Q1-c is C* minus F111
    66	    out["Q1-c"] = _combine([_cell(f, neg(_get(q1(f), "side", "gross_eff_diff")), lambda v: -0.01 <= v <= 0.01) for f in ("D2+H3", "X7-SC")])
    67	    out["Q1-d"] = _combine([{"cell": f, "value": q1(f).get("better"), "status": NA if cat(f) is None or "efficiency" not in q1(f)
    68	                             else "fulfilled" if q1(f).get("better") is None else "failed"} for f in ("D2+H3", "X7-SC")])
    69	    s = lambda kind, f, k: _get(rep, "q2", kind, f, k, "estimate")
    70	    out["Q2-a"] = _combine([_cell(k, s("searched", "D2+H3", k), lambda v: v <= -0.05) for k in ("G", "S")])
    71	    out["Q2-b"] = _combine([_cell("P", s("searched", "D2+H3", "P"), lambda v: abs(v) < 0.03)])
    72	    out["Q2-c"] = _combine([_cell("PG", s("searched", "D2+H3", "PG"), lambda v: abs(v) < 0.03),
    73	                            _cell("PS", s("searched", "D2+H3", "PS"), lambda v: abs(v) < 0.03),
    74	                            _cell("GS", s("searched", "D2+H3", "GS"), lambda v: v <= 0)])
    75	    out["Q2-d"] = _combine([_cell(f"{k} {f}", (s("fixed", f, k), s("searched", f, k)), lambda v: abs(v[0]) < abs(v[1]))
    76	                            for f in ("D2+H3", "X7-SC") for k in ("P", "G", "S")])
    77	    diff = lambda m, r, a, b: (None if _gain(cells, m, r, a) is None or _gain(cells, m, r, b) is None
    78	                               else _gain(cells, m, r, a) - _gain(cells, m, r, b))
    79	    out["Q3-a"] = _combine([_cell(f"{m} {r}", diff(m, r, "X7-SC", "D2+H3"), lambda v: v < 0.05) for m in MARKETS for r in ("F111", "C*")])
    80	    out["Q3-b"] = _combine([_cell("headline F111", diff("headline", "F111", "H4", "X7-SC"), lambda v: v <= 0.05)])
    81	    out["Q3-c"] = _combine([_cell(f"{m} {r}", diff(m, r, "X5-AG/v2", "D2+H3"), lambda v: v < 0) for m in MARKETS for r in ("F111", "C*")])
    82	    groups = ["c2_synchronised", "c2_staggered", "c5_synchronised", "c5_staggered", "c2_roles"]
    83	    co = lambda r, g: _get(rep, "q3", "coalition", r, g)
    84	    out["Q3-d"] = _combine([_cell(f"{r} {g}", (_get(co(r, g), "G_min", "estimate"), _get(co(r, g), "G_tot", "estimate")),
    85	                                  lambda v: v[0] - 0.5 * v[1] <= 0) for r in ("F111", "C*") for g in groups])
    86	    ben = lambda r: (_get(cells, f"headline@rho0.2|{r}|X8-DB|total|c2_roles", "member_gain") or [None])[0]
    87	    out["Q3-e"] = _combine([_cell("headline", (ben("F111"), ben("C*")), lambda v: v[0] > v[1])])
    88	    eff = lambda r, o: _get(rep, "q3", "welfare_selected", r, o, "result", "efficiency")
    89	    out["Q3-f"] = _combine([_cell(f"{r} {o}", eff(r, o), lambda v: v >= 0.90) for o in ("W0", "W1") for r in ("F111", "C*")]
    90	                           + [_cell(f"F000<F111 {o}", (eff("F000", o), eff("F111", o)), lambda v: v[0] < v[1]) for o in ("W0", "W1")])
    91	    rp = lambda r: _get(rep, "secondary", "repair_rho1", r, "D2", "estimate")
    92	    out["Q3-g"] = _combine([_cell("headline rho1", (rp("F111"), rp("R4")), lambda v: v[0] - v[1] >= 0.10)])
    93	    k = _get(rep, "q4", "k")
