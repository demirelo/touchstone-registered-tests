def _strat(st, tail: float = NOMINAL, strict: bool = False) -> dict:
    try:
        return {"estimate": float(stratified_mean(st)), "interval": [float(stratified_at(st, "lower", tail)), float(stratified_at(st, "upper", tail))]}
    except NumericalRefusal:
        if strict:
