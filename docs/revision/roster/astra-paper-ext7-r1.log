    99	
   100	
   101	# Eligibility (external review round 7). predictions-v2.md: a target that is "incomplete (design 6.5)" is not assessed;
   102	# design 6.5 calls a search-flagged cell "incomplete" and keeps its estimate for the prescribed search procedure, and keeps
   103	# every confirmatory decision that uses it. score() above reads the numbers only; the map below names each cell's
   104	# required searches and rescored the predictions under two stricter readings. Descriptive only.
   105	RULES8 = tuple(f"F{a}{b}{c}" for a in "01" for b in "01" for c in "01")
   106	DECISIONS = frozenset({"Q1-a", "Q1-a-alt", "Q1-b", "Q1-d", "Q4-a", "Q4-b"})   # score a confirmatory decision or its label
   107	SCOPES = ("numerical", "q3", "descriptive")
   108	COALITION_FAMILY = {"c2_roles": "X8-DB"}                                   # the other coalition groups are X6-SE/v2
   109	
   110	
   111	def _sid(m, r, fam, obj="profit", grp=None, rho="0.2"):
   112	    return f"{m}@rho{rho}|{r}|{fam}|{obj}" + (f"|{grp}" if grp else "")
   113	
   114	
   115	def inputs(pid: str, cell: str) -> list:
   116	    """The searches a prediction cell needs (ids as in the report's search_flagged list)."""
   117	    q1 = lambda fam: [_sid(m, r, fam) for m in FRESH for r in ("C*", "F111")]
   118	    q2 = lambda fam: [_sid(m, r, fam) for m in FRESH for r in RULES8]          # searched cells and the fixed-attack bank
   119	    if pid in ("Q1-a", "Q1-a-alt"):
   120	        return q1("D2+H3")
   121	    if pid in ("Q1-b", "Q1-c", "Q1-d"):
   122	        return q1(cell)
   123	    if pid in ("Q2-a", "Q2-b", "Q2-c"):
   124	        return q2("D2+H3")
   125	    if pid == "Q2-d":
   126	        return q2(cell.split()[1])
   127	    if pid in ("Q3-a", "Q3-b", "Q3-c"):
   128	        m, r = cell.split()
   129	        a, b = {"Q3-a": ("X7-SC", "D2+H3"), "Q3-b": ("H4", "X7-SC"), "Q3-c": ("X5-AG/v2", "D2+H3")}[pid]
   130	        return [_sid(m, r, a), _sid(m, r, b)]
   131	    if pid == "Q3-d":
   132	        r, g = cell.split()
   133	        fam = COALITION_FAMILY.get(g, "X6-SE/v2")
   134	        return [_sid("headline", r, fam, "min", g), _sid("headline", r, fam, "total", g)]
   135	    if pid == "Q3-e":
   136	        return [_sid("headline", r, "X8-DB", "total", "c2_roles") for r in ("F111", "C*")]
   137	    if pid == "Q3-f":
   138	        rules, o = (("F000", "F111"), cell.split()[1]) if cell.startswith("F000<") else ((cell.split()[0],), cell.split()[1])
   139	        return [_sid("headline", r, f, o) for r in rules for f in ("D2+H3", "X7-SC")]
   140	    if pid == "Q3-g":
   141	        return [_sid("headline", r, "D2", rho="1") for r in ("F111", "R4")]
   142	    if pid == "Q4-a":
   143	        return [_sid(m, r, "D2+H3") for m in FRESH for r in ("F000", "F111")]
   144	    if pid == "Q4-b":
   145	        return [_sid(cell, r, "D2+H3") for r in ("F000", "F111")]
   146	    raise ValueError(f"no input map for {pid}")
   147	
   148	
   149	def eligibility(sc: dict, flagged, scope: str) -> dict:
   150	    """Each cell lists its flagged required searches. Under 'q3' (the reviewer's reading) a Q3 cell with a flagged input is
   151	    not assessed; under 'descriptive' every cell outside DECISIONS is; 'numerical' keeps the scorer's statuses."""
   152	    if scope not in SCOPES:
   153	        raise ValueError(f"unknown scope {scope}")
   154	    fl, out = set(flagged), {}
   155	    for pid, v in sc.items():
   156	        hit = scope == "descriptive" and pid not in DECISIONS or scope == "q3" and pid.startswith("Q3-")
   157	        cells = []
   158	        for c in v.get("cells", []):
   159	            f = [x for x in inputs(pid, c["cell"]) if x in fl]
   160	            cells.append({**c, "flagged": f, "status": NA if (hit and f) else c["status"]})
   161	        out[pid] = {**_combine(cells), "cells": cells} if cells else dict(v)
   162	    return out
   163	
   164	
   165	def tally(sc: dict) -> dict:
   166	    st = [v["status"] for v in sc.values()]
   167	    return {s: st.count(s) for s in ("fulfilled", "failed", NA)}
   168	
   169	
   170	def eligibility_map(sc: dict, flagged) -> dict:
   171	    by = {s: eligibility(sc, flagged, s) for s in SCOPES}
   172	    return {"flagged": sorted(set(flagged)), "tally": {s: tally(by[s]) for s in SCOPES},
   173	            "targets": {pid: {"decision": pid in DECISIONS, "status": {s: by[s][pid]["status"] for s in SCOPES},
   174	                              "flagged": sorted({x for c in by["numerical"][pid].get("cells", []) for x in c["flagged"]}),
   175	                              "cells": {c["cell"]: c["flagged"] for c in by["numerical"][pid].get("cells", []) if c["flagged"]}}
   176	                        for pid in sorted(sc)}}
   177	
   178	
   179	def main(argv=None) -> int:
   180	    ap = argparse.ArgumentParser(); ap.add_argument("--report", required=True); ap.add_argument("--cells", required=True)
   181	    ap.add_argument("--write", required=True)
   182	    ap.add_argument("--eligibility", help="also write the eligibility map (flagged inputs, three readings) here")
   183	    a = ap.parse_args(argv); rep = json.loads(Path(a.report).read_text())
   184	    sc = score(rep, json.loads(Path(a.cells).read_text()))
   185	    Path(a.write).write_text(json.dumps(sc, indent=1, sort_keys=True))
   186	    if a.eligibility:
   187	        Path(a.eligibility).write_text(json.dumps(eligibility_map(sc, rep.get("search_flagged") or []), indent=1, sort_keys=True))
   188	    return 0
   189	
   190	
   191	if __name__ == "__main__":
   192	    sys.exit(main())

