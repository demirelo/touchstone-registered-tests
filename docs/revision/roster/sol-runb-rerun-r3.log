def finite(*xs) -> bool:
    def vals(x):
        if isinstance(x, dict):
            for v in x.values():
                yield from vals(v)
        elif isinstance(x, (list, tuple)):
            for v in x:
                yield from vals(v)
        elif isinstance(x, (int, float)) and not isinstance(x, bool):
            yield x
    return all(math.isfinite(v) for x in xs for v in vals(x))


