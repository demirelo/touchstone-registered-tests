   338	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   339	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   340	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   341	    expected = expected or {}
   342	    for rid in expected:
   343	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   344	            raise ValueError(f"{rid}: the run's result is missing")
   345	    sub, out = [], {}
   346	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   347	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   348	        for m in markets:
   349	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   350	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   351	                continue
   352	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra, expected), _cell_gains(src, conv, rb, expected)
   353	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   354	            sub += [r for r, s_ in ((ra, sa), (rb, sb)) if s_ and r not in sub]
   355	        if fz_a:
   356	            out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   357	    return {"label": "exploratory sensitivity; the frozen estimates stay primary; " + C.SCOPE, **out, "substituted": sub}
