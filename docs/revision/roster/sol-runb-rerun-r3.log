   319	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "cost_stopped": stopped, "cost": r.get("cost") if stopped else None, "site": site, "compared_with": "frozen stage, same machine" if ref else "registered record",
   320	            "comparison": r["round1_gate"],
   321	            "round1": (r.get("rounds") or [None])[0],
   322	            "binding": bind, "environment": G.environment()}
