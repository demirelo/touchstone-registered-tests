   325	def _cell_gains(src, conv, rid: str, expected: dict):
   326	    f = read(R.eval_path(src, rid))
   327	    if rid not in expected:
   328	        return f["gain"], f["gain"], False
   329	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   330	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   331	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   332	    g = c["heldout"]["gain"]
   333	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   334	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   335	    return f["gain"], g, True
