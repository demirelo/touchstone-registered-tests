   311	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   312	    """Gate mode: round 1 only. On the Mac it is compared with the frozen doubling stage run on the same machine (flagged
   313	    cells diverge across platforms); on the pod, with the registered doubling record. Saved full-budget evidence bound to
   314	    the cell's inputs, this driver, the site, and the environment."""
