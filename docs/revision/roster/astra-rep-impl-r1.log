   181	def _menu_freeze(out: Path, jobs: list[dict]) -> None:
   182	    """A follow-up freeze per context: every search record and the targets' references, each validated (stage,
   183	    provenance, dependency set and hashes), so the reset driver's input and pairing checks can read this directory."""
   184	    import revision_v2 as R
   185	    from reset_followup_v2 import CUTS, DEVIATIONS, H4_EXCLUDED
   186	    from runnerup_v2 import _validate_new
   187	    from sim.records_v2 import read, write
   188	    for ctx in sorted({j["context"] for j in jobs}):
   189	        cj = [j for j in jobs if j["context"] == ctx]
   190	        recs = {j["id"]: _validate_new(out, j["id"], "search", j["provenance"], jobs) for j in cj}
   191	        for t in TARGETS:
   192	            rid = f"reference/{ctx}/{t}"
   193	            recs[rid] = _validate_new(out, rid, "reference", R.reference_provenance(next(j for j in cj if j["rule"] == t)), jobs)
   194	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS,
   195	                "h4_excluded": H4_EXCLUDED, "records": recs}
   196	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
