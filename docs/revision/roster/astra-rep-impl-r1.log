    44	def continuation_queue(flagged: list[dict]) -> list[dict]:
    45	    """The flagged cells in the fixed order: rate 0.05, 0.03, 0; markets fresh0..5; rules R3, C*, C-thr, B3.
    46	    Each item: {"rate": float, "market": str, "rule": "F111" | "C*" | "Cthr" | "F000", ...}."""
    47	    rk = {r: i for i, r in enumerate(CONT_RATE_ORDER)}; uk = {r: i for i, r in enumerate(CONT_RULE_ORDER)}
    48	    bad = [c for c in flagged if c["rate"] not in rk or c["rule"] not in uk or c["market"] not in MARKETS]
    49	    if bad:
    50	        _refuse(f"unknown cells in the flag list: {bad[:3]}")
    51	    return sorted(flagged, key=lambda c: (rk[c["rate"]], MARKETS.index(c["market"]), uk[c["rule"]]))
