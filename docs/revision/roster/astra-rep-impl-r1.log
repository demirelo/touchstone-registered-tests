    58	def require(root, manifest) -> None:
    59	    m = json.loads(Path(manifest).read_text())
    60	    bad = frozen_problems(root, m["commit"]) + verify(root, manifest)
    61	    if bad:
    62	        raise SystemExit("commitment check failed:\n" + "\n".join(bad))
