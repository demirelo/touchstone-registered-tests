    62	def admit_workers(requested: int, limit_bytes: int | None, peak_bytes: float, parent_bytes: float = 2e9, headroom: float = 1.25) -> int:
    63	    """Pod-memory admission (plan section 5): the largest worker count whose measured peak with 25 percent headroom,
    64	    plus the parent, fits the pod's cgroup limit; at least 1 only if one task fits, else refuse."""
    65	    if limit_bytes is None:
    66	        return requested
    67	    fit = int((limit_bytes - parent_bytes) // (peak_bytes * headroom))
    68	    if fit < 1:
    69	        _refuse(f"one task needs {peak_bytes * headroom / 1e9:.1f} GB with headroom; the limit is {limit_bytes / 1e9:.1f} GB")
    70	    return min(requested, fit)
