     1	"""Cost estimate of the churn replication (plan draft 3, review r3 caveats applied) from experiments/v2/benchmark/timings.json, the churn slowdown
     2	measured for the churn arm (docs/revision/churn/churn_cost.py) and the memory-safe worker counts of the churn arm and
     3	Run B. Two numbers per scenario: core-hours at 0.108 USD per core-hour, and billed pod time from a stage schedule
     4	(waves at the stage's worker limit, stages in sequence) at 0.56 USD per hour; the estimate is the larger of the two.
     5	Assumptions are named inline; review round 1 asked for the schedule, the gates, calibration, diagnostics, continuation
     6	slowdown and a flag-share sensitivity.
     7	Usage (repository root): python3 docs/revision/followup3/cost_estimate.py"""
     8	import json
     9	import math
    10	
    11	T = json.load(open("experiments/v2/benchmark/timings.json"))["timings"]
    12	U, POD, PREP, PODS, TRANSFER_H = 0.108, 0.56, 0.6, 2, 0.2   # two pods, each with preparation and a transfer tail
    13	MARKETS, RULES, MENU_RULES, RATES = 6, 4, 10, (0.03, 0.05)
    14	SLOW = 8.62 / 6.48                     # the p = 0.05 slowdown, applied to every churn stage (conservative for 0.03)
    15	CALIB_H = 0.25                         # assumption: six calibrations of 20 seeds each on the pod (not benchmarked)
    16	W_SEARCH, W_EVAL, W_CONT = 16, 9, 5    # churn arm (search 16, evaluate and doubling 9); Run B continuation 5
    17	EV = T["eval160"]["profit"] * 200 / 160
    18	DIAG = 60.0
    19	
    20	
    21	def waves(n: int, w: int) -> int:
    22	    return math.ceil(n / w) if n else 0
    23	
    24	
    25	def estimate(flag_share: float, rounds: int = 3) -> dict:
    26	    cells = (1 + len(RATES)) * MARKETS * RULES                      # 72 evaluation cells
    27	    menu_d2 = MARKETS * (MENU_RULES + 1)                            # ten matched rules plus C-thr(12), D2+H3
    28	    menu_x7 = MARKETS * (MENU_RULES + 1)                            # the same in X7-SC; menu X7-SC winners get no doubling
    29	    churn_cells = len(RATES) * MARKETS * RULES
    30	    flagged = round(flag_share * cells)
    31	    cont_round = (T["doubling"] + EV) * SLOW                        # one continuation round; round 1 repeats the doubling
    32	    stages = {   # name: (core seconds, schedule seconds), in execution order (review r2: D2+H3 before X7-SC, gates after
    33	        # their menu and reference inputs)
    34	        "calibration": (CALIB_H * 3600, CALIB_H * 3600),
    35	        "menu_d2h3": (menu_d2 * T["d2h3_cell"], waves(menu_d2, W_SEARCH) * T["d2h3_cell"]),
    36	        "menu_x7": (menu_x7 * T["x7_cell"], waves(menu_x7, W_SEARCH) * T["x7_cell"]),     # needs the embedded D2+H3 winner
    37	        "references": (MARKETS * RULES * T["reference"], MARKETS * RULES * T["reference"]),               # serial, as Run A
    38	        "gate_churn_zero": (T["d2h3_cell"] + 2 * (EV + T["doubling"]), T["d2h3_cell"] + 2 * (EV + T["doubling"])),   # review
    39	        # r3: one churn-zero search, evaluation and doubling against the ordinary menu search and its evaluation and doubling
    40	        # (search, evaluate and doubling must agree); serial, after the menus and references
    41	        "p0_eval_doubling": (MARKETS * RULES * (EV + T["doubling"]), waves(MARKETS * RULES, W_EVAL) * (EV + T["doubling"])),
    42	        "gate_churn_nonzero": (cont_round, cont_round),   # after the first p = 0.05 cell's search, evaluation and doubling
    43	        # (reused in production): its continuation round 1 against its own doubling record
    44	        "churn_search": (churn_cells * T["d2h3_cell"] * SLOW, waves(churn_cells, W_SEARCH) * T["d2h3_cell"] * SLOW),
    45	        "churn_eval_doubling": (churn_cells * (EV + T["doubling"]) * SLOW, waves(churn_cells, W_EVAL) * (EV + T["doubling"]) * SLOW),
    46	        "continuation": (flagged * rounds * cont_round, waves(flagged, W_CONT) * rounds * cont_round),
    47	        "diagnostics": (cells * 2 * DIAG * SLOW, waves(cells * 2, W_EVAL) * DIAG * SLOW),   # frozen and final winners
    48	    }
    49	    core_h = sum(c for c, _ in stages.values()) / 3600
    50	    sched_h = sum(s for _, s in stages.values()) / 3600 + PODS * (PREP + TRANSFER_H)
    51	    usd_core, usd_pod = core_h * U, sched_h * POD
    52	    est = max(usd_core, usd_pod)
    53	    return {"flag_share": flag_share, "flagged_cells": flagged,
    54	            "schedule_hours": {k: round(s / 3600, 2) for k, (_, s) in stages.items()},
    55	            "core_hours": round(core_h, 1), "billed_pod_hours": round(sched_h, 1),
    56	            "usd_core": round(usd_core, 2), "usd_pod": round(usd_pod, 2), "estimate_usd": round(est, 2),
    57	            "estimate_x1.25": round(est * 1.25, 2)}
    58	
    59	
    60	if __name__ == "__main__":
    61	    print(json.dumps([estimate(0.30), estimate(0.50)], indent=1))

