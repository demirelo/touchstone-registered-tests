    47	def frozen_problems(root, commit: str) -> list:
    48	    out = []
    49	    if _git(root, "diff", "--quiet", commit, "--", *FROZEN).returncode != 0:
    50	        out.append(f"{', '.join(FROZEN)} differ from commit {commit}")
    51	    untracked = _git(root, "ls-files", "--others", "--exclude-standard", "--", *FROZEN).stdout.split()
    52	    if untracked:
    53	        out.append(f"untracked files under {', '.join(FROZEN)}: {', '.join(untracked[:5])}")
    54	    out += [f"environment override set: {v}" for v in OVERRIDES if os.environ.get(v)]
    55	    return out
