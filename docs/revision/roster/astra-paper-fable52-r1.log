+    assert got["frozen"]["mean"] == pytest.approx(0.020700, abs=1e-6) and got["frozen"]["positive"] == 5 and got["frozen"]["n"] == 6
+    lo, hi = got["frozen"]["t95"]                                   # values from scipy on the report numbers (2026-11-10 command)
