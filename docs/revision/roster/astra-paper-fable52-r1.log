+            p = tmp_path / "search" / (P.safe(f"{m}@rho0.2|{rule}|X7-SC|profit") + ".json"); p.parent.mkdir(parents=True, exist_ok=True)
+            p.write_text(json.dumps({"attack": {"best_source": src}}))
+    got = P.x7_embedding(tmp_path, ["fresh0", "fresh1"])
