   190	        out[rid] = keys
   191	    return out
   192	
   193	
   194	def eligibility(sc: dict, flagged, scope: str, deps: dict | None = None) -> dict:
   195	    """Each cell lists its flagged required searches: its direct inputs and, with deps, everything they depend on. Under
   196	    'q3' a Q3 cell with a flagged required search is not assessed; under 'descriptive' every cell outside DECISIONS is (a
   197	    convention of this sensitivity: design 6.5 keeps the decisions, it does not say how predictions about them are
   198	    scored); 'numerical' keeps the scorer's statuses."""
   199	    if scope not in SCOPES:
   200	        raise ValueError(f"unknown scope {scope}")
   201	    fl, out = set(flagged), {}
   202	    for pid, v in sc.items():
   203	        hit = scope == "descriptive" and pid not in DECISIONS or scope == "q3" and pid.startswith("Q3-")
   204	        cells = []
   205	        for c in v.get("cells", []):
   206	            req = set(inputs(pid, c["cell"]))
   207	            for x in list(req):
   208	                req |= (deps or {}).get(x, set())
   209	            f = sorted(req & fl)
   210	            cells.append({**c, "flagged": f, "status": NA if (hit and f) else c["status"]})
   211	        out[pid] = {**_combine(cells), "cells": cells} if cells else dict(v)
   212	    return out
   213	
   214	
   215	def tally(sc: dict) -> dict:
   216	    st = [v["status"] for v in sc.values()]
   217	    return {s: st.count(s) for s in ("fulfilled", "failed", NA)}
   218	
   219	
   220	def eligibility_map(sc: dict, flagged, deps: dict | None = None) -> dict:
   221	    """Tallies with dependencies (the readings) and with direct inputs only (as in external review round 7); every cell
   222	    with its direct inputs, flagged required searches, and status under each reading."""
   223	    by = {s: eligibility(sc, flagged, s, deps) for s in SCOPES}
   224	    direct = {s: tally(eligibility(sc, flagged, s)) for s in SCOPES}
   225	    cells = lambda pid: {c["cell"]: {"inputs": inputs(pid, c["cell"]), "flagged": c["flagged"],
   226	                                     "status": {s: next(d["status"] for d in by[s][pid]["cells"] if d["cell"] == c["cell"]) for s in SCOPES}}
   227	                         for c in by["numerical"][pid].get("cells", [])}
   228	    return {"flagged": sorted(set(flagged)), "dependencies_traced": deps is not None,
   229	            "tally": {s: tally(by[s]) for s in SCOPES}, "tally_direct_inputs": direct,
   230	            "targets": {pid: {"decision": pid in DECISIONS, "status": {s: by[s][pid]["status"] for s in SCOPES},
   231	                              "flagged": sorted({x for c in by["numerical"][pid].get("cells", []) for x in c["flagged"]}),
   232	                              "cells": cells(pid)}
   233	                        for pid in sorted(sc)}}
   234	
   235	
   236	def main(argv=None) -> int:
   237	    ap = argparse.ArgumentParser(); ap.add_argument("--report", required=True); ap.add_argument("--cells", required=True)
   238	    ap.add_argument("--write", required=True)
   239	    ap.add_argument("--eligibility", help="also write the eligibility map (flagged inputs, three readings) here")
   240	    ap.add_argument("--records", help="evaluation records (eval/all); with --eligibility, trace recorded dependencies")
   241	    a = ap.parse_args(argv); rep = json.loads(Path(a.report).read_text())
   242	    sc = score(rep, json.loads(Path(a.cells).read_text()))
   243	    Path(a.write).write_text(json.dumps(sc, indent=1, sort_keys=True))
   244	    if a.eligibility:
   245	        ids = sorted({x for pid, v in sc.items() for c in v.get("cells", []) for x in inputs(pid, c["cell"])})
   246	        deps = dependencies(a.records, ids) if a.records else None
   247	        em = eligibility_map(sc, rep.get("search_flagged") or [], deps)
   248	        Path(a.eligibility).write_text(json.dumps(em, indent=1, sort_keys=True))
   249	    return 0
   250	
   251	
   252	if __name__ == "__main__":
