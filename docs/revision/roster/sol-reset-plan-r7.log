   259	    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
   260	            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
   261	    inv = {"stage": "inventory", "deviations": list(DEVIATIONS), "environment": environment(), "records": recs}
   262	    write(out / "inventory.json", inv)
