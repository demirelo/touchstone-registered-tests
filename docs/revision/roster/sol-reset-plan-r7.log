     1	"""Protocol v2: writer and checker (design 2, 7.3, 9.6; operations plan Task 6). --write builds experiments/protocol-v2.yaml
     2	from the promoted inputs: the hashes of the manifest, parameters, promotion record, frozen cost decision, coverage, and
     3	predictions; the decision's branch, markets, and cuts; kappa from kappa_effective (admitted only); the H4 commitment; the
     4	recorded spend; the block, seed, market, and cap rules. --check re-derives every value from its file. --check-commit runs
     5	in the evaluation checkout: a clean tree, a valid signed tag protocol-v2 at HEAD, only data and documents changed since
     6	code_commit, and --check."""
     7	from __future__ import annotations
     8	
     9	import argparse
    10	import hashlib
    11	import json
    12	import re
    13	import subprocess
    14	import sys
    15	from pathlib import Path
    16	
    17	import yaml
    18	
    19	ROOT = Path(__file__).resolve().parents[1]
    20	PROTOCOL = "experiments/protocol-v2.yaml"
    21	TAG = "protocol-v2"
    22	FILES = {"manifest_sha256": "experiments/revision-v2-manifest.yaml", "params_sha256": "experiments/v2/params.json",
    23	         "promotion_sha256": "experiments/v2/promotion.json", "decision_sha256": "experiments/v2/benchmark/decision.json",
    24	         "coverage_sha256": "experiments/v2/coverage.json", "predictions_sha256": "docs/revision/predictions-v2.md"}
    25	LEDGER = "docs/revision/budget-ledger.json"
    26	ALLOWED = ("experiments/v2/", "docs/")
    27	ALLOWED_FILES = (PROTOCOL, PROTOCOL + ".ots")
    28	APPROVAL_LIMIT = 40.0
    29	
    30	
    31	def _sha(p: Path) -> str:
    32	    return hashlib.sha256(Path(p).read_bytes()).hexdigest()
    33	
    34	
    35	def _json(p: Path) -> dict:
    36	    return json.loads(Path(p).read_text())
    37	
    38	
    39	def _spent(repo: Path) -> float:
    40	    p = Path(repo) / LEDGER
    41	    return float(sum(float(r["usd"]) for r in _json(p).get("spent", []))) if p.exists() else 0.0
    42	
    43	
    44	def _choices(dec: dict, cuts: int, branch: str, markets: list[str], approval: str | None) -> list[str]:
    45	    out = []
    46	    if (int(cuts), branch, list(markets)) != (dec.get("cuts"), dec.get("branch"), list(dec.get("markets") or [])):
    47	        out.append(f"decision: cuts, branch, markets ({cuts}, {branch}, {markets}) differ from the frozen decision "
    48	                   f"({dec.get('cuts')}, {dec.get('branch')}, {dec.get('markets')})")
    49	    if float(dec.get("total_usd") or 0.0) > APPROVAL_LIMIT and not approval:
    50	        out.append(f"approval: the decision's total {dec.get('total_usd')} USD is above {APPROVAL_LIMIT} and needs the author's written approval")
    51	    return out
    52	
    53	
    54	def decision_file(repo, h4: dict | None) -> Path:
    55	    """Design draft 7, 5.3: with H4 committed, the protocol binds the decision after the H4 timing."""
    56	    b = Path(repo) / "experiments" / "v2" / "benchmark"
    57	    return b / ("decision-h4.json" if h4 else "decision.json")
    58	
    59	
    60	def _ledger_approval(repo) -> str | None:
    61	    p = Path(repo) / LEDGER
    62	    return ((_json(p).get("approval") or {}).get("text")) if p.exists() else None
    63	
    64	
    65	def build(repo, code_commit: str, cuts: int, h4: dict | None, approval: str | None, branch: str, markets: list) -> dict:
    66	    repo = Path(repo); df = decision_file(repo, h4)
    67	    if not df.exists():
    68	        raise SystemExit(f"{df.relative_to(repo)}: missing (with H4, the protocol needs the decision after the H4 timing)")
    69	    dec = _json(df)["decision"]
    70	    problems = _choices(dec, cuts, branch, markets, approval)
    71	    led = _ledger_approval(repo)
    72	    if approval and led is not None and approval != led:
    73	        problems.append("approval: the text differs from the approval recorded in the budget ledger (budget_v2 --approve)")
    74	    if problems:
    75	        raise SystemExit("; ".join(problems))
    76	    cov = _json(repo / FILES["coverage_sha256"])
    77	    p = {"version": 2, "code_commit": str(code_commit), **{k: _sha(repo / rel) for k, rel in FILES.items()}, "decision_sha256": _sha(df), "cuts": int(cuts), "branch": branch,
    78	         "development_markets": list(markets), "h4": dict(h4) if h4 else None,
    79	         "kappa": {f: (cov.get(f) or {}).get("kappa_effective") for f in ("Q1", "Q4")},
    80	         "cost": {"development_usd": dec.get("development_usd"), "evaluation_usd": dec.get("evaluation_usd"), "total_usd": dec.get("total_usd"),
    81	                  "spent_usd": _spent(repo)},
    82	         "approval": approval, "block": {"rule": "H = A + 144", "depth": 6, "explorers": ["blockstream.info", "mempool.space"]},
    83	         "seeds": {"eval_range": [30_000_000, 40_000_000], "per_market": 200}, "markets": ["headline"] + [f"fresh{i}" for i in range(6)],
    84	         "caps": {"development": 12, "evaluation": 40}}
    85	    bad = check(repo, p)
    86	    if bad:
    87	        raise SystemExit("; ".join(bad))
    88	    return p
    89	
    90	
    91	def check(repo, protocol: dict) -> list[str]:
    92	    repo = Path(repo); out = []
    93	    files = {**FILES, "decision_sha256": decision_file(repo, protocol.get("h4")).relative_to(repo).as_posix()}
    94	    for k, rel in files.items():
    95	        f = repo / rel
    96	        if not f.exists() or _sha(f) != protocol.get(k):
    97	            out.append(f"{rel}: missing or its hash differs from the protocol's {k}")
    98	    if out:
    99	        return out
   100	    from scripts.promote_v2 import derive_params, verify_promoted
   101	    v2 = repo / "experiments" / "v2"
   102	    out += verify_promoted(v2)
   103	    try:
   104	        if _json(v2 / "params.json") != derive_params(v2):
   105	            out.append("params.json does not follow from the promoted comparator and tuned files")
   106	    except (OSError, KeyError, ValueError) as e:
   107	        out.append(f"params.json cannot be derived from the promoted files: {e}")
   108	    dec = _json(repo / files["decision_sha256"])["decision"]
   109	    out += _choices(dec, protocol.get("cuts"), protocol.get("branch"), protocol.get("development_markets") or [], protocol.get("approval"))
   110	    led = _ledger_approval(repo)
   111	    if protocol.get("approval") and led is not None and protocol["approval"] != led:
   112	        out.append("approval: the text differs from the approval recorded in the budget ledger")
   113	    cov = _json(repo / FILES["coverage_sha256"])
   114	    if protocol.get("kappa") != {f: (cov.get(f) or {}).get("kappa_effective") for f in ("Q1", "Q4")}:
   115	        out.append("coverage: kappa differs from kappa_effective")
   116	    if abs(float((protocol.get("cost") or {}).get("spent_usd", -1)) - _spent(repo)) > 1e-9:
   117	        out.append("ledger: the recorded spend differs from the protocol's spent_usd")
   118	    h4 = protocol.get("h4")
   119	    com = repo / "experiments" / "v2" / "h4" / "commitment.json"
   120	    if h4 is not None and com.exists() and _json(com).get("bundle_sha256") != h4.get("bundle_sha256"):
   121	        out.append("h4: the protocol's bundle hash differs from the author's commitment (experiments/v2/h4/commitment.json)")
   122	    if h4 is not None and not (re.fullmatch(r"[0-9a-f]{40}", str(h4.get("commit"))) and re.fullmatch(r"[0-9a-f]{64}", str(h4.get("bundle_sha256")))):
   123	        out.append("h4: the commitment needs a 40-hex commit and a 64-hex bundle hash")
   124	    if protocol.get("version") != 2 or not re.fullmatch(r"[0-9a-f]{40}", str(protocol.get("code_commit"))):
   125	        out.append("protocol: version 2 and a 40-hex code_commit are required")
   126	    return out
