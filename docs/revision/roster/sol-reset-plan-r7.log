   293	def diagnostics(src, out, jobs: list[dict], report: dict, d2_from=None) -> dict:
   294	    """Plan section 4 (draft 5), evaluation only: for each D2 job's (context, rule), the base and doubled D2+H3 winners and
   295	    the base D2 winner on the evaluation seeds with reset instrumentation; the switch g(winner) - g(winner with x = 0) for
   296	    the D2+H3 winners and the reverse switch g(D2 winner with x = 1) - g(D2 winner). The reference cancels in each switch,
   297	    so it is a difference of normalised profits."""
   298	    import numpy as np
   299	    from sim.cell import SeedCache, run_focal
   300	    res = {}
   301	    for j in jobs:
   302	        T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j); cache = SeedCache()
   303	        h3 = R.cell_id(j["context"], j["rule"], "D2+H3", "profit")
   304	        pols = {"d2h3_base": read(R.path_of(src, h3))["attack"]["best_knobs"], "d2h3_doubled": report["doubling"][h3]["heldout"]["knobs"],
   305	                "d2_base": with_x(read(R.path_of(d2_from or out, j["id"]))["attack"]["best_knobs"], 0)}
   306	        runs = {k: run_focal(cell, lambda k=k: fam.make(dict(pols[k])), cache) for k in pols}
   307	        row = {k: {"knobs": pols[k], **reset_stats(runs[k].results, cell.focal), "seeds": list(cell.seeds),
   308	                   "normalized": [float(v) for v in runs[k].normalized], "mean_normalized": float(np.mean(runs[k].normalized))} for k in pols}
   309	        require_zero_resets(row["d2_base"], j["id"])
   310	        for k in ("d2h3_base", "d2h3_doubled"):
   311	            if int(pols[k].get("x", 0)) == 0:
   312	                row[k]["switch_x0"] = {"identical": True, "effect": 0.0}
   313	            else:
   314	                off = run_focal(cell, lambda k=k: fam.make(with_x(pols[k], 0)), cache)
   315	                diff = runs[k].normalized - off.normalized
   316	                row[k]["switch_x0"] = {"identical": False, "effect": float(np.mean(diff)), "per_seed": [float(v) for v in diff]}
   317	        on = run_focal(cell, lambda: fam.make(with_x(pols["d2_base"], 1)), cache)
   318	        diff = on.normalized - runs["d2_base"].normalized
   319	        row["d2_base"]["switch_x1"] = {"effect": float(np.mean(diff)), "per_seed": [float(v) for v in diff]}
   320	        res[f"{j['context']}|{j['rule']}"] = row
   321	    return res
