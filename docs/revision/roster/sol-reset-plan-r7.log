   338	def compare(src, out, rid: str = REPRO) -> dict:
   339	    """Validation (a), plan draft 5: exact on the provenance keys (the commit may differ), the episode count, the attack and
   340	    twin archive sizes, `best_source`, the discrete knobs, the search and evaluation dependency ids, the reference hash and
   341	    the seeds; continuous knobs within KNOB_TOL relative and per-seed gains within GAIN_TOL absolute; every value finite.
   342	    `identical` additionally needs bit-identical knobs and gains."""
   343	    a, b = read(R.path_of(src, rid)), read(R.path_of(out, rid)); ea, eb = read(R.eval_path(src, rid)), read(R.eval_path(out, rid))
   344	    if None in (a, b, ea, eb):
   345	        return {"pass": False, "identical": False, "problems": ["a record is missing"]}
   346	    problems = []
   347	    ka, kb = a["attack"]["best_knobs"], b["attack"]["best_knobs"]
   348	    objs = [x.get("best_f") for x in (a["attack"], b["attack"], a.get("twin") or {}, b.get("twin") or {})] + [c.get("f") for c in a.get("controls", []) + b.get("controls", [])]
   349	    if not _finite(list(ka.values()), list(kb.values()), ea["gain"], eb["gain"], objs) or None in objs[:2]:
   350	        problems.append("nonfinite value")
   351	    ta, tb = (a.get("twin") or {}).get("best_f"), (b.get("twin") or {}).get("best_f")
   352	    if ta is None or tb is None or not abs(ta - tb) <= GAIN_TOL:
   353	        problems.append("twin best value differs")
   354	    ca, cb = a.get("controls", []), b.get("controls", [])
   355	    if [c["knobs"] for c in ca] != [c["knobs"] for c in cb]:
   356	        problems.append("control set differs")
   357	    cd = [abs(x["f"] - y["f"]) for x, y in zip(ca, cb) if x["f"] != y["f"]]
   358	    if set(ka) != set(kb):
   359	        problems.append("knob names differ")
   360	    disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   361	    if any(ka[k] != kb.get(k) for k in disc):
   362	        problems.append("discrete knob differs")
   363	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   364	    if not rel <= KNOB_TOL:
   365	        problems.append(f"knob tolerance exceeded ({rel:.3g})")
   366	    for k in EXACT_PROV:
   367	        if a["provenance"].get(k) != b["provenance"].get(k):
   368	            problems.append(f"{k} differs")
   369	    ua, ub = ea.get("upstream") or {}, eb.get("upstream") or {}
   370	    refs = sorted(u for u in ua if u.startswith("reference/"))
   371	    for what, x, y in (("episode count", a.get("runs"), b.get("runs")), ("best_source", a["attack"].get("best_source"), b["attack"].get("best_source")),
   372	                       ("archive size", len(a["attack"].get("archive", [])), len(b["attack"].get("archive", []))),
   373	                       ("twin archive size", len((a.get("twin") or {}).get("archive", [])), len((b.get("twin") or {}).get("archive", []))),
   374	                       ("dependency set", sorted(a.get("upstream") or {}), sorted(b.get("upstream") or {})),
   375	                       ("evaluation dependency set", sorted(ua), sorted(ub)), ("reference hash", [ua.get(r) for r in refs], [ub.get(r) for r in refs]),
   376	                       ("seeds", ea["seeds"], eb["seeds"])):
   377	        if x != y:
   378	            problems.append(f"{what} differs")
   379	    gd = max((abs(x - y) for x, y in zip(ea["gain"], eb["gain"])), default=0.0) if len(ea["gain"]) == len(eb["gain"]) else float("inf")
   380	    if not gd <= GAIN_TOL:
   381	        problems.append(f"gain tolerance exceeded ({gd:.3g})")
   382	    controls = {"differing": len(cd), "max_abs": max(cd, default=0.0)}          # reported, not gated: a near-tie in a corner policy can flip a discrete branch
   383	    same_obj = ta == tb and not cd and a["attack"].get("best_f") == b["attack"].get("best_f")
   384	    return {"pass": not problems, "identical": not problems and ka == kb and ea["gain"] == eb["gain"] and same_obj, "max_knob_rel": rel, "max_gain_abs": gd,
   385	            "controls": controls, "problems": problems}
