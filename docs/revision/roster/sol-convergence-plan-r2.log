    89	def preflight(out, src, jobs: list[dict], salt_sha256: str, container: dict | None = None) -> None:
    90	    """Every check that must pass before any episode, on every execution path (internal review r4)."""
    91	    check_salt(out, salt_sha256, jobs); check_commit(jobs); check_code(); check_pairing(src, jobs)
    92	    if container is not None:
    93	        check_configs(jobs, container)
