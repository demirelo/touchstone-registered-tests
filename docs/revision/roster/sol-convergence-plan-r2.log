     1	"""The reset follow-up (docs/revision/reset-experiment-plan.md, draft 4, section 3): the 18 D2 cells that cut 3 removed
     2	(F000, F111, C* x fresh0..fresh5 at rho 0.2), run with the frozen stage functions of scripts/revision_v2.py.
     3	
     4	Three things of the frozen runner are bypassed, each a recorded deviation (DEVIATIONS): the manifest's cut list, the
     5	hard-coded doubling eligibility, and the original freeze. Everything else is the frozen code: `job`, `stage_search`,
     6	`stage_evaluate`, `stage_doubling`, reached through `revision_v2._run_one`, so the record format and the dependency sets
     7	are the registered ones.
     8	
     9	Order: copy the inputs (the frozen references, the menu searches and bank sources they list, each checked against the
    10	hash the original records hold), search, the follow-up freeze, acceptance, evaluation, acceptance, doubling, inventory.
    11	The output directory is never results/v2/eval/all."""
    12	from __future__ import annotations
    13	
    14	import argparse
    15	import json
    16	import shutil
    17	import sys
    18	from pathlib import Path
    19	
    20	ROOT = Path(__file__).resolve().parents[3]          # docs/revision/followup/ (code after the freeze lives under docs/)
    21	sys.path.insert(0, str(ROOT / "scripts")); sys.path.insert(0, str(ROOT))
    22	
    23	import revision_v2 as R  # noqa: E402
    24	from sim import manifest_v2 as MAN  # noqa: E402
    25	from sim.records_v2 import read, sha_file, write  # noqa: E402
    26	
    27	RULES = ("F000", "F111", "C*")
    28	MARKETS = tuple(f"fresh{i}" for i in range(6))
    29	CUTS, H4_EXCLUDED = 3, False                        # the registered evaluation: cuts 3, H4 loaded (results/v2/draw/h4.json)
    30	EVAL_ALL = ROOT / "results" / "v2" / "eval" / "all"
    31	DEVIATIONS = (
    32	    "manifest cut list bypassed: the 18 D2 cells (F000, F111, C* x fresh0..fresh5, rho 0.2) that cut 3 removed are run",
    33	    "doubling eligibility bypassed: each of the 18 cells gets a doubling check with its held-out evaluation",
    34	    "original freeze bypassed: this script's follow-up freeze and acceptance check replace revision_v2.accept",
    35	)
    36	
    37	
    38	def _refuse(msg: str):
    39	    raise SystemExit(f"reset follow-up refused: {msg}")
    40	
    41	
    42	def cell_ids(markets=MARKETS) -> list[str]:
    43	    return [R.cell_id(MAN.context(m), r, "D2", "profit") for m in markets for r in RULES]
    44	
    45	
    46	def restored_cells(markets=MARKETS) -> list[dict]:
    47	    uncut = {c["id"]: c for c in MAN.cells()}; kept = {c["id"] for c in MAN.effective(CUTS, H4_EXCLUDED)}; ids = cell_ids(markets)
    48	    if missing := [i for i in ids if i not in uncut]:
    49	        _refuse(f"not design cells: {missing}")
    50	    if present := [i for i in ids if i in kept]:
    51	        _refuse(f"not removed by cut {CUTS}: {present}")
    52	    return [uncut[i] for i in ids]
    53	
    54	
    55	def check_out(out, src=None) -> None:
    56	    o = Path(out).resolve()
