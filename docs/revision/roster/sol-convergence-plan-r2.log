   201	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES) -> dict:
   202	    """Q1 (C* - R3, D2+H3) and Q4 (B3 - R3, D2+H3) per market and pooled, with the final winners substituted for the
   203	    re-searched cells; descriptive, nominal paired bootstrap."""
   204	    sub, out = [], {}
   205	    for q, (a, b) in {"q1": ("C*", "F111"), "q4": ("F000", "F111")}.items():
   206	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   207	        for m in markets:
   208	            ra, rb = (f"{m}@rho0.2|{r}|D2+H3|profit" for r in (a, b))
   209	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra), _cell_gains(src, conv, rb)
   210	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   211	            sub += [r for r, s in ((ra, sa), (rb, sb)) if s and r not in sub]
   212	        out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   213	    return {"label": "exploratory sensitivity; the frozen estimates stay primary", **out, "substituted": sub}
