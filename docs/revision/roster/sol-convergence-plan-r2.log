   191	def _cell_gains(src, conv, rid: str):
   192	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   193	    f = read(R.eval_path(src, rid))
   194	    if c is not None and ((c.get("binding") or {}).get("smoke") is not False or "heldout" not in c):
   195	        raise ValueError(f"{rid}: not a validated full-run result (binding)")
   196	    if c is not None and c["heldout"]["seeds"] != f["seeds"]:
   197	        raise ValueError(f"{rid}: held-out seeds differ from the evaluation seeds")
   198	    return f["gain"], (c["heldout"]["gain"] if c else f["gain"]), c is not None
