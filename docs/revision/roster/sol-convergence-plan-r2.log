   200	def check_configs(jobs: list[dict], container: dict) -> None:
   201	    """Each job's configuration hash equals the recorded container hash (addendum.json deviations.configs)."""
   202	    for j in jobs:
   203	        label = j["mkt"]["label"]; want = (container.get(label) or {}).get("container_hash")
   204	        if j["provenance"]["cfg_sha256"] != want:
   205	            _refuse(f"{j['id']}: configuration hash {j['provenance']['cfg_sha256']} is not the container hash {want}")
   206	
   207	
   208	def _ctx_inputs(out, ctx: str) -> dict[str, str]:
   209	    return {r: s for r, s in (read(Path(out) / "inputs.json") or {}).items() if ctx in r}
   210	
   211	
   212	def prefreeze(out, jobs: list[dict]) -> None:
   213	    """The pre-evaluation freeze of each context: its copied inputs and its new search records, with their hashes."""
   214	    for ctx in sorted({j["context"] for j in jobs}):
   215	        recs = dict(_ctx_inputs(out, ctx))
   216	        for j in (j for j in jobs if j["context"] == ctx):
   217	            p = R.path_of(out, j["id"]); rec = read(p)
   218	            if rec is None or rec.get("stage") != "search" or rec.get("provenance") != j["provenance"]:
   219	                _refuse(f"{j['id']}: no current search record to freeze")
   220	            recs[j["id"]] = sha_file(p)
   221	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED, "records": recs}
   222	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   223	        if old is not None and old != body:
   224	            _refuse(f"{p} exists with other records")
   225	        if old is None:
   226	            write(p, body)
   227	
   228	
   229	def accept(out, jobs: list[dict], salt_sha256: str, container: dict, src=None) -> None:
   230	    """Run before evaluation and before doubling: the freeze exists and every record in it, and every copied input,
   231	    still has its hash; the identity salt and the configurations are the recorded ones; with `src`, inputs.json holds
   232	    every input recomputed from the original records."""
   233	    check_salt(out, salt_sha256, jobs)
   234	    check_configs(jobs, container)
   235	    if src is not None:
   236	        have = read(Path(out) / "inputs.json") or {}
   237	        if bad := sorted(r for r, s in inputs(src, jobs).items() if have.get(r) != s):
   238	            _refuse(f"inputs.json lacks or differs on {bad[:3]}")
   239	    for ctx in sorted({j["context"] for j in jobs}):
   240	        fr = read(R.path_of(out, f"freeze/{ctx}"))
   241	        if fr is None or not fr.get("followup"):
   242	            _refuse(f"{ctx}: no follow-up freeze")
   243	        want = {**_ctx_inputs(out, ctx), **{j["id"]: None for j in jobs if j["context"] == ctx}}
   244	        if missing := sorted(set(want) - set(fr["records"])):
   245	            _refuse(f"{ctx}: the freeze lacks {missing}")
   246	        for r, sha in fr["records"].items():
   247	            p = R.path_of(out, r)
   248	            if not p.exists() or sha_file(p) != sha or (want.get(r) not in (None, sha)):
   249	                _refuse(f"{ctx}: {r} differs from the freeze")
   250	
