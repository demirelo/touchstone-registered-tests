   257	    t = json.loads((ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]
   258	    started = a.started if a.started is not None else __import__("time").time()
   259	    path = lambda j: out / "convergence" / (R._safe(j["id"]) + ".json")
