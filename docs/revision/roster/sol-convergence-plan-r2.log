"""Family names of protocol v2 and the candidate reconstruction shared by the runner, tuning, and coverage."""
from __future__ import annotations

from .cell import Abstain
from .policies.families import D2, Family
from .policies.honest import HonestMax
from .policies.identity import h3_family
from .policies.v2 import x5v2_family, x6v2_family
from .policies.x7 import x7_family
from .policies.x8 import x8_family
from .reference import Candidate


def family_for(name: str, T: int, L: int, h4_source=None) -> Family:
    if name == "D2":
        return D2
    if name == "D2+H3":
        return h3_family(D2)
    if name == "X7-SC":
        return x7_family(T, L)
    if name == "X5-AG/v2":
        return x5v2_family(T, L)
    if name == "X6-SE/v2":
        return x6v2_family(T, L)
    if name == "X8-DB":
        return x8_family(T, L)
    if name == "H4":
        if h4_source is None:
            raise ValueError("H4 is not loaded")
        return h4_source.family(T, L)
    raise ValueError(f"unknown family {name!r}")


def cand_from_json(d: dict, h4_source=None) -> Candidate:
    if d["knobs"] is None:
        return Candidate(d["name"], Abstain if d["name"] == "abstain" else HonestMax, None)
    fam = family_for(d["family"], int(d["T"]), int(d["L"]), h4_source); k = dict(d["knobs"])
    return Candidate(d["name"], lambda: fam.make(k), k)
"""Market instances and seed streams of the revision program (design 7.1, 7.2). A synthetic neighbourhood of the headline
market: N 10, J 50, T 200, sigma 0.05, no entry cost, v_min 0.6, beta 0.05, rho 0.2; per draw, sorted quality ceilings,
cost slopes falling with quality (plus noise), fixed costs, capacities, and the value ceiling. Every random input comes
from a domain-separated SHA-256 digest of a root: "dev-20261022" for the public development instances, the Bitcoin block
hash at height H for the fresh ones. Draw order inside an attempt: q_max (10), b_lo, b_hi, b noise (10), a (10), k (10),
v_max; attempts repeat in the same stream until the configuration validates."""
from __future__ import annotations

import hashlib

import numpy as np

from .calibrate import calibrate, cell_config
from .config import MarketConfig, ProviderParams

DEV_ROOT = "dev-20261022"
EVAL_RANGE = (30_000_000, 40_000_000)
COVERAGE_RANGE = (40_000_000, 60_000_000)
CALIBRATION_SEEDS = tuple(range(4000, 4020))
LIMIT = 10_000


class InstanceLimit(RuntimeError):
    pass


def digest(root: str, domain: str, n: int) -> bytes:
    return hashlib.sha256(f"{root}|touchstone-v2|{domain}|{int(n)}".encode("ascii")).digest()


def stream(root: str, i: int) -> np.random.Generator:
    return np.random.Generator(np.random.PCG64(int.from_bytes(digest(root, "instance", i)[:16], "big")))


def draw_instance(rng: np.random.Generator, limit: int = LIMIT) -> tuple[MarketConfig, int]:
    for rejections in range(int(limit)):
        q = np.sort(rng.uniform(0.55, 1.0, 10)); b_lo = rng.uniform(0.18, 0.26); b_hi = rng.uniform(0.34, 0.46)
        noise = rng.uniform(-0.02, 0.02, 10); a = rng.uniform(0.0, 0.05, 10); k = rng.integers(4, 9, size=10); v_max = rng.uniform(1.2, 1.6)
        b = [b_hi - (b_hi - b_lo) * r / 9 + noise[r] for r in range(10)]
        providers = tuple(ProviderParams(q_max=float(q[r]), a=float(a[r]), b=float(b[r]), k=int(k[r])) for r in range(10))
        cfg = MarketConfig(N=10, J=50, T=200, sigma=0.05, e=0.0, v_min=0.6, v_max=float(v_max), providers=providers, alpha=0.05, budget=0.0)
        try:
            cfg.validate()
        except ValueError:
            continue
        return cfg, rejections
    raise InstanceLimit(f"no valid instance in {limit} draws")


def _draw_stream(root: str, i: int, limit: int) -> tuple[MarketConfig, int]:
    return draw_instance(stream(root, i), limit)


def markets(root: str, count: int, prefix: str = "fresh", limit: int = LIMIT) -> list[dict]:
    """Label <prefix><i> uses stream i; a stream that hits the limit gives its label the next unused index >= count."""
    out, spare = [], int(count)
    for i in range(int(count)):
        idx = i
        while True:
            try:
                cfg, rej = _draw_stream(root, idx, limit); break
            except InstanceLimit:
                idx, spare = spare, spare + 1
        out.append({"label": f"{prefix}{i}", "stream_index": idx, "cfg": cfg, "rejections": rej})
    return out


def dev_markets() -> list[dict]:
    return markets(DEV_ROOT, 2, prefix="dev")


def calibrated(cfg: MarketConfig, rho: float = 0.2, beta: float = 0.05) -> MarketConfig:
    return cell_config(cfg, calibrate(cfg, list(CALIBRATION_SEEDS)), rho=rho, beta=beta)


def _seeds(root: str, domain: str, n: int, lo: int, width: int) -> list[int]:
    out, seen, c = [], set(), 0
    while len(out) < int(n):
        v = lo + int.from_bytes(digest(root, domain, c)[:8], "big") % width; c += 1
        if v not in seen:
            seen.add(v); out.append(v)
    return out


def eval_seeds(root: str, label: str, n: int = 200) -> list[int]:
    return _seeds(root, "seeds/" + label, n, EVAL_RANGE[0], EVAL_RANGE[1] - EVAL_RANGE[0])


def coverage_pool(label: str, n: int = 20_000) -> list[int]:
    return _seeds(DEV_ROOT, "coverage/" + label, n, COVERAGE_RANGE[0], COVERAGE_RANGE[1] - COVERAGE_RANGE[0])


def identity_salt_hex(root: str) -> str:
    return digest(root, "salt", 0).hex()
from __future__ import annotations

import json
from dataclasses import dataclass, asdict
from pathlib import Path

import numpy as np
from scipy.optimize import linear_sum_assignment

from .cell import market_key
from .config import MarketConfig
from .firstbest import first_best_episode
from .rng import make_draws


@dataclass(frozen=True)
class Calibration:
    S_hat: float
    n_FB: float
    m: float
    market_key: str
    T: int
    seeds: tuple

    def as_dict(self) -> dict:
        d = asdict(self); d["seeds"] = list(self.seeds); return d


def first_best_served(cfg: MarketConfig, values_t: np.ndarray) -> int:
    q_full = np.array([p.q_max for p in cfg.providers]); cost_full = cfg.cost_full
    owner = np.repeat(np.arange(cfg.N), [p.k for p in cfg.providers])
    w = np.maximum(values_t[None, :] * q_full[owner][:, None] - cost_full[owner][:, None], 0.0)
    rows, cols = linear_sum_assignment(w, maximize=True)
    return int((w[rows, cols] > 0).sum())


def calibrate(cfg_base: MarketConfig, seeds) -> Calibration:
    """S_hat and n_FB on the calibration seeds (spec 3). Refuses an invalid market or no seeds."""
    cfg_base.validate()
    seeds = [int(s) for s in seeds]
    if not seeds:
        raise ValueError("calibration needs at least one seed")
    totals, served = [], []
    for s in seeds:
        d = make_draws(cfg_base, s)
        totals.append(first_best_episode(cfg_base, d))
        served.append(sum(first_best_served(cfg_base, d.values[t]) for t in range(cfg_base.T)))
    S_hat = float(np.mean(totals)); n_FB = float(np.mean(served))
    if n_FB <= 0:
        raise ValueError("no job has positive first-best surplus: calibration is undefined for this market")
    return Calibration(S_hat=S_hat, n_FB=n_FB, m=S_hat / n_FB, market_key=market_key(cfg_base), T=int(cfg_base.T), seeds=tuple(seeds))


def cell_config(cfg_base: MarketConfig, cal: Calibration, rho: float, beta: float) -> MarketConfig:
    """alpha = rho * m and B = beta * S_hat for one cell; the calibration must belong to this market."""
    if cal.market_key != market_key(cfg_base):
        raise ValueError("calibration belongs to a different market configuration")
    cfg = MarketConfig(N=cfg_base.N, J=cfg_base.J, T=cfg_base.T, sigma=cfg_base.sigma, e=cfg_base.e, v_min=cfg_base.v_min,
                       v_max=cfg_base.v_max, providers=cfg_base.providers, alpha=float(rho) * cal.m, budget=float(beta) * cal.S_hat)
    cfg.validate()
    return cfg


def save_calibration(cal: Calibration, path: str | Path) -> None:
    Path(path).write_text(json.dumps(cal.as_dict(), indent=2, sort_keys=True) + "\n")
