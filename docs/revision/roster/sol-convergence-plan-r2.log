   144	def run_cell(job: dict, out, max_rounds: int = MAX_ROUNDS, src=None, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   145	    from sim.cell import SeedCache
   146	    from sim.locked import load_locked
   147	    from sim.records import search_from_json
   148	    from sim.reference import reference_candidates, select_reference
   149	    from sim.search import Objective
   150	    T, L = R.constants(job); fam = R.family_for(job["family"], T, L); cell = R.train_cell(job); st = R.settings(job); cache = SeedCache()
   151	    rec = read(R.path_of(out, job["id"])); prev = search_from_json(rec["attack"]); twin = search_from_json(rec["twin"])
   152	    frozen_ref, rrec, _ = R.reference_of(job, out); prev_ref = float(np.mean(rrec["per_seed_normalized"]))
   153	    cands, _, _ = R.menu(job, out, CUTS, H4_EXCLUDED); order = tuple(load_locked()["reference_order"])
   154	    stopper = G.CostStop(*cost) if cost else None
   155	    rounds, gate, outcome = [], None, "round cap"
   156	    for k in range(1, max_rounds + 1):
   157	        new = R.continue_search(Objective(cell, fam, cache), fam, st, prev, seed=round_seed(k, st.restarts))
   158	        best = new if new.best_f > prev.best_f else replace(new, best_x=prev.best_x, best_knobs=prev.best_knobs, best_f=prev.best_f, best_source=prev.best_source)
   159	        extra = reference_candidates(cell, fam, best, twin, [], order)
   160	        ref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache); ref_f = float(np.mean(ref.per_seed_normalized))
   161	        rounds.append({"round": k, "restarts_total": st.restarts * (k + 1), "cma_seeds": sorted(cma_seeds(k, st.restarts)), "attack_f": float(best.best_f),
   162	                       "attack_change": float(best.best_f - prev.best_f), "reference_f": ref_f, "reference_change": ref_f - prev_ref,
   163	                       "best_knobs": dict(best.best_knobs), "best_source": best.best_source})
   164	        if k == 1 and src is not None:                          # the registered doubling's held-out winner is round 1's search winner
   165	            reg = read(Path(src) / "doubling" / (R._safe(job["id"]) + ".json"))
   166	            h1 = R.gain_fields(R.eval_cell(job), fam, new.best_knobs, frozen_ref, SeedCache())
   167	            r1 = {**rounds[0], "heldout": {"knobs": dict(new.best_knobs), "seeds": list(R.eval_cell(job).seeds), "gain": h1["gain"]}}
   168	            gate = compare_round1(reg, r1) if reg is not None else {"pass": False, "problems": ["no registered doubling record"]}
   169	        prev, prev_ref = best, ref_f
   170	        outcome = decide(k, rounds[-1], gate, stopper.allow(f"round {k + 1}", round_hours) if stopper else True, max_rounds)
   171	        if outcome != "continue":
   172	            break
   173	    status = {"passed": "passed", "round cap": "not passed at the cap", "cost cap": "stopped at the cost cap",
   174	              "round-1 mismatch": "stopped: round 1 differs from the registered doubling"}[outcome]
   175	    res = {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": rounds, "status": status,
   176	           "passed_round": passed_round(rounds), "round1_gate": gate if gate is not None else "not compared (smoke)", "claim": CLAIM,
   177	           "frozen_best_f": float(rec["attack"]["best_f"])}
   178	    if outcome != "round-1 mismatch":
   179	        held = R.gain_fields(R.eval_cell(job), fam, prev.best_knobs, frozen_ref, SeedCache())
   180	        res["heldout"] = {"knobs": dict(prev.best_knobs), "seeds": list(R.eval_cell(job).seeds), **held}
   181	    return res
