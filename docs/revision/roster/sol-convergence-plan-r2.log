"""Stage records of the v2 runner: atomic JSON writes, tolerant reads (a missing or truncated file is absent), and
validation of a record's stage, provenance, and upstream hashes against the current files."""
from __future__ import annotations

import hashlib
import json
import os
import secrets
from pathlib import Path


def write(path, rec: dict) -> None:
    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    tmp = p.with_name(f".{p.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")       # unique per writer
    with open(tmp, "w") as f:
        json.dump(rec, f, default=float); f.flush(); os.fsync(f.fileno())
    os.replace(tmp, p)


def read(path) -> dict | None:
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return None


def sha_file(path) -> str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def validate(job: dict, stage: str, rec: dict, upstream: dict) -> None:
    """`upstream` maps each upstream record id to its current path; raises ValueError on any mismatch."""
    if rec.get("stage") != stage:
        raise ValueError(f"record stage {rec.get('stage')!r} is not {stage!r}")
    if rec.get("provenance") != job.get("provenance"):
        raise ValueError("record provenance differs from the job's")
    for rid, sha in (rec.get("upstream") or {}).items():
        p = upstream.get(rid)
        if p is None or not Path(p).exists() or sha_file(p) != sha:
            raise ValueError(f"upstream {rid} changed or is missing")
from __future__ import annotations

import hashlib
import json
from pathlib import Path

import yaml

from .config import MarketConfig, ProviderParams

import os

DEFAULT_PATH = Path(__file__).resolve().parents[1] / "experiments" / "locked.yaml"


def load_locked(path: str | Path | None = None) -> dict:
    """The locked file; TOUCHSTONE_LOCKED (read at call time) exists for synthetic tests only, and scripts/check_claim.py
    refuses to run with it set."""
    path = Path(path) if path is not None else Path(os.environ.get("TOUCHSTONE_LOCKED") or DEFAULT_PATH)
    with open(path) as f:
        return yaml.safe_load(f)


def seeds(locked: dict, namespace: str) -> list[int]:
    v = locked["seeds"].get(namespace)
    if v is None and namespace == "final_eval":
        from .registry import SEALED_DIR
        if (SEALED_DIR / "final_eval_seeds.json").exists():
            from .sealed import final_eval_seeds, verify_bundle
            verify_bundle(SEALED_DIR, locked)                 # the seeds count only from a bundle that matches the lock commitment
            return final_eval_seeds(SEALED_DIR)
    if v is None:
        raise ValueError(f"seed namespace {namespace!r} is not available (final-eval seeds are released with the sealed bundle)")
    return [int(x) for x in v]


def sha256_file(path: str | Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def settings_hash(locked: dict) -> str:
    """Hash of every experimental setting: the whole file except the version label and the blocks written at the lock
    (tuned, calibration, the coverage report hash and consequences, the comprehension fixture hash, and the sealed
    bundle hash by the lock tooling; identity_salt_sha256 by the separate session; h1.cost_cap_usd from the token
    pilot), so installing them at the lock keeps the pre-lock artifacts valid."""
    skip = ("version", "tuned", "calibration", "identity_salt_sha256", "sealed_bundle_sha256", "coverage_report_sha256",
            "comprehension_fixture_sha256", "coverage_consequences")
    bound = {k: v for k, v in locked.items() if k not in skip}
    if isinstance(bound.get("h1"), dict):
        bound["h1"] = {k: v for k, v in bound["h1"].items() if k not in ("cost_cap_usd", "prices")}   # measured figures, never results
    return hashlib.sha256(json.dumps(bound, sort_keys=True).encode()).hexdigest()


def market_config_from_locked(locked: dict) -> MarketConfig:
    mk = locked["market"]; pt = mk["providers"]
    providers = tuple(ProviderParams(q_max=float(q), a=float(a), b=float(b), k=int(k))
                      for q, a, b, k in zip(pt["q_max"], pt["a"], pt["b"], pt["k"]))
    return MarketConfig(N=int(mk["N"]), J=int(mk["J"]), T=int(mk["T"]), sigma=float(mk["sigma"]), e=float(mk["e"]),
                        v_min=float(mk["v_min"]), v_max=float(mk["v_max"]), providers=providers, alpha=0.0, budget=0.0)
"""The follow-up budget category of the reset experiment (docs/revision/reset-experiment-plan.md, draft 4, section 7).

scripts/budget_v2.py is frozen (code freeze 627a2de) and has no way to add a category, so this module adds one under the
same lock and validation: the author's written approval sets the program limit and the new `followup` cap together.
Reservations and spend then go through budget_v2.reserve and budget_v2.record unchanged."""
from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT))

from scripts import budget_v2 as BV  # noqa: E402

OP = "followup"
Refused = BV.Refused


def approve(path, new_limit: float, cap: float, text: str) -> None:
    new_limit = BV._amount(new_limit, "approval limit", positive=True); cap = BV._amount(cap, f"cap {OP}", positive=True)
    if not str(text).strip():
        raise Refused("an approval needs the author's written text")
    if not Path(path).exists():
        raise Refused(f"no ledger at {path}")
    with BV._locked(path) as d:
        if OP in d["caps"]:
            raise Refused(f"the {OP} category already has a cap of {d['caps'][OP]} USD")
        if new_limit + 1e-9 < BV._used(d) + cap:
            raise Refused(f"the limit {new_limit} is below the spend and reservations ({BV._used(d):.3f}) plus the new cap {cap}")
        if d.get("approval"):
            d.setdefault("approval_history", []).append(d["approval"])
        d["caps"][OP] = cap
        d["approval"] = {"limit": new_limit, "text": str(text)}


def reserve(path, tag: str, estimate: float) -> float:
    with BV._locked(path) as d:
        if OP not in d["caps"]:
            raise Refused(f"no cap for {OP!r}: record the author's approval first (--approve LIMIT CAP TEXT)")
    return BV.reserve(path, OP, tag, estimate)


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--ledger", default=str(BV.DEFAULT))
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--approve", nargs=3, metavar=("LIMIT", "CAP", "TEXT")); g.add_argument("--reserve", nargs=2, metavar=("TAG", "ESTIMATE"))
    a = ap.parse_args(argv)
    try:
        if a.approve:
            approve(a.ledger, float(a.approve[0]), float(a.approve[1]), a.approve[2])
        else:
            print(f"{reserve(a.ledger, a.reserve[0], float(a.reserve[1])):.2f}")
    except Refused as e:
        print(f"refused: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
