    65	def check_pairing(src, jobs: list[dict]) -> None:
    66	    """Each job's provenance equals its frozen reference's provenance on every key the pairing depends on (the commit may
    67	    differ): runner, salt, configuration, root, seeds, rule parameters, context (Fable 5.2 driver review, finding 1)."""
    68	    for j in jobs:
    69	        ref = read(R.path_of(src, f"reference/{j['context']}/{j['rule']}"))
    70	        if ref is None:
    71	            _refuse(f"{j['id']}: no reference record to pair with")
    72	        if bad := [k for k in PAIRED_KEYS if j["provenance"].get(k) != ref["provenance"].get(k)]:
    73	            _refuse(f"{j['id']}: provenance differs from its reference in {bad}")
