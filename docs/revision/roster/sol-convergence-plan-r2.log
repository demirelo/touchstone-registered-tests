    95	
    96	def compare_round1(registered: dict, r1: dict) -> dict:
    97	    """Round 1 against the registered doubling record: exact on the seeds and discrete held-out knobs; 1e-9 on the
    98	    continuous knobs, both changes and the held-out gains; every value finite."""
    99	    problems = []
   100	    ha, hb = registered["heldout"], r1["heldout"]
   101	    if not G.finite(ha["gain"], hb["gain"], hb["knobs"], [r1["attack_change"], r1["reference_change"]]):
   102	        problems.append("nonfinite value")
   103	    if ha["seeds"] != hb["seeds"]:
   104	        problems.append("seeds differ")
   105	    ka, kb = ha["knobs"], hb["knobs"]; disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   106	    if set(ka) != set(kb) or any(ka[k] != kb[k] for k in disc):
   107	        problems.append("discrete knob differs")
   108	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   109	    chg = max(abs(registered[k] - r1[k]) for k in ("attack_change", "reference_change"))
   110	    gd = max((abs(x - y) for x, y in zip(ha["gain"], hb["gain"])), default=0.0) if len(ha["gain"]) == len(hb["gain"]) else float("inf")
   111	    if not (rel <= KNOB_TOL and chg <= VAL_TOL and gd <= VAL_TOL):
   112	        problems.append(f"tolerance exceeded (knobs {rel:.3g}, changes {chg:.3g}, gains {gd:.3g})")
   113	    return {"pass": not problems, "max_knob_rel": rel, "max_change_abs": chg, "max_gain_abs": gd, "problems": problems}
