    58	def finite(*xs) -> bool:
    59	    def vals(x):
    60	        if isinstance(x, dict):
    61	            for v in x.values():
    62	                yield from vals(v)
    63	        elif isinstance(x, (list, tuple)):
    64	            for v in x:
    65	                yield from vals(v)
    66	        elif isinstance(x, (int, float)) and not isinstance(x, bool):
    67	            yield x
    68	    return all(math.isfinite(v) for x in xs for v in vals(x))
