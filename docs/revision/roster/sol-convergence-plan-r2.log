    87	CLAIM = ("a cell that passes 'passed the registered incremental check within three rounds' (a capped search extension "
    88	         "of R restarts per round); this is not convergence, not optimality, and not a bound on the remaining search error")
    89	DEVIATIONS = ("continued searches of the 14 flagged profit cells beyond the registered doubling, up to three rounds of R restarts",
    90	              "the final winner is evaluated against the unchanged frozen reference; reselected references are diagnostics only",
    91	              "unflagged cells, frozen banks and X7-SC's original D2+H3 incumbents are unchanged; the 7 flagged coalition cells and "
    92	              "the unchecked fresh factorial cells are not in this run", "exploratory sensitivity after the report; the frozen estimates stay primary")
    93	KNOB_TOL, VAL_TOL = 1e-9, 1e-9
