   116	def decide(k: int, last: dict, gate: dict | None, cost_ok: bool, max_rounds: int = MAX_ROUNDS) -> str:
   117	    """After round k: stop on a round-1 mismatch, on a pass, at the round cap, or (before the next round) at the cost cap."""
   118	    if k == 1 and gate is not None and not gate["pass"]:
   119	        return "round-1 mismatch"
   120	    if _passes(last):
   121	        return "passed"
   122	    if k >= max_rounds:
   123	        return "round cap"
   124	    return "continue" if cost_ok else "cost cap"
