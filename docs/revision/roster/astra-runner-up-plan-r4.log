   167	def _required(out, jobs: list[dict], ctx: str, src) -> dict:
   168	    """Every record the context's freeze must hold: exactly its bank inputs, each copy's actual hash equal to the original
   169	    freeze's, both searches, and its reference, each new record validated with current hashes."""
   170	    recs = dict(check_bank_copies(out, src, [ctx]))
   171	    for j in (j for j in jobs if j["context"] == ctx):
   172	        recs[j["id"]] = _validate_new(out, j["id"], "search", j["provenance"], jobs)
   173	    rid = f"reference/{ctx}/{LABEL}"; recs[rid] = _validate_new(out, rid, "reference", _ref_provenance(jobs, ctx), jobs)
