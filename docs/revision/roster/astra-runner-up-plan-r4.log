    91	class CostStop:
    92	    """Checked between stages: a stage starts only if the billed time so far plus its estimate stays within the cap.
    93	    A running stage is never interrupted (the author: do not kill jobs); the run stops and reports instead."""
    94	
    95	    def __init__(self, cap_usd: float, usd_per_hour: float, started: float, clock=time.time, prior_usd: float = 0.0):
    96	        self.cap, self.rate, self.started, self.clock, self.stopped, self.log = float(cap_usd), float(usd_per_hour), float(started), clock, None, []
    97	        self.prior = float(prior_usd)                                    # failed attempts of the same run count toward the cap
    98	
    99	    def allow(self, stage: str, est_hours: float) -> bool:
   100	        spent = self.prior + (self.clock() - self.started) / 3600 * self.rate; ok = spent + est_hours * self.rate <= self.cap + 1e-9
   101	        self.log.append({"stage": stage, "spent_usd": round(spent, 4), "next_usd": round(est_hours * self.rate, 4), "allowed": ok})
   102	        if not ok and self.stopped is None:
   103	            self.stopped = stage
   104	        return ok
   105	
   106	    def report(self) -> dict:
   107	        return {"cap_usd": self.cap, "usd_per_hour": self.rate, "prior_usd": self.prior, "stopped_before": self.stopped, "log": self.log,
   108	                "note": "an admission limit checked before each stage or round; a running stage finishes, so billing can exceed the cap by that stage"}
   109	
   110	
   111	def prior_from_attempts(path) -> float:
   112	    """Spend of the launcher's closed attempts (`<name>.attempts`: pod id, start, end, USD per hour per line)."""
   113	    p = Path(path) if path else None
   114	    if p is None or not p.exists():
   115	        _refuse(f"no launcher attempts file at {path}")
   116	    tot = 0.0
   117	    for line in p.read_text().splitlines():
   118	        if not line.strip():
   119	            continue
   120	        try:
   121	            _, t0, t1, cph = line.split(); tot += (float(t1) - float(t0)) / 3600 * float(cph)
   122	        except ValueError:
   123	            _refuse(f"unreadable line in the attempts file {p}: {line!r}")
   124	    return tot
   125	
   126	
   127	def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, attempts, clock=time.time) -> CostStop:
   128	    """A paid run must state the pod allocation time, a positive rate, and the launcher's attempts file, whose closed
   129	    attempts are counted toward the cap (no default of zero)."""
   130	    if started is None:
   131	        _refuse("a paid run needs --started-at (the pod allocation time)")
   132	    if not usd_per_hour > 0 or not cap_usd > 0:
   133	        _refuse("a paid run needs a positive rate and cap")
   134	    return CostStop(cap_usd, usd_per_hour, started, clock, prior_from_attempts(attempts))
