   164	    if g is None or g.get("stage") != stage or g.get("cell") != cell or g.get("pass") is not True:
   165	        problems.append("gate record missing, unrelated, or failed")
   166	    if any(recs.get(r) != (sha_file(d / r) if (d / r).exists() else None) for r in ("gate.json", "inputs.json")):
