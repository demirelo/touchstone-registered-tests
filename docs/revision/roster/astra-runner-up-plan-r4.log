#!/bin/bash
# Snapshot guard: run a private copy, so an edit to this file cannot reach a running launch.
if [ -z "${LAUNCH_SNAPSHOT:-}" ]; then
  snapf="/Users/oemer.demirel/Projects/touchstone/results/pods/snap_$(basename "$0" .sh)_$$.sh"; cp "$0" "$snapf"
  LAUNCH_SNAPSHOT="$snapf" exec bash "$snapf" "$@"
fi
# Reset follow-up (docs/revision/reset-experiment-plan.md, draft 5) on one Runpod CPU pod, adapted from eval_pod.sh.
# Order on the pod: the reproduction gate (bit identity, --require-identical; the author's decision), then the 18 D2 cells
# stage by stage (inputs and search with all vCPUs; evaluate, doubling and the spot diagnostics with WEVAL workers for
# memory), then the inventory. Spending (the author: do not kill jobs): at the reserved cap the pod stops BETWEEN stages
# (a STOP file the remote script reads before each stage); only at HARD x the cap is the pod deleted mid-stage, as an
# absolute guard. An EXIT/INT/TERM trap pulls what exists, deletes the pod and verifies the deletion.
# Usage: reset_pod.sh <code_tgz> <bundle_tgz> <tag> <cap_usd> <local_out>
# Env: EXPECT (commit inside the code tarball), MAXCPH, optional WEVAL (default 10), MINMEM (default 28), HARD (default 1.3).
set -u
PY=/opt/homebrew/bin/python3; P=/Users/oemer.demirel/Projects/touchstone/results/pods
TGZ=${1:?code tarball}; BTGZ=${2:?bundle tarball}; TAG=${3:?tag}; CAP=${4:?cap_usd}; LOUT=${5:?local_out}; cd $P
EXPECT=${EXPECT:?commit}; MAXCPH=${MAXCPH:?max usd per hour}; WEVAL=${WEVAL:-10}; MINMEM=${MINMEM:-28}; HARD=${HARD:-1.3}
mkdir -p "$LOUT" logs_r_$TAG
$PY -c "import sys,tarfile; ms=tarfile.open(sys.argv[1]).getmembers(); d=[m.name for m in ms if m.name.split('/')[-1].startswith('._')]; o=[m.name for m in ms if m.uid!=0]; print('tarball guard: %d AppleDouble, %d non-root' % (len(d),len(o))); sys.exit(1 if d or o else 0)" "$TGZ" || { echo "code tarball refused"; exit 1; }
hg=$(mktemp -d); tar xzf "$TGZ" -C "$hg" 2>/dev/null || { echo "code tarball refused: cannot unpack"; exit 1; }
# Code guard (fails closed: every git call's status is checked): HEAD is EXPECT, protocol-v2 is an ancestor, the tree is
# clean, every path changed since the tag is in the code freeze's allowed paths, and scripts/, sim/, tests/ equal the tag.
guard() {
  cd "$1" || return 1
  [ "$(git rev-parse HEAD 2>/dev/null)" = "$EXPECT" ] || { echo "HEAD is not $EXPECT"; return 1; }
  git merge-base --is-ancestor protocol-v2 HEAD || { echo "protocol-v2 is not an ancestor"; return 1; }
  st=$(git status --porcelain) || { echo "git status failed"; return 1; }; [ -z "$st" ] || { echo "tree not clean: $st" | head -c 300; return 1; }
  ch=$(git diff --name-only protocol-v2 HEAD) || { echo "git diff failed"; return 1; }
  bad=$(echo "$ch" | grep -v -e '^docs/' -e '^experiments/v2/' -e '^paper/' -e '^sealed2/h4/' -e '^$' || true); [ -z "$bad" ] || { echo "changed outside the allowed paths: $bad" | head -c 300; return 1; }
  git diff --quiet protocol-v2 -- scripts/ sim/ tests/ || { echo "scripts/, sim/ or tests/ differ from protocol-v2"; return 1; }
  echo "code guard: ok at $(git rev-parse --short HEAD)"
}
( guard "$hg" ); g=$?; mv -- "$hg" ~/.Trash/hg_reset_$$
[ $g -eq 0 ] || { echo "code tarball refused"; exit 1; }
[ -n "${DRYRUN:-}" ] && { echo "dry run: guards passed; no pod created"; exit 0; }
# verify DIR: every record in DIR/inventory.json exists with its hash.
verify() { $PY - "$1" <<'PYV'
import hashlib, json, sys
from pathlib import Path
d = Path(sys.argv[1]); inv = json.loads((d / "inventory.json").read_text())
bad = [k for k, h in inv["records"].items() if not (d / k).is_file() or hashlib.sha256((d / k).read_bytes()).hexdigest() != h]
print(f"verify {d.name}: {len(inv['records'])} records, {len(bad)} bad"); sys.exit(1 if bad else 0)
PYV
}
tmo() { perl -e 'alarm shift; exec @ARGV' "$@"; }
NAME=ts-r-$TAG; DONE=$P/$NAME.done; ATT=$P/$NAME.attempts
rm_ok() { [ -e "$1" ] && mv -- "$1" ~/.Trash/"$(basename "$1").$$"; true; }
rm_ok "$DONE"; rm_ok "$P/$NAME.blocked"; : > "$ATT"
id=""; state="NOT STARTED"; rc=1; cph=0; a0=0; tfirst=0
# Pod safety lives in podctl.py (test_podctl.py, with mutation checks): fail-closed listing, deletion verified within
# elapsed time, reconciliation, a creation block from the hard deadline, and a watchdog that runs on after this launcher
# exits, until no pod named $NAME remains.
cleanup() {
  trap - EXIT INT TERM
  if [ -n "$id" ]; then
    try=0
    while :; do   # after RUN OK: keep the pod and retry until both directories verify, or until 2 min before the hard deadline
      try=$((try+1)); ok=1
      for spec in "followup-reset/ $LOUT/followup-reset/ 900" "followup-gate/ $LOUT/followup-gate/ 300"; do
        set -- $spec; rem=$(( hard - 120 - $(date +%s) )); [ $rem -le 0 ] && { ok=0; break; }; t=$3; [ $rem -lt $t ] && t=$rem
        tmo $t $PY runpod.py pull $id /root/touchstone/results/v2/$1 "$2" >/dev/null 2>&1 || ok=0
      done
      rem=$(( hard - 120 - $(date +%s) )); [ $rem -gt 0 ] && tmo $(( rem < 300 ? rem : 300 )) $PY runpod.py pull $id /root/touchstone/results/logs/ logs_r_$TAG/ >/dev/null 2>&1
      if [ "$state" = "RUN OK" ] && [ $ok = 1 ]; then { verify "$LOUT/followup-gate" && verify "$LOUT/followup-reset"; } || ok=0; fi
      [ $ok = 1 ] && break
      echo "$(date +%H:%M) pull or verification failed (try $try)"
      if [ "$state" = "RUN OK" ]; then [ "$(date +%s)" -ge $(( hard - 120 )) ] && break; else [ $try -ge 3 ] && break; fi
      sleep 60
    done
    [ $ok = 1 ] || { [ "$state" = "RUN OK" ] && state="RUN OK BUT RECORDS NOT VERIFIED"; rc=1; }
    if $PY podctl.py delete $id 1800; then echo "$(date +%H:%M) $id deleted (verified)"; echo "$id $(date +%s) deleted" >> "$ATT"; else echo "$(date +%H:%M) $id: deletion not verified in 30 min; the watchdog keeps trying (billing may continue)"; rc=1; fi
  fi
  $PY podctl.py reconcile $NAME || { echo "$(date +%H:%M) reconcile failed; the watchdog keeps trying"; rc=1; }
  touch "$DONE"     # the watchdog then deletes any orphan pod and exits only after SETTLE s of empty listings
  # Spend: one pod at a time is guaranteed by reconciliation before every request, so the time from the first creation
  # request to the last verified deletion (or to now, if one is unverified) at MAXCPH bounds the spend of all attempts.
  if [ "$tfirst" -gt 0 ]; then echo "$(date +%H:%M) spend bound: $(( $(date +%s) - tfirst ))s at $MAXCPH USD/h = $($PY -c "print(round(($(date +%s)-$tfirst)/3600*float('$MAXCPH'),3))") USD (pod events in $ATT; record the bound with budget_v2.py --record)"; fi
  echo "$(date +%H:%M) end: $state"
  exit $rc
}
trap cleanup EXIT INT TERM
# Deadlines from the first creation request at the price ceiling MAXCPH (a bound across attempts).
t0=$(date +%s); soft=$(( t0 + $($PY -c "print(int(3600*float('$CAP')/float('$MAXCPH')))") )); hard=$(( t0 + $($PY -c "print(int(3600*float('$CAP')*float('$HARD')/float('$MAXCPH')))") ))
nohup $PY podctl.py watchdog $NAME $hard "$DONE" >> logs_r_$TAG/watchdog.log 2>&1 &
disown
# One creation request at a time (create_one.py, no hidden retries). Before EVERY request: reconciliation must succeed (no
# untracked pod), the watchdog must allow creation, and the soft deadline must be ahead. An ambiguous answer is followed by
# a 30 s wait and reconciliation before the next request; an unambiguous refusal (no capacity) tries the next flavor.
req=0; tries=0
while [ $tries -lt 3 ] && [ $req -lt 36 ]; do
  $PY podctl.py reconcile $NAME 600 || { state="RECONCILE FAILED BEFORE REQUEST $((req+1))"; exit 1; }
  $PY podctl.py may-create $NAME $hard || { state="CREATION BLOCKED (hard deadline)"; exit 1; }
  [ "$(date +%s)" -lt "$soft" ] || { state="SOFT DEADLINE BEFORE START"; exit 1; }
  [ "$tfirst" -gt 0 ] || tfirst=$(date +%s)
  out=$(tmo 120 $PY create_one.py $NAME $(( req % 12 )) 2>/dev/null | tail -n 1); req=$((req+1))
  id=$(echo "$out" | $PY -c 'import sys,json; print(json.loads(sys.stdin.read()).get("id",""))' 2>/dev/null)
  amb=$(echo "$out" | $PY -c 'import sys,json; d=json.loads(sys.stdin.read() or "{}"); print(1 if d.get("ambiguous", True) else 0)' 2>/dev/null || echo 1)
  if [ -z "$id" ]; then
    if [ "$amb" = 1 ]; then echo "$(date +%H:%M) ambiguous creation answer; reconciling"; sleep 30; $PY podctl.py reconcile $NAME 600 || { state="RECONCILE FAILED AFTER AN AMBIGUOUS ANSWER"; exit 1; }; tries=$((tries+1)); fi
    continue
  fi
  v=16; echo "$id $(date +%s) start" >> "$ATT"
  cph=$(tmo 60 $PY runpod.py list 2>/dev/null | $PY -c "import sys,json; print(next((p.get('costPerHr') or 0) for p in json.load(sys.stdin) if p['id']=='$id'))" 2>/dev/null)
  $PY -c "import sys; sys.exit(0 if 0<float('${cph:-0}' or 0)<=float('$MAXCPH') else 1)" || { state="PRICE ${cph:-unknown} NOT IN (0, $MAXCPH]"; exit 1; }
  a0=$(date +%s); up=""; while [ "$(date +%s)" -lt "$soft" ] && [ $(( $(date +%s) - a0 )) -lt 240 ]; do r=$(tmo 30 $PY runpod.py ssh $id 'echo up' 2>/dev/null | head -c 2); [ "$r" = up ] && { up=1; break; }; sleep 10; done
  [ -n "$up" ] && break
  echo "$(date +%H:%M) $id unreachable; deleting"; $PY podctl.py delete $id 600 || { state="UNREACHABLE POD NOT DELETED"; exit 1; }; echo "$id $(date +%s) deleted" >> "$ATT"; id=""; tries=$((tries+1))
done
[ -z "$id" ] && { state="NO POD"; exit 1; }
echo "$(date +%H:%M) pod $id ($v vCPU, $cph USD/h): soft stop in $(( soft - $(date +%s) ))s, hard stop in $(( hard - $(date +%s) ))s (cap $CAP USD)"
tmo 900 $PY runpod.py push $id $TGZ /root/rc.tgz >/dev/null 2>&1
