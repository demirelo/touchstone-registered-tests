   159	def _verified_dir(d, stage: str, cell: str, inputs: dict, budget, site: str) -> dict:
   160	    d = Path(d); g, inv, inp = read(d / "gate.json"), read(d / "inventory.json"), read(d / "inputs.json")
   161	    srch = read(F.R.path_of(d, cell)); drv = sha_file(HERE.parent / "followup" / "reset_followup_v2.py")
