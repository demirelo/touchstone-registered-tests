    s0 = A.R.cell_id(CTX, "C*/S0", "D2+H3", "profit"); q0 = A.R.path_of(out, s0); q0.parent.mkdir(parents=True)
    q0.write_bytes(A.R.path_of(src, s0).read_bytes()); A.check_no_registered_cstar(src, out)           # a C*/S0 bank copy is allowed
