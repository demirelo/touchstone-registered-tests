def test_a_copy_of_a_registered_cstar_record_in_the_output_is_refused(tmp_path, monkeypatch):
    src = _src(tmp_path); out = tmp_path / "out"; rid = A.R.cell_id(CTX, "C*", "D2+H3", "profit")
