   256	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3, doubling=None, search=None) -> str | None:
   257	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   258	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   259	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   260	    job's ordered evaluation seeds; a measured round 1 must agree with this cell's doubling record (`doubling`;
   261	    _round1_problem). The job must carry its evaluation seeds: no check is skipped."""
