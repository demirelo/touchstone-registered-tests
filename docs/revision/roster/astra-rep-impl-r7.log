   111	def round_hours(job: dict) -> float:
   112	    """One continuation round's admission estimate (Run B's rule): a doubling-size search and its 200-seed evaluation from
   113	    the benchmark, times the churn slowdown (1.33 at p > 0, the churn arm's rate stages), plus 0.1 h shutdown."""
   114	    import json as _j
   115	    from convergence_v2 import ROOT as _ROOT
   116	    t = _j.loads((_ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]
   117	    base = (t["doubling_x7"] if job.get("family") == "X7-SC" else t["doubling"]) + t["eval160"]["profit"] * 200 / 160
   118	    return base * (1.33 if float(job.get("churn") or 0) > 0 else 1.0) / 3600 + 0.1
