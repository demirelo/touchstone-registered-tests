   324	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   325	              smoke: bool = False) -> dict:
   326	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   327	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   328	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   329	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   330	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   331	    cost-stopped ones."""
   332	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   333	    import revision_v2 as R
   334	    if gate is None:
   335	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   336	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   337	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   338	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   339	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   340	    saved = {d: _d(read_record(d)) for _, d in items}                   # a non-object root counts as no record
   341	    dbl = {d: doubling_of(c["dir"], c["job"]["id"]) for c, d in items}; srch = {d: search_of(c["dir"], c["job"]["id"]) for c, d in items}
   342	    other = [c["id"] for c, d in items if saved[d] is not None and isinstance(saved[d].get("provenance"), dict)   # a binding
   343	             and not _same(saved[d]["provenance"], c["job"].get("provenance"))]   # that names another job or run; a missing
   344	                                                                                  # or malformed one is an invalid record
   345	    if other:                                                            # plan section 5: reuse only this run's records
   346	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   347	    if any(_mismatch(saved[d], dbl[d], srch[d]) for _, d in items):     # a measured disagreement included (review rep-impl-r5)
   348	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   349	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   350	    # review rep-impl-r3: a saved record is reused only if it passes the same checks collect applies; any other record
   351	    # (incomplete, malformed, nonfinite) means "no passing record" and its cell is rerun (plan section 4: a resume
   352	    # continues from the first cell without a passing record); the old record is set aside, never deleted
   353	    # (an unknown status included: review rep-impl-r4; a measured round-1 mismatch stopped above and is never rerun)
   354	    invalid = lambda c, d, mr: saved[d] is not None and not cost_stopped(saved[d]) and \
   355	        cont_problem(saved[d], c["id"], c["job"], smoke, mr, dbl[d], srch[d]) is not None
   356	    rerun = lambda c, d, mr: saved[d] is None or cost_stopped(saved[d]) or invalid(c, d, mr)
   357	    run = 0
   358	    if rerun(gate, gdest, 1):
