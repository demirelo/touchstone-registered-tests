   217	def _round1_problem(rec: dict, doubling, search=None) -> str | None:
   218	    """Round 1 against this cell's own doubling record and frozen search (reviews rep-impl-r4, r5): with zero
   219	    differences, the comparison's round-1 winner equals the doubling's held-out knobs, its held-out mean equals the mean
   220	    of the doubling's held-out gains (the same np.mean of the same values), and round 1's two changes equal the
   221	    doubling's; round 1's best knobs are the doubling's winner or the frozen search winner (the better of the two); and a
   222	    final winner equal to the doubling's winner has the doubling's held-out gains exactly. All five hold on every Run B
   223	    record with an identical round 1 (76 records; 48 with that final winner)."""
   224	    import numpy as np
   225	    if not _round1_ready(rec, doubling, search):
