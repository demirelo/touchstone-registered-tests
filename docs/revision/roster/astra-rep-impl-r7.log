   177	def _rounds_problem(rec: dict, max_rounds: int) -> str | None:
   178	    """Run B's rounds (convergence_v2.run_cell; review rep-impl-r3): numbered 1..k with k <= max_rounds, finite search and
   179	    reference values with finite knobs; "passed" exactly when the last round is the first that passes the doubling
   180	    threshold, "not passed at the cap" when k equals the cap and no round passes; the held-out winner is the last round's."""
   181	    from convergence_v2 import _passes
   182	    rounds = rec.get("rounds")
   183	    if not isinstance(rounds, list) or not 1 <= len(rounds) <= max_rounds:
   184	        return "rounds missing or beyond the cap"
   185	    for i, r in enumerate(rounds):
   186	        if not isinstance(r, dict) or type(r.get("round")) is not int or r["round"] != i + 1 or not _finite([r.get(k) for k in ("attack_f", "attack_change", "reference_f", "reference_change")]) \
   187	                or not _knobs_ok(r.get("best_knobs")):
   188	            return f"round {i + 1} malformed or nonfinite"
   189	    ok = [_passes(r) for r in rounds]
   190	    if rec["status"] == "passed" and not (ok[-1] and not any(ok[:-1])):
   191	        return "status passed without a final passing round"
   192	    if rec["status"] == STATUSES[1] and (len(rounds) != max_rounds or any(ok)):
   193	        return "status at the cap without the capped, unpassed rounds"
   194	    if not _same((rec.get("heldout") or {}).get("knobs"), rounds[-1]["best_knobs"]):
   195	        return "held-out winner differs from the last round's winner"
   196	    return None
