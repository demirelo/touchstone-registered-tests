   227	    g, r1, h = rec["round1_gate"], rec["rounds"][0], doubling["heldout"]
   228	    if not _same(g.get("heldout_knobs"), h["knobs"]):
   229	        return "round-1 winner differs from the doubling record's held-out winner"
   230	    if not _same(g.get("heldout_mean"), float(np.mean(h["gain"]))):
   231	        return "round-1 held-out mean differs from the doubling record's"
   232	    if not (_same(r1.get("attack_change"), doubling.get("attack_change")) and _same(r1.get("reference_change"), doubling.get("reference_change"))):
