   199	def _round1_ready(rec, doubling, search) -> bool:
   200	    """Round 1 was measured and both records it is compared with are well-formed: then any disagreement below is a
   201	    round-1 mismatch, not a malformed record."""
   202	    rec, doubling, search = _d(rec), _d(doubling), _d(search)
   203	    if rec is None or doubling is None or search is None or not isinstance(rec.get("round1_gate"), dict):
   204	        return False
   205	    rounds, h, g = rec.get("rounds"), doubling.get("heldout"), rec["round1_gate"]
   206	    if not (isinstance(rounds, list) and rounds and isinstance(rounds[0], dict) and isinstance(h, dict) and
   207	            _finite(h.get("gain")) and _knobs_ok(h.get("knobs")) and isinstance(search.get("attack"), dict) and
   208	            _knobs_ok(search["attack"].get("best_knobs"))):
   209	        return False
   210	    r1, fh = rounds[0], rec.get("heldout")                  # the measured values themselves must be well-formed
   211	    if not (_finite([r1.get("attack_change"), r1.get("reference_change"), g.get("heldout_mean")]) and
   212	            _knobs_ok(r1.get("best_knobs")) and _knobs_ok(g.get("heldout_knobs"))):
   213	        return False
   214	    return not (isinstance(fh, dict) and _same(fh.get("knobs"), h["knobs"])) or _finite(fh.get("gain"))
