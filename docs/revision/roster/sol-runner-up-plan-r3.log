   226	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   227	    """Gate mode: round 1 only, compared with the registered doubling record; saved full-budget evidence bound to the
   228	    cell's inputs, this driver, the site, and the environment."""
   229	    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours)
   230	    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
   231	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "site": site, "comparison": r["round1_gate"],
   232	            "binding": bind, "environment": G.environment()}
   233	
   234	
   235	def _cell_gains(src, conv, rid: str, expected: dict):
   236	    f = read(R.eval_path(src, rid))
   237	    if rid not in expected:
   238	        return f["gain"], f["gain"], False
   239	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   240	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   241	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   242	    g = c["heldout"]["gain"]
   243	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   244	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   245	    return f["gain"], g, True
   246	
   247	
   248	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   249	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   250	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   251	    expected = expected or {}
   252	    for rid in expected:
   253	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   254	            raise ValueError(f"{rid}: the run's result is missing")
   255	    sub, out = [], {}
   256	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   257	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   258	        for m in markets:
   259	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   260	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   261	                continue
   262	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra, expected), _cell_gains(src, conv, rb, expected)
   263	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   264	            sub += [r for r, s_ in ((ra, sa), (rb, sb)) if s_ and r not in sub]
   265	        if fz_a:
   266	            out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   267	    return {"label": "exploratory sensitivity; the frozen estimates stay primary; " + C.SCOPE, **out, "substituted": sub}
   268	
