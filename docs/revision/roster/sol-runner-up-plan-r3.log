    65	def bank_inputs(src, contexts) -> dict[str, str]:
    66	    """The other rules' registered winners that the frozen menu reads for a C*-labelled rule, with their original freeze hashes."""
    67	    need = {}
    68	    for ctx in sorted(set(contexts)):
    69	        fr = read(R.path_of(src, f"freeze/{ctx}"))
    70	        if fr is None or fr.get("cuts") != CUTS or fr.get("h4_excluded") != H4_EXCLUDED:
    71	            _refuse(f"the original freeze of {ctx} is missing or not cuts {CUTS} with H4 loaded")
    72	        for fam in MAN.menu_families(R.manifest_ctx(ctx), LABEL):
    73	            for other in MAN.bank_rules(R.manifest_ctx(ctx), fam, CUTS, H4_EXCLUDED):
    74	                if other == LABEL:
    75	                    continue
    76	                rid = R.cell_id(ctx, other, fam, "profit")
    77	                if rid not in fr["records"]:
    78	                    _refuse(f"{rid} is not in the original freeze of {ctx}")
    79	                need[rid] = fr["records"][rid]
    80	    return need
