   167	def prefreeze(out, jobs, src) -> None:
   168	    for ctx in sorted({j["context"] for j in jobs}):
   169	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED,
   170	                "records": _required(out, jobs, ctx, src)}
   171	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   172	        if old is not None and old != body:
   173	            _refuse(f"{p} exists with other records")
   174	        if old is None:
   175	            write(p, body)
