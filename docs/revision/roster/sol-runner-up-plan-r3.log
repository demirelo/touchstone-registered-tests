   272	def analysis(out, src, report: dict, markets=MARKETS, fams=FAMS, resamples: int = C.RESAMPLES) -> dict:
   273	    """Per family: runner-up minus R3, C* minus runner-up and C* minus R3, base and doubled, each rule against its own
   274	    unchanged frozen reference, paired on the evaluation seeds, from unrounded values; exploratory."""
   275	    res = {}
   276	    for fam in fams:
   277	        base = _contrasts(_base(out, LABEL, fam, markets), _base(src, "F111", fam, markets), _base(src, "C*", fam, markets), markets, resamples)
   278	        dbl = _contrasts(_doubled_out(out, fam, markets), _doubled_report(report, "F111", fam, markets), _doubled_report(report, "C*", fam, markets), markets, resamples)
   279	        flags = {}
   280	        for m in markets:
   281	            rec = read(Path(out) / "doubling" / (R._safe(R.cell_id(MAN.context(m), LABEL, fam, "profit")) + ".json")) or {}
   282	            flags[m] = {k: rec.get(k) for k in ("attack_change", "reference_change", "incomplete")}
   283	        row = {"label": "exploratory, after the report; " + C.SCOPE, "base": base, "doubled": dbl, "flags": flags}
   284	        if fam == "D2+H3":
   285	            row["expectation"] = _score(base, dbl)
   286	        res[fam] = row
   287	    return res
