    90	class CostStop:
    91	    """Checked between stages: a stage starts only if the billed time so far plus its estimate stays within the cap.
    92	    A running stage is never interrupted (the author: do not kill jobs); the run stops and reports instead."""
    93	
    94	    def __init__(self, cap_usd: float, usd_per_hour: float, started: float, clock=time.time, prior_usd: float = 0.0):
    95	        self.cap, self.rate, self.started, self.clock, self.stopped, self.log = float(cap_usd), float(usd_per_hour), float(started), clock, None, []
    96	        self.prior = float(prior_usd)                                    # failed attempts of the same run count toward the cap
    97	
    98	    def allow(self, stage: str, est_hours: float) -> bool:
    99	        spent = self.prior + (self.clock() - self.started) / 3600 * self.rate; ok = spent + est_hours * self.rate <= self.cap + 1e-9
   100	        self.log.append({"stage": stage, "spent_usd": round(spent, 4), "next_usd": round(est_hours * self.rate, 4), "allowed": ok})
   101	        if not ok and self.stopped is None:
   102	            self.stopped = stage
   103	        return ok
   104	
   105	    def report(self) -> dict:
   106	        return {"cap_usd": self.cap, "usd_per_hour": self.rate, "prior_usd": self.prior, "stopped_before": self.stopped, "log": self.log,
   107	                "note": "an admission limit checked before each stage or round; a running stage finishes, so billing can exceed the cap by that stage"}
