   325	    preflight(out, a.src, jobs, salt, container, a.smoke)
   326	    b = G.binding(inputs_sha=G.sha_json(bank_inputs(a.src, [j["context"] for j in jobs])), provenance={j["id"]: j["provenance"] for j in jobs},
   327	                  smoke=a.smoke, settings={"markets": list(markets), "spec": EXPECTED_SPEC, "cuts": CUTS}, driver_sha=sha_file(Path(__file__)))
   328	    if not G.reusable(out / "run.json", b):
   329	        write(out / "run.json", {"binding": b, "label": "runner-up follow-up run"})
   330	    write(out / "label.json", {"rule_label": LABEL, "rule": "C-thr", "cred": runner_up_cred(), "source": str(LOG.relative_to(ROOT)), "deviations": list(DEVIATIONS)})
   331	    paid = a.site == "pod" and not a.smoke
