    66	def _eval_set(out, src, ru, cs, r3, ru_d=None, cs_d=None, r3_d=None, markets=("fresh0", "fresh1")):
    67	    rep = {"doubling": {}}
    68	    for m in markets:
    69	        for base, rule, g, gd in ((out, "C*", ru, ru_d), (src, "F111", r3, r3_d), (src, "C*", cs, cs_d)):
    70	            rid = f"{m}@rho0.2|{rule}|D2+H3|profit"; write(A.R.eval_path(base, rid), {"seeds": [1, 2], "gain": g})
    71	            held = {"seeds": [1, 2], "gain": gd if gd is not None else g, "knobs": {}}
    72	            if base == out:
    73	                write(out / "doubling" / (A.R._safe(rid) + ".json"), {"heldout": held, "attack_change": 0.001, "reference_change": 0.0, "incomplete": False})
    74	            else:
    75	                rep["doubling"][rid] = {"heldout": held}
    76	    return rep
