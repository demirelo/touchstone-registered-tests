def _frozen_out(tmp_path, monkeypatch):
    """A follow-up output with one market's bank input, two searches and a reference, and the matching jobs."""
    out = tmp_path / "out"; bank = A.R.cell_id(CTX, "F000", "D2+H3", "profit")
    write(A.R.path_of(out, bank), {"stage": "search"}); write(out / "inputs.json", {bank: sha_file(A.R.path_of(out, bank))})
    jobs = []
    for fam in ("D2+H3", "X7-SC"):
        rid = A.R.cell_id(CTX, "C*", fam, "profit"); prov = {"id": rid, "p": 1}
        up = {} if fam == "D2+H3" else {A.R.cell_id(CTX, "C*", "D2+H3", "profit"): sha_file(A.R.path_of(out, A.R.cell_id(CTX, "C*", "D2+H3", "profit")))}
        write(A.R.path_of(out, rid), {"stage": "search", "provenance": prov, "upstream": up}); jobs.append({"id": rid, "context": CTX, "family": fam, "provenance": prov})
    ref = f"reference/{CTX}/C*"; write(A.R.path_of(out, ref), {"stage": "reference", "provenance": {"ref": 1},
                                                                "upstream": {j["id"]: sha_file(A.R.path_of(out, j["id"])) for j in jobs} | {bank: sha_file(A.R.path_of(out, bank))}})
    monkeypatch.setattr(A, "_expected", lambda rid, jobs: set((read(A.R.path_of(out, rid)) or {}).get("upstream") or {}))
    monkeypatch.setattr(A, "_ref_provenance", lambda jobs, ctx: {"ref": 1})
    monkeypatch.setattr(A, "bank_inputs", lambda src, ctxs: {bank: sha_file(A.R.path_of(out, bank))})
    return out, jobs


def test_prefreeze_and_acceptance_validate_the_complete_freeze(tmp_path, monkeypatch):
    out, jobs = _frozen_out(tmp_path, monkeypatch)
    A.prefreeze(out, jobs, src="src"); fr = read(A.R.path_of(out, f"freeze/{CTX}"))
    assert len(fr["records"]) == 4 and fr["cuts"] == 3 and fr["h4_excluded"] is False and fr["followup"] is True
    A.check_freeze(out, jobs, src="src")


def test_acceptance_refuses_an_empty_or_incomplete_freeze(tmp_path, monkeypatch):
    out, jobs = _frozen_out(tmp_path, monkeypatch); A.prefreeze(out, jobs, src="src")
    p = A.R.path_of(out, f"freeze/{CTX}"); f = read(p)
    for change in ({"records": {}}, {"records": {k: v for k, v in f["records"].items() if not k.startswith("reference/")}}, {"cuts": 2}, {"h4_excluded": True}):
        write(p, {**f, **change})
        with pytest.raises(SystemExit):
            A.check_freeze(out, jobs, src="src")


def test_prefreeze_refuses_a_stale_or_wrongly_linked_record(tmp_path, monkeypatch):
    out, jobs = _frozen_out(tmp_path, monkeypatch)
    q = A.R.path_of(out, jobs[0]["id"]); d = read(q); d["provenance"] = {"id": "old"}; write(q, d)
    with pytest.raises(SystemExit, match="provenance"):
        A.prefreeze(out, jobs, src="src")
    out2, jobs2 = _frozen_out(tmp_path / "b", monkeypatch)
    q = A.R.path_of(out2, jobs2[1]["id"]); d = read(q); d["upstream"] = {jobs2[0]["id"]: "0" * 64}; write(q, d)
    with pytest.raises(SystemExit, match="hash"):
        A.prefreeze(out2, jobs2, src="src")


def test_a_changed_bank_copy_is_refused_even_with_a_rebuilt_reference(tmp_path, monkeypatch):
    out, jobs = _frozen_out(tmp_path, monkeypatch); bank = A.R.cell_id(CTX, "F000", "D2+H3", "profit"); q = A.R.path_of(out, bank)
    orig = sha_file(q); monkeypatch.setattr(A, "bank_inputs", lambda src, ctxs: {bank: orig})          # the original freeze hash
    write(q, {"stage": "search", "changed": True}); w = read(out / "inputs.json"); w[bank] = sha_file(q); write(out / "inputs.json", w)
    ref = A.R.path_of(out, f"reference/{CTX}/C*"); r = read(ref); r["upstream"][bank] = sha_file(q); write(ref, r)       # rebuilt reference
    with pytest.raises(SystemExit, match="original freeze"):
        A.prefreeze(out, jobs, src="src")


def test_a_full_run_needs_bound_reproduction_evidence(tmp_path, monkeypatch):
    with pytest.raises(SystemExit, match="evidence"):
        A.check_run_evidence(None, None, None, smoke=False)
    seen = []
    monkeypatch.setattr(A.G, "check_reset_evidence", lambda m, p: seen.append((m, p)))
    write(tmp_path / "dbl.json", {"pass": True}); A.check_run_evidence(tmp_path / "m", tmp_path / "p", tmp_path / "dbl.json", smoke=False)
    assert seen == [(tmp_path / "m", tmp_path / "p")]
    write(tmp_path / "bad.json", {"pass": False})
    with pytest.raises(SystemExit, match="evidence"):
        A.check_run_evidence(tmp_path / "m", tmp_path / "p", tmp_path / "bad.json", smoke=False)
    A.check_run_evidence(None, None, None, smoke=True)


@pytest.mark.skipif(not (MAIN / "eval/all/freeze").is_dir(), reason="needs the registered evaluation records")
def test_smoke_path_for_one_fresh_market(tmp_path, monkeypatch):
def inputs(src, jobs: list[dict]) -> dict[str, str]:
    """Every record the frozen evaluation and doubling stages read for `jobs`, with the hash the original records hold:
    the reference from the context's original freeze, its menu and bank records from the reference's `upstream`, and
    (recursively) the `upstream` of each copied search record."""
    need: dict[str, str] = {}
    for j in jobs:
        ctx = j["context"]; fr = read(R.path_of(src, f"freeze/{ctx}"))
        if fr is None:
            _refuse(f"the original freeze of {ctx} is missing")
        if "cuts" not in fr or "h4_excluded" not in fr or fr["cuts"] != CUTS or fr["h4_excluded"] != H4_EXCLUDED:
            _refuse(f"the original freeze of {ctx} does not state cuts {CUTS} with H4 loaded")
        rid = f"reference/{ctx}/{j['rule']}"
        if rid not in fr["records"]:
            _refuse(f"{rid} is not in the original freeze of {ctx}")
        ref = read(R.path_of(src, rid))
        if ref is None:
            _refuse(f"{rid} is missing in {src}")
        want = _expected_reference_upstream(rid)
        if want is not None and set(ref.get("upstream") or {}) != want:
            _refuse(f"{rid}: its dependencies are not the registered menu and cuts-{CUTS} bank")
        need[rid] = fr["records"][rid]; todo = dict(ref["upstream"])
        while todo:
            u, s = todo.popitem()
            if need.setdefault(u, s) != s:
                _refuse(f"{u}: two original records hold different hashes")
            if u not in fr["records"]:
                _refuse(f"{u}: not in the original freeze of {ctx}")
            if fr["records"][u] != s:
                _refuse(f"{u}: its hash differs from the original freeze of {ctx}")
            for k, v in ((read(R.path_of(src, u)) or {}).get("upstream") or {}).items():
                if need.get(k, v) != v or todo.get(k, v) != v:
                    _refuse(f"{k}: two original records hold different hashes")
                if k not in need:
                    todo[k] = v
    return need


def copy_inputs(src, out, need: dict[str, str]) -> None:
def market(label: str, root: str, rho: float = 0.2, dev: bool = False, smoke: bool = False, cfg=None, commit: str | None = None,
           salt_sha256: str | None = None) -> dict:
    """`cfg`, `commit`, and `salt_sha256` come from recorded inputs when given (the verify stage), so no calibration
    episode, git process, or salt read happens."""
    cfg = cfg if cfg is not None else _market_cfg(label, root, float(rho))
    train, val = list(range(1000, 1005)), list(range(2000, 2020))
    ev = val if dev else INST.eval_seeds(root, label)
    if smoke:
        train, ev = train[: SMOKE[2]], ev[: SMOKE[3]]
    out = {"label": label, "root": root, "rho": float(rho), "dev": bool(dev), "smoke": bool(smoke), "cfg": cfg, "focal": int(positions(cfg)["median"]),
           "seeds_train": train, "seeds_val": val, "seeds_eval": list(ev), "context": MAN.context(label, float(rho))}
    if commit is not None:
        out["commit"] = str(commit)
    if salt_sha256 is not None:
        out["salt_sha256"] = str(salt_sha256)
    return out


def manifest_ctx(ctx: str) -> str:
def job(mkt: dict, rule: str, family: str, objective: str = "profit", c: int | None = None, schedule: str | None = None,
        smoke: bool = False, params: dict | None = None, h4: dict | None = None, block: str | None = None) -> dict:
    lk = load_locked(); s = lk["search"]
    R, E, n_train, n_eval = SMOKE if (smoke or mkt["smoke"]) else (int(s["restarts"]), int(s["evals_per_restart"]), len(mkt["seeds_train"]), len(mkt["seeds_eval"]))
    if family in ("X7-SC", "H4"):                   # H4 is priced and searched as an X7-SC cell (design draft 7, 5.3)
        E *= 2
    spec = rule_spec(rule, params)
    j = {"id": cell_id(mkt["context"], rule, family, objective, c, schedule), "context": mkt["context"], "rule": rule, "family": family,
         "objective": objective, "c": c, "schedule": schedule, "budget": [R, E, n_train, n_eval], "spec": spec, "mkt": mkt,
         "h4": h4 if family == "H4" else None}
    cell = _cells_by_id().get(j["id"].replace(j["context"], manifest_ctx(j["context"]), 1))
    j["block"] = block or (cell or {}).get("block"); j["priority"] = MAN.priority(cell) if cell else 3      # execution priority (design 8.2)
    j["provenance"] = context_provenance(mkt) | {"budget": j["budget"], "rule_params_sha256": _sha_json(spec), "id": j["id"]}
    if family == "H4" and h4:
        j["provenance"]["h4_sha256"] = str(h4["sha"])
    return j


def context_provenance(mkt: dict) -> dict:
"""Loader of the sealed, independently authored family H4 (design 5.3). The bundle's h4/family.py exports
make_family(T, L) -> Family and BINARY (the binary knob names, clip included); the loader verifies the bundle hash, imports
the module by absolute path, and checks the family at two constant pairs (a Family named H4, clip last, bounds for every
non-binary knob). Any failure excludes H4 and is reported; there is no repair after the lock."""
from __future__ import annotations

import hashlib
import importlib.util
from dataclasses import dataclass
from pathlib import Path

import math

from .policies.families import Family

BUNDLE_FILES = ("h4/family.py", "h4/containment.md", "h4/check.json")
CHECK_CONSTANTS = ((200, 10), (100, 20))
MAX_KNOBS = 15                                   # design draft 7, 5.3: the resource envelope


def bundle_sha(bundle_dir) -> str:
    h = hashlib.sha256()
    for rel in BUNDLE_FILES:
        h.update(rel.encode()); h.update(b"\0"); h.update(hashlib.sha256((Path(bundle_dir) / rel).read_bytes()).hexdigest().encode()); h.update(b"\n")
    return h.hexdigest()


@dataclass(frozen=True)
class Excluded:
    reason: str


class H4Source:
    def __init__(self, module) -> None:
        self.module = module

    def family(self, T: int, L: int) -> Family:
        return self.module.make_family(int(T), int(L))


def _check(fam, binary) -> str | None:
    if not isinstance(fam, Family):
        return "make_family did not return a Family"
    if fam.name != "H4":
        return f"family name {fam.name!r} is not H4"
    if not fam.knobs or fam.knobs[-1] != "clip" or "clip" in fam.bounds:
        return "clip must be the last, binary knob"
    if len(fam.knobs) > MAX_KNOBS:
        return f"{len(fam.knobs)} knobs: the envelope allows at most {MAX_KNOBS} knobs"
    if not callable(getattr(fam, "project", None)):
        return "the family has no callable project (truthful projection)"
    missing = [k for k in fam.knobs if k not in fam.bounds and k not in binary]
    if missing:
        return f"no bounds for non-binary knob(s) {missing}"
    if any(not (math.isfinite(float(lo)) and math.isfinite(float(hi))) for lo, hi in fam.bounds.values()):
        return "knob bounds must be finite"
    if any(not (float(lo) < float(hi)) for lo, hi in fam.bounds.values()):
        return "empty knob bounds"
    return None


