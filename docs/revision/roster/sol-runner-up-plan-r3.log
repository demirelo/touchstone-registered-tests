   270	def main(argv=None) -> int:
   271	    argv = list(sys.argv[1:] if argv is None else argv)
   272	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   273	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True); ap.add_argument("--report", required=True)
   274	    ap.add_argument("--posthoc", default=str(HERE.parent / "posthoc" / "posthoc.json"), help="its `nesting` block adds X7-SC cells")
   275	    ap.add_argument("--draw", required=True); ap.add_argument("--instances", required=True); ap.add_argument("--cfgs", required=True); ap.add_argument("--addendum", required=True)
   276	    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--cells", default=None, help="comma list; default the whole run")
   277	    ap.add_argument("--max-rounds", dest="max_rounds", type=int, default=MAX_ROUNDS); ap.add_argument("--workers", type=int, default=1)
   278	    ap.add_argument("--smoke", action="store_true"); ap.add_argument("--gate", action="store_true", help="round 1 only, compared with the registered doubling")
   279	    ap.add_argument("--site", choices=("mac", "pod"), default="pod", help="where this runs; a pod run is paid and needs --started-at")
   280	    ap.add_argument("--evidence", action="append", default=[], help="gate records (Mac and pod) for the gate cells (full runs)")
   281	    ap.add_argument("--cap-usd", dest="cap", type=float, default=4.25); ap.add_argument("--usd-per-hour", dest="rate", type=float, default=0.56)
   282	    ap.add_argument("--started-at", dest="started", type=float, default=None); ap.add_argument("--prior-spend-usd", dest="prior", type=float, default=0.0)
   283	    a = ap.parse_args(argv)
   284	    G.pin_settings(); out = Path(a.out); F.check_out(out, a.src)
   285	    if not 1 <= a.max_rounds <= MAX_ROUNDS:
   286	        _refuse(f"--max-rounds must be 1 to {MAX_ROUNDS}")
   287	    from sim.records import cfg_from_dict
   288	    report = json.loads(Path(a.report).read_text()); nesting = json.loads(Path(a.posthoc).read_text())["nesting"]
   289	    root = json.loads(Path(a.draw).read_text())["hash"]; salt = json.loads(Path(a.instances).read_text())["salt_sha256"]
   290	    params = json.loads(Path(a.params).read_text()); cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   291	    plan = cells_for(report, nesting)
   292	    cells = a.cells.split(",") if a.cells else plan["cells"]
   293	    if bad := [c for c in cells if c not in plan["cells"]]:
   294	        _refuse(f"not cells of this run: {bad}")
   295	    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   296	    jobs = [job_for(c, root, cfgs, params, salt, a.smoke) for c in cells]
   297	    container = dict(json.loads(Path(a.addendum).read_text())["deviations"]["configs"])
   298	    for j in jobs:                                               # headline: the registered record's configuration hash
   299	        if j["mkt"]["label"] == "headline":
   300	            container["headline"] = {"container_hash": read(R.path_of(a.src, j["id"]))["provenance"]["cfg_sha256"]}
   301	    F.check_salt(out, salt, jobs); F.check_commit(jobs); F.check_code(); F.check_configs(jobs, container)
   302	    if not a.smoke:
   303	        F.check_pairing(a.src, jobs)
   304	        for j in jobs:
   305	            G.check_budget(j, R.path_of(a.src, j["id"]))
   306	    needs = {j["id"]: cell_inputs(a.src, j) for j in jobs}
   307	    F.copy_inputs(a.src, out, merge_inputs(list(needs.values())))     # one call: the helper refuses added keys
   308	    drv = sha_file(Path(__file__))
   309	    bind = lambda j: G.binding(inputs_sha=G.sha_json(needs[j["id"]]), provenance=j["provenance"], smoke=a.smoke,
   310	                               settings={"max_rounds": a.max_rounds, "threshold": THRESHOLD, "seeds": "1+(k-1)R", "nesting": j["id"] in plan["nesting"]},
   311	                               driver_sha=drv)
   312	    gate_cells = {c: {"inputs_sha": G.sha_json(cell_inputs(a.src, job_for(c, root, cfgs, params, salt, False))), "driver_sha": drv} for c in GATE_CELLS}
   313	    check_run_evidence(a.evidence, a.smoke, a.gate, gate_cells)
   314	    t = json.loads((ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]; ev = t["eval160"]["profit"] * 200 / 160
   315	    hours = lambda j: ((t["doubling_x7"] if j["family"] == "X7-SC" else t["doubling"]) + ev) / 3600 + 0.1     # a round, its evaluation, shutdown
   316	    paid = a.site == "pod" and not a.smoke
   317	    cost = (lambda: G.paid_cost_stop(a.cap, a.rate, a.started, a.prior)) if paid else (lambda: None)
   318	    stop = cost(); cargs = (a.cap, a.rate, a.started, __import__("time").time, a.prior) if paid else None
   319	    files = {"driver": Path(__file__), "plan": HERE / "convergence-plan.md", "report": Path(a.report), "posthoc": Path(a.posthoc)}
   320	    if a.gate:
   321	        res = {}
   322	        for j in jobs:                                           # serial; admission before each gate cell
   323	            if stop and not stop.allow(f"gate {j['id']}", hours(j)):
   324	                write(out / "cost_stop.json", stop.report()); G.inventory(out, DEVIATIONS, files, argv); return 3
   325	            res[j["id"]] = gate_cell(j, out, a.src, a.site, bind(j), cargs, hours(j))
   326	            write(out / "gate" / (R._safe(j["id"]) + f"__{a.site}.json"), res[j["id"]])
   327	        G.inventory(out, DEVIATIONS, files, argv)
   328	        return 0 if all(r["pass"] for r in res.values()) else 4
   329	    path = lambda j: out / "convergence" / (R._safe(j["id"]) + ".json")
   330	    todo = sorted((j for j in jobs if not G.reusable(path(j), bind(j))), key=lambda j: j["family"] != "X7-SC")   # longest first
   331	    emb = lambda j: (report["doubling"].get(R.cell_id(j["context"], j["rule"], "D2+H3", "profit")) or {}).get("heldout", {}).get("knobs") if j["id"] in plan["nesting"] else None
   332	    minr = lambda j: 2 if j["id"] in plan["nesting"] else 1
   333	    args = [(j, out, a.max_rounds, None if a.smoke else a.src, cargs, hours(j), emb(j), minr(j)) for j in todo]
   334	    from concurrent.futures import ProcessPoolExecutor
   335	    if a.workers > 1 and len(todo) > 1:
   336	        with ProcessPoolExecutor(max_workers=a.workers) as ex:
   337	            res = list(ex.map(run_cell, *zip(*args)))
   338	    else:
   339	        res = [run_cell(*x) for x in args]
   340	    for j, rec in zip(todo, res):
   341	        write(path(j), {**rec, "binding": bind(j)})
   342	    status = {j["id"]: read(path(j))["status"] for j in jobs}
   343	    mismatch = [k for k, v in status.items() if v.startswith("stopped: round 1")]
   344	    if not a.smoke and not mismatch:
   345	        done = {j["id"]: bind(j) for j in jobs if "heldout" in read(path(j))}
   346	        nest_done = {k: read(out / "convergence" / (R._safe(k) + ".json"))["heldout"]["gain"] for k in plan["nesting"] if k in done}
   347	        write(out / "recompute.json", {**recompute(a.src, out, expected=done), "nesting_shortfall": shortfall_report(nesting, nest_done)})
   348	    G.inventory(out, DEVIATIONS, files, argv)
   349	    print(json.dumps({"cells": len(jobs), "status": status}))
   350	    return 4 if mismatch else 0
   351	
   352	
   353	if __name__ == "__main__":
   354	    sys.exit(main())

