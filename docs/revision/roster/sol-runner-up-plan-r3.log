    39	def q1_category(interval) -> str:
    40	    """The registered Q1 categories (design 9.3), applied descriptively to a nominal interval."""
    41	    lo, hi = interval
    42	    if lo > MARGIN:
    43	        return "materially lower (R3 lower)"
    44	    if hi < -MARGIN:
    45	        return "materially lower (comparator lower)"
    46	    if -MARGIN <= lo and hi <= MARGIN:
    47	        if lo > 0:
    48	            return "equivalent, direction R3 lower"
    49	        if hi < 0:
    50	            return "equivalent, direction comparator lower"
    51	        return "equivalent"
    52	    if lo > 0 or hi < 0:
    53	        return "ordered, size not established"
    54	    return "inconclusive"
