   252	def _contrasts(ru, r3, cs, markets, resamples) -> dict | str:
   253	    if None in (ru, r3, cs):
   254	        return "not available"
   255	    for m in markets:
   256	        if not (ru[m][0] == r3[m][0] == cs[m][0]):
   257	            raise ValueError(f"{m}: evaluation seeds differ")
   258	    if not G.finite([ru[m][1] for m in markets], [r3[m][1] for m in markets], [cs[m][1] for m in markets]):
   259	        return "not available"
   260	    g = lambda d: {m: d[m][1] for m in markets}
   261	    a, b, c = C.pooled_paired(g(ru), g(r3), resamples), C.pooled_paired(g(cs), g(ru), resamples), C.pooled_paired(g(cs), g(r3), resamples)
   262	    return {"runner_up_minus_r3": {**a, "category": C.q1_category(a["interval"])}, "cstar_minus_runner_up": b,
   263	            "cstar_minus_r3": {**c, "category": C.q1_category(c["interval"])}}
   264	
   265	
   266	def _score(base, doubled) -> dict:
   267	    vals = [None if isinstance(x, str) else x["cstar_minus_runner_up"]["estimate"] > 0 for x in (base, doubled)]   # a tie is not met
   268	    score = "not available" if None in vals else ("met" if all(vals) else ("failed" if not any(vals) else "not established"))
   269	    return {"statement": EXPECTATION, "base": vals[0], "doubled": vals[1], "score": score}
