   312	    a = ap.parse_args(argv); out = Path(a.out); F.check_out(out, a.src)
   313	    G.pin_settings(); check_run_evidence(a.reset_mac, a.reset_pod, a.doubling_evidence, a.smoke)
   314	    from sim.records import cfg_from_dict
   315	    root = json.loads(Path(a.draw).read_text())["hash"]; salt = json.loads(Path(a.instances).read_text())["salt_sha256"]
