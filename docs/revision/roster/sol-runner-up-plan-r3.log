   135	def _validate_new(out, rid: str, stage: str, prov: dict, jobs: list[dict]) -> str:
   136	    """A new record of this run: its stage, its current provenance, its dependency ids, and each dependency's current hash."""
   137	    p = R.path_of(out, rid); rec = read(p)
   138	    if rec is None or rec.get("stage") != stage:
   139	        _refuse(f"{rid}: no {stage} record")
   140	    if rec.get("provenance") != prov:
   141	        _refuse(f"{rid}: provenance is not the current job's")
   142	    up = rec.get("upstream") or {}
   143	    if set(up) != _expected(rid, jobs):
   144	        _refuse(f"{rid}: dependency set {sorted(up)} is not the expected one")
   145	    for u, h in up.items():
   146	        q = R.path_of(out, u)
   147	        if not q.exists() or sha_file(q) != h:
   148	            _refuse(f"{rid}: dependency {u} differs from its recorded hash")
   149	    return sha_file(p)
