   116	def _frozen_out(tmp_path, monkeypatch):
   117	    """A follow-up output with one market's bank input, two searches and a reference, and the matching jobs."""
   118	    out = tmp_path / "out"; bank = A.R.cell_id(CTX, "F000", "D2+H3", "profit")
   119	    write(A.R.path_of(out, bank), {"stage": "search"}); write(out / "inputs.json", {bank: sha_file(A.R.path_of(out, bank))})
   120	    jobs = []
   121	    for fam in ("D2+H3", "X7-SC"):
   122	        rid = A.R.cell_id(CTX, "C*", fam, "profit"); prov = {"id": rid, "p": 1}
   123	        up = {} if fam == "D2+H3" else {A.R.cell_id(CTX, "C*", "D2+H3", "profit"): sha_file(A.R.path_of(out, A.R.cell_id(CTX, "C*", "D2+H3", "profit")))}
   124	        write(A.R.path_of(out, rid), {"stage": "search", "provenance": prov, "upstream": up}); jobs.append({"id": rid, "context": CTX, "family": fam, "provenance": prov})
   125	    ref = f"reference/{CTX}/C*"; write(A.R.path_of(out, ref), {"stage": "reference", "provenance": {"ref": 1},
   126	                                                                "upstream": {j["id"]: sha_file(A.R.path_of(out, j["id"])) for j in jobs} | {bank: sha_file(A.R.path_of(out, bank))}})
   127	    monkeypatch.setattr(A, "_expected", lambda rid, jobs: set((read(A.R.path_of(out, rid)) or {}).get("upstream") or {}))
   128	    monkeypatch.setattr(A, "_ref_provenance", lambda jobs, ctx: {"ref": 1})
   129	    monkeypatch.setattr(A, "bank_inputs", lambda src, ctxs: {bank: sha_file(A.R.path_of(out, bank))})
   130	    return out, jobs
