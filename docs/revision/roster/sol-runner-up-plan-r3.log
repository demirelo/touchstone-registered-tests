   290	def stage_hours() -> dict:
   291	    """Billed wall time per stage on one pod (critical path), from the benchmark."""
   292	    t = json.loads((ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]; ev = lambda k: t["eval160"][k] * 200 / 160
