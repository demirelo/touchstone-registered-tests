   152	def _required(out, jobs: list[dict], ctx: str, src) -> dict:
   153	    """Every record the context's freeze must hold: exactly its bank inputs, each copy's actual hash equal to the original
   154	    freeze's, both searches, and its reference, each new record validated with current hashes."""
   155	    recs = {}
   156	    for r, h in bank_inputs(src, [ctx]).items():
   157	        q = R.path_of(out, r)
   158	        if not q.exists() or sha_file(q) != h:
   159	            _refuse(f"{r}: the copy differs from the original freeze")
   160	        recs[r] = h
   161	    for j in (j for j in jobs if j["context"] == ctx):
   162	        recs[j["id"]] = _validate_new(out, j["id"], "search", j["provenance"], jobs)
   163	    rid = f"reference/{ctx}/{LABEL}"; recs[rid] = _validate_new(out, rid, "reference", _ref_provenance(jobs, ctx), jobs)
   164	    return recs
