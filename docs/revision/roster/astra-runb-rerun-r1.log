+    time.sleep(wait)
+    if job["id"] == "kill":
+        os.kill(os.getpid(), 9)                                  # what the out-of-memory killer did on the pod
+    return {"id": job["id"], "status": "passed"}
+
+
+def test_each_cell_is_saved_when_it_ends_and_a_killed_worker_loses_only_its_own_cell():
+    saved = []
