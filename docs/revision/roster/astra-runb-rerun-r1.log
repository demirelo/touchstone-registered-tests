   224	def _supporting_problems(d: Path, stage: str, cell: str, inp: dict, srch, src) -> list:
   225	    """The supporting records' stages, provenance, dependency sets, dependency hashes, and the freeze contents."""
   226	    out, ctx = [], cell.split("|")[0]
   227	    reg = read(F.R.path_of(src, cell)) if src is not None else None
   228	    if reg is not None and srch is not None and any((srch.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV):
   229	        out.append("search provenance differs from the registered record")
   230	    if stage == "reproduction gate":
   231	        fr, ev = read(d / "freeze" / f"{ctx}.json"), read(F.R.eval_path(d, cell))
   232	        want = {r: h for r, h in inp.items() if r.startswith(ctx) or f"/{ctx}/" in r}
   233	        want[cell] = sha_file(F.R.path_of(d, cell)) if F.R.path_of(d, cell).exists() else None
   234	        if fr is None or fr.get("stage") != "freeze" or fr.get("followup") is not True or fr.get("cuts") != F.CUTS or fr.get("h4_excluded") != F.H4_EXCLUDED \
   235	                or not fr.get("records") or fr["records"] != want or not _deps_ok(d, fr["records"], set(want)):
   236	            out.append("freeze empty, incomplete, or stale")
