     1	"""The budget ledger of the paid operations (design 8.2; operations plan Task 4). A pod's USD cap is reserved before its
     2	launch: the grant is min(estimate x 1.25, phase cap - spent - outstanding), refused when it is below the estimate or when
     3	the spend plus outstanding reservations of both phases would pass the approval limit (40 USD, or the higher limit of a
     4	written approval). The actual spend replaces the reservation when the pod is pulled. Every update holds an exclusive lock
     5	on <ledger>.lock across its read and write, so concurrent launches cannot oversubscribe a cap."""
     6	from __future__ import annotations
     7	
     8	import argparse
     9	import fcntl
    10	import json
    11	import math
    12	import os
    13	import sys
    14	from contextlib import contextmanager
    15	from pathlib import Path
    16	
    17	DEFAULT = Path(__file__).resolve().parents[1] / "docs" / "revision" / "budget-ledger.json"
    18	DECISION_H4 = Path(__file__).resolve().parents[1] / "experiments" / "v2" / "benchmark" / "decision-h4.json"
    19	CAPS = {"development": 12.0, "evaluation": 40.0}
    20	APPROVAL_LIMIT = 40.0
    21	HEADROOM = 1.25
    22	
    23	
    24	class Refused(Exception):
    25	    pass
    26	
    27	
    28	def _amount(x, what: str, positive: bool = False) -> float:
    29	    """A finite, nonnegative amount (positive when required); anything else would disable the cap comparisons."""
    30	    try:
    31	        v = float(x)
    32	    except (TypeError, ValueError):
    33	        raise Refused(f"{what} {x!r} is not a number")
    34	    if not math.isfinite(v) or v < 0 or (positive and v <= 0):
    35	        raise Refused(f"{what} {x!r} must be finite and {'positive' if positive else 'nonnegative'}")
    36	    return v
    37	
    38	
    39	def _valid(d: dict) -> dict:
    40	    for op, cap in d.get("caps", {}).items():
    41	        _amount(cap, f"cap {op}", positive=True)
    42	    for r in d.get("spent", []):
    43	        _amount(r.get("usd"), f"spend {r.get('tag')}")
    44	    for r in d.get("reservations", []):
    45	        _amount(r.get("cap"), f"reservation {r.get('tag')}")
    46	    if d.get("approval"):
    47	        _amount(d["approval"].get("limit"), "approval limit", positive=True)
    48	        if not (isinstance(d["approval"].get("text"), str) and d["approval"]["text"].strip()):
    49	            raise Refused("the saved approval has no written text")
    50	    return d
    51	
    52	
    53	def _after_read() -> None:
    54	    """Called between the ledger read and write of an update; a test replaces it to widen the race window."""
    55	
    56	
    57	@contextmanager
    58	def _locked(path: Path):
    59	    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    60	    with open(f"{path}.lock", "a") as lk:
    61	        fcntl.flock(lk, fcntl.LOCK_EX)
    62	        try:
    63	            d = _valid(json.loads(path.read_text()) if path.exists() else {"caps": dict(CAPS), "reservations": [], "spent": [], "approval": None})
    64	            _after_read()
    65	            yield d
    66	            tmp = Path(f"{path}.{os.getpid()}.tmp"); tmp.write_text(json.dumps(d, indent=1)); os.replace(tmp, path)
    67	        finally:
    68	            fcntl.flock(lk, fcntl.LOCK_UN)
    69	
    70	
    71	def _used(d: dict, op: str | None = None) -> float:
    72	    pick = lambda rows: sum(float(r.get("usd", r.get("cap", 0.0))) for r in rows if op is None or r["op"] == op)
    73	    return pick(d["spent"]) + pick(d["reservations"])
    74	
    75	
    76	def limit(d: dict) -> float:
    77	    return float((d.get("approval") or {}).get("limit", APPROVAL_LIMIT))
    78	
    79	
    80	def _gate(d: dict, op: str, decision_h4) -> None:
    81	    """Design draft 7, 5.3 and 8.2: once the decision after the H4 timing exists, no development reservation (any tag)
    82	    while it stops, or while its total needs an approval that the ledger's limit does not cover."""
    83	    p = Path(decision_h4) if decision_h4 is not None else None
    84	    if op != "development" or p is None or not p.exists():
    85	        return
    86	    dec = json.loads(p.read_text())["decision"]
    87	    if dec.get("stop"):
    88	        raise Refused(f"the decision after the H4 timing stops at {dec['stop']!r}: no further development reservation")
    89	    if dec.get("approval_required") and limit(d) + 1e-9 < float(dec.get("total_usd") or 0.0):
    90	        raise Refused(f"the decision after the H4 timing totals {dec.get('total_usd')} USD; record the author's approval with --approve first")
    91	
    92	
    93	def reserve(path, op: str, tag: str, estimate: float, decision_h4=DECISION_H4) -> float:
    94	    estimate = _amount(estimate, "estimate", positive=True)
    95	    with _locked(path) as d:
    96	        _gate(d, op, decision_h4)
    97	        if any(r["tag"] == tag for r in d["reservations"] + d["spent"]):
    98	            raise Refused(f"tag {tag!r} is already in the ledger")
    99	        grant = min(float(estimate) * HEADROOM, float(d["caps"][op]) - _used(d, op))
   100	        if grant < float(estimate):
   101	            raise Refused(f"{op}: {grant:.2f} USD left under the cap, below the estimate {float(estimate):.2f}")
   102	        if _used(d) + grant > limit(d) + 1e-9:
   103	            raise Refused(f"the combined spend and reservations would reach {_used(d) + grant:.2f} USD, above the approved {limit(d):.2f}")
   104	        d["reservations"].append({"op": op, "tag": tag, "cap": round(grant, 6)})
   105	        return grant
   106	
   107	
   108	def record(path, tag: str, usd: float) -> None:
   109	    usd = _amount(usd, "spend")
   110	    with _locked(path) as d:
   111	        r = next((r for r in d["reservations"] if r["tag"] == tag), None)
   112	        if r is None:
   113	            raise Refused(f"no reservation {tag!r}")
   114	        d["reservations"].remove(r); d["spent"].append({"op": r["op"], "tag": tag, "usd": float(usd)})
   115	
   116	
   117	def approve(path, new_limit: float, text: str) -> None:
   118	    new_limit = _amount(new_limit, "approval limit", positive=True)
   119	    if not str(text).strip():
   120	        raise Refused("an approval needs the author's written text")
   121	    with _locked(path) as d:
   122	        d["approval"] = {"limit": float(new_limit), "text": str(text)}
   123	
   124	
   125	def main(argv=None) -> int:
   126	    ap = argparse.ArgumentParser()
   127	    ap.add_argument("--ledger", default=str(DEFAULT))
   128	    g = ap.add_mutually_exclusive_group(required=True)
   129	    g.add_argument("--reserve", nargs=3, metavar=("OP", "TAG", "ESTIMATE")); g.add_argument("--record", nargs=2, metavar=("TAG", "USD"))
   130	    g.add_argument("--approve", nargs=2, metavar=("LIMIT", "TEXT")); g.add_argument("--show", action="store_true")
   131	    a = ap.parse_args(argv)
   132	    try:
   133	        if a.reserve:
   134	            print(f"{reserve(a.ledger, a.reserve[0], a.reserve[1], float(a.reserve[2])):.2f}")
   135	        elif a.record:
   136	            record(a.ledger, a.record[0], float(a.record[1]))
   137	        elif a.approve:
   138	            approve(a.ledger, float(a.approve[0]), a.approve[1])
   139	        else:
   140	            print(Path(a.ledger).read_text())
   141	    except Refused as e:
   142	        print(f"refused: {e}", file=sys.stderr)
   143	        return 1
   144	    return 0
   145	
   146	
   147	if __name__ == "__main__":
   148	    sys.exit(main())

