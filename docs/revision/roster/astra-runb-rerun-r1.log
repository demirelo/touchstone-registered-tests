+    args = [(jobs[0], 1.5), (jobs[1], 0.0), (jobs[2], 0.0)]
+    lost = B.run_cells(_probe_cell, jobs, args, workers=2, save=lambda j, rec: saved.append((j["id"], rec["status"])))
+    assert sorted(saved) == [("a", "passed"), ("b", "passed")]
+    assert lost == ["kill"]
+
