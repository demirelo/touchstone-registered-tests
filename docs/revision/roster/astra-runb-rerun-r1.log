   339	def main(argv=None) -> int:
   340	    argv = list(sys.argv[1:] if argv is None else argv)
   341	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   342	    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True); ap.add_argument("--report", required=True)
