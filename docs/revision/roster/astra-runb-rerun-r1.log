   405	            res[j["id"]] = gate_cell(j, out, a.src, a.site, bind(j), cargs, hours(j))
   406	            if res[j["id"]]["cost_stopped"]:                     # shared launcher review r1: exit 3 (a stop), and no gate record
   407	                write(out / "cost_stop.json", {**(stop.report() if stop else {}), "inner": res[j["id"]]["cost"], "cell": j["id"]})
   408	                G.inventory(out, DEVIATIONS, files, argv); return 3
   409	            write(out / "gate" / (R._safe(j["id"]) + f"__{a.site}.json"), res[j["id"]])
   410	            if not res[j["id"]]["pass"]:                         # review r2: a measured mismatch ends the gate at once (exit 4);
   411	                G.inventory(out, DEVIATIONS, files, argv); return 4   # no later cell starts, so no later stop can mask it
   412	        G.inventory(out, DEVIATIONS, files, argv)
   413	        return 0 if all(r["pass"] for r in res.values()) else 4
   414	    path = lambda j: out / "convergence" / (R._safe(j["id"]) + ".json")
   415	    todo = sorted((j for j in jobs if not G.reusable(path(j), bind(j))), key=lambda j: j["family"] != "X7-SC")   # longest first
   416	    minr = lambda j: 2 if j["id"] in plan["nesting"] else 1
