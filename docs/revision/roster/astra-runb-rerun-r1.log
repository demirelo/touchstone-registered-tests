     1	"""Stage records of the v2 runner: atomic JSON writes, tolerant reads (a missing or truncated file is absent), and
     2	validation of a record's stage, provenance, and upstream hashes against the current files."""
     3	from __future__ import annotations
     4	
     5	import hashlib
     6	import json
     7	import os
     8	import secrets
     9	from pathlib import Path
    10	
    11	
    12	def write(path, rec: dict) -> None:
    13	    p = Path(path); p.parent.mkdir(parents=True, exist_ok=True)
    14	    tmp = p.with_name(f".{p.name}.{os.getpid()}.{secrets.token_hex(4)}.tmp")       # unique per writer
    15	    with open(tmp, "w") as f:
    16	        json.dump(rec, f, default=float); f.flush(); os.fsync(f.fileno())
    17	    os.replace(tmp, p)
    18	
    19	
    20	def read(path) -> dict | None:
    21	    try:
    22	        return json.loads(Path(path).read_text())
    23	    except (OSError, ValueError):
    24	        return None
    25	
    26	
    27	def sha_file(path) -> str:
    28	    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
    29	
    30	
    31	def validate(job: dict, stage: str, rec: dict, upstream: dict) -> None:
    32	    """`upstream` maps each upstream record id to its current path; raises ValueError on any mismatch."""
    33	    if rec.get("stage") != stage:
    34	        raise ValueError(f"record stage {rec.get('stage')!r} is not {stage!r}")
    35	    if rec.get("provenance") != job.get("provenance"):
    36	        raise ValueError("record provenance differs from the job's")
    37	    for rid, sha in (rec.get("upstream") or {}).items():
    38	        p = upstream.get(rid)
    39	        if p is None or not Path(p).exists() or sha_file(p) != sha:
    40	            raise ValueError(f"upstream {rid} changed or is missing")

