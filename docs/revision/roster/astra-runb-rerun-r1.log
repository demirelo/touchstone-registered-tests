   324	    exit 0 when the step may start, 3 when it may not."""
   325	    import argparse
   326	    ap = argparse.ArgumentParser(); ap.add_argument("cmd", choices=("admit",))
   327	    ap.add_argument("--cap-usd", dest="cap", type=float, required=True); ap.add_argument("--usd-per-hour", dest="rate", type=float, required=True)
   328	    ap.add_argument("--started-at", dest="started", type=float, required=True); ap.add_argument("--attempts", required=True)
   329	    ap.add_argument("--ledger", required=True); ap.add_argument("--run-tag", dest="tag", required=True); ap.add_argument("--hours", type=float, required=True)
   330	    ap.add_argument("--stop-file", dest="stop_file", default=None); ap.add_argument("--soft-deadline", dest="soft", type=float, default=None)
   331	    ap.add_argument("--now", type=float, default=None, help="for tests")
   332	    a = ap.parse_args(argv)
   333	    clock = (lambda: a.now) if a.now is not None else time.time
   334	    c = paid_cost_stop(a.cap, a.rate, a.started, a.attempts, a.ledger, a.tag, clock=clock, stop_file=a.stop_file, soft_deadline=a.soft)
