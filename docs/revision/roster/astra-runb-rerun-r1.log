   317	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   318	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   319	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   320	    expected = expected or {}
   321	    for rid in expected:
   322	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   323	            raise ValueError(f"{rid}: the run's result is missing")
   324	    sub, out = [], {}
   325	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   326	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   327	        for m in markets:
   328	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   329	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   330	                continue
   331	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra, expected), _cell_gains(src, conv, rb, expected)
   332	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   333	            sub += [r for r, s_ in ((ra, sa), (rb, sb)) if s_ and r not in sub]
   334	        if fz_a:
   335	            out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   336	    return {"label": "exploratory sensitivity; the frozen estimates stay primary; " + C.SCOPE, **out, "substituted": sub}
