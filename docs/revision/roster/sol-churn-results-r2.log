def _newest_by_first_offer(r, focal: int) -> float:
    """The mechanism-relevant statistic (sim/mechanisms/factorial.py: R3 ages an identity from its first offer and ranks
    the identities holding assigned jobs): over the rounds in which the focal identity holds assigned jobs, the share in
    which its first-offer round is strictly the latest among the identities holding assigned jobs."""
    first: dict = {}; hits = n = 0
    for t, h in enumerate(r.history):
        for i in getattr(h, "offers", {}) or {}:
            first.setdefault(int(i), t)
        holders = {int(i) for i in h.assignment.values()}
        mine = [i for i in holders if r.entity_of[i] == focal]
        if not mine:
            continue
        n += 1; f = first.get(mine[0], t); latest = max(first.get(i, t) for i in holders)
        hits += int(f == latest and sum(1 for i in holders if first.get(i, t) == latest) == 1)
    return hits / n if n else 0.0


def _uniquely_newest(r, focal: int) -> float:
    """Creation-time newest among the current identities: the share of rounds in which the focal provider's current
    identity has strictly the latest creation round (initial identities tie at round 0). Not the order R3 uses."""
    T = len(r.history); born = list(r.identity_round); ent = list(r.entity_of); hits = 0
    for t in range(T):
        cur = {}
        for i, (e, b) in enumerate(zip(ent, born)):
            if b <= t:
                cur[e] = i                                              # identities are numbered in creation order
        newest = max(born[i] for i in cur.values()); f = born[cur[focal]]
        hits += int(f == newest and sum(1 for i in cur.values() if born[i] == newest) == 1)
    return hits / T if T else 0.0


def newcomer_shares(results, focal: int, edges=AGE_EDGES) -> dict:
    """Audited share of served jobs by identity age (rounds since creation) for honest replacement identities, honest
    initial identities, and the focal provider's identities: per episode [served, audited] counts per age bin, and the
    pooled share per bin (None, "unavailable", when no job was served in the bin); honest replacements per episode; and
    per episode the share of rounds in which the focal identity is uniquely the newest."""
    cats = ("honest_replacement", "honest_initial", "focal"); nb = len(edges) - 1
    per, reps, newest, offer_newest = [], [], [], []
    for r in results:
        cnt = {c: [[0, 0] for _ in range(nb)] for c in cats}
        reps.append(sum(1 for i, e in enumerate(r.entity_of) if e != focal and r.identity_generation[i] > 0))
        cat = lambda i: "focal" if r.entity_of[i] == focal else ("honest_replacement" if r.identity_generation[i] > 0 else "honest_initial")
        for t, h in enumerate(r.history):
            def put(i, k):
                age = t - r.identity_round[i]
                for b in range(nb):
                    if edges[b] <= age < edges[b + 1]:
                        cnt[cat(i)][b][k] += 1; return
            for i in h.assignment.values():
                put(i, 0)
            for a in h.audits:
                put(a.provider, 1)
        per.append(cnt); newest.append(_uniquely_newest(r, focal)); offer_newest.append(_newest_by_first_offer(r, focal))
    out = {}
    for c in cats:
        rows = []
        for b in range(nb):
            sv = sum(e[c][b][0] for e in per); au = sum(e[c][b][1] for e in per)
            rows.append({"age": [edges[b], edges[b + 1]], "served": sv, "audited": au, "share": (au / sv if sv else None)})
        out[c] = rows
    out["per_episode"] = per
    out["honest_replacements_per_episode"] = float(sum(reps) / len(reps)) if reps else 0.0
    out["focal_newest_by_creation"] = newest
    out["focal_newest_by_first_offer_assigned"] = offer_newest
    return out


def pool_markets(by_market: dict, cat: str) -> list:
    """Equal market weights: per age bin, the mean of the market shares over the markets where the share is available."""
    nb = len(next(iter(by_market.values()))[cat]); res = []
    for b in range(nb):
        v = [m[cat][b]["share"] for m in by_market.values() if m[cat][b]["share"] is not None]
        res.append({"share": (sum(v) / len(v) if v else None), "markets": len(v)})
    return res


def _diag_one(job: dict, out: str) -> tuple:
    import numpy as np
    from sim.cell import SeedCache, run_focal
    install(); j = job
    T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j)
    pols = {"base": read(R.path_of(out, j["id"]))["attack"]["best_knobs"],
            "doubled": read(Path(out) / "doubling" / (R._safe(j["id"]) + ".json"))["heldout"]["knobs"]}
    row = {}
    for k, knobs in pols.items():
        fr = run_focal(cell, lambda knobs=knobs: fam.make(dict(knobs)), SeedCache())
        row[k] = {"knobs": knobs, "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
                  "mean_normalized": float(np.mean(fr.normalized)), "shares": newcomer_shares(fr.results, cell.focal)}
    return f"{j['context']}|{j['rule']}", row


def diagnostics(out, jobs: list[dict], workers: int = 1) -> dict:
    """Plan section 4 (draft 2): the base and the doubled winner of each churn cell rerun on the evaluation seeds under
    churn, with per-seed normalised profits and newcomer audit counts; and, per rule and winner, the age-bin shares pooled
    over markets with equal weights."""
    install()
    if workers <= 1 or len(jobs) <= 1:
        rows = [_diag_one(j, str(out)) for j in jobs]
    else:
        with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
            rows = list(ex.map(_diag_one, jobs, [str(out)] * len(jobs)))
    res = dict(rows); pooled = {}
    for rule in sorted({k.split("|")[1] for k in res}):
        for w in ("base", "doubled"):
            bm = {k.split("|")[0]: v[w]["shares"] for k, v in res.items() if k.split("|")[1] == rule}
            pooled[f"{rule}|{w}"] = {c: pool_markets(bm, c) for c in ("honest_replacement", "honest_initial", "focal")}
    return {"cells": res, "pooled": pooled}


GATE_CELL = ("fresh0", "F111")
"""Evaluation-2 numbers for the paper, generated from report.json (paper draft 9 outline, "Rules for the text").

--write flattens report.json into one LaTeX macro per path: the text writes \\rv{q4.k} or \\rv{q1.tests.C*-F111|D2+H3.estimate}.
--check fails when a path used in the text is not in the report, when numbers.tex is stale, or when a bare decimal
number (decimal, integer, or percentage, outside identifiers such as F111) appears between `% BEGIN-EV2` and `% END-EV2` (evaluation-2 result text must use macros)."""
from __future__ import annotations

import argparse
import json
import math
import re
import sys
from pathlib import Path

DIGITS = 3
BARE = re.compile(r"(?<![A-Za-z0-9_.])-?(?:\d+(?:\.\d+)?|\.\d+)%?")       # decimals, integers, percentages; not F111, X7-SC, D2+H3
# Stripped before the bare-number scan: \const{} (protocol constants, marked explicitly) and arguments of references.
EXEMPT = re.compile(r"_\{[0-9]+\}|_[0-9]|\\(?:const|evone)\{[^}]*\}|\\(?:ref|eqref|cite|citep|citet|label|input|include|includegraphics|url|href)(?:\[[^\]]*\])?\{[^}]*\}")
USE = re.compile(r"\\rv\{([^}]*)\}")
USEK = re.compile(r"\\rvk\{(\w+)\}\{([^}]*)\}")
SITE = re.compile(r"\\site\{([^}]*)\}")
SECTION = re.compile(r"\\section\*?\s*\{([^}]*)\}(?:\s*\\label\{sec:([^}]*)\})?")
FULL = ("abstract", "results")       # sections that must lie wholly inside result regions
NOBARE = REQUIRED = ("abstract", "intro", "results", "discussion", "conclusion")   # no unmarked number outside regions; captions likewise
LABEL = re.compile(r"\\label\{sec:([^}]*)\}")
COMMENT = re.compile(r"(?<!\\)%.*")
INPUT = re.compile(r"\\(?:input|include)\{([^}]*)\}")
P_LEAVES = {"p", "p_gain", "p_eff", "calibrated", "holm_adjusted", "calibrated_gain", "calibrated_eff"}
# Kinds for prose in result regions: the field name and the value type must fit the sentence's statistic.
COUNT_LEAVES = {"k", "fulfilled", "failed", "not assessed",           # Q4's k; the prediction tallies (score_v2.py)
                "positive", "n", "embedded_identical", "cells", "flagged", "checks", "over_threshold", "refs_with_any_reset",
                "negative", "incomplete_n"}    # churn follow-up (churn.json)    # Fable 5.2 review counts (posthoc)
KINDS = {"count": lambda leaf, v: leaf in COUNT_LEAVES and isinstance(v, int) and not isinstance(v, bool),
         "p": lambda leaf, v: leaf in P_LEAVES and isinstance(v, float) and 0 <= v <= 1,
         "gain": lambda leaf, v: leaf in {"estimate", "gain_diff", "gain_diff_lower", "attacker_gain", "0", "1", "q1_frozen", "q1_doubled",
                                          "q4_frozen", "q4_doubled", "mean_gain", "mean", "difference", "pooled", "max_shortfall", "fresh1", "max_change", "G_shift_pooled",
                                          "max_abs_replacement_value", "max_abs_validation_mean_diff"} and isinstance(v, float),
         "ratio": lambda leaf, v: leaf == "relative" and isinstance(v, float),
         "share_s": lambda leaf, v: leaf in {"value", "0", "1", "S_with_non_replacing_references"} and isinstance(v, float),   # reset follow-up S (not clipped); "0"/"1": the leave-one-out range
         "share": lambda leaf, v: leaf == "audited_share" and isinstance(v, float) and 0 <= v <= 1,
         "age_share": lambda leaf, v: leaf in {"share", "focal_newest_first_offer"} and isinstance(v, float) and 0 <= v <= 1,   # churn diagnostics
         "per_episode": lambda leaf, v: leaf == "honest_replacements_per_episode" and isinstance(v, float) and v >= 0,
         "eff": lambda leaf, v: leaf in {"eff", "eff_lower", "efficiency", "0", "1"} and isinstance(v, float),
         "label": lambda leaf, v: isinstance(v, str)}
HEADER = "% Generated by docs/revision/paper-v2/numbers_v2.py from report.json; do not edit.\n"
PREAMBLE = "\\providecommand{\\const}[1]{#1}\n\\providecommand{\\evone}[1]{#1}\n\\providecommand{\\rvk}[2]{\\rv{#2}}\n\\providecommand{\\site}[1]{\\ifcsname site@#1\\endcsname\\csname site@#1\\endcsname\\else\\textbf{??#1}\\fi}\n\\providecommand{\\rv}[1]{\\ifcsname rv@#1\\endcsname\\csname rv@#1\\endcsname\\else\\textbf{??#1}\\fi}\n"


def _fmt(v) -> str:
    if v is None:
        return "n/a"
    if isinstance(v, bool):
        return "yes" if v else "no"
    if isinstance(v, int):
        return str(v)
    if isinstance(v, float):
        if not math.isfinite(v):
            raise ValueError(f"nonfinite value in the report: {v}")
        s = f"{v:.{DIGITS}f}"
        return f"\\ensuremath{{{s}}}" if s.startswith("-") else s
    return re.sub(r"([&%$#_{}])", r"\\\1", str(v))


def _fmt_p(v) -> str:
    """p-values: four significant digits; small values in scientific form, so a nonzero p never prints as 0.000."""
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        return _fmt(v)
    if not math.isfinite(v):
        raise ValueError(f"nonfinite value in the report: {v}")
    s = f"{float(v):.4g}"
    if "e" in s:
        m, e = s.split("e")
        return f"\\ensuremath{{{m}\\times10^{{{int(e)}}}}}"
    return s


def flat(report, prefix: str = "") -> dict:
    """Report path to raw value."""
    out = {}
    items = report.items() if isinstance(report, dict) else enumerate(report)
    for k, v in items:
        path = f"{prefix}{k}"
        out.update(flat(v, path + ".")) if isinstance(v, (dict, list)) else out.__setitem__(path, v)
    return out


def _is_p(path: str) -> bool:
    parts = path.split(".")
    return parts[-1] in P_LEAVES or (len(parts) >= 2 and parts[-2] in P_LEAVES)


def macros(report: dict) -> dict:
    return {p: (_fmt_p(v) if _is_p(p) else _fmt(v)) for p, v in flat(report).items()}


def render(report: dict, sites: dict | None = None) -> str:
    m = macros(report)
    # With a site manifest the text uses only \\site{}, so only site macros are written (the full path list ran to
    # 219k lines and overflowed pdfLaTeX's string pool, 2026-11-05).
    lines = [] if sites is not None else [f"\\expandafter\\def\\csname rv@{p}\\endcsname{{{v}}}" for p, v in sorted(m.items())]
    lines += [f"\\expandafter\\def\\csname site@{n}\\endcsname{{{m.get(d['path'], '??' + n)}}}" for n, d in sorted((sites or {}).items())]
    return HEADER + PREAMBLE + "\n".join(lines) + "\n"


def _sites(path) -> dict | None:
    """The result-site manifest: site name -> {path, kind, section}; read from beside the given file when present."""
    f = Path(path).parent / "sites.json"
    return json.loads(f.read_text()) if f.exists() else None


def load(report_path, extra: dict | None = None) -> dict:
    """report.json at the top level; each extra source (name -> path: cells.json, scoring.json) under its own name."""
    data = json.loads(Path(report_path).read_text())
    for name, path in (extra or {}).items():
        if name in data:
            raise ValueError(f"extra source name {name} collides with a report key")
        data[name] = json.loads(Path(path).read_text())
    return data


def write(report_path, numbers_path, extra: dict | None = None) -> None:
    Path(numbers_path).write_text(render(load(report_path, extra), _sites(numbers_path)))


def _blocks(tex: str) -> tuple[list[str], list[str]]:
    blocks, problems, cur = [], [], None
    for n, line in enumerate(tex.splitlines(), 1):
        s = line.strip()
        if s == "% BEGIN-EV2":
            if cur is not None:
                problems.append(f"line {n}: nested BEGIN-EV2")
            cur = []
        elif s == "% END-EV2":
            if cur is None:
                problems.append(f"line {n}: END-EV2 without BEGIN-EV2")
            else:
                blocks.append("\n".join(cur)); cur = None
        elif cur is not None and not s.startswith("%"):
            cur.append(line)
    if cur is not None:
        problems.append("unclosed BEGIN-EV2 block")
    return blocks, problems


def strip_comments(text: str) -> str:
    """Remove LaTeX comments (a % after an even number of backslashes), keeping the region marker lines."""
    out = []
    for line in text.splitlines():
        if line.strip() in ("% BEGIN-EV2", "% END-EV2"):
            out.append(line.strip()); continue
        cut, i = len(line), 0
        while i < len(line):
            if line[i] == "%":
                k = i
                while k > 0 and line[k - 1] == "\\":
                    k -= 1
                if (i - k) % 2 == 0:
                    cut = i; break
            i += 1
        out.append(line[:cut])
    return "\n".join(out) + "\n"


def sources(tex_path, numbers_path=None) -> str:
    """The text with every \\input or \\include file inlined, except the generated numbers file and generated tables
    (checked by tables_v2.py --check)."""
    base = Path(tex_path).parent; skip = {Path(numbers_path).name} if numbers_path else set()
    def inline(m):
        name = m.group(1); f = base / (name if name.endswith(".tex") else name + ".tex")
        if f.name in skip or name.startswith("tables/") or not f.exists():
            return m.group(0)
        return sources(f, numbers_path)
    return INPUT.sub(inline, strip_comments(Path(tex_path).read_text()))      # comments first: a commented \\input is not followed


def _report_numbers(raw: dict) -> set:
    return {f"{v:.3f}" for v in raw.values() if isinstance(v, float) and not isinstance(v, bool) and math.isfinite(v)}


def check(report_path, numbers_path, tex_path, extra: dict | None = None) -> list[str]:
    report = load(report_path, extra); known = macros(report); raw = flat(report)
    tex = sources(tex_path, numbers_path); problems = []
    sites = _sites(tex_path)
    if not Path(numbers_path).exists() or Path(numbers_path).read_text() != render(report, sites):
        problems.append(f"{numbers_path}: stale or missing; run --write")
    used = set(USE.findall(tex)) | {p for _, p in USEK.findall(tex)}
    problems += [f"unknown report path in the text: {p}" for p in sorted(used) if p not in known]
    for kind, p in USEK.findall(tex):
        if kind not in KINDS:
            problems.append(f"unknown kind {kind} for {p}")
        elif p in raw and not KINDS[kind](p.split(".")[-1], raw[p]):
            problems.append(f"kind {kind} does not fit {p} (value {raw[p]!r})")
    blocks, bp = _blocks(tex); problems += bp
    for b in blocks:
        problems += [f"plain \\rv in an evaluation-2 block (use \\rvk with a kind): {p}" for p in USE.findall(b)]
        bare = BARE.findall(EXEMPT.sub("", USEK.sub("", USE.sub("", b))))
        problems += [f"bare number in an evaluation-2 block: {x}" for x in bare]
    outside = tex
    for b in blocks:
        outside = outside.replace(b, "")
    assert CB.expectations(r, diagnostics=_diag(na))["4"]["verdict"] == "unavailable"
    assert CB.expectations(r, diagnostics=None)["4"]["verdict"] == "unavailable"


def _full_diag(n=4, share_r3=0.6, markets=M6):
    """Consistent driver-shaped diagnostics: per-episode [served, audited] counts, bin totals, and the market-pooled shares."""
    cells, pooled = {}, {}
    for r in CB.RULES:
        for w in ("base", "doubled"):
            bins_by_m = {}
            for i, m in enumerate(markets):
                au = {"F111": round(10 * share_r3), "C*": 4, "F000": 2}[r] + (i % 2)
                per = [{c: [[10, au], [5, 1], [0, 0], [3, 0]] for c in ("honest_replacement", "honest_initial", "focal")} for _ in range(n)]
                sh = {}
                for c in ("honest_replacement", "honest_initial", "focal"):
                    rows = []
                    for b in range(4):
                        sv = sum(e[c][b][0] for e in per); a = sum(e[c][b][1] for e in per)
                        rows.append({"age": [0, 1], "served": sv, "audited": a, "share": (a / sv if sv else None)})
                    sh[c] = rows
                sh.update(per_episode=per, honest_replacements_per_episode=18.0, focal_newest_by_creation=[0.5] * n,
                          focal_newest_by_first_offer_assigned=[0.25] * n)
                cells.setdefault(f"{m}@rho0.2|{r}", {})[w] = {"seeds": list(range(n)), "shares": sh}
                bins_by_m[m] = sh
            pooled[f"{r}|{w}"] = {}
            for c in ("honest_replacement", "honest_initial", "focal"):
                res = []
                for b in range(4):
                    v = [bins_by_m[m][c][b]["share"] for m in markets if bins_by_m[m][c][b]["share"] is not None]
                    res.append({"share": (sum(v) / len(v) if v else None), "markets": len(v)})
                pooled[f"{r}|{w}"][c] = res
    return {"cells": cells, "pooled": pooled}


def test_validate_diagnostics_accepts_a_consistent_summary():
    CB.validate_diagnostics(_full_diag(), M6, n_seeds=4)


def test_validate_diagnostics_rejects_a_conflicting_pooled_share():
    d = _full_diag(); d["pooled"]["F111|base"]["honest_replacement"][0]["share"] += 0.01
    with pytest.raises(ValueError, match="pooled"):
        CB.validate_diagnostics(d, M6, n_seeds=4)


def test_validate_diagnostics_rejects_bin_totals_that_differ_from_the_episode_counts():
    d = _full_diag(); d["cells"]["fresh2@rho0.2|C*"]["doubled"]["shares"]["honest_replacement"][0]["audited"] += 1
    with pytest.raises(ValueError, match="per-episode"):
        CB.validate_diagnostics(d, M6, n_seeds=4)


def test_validate_diagnostics_rejects_a_missing_cell_or_episode():
    d = _full_diag(); del d["cells"]["fresh5@rho0.2|F000"]
    with pytest.raises(ValueError, match="missing"):
        CB.validate_diagnostics(d, M6, n_seeds=4)
    with pytest.raises(ValueError, match="episodes"):
        CB.validate_diagnostics(_full_diag(), M6, n_seeds=5)


def test_newest_share_averages_episode_shares_within_a_market_then_across_markets():
    """Sol r1: not one pooled fraction of rounds. Market fresh0 has episode shares 1, 0, 0 (one third), the others 1."""
    d = _full_diag(n=3)
    for m in M6:
        d["cells"][f"{m}@rho0.2|F111"]["base"]["shares"]["focal_newest_by_first_offer_assigned"] = [1.0, 1.0, 1.0]
    d["cells"]["fresh0@rho0.2|F111"]["base"]["shares"]["focal_newest_by_first_offer_assigned"] = [1.0, 0.0, None]
    s = CB.diag_summary(d)["F111|base"]
    assert s["focal_newest_first_offer"] == pytest.approx((0.5 + 5 * 1.0) / 6)       # None episodes are left out


def test_registered_values_are_reproduced_from_the_no_churn_records(tmp_path):
    """posthoc.json doubled.D2+H3: q1 = C* - R3, q4 = B3 - R3 (frozen = base, doubled); absolute mean gains of C* and R3."""
    r = CB.analyse(CB.load(*_tree(tmp_path, _gains()), markets=M6, n_seeds=40), b=99, seed=1)
    reg = {"pooled": {"q1_frozen": 0.02, "q1_doubled": 0.02, "q4_frozen": 0.17, "q4_doubled": 0.17},
           "absolute": {"C*": {"mean_gain": 0.08}, "F111": {"mean_gain": 0.06}}}
    chk = CB.registered_check(r, reg)
    assert chk["ok"] is True and chk["absolute_matches"] == ["base", "doubled"]
    bad = json.loads(json.dumps(reg)); bad["pooled"]["q4_doubled"] = 0.18
    assert CB.registered_check(r, bad)["ok"] is False


def test_cli_writes_the_result_with_input_hashes_and_a_table(tmp_path):
    ea, ch, rep = _tree(tmp_path, _gains(noise=0.01))
    for c in ("0.01", "0.05"):
        _write(ch / f"p{c}" / "diagnostics.json", _full_diag(n=40))
    out, tab = tmp_path / "churn.json", tmp_path / "tables"
    rc = CB.main(["--records", str(ea), "--churn", str(ch), "--report", str(rep), "--out", str(out), "--tables", str(tab),
                  "--n-seeds", "40", "--resamples", "99"])
    assert rc == 0
    res = json.loads(out.read_text())
    assert res["label"].startswith("exploratory follow-up") and len(res["inputs"]["report_sha256"]) == 64
    assert set(res["expectations"]) == {"1", "2", "3", "4"}
    t = (tab / "posthoc_churn.tex").read_text()

