def _scan(tex: str):
    """Per line of comment-free text: (section key, inside a result region, text), and problems. Every \\section needs
    a \\label{sec:...} on its line or the next; sec: labels elsewhere are refused and do not change the section."""
    sec, region, out, problems, pending = "front", False, [], [], None
    for line in tex.splitlines():
        s = line.strip()
        if s == "% BEGIN-EV2":
            region = True; continue
        if s == "% END-EV2":
            region = False; continue
        m = SECTION.search(line); lab = LABEL.search(line)
        if pending is not None and not m:
            if lab:
                sec = lab.group(1); lab = None
            elif s:                                        # blank lines keep the requirement pending
                problems.append(f"section without a \\label{{sec:...}}: {pending}"); sec = pending.lower()
            if s:
                pending = None
        if s.startswith("\\begin{abstract}"):
            sec = "abstract"
        elif m:
            if pending is not None:
                problems.append(f"section without a \\label{{sec:...}}: {pending}")
            if m.group(2):
                sec = m.group(2)
            else:
                pending = m.group(1).strip(); sec = pending.lower()
        elif lab:
            problems.append(f"sec: label outside a section heading: {lab.group(1)}")
        out.append((sec, region, line))
    if pending is not None:
        problems.append(f"section without a \\label{{sec:...}}: {pending}")
    return out, problems


def _captions(tex: str) -> list[tuple[bool, str]]:
    """Whole \\caption arguments (brace-matched across lines), each with whether it starts inside a result region."""
    region, spans, pos = False, [], 0
    for line in tex.splitlines(keepends=True):
        s = line.strip()
        if s == "% BEGIN-EV2":
            region = True
        elif s == "% END-EV2":
            region = False
        spans.append((pos, region)); pos += len(line)
    def inside(off):
        r = False
        for start, reg in spans:
            if start > off:
                break
            r = reg
        return r
    out = []
    for m in re.finditer(r"\\caption\s*(?:\[[^\]]*\]\s*)?\{", tex):
        depth, k = 1, m.end()
        while k < len(tex) and depth:
            depth += {"{": 1, "}": -1}.get(tex[k], 0) if tex[k - 1] != "\\" else 0; k += 1
        out.append((inside(m.start()), tex[m.end():k - 1]))
    return out


def _floats(tex: str) -> list[dict]:
    """Figure and table environments, line by line: each float's labels, its lines outside result regions, and whether
    it lies wholly inside one region. Works for one-line floats and for regions that end inside a float."""
    out, region, cur = [], False, None
    for line in tex.splitlines():
        s = line.strip()
        if s == "% BEGIN-EV2":
            region = True; continue
        if s == "% END-EV2":
            region = False
            if cur is not None:
                cur["whole"] = False
            continue
        if len(re.findall(r"\\(?:begin|end)\{(?:figure|table)\*?\}", line)) > 1:
            out.append({"labels": [], "outside": [], "whole": False, "layout": line.strip()[:80]})
        if cur is None and re.search(r"\\begin\{(figure|table)\*?\}", line):
            cur = {"labels": [], "outside": [], "whole": region}
        if cur is not None:
            cur["labels"] += re.findall(r"\\label\{([^}]*)\}", line)
            if not region:
                cur["outside"].append(line); cur["whole"] = False
            if re.search(r"\\end\{(figure|table)\*?\}", line):
                out.append(cur); cur = None
    return out


def _float_list(path) -> list | None:
    """floats.json beside the paper: the labels of every evaluation-2 table and figure (the source coverage list)."""
    f = Path(path).parent / "floats.json" if path else None
    return json.loads(f.read_text()) if f and f.exists() else None


def _site_checks(tex: str, sites: dict, raw: dict, known: dict, outside: str, tex_path_hint=None) -> list[str]:
    problems = []
    for n, d in sorted(sites.items()):
        if d.get("path") not in known:
            problems.append(f"site {n}: report path {d.get('path')} not in the report")
        elif d.get("kind") not in KINDS or not KINDS[d["kind"]](d["path"].split(".")[-1], raw[d["path"]]):
            problems.append(f"site {n}: kind {d.get('kind')} does not fit {d['path']}")
    seen = {}; scanned, sp = _scan(tex); problems += sp
    keys = {sec for sec, _, _ in scanned}
    problems += [f"required section {k} (\\label{{sec:{k}}}) not found" for k in REQUIRED if k not in keys]
    floats = _floats(tex); listed = _float_list(tex_path_hint)
    for f in floats:
        if f.get("layout"):
            problems.append(f"one float command per line (begin and end on separate lines): {f['layout']}"); continue
        body = "\n".join(f["outside"])
        if BARE.findall(EXEMPT.sub("", body)) or USE.search(body) or USEK.search(body) or SITE.search(body):
            problems.append(f"figure or table outside a result region holds a number or result macro: {' '.join(body.split())[:80]}")
    by_label = {lab: f for f in floats for lab in f["labels"]}
    for lab in listed or []:
        if lab not in by_label:
            problems.append(f"listed evaluation-2 float {lab} not found")
        elif not by_label[lab]["whole"]:
            problems.append(f"listed evaluation-2 float {lab} does not lie wholly inside one result region")
    for in_region, cap in _captions(tex):
        if not in_region and (BARE.findall(EXEMPT.sub("", cap)) or USE.search(cap) or USEK.search(cap) or SITE.search(cap)):
            problems.append(f"caption outside a result region holds a number or result macro: {' '.join(cap.split())[:80]}")
    for sec, region, line in scanned:
        for n in SITE.findall(line):
            seen.setdefault(n, []).append(sec)
            if n not in sites:
                problems.append(f"unknown site in the text: {n}")
            elif sec != sites[n]["section"]:
                problems.append(f"site {n} is in section {sec}, declared in section {sites[n]['section']}")
            if not region:
                problems.append(f"site {n} is outside a result region")
        if region and (USE.search(line) or USEK.search(line)):
