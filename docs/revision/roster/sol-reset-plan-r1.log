    32	def percentile_bootstrap(x, side: str, level: float, resamples: int, seed: int) -> Bound:
    33	    """One-sided percentile bootstrap of the mean; the seed is the resampling unit (spec 8)."""
    34	    x = _check(x, side, level); n = x.size
    35	    if np.all(x == x[0]):
    36	        return Bound(float(x[0]), side, level, "percentile", True, n)
    37	    rng = np.random.default_rng(int(seed))
    38	    idx = rng.integers(0, n, size=(int(resamples), n))
    39	    means = x[idx].mean(axis=1)
    40	    q = level if side == "upper" else 1.0 - level
    41	    return Bound(float(np.quantile(means, q)), side, level, "percentile", False, n)
    42	
    43	
    44	def studentized_bootstrap(x, side: str, level: float, resamples: int, seed: int) -> Bound:
    45	    """Bootstrap-t: each resample studentized by its own standard error; a zero-standard-error resample
    46	    uses the full-sample standard error (spec 8)."""
    47	    x = _check(x, side, level); n = x.size
    48	    mean = x.mean(); se = x.std(ddof=1) / np.sqrt(n)
    49	    if np.all(x == x[0]):                                        # exact constancy, not std == 0: ten copies of 1/3 have a nonzero float std
    50	        return Bound(float(x[0]), side, level, "studentized", True, n)
    51	    rng = np.random.default_rng(int(seed))
    52	    idx = rng.integers(0, n, size=(int(resamples), n))
    53	    samples = x[idx]
    54	    m = samples.mean(axis=1); s = samples.std(axis=1, ddof=1) / np.sqrt(n)
    55	    s = np.where(s > 0, s, se)
    56	    tstat = (m - mean) / s
    57	    if side == "upper":
    58	        return Bound(float(mean - np.quantile(tstat, 1.0 - level) * se), side, level, "studentized", False, n)
    59	    return Bound(float(mean - np.quantile(tstat, level) * se), side, level, "studentized", False, n)
    60	
    61	
    62	def t_bound(x, side: str, level: float) -> Bound:
    63	    """One-sided Student t bound on the mean (H1's 10 repetitions, spec 8)."""
    64	    x = _check(x, side, level); n = x.size
    65	    se = x.std(ddof=1) / np.sqrt(n)
    66	    crit = stats.t.ppf(level, n - 1)
    67	    degenerate = bool(np.all(x == x[0]))
    68	    value = float(x[0]) if degenerate else (x.mean() + crit * se if side == "upper" else x.mean() - crit * se)
    69	    return Bound(float(value), side, level, "t", degenerate, n)
    70	
    71	
    72	def exact_t_bound_with_critical(x, side: str, critical: float) -> float:
    73	    """A one-sided t-type bound at an arbitrary critical value (the coverage study's negative control)."""
    74	    x = np.asarray(x, dtype=float).ravel(); n = x.size
    75	    se = x.std(ddof=1) / np.sqrt(n)
    76	    return float(x.mean() + critical * se if side == "upper" else x.mean() - critical * se)
    77	
    78	
    79	def t_interval(x, level: float = 0.95) -> tuple[float, float]:
    80	    """Two-sided t interval on the mean (the reference-mean interval of the coverage study)."""
    81	    x = np.asarray(x, dtype=float).ravel(); n = x.size
    82	    se = x.std(ddof=1) / np.sqrt(n)
    83	    h = stats.t.ppf(0.5 + level / 2.0, n - 1) * se
    84	    return float(x.mean() - h), float(x.mean() + h)
