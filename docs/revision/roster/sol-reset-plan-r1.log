        E *= 2
    spec = rule_spec(rule, params)
    j = {"id": cell_id(mkt["context"], rule, family, objective, c, schedule), "context": mkt["context"], "rule": rule, "family": family,
         "objective": objective, "c": c, "schedule": schedule, "budget": [R, E, n_train, n_eval], "spec": spec, "mkt": mkt,
         "h4": h4 if family == "H4" else None}
    cell = _cells_by_id().get(j["id"].replace(j["context"], manifest_ctx(j["context"]), 1))
    j["block"] = block or (cell or {}).get("block"); j["priority"] = MAN.priority(cell) if cell else 3      # execution priority (design 8.2)
    j["provenance"] = context_provenance(mkt) | {"budget": j["budget"], "rule_params_sha256": _sha_json(spec), "id": j["id"]}
    if family == "H4" and h4:
        j["provenance"]["h4_sha256"] = str(h4["sha"])
    return j


def context_provenance(mkt: dict) -> dict:
    return {"git_commit": mkt.get("commit") or git_commit(), "runner_sha256": _sha(Path(__file__).read_bytes()), "cfg_sha256": _sha_json(cfg_to_dict(mkt["cfg"])),
            "salt_sha256": mkt.get("salt_sha256") or _sha(load_identity_salt()), "root": mkt["root"], "seeds_train": mkt["seeds_train"],
            "seeds_val": mkt["seeds_val"], "seeds_eval": mkt["seeds_eval"], "context": mkt["context"]}


def settings(job: dict) -> SearchSettings:
    R, E, _, _ = job["budget"]
    return replace(settings_from_locked(load_locked()), restarts=int(R), evals_per_restart=int(E))


def train_cell(job: dict, others: tuple = ()) -> Cell:
def stage_search(job: dict, out: Path) -> dict:
    T, L = constants(job); fam = family_for(job["family"], T, L, job.get("h4")); cache = SeedCache(); st = settings(job); cell = train_cell(job)
    upstream = {}
    if job["objective"] == "W0":
        extra, upstream = _welfare_extra(job, out, T)
        obj = WelfareObjective(cell, fam, cache)
        res = cma_search(obj, fam, st, 1, incumbents={"honest_point": fam.honest_point(), **extra})
        controls(obj, fam)
        best = max(obj.archive.values(), key=lambda e: e.f)
        return _welfare_record(obj, res, dict(best.knobs), upstream, T, L)
    tw = twin_search(cell, fam, cache, st, seed=0)
    extra = {}
    if job["family"] == "X7-SC":
        rid = _menu_id(job["context"], job["rule"], "D2+H3"); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"{job['id']}: needs {rid} first")
        extra["embedded_h3"] = embed_h3(rec["attack"]["best_knobs"], T); upstream[rid] = sha_file(path_of(out, rid))
    at = search_family(cell, fam, cache, st, tw, extra)
    obj = Objective(cell, fam, cache); obj.archive.update(at.archive)
    ctrl = controls(obj, fam)
    best_ctrl = max(ctrl, key=lambda kf: kf[1]) if ctrl else None
    at.archive.update(obj.archive)
    rec = {"twin": search_to_json(tw), "attack": search_to_json(at), "controls": [{"knobs": k, "f": f} for k, f in ctrl],
           "upstream": upstream, "T": T, "L": L, "runs": cache.runs}
    if best_ctrl is not None and best_ctrl[1] > at.best_f:
        rec["attack"]["best_knobs"], rec["attack"]["best_f"], rec["attack"]["best_source"] = dict(best_ctrl[0]), float(best_ctrl[1]), "control"
    return rec


def cand_to_json(c: Candidate, family: str | None, T: int, L: int) -> dict:
def stage_freeze(ctx: str, catalog: list[dict], out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    derived_records(ctx, catalog, out, cuts, h4_excluded)
    problems = check_complete(ctx, catalog, out, cuts, h4_excluded)
    if problems:
        raise SystemExit(f"freeze {ctx} refused: {problems[:5]}{' ...' if len(problems) > 5 else ''}")
    recs = [r.replace(manifest_ctx(ctx), ctx, 1) for r in MAN.required(manifest_ctx(ctx), cuts, h4_excluded)]
    rec = {"stage": "freeze", "context": ctx, "cuts": cuts, "h4_excluded": h4_excluded, "records": {r: sha_file(path_of(out, r)) for r in recs}}
    write(path_of(out, f"freeze/{ctx}"), rec)
    return rec


def accept(ctx: str, catalog: list[dict], out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    fr = read(path_of(out, f"freeze/{ctx}"))
    if fr is None:
        raise SystemExit(f"{ctx}: no freeze; evaluation refused")
    for r, sha in fr["records"].items():
        p = path_of(out, r)
        if not p.exists() or sha_file(p) != sha:
            raise SystemExit(f"{ctx}: {r} differs from the freeze; evaluation refused")
    problems = check_complete(ctx, catalog, out, cuts, h4_excluded)
    missing = [r.replace(manifest_ctx(ctx), ctx, 1) for r in MAN.required(manifest_ctx(ctx), cuts, h4_excluded)
               if r.replace(manifest_ctx(ctx), ctx, 1) not in fr["records"]]
    if problems or missing:
        raise SystemExit(f"{ctx}: freeze incomplete or stale; evaluation refused: {(problems + missing)[:5]}")
    return fr


# ---- evaluation --------------------------------------------------------------------------------------------------------

GAIN_FIELDS = ("gain", "eff_attack", "eff_ref", "net_eff_attack", "net_eff_ref", "profit_attack", "profit_ref", "audit_spend_attack", "sstar",
               "served_share_attack", "served_share_ref", "false_refund_focal_attack", "false_refund_others_attack",       # design draft 7, 9.3
               "false_refund_focal_ref", "false_refund_others_ref")
BASE_FIELDS = GAIN_FIELDS[:9]                       # the GainResult fields of the frozen evaluate_gain


def gain_fields(cell, fam, knobs: dict, cand, cache: SeedCache) -> dict:
    """The frozen evaluate_gain's fields plus the draft-7 fields computed from the same episodes (no extra episode).
    sim/cell.py and sim/reference.py are frozen, so the profiles' results are kept by rebinding the run_focal name that
    evaluate_gain looks up, for this call only (order attack, clipped, reference, honest); evaluation runs one job per
    process, never in threads."""
    import sim.reference as REF
    kept, orig = [], REF.run_focal

    def keep(c, pf, ca):
        fr = orig(c, pf, ca); kept.append(fr.results); return fr

    REF.run_focal = keep
    try:
        g = evaluate_gain(cell, fam, dict(knobs), cand, cache)
    finally:
        REF.run_focal = orig
    return {**{k: [float(v) for v in getattr(g, k)] for k in BASE_FIELDS}, **extras(kept[0], kept[2], cell.cfg, cell.focal)}


def stage_evaluate(job: dict, out: Path) -> dict:
    T, L = constants(job); cache = SeedCache(); m = job["mkt"]; cell = eval_cell(job)
    if job["objective"] == "diagnostic":                 # design 6.7: a fixed profile, no search, no reference
        return {"seeds": list(cell.seeds), **honest_replacement(m["cfg"], rule_factory(job), m["focal"], cell.seeds, cache)}
    rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); cand, _, _ = reference_of(job, out)
        return {"seeds": list(cell.seeds), **gain_fields(cell, fam, rec["attack"]["best_knobs"], cand, cache)}
    if job["objective"] in ("W0", "W1"):
        if rec["selected"] is None:
            return {"seeds": list(cell.seeds), "no_feasible_candidate": True}
        fam = family_for(job["family"], T, L); fr = run_focal(cell, lambda: fam.make(dict(rec["selected"])), cache)
        out_ = {"seeds": list(cell.seeds), "eff": gross_efficiency(fr.results).tolist(), "normalized": fr.normalized.tolist()}
        if job["objective"] == "W1":
            cand, _, _ = reference_of(job, out); ref = run_focal(cell, cand.policy_factory, cache)
            out_["constraint"] = (fr.normalized - ref.normalized).tolist()
        return out_
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}"))
    if job["objective"] == "min":
        win = read(path_of(out, f"coalition_select/{job['context']}/{_coalition_tag(job)}"))["winners"][job["id"]]["descriptor"]
    else:
        win = _desc(job, rec["selected"])
    rows = _rows_of(job, win, cell.seeds, cache); ref_rows = _rows_of(job, jrec["descriptor"], cell.seeds, cache)
    g = rows - ref_rows
    return {"seeds": list(cell.seeds), "member_gain": g.tolist(), "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min()),
            "winner": win, "reference": jrec["descriptor"]}


def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
        _, rrec, _ = reference_of(job, out)
        cands, fams, _ = menu(job, out, cuts, h4_excluded)
        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
    if job["objective"] in ("W0", "W1"):
        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
        continue_search(obj, fam, st, orig)
        sel_old = rec["selected"]
        old_eff = obj.extra[exact_key(sel_old)]["eff"] if sel_old is not None else None
        sel = select_w1(obj) if job["objective"] == "W1" else dict(max(obj.archive.values(), key=lambda e: e.f).knobs)
        new_eff = obj.extra[exact_key(sel)]["eff"] if sel is not None else None
        held = None
        if sel is not None:
            fr = run_focal(eval_cell(job), lambda: fam.make(dict(sel)), SeedCache())
            held = {"knobs": dict(sel), "seeds": list(eval_cell(job).seeds), "eff": gross_efficiency(fr.results).tolist()}
        return {**doubling_report("w1" if job["objective"] == "W1" else "welfare", {"eff": old_eff, "feasible": sel_old is not None},
                                  {"eff": new_eff, "feasible": sel is not None}), "heldout": held}
    m = job["mkt"]; fam = family_for(job["family"], T, L); orig = search_from_json(rec["coalition"])
    if job["objective"] == "total":
        obj = _coalition_objective(job, "total", np.zeros((len(_members(job)), len(m["seeds_train"]))), cache)
        new = continue_search(obj, fam, st, orig)
        return {**doubling_report("coalition", {"f": orig.best_f}, {"f": max(new.best_f, orig.best_f)}),
                "heldout": _coalition_heldout(job, _desc(job, new.best_knobs), out)}
    ctx, tag = job["context"], _coalition_tag(job)                  # G_min: every score against the final reference (design 6.3)
    ref = np.asarray(read(path_of(out, f"joint_reference/{ctx}/{tag}"))["member_normalized"])
    sel = read(path_of(out, f"coalition_select/{ctx}/{tag}"))["winners"][job["id"]]
    orig = rescore_min(orig, rec["rows"], ref)
    obj = _coalition_objective(job, "min", ref, cache)
    new = continue_search(obj, fam, st, orig)
    win, f = (_desc(job, new.best_knobs), new.best_f) if new.best_f > sel["score"] else (sel["descriptor"], sel["score"])   # step 6's winner stays in
    return {**doubling_report("coalition", {"f": sel["score"]}, {"f": f}), "heldout": _coalition_heldout(job, win, out)}


def _coalition_heldout(job: dict, desc: dict, out: Path) -> dict:
def build_jobs(markets: list[str], root: str, dev: bool, smoke: bool, params: dict | None, cuts: int, h4: dict | None, h4_excluded: bool,
               cfgs: dict | None = None, commit: str | None = None, salt_sha256: str | None = None) -> list[dict]:
    jobs = []
    for label in markets:
        for rho in sorted({c["rho"] for c in MAN.effective(cuts, h4_excluded)}):
            mctx = MAN.context("fresh0" if label.startswith("dev") else label, rho)
            cs = [c for c in MAN.effective(cuts, h4_excluded) if c["context"] == mctx]
            if not cs:
                continue
            cfg = (cfgs or {}).get(label) if rho == 0.2 else None
            mkt = market(label, root, rho, dev=dev, smoke=smoke, cfg=cfg, commit=commit, salt_sha256=salt_sha256)
            for c in cs:
                jobs.append(job(mkt, c["rule"], c["family"], c["objective"], c["c"], c["schedule"], smoke, params, h4, block=c["block"]))
    return jobs


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--stage", required=True, choices=STAGES); ap.add_argument("--select", default="*"); ap.add_argument("--out", required=True)
    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--dev", action="store_true"); ap.add_argument("--smoke", action="store_true")
    ap.add_argument("--root", default=None); ap.add_argument("--h4", default=None); ap.add_argument("--h4-sha", dest="h4_sha", default=None)
    ap.add_argument("--params", default=None); ap.add_argument("--cuts", type=int, default=0); ap.add_argument("--markets", default=None)
    ap.add_argument("--h4-decision", dest="h4_decision", default=None, help="results/v2/draw/h4.json: the one recorded H4 decision")
    ap.add_argument("--commit", default=None, help="verify: the expected commit (git rev-parse protocol-v2^{commit})")
    ap.add_argument("--instances", default=None, help="verify: results/v2/draw/instances.json"); ap.add_argument("--protocol", default=None)
    a = ap.parse_args(argv); out = Path(a.out); verifying = a.stage == "verify"
    if verifying and not out.is_dir():
        raise SystemExit(f"verify reads an existing --out; {out} is not a directory")
    if not a.dev and not a.root:
        raise SystemExit("a fresh run needs --root (the block hash); use --dev for development markets")
    if not a.dev and not a.h4_decision:
        raise SystemExit("a fresh run needs --h4-decision (the recorded H4 decision)")
    if not a.dev and not a.protocol:
        raise SystemExit("a fresh run needs --protocol (experiments/protocol-v2.yaml), to check the H4 decision against it")
    decision = json.loads(Path(a.h4_decision).read_text()) if a.h4_decision else None
    if decision is not None and a.protocol:
        reg = ((__import__("yaml").safe_load(Path(a.protocol).read_text()) or {}).get("h4") or {}).get("bundle_sha256")
        if "registered_sha256" not in decision or decision["registered_sha256"] != reg or (decision.get("loaded") and decision.get("bundle_sha256") != reg):
            raise SystemExit(f"the H4 decision does not match the protocol's registered bundle {reg!r}")
    params = json.loads(Path(a.params).read_text()) if a.params else None
    root = DEV_ROOT if a.dev else a.root
    markets = (a.markets or ("dev0,dev1" if a.dev else ",".join(MAN.doc()["markets"]))).split(",")
    cfgs = commit = salt = None
    if verifying:
        if not a.commit:
            raise SystemExit("verify needs --commit")
        if not (a.instances and a.protocol):
            raise SystemExit("verify needs --instances and --protocol in every mode (it builds jobs from recorded inputs only)")
        commit = a.commit
        if decision is not None:                                   # the recorded identity only; the bundle is not loaded
            h4 = {"dir": None, "sha": decision["bundle_sha256"]} if decision.get("loaded") else None; h4_excluded = not decision.get("loaded")
        else:
            h4, h4_excluded = None, True
        if a.instances:
            inst = json.loads(Path(a.instances).read_text()); salt = inst["salt_sha256"]
            from sim.records import cfg_from_dict
            cfgs = {k: cfg_from_dict(v["calibrated_cfg"]) for k, v in inst.get("markets", {}).items()}
            absent = [m for m in markets if m != "headline" and m not in cfgs]
            if absent or not inst.get("salt_sha256"):
                raise SystemExit(f"instances.json lacks the recorded configuration of {absent} or the salt hash; verify never calibrates")
        else:
            inst = None
    else:
        out.mkdir(parents=True, exist_ok=True)
        if not a.dev:
            install_salt(root, out)
        if decision is not None:
            h4, h4_excluded = resolve_h4(decision, a.h4, a.h4_sha)
        else:
            h4 = {"dir": a.h4, "sha": a.h4_sha} if a.h4 else None
            h4_excluded = h4 is None or isinstance(_h4(a.h4, a.h4_sha), Excluded)
            if h4 is not None and h4_excluded:
                write(out / "h4_excluded.json", {"reason": _h4(a.h4, a.h4_sha).reason})
    patterns = a.select.split(",")
    try:
        jobs = build_jobs(markets, root, a.dev, a.smoke, params, a.cuts, h4, h4_excluded, cfgs, commit, salt)
    except SystemExit as e:
        if a.select == "*" or verifying:
            raise
        print(f"note: {e}", file=sys.stderr); jobs = []
    catalog = jobs
    jobs = [j for j in jobs if any(fnmatch.fnmatchcase(j["id"], p) for p in patterns)] if a.select != "*" else jobs
    if verifying:
        protocol = __import__("yaml").safe_load(Path(a.protocol).read_text()) if a.protocol else None
        rep = verify(out, catalog, jobs, inst, protocol, decision, a.cuts, h4_excluded)

