     1	from __future__ import annotations
     2	
     3	from ..mechanisms.base import Offer
     4	from .base import Action, ProviderView
     5	
     6	
     7	class AdaptiveCheat:
     8	    """D2 (spec 5.3). Markup state m_t: m_1 = m0; after a failed audit
     9	    m <- m (1 - d); otherwise m <- min(m0, m + r m0); unchanged during a ban.
    10	    One instance per entity per episode."""
    11	    name = "adaptive_cheat"
    12	
    13	    def __init__(self, u0: float, m0: float, s: float, d: float, r: float, w: float, clip: int) -> None:
    14	        if not (0.0 <= u0 <= 1.0 and 0.0 <= m0 <= 1.0 and 0.0 <= s <= 0.3 and 0.0 <= d <= 1.0
    15	                and 0.0 <= r <= 0.2 and 0.0 <= w <= 2.0):
    16	            raise ValueError("D2 knob outside its domain")
    17	        if isinstance(clip, bool) or clip not in (0, 1) or int(clip) != clip:
    18	            raise ValueError("clip must be exactly 0 or 1")
    19	        self.u0, self.m0, self.s, self.d, self.r, self.w, self.clip = float(u0), float(m0), float(s), float(d), float(r), float(w), int(clip)
    20	        self.m = float(m0)
    21	        self._last_t: int | None = None
    22	
    23	    def _update_state(self, view: ProviderView) -> None:
    24	        # Apply the recurrence once per round, using what happened last round.
    25	        if self._last_t is not None and view.t > self._last_t and view.history.failed:
    26	            banned_last = bool(view.history.banned_until) and view.history.banned_until[-1] > view.t - 1
    27	            if view.history.failed[-1] > 0:
    28	                self.m *= (1.0 - self.d)
    29	            elif banned_last:
    30	                pass   # banned and not audited last round: state unchanged
    31	            else:
    32	                self.m = min(self.m0, self.m + self.r * self.m0)
    33	        self._last_t = view.t
    34	
    35	    def act(self, view: ProviderView) -> Action:
    36	        self._update_state(view)
    37	        p = view.params
    38	        effort = p.q_max * (1.0 - self.u0)
    39	        claim = min(1.0, max(0.0, effort + self.m - self.s))
    40	        if self.clip:
    41	            claim = min(claim, effort)
    42	        return Action(effort=effort, offer=Offer(claim=claim, bid=(1.0 + self.w) * (p.a + p.b * effort)))

