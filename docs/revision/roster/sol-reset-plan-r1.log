    90	    if method == "studentized":
    91	        return studentized_bootstrap(x, side, level, int(settings["bootstrap_resamples"]), int(settings["bootstrap_seed"]))
    92	    if method == "t":
    93	        return t_bound(x, side, level)
    94	    raise ValueError(f"unknown interval method {method!r}")
