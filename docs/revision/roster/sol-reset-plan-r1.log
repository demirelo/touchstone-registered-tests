     1	from __future__ import annotations
     2	
     3	from dataclasses import replace
     4	
     5	from .base import Action, ProviderView
     6	
     7	
     8	class IdentityReplacement:
     9	    """H3 (spec 6.2): behave like the wrapped policy, and exit in the round
    10	    after a failed audit so the entity re-enters under a fresh identity in that
    11	    round (exits take effect when made, Task 2)."""
    12	
    13	    def __init__(self, policy) -> None:
    14	        self.policy = policy
    15	        self.name = f"h3({getattr(policy, 'name', 'policy')})"
    16	
    17	    def act(self, view: ProviderView) -> Action:
    18	        a = self.policy.act(view)
    19	        failed_last = bool(view.history.failed) and view.history.failed[-1] > 0
    20	        return Action(effort=a.effort, offer=a.offer, exit=a.exit or failed_last)
    21	
    22	
    23	def h3_family(family):
    24	    """The family with one more binary knob x: x = 1 wraps the policy in IdentityReplacement,
    25	    x = 0 leaves it unwrapped, so the honest point (x = 0, clip = 1) is honest-max."""
    26	    base_factory = family.factory
    27	
    28	    def factory(**k):
    29	        k = dict(k); x = int(k.pop("x"))
    30	        p = base_factory(**k)
    31	        return IdentityReplacement(p) if x else p
    32	    knobs = tuple(n for n in family.knobs if n != "clip") + ("x", "clip")
    33	    return replace(family, name=f"{family.name}+H3", knobs=knobs, factory=factory)

