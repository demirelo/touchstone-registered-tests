FIELDS = ("gain", "profit_attack", "profit_ref", "sstar", "eff_attack")


def _n_agents(job: dict) -> int:
    cfg = job["mkt"]["cfg"]
    return int(cfg["N"] if isinstance(cfg, dict) else cfg.N)


def _valid_held(h, seeds) -> bool:
    """Finite per-seed values on the ordered seeds, and a positive normalizer S* on every seed (terms_of divides by it;
    review rep-impl-r3)."""
    return isinstance(h, dict) and isinstance(h.get("seeds"), list) and h["seeds"] == list(seeds) and \
        all(_finite(h.get(f)) and len(h[f]) == len(seeds) for f in FIELDS) and all(x > 0 for x in h["sstar"])


def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
    import revision_v2 as R
    from sim.records_v2 import sha_file
    up = rec.get("upstream")
    if not isinstance(up, dict) or set(up) != set(want):
        return "dependency set differs"
    for u, h in up.items():
        q = R.path_of(d, u)
        if not q.is_file() or sha_file(q) != h:
            return f"dependency hash differs: {u}"
    return None


@_checked
def base_problem(d: Path, job: dict, ev, db) -> str | None:
    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
    its flag equals the frozen rule (revision_v2.doubling_report)."""
    import revision_v2 as R
    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
    if ev is None:
        return "no evaluation record"
    if ev.get("stage") != "evaluate" or ev.get("id") != job["id"] or ev.get("provenance") != job["provenance"]:
        return "evaluation record of another stage, cell or run"
    if not _valid_held(ev, seeds):
        return "evaluation values nonfinite or on other seeds"
    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
        return "evaluation: " + x
    if db is None:
        return "no doubling record"
    if db.get("stage") != "doubling" or db.get("id") != job["id"] or db.get("provenance") != job["provenance"] or db.get("kind") != "profit":
        return "doubling record of another stage, cell, run or kind"
    ch = [db.get("attack_change"), db.get("reference_change")]
    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
        return "doubling changes nonfinite or flag missing"
    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
        return "doubling flag differs from its changes"
    h = db.get("heldout")
    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
        return "doubling held-out result missing, nonfinite or on other seeds"
    ref = read_record(R.path_of(d, rid))
    if ref is None or not isinstance(ref.get("upstream"), dict):
        return "no reference record"
    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
        return "doubling: " + x
    return None


def _n_bins() -> int:
    from churn_v2 import AGE_EDGES
    return len(AGE_EDGES) - 1


def _shares_ok(sh, n_episodes: int) -> bool:
    """Newcomer audit counts (churn_v2.newcomer_shares): one episode per evaluation seed, each with the prescribed number
    of age bins of [served, audited], finite and nonnegative, audited at most served (review rep-impl-r3)."""
    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
    if not isinstance(per, list) or len(per) != n_episodes:
        return False
    nb = _n_bins()
    for e in per:
        f = e.get("focal") if isinstance(e, dict) else None
        if not isinstance(f, list) or len(f) != nb:
            return False
        for b in f:
            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
                return False
    return True


def diag_ok(row, seeds, knobs) -> bool:
    """A diagnostics row (frozen: diagnostics.json cells[...]["base"]; continued: its own record) for this winner: its
    knobs, the job's ordered evaluation seeds, finite per-seed profits and well-formed audit counts (review rep-impl-r2)."""
    return isinstance(row, dict) and row.get("knobs") == knobs and list(row.get("seeds") or []) == list(seeds) and \
        _finite(row.get("normalized")) and len(row["normalized"]) == len(seeds) and _shares_ok(row.get("shares"), len(seeds))


BINDING = "diagnostics_binding.json"


def diagnostics_binding(d: Path, kind: str, p: float, jobs: list) -> dict:
    """Written by rep_v2's rate stage right after the diagnostics step and before the inventory (review rep-impl-r3): the
    sha256 of diagnostics.json, the rate, and per cell the job id, its provenance (this run's commit, draw and salt) and
    the hashes of the search and doubling records whose winners the diagnostics reran."""
    import revision_v2 as R
    from sim.records_v2 import sha_file
    d = Path(d); h = lambda q: sha_file(q) if q.is_file() else None
    return {"stage": "diagnostics binding", "kind": kind, "rate": float(p), "diagnostics": h(d / "diagnostics.json"),
            "cells": {f"{j['context']}|{j['rule']}": {"id": j["id"], "provenance": j["provenance"], "search": h(R.path_of(d, j["id"])),
                                                       "doubling": h(d / "doubling" / (R._safe(j["id"]) + ".json"))} for j in jobs}}


def diag_bound(d: Path, kind: str, p: float, ck: str, job: dict) -> bool:
    """The frozen diagnostics of cell `ck` belong to this job, rate and run: the binding names this rate, the current
    diagnostics.json, this job's id and provenance, and the current search and doubling records."""
    import revision_v2 as R
    from sim.records_v2 import sha_file
    b = read_record(Path(d) / BINDING); c = ((b or {}).get("cells") or {}).get(ck)
    q = Path(d) / "diagnostics.json"
    return isinstance(c, dict) and b.get("stage") == "diagnostics binding" and b.get("kind") == kind and b.get("rate") == float(p) and \
        q.is_file() and b.get("diagnostics") == sha_file(q) and c.get("id") == job["id"] and c.get("provenance") == job["provenance"] and \
        R.path_of(d, job["id"]).is_file() and c.get("search") == sha_file(R.path_of(d, job["id"])) and \
        c.get("doubling") == sha_file(Path(d) / "doubling" / (R._safe(job["id"]) + ".json"))


def cont_diag_ok(rec, key: str, job: dict, knobs) -> bool:
    return isinstance(rec, dict) and rec.get("stage") == "continued diagnostics" and rec.get("id") == key and \
        rec.get("provenance") == job["provenance"] and diag_ok(rec, job["mkt"]["seeds_eval"], knobs)


def terms_of(h: dict, n: int) -> dict:
    """Per seed: gain = attack term - reference term, each normalised by S*/N (sim/reference.evaluate_gain)."""
    sc = [x / n for x in h["sstar"]]
    return {"gain": list(h["gain"]), "attack": [a / s for a, s in zip(h["profit_attack"], sc)],
            "reference": [r / s for r, s in zip(h["profit_ref"], sc)], "eff_attack": list(h["eff_attack"]), "seeds": list(h["seeds"])}


def _audit_of(shares: dict) -> tuple:
    per = shares["per_episode"]
    fo = [sum(e["focal"][b][i] for e in per for b in range(len(e["focal"]))) for i in (0, 1)]
    return fo[1], fo[0]                                                   # (audited, served)


def collect(base: Path, jobs_by_dir: dict, gate: dict | None, smoke: bool = False) -> dict:
    """Records for both winner sets (recs[rate][market][rule] with gains, attack and reference terms, efficiency and
    seeds), R3's audit counts for both sets, and the winner counts. Every record is checked before use (review
    rep-impl-r2): a cell whose evaluation or doubling record fails base_problem is unscorable (plan section 4); a frozen
    diagnostics row that fails diag_ok gives no audit count. Only flagged cells look at a continuation record; a flagged
    cell without one is "not continued". The primary set is unavailable after a round-1 mismatch in any continuation
    record or without this run's identical gate record (also when no cell is flagged). A flagged cell whose continuation
    record fails cont_problem keeps its validated frozen winner and counts as not continued (plan section 4; review
    rep-impl-r3). A frozen R3 audit count needs diagnostics bound to this job, rate and run (diag_bound) and complete
    (diag_ok); a continued R3 winner's audit count needs its checked continued diagnostics."""
    import convergence_v2  # noqa: F401
    import revision_v2 as R
    base = Path(base); cdir = base / "continuation"
    allrec = [read_record(q) for q in sorted(cdir.glob("*.json")) + sorted((cdir / "gate").glob("*.json")) if q.name != "lost_cells.json"]
    mismatch = any(_mismatch(r) for r in allrec)
    g = read_record(cdir / "gate" / (R._safe(gate["id"]) + ".json")) if gate else None
    gdb = doubling_of(gate.get("dir") or base / "menu-p0.05", gate["job"]["id"]) if gate else None
    gate_ok = g is not None and cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=gdb) is None and \
        g.get("status") in STATUSES[:2] and (identical(g) or (smoke and g.get("round1_gate") == SMOKE_GATE))
    frozen, primary, problems, unscorable = {}, {}, [], []
    counts = {"frozen": 0, "continued": 0, "unresolved": 0, "stopped": 0, "not continued": 0}
    audit = {"frozen": {}, "primary": {}}
    for (kind, p), jobs in jobs_by_dir.items():
        rk = "0" if p == 0 else f"{p:g}"; d = base / f"{kind}-p{p:g}"
        diag = (read_record(d / "diagnostics.json") or {}).get("cells") or {} if kind == "menu" else {}
        for j in jobs:
            m, r = j["mkt"]["label"].replace("fresh", "rep"), analysis_rule(kind, j["rule"])
            ev = read_record(R.eval_path(d, j["id"])); db = read_record(d / "doubling" / (R._safe(j["id"]) + ".json"))
            seeds = j["mkt"]["seeds_eval"]
            if (why := base_problem(d, j, ev, db)) is not None:
                unscorable.append(f"{kind}-p{p:g}|{j['id']}: {why}"); continue
            n = _n_agents(j); fz = terms_of(ev, n)
            frozen.setdefault(rk, {}).setdefault(m, {})[r] = fz
            fa = None
            if r == "R3" and kind == "menu":
                ck = f"{j['context']}|{j['rule']}"
                row = (diag.get(ck) or {}).get("base")
                sr = read_record(R.path_of(d, j["id"])) or {}
                if diag_bound(d, kind, p, ck, j) and diag_ok(row, seeds, (sr.get("attack") or {}).get("best_knobs")):
                    fa = _audit_of(row["shares"]); audit["frozen"].setdefault(rk, {})[m] = fa
                elif ck in diag:
                    problems.append(f"{kind}-p{p:g}|{j['id']}: frozen diagnostics fail their checks")
            win, kw, crec = fz, "frozen", None
            key = _key(kind, p, j["id"])
            if db["incomplete"]:
                crec = read_record(cdir / (R._safe(key) + ".json"))
                if crec is None:
                    kw = "not continued"
                elif (why := cont_problem(crec, key, j, smoke, doubling=db)) is not None:   # plan section 4: invalid output keeps
                    problems.append(f"{key}: {why}"); kw = "not continued"     # the validated frozen winner
                else:
                    try:
                        _, kw = select_winner(fz["gain"], crec)
                    except Round1Mismatch:
                        kw = "frozen"
                    if kw in ("continued", "unresolved"):
                        win = terms_of(crec["heldout"], n)
            counts[kw] += 1
            primary.setdefault(rk, {}).setdefault(m, {})[r] = win
            if r == "R3" and kind == "menu":                # review rep-impl-r4: the primary count comes from the primary
                if kw in ("continued", "unresolved"):           # winner's own diagnostics; frozen ones only for a frozen winner
                    cd = read_record(cdir / "diagnostics" / (R._safe(key) + ".json"))
                    if cont_diag_ok(cd, key, j, crec["heldout"]["knobs"]):
                        audit["primary"].setdefault(rk, {})[m] = _audit_of(cd["shares"])
                    elif cd is not None:
                        problems.append(f"{key}: continued diagnostics fail their checks")
                elif fa is not None:
                    audit["primary"].setdefault(rk, {})[m] = fa
    if not gate_ok:
        problems.append("no identical gate record of this run's gate cell")
    bad = mismatch or not gate_ok
    return {"frozen": frozen, "primary": None if bad else primary, "audit": audit, "counts": counts,
            "round1_mismatch": mismatch, "gate_ok": gate_ok, "problems": problems, "unscorable": unscorable}


def _diag_cont(job: dict, knobs: dict) -> dict:
    """In a worker: the churn arm's diagnostic run (churn_v2._diag_one) for a continued winner's knobs on the evaluation
    seeds under the cell's churn: per-seed normalised profits and newcomer audit counts (plan section 3, expectation 5
    on the primary winners)."""
    import churn_v2
    import numpy as np
    import revision_v2 as R
    from sim.cell import SeedCache, run_focal
    churn_v2.install()
    T, L = R.constants(job); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(job)
    fr = run_focal(cell, lambda: fam.make(dict(knobs)), SeedCache())
    return {"stage": "continued diagnostics", "provenance": job["provenance"], "knobs": dict(knobs),
            "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
            "mean_normalized": float(np.mean(fr.normalized)), "shares": churn_v2.newcomer_shares(fr.results, cell.focal)}


def run_diagnostics(base: Path, jobs_by_dir: dict, workers: int, smoke: bool = False) -> dict:
    """The diagnostics of R3's continued winners (menu cells at p = 0 and 0.05 whose continuation passed or reached the
    cap) in Run B's pool; records under continuation/diagnostics/, reused on resume when bound to the same job."""
    import convergence_v2  # noqa: F401
    import revision_v2 as R
    cdir = Path(base) / "continuation"; todo, args, dests, extras = [], [], [], []
    for (kind, p), jobs in jobs_by_dir.items():
        if kind != "menu" or p not in (0.0, 0.05):
            continue
        for j in jobs:
            if j["rule"] != "F111":
                continue
            key = _key(kind, p, j["id"]); crec = read_record(cdir / (R._safe(key) + ".json"))
            d = Path(base) / f"{kind}-p{p:g}"
            if crec is None or cont_problem(crec, key, j, smoke, doubling=doubling_of(d, j["id"])) is not None or crec["status"] not in STATUSES[:2]:
                continue
            dest = cdir / "diagnostics" / (R._safe(key) + ".json"); old = read_record(dest)
            if cont_diag_ok(old, key, j, crec["heldout"]["knobs"]):
                continue
            _set_aside(cdir / "diagnostics", dest)              # a stale or foreign record is rerun, never reused
            todo.append({"id": key}); args.append((j, crec["heldout"]["knobs"])); dests.append(dest); extras.append({"id": key})
    lost, failed = ([], {}) if not todo else run_cells(_diag_cont, todo, args, workers, dests, extras)
            "plan": h(HERE / "convergence-plan.md"), "report": h(report), "posthoc": h(posthoc), "registered_doubling": h(registered_doubling),
            "embedded_incumbent": G.sha_json(embedded) if embedded is not None else None}


def round1_agrees(r1: dict, registered: dict, tol: float = 1e-9) -> bool:
    return all(abs(r1[k] - registered[k]) <= tol for k in ("attack_change", "reference_change"))


def job_for(rid: str, root: str, cfgs: dict, params: dict, salt: str, smoke: bool) -> dict:
    ctx, rule, fam, _ = rid.split("|"); label = ctx.split("@")[0]
    mkt = R.market(label, root, 0.2, smoke=smoke, cfg=cfgs.get(label), salt_sha256=salt)
    return R.job(mkt, rule, fam, "profit", smoke=smoke, params=params)


def cell_inputs(src, job: dict) -> dict:
    need = F.inputs(src, [job]); p = R.path_of(src, job["id"])
    fr = read(R.path_of(src, f"freeze/{job['context']}"))
    if job["id"] not in fr["records"] or fr["records"][job["id"]] != sha_file(p):
        _refuse(f"{job['id']}: its search record differs from the original freeze")
    need[job["id"]] = fr["records"][job["id"]]
    for u, s in (read(p).get("upstream") or {}).items():
        if need.setdefault(u, s) != s:
            _refuse(f"{u}: two original records hold different hashes")
    return need


CLAIM = ("a cell that passes 'passed the registered incremental check within three rounds' (a capped search extension "
         "of R restarts per round); this is not convergence, not optimality, and not a bound on the remaining search error")
DEVIATIONS = ("continued searches of the 14 flagged profit cells and of the X7-SC cells with a nesting shortfall of at least 0.005, "
              "beyond the registered doubling, up to three rounds of R restarts",
              "from round 2 a nesting cell's X7-SC search also starts from the doubled D2+H3 winner embedded in X7-SC, and such a cell runs at least two rounds",
              "the final winner is evaluated against the unchanged frozen reference; reselected references are diagnostics only",
              "unflagged cells, frozen banks and X7-SC's original D2+H3 incumbents are unchanged; the 7 flagged coalition cells and "
              "the unchecked fresh factorial cells are not in this run", "exploratory sensitivity after the report; the frozen estimates stay primary")
KNOB_TOL, VAL_TOL = 1e-9, 1e-9


def compare_round1(registered: dict, r1: dict) -> dict:
    """Round 1 against the registered doubling record: exact on the seeds and discrete held-out knobs; 1e-9 on the
    continuous knobs, both changes and the held-out gains; every value finite."""
    problems = []
    ha, hb = registered["heldout"], r1["heldout"]
    if not G.finite(ha["gain"], hb["gain"], hb["knobs"], [r1["attack_change"], r1["reference_change"]]):
        problems.append("nonfinite value")
    if ha["seeds"] != hb["seeds"]:
        problems.append("seeds differ")
    ka, kb = ha["knobs"], hb["knobs"]; disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
    if set(ka) != set(kb) or any(ka[k] != kb[k] for k in disc):
        problems.append("discrete knob differs")
    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
    chg = max(abs(registered[k] - r1[k]) for k in ("attack_change", "reference_change"))
    gd = max((abs(x - y) for x, y in zip(ha["gain"], hb["gain"])), default=0.0) if len(ha["gain"]) == len(hb["gain"]) else float("inf")
    if not (rel <= KNOB_TOL and chg <= VAL_TOL and gd <= VAL_TOL):
        problems.append(f"tolerance exceeded (knobs {rel:.3g}, changes {chg:.3g}, gains {gd:.3g})")
    return {"pass": not problems, "max_knob_rel": rel, "max_change_abs": chg, "max_gain_abs": gd, "problems": problems}


def decide(k: int, last: dict, gate: dict | None, cost_ok: bool, max_rounds: int = MAX_ROUNDS, min_rounds: int = 1) -> str:
    """After round k: stop on a round-1 mismatch, on a pass (from round `min_rounds`), at the round cap, or (before the
    next round) at the cost cap."""
    if k == 1 and gate is not None and not gate["pass"]:
        return "round-1 mismatch"
    if k >= min_rounds and _passes(last):
        return "passed"
    if k >= max_rounds:
        return "round cap"
    return "continue" if cost_ok else "cost cap"


GATE_CELLS = ("headline@rho0.2|F111|X7-SC|profit", "fresh1@rho0.2|F111|D2+H3|profit")


def check_run_evidence(paths, smoke: bool, gate: bool, cells: dict) -> None:
    """A full run needs, for each gate cell, a passing full-budget gate record from the Mac and one from this machine,
    bound to the cell's current inputs and this driver."""
    if smoke or gate:
        return
    if not paths:
        _refuse("no reproduction evidence given for a full run")
    G.check_gate_evidence(paths, cells)


def merge_inputs(needs: list[dict]) -> dict:
    merged = {}
    for n in needs:
        for k, v in n.items():
            if merged.setdefault(k, v) != v:
                _refuse(f"{k}: two cells list different hashes")
    return merged


def worker_cost_args(stop) -> tuple:
    """The arguments a worker uses to rebuild the validated cost stop: the same cap, rate, accounting start (the recorded
    open event), prior spend, STOP file and soft deadline."""
    import time as _t
    return (stop.cap, stop.rate, stop.started, _t.time, stop.prior, str(stop.stop_file) if stop.stop_file else None, stop.soft)


def run_cell(job: dict, out, max_rounds: int = MAX_ROUNDS, src=None, cost: tuple | None = None, round_hours: float = 0.0,
             embedded: dict | None = None, min_rounds: int = 1, reference=None) -> dict:
    from sim.cell import SeedCache
    from sim.locked import load_locked
    from sim.records import search_from_json
    from sim.reference import reference_candidates, select_reference
    from sim.search import Objective, cma_search
    T, L = R.constants(job); fam = R.family_for(job["family"], T, L); cell = R.train_cell(job); st = R.settings(job); cache = SeedCache()
    rec = read(R.path_of(out, job["id"])); prev = search_from_json(rec["attack"]); twin = search_from_json(rec["twin"])
    frozen_ref, rrec, _ = R.reference_of(job, out); prev_ref = float(np.mean(rrec["per_seed_normalized"]))
    cands, _, _ = R.menu(job, out, CUTS, H4_EXCLUDED); order = tuple(load_locked()["reference_order"])
    stopper = G.CostStop(*cost) if cost else None
    emb = R.embed_h3(embedded, T) if embedded is not None else None
    rounds, gate, outcome = [], None, "round cap"
    if stopper and not stopper.allow("round 1", round_hours):           # admission before the cell's first round
        return {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": [],
                "status": "stopped at the cost cap", "passed_round": None, "round1_gate": "not run", "claim": CLAIM, "cost": stopper.report()}
    for k in range(1, max_rounds + 1):
        obj = Objective(cell, fam, cache); obj.archive.update(prev.archive)     # revision_v2.continue_search, with the round's incumbents
        new = cma_search(obj, fam, st, round_seed(k, st.restarts) + st.restarts, incumbents=round_incumbents(k, prev.best_knobs, emb))
        best = new if new.best_f > prev.best_f else replace(new, best_x=prev.best_x, best_knobs=prev.best_knobs, best_f=prev.best_f, best_source=prev.best_source)
        extra = reference_candidates(cell, fam, best, twin, [], order)
        ref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache); ref_f = float(np.mean(ref.per_seed_normalized))
        rounds.append({"round": k, "restarts_total": st.restarts * (k + 1), "cma_seeds": sorted(cma_seeds(k, st.restarts)), "attack_f": float(best.best_f),
                       "attack_change": float(best.best_f - prev.best_f), "reference_f": ref_f, "reference_change": ref_f - prev_ref,
                       "best_knobs": dict(best.best_knobs), "best_source": best.best_source})
        if k == 1 and src is not None:                          # the registered doubling's held-out winner is round 1's search winner
            reg = read(reference) if reference is not None else read(Path(src) / "doubling" / (R._safe(job["id"]) + ".json"))
            h1 = R.gain_fields(R.eval_cell(job), fam, new.best_knobs, frozen_ref, SeedCache())
            r1 = {**rounds[0], "heldout": {"knobs": dict(new.best_knobs), "seeds": list(R.eval_cell(job).seeds), "gain": h1["gain"]}}
            gate = compare_round1(reg, r1) if reg is not None else {"pass": False, "problems": ["no registered doubling record"]}
            gate["heldout_knobs"], gate["heldout_mean"] = dict(new.best_knobs), float(np.mean(h1["gain"]))
        prev, prev_ref = best, ref_f
        outcome = decide(k, rounds[-1], gate, stopper.allow(f"round {k + 1}", round_hours) if stopper else True, max_rounds, min_rounds)
        if outcome != "continue":
            break
    status, passed = final_status(rounds, outcome, min_rounds)
    res = {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": rounds, "status": status,
           "passed_round": passed, "round1_gate": gate if gate is not None else "not compared (smoke)", "claim": CLAIM,
           "frozen_best_f": float(rec["attack"]["best_f"]), "embedded_doubled_d2h3": emb is not None, "min_rounds": min_rounds,
           "cost": stopper.report() if stopper else None}
    if outcome != "round-1 mismatch":
        held = R.gain_fields(R.eval_cell(job), fam, prev.best_knobs, frozen_ref, SeedCache())
        res.update(place_heldout(status, {"knobs": dict(prev.best_knobs), "seeds": list(R.eval_cell(job).seeds), **held}))
    return res


def restart_hours(hs: list) -> dict:
    """Hours a restart needs for cells of these worst-case hours on 1 to 16 workers: longest first onto the least-loaded
    worker, plus 0.1 h shutdown, rounded up to 0.01 h (Sol and Astra, rerun review r1: not a fixed estimate)."""
    import math
    out = {}
    for w in range(1, 17):
        load = [0.0] * w
        for h in sorted(hs, reverse=True):
            load[load.index(min(load))] += h
        out[str(w)] = math.ceil((max(load) + 0.1) * 100 - 1e-6) / 100
    return out


def _run_and_save(fn, x: tuple, dest, extra: dict) -> None:
    """In the worker: run one cell and write its record (atomic) before anything goes back to the parent, so a sibling's
    death cannot discard a finished result in transit (Sol and Astra, rerun review r1)."""
    write(dest, {**fn(*x), **extra})


def run_cells(fn, todo: list, args: list, workers: int, dests: list, extras: list) -> tuple:
    """Run the cells, each in a worker process (also with one worker: a kill must not take the driver), and let each worker


KNOBS = {"u0": 1.0, "x": 0}


def _deps(d, job):
    """The records an evaluation and a doubling record depend on (freeze, reference with its menu, the cell's search),
    written once; returns the evaluation and the doubling dependency hashes."""
    import convergence_v2  # noqa: F401
    import revision_v2 as R
    from sim.records_v2 import sha_file
    ctx = job["context"]; menu = f"{ctx}|F000|D2+H3|profit"; fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
    for k, obj in ((fz, {"stage": "freeze"}), (menu, {"stage": "search", "attack": {"best_knobs": {"u0": 2.0, "x": 1}}}),
                   (job["id"], {"stage": "search", "attack": {"best_knobs": KNOBS}})):
        if not R.path_of(d, k).exists():
            _w(R.path_of(d, k), obj)
    if not R.path_of(d, rid).exists():
        _w(R.path_of(d, rid), {"stage": "reference", "upstream": {menu: sha_file(R.path_of(d, menu))}})
    h = lambda ks: {k: sha_file(R.path_of(d, k)) for k in ks}
    return h([fz, rid, job["id"]]), h([fz, rid, job["id"], menu])


def _cell(base, job, p, kind="menu", gain=(0.1, 0.3), incomplete=False, ev_prov=None, seeds=None, doubling=True, ev=True):
    import convergence_v2  # noqa: F401
    import revision_v2 as R
    d = base / f"{kind}-p{p:g}"
    h = {"seeds": list(seeds or job["mkt"]["seeds_eval"]), "gain": list(gain), "profit_attack": [g + 1 for g in gain],
         "profit_ref": [1.0] * len(gain), "sstar": [4.0] * len(gain), "eff_attack": [0.9] * len(gain)}
    eup, dup = _deps(d, job)
    if ev:
        _w(R.eval_path(d, job["id"]), {"stage": "evaluate", "id": job["id"], "provenance": ev_prov or job["provenance"], **h,
                                       "upstream": eup})
    if doubling:
        _w(d / "doubling" / (R._safe(job["id"]) + ".json"), {"stage": "doubling", "id": job["id"], "provenance": job["provenance"],
                                                             "kind": "profit", "attack_change": 0.01 if incomplete else 0.0,
                                                             "reference_change": 0.0, "incomplete": incomplete,
                                                             "heldout": {"knobs": dict(KNOBS), **h}, "upstream": dup})
    return d


def _cont(base, kind, p, job, status="passed", gain=(0.5, 0.7), gate=EXACT, sub=""):
    """A continuation record consistent with the cell's own doubling record (written unflagged if missing): round 1
    repeats the doubling's changes, the comparison carries its held-out knobs and mean; a pass comes in round 1 if the
    doubling passes, else in round 2; the held-out winner is the last round's."""
    import numpy as np
    import convergence_v2  # noqa: F401
    import revision_v2 as R
    from convergence_v2 import _passes
    key = D._key(kind, p, job["id"])
    db = D.doubling_of(base / f"{kind}-p{p:g}", job["id"])
    if db is None:
        _cell(base, job, p, kind); db = D.doubling_of(base / f"{kind}-p{p:g}", job["id"])
    if isinstance(gate, dict):
        gate = {**gate, "heldout_knobs": db["heldout"]["knobs"], "heldout_mean": float(np.mean(db["heldout"]["gain"]))}
    rd = lambda i, ch: {"round": i, "attack_f": 1.0, "attack_change": ch[0], "reference_f": 1.0, "reference_change": ch[1],
                        "best_knobs": dict(CKNOBS)}
    r1 = rd(1, (db["attack_change"], db["reference_change"]))
    mr = 1 if sub == "gate" else 3
    if status == "passed":
        rounds = [r1] if _passes(r1) else [r1, rd(2, (0.0, 0.0))]
    else:
        rounds = [r1] + [rd(i, (0.01, 0.0)) for i in range(2, mr + 1)]
    h = {"knobs": dict(CKNOBS), "seeds": job["mkt"]["seeds_eval"], "gain": list(gain), "profit_attack": [g + 1 for g in gain],
         "profit_ref": [1.0] * len(gain), "sstar": [4.0] * len(gain), "eff_attack": [0.8] * len(gain)}
    _w(base / "continuation" / sub / (R._safe(key) + ".json"), {"stage": "convergence", "id": key, "status": status,
                                                               "provenance": job["provenance"], "round1_gate": gate,
                                                               "rounds": rounds, "heldout": h})
    return key


def _gi(job, p=0.05):
    """The gate item collect needs (rep_v2.gate_item's shape)."""
    return {"id": D._key("menu", p, job["id"]), "job": job}


