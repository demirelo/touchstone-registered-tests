   341	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   342	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   343	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   344	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   345	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   346	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   347	    import revision_v2 as R
   348	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   349	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   350	    if ev is None:
