   545	    """The diagnostics of R3's continued winners (menu cells at p = 0 and 0.05 whose continuation passed or reached the
   546	    cap) in Run B's pool; records under continuation/diagnostics/, reused on resume when bound to the same job."""
   547	    import convergence_v2  # noqa: F401
