   327	def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
   328	    import revision_v2 as R
   329	    from sim.records_v2 import sha_file
   330	    up = rec.get("upstream")
   331	    if not isinstance(up, dict) or set(up) != set(want):
   332	        return "dependency set differs"
   333	    for u, h in up.items():
   334	        q = R.path_of(d, u)
   335	        if not q.is_file() or sha_file(q) != h:
   336	            return f"dependency hash differs: {u}"
   337	    return None
