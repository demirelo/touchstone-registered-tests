   563	            _set_aside(cdir / "diagnostics", dest)              # a stale or foreign record is rerun, never reused
   564	            todo.append({"id": key}); args.append((j, crec["heldout"]["knobs"])); dests.append(dest); extras.append({"id": key})
   565	    lost, failed = ([], {}) if not todo else run_cells(_diag_cont, todo, args, workers, dests, extras)
   566	    if lost and not failed:                                     # the launcher's restart reads this estimate (exit 5)
