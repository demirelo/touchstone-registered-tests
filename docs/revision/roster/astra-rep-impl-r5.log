   165	def _round1_problem(rec: dict, doubling) -> str | None:
   166	    """Round 1 against this cell's own doubling record (review rep-impl-r4): with zero differences, the comparison's
   167	    round-1 winner equals the doubling's held-out knobs, its held-out mean equals the mean of the doubling's held-out
   168	    gains (the same np.mean of the same values), and round 1's two changes equal the doubling's."""
   169	    import numpy as np
   170	    g, r1 = rec["round1_gate"], rec["rounds"][0]
   171	    if not isinstance(doubling, dict) or not isinstance(doubling.get("heldout"), dict) or not _finite(doubling["heldout"].get("gain")):
   172	        return "no valid doubling record to check round 1 against"
   173	    if g.get("heldout_knobs") != doubling["heldout"].get("knobs"):
   174	        return "round-1 winner differs from the doubling record's held-out winner"
   175	    if g.get("heldout_mean") != float(np.mean(doubling["heldout"]["gain"])):
   176	        return "round-1 held-out mean differs from the doubling record's"
   177	    if r1.get("attack_change") != doubling.get("attack_change") or r1.get("reference_change") != doubling.get("reference_change"):
   178	        return "round-1 changes differ from the doubling record's"
   179	    return None
