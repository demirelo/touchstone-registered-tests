   353	        return "evaluation record of another stage, cell or run"
   354	    if not _valid_held(ev, seeds):
   355	        return "evaluation values nonfinite or on other seeds"
   356	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
