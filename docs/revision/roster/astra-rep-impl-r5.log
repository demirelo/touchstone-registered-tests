    52	def select_winner(frozen: list, rec: dict | None) -> tuple:
    53	    """(gains, kind) for one flagged cell: a passed cell uses its continued winner ("continued"); a cell at the round cap
    54	    uses its last winner ("unresolved"); a cost-stopped cell keeps the frozen winner and drops its partial rounds
    55	    ("stopped"); a missing or nonfinite continuation keeps the frozen winner ("not continued"); a round-1 mismatch raises."""
    56	    if rec is None:
    57	        return frozen, "frozen"
    58	    st = str(rec.get("status", ""))
    59	    if st.startswith("stopped: round 1"):
    60	        raise Round1Mismatch(rec.get("id", "?"))
    61	    if st == "stopped at the cost cap":
    62	        return frozen, "stopped"
    63	    g = (rec.get("heldout") or {}).get("gain")
    64	    if not _finite(g):
    65	        return frozen, "not continued"
    66	    return list(g), ("continued" if st == "passed" else "unresolved")
