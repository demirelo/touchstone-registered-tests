/bin/zsh -lc "python3 -B -c 'import json
from pathlib import Path
for fn in ['\\''churn'\\'','\\''churn_mid'\\'']:
 d=json.loads(Path('\\''docs/revision/posthoc/'\\''+fn+'\\''.json'\\'').read_text())
 for ver in ['\\''base'\\'','\\''doubled'\\'']:
  for p,row in d['\\''statistics'\\''][ver].items():
   print(fn,ver,p,{k:{'\\''mean'\\'':round(row[k]['\\''pooled'\\'']['\\''estimate'\\''],6),'\\''signs'\\'':row[k]['\\''signs'\\''],'\\''markets'\\'':{m:round(v,6) for m,v in row[k]['\\''markets'\\''].items()}} for k in ['\\''d'\\'','\\''q'\\'']})
 print('\\''expectations'\\'',d['\\''expectations'\\''])
 print('\\''t95'\\'',d['\\''review_r4'\\'']['\\''t95'\\''])
 print('\\''inputs'\\'',d['\\''inputs'\\''])
d=json.loads(Path('\\''docs/revision/followup2/runnerup_analysis.json'\\'').read_text())
for fam,x in d.items():
 if isinstance(x,dict):
  for ver in ['\\''base'\\'','\\''doubled'\\'']:
   if ver in x: print('\\''RUN A'\\'',fam,ver, {k:v for k,v in x[ver]['\\''runner_up_minus_r3'\\''].items() if k in ['\\''estimate'\\'','\\''interval'\\'','\\''category'\\'']})
