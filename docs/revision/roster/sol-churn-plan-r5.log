   373	def _rate_env(monkeypatch, tmp_path, workers_by_stage, limit=32 * 2 ** 30):
   374	    """_run_rate with every check stubbed; the preflight returns the given workers per stage."""
   375	    needs, runs, pre = [], [], []
   376	    monkeypatch.setattr(C, "check_cap", lambda started, need_s, *a, **k: needs.append(round(need_s)))
   377	    monkeypatch.setattr(C, "memory_limit", lambda: limit)
   378	    def mp(stage, jobs, out, req, **k):
   379	        pre.append((stage, req)); return {"workers": min(req, workers_by_stage[stage]), "measured": [jobs[0]["id"]], "limit_bytes": limit, "seconds": 1.0}
   380	    monkeypatch.setattr(C, "memory_preflight", mp)
   381	    monkeypatch.setattr(C, "run_stage", lambda st, jobs, out, w: runs.append((st, w, len(jobs))))
   382	    monkeypatch.setattr(C.F, "accept", lambda *a, **k: None)
   383	    monkeypatch.setattr(C, "diagnostics", lambda out, jobs, w: runs.append(("diagnostics", w, len(jobs))) or {})
   384	    for f in ("check_configs", "check_salt", "check_commit", "check_code", "check_pairing"):
   385	        monkeypatch.setattr(C.F, f, lambda *a, **k: None)
   386	    a = NS(smoke=False, src="s", workers_search=16, workers_eval=9, stop_usd=8.0, usd_per_hour=0.56, prior_usd=0.0)
   387	    jobs = [{"id": f"j{i}", "churn": 0.05, "rule": ("F111", "C*", "F000")[i % 3]} for i in range(18)]
   388	    return a, jobs, needs, runs, pre
