   337	def test_r3_preflight_measures_real_tasks_one_per_rule_and_the_doubling(tmp_path):
   338	    jobs = [{"id": f"m{i}|{r}", "rule": r, "context": f"m{i}"} for i in range(2) for r in ("F111", "C*", "F000")]
   339	    peaks = {"F111": 2.0, "C*": 2.6, "F000": 2.2}; ran = []
   340	    def runner(stage, job, out, catalog):
   341	        ran.append((stage, job["id"])); return {"peak_rss_bytes": int(peaks[job["rule"]] * 2 ** 30), "status": "done"}
   342	    G = 2 ** 30
   343	    ev = C.memory_preflight("evaluate", jobs, tmp_path, 9, runner=runner, limit=32 * G, parent=G)
   344	    assert [j for s, j in ran] == ["m0|F111", "m0|C*", "m0|F000"]                              # one real task per rule
   345	    assert ev["task_peak_bytes"] == int(2.6 * G) and ev["margin"] == 1.25 and ev["workers"] == int((0.9 * 32 * G - G) // int(1.25 * 2.6 * G))
   346	    assert ev["measured"] == ["m0|F111", "m0|C*", "m0|F000"]                                   # their records count as done
   347	    ran.clear(); db = C.memory_preflight("doubling", jobs, tmp_path, 9, runner=runner, limit=32 * G, parent=G)
   348	    assert len(ran) == 1 and db["stage"] == "doubling"
