    73	        p = job.get("churn")
    74	        if p is None or others:
    75	            return cell
    76	        from dataclasses import replace
    77	        return replace(cell, others=tuple((e, _churn_factory(p)) for e in range(cell.cfg.N) if e != cell.focal))
