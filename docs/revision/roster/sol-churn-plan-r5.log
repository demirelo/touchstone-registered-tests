   351	def test_r3_admission_is_rerun_after_the_preflight_and_the_reduced_workers_persist(tmp_path, monkeypatch):
   352	    needs, runs = [], []
   353	    monkeypatch.setattr(C, "check_cap", lambda started, need_s, *a, **k: needs.append(round(need_s)))
   354	    monkeypatch.setattr(C, "memory_preflight", lambda stage, jobs, out, req, **k: {"workers": 2, "measured": [jobs[0]["id"]], "seconds": 100.0})
   355	    monkeypatch.setattr(C, "run_stage", lambda st, jobs, out, w: runs.append((st, w, len(jobs))))
   356	    monkeypatch.setattr(C.F, "accept", lambda *a, **k: None)
   357	    monkeypatch.setattr(C, "diagnostics", lambda out, jobs, w: runs.append(("diagnostics", w, len(jobs))) or {})
   358	    for f in ("check_configs", "check_salt", "check_commit", "check_code", "check_pairing"):
   359	        monkeypatch.setattr(C.F, f, lambda *a, **k: None)
   360	    a = NS(smoke=False, src="s", workers_search=16, workers_eval=9, stop_usd=8.0, usd_per_hour=0.56, prior_usd=0.0)
   361	    jobs = [{"id": f"j{i}", "churn": 0.05, "rule": ("F111", "C*", "F000")[i % 3]} for i in range(18)]
   362	    C._run_rate(tmp_path, jobs, ("evaluate", "doubling", "diagnostics"), a, "salt", {}, 0.05, started=1.0)
   363	    s = C.STAGE_SECONDS; f = 1.33
   364	    assert needs[0] == round(s["evaluate"] * f * (3 + 2))                                      # three serial preflight tasks + 15 jobs at nine workers
   365	    assert needs[1] == round(s["evaluate"] * f * 9)                                            # rerun after the preflight: 17 remaining jobs at two workers
   366	    assert needs[2] == round(s["doubling"] * f * (1 + 9))                                      # doubling: one preflight task + 17 jobs at the kept two workers
   367	    assert needs[3] == round(s["doubling"] * f * 9)
   368	    assert ("evaluate", 2, 17) in runs and ("doubling", 2, 17) in runs and ("diagnostics", 2, 18) in runs   # the limit persists
