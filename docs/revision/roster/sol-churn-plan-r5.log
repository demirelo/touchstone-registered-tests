   272	def check_started(started, now: float | None = None) -> None:
   273	    """Production runs need the pod's allocation time (epoch seconds, in the past)."""
   274	    import math
   275	    import time
   276	    now = time.time() if now is None else now
   277	    if started is None or not isinstance(started, (int, float)) or not math.isfinite(started) or not (1.6e9 < float(started) <= now):
   278	        raise SystemExit(f"churn arm refused: --started must be the pod's allocation time in epoch seconds, got {started!r}")
