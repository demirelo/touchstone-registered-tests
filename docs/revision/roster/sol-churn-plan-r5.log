   391	def test_r4_a_skipped_record_is_never_a_memory_measurement(tmp_path):
   392	    # Review r4: on resume, _run_one returns "skipped" for a valid record, so the child measures no real task.
   393	    jobs = [{"id": f"m{i}|{r}", "rule": r} for i in range(3) for r in ("F111", "C*", "F000")]
   394	    G = 2 ** 30; peaks = {"F111": 2.0, "C*": 2.6, "F000": 2.2}; ran = []
   395	    done_before = {"m0|F111", "m0|C*"}                                                         # records left by a crashed earlier attempt
   396	    def runner(stage, job, out, catalog):
   397	        ran.append(job["id"])
   398	        if job["id"] in done_before:
   399	            return {"peak_rss_bytes": int(0.3 * G), "status": "skipped"}
   400	        return {"peak_rss_bytes": int(peaks[job["rule"]] * G), "status": "done"}
   401	    ev = C.memory_preflight("evaluate", jobs, tmp_path, 9, runner=runner, limit=32 * G, parent=G)
   402	    assert "m0|F111" in ran and "m0|C*" in ran                                                 # the skipped attempts happened
   403	    assert ran == ["m0|F111", "m1|F111", "m0|C*", "m1|C*", "m0|F000"]                          # each was replaced by a real task
   404	    assert ev["task_peak_bytes"] == int(2.6 * G) and ev["measured"] == ["m1|F111", "m1|C*", "m0|F000"]
   405	    assert all(v >= int(2.0 * G) for v in ev["peaks"].values())
