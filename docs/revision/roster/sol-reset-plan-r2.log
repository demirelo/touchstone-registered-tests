def menu(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> tuple[list, list, dict]:
    """The reference menu of the job's rule in its context (design 6.4): candidates, their family names, upstream hashes."""
    ctx, rule = job["context"], job["rule"]; T, L = constants(job); cell = train_cell(job)
    groups: dict[tuple, list] = {}; upstream = {}; fnames = MAN.menu_families(manifest_ctx(ctx), rule)
    for fname in fnames:
        rid = _menu_id(ctx, rule, fname); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"reference {ctx}/{rule}: needs {rid}")
        upstream[rid] = sha_file(path_of(out, rid))
        fam = family_for(fname, T, L)
        bank = []
        if rule in FIXED:
            for other in MAN.bank_rules(manifest_ctx(ctx), fname, cuts, h4_excluded):
                if other == rule:
                    continue
                orid = _menu_id(ctx, other, fname); orec = read(path_of(out, orid))
                if orec is None:
                    raise SystemExit(f"reference {ctx}/{rule}: needs bank source {orid}")
                upstream[orid] = sha_file(path_of(out, orid)); bank.append(fam.project(orec["attack"]["best_knobs"]))
        lk = load_locked()
        cands = reference_candidates(cell, fam, search_from_json(rec["attack"]), search_from_json(rec["twin"]), bank, tuple(lk["reference_order"]))
        for c in cands:
            cat = "bank" if c.name.startswith("bank_") else c.name
            groups.setdefault((cat, fname), []).append(c)
    out_c, fams = merge_menu(groups, fnames)
    return out_c, fams, upstream

def _coalition_heldout(job: dict, desc: dict, out: Path) -> dict:
    """The doubled coalition winner (one descriptor, the same one the objective change reports) on the evaluation seeds
    against the final joint reference (design 6.5)."""
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}")); seeds = list(eval_cell(job).seeds); cache = SeedCache()
    g = _rows_of(job, desc, seeds, cache) - _rows_of(job, jrec["descriptor"], seeds, cache)
    return {"descriptor": desc, "knobs": None if desc["knobs"] is None else dict(desc["knobs"]), "seeds": seeds, "member_gain": g.tolist(),
            "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min())}


def rescore_min(orig, rows: list[dict], ref: np.ndarray):
    """The search's archive with every G_min score recomputed against `ref` from the stored member rows (design 6.3)."""
    by = {exact_key(e["knobs"]): np.asarray(e["member_rows"]) for e in rows}
    arch = {}
    for k, e in orig.archive.items():
        f = float((by[k] - ref).mean(axis=1).min()) if k in by else e.f
        arch[k] = replace(e, f=f)
    best = max(arch.values(), key=lambda e: e.f)
    return replace(orig, archive=arch, best_knobs=dict(best.knobs), best_f=best.f)


