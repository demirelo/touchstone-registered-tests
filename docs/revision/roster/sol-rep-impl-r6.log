   406	@_checked
   407	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   408	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   409	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   410	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   411	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   412	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   413	    import revision_v2 as R
   414	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   415	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   416	    if ev is None:
   417	        return "no evaluation record"
   418	    if ev.get("stage") != "evaluate" or not _same(ev.get("id"), job["id"]) or not _same(ev.get("provenance"), job["provenance"]):
   419	        return "evaluation record of another stage, cell or run"
   420	    if not _valid_held(ev, seeds):
   421	        return "evaluation values nonfinite or on other seeds"
   422	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
   423	        return "evaluation: " + x
   424	    if db is None:
   425	        return "no doubling record"
   426	    if db.get("stage") != "doubling" or not _same(db.get("id"), job["id"]) or not _same(db.get("provenance"), job["provenance"]) or db.get("kind") != "profit":
   427	        return "doubling record of another stage, cell, run or kind"
   428	    ch = [db.get("attack_change"), db.get("reference_change")]
   429	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   430	        return "doubling changes nonfinite or flag missing"
   431	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   432	        return "doubling flag differs from its changes"
   433	    h = db.get("heldout")
   434	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   435	        return "doubling held-out result missing, nonfinite or on other seeds"
   436	    ref = read_record(R.path_of(d, rid))
   437	    if ref is None or not isinstance(ref.get("upstream"), dict):
   438	        return "no reference record"
   439	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   440	        return "doubling: " + x
   441	    return None
