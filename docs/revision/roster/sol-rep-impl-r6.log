   277	
   278	def _set_aside(cdir: Path, dest: Path) -> None:
   279	    """Move a record that will be rerun out of the way (no deletion), so that a lost worker shows as a missing record and
   280	    is never masked by the old one (review rep-impl-r2)."""
   281	    if dest.exists():
   282	        sup = cdir / "superseded"; sup.mkdir(parents=True, exist_ok=True)
   283	        n = len(list(sup.glob(dest.stem + ".*.json")))
   284	        dest.rename(sup / f"{dest.stem}.{n}.json")
   285	
   286	
   287	def _mismatch(rec, doubling=None, search=None) -> bool:
   288	    """A measured round 1 that differs from the doubling record at all: the recorded status, a comparison that is not
   289	    identical, or (with the cell's doubling and search records) any recorded round-1 value that disagrees with them
   290	    (_round1_problem; review rep-impl-r5). A cell refused before round 1 ("not run") or a smoke run ("not compared")
   291	    measured nothing."""
   292	    rec = _d(rec)
   293	    if rec is None:
   294	        return False
   295	    if str(rec.get("status", "")).startswith("stopped: round 1"):
   296	        return True
   297	    if not isinstance(rec.get("round1_gate"), dict):
   298	        return False
   299	    if not identical(rec):
   300	        return True
   301	    return _round1_ready(rec, doubling, search) and _round1_problem(rec, doubling, search) is not None
   302	
