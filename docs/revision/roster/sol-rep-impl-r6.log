   311	
   312	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   313	              smoke: bool = False) -> dict:
   314	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   315	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   316	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   317	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   318	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   319	    cost-stopped ones."""
   320	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   321	    import revision_v2 as R
   322	    if gate is None:
   323	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   324	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   325	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   326	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   327	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   328	    saved = {d: _d(read_record(d)) for _, d in items}                   # a non-object root counts as no record
   329	    dbl = {d: doubling_of(c["dir"], c["job"]["id"]) for c, d in items}; srch = {d: search_of(c["dir"], c["job"]["id"]) for c, d in items}
   330	    other = [c["id"] for c, d in items if saved[d] is not None and not _same(saved[d].get("provenance"), c["job"].get("provenance"))]
   331	    if other:                                                            # plan section 5: reuse only this run's records
   332	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   333	    if any(_mismatch(saved[d], dbl[d], srch[d]) for _, d in items):     # a measured disagreement included (review rep-impl-r5)
   334	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   335	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   336	    # review rep-impl-r3: a saved record is reused only if it passes the same checks collect applies; any other record
   337	    # (incomplete, malformed, nonfinite) means "no passing record" and its cell is rerun (plan section 4: a resume
   338	    # continues from the first cell without a passing record); the old record is set aside, never deleted
   339	    # (an unknown status included: review rep-impl-r4; a measured round-1 mismatch stopped above and is never rerun)
   340	    invalid = lambda c, d, mr: saved[d] is not None and not cost_stopped(saved[d]) and \
   341	        cont_problem(saved[d], c["id"], c["job"], smoke, mr, dbl[d], srch[d]) is not None
   342	    rerun = lambda c, d, mr: saved[d] is None or cost_stopped(saved[d]) or invalid(c, d, mr)
   343	    run = 0
   344	    if rerun(gate, gdest, 1):
   345	        _set_aside(cdir, gdest)
   346	        lost, failed = run_cells(_cont_one, [gate], [(gate["job"], gate["dir"], 1, cost, hours[gate["id"]])], 1, [gdest],
   347	                                 [{"id": gate["id"], "gate": True}])
   348	        run += 1
   349	        if failed:
   350	            return {"run": run, "failed": failed, "exit": 6, "gate": "the gate cell raised an error"}
   351	        if lost:
   352	            _lost(cdir, lost, hours, 1)
   353	            return {"run": run, "lost": lost, "exit": 5, "gate": "the gate cell's worker was lost"}
   354	    g = _d(read_record(gdest))
   355	    if _mismatch(g, dbl[gdest], srch[gdest]):
   356	        return {"run": run, "exit": 4, "gate": "round-1 mismatch at the gate: continuation stopped"}
   357	    if cost_stopped(g):
   358	        return {"run": run, "exit": 3, "gate": "the gate cell was refused at the cost cap: no further cell started"}
   359	    if not smoke and not identical(g):                                   # the gate must prove identity, not just not fail
   360	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   361	    if (why := cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1, doubling=dbl[gdest], search=srch[gdest])) is not None:
   362	        return {"run": run, "exit": 6, "gate": f"the gate record fails its checks: {why}"}
   363	    todo = [c for c in queue if rerun(c, dest(c), max_rounds)]          # same order; completed, valid cells reused
   364	    for c in todo:
   365	        _set_aside(cdir, dest(c))
   366	    lost, failed = ([], {}) if not todo else run_cells(
   367	        _cont_one, todo, [(c["job"], c["dir"], max_rounds, cost, hours[c["id"]]) for c in todo], workers,   # module-level fn
   368	        [dest(c) for c in todo], [{"id": c["id"]} for c in todo])
   369	    recs = [_d(read_record(dest(c))) for c in todo]
   370	    mismatch = [c["id"] for c, r in zip(todo, recs) if _mismatch(r, dbl[dest(c)], srch[dest(c)])]
   371	    stopped = [c["id"] for c, r in zip(todo, recs) if cost_stopped(r)]
   372	    if lost and not mismatch and not failed:
   373	        _lost(cdir, lost, hours, max_rounds)
   374	    code = 4 if mismatch else 6 if failed else 5 if lost else 3 if stopped else 0
   375	    return {"run": run + len(todo), "lost": lost, "failed": failed, "mismatch": mismatch, "stopped": stopped, "exit": code}
   376	
