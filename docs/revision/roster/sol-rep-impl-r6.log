   449	def _shares_ok(sh, n_episodes: int) -> bool:
   450	    """Newcomer audit counts (churn_v2.newcomer_shares): one episode per evaluation seed, each with the prescribed number
   451	    of age bins of [served, audited], finite and nonnegative, audited at most served (review rep-impl-r3)."""
   452	    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
   453	    if not isinstance(per, list) or len(per) != n_episodes:
   454	        return False
   455	    nb = _n_bins()
   456	    for e in per:
   457	        f = e.get("focal") if isinstance(e, dict) else None
   458	        if not isinstance(f, list) or len(f) != nb:
   459	            return False
   460	        for b in f:
   461	            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
   462	                return False
   463	    return True
