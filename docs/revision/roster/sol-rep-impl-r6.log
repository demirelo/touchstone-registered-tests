   245	@_checked
   246	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3, doubling=None, search=None) -> str | None:
   247	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   248	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   249	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   250	    job's ordered evaluation seeds; a measured round 1 must agree with this cell's doubling record (`doubling`;
   251	    _round1_problem). The job must carry its evaluation seeds: no check is skipped."""
   252	    seeds = (job.get("mkt") or {}).get("seeds_eval")
   253	    if not seeds:
   254	        return "the job has no evaluation seeds to check against"
   255	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or not _same(rec.get("id"), key):
   256	        return "not a continuation record of this cell"
   257	    if not _same(rec.get("provenance"), job.get("provenance")):
   258	        return "continuation record of another job or run"
   259	    st = rec.get("status")
   260	    if st not in STATUSES:
   261	        return f"unknown continuation status {st!r}"
   262	    if st in STATUSES[:2]:
   263	        g = rec.get("round1_gate")
   264	        if not (identical(rec) or (smoke and g == SMOKE_GATE)):
   265	            return "a continued winner without its own identical round-1 comparison"
   266	        if isinstance(g, dict) and not (_knobs_ok(g.get("heldout_knobs")) and _finite([g.get("heldout_mean")])):
   267	            return "round-1 comparison without a finite round-1 winner"
   268	        h = rec.get("heldout")
   269	        if not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   270	            return "held-out result missing, nonfinite, on other seeds or with a zero normalizer"
   271	        if x := _rounds_problem(rec, max_rounds):
   272	            return x
   273	        if isinstance(g, dict) and (x := _round1_problem(rec, doubling, search)):
   274	            return x
   275	    return None
