   489	def diag_bound(d: Path, kind: str, p: float, ck: str, job: dict) -> bool:
   490	    """The frozen diagnostics of cell `ck` belong to this job, rate and run: the binding names this rate, the current
   491	    diagnostics.json, this job's id and provenance, and the current search and doubling records."""
   492	    import revision_v2 as R
   493	    from sim.records_v2 import sha_file
   494	    b = _d(read_record(Path(d) / BINDING)); c = (_d((b or {}).get("cells")) or {}).get(ck)
   495	    q = Path(d) / "diagnostics.json"
   496	    return isinstance(c, dict) and b.get("stage") == "diagnostics binding" and b.get("kind") == kind and _same(b.get("rate"), float(p)) and \
   497	        q.is_file() and b.get("diagnostics") == sha_file(q) and _same(c.get("id"), job["id"]) and _same(c.get("provenance"), job["provenance"]) and \
   498	        R.path_of(d, job["id"]).is_file() and c.get("search") == sha_file(R.path_of(d, job["id"])) and \
   499	        c.get("doubling") == sha_file(Path(d) / "doubling" / (R._safe(job["id"]) + ".json"))
