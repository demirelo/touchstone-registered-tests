   477	def diagnostics_binding(d: Path, kind: str, p: float, jobs: list) -> dict:
   478	    """Written by rep_v2's rate stage right after the diagnostics step and before the inventory (review rep-impl-r3): the
   479	    sha256 of diagnostics.json, the rate, and per cell the job id, its provenance (this run's commit, draw and salt) and
   480	    the hashes of the search and doubling records whose winners the diagnostics reran."""
   481	    import revision_v2 as R
   482	    from sim.records_v2 import sha_file
   483	    d = Path(d); h = lambda q: sha_file(q) if q.is_file() else None
   484	    return {"stage": "diagnostics binding", "kind": kind, "rate": float(p), "diagnostics": h(d / "diagnostics.json"),
   485	            "cells": {f"{j['context']}|{j['rule']}": {"id": j["id"], "provenance": j["provenance"], "search": h(R.path_of(d, j["id"])),
   486	                                                       "doubling": h(d / "doubling" / (R._safe(j["id"]) + ".json"))} for j in jobs}}
