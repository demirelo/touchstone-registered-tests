   393	def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
   394	    import revision_v2 as R
   395	    from sim.records_v2 import sha_file
   396	    up = rec.get("upstream")
   397	    if not isinstance(up, dict) or set(up) != set(want):
   398	        return "dependency set differs"
   399	    for u, h in up.items():
   400	        q = R.path_of(d, u)
   401	        if not q.is_file() or sha_file(q) != h:
   402	            return f"dependency hash differs: {u}"
   403	    return None
