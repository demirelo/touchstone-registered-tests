   507	def safe_terms(h: dict, n: int):
   508	    """terms_of, or None when a normalizer S*/N is not positive after the division or any term is not finite (review
   509	    rep-impl-r5: S* = 5e-324 passed as positive, then became 0 after division by N)."""
   510	    try:
   511	        if not all(x / n > 0 for x in h["sstar"]):
   512	            return None
   513	        t = terms_of(h, n)
   514	        return t if _finite(t["attack"]) and _finite(t["reference"]) and _finite(t["gain"]) else None
   515	    except (ZeroDivisionError, OverflowError, TypeError, KeyError):
   516	        return None
   517	
   518	
   519	def terms_of(h: dict, n: int) -> dict:
   520	    """Per seed: gain = attack term - reference term, each normalised by S*/N (sim/reference.evaluate_gain)."""
   521	    sc = [x / n for x in h["sstar"]]
   522	    return {"gain": list(h["gain"]), "attack": [a / s for a, s in zip(h["profit_attack"], sc)],
   523	            "reference": [r / s for r, s in zip(h["profit_ref"], sc)], "eff_attack": list(h["eff_attack"]), "seeds": list(h["seeds"])}
   524	
   525	
   526	def _audit_of(shares: dict) -> tuple:
   527	    per = shares["per_episode"]
   528	    fo = [sum(e["focal"][b][i] for e in per for b in range(len(e["focal"]))) for i in (0, 1)]
   529	    return fo[1], fo[0]                                                   # (audited, served)
