### 8.1a Questions and their cells


@lru_cache(maxsize=1)
def _cells_by_id() -> dict:
    return {c["id"]: c for c in MAN.cells()}


def job(mkt: dict, rule: str, family: str, objective: str = "profit", c: int | None = None, schedule: str | None = None,
        smoke: bool = False, params: dict | None = None, h4: dict | None = None, block: str | None = None) -> dict:
    lk = load_locked(); s = lk["search"]
    R, E, n_train, n_eval = SMOKE if (smoke or mkt["smoke"]) else (int(s["restarts"]), int(s["evals_per_restart"]), len(mkt["seeds_train"]), len(mkt["seeds_eval"]))
    if family in ("X7-SC", "H4"):                   # H4 is priced and searched as an X7-SC cell (design draft 7, 5.3)
        E *= 2
    spec = rule_spec(rule, params)
    j = {"id": cell_id(mkt["context"], rule, family, objective, c, schedule), "context": mkt["context"], "rule": rule, "family": family,
         "objective": objective, "c": c, "schedule": schedule, "budget": [R, E, n_train, n_eval], "spec": spec, "mkt": mkt,
         "h4": h4 if family == "H4" else None}
    cell = _cells_by_id().get(j["id"].replace(j["context"], manifest_ctx(j["context"]), 1))
    j["block"] = block or (cell or {}).get("block"); j["priority"] = MAN.priority(cell) if cell else 3      # execution priority (design 8.2)
    j["provenance"] = context_provenance(mkt) | {"budget": j["budget"], "rule_params_sha256": _sha_json(spec), "id": j["id"]}
    if family == "H4" and h4:
        j["provenance"]["h4_sha256"] = str(h4["sha"])
    return j


def context_provenance(mkt: dict) -> dict:
    return {"git_commit": mkt.get("commit") or git_commit(), "runner_sha256": _sha(Path(__file__).read_bytes()), "cfg_sha256": _sha_json(cfg_to_dict(mkt["cfg"])),
            "salt_sha256": mkt.get("salt_sha256") or _sha(load_identity_salt()), "root": mkt["root"], "seeds_train": mkt["seeds_train"],
            "seeds_val": mkt["seeds_val"], "seeds_eval": mkt["seeds_eval"], "context": mkt["context"]}


def settings(job: dict) -> SearchSettings:
    R, E, _, _ = job["budget"]
    return replace(settings_from_locked(load_locked()), restarts=int(R), evals_per_restart=int(E))


def train_cell(job: dict, others: tuple = ()) -> Cell:
    m = job["mkt"]
    return Cell(cfg=m["cfg"], rule_factory=rule_factory(job), focal=m["focal"], seeds=tuple(m["seeds_train"]), name=job["id"], others=others)


def eval_cell(job: dict) -> Cell:
    return replace(train_cell(job), seeds=tuple(job["mkt"]["seeds_eval"]))


# ---- record paths ------------------------------------------------------------------------------------------------------

def _safe(s: str) -> str:
    return s.replace("|", "__").replace("/", "~").replace("*", "star")


def path_of(out: Path, rid: str) -> Path:
    if rid.startswith("freeze/"):
        return Path(out) / "freeze" / (rid.split("/", 1)[1] + ".json")
    if "|" in rid:
        objective = rid.split("|")[3]
        return Path(out) / ("dependent" if objective in ("W1", "total", "min") else "search") / (_safe(rid) + ".json")
    kind, ctx, rest = rid.split("/", 2)
    return Path(out) / kind / ctx / (_safe(rest) + ".json")


def eval_path(out: Path, rid: str) -> Path:
    return Path(out) / "evaluate" / (_safe(rid) + ".json")


# ---- search adapters ---------------------------------------------------------------------------------------------------

def search_family(cell: Cell, family: Family, cache: SeedCache, st: SearchSettings, twin, extra_incumbents: dict | None = None):
    inc = {"twin_best": twin.best_knobs, "honest_point": family.honest_point(), **(extra_incumbents or {})}
    return cma_search(Objective(cell, family, cache), family, st, 1, incumbents=inc)


BOUNDED_CONTROLS = ("X7-SC", "H4")                # design draft 7, 5.2 and 5.3: Sobol corner controls, never every corner


def controls(objective, family: Family) -> list:
    if family.name in BOUNDED_CONTROLS:
        vecs = corner_vectors(family)
    else:
        if family.dim > 8:
            raise AssertionError(f"{family.name}: {family.dim} knobs is too many for exhaustive corners")
        vecs = family.corners()
    return [(k, float(objective.eval_knobs(k, source="corner"))) for k in vecs]


def continue_search(objective, family: Family, st: SearchSettings, original, seed: int = 1):
    """Doubling (design 6.5): as many new restarts as registered, with restart seeds after the registered ones, on the
    merged archive (old entries kept), the previous best as an incumbent."""
    objective.archive.update(original.archive)
    return cma_search(objective, family, st, int(seed) + int(st.restarts), incumbents={"previous_best": dict(original.best_knobs)})


def stage_search(job: dict, out: Path) -> dict:
    T, L = constants(job); fam = family_for(job["family"], T, L, job.get("h4")); cache = SeedCache(); st = settings(job); cell = train_cell(job)
    upstream = {}
    if job["objective"] == "W0":
        extra, upstream = _welfare_extra(job, out, T)
        obj = WelfareObjective(cell, fam, cache)
        res = cma_search(obj, fam, st, 1, incumbents={"honest_point": fam.honest_point(), **extra})
        controls(obj, fam)
        best = max(obj.archive.values(), key=lambda e: e.f)
        return _welfare_record(obj, res, dict(best.knobs), upstream, T, L)
    tw = twin_search(cell, fam, cache, st, seed=0)
    extra = {}
    if job["family"] == "X7-SC":
        rid = _menu_id(job["context"], job["rule"], "D2+H3"); rec = read(path_of(out, rid))
        if rec is None:
            raise SystemExit(f"{job['id']}: needs {rid} first")
        extra["embedded_h3"] = embed_h3(rec["attack"]["best_knobs"], T); upstream[rid] = sha_file(path_of(out, rid))
    at = search_family(cell, fam, cache, st, tw, extra)
    obj = Objective(cell, fam, cache); obj.archive.update(at.archive)
    ctrl = controls(obj, fam)
    best_ctrl = max(ctrl, key=lambda kf: kf[1]) if ctrl else None
    at.archive.update(obj.archive)
    rec = {"twin": search_to_json(tw), "attack": search_to_json(at), "controls": [{"knobs": k, "f": f} for k, f in ctrl],
           "upstream": upstream, "T": T, "L": L, "runs": cache.runs}
    if best_ctrl is not None and best_ctrl[1] > at.best_f:
        rec["attack"]["best_knobs"], rec["attack"]["best_f"], rec["attack"]["best_source"] = dict(best_ctrl[0]), float(best_ctrl[1]), "control"
    return rec


def cand_to_json(c: Candidate, family: str | None, T: int, L: int) -> dict:
def gain_fields(cell, fam, knobs: dict, cand, cache: SeedCache) -> dict:
    """The frozen evaluate_gain's fields plus the draft-7 fields computed from the same episodes (no extra episode).
    sim/cell.py and sim/reference.py are frozen, so the profiles' results are kept by rebinding the run_focal name that
    evaluate_gain looks up, for this call only (order attack, clipped, reference, honest); evaluation runs one job per
    process, never in threads."""
    import sim.reference as REF
    kept, orig = [], REF.run_focal

    def keep(c, pf, ca):
        fr = orig(c, pf, ca); kept.append(fr.results); return fr

    REF.run_focal = keep
    try:
        g = evaluate_gain(cell, fam, dict(knobs), cand, cache)
    finally:
        REF.run_focal = orig
    return {**{k: [float(v) for v in getattr(g, k)] for k in BASE_FIELDS}, **extras(kept[0], kept[2], cell.cfg, cell.focal)}


def stage_evaluate(job: dict, out: Path) -> dict:
    T, L = constants(job); cache = SeedCache(); m = job["mkt"]; cell = eval_cell(job)
    if job["objective"] == "diagnostic":                 # design 6.7: a fixed profile, no search, no reference
        return {"seeds": list(cell.seeds), **honest_replacement(m["cfg"], rule_factory(job), m["focal"], cell.seeds, cache)}
    rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); cand, _, _ = reference_of(job, out)
        return {"seeds": list(cell.seeds), **gain_fields(cell, fam, rec["attack"]["best_knobs"], cand, cache)}
    if job["objective"] in ("W0", "W1"):
        if rec["selected"] is None:
            return {"seeds": list(cell.seeds), "no_feasible_candidate": True}
        fam = family_for(job["family"], T, L); fr = run_focal(cell, lambda: fam.make(dict(rec["selected"])), cache)
        out_ = {"seeds": list(cell.seeds), "eff": gross_efficiency(fr.results).tolist(), "normalized": fr.normalized.tolist()}
        if job["objective"] == "W1":
            cand, _, _ = reference_of(job, out); ref = run_focal(cell, cand.policy_factory, cache)
            out_["constraint"] = (fr.normalized - ref.normalized).tolist()
        return out_
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}"))
    if job["objective"] == "min":
        win = read(path_of(out, f"coalition_select/{job['context']}/{_coalition_tag(job)}"))["winners"][job["id"]]["descriptor"]
    else:
        win = _desc(job, rec["selected"])
    rows = _rows_of(job, win, cell.seeds, cache); ref_rows = _rows_of(job, jrec["descriptor"], cell.seeds, cache)
    g = rows - ref_rows
    return {"seeds": list(cell.seeds), "member_gain": g.tolist(), "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min()),
            "winner": win, "reference": jrec["descriptor"]}


def _cross_rules(ctx: str, family: str, catalog: list[dict], bank: dict) -> tuple[dict, list]:
def doubling_report(kind: str, old: dict, new: dict) -> dict:
    """Changes in the objective's units (design 6.5): profit (attack and reference normalised profit), welfare (gross
    efficiency, lower is a better attack), w1 (efficiency and feasibility), coalition (objective)."""
    rep = {"kind": kind}
    if kind == "profit":
        rep["attack_change"] = float(new["attack_f"] - old["attack_f"]); rep["reference_change"] = float(new["ref_f"] - old["ref_f"])
        changes = [rep["attack_change"], rep["reference_change"]]
    elif kind in ("welfare", "w1"):
        rep["efficiency_change"] = float(old["eff"] - new["eff"]) if old.get("eff") is not None and new.get("eff") is not None else 0.0
        changes = [rep["efficiency_change"]]
        if kind == "w1":
            rep["feasibility_transition"] = bool(old.get("feasible") is False and new.get("feasible") is True)
    elif kind == "coalition":
        rep["objective_change"] = float(new["f"] - old["f"]); changes = [rep["objective_change"]]
    else:
        raise ValueError(kind)
    rep["incomplete"] = bool(any(c >= THRESHOLD - 1e-12 for c in changes) or rep.get("feasibility_transition", False))
    return rep


def stage_doubling(job: dict, out: Path, cuts: int = 0, h4_excluded: bool = False) -> dict:
    T, L = constants(job); cache = SeedCache(); st = settings(job); cell = train_cell(job); rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); orig = search_from_json(rec["attack"])
        new = continue_search(Objective(cell, fam, cache), fam, st, orig)
        _, rrec, _ = reference_of(job, out)
        cands, fams, _ = menu(job, out, cuts, h4_excluded)
        lk = load_locked(); extra = reference_candidates(cell, fam, new, search_from_json(rec["twin"]), [], tuple(lk["reference_order"]))
        newref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache)
        cand, _, _ = reference_of(job, out)                    # held-out diagnostic (design 6.5): the frozen reference, evaluation seeds
        return {**doubling_report("profit", {"attack_f": orig.best_f, "ref_f": float(np.mean(rrec["per_seed_normalized"]))},
                                  {"attack_f": max(new.best_f, orig.best_f), "ref_f": float(np.mean(newref.per_seed_normalized))}),
                "heldout": {"knobs": dict(new.best_knobs), "seeds": list(eval_cell(job).seeds),
                            **gain_fields(eval_cell(job), fam, new.best_knobs, cand, SeedCache())}}
    if job["objective"] in ("W0", "W1"):
        fam = family_for(job["family"], T, L); orig = search_from_json(rec["welfare"])
        ref = np.asarray(reference_of(job, out)[1]["per_seed_normalized"]) if job["objective"] == "W1" else None
        obj = WelfareObjective(cell, fam, cache, ref_normalized=ref)
        obj.extra.update({exact_key(e["knobs"]): {k: v for k, v in e.items() if k != "knobs"} for e in rec["extras"]})
        continue_search(obj, fam, st, orig)
        sel_old = rec["selected"]
from __future__ import annotations

from dataclasses import dataclass
from itertools import product

import numpy as np
from scipy.stats import qmc

from .adaptive import AdaptiveCheat
from .fixed_cheat import FixedCheat


def _sigmoid(x: np.ndarray) -> np.ndarray:
    return 1.0 / (1.0 + np.exp(-x))


def _logit(p: float) -> float:
    p = min(max(p, 1e-12), 1 - 1e-12)
    return float(np.log(p / (1 - p)))


def exact_key(knobs: dict) -> tuple:
    """Identity of a policy: exact values, sorted by name. Used by the archive, the bank, and candidate
    de-duplication, so two distinct policies never share an entry or drop each other."""
    return tuple(sorted((k, float(v)) for k, v in knobs.items()))


def knob_key(knobs: dict) -> tuple:
    """Rounded key (9 decimals) for grouping in reports only; never for de-duplication."""
    return tuple(sorted((k, round(float(v), 9)) for k, v in knobs.items()))


@dataclass(frozen=True)
class Family:
    name: str
    knobs: tuple[str, ...]            # bounded knobs in order, then the binary knobs, "clip" last
    bounds: dict                      # a knob absent here is binary: a logistic coordinate thresholded at 0.5
    factory: object

    @property
    def dim(self) -> int:
        return len(self.knobs)

    def is_binary(self, k: str) -> bool:
        return k not in self.bounds

    def transform(self, x: np.ndarray) -> dict:
        s = _sigmoid(np.asarray(x, dtype=float))
        out = {}
        for k, v in zip(self.knobs, s):
            if self.is_binary(k):
                out[k] = 1 if v >= 0.5 else 0
            else:
                lo, hi = self.bounds[k]
                out[k] = float(lo + (hi - lo) * v)
        return out

    def inverse(self, knobs: dict, near: float = 0.02) -> np.ndarray:
        """Approximate inverse for search starts only; never use it to evaluate an exact point."""
        x = []
        for k in self.knobs:
            if self.is_binary(k):
                x.append(_logit(1 - near if knobs[k] else near))
            else:
                lo, hi = self.bounds[k]
                x.append(_logit((knobs[k] - lo) / (hi - lo)))
        return np.array(x)

    def project(self, knobs: dict) -> dict:
        out = dict(knobs); out["clip"] = 1
        return out

    def make(self, knobs: dict):
        return self.factory(**knobs)

    def corners(self) -> list[dict]:
        seen, out = set(), []
        for bits in product((0, 1), repeat=self.dim):
            k = {}
            for name, b in zip(self.knobs, bits):
                k[name] = b if self.is_binary(name) else float(self.bounds[name][b])
            key = exact_key(k)
            if key not in seen:
                seen.add(key); out.append(k)
        return out

    def honest_point(self) -> dict:
        return {k: ((1 if k == "clip" else 0) if self.is_binary(k) else float(self.bounds[k][0])) for k in self.knobs}

    def registered_starts(self, settings: dict, twin: bool = False) -> list[np.ndarray]:
        near = float(settings["near_corner"])
        lo_x, hi_x = _logit(near), _logit(1 - near)
        honest = np.full(self.dim, lo_x); honest[self.knobs.index("clip")] = hi_x
        cheat = np.full(self.dim, hi_x)
        for name in ("s", "clip"):
            if name in self.knobs:
                cheat[self.knobs.index(name)] = lo_x
        sob = qmc.Sobol(d=self.dim, scramble=True, seed=int(settings["sobol_seed"])).random(4)[1:4]
        sobol = [np.array([_logit(float(v)) for v in row]) for row in sob]
        return ([honest, cheat] if twin else [cheat, honest]) + sobol      # a one-restart attack search starts where cheating is reachable; a twin search where truthful profit is positive


D1 = Family("D1", ("u", "m", "s", "w", "clip"),
            {"u": (0.0, 1.0), "m": (0.0, 1.0), "s": (0.0, 0.3), "w": (0.0, 2.0)}, FixedCheat)
D2 = Family("D2", ("u0", "m0", "s", "d", "r", "w", "clip"),
            {"u0": (0.0, 1.0), "m0": (0.0, 1.0), "s": (0.0, 0.3), "d": (0.0, 1.0), "r": (0.0, 0.2), "w": (0.0, 2.0)},
            AdaptiveCheat)
FAMILIES = {"D1": D1, "D2": D2}


def embed_d1_in_d2(k: dict) -> dict:
    return {"u0": k["u"], "m0": k["m"], "s": k["s"], "d": 0.0, "r": 0.0, "w": k["w"], "clip": k["clip"]}


def embed_d2_in_h3(k: dict) -> dict:
    """Amendment 2: the behaviour-preserving containment of D2 in D2+H3 (x = 0 never exits)."""
    return {**k, "x": 0}


def embed_d2_in_h3_exit(k: dict) -> dict:
    """Amendment 2: the additional replacement-policy transformation (x = 1 exits after a failed audit)."""
    return {**k, "x": 1}


H3_EMBEDDINGS = ("embed_d2_in_h3", "embed_d2_in_h3_exit")
from __future__ import annotations

from ..mechanisms.base import Offer
from .base import Action, ProviderView


class AdaptiveCheat:
    """D2 (spec 5.3). Markup state m_t: m_1 = m0; after a failed audit
    m <- m (1 - d); otherwise m <- min(m0, m + r m0); unchanged during a ban.
    One instance per entity per episode."""
    name = "adaptive_cheat"

    def __init__(self, u0: float, m0: float, s: float, d: float, r: float, w: float, clip: int) -> None:
        if not (0.0 <= u0 <= 1.0 and 0.0 <= m0 <= 1.0 and 0.0 <= s <= 0.3 and 0.0 <= d <= 1.0
                and 0.0 <= r <= 0.2 and 0.0 <= w <= 2.0):
            raise ValueError("D2 knob outside its domain")
        if isinstance(clip, bool) or clip not in (0, 1) or int(clip) != clip:
            raise ValueError("clip must be exactly 0 or 1")
        self.u0, self.m0, self.s, self.d, self.r, self.w, self.clip = float(u0), float(m0), float(s), float(d), float(r), float(w), int(clip)
        self.m = float(m0)
        self._last_t: int | None = None

    def _update_state(self, view: ProviderView) -> None:
        # Apply the recurrence once per round, using what happened last round.
        if self._last_t is not None and view.t > self._last_t and view.history.failed:
            banned_last = bool(view.history.banned_until) and view.history.banned_until[-1] > view.t - 1
            if view.history.failed[-1] > 0:
                self.m *= (1.0 - self.d)
            elif banned_last:
                pass   # banned and not audited last round: state unchanged
            else:
                self.m = min(self.m0, self.m + self.r * self.m0)
        self._last_t = view.t

    def act(self, view: ProviderView) -> Action:
        self._update_state(view)
        p = view.params
        effort = p.q_max * (1.0 - self.u0)
        claim = min(1.0, max(0.0, effort + self.m - self.s))
        if self.clip:
            claim = min(claim, effort)
        return Action(effort=effort, offer=Offer(claim=claim, bid=(1.0 + self.w) * (p.a + p.b * effort)))

