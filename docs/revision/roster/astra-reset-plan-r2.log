from __future__ import annotations

from dataclasses import dataclass
from itertools import product

import numpy as np
from scipy.stats import qmc

from .adaptive import AdaptiveCheat
from .fixed_cheat import FixedCheat


def _sigmoid(x: np.ndarray) -> np.ndarray:
    return 1.0 / (1.0 + np.exp(-x))


def _logit(p: float) -> float:
    p = min(max(p, 1e-12), 1 - 1e-12)
    return float(np.log(p / (1 - p)))


def exact_key(knobs: dict) -> tuple:
    """Identity of a policy: exact values, sorted by name. Used by the archive, the bank, and candidate
    de-duplication, so two distinct policies never share an entry or drop each other."""
    return tuple(sorted((k, float(v)) for k, v in knobs.items()))


def knob_key(knobs: dict) -> tuple:
    """Rounded key (9 decimals) for grouping in reports only; never for de-duplication."""
    return tuple(sorted((k, round(float(v), 9)) for k, v in knobs.items()))


@dataclass(frozen=True)
class Family:
    name: str
    knobs: tuple[str, ...]            # bounded knobs in order, then the binary knobs, "clip" last
    bounds: dict                      # a knob absent here is binary: a logistic coordinate thresholded at 0.5
    factory: object

    @property
    def dim(self) -> int:
        return len(self.knobs)

    def is_binary(self, k: str) -> bool:
        return k not in self.bounds

    def transform(self, x: np.ndarray) -> dict:
        s = _sigmoid(np.asarray(x, dtype=float))
        out = {}
        for k, v in zip(self.knobs, s):
            if self.is_binary(k):
                out[k] = 1 if v >= 0.5 else 0
            else:
                lo, hi = self.bounds[k]
                out[k] = float(lo + (hi - lo) * v)
        return out

    def inverse(self, knobs: dict, near: float = 0.02) -> np.ndarray:
        """Approximate inverse for search starts only; never use it to evaluate an exact point."""
        x = []
        for k in self.knobs:
            if self.is_binary(k):
                x.append(_logit(1 - near if knobs[k] else near))
            else:
                lo, hi = self.bounds[k]
                x.append(_logit((knobs[k] - lo) / (hi - lo)))
        return np.array(x)

    def project(self, knobs: dict) -> dict:
        out = dict(knobs); out["clip"] = 1
        return out

    def make(self, knobs: dict):
        return self.factory(**knobs)

    def corners(self) -> list[dict]:
        seen, out = set(), []
        for bits in product((0, 1), repeat=self.dim):
            k = {}
            for name, b in zip(self.knobs, bits):
                k[name] = b if self.is_binary(name) else float(self.bounds[name][b])
            key = exact_key(k)
            if key not in seen:
                seen.add(key); out.append(k)
        return out

    def honest_point(self) -> dict:
        return {k: ((1 if k == "clip" else 0) if self.is_binary(k) else float(self.bounds[k][0])) for k in self.knobs}

    def registered_starts(self, settings: dict, twin: bool = False) -> list[np.ndarray]:
        near = float(settings["near_corner"])
        lo_x, hi_x = _logit(near), _logit(1 - near)
        honest = np.full(self.dim, lo_x); honest[self.knobs.index("clip")] = hi_x
        cheat = np.full(self.dim, hi_x)
        for name in ("s", "clip"):
            if name in self.knobs:
                cheat[self.knobs.index(name)] = lo_x
        sob = qmc.Sobol(d=self.dim, scramble=True, seed=int(settings["sobol_seed"])).random(4)[1:4]
        sobol = [np.array([_logit(float(v)) for v in row]) for row in sob]
        return ([honest, cheat] if twin else [cheat, honest]) + sobol      # a one-restart attack search starts where cheating is reachable; a twin search where truthful profit is positive


D1 = Family("D1", ("u", "m", "s", "w", "clip"),
            {"u": (0.0, 1.0), "m": (0.0, 1.0), "s": (0.0, 0.3), "w": (0.0, 2.0)}, FixedCheat)
D2 = Family("D2", ("u0", "m0", "s", "d", "r", "w", "clip"),
            {"u0": (0.0, 1.0), "m0": (0.0, 1.0), "s": (0.0, 0.3), "d": (0.0, 1.0), "r": (0.0, 0.2), "w": (0.0, 2.0)},
            AdaptiveCheat)
FAMILIES = {"D1": D1, "D2": D2}


def embed_d1_in_d2(k: dict) -> dict:
    return {"u0": k["u"], "m0": k["m"], "s": k["s"], "d": 0.0, "r": 0.0, "w": k["w"], "clip": k["clip"]}


def embed_d2_in_h3(k: dict) -> dict:
    """Amendment 2: the behaviour-preserving containment of D2 in D2+H3 (x = 0 never exits)."""
    return {**k, "x": 0}


def embed_d2_in_h3_exit(k: dict) -> dict:
    """Amendment 2: the additional replacement-policy transformation (x = 1 exits after a failed audit)."""
    return {**k, "x": 1}


H3_EMBEDDINGS = ("embed_d2_in_h3", "embed_d2_in_h3_exit")
from __future__ import annotations

from ..mechanisms.base import Offer
from .base import Action, ProviderView


class AdaptiveCheat:
    """D2 (spec 5.3). Markup state m_t: m_1 = m0; after a failed audit
    m <- m (1 - d); otherwise m <- min(m0, m + r m0); unchanged during a ban.
    One instance per entity per episode."""
    name = "adaptive_cheat"

    def __init__(self, u0: float, m0: float, s: float, d: float, r: float, w: float, clip: int) -> None:
        if not (0.0 <= u0 <= 1.0 and 0.0 <= m0 <= 1.0 and 0.0 <= s <= 0.3 and 0.0 <= d <= 1.0
                and 0.0 <= r <= 0.2 and 0.0 <= w <= 2.0):
            raise ValueError("D2 knob outside its domain")
        if isinstance(clip, bool) or clip not in (0, 1) or int(clip) != clip:
            raise ValueError("clip must be exactly 0 or 1")
        self.u0, self.m0, self.s, self.d, self.r, self.w, self.clip = float(u0), float(m0), float(s), float(d), float(r), float(w), int(clip)
        self.m = float(m0)
        self._last_t: int | None = None

    def _update_state(self, view: ProviderView) -> None:
        # Apply the recurrence once per round, using what happened last round.
        if self._last_t is not None and view.t > self._last_t and view.history.failed:
            banned_last = bool(view.history.banned_until) and view.history.banned_until[-1] > view.t - 1
            if view.history.failed[-1] > 0:
                self.m *= (1.0 - self.d)
            elif banned_last:
                pass   # banned and not audited last round: state unchanged
            else:
                self.m = min(self.m0, self.m + self.r * self.m0)
        self._last_t = view.t

    def act(self, view: ProviderView) -> Action:
        self._update_state(view)
        p = view.params
        effort = p.q_max * (1.0 - self.u0)
        claim = min(1.0, max(0.0, effort + self.m - self.s))
        if self.clip:
            claim = min(claim, effort)
        return Action(effort=effort, offer=Offer(claim=claim, bid=(1.0 + self.w) * (p.a + p.b * effort)))
"""X7-SC, the state-conditioned attack family (design 5.2). D2's markup recurrence, persisting across identities as in
D2+H3; phase multipliers for fresh, established, and terminal rounds, where a phase reads the identity's age and its own
passed audits; a reset after a failed audit unless the remaining horizon is at most h_R; a voluntary reset when the
identity's own audit rate over its last L rounds exceeds lambda. Reads only the provider view and the rule's public
constants T and L, injected at construction. Per round: (1) markup update from round t - 1, once; (2) failure trigger;
(3) voluntary trigger if no failure trigger; (4) exit and new creation round t; (5) phase of the identity that serves in
round t; (6) action. The harness asks for the action before it creates the replacement and applies the exit before the
offer, so the exit round's action is the replacement's."""
from __future__ import annotations

from scipy.stats import qmc

from ..mechanisms.base import Offer
from .base import Action, ProviderView
from .families import Family, exact_key

KNOBS = ("u0", "m0", "s", "d", "r", "w", "k_F", "k_T", "a_F", "n_P", "h_R", "a_R", "e_P", "lambda", "clip")
SOBOL_SEED = 20261028
X7_CORNER_COUNT = 771                                # distinct corners and projections for 15 knobs with scipy 1.18.1 (design 5.2)
FRESH, ESTABLISHED, TERMINAL = "fresh", "established", "terminal"


class X7Policy:
    name = "x7_state_conditioned"

    def __init__(self, u0, m0, s, d, r, w, k_F, k_T, a_F, n_P, h_R, a_R, e_P, lam, clip, T: int, L: int) -> None:
        self.T, self.L = int(T), int(L)
        vals = dict(u0=u0, m0=m0, s=s, d=d, r=r, w=w, k_F=k_F, k_T=k_T, a_F=a_F, n_P=n_P, h_R=h_R, a_R=a_R, e_P=e_P, lam=lam)
        dom = dict(u0=(0, 1), m0=(0, 1), s=(0, 0.3), d=(0, 1), r=(0, 0.2), w=(0, 2), k_F=(0, 1), k_T=(0, 2), a_F=(0, 60), n_P=(0, 30),
                   h_R=(0, self.T), a_R=(0, self.T), e_P=(0, 1), lam=(0, 1))
        for k, v in vals.items():
            if not (dom[k][0] <= float(v) <= dom[k][1]):
                raise ValueError(f"X7-SC knob {k} outside its domain")
        if isinstance(clip, bool) or clip not in (0, 1) or int(clip) != clip:
            raise ValueError("clip must be exactly 0 or 1")
        for k, v in vals.items():
            setattr(self, k, float(v))
        self.clip = int(clip)
        self.m = float(m0)
        self.c = 0                                   # creation round of the current identity
        self.p_own = 0                               # passes since the identity's last failure (design draft 7, 5.2)
        self._p_upto = 0                             # rounds of history already folded into p_own
        self.waiting = False                         # a failure was rejected by the age gate and the identity has not served since
        self._last_t: int | None = None
        self._last: Action | None = None
        self.resets_failure = self.resets_voluntary = 0
        self.last_phase: str | None = None

    def _update_markup(self, view: ProviderView) -> None:
        h = view.history
        if self._last_t is not None and view.t > self._last_t and h.failed:
            banned_last = bool(h.banned_until) and h.banned_until[-1] > view.t - 1
            if h.failed[-1] > 0:
                self.m *= (1.0 - self.d)
            elif not banned_last:
                self.m = min(self.m0, self.m + self.r * self.m0)

    def _window(self, view: ProviderView, lo: int) -> tuple[int, int, int]:
        h, t = view.history, view.t
        rng = range(max(lo, 0), t)
        return sum(h.served[k] for k in rng), sum(h.audited[k] for k in rng), sum(h.failed[k] for k in rng)

    def _update_p_own(self, view: ProviderView) -> None:
        """Batch update of the identity's pass count after each round's audit results, as C's credibility state."""
        h = view.history
        for k in range(max(self._p_upto, self.c), view.t):
            self.p_own = 0 if h.failed[k] > 0 else self.p_own + (h.audited[k] - h.failed[k])
        self._p_upto = max(self._p_upto, view.t)

    def act(self, view: ProviderView) -> Action:
        t = int(view.t)
        if self._last_t == t and self._last is not None:
            return self._last
        self._update_markup(view)
        self._update_p_own(view)
        h = view.history
        exit_ = False
        failed_last = bool(h.failed) and h.failed[-1] > 0
        if self.waiting and h.served and h.served[-1] >= 1 and not failed_last:
            self.waiting = False                     # the identity has served again after waiting out its ban
        banned_now = bool(h.banned_until) and h.banned_until[-1] > t
        if failed_last and self.T - t > self.h_R and (t - self.c) < self.a_R:
            exit_ = True; self.resets_failure += 1
        elif failed_last and self.T - t > self.h_R:
            self.waiting = True                      # the age gate rejected the reset: wait, keep age and pass history
        elif not self.waiting and not banned_now:
            served, audited, _ = self._window(view, max(self.c, t - self.L))
            if served >= 1 and audited / served > self.lam:
                exit_ = True; self.resets_voluntary += 1
        if exit_:
            self.c = t; self.p_own = 0; self._p_upto = t; self.waiting = False
        served_w, audited_w, _ = self._window(view, max(self.c, t - self.L))
        exposed = served_w >= 1 and audited_w / served_w > self.e_P
        if self.T - t <= self.L:
            phase = TERMINAL
        elif (t - self.c) < self.a_F or self.p_own < self.n_P or exposed:
            phase = FRESH
        else:
            phase = ESTABLISHED
        k = {FRESH: self.k_F, ESTABLISHED: 1.0, TERMINAL: self.k_T}[phase]
        p = view.params
        effort = p.q_max * (1.0 - min(1.0, k * self.u0))
        claim = min(1.0, max(0.0, effort + k * self.m - self.s))
        if self.clip:
            claim = min(claim, effort)
        self.last_phase, self._last_t = phase, t
        self._last = Action(effort=effort, offer=Offer(claim=claim, bid=(1.0 + self.w) * (p.a + p.b * effort)), exit=exit_)
        return self._last


def x7_family(T: int, L: int) -> Family:
    bounds = {"u0": (0.0, 1.0), "m0": (0.0, 1.0), "s": (0.0, 0.3), "d": (0.0, 1.0), "r": (0.0, 0.2), "w": (0.0, 2.0), "k_F": (0.0, 1.0),
              "k_T": (0.0, 2.0), "a_F": (0.0, 60.0), "n_P": (0.0, 30.0), "h_R": (0.0, float(T)), "a_R": (0.0, float(T)), "e_P": (0.0, 1.0),
              "lambda": (0.0, 1.0)}

    def factory(**k):
        k = dict(k); k["lam"] = k.pop("lambda")
        return X7Policy(**k, T=T, L=L)
    return Family("X7-SC", KNOBS, bounds, factory)


def embed_h3(knobs: dict, T: int) -> dict:
    """D2+H3 knobs (with x) to the X7-SC point with identical behaviour."""
    return {"u0": knobs["u0"], "m0": knobs["m0"], "s": knobs["s"], "d": knobs["d"], "r": knobs["r"], "w": knobs["w"], "k_F": 1.0,
            "k_T": 1.0, "a_F": 0.0, "n_P": 0.0, "h_R": 0.0 if int(knobs["x"]) else float(T), "a_R": float(T), "e_P": 1.0, "lambda": 1.0,
            "clip": knobs["clip"]}


def _corner(fam: Family, bits) -> dict:
    return {n: (int(b) if fam.is_binary(n) else float(fam.bounds[n][int(b)])) for n, b in zip(fam.knobs, bits)}


def x7_corners(fam: Family) -> list[dict]:
    """For any family (X7-SC and H4, design draft 7): 512 scrambled-Sobol corners (bit 1 when a coordinate is >= 0.5), de-duplicated in order, then the all-low and
    all-high corners if absent (a bounded diagnostic, not exhaustive coverage)."""
    pts = qmc.Sobol(d=len(fam.knobs), scramble=True, seed=SOBOL_SEED).random_base2(9)
    out, seen = [], set()
    for row in pts:
        k = _corner(fam, row >= 0.5); key = exact_key(k)
        if key not in seen:
            seen.add(key); out.append(k)
    for bits in ([0] * len(fam.knobs), [1] * len(fam.knobs)):
        k = _corner(fam, bits); key = exact_key(k)
        if key not in seen:
            seen.add(key); out.append(k)
    return out


def corner_vectors(fam: Family) -> list[dict]:
    """The corners and their truthful projections, de-duplicated by exact key across both."""
    out, seen = [], set()
    for k in x7_corners(fam) + [fam.project(c) for c in x7_corners(fam)]:
        key = exact_key(k)
        if key not in seen:
            seen.add(key); out.append(k)
    return out
"""The protocol-v2 manifest (design draft 7: 8.1, 8.1a, 8.2, 6.5, 6.6, 6.7), read from experiments/revision-v2-manifest.yaml:
the 287 search cells and 3 diagnostic cells, the 98 doubling checks, the 14 fixed-attack cross-evaluations, the execution
priority, the pre-stated cut order, per context the records a final freeze requires and the reference-bank rules, the
distinct-rule check (design 3.4), and the question-to-cell map (design 8.1a)."""
from __future__ import annotations

from functools import lru_cache
from pathlib import Path

import json
import math

import yaml

ROOT = Path(__file__).resolve().parents[1]
PATH = ROOT / "experiments/revision-v2-manifest.yaml"
Q1_Q4_RULES = ("F000", "F111", "C*")
FACTORIAL = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111")
MATCHED = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111", "C*", "C*/S0")
FIXED = MATCHED + ("C*/S2", "R4")                    # rules at the fixed pair (R4 and C*/S2 only in the rho = 1 repair block)
MENU_FAMILIES = ("D2+H3", "X7-SC")
SECONDARY = ("B3-t", "R3-t", "C*-t")
CORE = ("F000", "F111", "C*")
J, L_FIXED = 50, 10


@lru_cache(maxsize=1)
def doc() -> dict:
    return yaml.safe_load(PATH.read_text())


CUT_ORDER = tuple(doc()["cut_order"])


def context(market: str, rho: float = 0.2) -> str:
    return f"{market}@rho{rho:g}" if rho != 0.2 else f"{market}@rho0.2"


def _cell(block, market, rho, rule, family, objective, c=None, schedule=None) -> dict:
    ctx = context(market, rho)
    cid = f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")
    return {"id": cid, "block": block, "market": market, "context": ctx, "rho": rho, "rule": rule, "family": family, "objective": objective,
            "c": c, "schedule": schedule}


def _families(b: dict, market: str) -> list:
    if "families_by_market" in b:
        return b["families_by_market"]["headline" if market == "headline" else "fresh"]
    return b["families"]


def headline_a_tot(rho: float) -> int:
    """A_tot = floor(beta S_hat / (rho m)) = floor((beta / rho) n_FB) on the headline calibration (design 3.4)."""
    n_fb = float(json.loads((ROOT / "experiments/calibration.json").read_text())["n_FB"])
    return int(math.floor(0.05 / float(rho) * n_fb + 1e-12))


def _descriptor(rule: str, a_tot: int) -> tuple:
    """(selection, pacing schedule) of a rule at the fixed pair; rules with their own parameters are unique."""
    if rule in FACTORIAL:
        pacing = ("reserve", min(J * L_FIXED, a_tot)) if rule[3] == "1" else ("spread",)
        return (("factorial", rule[1], rule[2]), pacing)
    if rule == "R4":
        return (("factorial", "1", "1"), ("reserve", min(J * L_FIXED, a_tot // 2)))
    if rule in ("C*", "C*/S0", "C*/S2"):
        pacing = {"C*": ("reserve", min(J * L_FIXED, a_tot)), "C*/S0": ("spread",), "C*/S2": ("reserve", min(J * L_FIXED, a_tot // 2))}[rule]
        return (("credibility",), pacing)
    return (("own", rule), ("own", rule))


def distinct_rule_problems(cs: list[dict], a_tot: dict) -> list[str]:
    """Design 3.4: no two rules compared in one block and context may have the same selection and pacing schedule."""
    seen: dict = {}; out = []
    for c in cs:
        key = (c["block"], c["context"], _descriptor(c["rule"], int(a_tot[c["context"]])))
        other = seen.setdefault(key, c["rule"])
        if other != c["rule"]:
            out.append(f"{c['block']} {c['context']}: {other} and {c['rule']} have the same selection and pacing")
    return sorted(set(out))


def cells() -> list[dict]:
    d = doc(); out = []
    for name, b in d["blocks"].items():
        markets = d["markets"] if b["markets"] == "all" else b["markets"]
        rho = float(b.get("rho", 0.2))
        objectives = b.get("objectives", [b.get("objective")])
        for m in markets:
            for r in b["rules"]:
                for f in _families(b, m):
                    for o in objectives:
                        if "c" in b:
                            out.extend(_cell(name, m, rho, r, f, o, c, s) for c in b["c"] for s in b["schedules"])
                        else:
                            out.append(_cell(name, m, rho, r, f, o))
    problems = distinct_rule_problems(out, {c["context"]: headline_a_tot(c["rho"]) for c in out})
    if problems:
        raise ValueError(f"manifest refused: {problems}")
    return out


def menu_families(ctx: str, rule: str) -> tuple[str, ...]:
    """Design 6.4: the secondary whole systems on fresh markets have the reduced D2+H3 menu; every other reference both."""
    return ("D2+H3",) if rule in SECONDARY and ctx.startswith("fresh") else MENU_FAMILIES


def _cut(cell: dict, spec: dict) -> bool:
    if spec.get("markets") == "fresh" and not cell["market"].startswith("fresh"):
        return False
    return all(cell[k] == v for k, v in (("block", spec.get("block")), ("family", spec.get("family")), ("rule", spec.get("rule"))) if v is not None)


def effective(cuts: int = 0, h4_excluded: bool = False) -> list[dict]:
    out = cells()
    for spec in CUT_ORDER[: int(cuts)]:
        out = [c for c in out if not _cut(c, spec)]
    if h4_excluded:
        out = [c for c in out if c["family"] != "H4"]
    return out


def doublings() -> list[str]:
    out = []
    for c in cells():
        if c["market"] == "headline" and c["rho"] == 0.2 and c["block"] in ("matched", "welfare", "coalition", "coalition_roles"):
            out.append(c["id"])
        elif c["market"].startswith("fresh") and c["block"] == "matched" and c["rule"] in Q1_Q4_RULES:
            out.append(c["id"])
    return out


def cross_evaluations() -> list[tuple[str, str]]:
    return [(context(m), f) for m in doc()["markets"] for f in MENU_FAMILIES]


def priority(cell: dict) -> int:
    if cell["block"] == "matched":
        return 0 if cell["rule"] in Q1_Q4_RULES else 1
    if cell["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic") or (cell["block"] == "extras" and cell["family"] in ("X5-AG/v2", "H4")):
        return 2
    return 3


def bank_rules(ctx: str, family: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    present = {c["rule"] for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["family"] == family and c["objective"] == "profit"}
    return [r for r in FIXED if r in present]


def required(ctx: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    cs = [c for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["block"] != "diagnostic"]   # diagnostics run after the freeze
    req = [c["id"] for c in cs]
    rules = sorted({c["rule"] for c in cs if c["objective"] != "coalition"}, key=lambda r: (r not in FIXED, r))
    req += [f"reference/{ctx}/{r}" for r in rules]
    groups: dict = {}
    for c in cs:
        if c["objective"] in ("total", "min"):
            groups.setdefault(f"{c['rule']}_c{c['c']}", set()).add(c["schedule"] if c["family"] == "X6-SE/v2" else None)
    for tag, schedules in groups.items():                  # design draft 7, 6.3: one coalition group per rule and c
        req += [f"joint_twin/{ctx}/{tag}_{s}" for s in ("synchronised", "staggered") if s in schedules]
        req += [f"{kind}/{ctx}/{tag}" for kind in ("joint_reference_pre", "joint_reference", "coalition_select")]
    env_rules = sorted({c["rule"] for c in cs if c["block"] == "extras"})
    req += [f"envelope/{ctx}/{r}" for r in env_rules]
    if any(c["block"] == "matched" for c in cs) and ctx in {context(m) for m in doc()["markets"]}:
        req += [f"bank/{ctx}/{f}" for f in MENU_FAMILIES]
        req += [f"bank_train/{ctx}/{f}" for f in MENU_FAMILIES]                          # design draft 7, 6.6: before the freeze
        req += [f"envelope_select/{ctx}/{r}/{f}" for f in MENU_FAMILIES for r in FACTORIAL
                if any(c["rule"] == r and c["family"] == f and c["block"] == "matched" for c in cs)]
    req += sorted({f"welfare_select/{ctx}/{c['rule']}/{c['objective']}" for c in cs if c["block"] == "welfare"},
                  key=lambda x: (CORE.index(x.split("/")[2]), x))                         # design draft 7, 6.2
    return req


def _ids(pred, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    return [c["id"] for c in effective(cuts, h4_excluded) if pred(c)]


def _fresh(c: dict) -> bool:
    return c["market"].startswith("fresh")


QUESTIONS = {
    "Q1": {"cells": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F111", "C*") and c["family"] in MENU_FAMILIES,
           "checks": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F111", "C*") and c["family"] in MENU_FAMILIES},
    "Q2": {"cells": lambda c: c["block"] == "matched" and c["rule"] in FACTORIAL and c["rho"] == 0.2,
           "checks": lambda c: c["market"] == "headline" and c["block"] == "matched" and c["rule"] in FACTORIAL},
    "Q3": {"cells": lambda c: c["rho"] == 0.2 and c["rule"] in CORE and (c["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic")
                                                                         or c["family"] in ("D2+H3", "X7-SC", "X5-AG/v2", "H4") and c["block"] in ("matched", "extras")),
           "checks": lambda c: c["rule"] in CORE and c["rho"] == 0.2 and (c["block"] in ("welfare", "coalition", "coalition_roles") or c["block"] == "matched")},
    "Q4": {"cells": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F000", "F111") and c["family"] == "D2+H3",
           "checks": lambda c: _fresh(c) and c["block"] == "matched" and c["rule"] in ("F000", "F111") and c["family"] == "D2+H3"},
    "repair": {"cells": lambda c: c["block"] == "repair", "checks": lambda c: False},
    "whole": {"cells": lambda c: c["block"] == "tuned", "checks": lambda c: False},
}


def question_cells(name: str, cuts: int = 0, h4_excluded: bool = False) -> dict:
    """Design 8.1a: the cells a question needs and the scheduled doubling checks it depends on (cross-evaluations for Q2)."""
    q = QUESTIONS[name]; dbl = set(doublings())
    out = {"cells": _ids(q["cells"], cuts, h4_excluded), "checks": [i for i in _ids(q["checks"], cuts, h4_excluded) if i in dbl]}
    if name == "Q2":
        out["cross"] = [f"cross/{ctx}/{f}" for ctx, f in cross_evaluations()]
    return out

