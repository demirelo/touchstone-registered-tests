   199	    """Run B: for every gate cell, a passing gate record from the Mac and one from this machine (same numerical stack),
   200	    each with exactly the expected binding (full-budget provenance, gate settings, input hashes, driver, dependencies)."""
   201	    recs = [read(p) for p in paths]; here = environment()
   202	    for cell, b in want.items():
   203	        for site in ("mac", "pod"):
   204	            ok = [r for r in recs if r and r.get("stage") == "convergence gate" and r.get("cell") == cell and r.get("site") == site
   205	                  and r.get("pass") is True and r.get("binding") == b and (site == "mac" or same_environment(r.get("environment") or {}, here))]
   206	            if not ok:
   207	                _refuse(f"no valid {site} gate evidence for {cell}")
