   374	    paid = a.site == "pod" and not a.smoke
   375	    stop = G.paid_cost_stop(a.cap, a.rate, a.started, a.attempts, a.ledger, a.run_tag, stop_file=a.stop_file, soft_deadline=a.soft) if paid else None
   376	    cargs = worker_cost_args(stop) if paid else None
   377	    files = {"driver": Path(__file__), "plan": HERE / "convergence-plan.md", "report": Path(a.report), "posthoc": Path(a.posthoc)}
   378	    if a.gate:
