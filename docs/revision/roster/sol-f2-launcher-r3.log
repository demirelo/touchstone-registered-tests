   212	
   213	def _required_records(d: Path, stage: str, cell: str) -> list:
   214	    if stage == "reproduction gate":
   215	        return ["gate.json", "inputs.json", str(F.R.path_of(d, cell).relative_to(d)), str(F.R.eval_path(d, cell).relative_to(d)),
   216	                f"freeze/{cell.split('|')[0]}.json"]
   217	    return ["gate.json", "inputs.json", str(F.R.path_of(d, cell).relative_to(d)), f"doubling/{F.R._safe(cell)}.json"]
   218	
   219	
   220	def _deps_ok(d: Path, up: dict, want_ids: set) -> bool:
   221	    return set(up) == set(want_ids) and all(F.R.path_of(d, u).exists() and sha_file(F.R.path_of(d, u)) == h for u, h in up.items())
   222	
   223	
   224	def _supporting_problems(d: Path, stage: str, cell: str, inp: dict, srch, src) -> list:
   225	    """The supporting records' stages, provenance, dependency sets, dependency hashes, and the freeze contents."""
   226	    out, ctx = [], cell.split("|")[0]
   227	    reg = read(F.R.path_of(src, cell)) if src is not None else None
   228	    if reg is not None and srch is not None and any((srch.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV):
   229	        out.append("search provenance differs from the registered record")
   230	    if stage == "reproduction gate":
   231	        fr, ev = read(d / "freeze" / f"{ctx}.json"), read(F.R.eval_path(d, cell))
   232	        want = {r: h for r, h in inp.items() if r.startswith(ctx) or f"/{ctx}/" in r}
   233	        want[cell] = sha_file(F.R.path_of(d, cell)) if F.R.path_of(d, cell).exists() else None
   234	        if fr is None or fr.get("stage") != "freeze" or fr.get("followup") is not True or fr.get("cuts") != F.CUTS or fr.get("h4_excluded") != F.H4_EXCLUDED \
   235	                or not fr.get("records") or fr["records"] != want or not _deps_ok(d, fr["records"], set(want)):
   236	            out.append("freeze empty, incomplete, or stale")
   237	        if ev is None or ev.get("stage") != "evaluate" or ev.get("id") != cell or ev.get("provenance") != (srch or {}).get("provenance") \
   238	                or not _deps_ok(d, ev.get("upstream") or {}, {cell, f"reference/{ctx}/{cell.split('|')[1]}", f"freeze/{ctx}"}):
   239	            out.append("evaluation record: stage, provenance, or dependencies wrong")
   240	    else:
   241	        db = read(d / "doubling" / (F.R._safe(cell) + ".json"))
   242	        if db is None or db.get("stage") != "doubling" or db.get("id") != cell or not _deps_ok(d, db.get("upstream") or {}, set(inp)) \
   243	                or (reg is not None and any((db.get("provenance") or {}).get(k) != reg["provenance"].get(k) for k in F.EXACT_PROV)):
   244	            out.append("doubling record: stage, provenance, or dependencies wrong")
   245	    return out
