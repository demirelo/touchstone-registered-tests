   327	    "== GATE FAILED"*|"== RUN FAILED"*|"== STOPPED BEFORE"*) state="$(echo "$last" | head -c 160)"; exit 1 ;;
   328	  esac
   329	done
   240	            reg = read(reference) if reference is not None else read(Path(src) / "doubling" / (R._safe(job["id"]) + ".json"))
