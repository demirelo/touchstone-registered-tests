   392	    path = lambda j: out / "convergence" / (R._safe(j["id"]) + ".json")
   393	    todo = sorted((j for j in jobs if not G.reusable(path(j), bind(j))), key=lambda j: j["family"] != "X7-SC")   # longest first
   394	    minr = lambda j: 2 if j["id"] in plan["nesting"] else 1
   395	    args = [(j, out, a.max_rounds, None if a.smoke else a.src, cargs, hours(j), emb(j), minr(j)) for j in todo]
   396	    from concurrent.futures import ProcessPoolExecutor
   397	    if a.workers > 1 and len(todo) > 1:
   398	        with ProcessPoolExecutor(max_workers=a.workers) as ex:
   399	            res = list(ex.map(run_cell, *zip(*args)))
   400	    else:
   401	        res = [run_cell(*x) for x in args]
   402	    for j, rec in zip(todo, res):
   403	        write(path(j), {**rec, "binding": bind(j)})
   404	    status = {j["id"]: read(path(j))["status"] for j in jobs}
   405	    mismatch = [k for k, v in status.items() if v.startswith("stopped: round 1")]
   406	    if not a.smoke and not mismatch:
   407	        done = {j["id"]: bind(j) for j in jobs if "heldout" in read(path(j))}           # cost-stopped cells keep their frozen estimates
   408	        nest_done = {k: read(out / "convergence" / (R._safe(k) + ".json"))["heldout"]["gain"] for k in plan["nesting"] if k in done}
   409	        write(out / "recompute.json", {**recompute(a.src, out, expected=done), "nesting_shortfall": shortfall_report(nesting, nest_done)})
   410	    G.inventory(out, DEVIATIONS, files, argv)
   411	    print(json.dumps({"cells": len(jobs), "status": status}))
   412	    return 4 if mismatch else 0
