   259	
   260	def frozen_doubling(job: dict, out) -> Path:
   261	    """The frozen doubling stage (revision_v2.stage_doubling) for this cell on this machine, saved as a reference record."""
   262	    p = Path(out) / "gate" / "frozen" / (R._safe(job["id"]) + ".json")
   263	    if read(p) is None:
   264	        write(p, {"stage": "doubling", "id": job["id"], **R.stage_doubling(job, Path(out), CUTS, H4_EXCLUDED)})
   265	    return p
   266	
   267	
   268	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   269	    """Gate mode: round 1 only. On the Mac it is compared with the frozen doubling stage run on the same machine (flagged
   270	    cells diverge across platforms); on the pod, with the registered doubling record. Saved full-budget evidence bound to
   271	    the cell's inputs, this driver, the site, and the environment."""
   272	    ref = frozen_doubling(job, out) if site == "mac" else None
   273	    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours, reference=ref)
   274	    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
   275	    stopped = r.get("round1_gate") == "not run"        # refused by the cell's own admission before round 1: a cost stop, not a mismatch
   276	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "cost_stopped": stopped, "cost": r.get("cost") if stopped else None, "site": site, "compared_with": "frozen stage, same machine" if ref else "registered record",
   277	            "comparison": r["round1_gate"],
   278	            "round1": (r.get("rounds") or [None])[0],
   279	            "binding": bind, "environment": G.environment()}
   280	
   281	
   282	def _cell_gains(src, conv, rid: str, expected: dict):
   283	    f = read(R.eval_path(src, rid))
   284	    if rid not in expected:
   285	        return f["gain"], f["gain"], False
   286	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   287	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   288	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   289	    g = c["heldout"]["gain"]
   290	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   291	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   292	    return f["gain"], g, True
   293	
   294	
   295	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   296	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   297	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   298	    expected = expected or {}
   299	    for rid in expected:
   300	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   301	            raise ValueError(f"{rid}: the run's result is missing")
   302	    sub, out = [], {}
   303	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   304	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   305	        for m in markets:
   306	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   307	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   308	                continue
   309	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra, expected), _cell_gains(src, conv, rb, expected)
   310	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   311	            sub += [r for r, s_ in ((ra, sa), (rb, sb)) if s_ and r not in sub]
   312	        if fz_a:
   313	            out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   314	    return {"label": "exploratory sensitivity; the frozen estimates stay primary; " + C.SCOPE, **out, "substituted": sub}
