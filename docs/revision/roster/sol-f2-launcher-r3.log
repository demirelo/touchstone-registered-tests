    43	def binding(inputs_sha: str, provenance: dict, smoke: bool, settings: dict, driver_sha: str, deps: dict | None = None) -> dict:
    44	    """`deps`: hashes of everything else a result depends on (helpers, plan, report, posthoc, registered records)."""
    45	    b = {"inputs_sha": inputs_sha, "provenance": provenance, "smoke": bool(smoke), "settings": settings, "driver_sha": driver_sha, "deps": dict(deps or {})}
    46	    return json.loads(json.dumps(b, default=float))              # the form it has when read back (tuples become lists)
