   295	B=\$R/bundle; L=results/logs
   296	IN="--src \$B/eval-all --draw \$B/draw/draw.json --instances \$B/draw/instances.json --cfgs \$B/deviation/cfg_linux.json --addendum \$B/report/addendum.json --report \$B/report/report.json"
   297	PAID="--cap-usd $CAP --usd-per-hour $MAXCPH --started-at $a0 --attempts \$R/f2.attempts --ledger \$R/f2.ledger.json --run-tag $RUNTAG --stop-file \$R/STOP --soft-deadline $soft"
   298	# step NAME HOURS: before a paid step, the launcher's STOP file and soft deadline, then the admission (guards.py admit;
