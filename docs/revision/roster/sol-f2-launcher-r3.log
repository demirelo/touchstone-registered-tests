    49	def reusable(path, b: dict) -> bool:
    50	    """False if nothing is saved; True if the saved result has this exact binding; refused otherwise (never overwritten)."""
    51	    rec = read(path)
    52	    if rec is None:
    53	        return False
    54	    if rec.get("binding") != b:
    55	        _refuse(f"{path}: a saved result with another binding exists")
    56	    return True
