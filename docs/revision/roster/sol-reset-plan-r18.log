    31	        q = json.dumps({"query": "query { myself { clientBalance currentSpendPerHr } }"}).encode()
    32	        req = urllib.request.Request("https://api.runpod.io/graphql", data=q, method="POST",
    33	                                     headers={"Authorization": f"Bearer {KEY}", "Content-Type": "application/json", "User-Agent": "curl/8.7.1"})
    34	        with urllib.request.urlopen(req, timeout=60) as r:
    35	            m = json.loads(r.read().decode())["data"]["myself"]
    36	        print(json.dumps({"balance": m["clientBalance"], "spendPerHr": m["currentSpendPerHr"]}))
    37	    elif cmd == "get": print(json.dumps(api("GET", f"/pods/{args[0]}"), indent=1)[:1500])
    38	    elif cmd == "delete": print(api("DELETE", f"/pods/{args[0]}"))
    39	    elif cmd == "ssh": r = ssh(args[0], args[1]); print(r.stdout, r.stderr, "exit", r.returncode); return r.returncode
    40	    elif cmd == "push": r = rsync(args[0], args[1], args[2]); print(r.stdout[-300:], r.stderr[-300:], "exit", r.returncode); return r.returncode
    41	    elif cmd == "pull": r = rsync(args[0], args[1], args[2], pull=True); print(r.stdout[-300:], r.stderr[-300:], "exit", r.returncode); return r.returncode
