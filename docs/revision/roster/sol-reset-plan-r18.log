    20	    return subprocess.run(["ssh", "-i", SSHKEY, "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=20", "-p", str(port), f"root@{ip}", cmd],
    21	                          capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    22	def rsync(pod_id, src, dst, pull=False):
    23	    ip, port = target(pod_id)
    24	    e = f"ssh -i {SSHKEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p {port}"
    25	    a, b = (f"root@{ip}:{src}", dst) if pull else (src, f"root@{ip}:{dst}")
    26	    return subprocess.run(["rsync", "-az", "-e", e, a, b], capture_output=True, text=True)
