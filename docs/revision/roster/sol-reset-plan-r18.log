    19	class Fake:
    20	    """A fake Runpod: pods by id -> name; `fail_list` listings fail; a pod in `stuck` survives `stuck[id]` deletes."""
    21	    def __init__(self, pods=None, fail_list=0, stuck=None, prices=None):
    22	        self.pods = dict(pods or {}); self.fail_list = fail_list; self.stuck = dict(stuck or {}); self.t = 0.0; self.calls = []
    23	        self.prices = dict(prices or {})
    24	    def run(self, args, timeout=60):
    25	        self.calls.append(args[0]); self.t += 1
    26	        if args[0] == "list":
    27	            if self.fail_list > 0:
    28	                self.fail_list -= 1; return 1, ""
    29	            return 0, json.dumps([{"id": i, "name": n, "costPerHr": self.prices.get(i, 0.5)} for i, n in self.pods.items()])
    30	        if args[0] == "delete":
    31	            pid = args[1]
    32	            if self.stuck.get(pid, 0) > 0:
    33	                self.stuck[pid] -= 1
    34	            else:
    35	                self.pods.pop(pid, None)
    36	            return 0, "{}"
    37	        return 0, ""
    38	    def clock(self):
    39	        return self.t
    40	    def sleep(self, s):
    41	        self.t += max(s, 0.01)
