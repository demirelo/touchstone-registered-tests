   309	    ap.add_argument("--gate", choices=("first", "only", "skip"), default="first", help="the p = 0 reproduction gate (plan section 3 c)")
   310	    ap.add_argument("--smoke", action="store_true")
   311	    a = ap.parse_args(argv); base = Path(a.out); F.check_out(base, a.src)
   312	    from sim.records import cfg_from_dict
   313	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   314	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   315	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   316	    params = json.loads(Path(a.params).read_text())
   317	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if a.stage == "all" else (a.stage,)
   318	    install()
   319	    if a.gate != "skip" and a.stage == "all":
   320	        out = base / "gate-p0"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   321	        jobs = build_jobs(root, cfgs, params, salt_sha, 0.0, (GATE_CELL[0],), (GATE_CELL[1],), a.smoke)
   322	        _run_rate(out, jobs, ("inputs", "search", "freeze", "evaluate", "doubling", "inventory"), a, salt_sha, container, 0.0, a.started)
   323	        rid = R.cell_id(f"{GATE_CELL[0]}@rho0.2", GATE_CELL[1], "D2+H3", "profit")
   324	        g = gate_compare(a.src, out, rid, jobs[0]["id"]); inventory(out, 0.0)
   325	        print(json.dumps({"gate": g["pass"], "search": g["search"].get("problems"), "doubling": g["doubling"].get("problems")}), flush=True)
