    54	    def settle(self, t: int, escrow: dict, owner: dict, cons: Consequences, failed_jobs_of: dict) -> None:
    55	        released = np.zeros(self.N)
    56	        for job, amount in escrow.items():
    57	            p = owner[job]
    58	            refund = min(cons.refunds.get(job, 0.0), amount)
    59	            self.refunds[t, p] += refund
    60	            released[p] += amount - refund
    61	        for ident, amount in cons.forfeits.items():
    62	            self.bond[ident] -= amount
    63	            self.forfeits[t, ident] += amount
    64	        for ident, amount in cons.releases.items():
    65	            self.bond[ident] -= amount
    66	            self.holdback_out[t, ident] += amount
    67	        for ident, amount in cons.holdbacks.items():
