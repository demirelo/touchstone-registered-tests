   229	    if sr is not None:
   230	        write(R.path_of(view, rid), {**sr, "id": rid, "provenance": {**sr["provenance"], "id": rid}})
   231	    if ev is not None:
   232	        up = {(rid if k == cid else k): v for k, v in (ev.get("upstream") or {}).items()}
   233	        write(R.eval_path(view, rid), {**ev, "id": rid, "upstream": up})
   234	    if db is not None:
