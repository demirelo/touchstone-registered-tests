   204	def diagnostics(out, jobs: list[dict], workers: int = 1) -> dict:
   205	    """Plan section 4 (draft 2): the base and the doubled winner of each churn cell rerun on the evaluation seeds under
   206	    churn, with per-seed normalised profits and newcomer audit counts; and, per rule and winner, the age-bin shares pooled
   207	    over markets with equal weights."""
   208	    install()
   209	    if workers <= 1 or len(jobs) <= 1:
   210	        rows = [_diag_one(j, str(out)) for j in jobs]
   211	    else:
   212	        with ProcessPoolExecutor(max_workers=workers, initializer=_init_worker) as ex:
   213	            rows = list(ex.map(_diag_one, jobs, [str(out)] * len(jobs)))
   214	    res = dict(rows); pooled = {}
   215	    for rule in sorted({k.split("|")[1] for k in res}):
   216	        for w in ("base", "doubled"):
   217	            bm = {k.split("|")[0]: v[w]["shares"] for k, v in res.items() if k.split("|")[1] == rule}
   218	            pooled[f"{rule}|{w}"] = {c: pool_markets(bm, c) for c in ("honest_replacement", "honest_initial", "focal")}
   219	    return {"cells": res, "pooled": pooled}
