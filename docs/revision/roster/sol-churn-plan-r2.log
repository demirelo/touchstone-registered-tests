   104	def _full_churn_job(p=0.05, rule="F111", market="fresh0"):
   105	    """A full-size (five training seeds) churn job on the registered configuration, with its inputs copied."""
   106	    M = MAIN
   107	    root = json.loads((M / "draw/draw.json").read_text())["hash"]; salt = json.loads((M / "draw/instances.json").read_text())["salt_sha256"]
   108	    from sim.records import cfg_from_dict
   109	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads((M / "deviation/cfg_linux.json").read_text()).items()}
   110	    params = json.loads((C.F.ROOT / "experiments/v2/params.json").read_text())
   111	    return C.build_jobs(root, cfgs, params, salt, p, (market,), (rule,))[0], root
