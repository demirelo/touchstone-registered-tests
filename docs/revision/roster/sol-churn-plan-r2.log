    72	            self.bond[ident] += amount
    73	        self.released[t] += released
    74	        self._settled = t + 1
    75	        excess = np.maximum(self.bond - self.recent_receipts(), 0.0)
    76	        self.bond -= excess
    77	        self.holdback_out[t] += excess
