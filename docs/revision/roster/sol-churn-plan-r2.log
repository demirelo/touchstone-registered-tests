   135	def test_r1_frozen_reference_score_is_recomputed_under_churn(tmp_path):
   136	    """Blocker 1: reference_change compares two churn scores; the frozen reference's stored no-churn score is replaced by
   137	    its evaluation under churn on the training seeds."""
   138	    from sim.cell import SeedCache, run_focal
   139	    j, root = _full_churn_job(); C.R.install_salt(root, tmp_path); C.install()
   140	    C.F.copy_inputs(MAIN / "eval/all", tmp_path, C.F.inputs(MAIN / "eval/all", [j]))
