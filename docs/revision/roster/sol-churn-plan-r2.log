   238	def gate_compare(src, out, rid: str, cid: str) -> dict:
   239	    """The p = 0 gate (plan draft 2, section 3 c): the churn cell `cid` at p = 0 against the registered cell `rid`, by the
   240	    reset driver's draft-5 criteria for the search and evaluation (`compare`) and the doubling check (`compare_doubling`)."""
   241	    view = Path(out) / "gate_view"; _mapped_view(out, view, cid, rid)
   242	    s, d = F.compare(src, view, rid), F.compare_doubling(src, view, rid)
   243	    res = {"stage": "churn p=0 gate", "registered": rid, "churn": cid, "pass": bool(s["pass"] and d["pass"]), "search": s, "doubling": d}
   244	    write(Path(out) / "gate.json", res)
   245	    return res
