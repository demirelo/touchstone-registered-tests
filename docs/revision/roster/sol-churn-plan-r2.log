     8	class Ledger:
     9	    """Owns every money flow. Conservation after every settlement:
    10	    funding = released + refunds + holdback_out + forfeits + bond + escrow."""
    11	
    12	    def __init__(self, N: int, T: int) -> None:
    13	        self.N, self.T = N, T
    14	        self.funding = np.zeros((T, N)); self.refunds = np.zeros((T, N)); self.released = np.zeros((T, N))
    15	        self.holdback_in = np.zeros((T, N)); self.holdback_out = np.zeros((T, N)); self.forfeits = np.zeros((T, N))
    16	        self.cost = np.zeros((T, N)); self.entry = np.zeros((T, N))
    17	        self.audit_cost = np.zeros(T)
    18	        self.bond = np.zeros(N)
    19	        self._settled = 0
    20	
    21	    def grow(self, m: int) -> None:
    22	        """Extend every per-identity array to m columns (new identities on re-entry)."""
    23	        cur = self.bond.shape[0]
    24	        if m <= cur:
    25	            return
    26	        pad = m - cur
