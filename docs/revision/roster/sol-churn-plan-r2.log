   225	def _mapped_view(out, view, cid: str, rid: str) -> None:
   226	    """Copies of a churn cell's search, evaluation, and doubling records under the registered id, so the reset driver's
   227	    comparators read both sides by one id; only the id fields and the cell's own upstream key are renamed."""
   228	    sr = read(R.path_of(out, cid)); ev = read(R.eval_path(out, cid)); db = read(Path(out) / "doubling" / (R._safe(cid) + ".json"))
   229	    if sr is not None:
   230	        write(R.path_of(view, rid), {**sr, "id": rid, "provenance": {**sr["provenance"], "id": rid}})
   231	    if ev is not None:
   232	        up = {(rid if k == cid else k): v for k, v in (ev.get("upstream") or {}).items()}
   233	        write(R.eval_path(view, rid), {**ev, "id": rid, "upstream": up})
   234	    if db is not None:
   235	        write(Path(view) / "doubling" / (R._safe(rid) + ".json"), {**db, "id": rid})
