   114	@pytest.mark.skipif(not (MAIN / "eval/all/freeze").is_dir(), reason="needs the registered evaluation records")
   115	def test_r1_menu_candidates_are_rerun_under_churn_on_five_training_seeds(tmp_path):
   116	    """Blocker 1: the copied menu candidates carry no-churn profits on the five training seeds; under churn they must be
   117	    run again, so every selection score equals a fresh churn evaluation of that candidate."""
   118	    from sim.cell import SeedCache, run_focal
   119	    import sim.reference as REF
   120	    j, root = _full_churn_job(); C.R.install_salt(root, tmp_path); C.install()
   121	    C.F.copy_inputs(MAIN / "eval/all", tmp_path, C.F.inputs(MAIN / "eval/all", [j]))
   122	    cands, _, _ = C.R.menu(j, tmp_path, C.F.CUTS, C.F.H4_EXCLUDED)
   123	    cell = C.R.train_cell(j); assert len(cell.seeds) == 5 and cell.others
   124	    known = [c for c in cands if c.known_normalized is not None and len(c.known_normalized) == 5 and c.name != "abstain"]
   125	    assert known                                                                              # the defect needs cached values to exist
   126	    differ = 0                                                                                # names repeat across families: one candidate at a time
   127	    for c in known:
   128	        want = float(run_focal(cell, c.policy_factory, SeedCache()).normalized.mean())
   129	        assert C.R.select_reference(cell, [c], SeedCache()).scores[c.name] == want
   130	        differ += REF.select_reference(cell, [c], SeedCache()).scores[c.name] != want
   131	    assert differ > 0
