   189	def _diag_one(job: dict, out: str) -> tuple:
   190	    import numpy as np
   191	    from sim.cell import SeedCache, run_focal
   192	    install(); j = job
   193	    T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j)
   194	    pols = {"base": read(R.path_of(out, j["id"]))["attack"]["best_knobs"],
   195	            "doubled": read(Path(out) / "doubling" / (R._safe(j["id"]) + ".json"))["heldout"]["knobs"]}
   196	    row = {}
   197	    for k, knobs in pols.items():
   198	        fr = run_focal(cell, lambda knobs=knobs: fam.make(dict(knobs)), SeedCache())
   199	        row[k] = {"knobs": knobs, "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
   200	                  "mean_normalized": float(np.mean(fr.normalized)), "shares": newcomer_shares(fr.results, cell.focal)}
   201	    return f"{j['context']}|{j['rule']}", row
