    48	    def recent_receipts(self) -> np.ndarray:
    49	        if self._settled == 0:
    50	            return np.zeros(self.N)
    51	        lo = max(0, self._settled - H_MAX)
    52	        return self.released[lo:self._settled].sum(axis=0)
