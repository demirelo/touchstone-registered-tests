   143	    assert rrec["per_seed_normalized"] == [float(x) for x in want] and rrec["churn_reevaluated"] is True
   144	    stored = read(C.R.path_of(tmp_path, f"reference/{j['context']}/F111"))["per_seed_normalized"]
   145	    assert stored != rrec["per_seed_normalized"]
   146	    nj = {k: v for k, v in j.items() if k != "churn"}
   147	    assert C.R.reference_of(nj, tmp_path)[1]["per_seed_normalized"] == stored                # no-churn jobs unchanged
