   130	
   131	def _uniquely_newest(r, focal: int) -> float:
   132	    """Share of rounds in which the focal provider's current identity has the latest creation round among the current
   133	    identities, strictly (initial identities tie at round 0)."""
   134	    T = len(r.history); born = list(r.identity_round); ent = list(r.entity_of); hits = 0
   135	    for t in range(T):
   136	        cur = {}
   137	        for i, (e, b) in enumerate(zip(ent, born)):
   138	            if b <= t:
   139	                cur[e] = i                                              # identities are numbered in creation order
   140	        newest = max(born[i] for i in cur.values()); f = born[cur[focal]]
   141	        hits += int(f == newest and sum(1 for i in cur.values() if born[i] == newest) == 1)
   142	    return hits / T if T else 0.0
   143	
   144	
   145	def newcomer_shares(results, focal: int, edges=AGE_EDGES) -> dict:
   146	    """Audited share of served jobs by identity age (rounds since creation) for honest replacement identities, honest
   147	    initial identities, and the focal provider's identities: per episode [served, audited] counts per age bin, and the
   148	    pooled share per bin (None, "unavailable", when no job was served in the bin); honest replacements per episode; and
   149	    per episode the share of rounds in which the focal identity is uniquely the newest."""
   150	    cats = ("honest_replacement", "honest_initial", "focal"); nb = len(edges) - 1
   151	    per, reps, newest = [], [], []
   152	    for r in results:
   153	        cnt = {c: [[0, 0] for _ in range(nb)] for c in cats}
   154	        reps.append(sum(1 for i, e in enumerate(r.entity_of) if e != focal and r.identity_generation[i] > 0))
   155	        cat = lambda i: "focal" if r.entity_of[i] == focal else ("honest_replacement" if r.identity_generation[i] > 0 else "honest_initial")
   156	        for t, h in enumerate(r.history):
   157	            def put(i, k):
   158	                age = t - r.identity_round[i]
   159	                for b in range(nb):
   160	                    if edges[b] <= age < edges[b + 1]:
   161	                        cnt[cat(i)][b][k] += 1; return
   162	            for i in h.assignment.values():
   163	                put(i, 0)
   164	            for a in h.audits:
   165	                put(a.provider, 1)
   166	        per.append(cnt); newest.append(_uniquely_newest(r, focal))
   167	    out = {}
   168	    for c in cats:
   169	        rows = []
   170	        for b in range(nb):
   171	            sv = sum(e[c][b][0] for e in per); au = sum(e[c][b][1] for e in per)
   172	            rows.append({"age": [edges[b], edges[b + 1]], "served": sv, "audited": au, "share": (au / sv if sv else None)})
   173	        out[c] = rows
   174	    out["per_episode"] = per
   175	    out["honest_replacements_per_episode"] = float(sum(reps) / len(reps)) if reps else 0.0
   176	    out["focal_uniquely_newest"] = newest
   177	    return out
   178	
   179	
   180	def pool_markets(by_market: dict, cat: str) -> list:
   181	    """Equal market weights: per age bin, the mean of the market shares over the markets where the share is available."""
   182	    nb = len(next(iter(by_market.values()))[cat]); res = []
   183	    for b in range(nb):
   184	        v = [m[cat][b]["share"] for m in by_market.values() if m[cat][b]["share"] is not None]
   185	        res.append({"share": (sum(v) / len(v) if v else None), "markets": len(v)})
   186	    return res
