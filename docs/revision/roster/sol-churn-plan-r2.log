   122	def check_salt(out, salt_sha256: str, jobs: list[dict]) -> None:
   123	    salt = Path(out) / "salt.hex"
   124	    if not salt.exists() or R._sha(bytes.fromhex(salt.read_text().strip())) != salt_sha256:
   125	        _refuse("the identity salt under the output is not the recorded salt")
   126	    if bad := [j["id"] for j in jobs if j["provenance"]["salt_sha256"] != salt_sha256]:
   127	        _refuse(f"jobs carry another salt hash: {bad}")
