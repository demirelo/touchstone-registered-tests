    96	def check_pairing_rule(src, jobs: list[dict]) -> None:
    97	    """Each job matches the registered C* reference's provenance on every pairing key except the rule parameters, which
    98	    must differ (otherwise the job is the registered C*)."""
    99	    keys = [k for k in F.PAIRED_KEYS if k != "rule_params_sha256"]
   100	    for j in jobs:
   101	        ref = read(R.path_of(src, f"reference/{j['context']}/{LABEL}"))
   102	        if ref is None:
   103	            _refuse(f"{j['id']}: no registered C* reference to pair with")
   104	        if bad := [k for k in keys if j["provenance"].get(k) != ref["provenance"].get(k)]:
   105	            _refuse(f"{j['id']}: provenance differs from the registered C* reference in {bad}")
   106	        if j["provenance"].get("rule_params_sha256") == ref["provenance"].get("rule_params_sha256"):
   107	            _refuse(f"{j['id']}: rule parameters equal the registered C*'s")
