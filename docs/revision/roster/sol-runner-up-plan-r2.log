     9	import numpy as np
    10	
    11	MARGIN = 0.05                                       # the registered Q1 margin (design 9.3)
    12	RESAMPLES, SEED = 9999, 0
    13	SCOPE = ("nominal paired percentile bootstrap over seeds, conditional on these markets and the selected policies and references; "
    14	         "no search or market-sampling uncertainty; no registered calibration or Holm guarantee")
    15	
    16	
    17	def pooled_paired(a: dict, b: dict, resamples: int = RESAMPLES, seed: int = SEED, level: float = 0.95) -> dict:
    18	    """`a`, `b`: market -> per-seed gains on the same seeds in the same order. Pooled = mean of the market means."""
    19	    markets = sorted(a)
    20	    if sorted(b) != markets:
    21	        raise ValueError("the two rules cover different markets")
    22	    diffs = {}
    23	    for m in markets:
    24	        x, y = np.asarray(a[m], float), np.asarray(b[m], float)
    25	        if x.shape != y.shape:
    26	            raise ValueError(f"{m}: unequal seed counts")
    27	        diffs[m] = x - y
    28	    rng = np.random.default_rng(seed); per = {m: np.empty(resamples) for m in markets}
    29	    for i in range(resamples):
    30	        for m in markets:
    31	            d = diffs[m]; per[m][i] = d[rng.integers(0, len(d), len(d))].mean()
    32	    reps = np.mean([per[m] for m in markets], axis=0)
    33	    q = (1 - level) / 2; iv = lambda r: [float(np.quantile(r, q)), float(np.quantile(r, 1 - q))]
    34	    return {"markets": {m: float(diffs[m].mean()) for m in markets}, "market_intervals": {m: iv(per[m]) for m in markets},
    35	            "estimate": float(np.mean([diffs[m].mean() for m in markets])), "interval": iv(reps), "resamples": resamples, "seed": seed, "level": level,
    36	            "scope": SCOPE}
