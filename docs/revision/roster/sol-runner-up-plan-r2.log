"""The protocol-v2 manifest (design draft 7: 8.1, 8.1a, 8.2, 6.5, 6.6, 6.7), read from experiments/revision-v2-manifest.yaml:
the 287 search cells and 3 diagnostic cells, the 98 doubling checks, the 14 fixed-attack cross-evaluations, the execution
priority, the pre-stated cut order, per context the records a final freeze requires and the reference-bank rules, the
distinct-rule check (design 3.4), and the question-to-cell map (design 8.1a)."""
from __future__ import annotations

from functools import lru_cache
from pathlib import Path

import json
import math

import yaml

ROOT = Path(__file__).resolve().parents[1]
PATH = ROOT / "experiments/revision-v2-manifest.yaml"
Q1_Q4_RULES = ("F000", "F111", "C*")
FACTORIAL = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111")
MATCHED = ("F000", "F001", "F010", "F011", "F100", "F101", "F110", "F111", "C*", "C*/S0")
FIXED = MATCHED + ("C*/S2", "R4")                    # rules at the fixed pair (R4 and C*/S2 only in the rho = 1 repair block)
MENU_FAMILIES = ("D2+H3", "X7-SC")
SECONDARY = ("B3-t", "R3-t", "C*-t")
CORE = ("F000", "F111", "C*")
J, L_FIXED = 50, 10


@lru_cache(maxsize=1)
def doc() -> dict:
    return yaml.safe_load(PATH.read_text())


CUT_ORDER = tuple(doc()["cut_order"])


def context(market: str, rho: float = 0.2) -> str:
    return f"{market}@rho{rho:g}" if rho != 0.2 else f"{market}@rho0.2"


def _cell(block, market, rho, rule, family, objective, c=None, schedule=None) -> dict:
    ctx = context(market, rho)
    cid = f"{ctx}|{rule}|{family}|{objective}" + (f"|c{c}_{schedule}" if c is not None else "")
    return {"id": cid, "block": block, "market": market, "context": ctx, "rho": rho, "rule": rule, "family": family, "objective": objective,
            "c": c, "schedule": schedule}


def _families(b: dict, market: str) -> list:
    if "families_by_market" in b:
        return b["families_by_market"]["headline" if market == "headline" else "fresh"]
    return b["families"]


def headline_a_tot(rho: float) -> int:
    """A_tot = floor(beta S_hat / (rho m)) = floor((beta / rho) n_FB) on the headline calibration (design 3.4)."""
    n_fb = float(json.loads((ROOT / "experiments/calibration.json").read_text())["n_FB"])
    return int(math.floor(0.05 / float(rho) * n_fb + 1e-12))


def _descriptor(rule: str, a_tot: int) -> tuple:
    """(selection, pacing schedule) of a rule at the fixed pair; rules with their own parameters are unique."""
    if rule in FACTORIAL:
        pacing = ("reserve", min(J * L_FIXED, a_tot)) if rule[3] == "1" else ("spread",)
        return (("factorial", rule[1], rule[2]), pacing)
    if rule == "R4":
        return (("factorial", "1", "1"), ("reserve", min(J * L_FIXED, a_tot // 2)))
    if rule in ("C*", "C*/S0", "C*/S2"):
        pacing = {"C*": ("reserve", min(J * L_FIXED, a_tot)), "C*/S0": ("spread",), "C*/S2": ("reserve", min(J * L_FIXED, a_tot // 2))}[rule]
        return (("credibility",), pacing)
    return (("own", rule), ("own", rule))


def distinct_rule_problems(cs: list[dict], a_tot: dict) -> list[str]:
    """Design 3.4: no two rules compared in one block and context may have the same selection and pacing schedule."""
    seen: dict = {}; out = []
    for c in cs:
        key = (c["block"], c["context"], _descriptor(c["rule"], int(a_tot[c["context"]])))
        other = seen.setdefault(key, c["rule"])
        if other != c["rule"]:
            out.append(f"{c['block']} {c['context']}: {other} and {c['rule']} have the same selection and pacing")
    return sorted(set(out))


def cells() -> list[dict]:
    d = doc(); out = []
    for name, b in d["blocks"].items():
        markets = d["markets"] if b["markets"] == "all" else b["markets"]
        rho = float(b.get("rho", 0.2))
        objectives = b.get("objectives", [b.get("objective")])
        for m in markets:
            for r in b["rules"]:
                for f in _families(b, m):
                    for o in objectives:
                        if "c" in b:
                            out.extend(_cell(name, m, rho, r, f, o, c, s) for c in b["c"] for s in b["schedules"])
                        else:
                            out.append(_cell(name, m, rho, r, f, o))
    problems = distinct_rule_problems(out, {c["context"]: headline_a_tot(c["rho"]) for c in out})
    if problems:
        raise ValueError(f"manifest refused: {problems}")
    return out


def menu_families(ctx: str, rule: str) -> tuple[str, ...]:
    """Design 6.4: the secondary whole systems on fresh markets have the reduced D2+H3 menu; every other reference both."""
    return ("D2+H3",) if rule in SECONDARY and ctx.startswith("fresh") else MENU_FAMILIES


def _cut(cell: dict, spec: dict) -> bool:
    if spec.get("markets") == "fresh" and not cell["market"].startswith("fresh"):
        return False
    return all(cell[k] == v for k, v in (("block", spec.get("block")), ("family", spec.get("family")), ("rule", spec.get("rule"))) if v is not None)


def effective(cuts: int = 0, h4_excluded: bool = False) -> list[dict]:
    out = cells()
    for spec in CUT_ORDER[: int(cuts)]:
        out = [c for c in out if not _cut(c, spec)]
    if h4_excluded:
        out = [c for c in out if c["family"] != "H4"]
    return out


def doublings() -> list[str]:
    out = []
    for c in cells():
        if c["market"] == "headline" and c["rho"] == 0.2 and c["block"] in ("matched", "welfare", "coalition", "coalition_roles"):
            out.append(c["id"])
        elif c["market"].startswith("fresh") and c["block"] == "matched" and c["rule"] in Q1_Q4_RULES:
            out.append(c["id"])
    return out


def cross_evaluations() -> list[tuple[str, str]]:
    return [(context(m), f) for m in doc()["markets"] for f in MENU_FAMILIES]


def priority(cell: dict) -> int:
    if cell["block"] == "matched":
        return 0 if cell["rule"] in Q1_Q4_RULES else 1
    if cell["block"] in ("welfare", "coalition", "coalition_roles", "diagnostic") or (cell["block"] == "extras" and cell["family"] in ("X5-AG/v2", "H4")):
        return 2
    return 3


def bank_rules(ctx: str, family: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    present = {c["rule"] for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["family"] == family and c["objective"] == "profit"}
    return [r for r in FIXED if r in present]


def required(ctx: str, cuts: int = 0, h4_excluded: bool = False) -> list[str]:
    cs = [c for c in effective(cuts, h4_excluded) if c["context"] == ctx and c["block"] != "diagnostic"]   # diagnostics run after the freeze
    req = [c["id"] for c in cs]
    rules = sorted({c["rule"] for c in cs if c["objective"] != "coalition"}, key=lambda r: (r not in FIXED, r))
    req += [f"reference/{ctx}/{r}" for r in rules]
    groups: dict = {}
    for c in cs:
        if c["objective"] in ("total", "min"):
            groups.setdefault(f"{c['rule']}_c{c['c']}", set()).add(c["schedule"] if c["family"] == "X6-SE/v2" else None)
    for tag, schedules in groups.items():                  # design draft 7, 6.3: one coalition group per rule and c
        req += [f"joint_twin/{ctx}/{tag}_{s}" for s in ("synchronised", "staggered") if s in schedules]
        req += [f"{kind}/{ctx}/{tag}" for kind in ("joint_reference_pre", "joint_reference", "coalition_select")]
    env_rules = sorted({c["rule"] for c in cs if c["block"] == "extras"})
    req += [f"envelope/{ctx}/{r}" for r in env_rules]
    if any(c["block"] == "matched" for c in cs) and ctx in {context(m) for m in doc()["markets"]}:
        req += [f"bank/{ctx}/{f}" for f in MENU_FAMILIES]
        req += [f"bank_train/{ctx}/{f}" for f in MENU_FAMILIES]                          # design draft 7, 6.6: before the freeze
        req += [f"envelope_select/{ctx}/{r}/{f}" for f in MENU_FAMILIES for r in FACTORIAL
                if any(c["rule"] == r and c["family"] == f and c["block"] == "matched" for c in cs)]
    req += sorted({f"welfare_select/{ctx}/{c['rule']}/{c['objective']}" for c in cs if c["block"] == "welfare"},
                  key=lambda x: (CORE.index(x.split("/")[2]), x))                         # design draft 7, 6.2
    return req
"""The budget ledger of the paid operations (design 8.2; operations plan Task 4). A pod's USD cap is reserved before its
launch: the grant is min(estimate x 1.25, phase cap - spent - outstanding), refused when it is below the estimate or when
the spend plus outstanding reservations of both phases would pass the approval limit (40 USD, or the higher limit of a
written approval). The actual spend replaces the reservation when the pod is pulled. Every update holds an exclusive lock
on <ledger>.lock across its read and write, so concurrent launches cannot oversubscribe a cap."""
from __future__ import annotations

import argparse
import fcntl
import json
import math
import os
import sys
from contextlib import contextmanager
from pathlib import Path

DEFAULT = Path(__file__).resolve().parents[1] / "docs" / "revision" / "budget-ledger.json"
DECISION_H4 = Path(__file__).resolve().parents[1] / "experiments" / "v2" / "benchmark" / "decision-h4.json"
CAPS = {"development": 12.0, "evaluation": 40.0}
APPROVAL_LIMIT = 40.0
HEADROOM = 1.25


class Refused(Exception):
    pass


def _amount(x, what: str, positive: bool = False) -> float:
    """A finite, nonnegative amount (positive when required); anything else would disable the cap comparisons."""
    try:
        v = float(x)
    except (TypeError, ValueError):
        raise Refused(f"{what} {x!r} is not a number")
    if not math.isfinite(v) or v < 0 or (positive and v <= 0):
        raise Refused(f"{what} {x!r} must be finite and {'positive' if positive else 'nonnegative'}")
    return v


def _valid(d: dict) -> dict:
    for op, cap in d.get("caps", {}).items():
        _amount(cap, f"cap {op}", positive=True)
    for r in d.get("spent", []):
        _amount(r.get("usd"), f"spend {r.get('tag')}")
    for r in d.get("reservations", []):
        _amount(r.get("cap"), f"reservation {r.get('tag')}")
    if d.get("approval"):
        _amount(d["approval"].get("limit"), "approval limit", positive=True)
        if not (isinstance(d["approval"].get("text"), str) and d["approval"]["text"].strip()):
            raise Refused("the saved approval has no written text")
    return d


def _after_read() -> None:
    """Called between the ledger read and write of an update; a test replaces it to widen the race window."""


@contextmanager
def _locked(path: Path):
    path = Path(path); path.parent.mkdir(parents=True, exist_ok=True)
    with open(f"{path}.lock", "a") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            d = _valid(json.loads(path.read_text()) if path.exists() else {"caps": dict(CAPS), "reservations": [], "spent": [], "approval": None})
            _after_read()
            yield d
            tmp = Path(f"{path}.{os.getpid()}.tmp"); tmp.write_text(json.dumps(d, indent=1)); os.replace(tmp, path)
        finally:
            fcntl.flock(lk, fcntl.LOCK_UN)


def _used(d: dict, op: str | None = None) -> float:
    pick = lambda rows: sum(float(r.get("usd", r.get("cap", 0.0))) for r in rows if op is None or r["op"] == op)
    return pick(d["spent"]) + pick(d["reservations"])


def limit(d: dict) -> float:
    return float((d.get("approval") or {}).get("limit", APPROVAL_LIMIT))


def _gate(d: dict, op: str, decision_h4) -> None:
    """Design draft 7, 5.3 and 8.2: once the decision after the H4 timing exists, no development reservation (any tag)
    while it stops, or while its total needs an approval that the ledger's limit does not cover."""
    p = Path(decision_h4) if decision_h4 is not None else None
    if op != "development" or p is None or not p.exists():
        return
    dec = json.loads(p.read_text())["decision"]
    if dec.get("stop"):
        raise Refused(f"the decision after the H4 timing stops at {dec['stop']!r}: no further development reservation")
    if dec.get("approval_required") and limit(d) + 1e-9 < float(dec.get("total_usd") or 0.0):
        raise Refused(f"the decision after the H4 timing totals {dec.get('total_usd')} USD; record the author's approval with --approve first")


def reserve(path, op: str, tag: str, estimate: float, decision_h4=DECISION_H4) -> float:
    estimate = _amount(estimate, "estimate", positive=True)
    with _locked(path) as d:
        _gate(d, op, decision_h4)
        if any(r["tag"] == tag for r in d["reservations"] + d["spent"]):
            raise Refused(f"tag {tag!r} is already in the ledger")
        grant = min(float(estimate) * HEADROOM, float(d["caps"][op]) - _used(d, op))
        if grant < float(estimate):
            raise Refused(f"{op}: {grant:.2f} USD left under the cap, below the estimate {float(estimate):.2f}")
        if _used(d) + grant > limit(d) + 1e-9:
            raise Refused(f"the combined spend and reservations would reach {_used(d) + grant:.2f} USD, above the approved {limit(d):.2f}")
        d["reservations"].append({"op": op, "tag": tag, "cap": round(grant, 6)})
        return grant


def record(path, tag: str, usd: float) -> None:
    usd = _amount(usd, "spend")
    with _locked(path) as d:
        r = next((r for r in d["reservations"] if r["tag"] == tag), None)
        if r is None:
            raise Refused(f"no reservation {tag!r}")
        d["reservations"].remove(r); d["spent"].append({"op": r["op"], "tag": tag, "usd": float(usd)})


def approve(path, new_limit: float, text: str) -> None:
    new_limit = _amount(new_limit, "approval limit", positive=True)
    if not str(text).strip():
        raise Refused("an approval needs the author's written text")
    with _locked(path) as d:
        d["approval"] = {"limit": float(new_limit), "text": str(text)}


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--ledger", default=str(DEFAULT))
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--reserve", nargs=3, metavar=("OP", "TAG", "ESTIMATE")); g.add_argument("--record", nargs=2, metavar=("TAG", "USD"))
    g.add_argument("--approve", nargs=2, metavar=("LIMIT", "TEXT")); g.add_argument("--show", action="store_true")
    a = ap.parse_args(argv)
    try:
        if a.reserve:
            print(f"{reserve(a.ledger, a.reserve[0], a.reserve[1], float(a.reserve[2])):.2f}")
        elif a.record:
            record(a.ledger, a.record[0], float(a.record[1]))
        elif a.approve:
            approve(a.ledger, float(a.approve[0]), a.approve[1])
        else:
            print(Path(a.ledger).read_text())
    except Refused as e:
        print(f"refused: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
