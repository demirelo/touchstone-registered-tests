   152	def _required(out, jobs: list[dict], ctx: str) -> dict:
   153	    """Every record the context's freeze must hold: its bank inputs, both searches, and its reference, with current hashes."""
   154	    inp = read(Path(out) / "inputs.json") or {}
   155	    recs = {r: h for r, h in inp.items() if r.startswith(ctx) or f"/{ctx}/" in r}
   156	    for j in (j for j in jobs if j["context"] == ctx):
   157	        recs[j["id"]] = _validate_new(out, j["id"], "search", j["provenance"], jobs)
   158	    rid = f"reference/{ctx}/{LABEL}"; recs[rid] = _validate_new(out, rid, "reference", _ref_provenance(jobs, ctx), jobs)
   159	    return recs
