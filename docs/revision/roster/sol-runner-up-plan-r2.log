   217	EXPECTATION = "pooled g(C*) - g(runner-up) > 0 under D2+H3 (the runner-up leaves the lower gain), base and doubled"
   218	
   219	
   220	def _base(base, rule: str, fam: str, markets) -> dict | None:
   221	    res = {}
   222	    for m in markets:
   223	        rec = read(R.eval_path(base, R.cell_id(MAN.context(m), rule, fam, "profit")))
   224	        if rec is None:
   225	            return None
   226	        res[m] = (rec["seeds"], rec["gain"])
   227	    return res
   228	
   229	
   230	def _doubled_out(out, fam: str, markets) -> dict | None:
   231	    res = {}
   232	    for m in markets:
   233	        rec = read(Path(out) / "doubling" / (R._safe(R.cell_id(MAN.context(m), LABEL, fam, "profit")) + ".json"))
   234	        if rec is None or "heldout" not in rec:
   235	            return None
   236	        res[m] = (rec["heldout"]["seeds"], rec["heldout"]["gain"])
   237	    return res
   238	
   239	
   240	def _doubled_report(report: dict, rule: str, fam: str, markets) -> dict | None:
   241	    res = {}
   242	    for m in markets:
   243	        h = (report.get("doubling", {}).get(R.cell_id(MAN.context(m), rule, fam, "profit")) or {}).get("heldout")
   244	        if h is None:
   245	            return None
   246	        res[m] = (h["seeds"], h["gain"])
   247	    return res
   248	
   249	
   250	def _contrasts(ru, r3, cs, markets, resamples) -> dict | str:
   251	    if None in (ru, r3, cs):
   252	        return "not available"
   253	    for m in markets:
   254	        if not (ru[m][0] == r3[m][0] == cs[m][0]):
   255	            raise ValueError(f"{m}: evaluation seeds differ")
   256	    if not G.finite([ru[m][1] for m in markets], [r3[m][1] for m in markets], [cs[m][1] for m in markets]):
   257	        return "not available"
   258	    g = lambda d: {m: d[m][1] for m in markets}
   259	    a, b, c = C.pooled_paired(g(ru), g(r3), resamples), C.pooled_paired(g(cs), g(ru), resamples), C.pooled_paired(g(cs), g(r3), resamples)
   260	    return {"runner_up_minus_r3": {**a, "category": C.q1_category(a["interval"])}, "cstar_minus_runner_up": b,
   261	            "cstar_minus_r3": {**c, "category": C.q1_category(c["interval"])}}
   262	
   263	
   264	def _score(base, doubled) -> dict:
   265	    vals = [None if isinstance(x, str) else x["cstar_minus_runner_up"]["estimate"] > 0 for x in (base, doubled)]   # a tie is not met
   266	    score = "not available" if None in vals else ("met" if all(vals) else ("failed" if not any(vals) else "not established"))
   267	    return {"statement": EXPECTATION, "base": vals[0], "doubled": vals[1], "score": score}
   268	
   269	
   270	def analysis(out, src, report: dict, markets=MARKETS, fams=FAMS, resamples: int = C.RESAMPLES) -> dict:
   271	    """Per family: runner-up minus R3, C* minus runner-up and C* minus R3, base and doubled, each rule against its own
   272	    unchanged frozen reference, paired on the evaluation seeds, from unrounded values; exploratory."""
   273	    res = {}
   274	    for fam in fams:
   275	        base = _contrasts(_base(out, LABEL, fam, markets), _base(src, "F111", fam, markets), _base(src, "C*", fam, markets), markets, resamples)
   276	        dbl = _contrasts(_doubled_out(out, fam, markets), _doubled_report(report, "F111", fam, markets), _doubled_report(report, "C*", fam, markets), markets, resamples)
   277	        flags = {}
   278	        for m in markets:
   279	            rec = read(Path(out) / "doubling" / (R._safe(R.cell_id(MAN.context(m), LABEL, fam, "profit")) + ".json")) or {}
   280	            flags[m] = {k: rec.get(k) for k in ("attack_change", "reference_change", "incomplete")}
   281	        row = {"label": "exploratory, after the report; " + C.SCOPE, "base": base, "doubled": dbl, "flags": flags}
   282	        if fam == "D2+H3":
   283	            row["expectation"] = _score(base, dbl)
   284	        res[fam] = row
   285	    return res
