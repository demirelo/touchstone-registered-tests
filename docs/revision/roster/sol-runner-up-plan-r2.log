    83	def check_no_registered_cstar(src, out) -> None:
    84	    """No file under the output may be a byte copy of a registered C* record (the label is shared)."""
    85	    out, src = Path(out), Path(src)
    86	    if not out.exists():
    87	        return
    88	    for q in out.rglob("*.json"):
    89	        if "__Cstar__" not in q.name and q.stem != "Cstar":       # the C* label exactly; C*/S0 (Cstar~S0) is a bank input
    90	            continue
    91	        p = src / q.relative_to(out)
    92	        if p.exists() and sha_file(p) == sha_file(q):
    93	            _refuse(f"{q} is a copy of a registered C* record")
