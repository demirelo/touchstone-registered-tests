    57	def build_jobs(root: str, cfgs: dict, params: dict, salt_sha256: str, markets=MARKETS, smoke: bool = False) -> list[dict]:
    58	    jobs = []
    59	    for m in markets:
    60	        mkt = R.market(m, root, 0.2, smoke=smoke, cfg=cfgs[m], salt_sha256=salt_sha256)
    61	        jobs += [R.job(mkt, LABEL, fam, "profit", smoke=smoke, params=params) for fam in FAMS]
    62	    return jobs
