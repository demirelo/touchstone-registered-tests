   183	            _refuse(f"{ctx}: no follow-up freeze with cuts {CUTS} and H4 loaded")
   184	        if not fr.get("records") or fr["records"] != _required(out, jobs, ctx):
   185	            _refuse(f"{ctx}: the freeze is empty, incomplete, or stale")
