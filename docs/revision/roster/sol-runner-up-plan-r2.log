   162	def prefreeze(out, jobs) -> None:
   163	    for ctx in sorted({j["context"] for j in jobs}):
   164	        body = {"stage": "freeze", "context": ctx, "followup": True, "deviations": list(DEVIATIONS), "cuts": CUTS, "h4_excluded": H4_EXCLUDED,
   165	                "records": _required(out, jobs, ctx)}
   166	        p = R.path_of(out, f"freeze/{ctx}"); old = read(p)
   167	        if old is not None and old != body:
   168	            _refuse(f"{p} exists with other records")
   169	        if old is None:
   170	            write(p, body)
