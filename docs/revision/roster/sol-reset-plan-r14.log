   148	def watchdog(name, hard_ts, done_file, run=_run, clock=time.time, sleep=time.sleep, here=HERE, settle=SETTLE):
   149	    """Ends only when DONE_FILE exists and successful listings show no pod named NAME for the settle time, counted from
   150	    DONE onwards (r11 Sol 3); after an ambiguous creation answer the settle time is at least AMBIGUOUS_SETTLE. After
   151	    DONE (the launcher reconciles first) any pod named NAME is an orphan and is deleted. From HARD_TS it also blocks
   152	    creation and deletes every pod named NAME, with no retry limit. On exit it prints the final spend bound."""
   153	    blocked = False
   154	    empty_since = None
   155	    while True:
   156	        if not blocked and clock() >= hard_ts:
   157	            open(os.path.join(here, f"{name}.blocked"), "w").write(str(int(clock())))
   158	            print(f"{time.strftime('%H:%M')} WATCHDOG: hard deadline; creation blocked; deleting every pod named {name}", flush=True)
   159	            blocked = True
   160	        done = os.path.exists(done_file)
   161	        need = max(settle, AMBIGUOUS_SETTLE) if os.path.exists(os.path.join(here, f"{name}.ambiguous")) else settle
