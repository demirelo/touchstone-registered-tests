   117	def record_price(name, pid, run=_run, here=HERE, pods=None):
   118	    """Raise the rate in NAME.acct to PID's observed price; if the price is unknown (or the listing failed) write
   119	    NAME.unpriced, so no spend bound is claimed. Returns the price or None."""
   120	    if pods is None:
   121	        pods = list_pods(run)
   122	    pod = next((p for p in pods or [] if p.get("id") == pid), None)
   123	    price = price_of(pod) if pod is not None else None
   124	    if price is None:
   125	        open(os.path.join(here, f"{name}.unpriced"), "a").write(f"{pid}\n")
   126	        return None
   127	    acct = os.path.join(here, f"{name}.acct")
   128	    try:
   129	        tfirst, rate = open(acct).read().split()[:2]
   130	        if price > float(rate):
   131	            open(acct, "w").write(f"{tfirst} {price}")
   132	    except (OSError, ValueError):
   133	        open(os.path.join(here, f"{name}.unpriced"), "a").write(f"{pid} (no acct)\n")
   134	    return price
   135	
