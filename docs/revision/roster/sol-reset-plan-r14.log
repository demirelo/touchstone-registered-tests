   108	def price_of(pod):
   109	    """The pod's price in USD/h when it is finite and positive, else None (missing, null, zero or unreadable: r12)."""
   110	    try:
   111	        v = float(pod.get("costPerHr"))
   112	    except (TypeError, ValueError):
   113	        return None
   114	    return v if math.isfinite(v) and v > 0 else None
