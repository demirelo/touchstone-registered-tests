    18	import json, os, shutil, sys
    19	H = os.path.dirname(os.path.abspath(__file__)); S = os.path.join(H, "state.json")
    20	st = json.load(open(S)); cmd, a = sys.argv[1], sys.argv[2:]; st["log"].append(" ".join([cmd] + a[:1])); rc = 0
    21	for p in list(st.get("pending", {})):                       # delayed creations appear after a countdown of calls
    22	    st["pending"][p][1] -= 1
    23	    if st["pending"][p][1] <= 0: st["pods"][p] = st["pending"].pop(p)[0]
    24	if cmd == "list":
    25	    if st.get("fail_list", 0) > 0: st["fail_list"] -= 1; rc = 1; print("error")
    26	    else: print(json.dumps([{"id": i, "name": n, "costPerHr": st["price"]} for i, n in st["pods"].items()]))
    27	elif cmd == "delete":
    28	    if st.get("stuck", {}).get(a[0], 0) > 0: st["stuck"][a[0]] -= 1
    29	    else: st["pods"].pop(a[0], None)
    30	    print("{}")
    31	elif cmd == "ssh":
    32	    c = a[1] if len(a) > 1 else ""
    33	    if not st["up"]: rc = 255; print("")
