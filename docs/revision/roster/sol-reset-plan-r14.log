    35	    elif "tail -c 240" in c: print("== RUN OK" if st.get("runok") else "== stage search")
    36	    else: print("up")
    37	elif cmd == "push": print("exit 0")
    38	elif cmd == "pull":
    39	    src, dst = a[1], a[2]
    40	    for k in ("followup-reset", "followup-gate"):
    41	        if k in src:
    42	            shutil.copytree(os.path.join(H, "remote", k), dst, dirs_exist_ok=True)
    43	            if k == "followup-reset" and st.get("corrupt_pulls", 0) > 0:
    44	                st["corrupt_pulls"] -= 1; open(os.path.join(dst, "r.json"), "w").write("corrupt")
