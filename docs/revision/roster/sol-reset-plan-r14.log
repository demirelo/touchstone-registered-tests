    35	def list_pods(run=_run, timeout=60):
    36	    """The pods as a list, or None when the listing failed (never an empty list on failure). The timeout stays
    37	    fractional so a command never outlives a sub-second budget (r11 Astra 5)."""
    38	    if float(timeout) <= 0:
    39	        return None                      # no budget left: no command, and no listing counts (r12 Sol 5 / Astra 4)
    40	    rc, out = run(["list"], timeout=float(timeout))
    41	    if rc != 0:
    42	        return None
    43	    try:
    44	        pods = json.loads(out)
    45	    except ValueError:
    46	        return None
    47	    return pods if isinstance(pods, list) else None
    48	
    49	
    50	def named(pods, name):
    51	    return [p["id"] for p in pods if p.get("name") == name]
    52	
    53	
    54	def delete_verified(pid, seconds, run=_run, clock=time.time, sleep=time.sleep):
    55	    """Delete PID until a successful listing no longer shows it, within SECONDS of elapsed time."""
    56	    end = clock() + seconds
    57	    while clock() < end:
    58	        run(["delete", pid], timeout=min(60.0, end - clock()))
    59	        if clock() >= end:
    60	            break
    61	        pods = list_pods(run, min(60, end - clock()))
    62	        if clock() < end + 1e-9 and pods is not None and pid not in [p["id"] for p in pods]:
    63	            return clock() <= end
    64	        sleep(min(15, max(0.0, end - clock())))
    65	    return False
    66	
    67	
    68	def reconcile(name, keep="", seconds=600, run=_run, clock=time.time, sleep=time.sleep, here=HERE):
    69	    """Delete every pod named NAME except KEEP, recording each one's price first (r13: every deletion path records it);
    70	    True only when a successful listing shows none left."""
    71	    end = clock() + seconds
    72	    while clock() < end:
    73	        pods = list_pods(run, min(60, end - clock()))
    74	        if pods is not None and clock() <= end:
    75	            extra = [i for i in named(pods, name) if i != keep]
    76	            if not extra:
    77	                return True
    78	            for i in extra:
    79	                if clock() >= end:
    80	                    break
    81	                record_price(name, i, run, here, pods)
