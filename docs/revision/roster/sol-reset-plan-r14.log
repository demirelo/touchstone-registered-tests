   137	def _final_bound(here, name):
   138	    if os.path.exists(os.path.join(here, f"{name}.unpriced")):
   139	        return "UNRESOLVED BILLING: a pod had an unknown price; check the Runpod console for the spend"
   140	    try:
   141	        tfirst, rate = open(os.path.join(here, f"{name}.acct")).read().split()[:2]
   142	        secs = max(0.0, time.time() - float(tfirst))
   143	        return f"final spend bound: {int(secs)}s at {rate} USD/h = {round(secs / 3600 * float(rate), 3)} USD"
   144	    except (OSError, ValueError):
