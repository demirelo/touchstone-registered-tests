     1	"""Minimal Runpod REST helper. Usage:
     2	  python runpod.py list | get ID | delete ID | ssh ID 'cmd' | push ID LOCAL REMOTE | pull ID REMOTE LOCAL"""
     3	import json, os, re, subprocess, sys, urllib.request
     4	KEY = re.search(r"apikey\s*=\s*'([^']+)'", open(os.path.expanduser("~/.runpod/config.toml")).read()).group(1)
     5	SSHKEY = os.path.expanduser("~/.runpod/ssh/runpodctl-ssh-key")
     6	BASE = "https://rest.runpod.io/v1"
     7	def api(method, path, body=None):
     8	    req = urllib.request.Request(BASE + path, data=json.dumps(body).encode() if body else None, method=method,
     9	                                 headers={"Authorization": f"Bearer {KEY}", "Content-Type": "application/json", "User-Agent": "curl/8.7.1"})
    10	    try:
    11	        with urllib.request.urlopen(req, timeout=60) as r:
    12	            t = r.read().decode(); return json.loads(t) if t else None
    13	    except urllib.error.HTTPError as e:
    14	        return {"error": e.code, "body": e.read().decode()[:500]}
    15	def target(pod_id):
    16	    p = api("GET", f"/pods/{pod_id}"); pm = p.get("portMappings") or {}
    17	    return p.get("publicIp"), pm.get("22") or pm.get(22)
    18	def ssh(pod_id, cmd, timeout=None):
    19	    ip, port = target(pod_id)
    20	    return subprocess.run(["ssh", "-i", SSHKEY, "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=20", "-p", str(port), f"root@{ip}", cmd],
    21	                          capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    22	def rsync(pod_id, src, dst, pull=False):
    23	    ip, port = target(pod_id)
    24	    e = f"ssh -i {SSHKEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p {port}"
    25	    a, b = (f"root@{ip}:{src}", dst) if pull else (src, f"root@{ip}:{dst}")
    26	    return subprocess.run(["rsync", "-az", "-e", e, a, b], capture_output=True, text=True)
    27	def main(argv) -> int:
    28	    cmd, args = argv[0], argv[1:]
    29	    if cmd == "list": print(json.dumps([{k: p.get(k) for k in ("id", "name", "desiredStatus", "publicIp", "portMappings", "costPerHr", "vcpuCount")} for p in api("GET", "/pods")], indent=1))
    30	    elif cmd == "get": print(json.dumps(api("GET", f"/pods/{args[0]}"), indent=1)[:1500])
