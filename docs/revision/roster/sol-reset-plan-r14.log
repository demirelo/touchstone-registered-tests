    95	def classify_creation(answer, exc=None):
    96	    """(pod id, ambiguous) for one creation request. Only a clear client refusal (HTTP 4xx other than 408 and 429) is
    97	    unambiguous; a timeout, exception, server or gateway error, or unreadable answer may still create a pod (r11)."""
    98	    if exc is not None:
    99	        return "", True
   100	    if isinstance(answer, dict) and answer.get("id"):
   101	        return str(answer["id"]), False
   102	    if isinstance(answer, dict) and isinstance(answer.get("error"), int):
   103	        code = answer["error"]
   104	        return "", not (400 <= code < 500 and code not in (408, 429))
   105	    return "", True
