    27	def _run(args, timeout=60):
    28	    try:
    29	        r = subprocess.run([PY, os.path.join(HERE, "runpod.py")] + args, capture_output=True, text=True, timeout=timeout)
    30	        return r.returncode, r.stdout
    31	    except subprocess.TimeoutExpired:
    32	        return 124, ""
