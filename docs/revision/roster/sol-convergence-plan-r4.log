   206	def run_cell(job: dict, out, max_rounds: int = MAX_ROUNDS, src=None, cost: tuple | None = None, round_hours: float = 0.0,
   207	             embedded: dict | None = None, min_rounds: int = 1, reference=None) -> dict:
   208	    from sim.cell import SeedCache
   209	    from sim.locked import load_locked
   210	    from sim.records import search_from_json
   211	    from sim.reference import reference_candidates, select_reference
   212	    from sim.search import Objective, cma_search
   213	    T, L = R.constants(job); fam = R.family_for(job["family"], T, L); cell = R.train_cell(job); st = R.settings(job); cache = SeedCache()
   214	    rec = read(R.path_of(out, job["id"])); prev = search_from_json(rec["attack"]); twin = search_from_json(rec["twin"])
   215	    frozen_ref, rrec, _ = R.reference_of(job, out); prev_ref = float(np.mean(rrec["per_seed_normalized"]))
   216	    cands, _, _ = R.menu(job, out, CUTS, H4_EXCLUDED); order = tuple(load_locked()["reference_order"])
   217	    stopper = G.CostStop(*cost) if cost else None
   218	    emb = R.embed_h3(embedded, T) if embedded is not None else None
   219	    rounds, gate, outcome = [], None, "round cap"
   220	    if stopper and not stopper.allow("round 1", round_hours):           # admission before the cell's first round
   221	        return {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": [],
   222	                "status": "stopped at the cost cap", "passed_round": None, "round1_gate": "not run", "claim": CLAIM, "cost": stopper.report()}
   223	    for k in range(1, max_rounds + 1):
   224	        obj = Objective(cell, fam, cache); obj.archive.update(prev.archive)     # revision_v2.continue_search, with the round's incumbents
   225	        new = cma_search(obj, fam, st, round_seed(k, st.restarts) + st.restarts, incumbents=round_incumbents(k, prev.best_knobs, emb))
   226	        best = new if new.best_f > prev.best_f else replace(new, best_x=prev.best_x, best_knobs=prev.best_knobs, best_f=prev.best_f, best_source=prev.best_source)
   227	        extra = reference_candidates(cell, fam, best, twin, [], order)
   228	        ref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache); ref_f = float(np.mean(ref.per_seed_normalized))
   229	        rounds.append({"round": k, "restarts_total": st.restarts * (k + 1), "cma_seeds": sorted(cma_seeds(k, st.restarts)), "attack_f": float(best.best_f),
   230	                       "attack_change": float(best.best_f - prev.best_f), "reference_f": ref_f, "reference_change": ref_f - prev_ref,
   231	                       "best_knobs": dict(best.best_knobs), "best_source": best.best_source})
   232	        if k == 1 and src is not None:                          # the registered doubling's held-out winner is round 1's search winner
   233	            reg = read(reference) if reference is not None else read(Path(src) / "doubling" / (R._safe(job["id"]) + ".json"))
   234	            h1 = R.gain_fields(R.eval_cell(job), fam, new.best_knobs, frozen_ref, SeedCache())
   235	            r1 = {**rounds[0], "heldout": {"knobs": dict(new.best_knobs), "seeds": list(R.eval_cell(job).seeds), "gain": h1["gain"]}}
   236	            gate = compare_round1(reg, r1) if reg is not None else {"pass": False, "problems": ["no registered doubling record"]}
   237	            gate["heldout_knobs"], gate["heldout_mean"] = dict(new.best_knobs), float(np.mean(h1["gain"]))
   238	        prev, prev_ref = best, ref_f
   239	        outcome = decide(k, rounds[-1], gate, stopper.allow(f"round {k + 1}", round_hours) if stopper else True, max_rounds, min_rounds)
   240	        if outcome != "continue":
   241	            break
   242	    status, passed = final_status(rounds, outcome, min_rounds)
   243	    res = {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": rounds, "status": status,
   244	           "passed_round": passed, "round1_gate": gate if gate is not None else "not compared (smoke)", "claim": CLAIM,
   245	           "frozen_best_f": float(rec["attack"]["best_f"]), "embedded_doubled_d2h3": emb is not None, "min_rounds": min_rounds,
   246	           "cost": stopper.report() if stopper else None}
   247	    if outcome != "round-1 mismatch":
   248	        held = R.gain_fields(R.eval_cell(job), fam, prev.best_knobs, frozen_ref, SeedCache())
   249	        res.update(place_heldout(status, {"knobs": dict(prev.best_knobs), "seeds": list(R.eval_cell(job).seeds), **held}))
   250	    return res
