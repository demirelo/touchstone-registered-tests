    49	def cells_for(report: dict, nesting: dict) -> dict:
    50	    """The run's cells: the flagged profit cells, then every X7-SC cell whose nesting shortfall (posthoc `nesting`) is at
    51	    least the doubling threshold (draft 3, Fable 5.2 r2 new problem 2)."""
    52	    base = sorted(flagged(report)["profit"])
    53	    nest = sorted(f"{k}|X7-SC|profit" for k, v in nesting["cells"].items() if v["shortfall"] >= THRESHOLD - 1e-12)
    54	    return {"cells": base + [c for c in nest if c not in base], "nesting": nest}
