    44	def flagged(report: dict) -> dict:
    45	    d = report["doubling"]; f = [k for k, v in d.items() if v.get("incomplete")]
    46	    return {"profit": [k for k in f if d[k].get("kind") == "profit"], "coalition": [k for k in f if d[k].get("kind") != "profit"]}
