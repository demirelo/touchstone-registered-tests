    79	def cma_seeds(k: int, restarts: int) -> set:
    80	    s = round_seed(k, restarts) + restarts                     # continue_search passes seed + restarts to cma_search
    81	    return set(range(s + 1, s + 1 + restarts))                 # cma_search uses seed + 1 + r
