   261	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   262	    """Gate mode: round 1 only. On the Mac it is compared with the frozen doubling stage run on the same machine (flagged
   263	    cells diverge across platforms); on the pod, with the registered doubling record. Saved full-budget evidence bound to
   264	    the cell's inputs, this driver, the site, and the environment."""
   265	    ref = frozen_doubling(job, out) if site == "mac" else None
   266	    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours, reference=ref)
   267	    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
   268	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "site": site, "compared_with": "frozen stage, same machine" if ref else "registered record",
   269	            "comparison": r["round1_gate"],
   270	            "round1": (r.get("rounds") or [None])[0],
   271	            "binding": bind, "environment": G.environment()}
