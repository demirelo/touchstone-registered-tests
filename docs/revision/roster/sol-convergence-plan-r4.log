   172	def decide(k: int, last: dict, gate: dict | None, cost_ok: bool, max_rounds: int = MAX_ROUNDS, min_rounds: int = 1) -> str:
   173	    """After round k: stop on a round-1 mismatch, on a pass (from round `min_rounds`), at the round cap, or (before the
   174	    next round) at the cost cap."""
   175	    if k == 1 and gate is not None and not gate["pass"]:
   176	        return "round-1 mismatch"
   177	    if k >= min_rounds and _passes(last):
   178	        return "passed"
   179	    if k >= max_rounds:
   180	        return "round cap"
   181	    return "continue" if cost_ok else "cost cap"
