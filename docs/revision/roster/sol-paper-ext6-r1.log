"""Draft-7 evaluation helpers (design 6.2, 6.6, 6.7, 9.3). False-failure refunds: refunds on failed audits in rounds
where the entity's claim did not exceed its delivered effort (a truthful job failed by noise), normalised by S*/N. Served
share: the market's served jobs over the first-best served jobs T min(J, sum k) (every capacity slot has positive
first-best surplus, `MarketConfig.validate`). The fixed-attack decomposition of a gain contrast into its attacker-profit
and reference terms. The training-selected bank envelope. The honest-replacement diagnostic: the focal provider plays
honest-max, replaces its identity once, and plays honest-max after; audited share, profit, and false refunds by age."""
from __future__ import annotations

import numpy as np

from .cell import SeedCache, run_profile
from .policies.base import Action
from .policies.honest import HonestMax

EPS = 1e-12


def _truthful(result) -> np.ndarray:
    c, e = np.asarray(result.claims, dtype=float), np.asarray(result.efforts, dtype=float)
    return np.where(np.isnan(c), False, c <= e + EPS)


def by_entity(result, table, N: int) -> np.ndarray:
    """A (T, identities) ledger table summed to (T, entities) through the episode's identity map."""
    a = np.asarray(table, dtype=float)
    if a.shape[1] == int(N) and not hasattr(result, "entity_of"):
        return a
    out = np.zeros((a.shape[0], int(N)))
    for ident, e in enumerate(result.entity_of):
        out[:, int(e)] += a[:, ident]
    return out


def false_refunds(result, focal: int, N: int) -> tuple[float, float]:
    """(focal, all other entities) refunds on failed truthful jobs, each normalised by S*/N."""
    mask = (np.asarray(result.failures) > 0) & _truthful(result)
    ref = np.where(mask, by_entity(result, result.ledger.refunds, N), 0.0); scale = float(result.sstar) / int(N)
    return float(ref[:, int(focal)].sum()) / scale, float(ref.sum() - ref[:, int(focal)].sum()) / scale


def served_share(result, cfg) -> float:
    n_fb = int(cfg.T) * min(int(cfg.J), sum(int(p.k) for p in cfg.providers))
    return float(np.asarray(result.served).sum()) / n_fb


def extras(attack_results, ref_results, cfg, focal: int) -> dict:
    """The draft-7 evaluation fields per seed (design 9.3 Q1 side fields)."""
    out = {"served_share_attack": [], "served_share_ref": [], "false_refund_focal_attack": [], "false_refund_others_attack": [],
           "false_refund_focal_ref": [], "false_refund_others_ref": []}
    for tag, res in (("attack", attack_results), ("ref", ref_results)):
        for r in res:
            f, o = false_refunds(r, focal, cfg.N)
            out[f"served_share_{tag}"].append(served_share(r, cfg))
            out[f"false_refund_focal_{tag}"].append(f); out[f"false_refund_others_{tag}"].append(o)
    return out


def decompose(row: dict, rule_r: str, rule_c: str) -> dict:
    """gain_R - gain_C = attack_term - reference_term per seed (design 6.6), from normalised per-seed profits."""
    a = np.subtract(row[rule_r]["profit_attack"], row[rule_c]["profit_attack"])
    r = np.subtract(row[rule_r]["profit_ref"], row[rule_c]["profit_ref"])
    return {"attack_term": a.tolist(), "reference_term": r.tolist()}


def envelope_rule(train: dict, rule: str) -> str:
    """The bank attack with the highest training gain against `rule` (design 6.6), ties by bank order."""
    k = list(train["rules"]).index(rule); best = None
    for i, a in enumerate(train["attacks"]):
        g = float(train["matrix"][i][k])
        if best is None or g > best[1]:
            best = (a, g)
    return best[0]


def _profit_flows(result, N: int) -> np.ndarray:
    """Per round and entity, the canonical profit flows of `Ledger.profit`: released + holdback out - cost - entry."""
    L = result.ledger
    return by_entity(result, L.released, N) + by_entity(result, L.holdback_out, N) - by_entity(result, L.cost, N) - by_entity(result, L.entry, N)


class _HonestReplacer:
    name = "honest_replacer"

    def __init__(self, at: int) -> None:
        self.at = int(at)
"""Evaluation-2 result tables for the paper, generated whole from report.json (paper draft 9 outline, "Rules for the
text"). Each row's label is the key that fetched its values, so a label cannot sit beside another row's numbers. A
string in the report (a status such as "not decided" or "unanswered: missing cell") is printed across the row. Captions
live in main.tex; these files hold only the tabular. --write writes tables/<name>.tex; --check compares them."""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from numbers_v2 import _fmt, _fmt_p  # noqa: E402

FRESH = tuple(f"fresh{i}" for i in range(6))
FAMS = ("D2+H3", "X7-SC")
CORE = ("F000", "F111", "C*")
SIDE = ("gross_eff_diff", "net_eff_diff", "ref_profit_diff", "audit_spend_diff", "false_refund_focal_diff", "false_refund_others_diff",
        "served_share_diff")


def holm_adjusted(p: list) -> list:
    """Holm step-down adjusted p-values: sorted ascending, adj_(i) = max_{j<=i} min(1, (m - j + 1) p_(j))."""
    m = len(p); order = sorted(range(m), key=lambda i: p[i]); out = [0.0] * m; run = 0.0
    for rank, i in enumerate(order):
        run = max(run, min(1.0, (m - rank) * float(p[i]))); out[i] = run
    return out


def esc(s) -> str:
    return _fmt(str(s))


def num(v) -> str:
    return _fmt(v) if not isinstance(v, str) else esc(v)


def iv(x) -> str:
    return "n/a" if not x or None in x else f"[{num(float(x[0]))}, {num(float(x[1]))}]"


def tabular(cols: str, header: list[str], rows: list[tuple[str, object]]) -> str:
    """rows: (label, list of cells) or (label, status string); a status spans the remaining columns."""
    n = len(header); out = [f"\\begin{{tabular}}{{@{{}}{cols}@{{}}}}\\toprule", " & ".join(header) + " \\\\\\midrule"]
    for label, cells in rows:
        if isinstance(cells, str):
            out.append(f"{esc(label)} & \\multicolumn{{{n - 1}}}{{l}}{{{esc(cells)}}} \\\\")
        else:
            out.append(" & ".join([esc(label)] + list(cells)) + " \\\\")
    out.append("\\bottomrule\\end{tabular}")
    return "\n".join(out) + "\n"


def q1(r: dict) -> str:
    """The stored "p" is the calibrated two-sided p-value that enters Holm over the two fixed slots (sim.decisions_v2.q1_family);
    the Holm-adjusted value is computed beside it."""
    rows = []; tests = [r["q1"]["tests"][f"C*-F111|{f}"] for f in FAMS]
    ps = [t.get("p") for t in tests]; adj = holm_adjusted([1.0 if p is None else p for p in ps]) if any(p is not None for p in ps) else [None] * len(ps)
    for f, t, a in zip(FAMS, tests, adj):
        rows.append((f, [num(t.get("estimate")), iv(t.get("interval")), esc(t.get("category")), _fmt_p(t.get("p")),
                         _fmt_p(a if t.get("p") is not None else None), esc(t.get("efficiency") or "n/a"), esc(t.get("better") or "none")]))
    return tabular("lrllrrll", ["Family", "$d$", "Interval", "Category", "$p'$ to Holm", "Holm-adj.", "Efficiency", "Better"], rows)


def q1_side(r: dict) -> str:
    rows = []
    for f in FAMS:
        s = r["q1"]["tests"][f"C*-F111|{f}"].get("side")
        rows.append((f, "not available") if not s else (f, [num(s[k]) for k in SIDE]))
    return tabular("l" + "r" * len(SIDE), ["Family", "Gross eff.", "Net eff.", "Ref.\\ profit", "Audit spend", "False-fail refunds (focal)",
                                           "False-fail refunds (others)", "Service fraction"], rows)


def q4(r: dict) -> str:
    """The stored p_gain and p_eff are the raw one-sided bootstrap p-values; q4.p holds the calibrated market maxima that
    enter Holm over six slots (sim.decisions_v2.q4_markets). Printed: raw values, the market maximum, and its Holm-adjusted value."""
    q = r["q4"]; rows = []; adj = holm_adjusted(q["p"]) if q.get("p") else [None] * len(FRESH)
    for i, m in enumerate(FRESH):
        x = q["markets"][m]
        if isinstance(x, str):
            rows.append((m, x)); continue
        dec = "pass" if m in q.get("passing", []) else "fail" if m in q.get("failing", []) else "not decided"
        rows.append((m, [num(x["gain_diff"]), num(x["gain_diff_lower"]), num(x["eff"]), num(x["eff_lower"]), _fmt_p(x["p_gain"]),
                         _fmt_p(x["p_eff"]), _fmt_p(q["p"][i] if q.get("p") else None), _fmt_p(adj[i]),
                         dec + (" (search flagged)" if x.get("search") else "")]))
    return tabular("lrrrrrrrrl", ["Market", "F000$-$F111", "Lower", "F111 eff.", "Lower", "Raw $p_{\\mathrm{gain}}$", "Raw $p_{\\mathrm{eff}}$",
                                  "Market $p'$", "Holm-adj.", "Decision"], rows)


20:A buyer of computation often cannot see the quality of delivered work and can afford to check only a sample of it. We study a repeated procurement market with noisy delivery, costly exact audits, and free identity replacement, in a mechanism class without entry fees, identity certification, or collateral before receipts; a failed audit refunds the job's escrow and bans the serving identity for a finite number of rounds. For the uniform-audit baselines with refund-and-ban enforcement and no bonds, immediate free replacement makes the ban costless. The rule we study, R3, checks every job of a new identity while the round's audits allow it, and after that window keeps targeting the newest identities, so a replacement can stay under heavy inspection: persistent age-ranked targeting rather than release by age. We report two registered tests. In the first, R3 passed its rule clause against a sealed attacker family, but the original comparative claim failed because neither baseline met its stipulated vulnerability criterion; an amended claim, registered after development results were seen, passed on the public identity-replacement family under interval procedures admitted by proxy. The second test compares R3 with C$^*$, selected in development from twelve configurations of four verified-history adaptations, at matched budget, payment, tolerance, ban, pacing, and sanctions; decomposes R3 into its three parts; adds stronger attacks; and repeats the B3--R3 comparison on six market instances drawn after the lock from a Bitcoin block hash.
21:Pooled over the six fresh markets, the registered procedure classifies R3 and C$^*$ as ``\site{abs_q1_cat}'' within the registered margin of $\pm\const{0.05}$: C$^*$ minus R3 is \site{abs_q1_est} under D2+H3 and \site{abs_q1_est_x} under X7-SC, almost all of it in the profit the attacker earns when it deviates. R3's two targeting parts are substitutes (factorial contrast \site{abs_q2_pg}), and pacing slightly raises the measured gain. At the headline market, the selected sealed-attacker policy gains \site{abs_q3_f111_h4} against R3; the selected unconstrained welfare attack lowers R3's gross efficiency to \site{abs_q3_w0}, and similarly for B3 and C$^*$; and an exploratory lottery between a welfare attack and a profitable attack, selected on the evaluation records, has estimated normalised gain \site{abs_ph_mix_gain} and gross efficiency \site{abs_ph_mix_eff} against R3, with its population profitability not established. The B3--R3 comparison passes on \site{abs_q4_k} of the six fresh markets, all of them qualified as results of the prescribed search procedure.
38:\paragraph{Contributions.} Three findings lead. (i) Persistent age-ranked targeting is not materially better than verified-history targeting at the same budget: the development-selected history comparator is pooled-equivalent to R3 within the registered margin. (ii) In the measured factorial contrasts, R3's priority phase and its newest-first targeting substitute for each other: either alone accounts for most of the reduction in the attacker's gain. (iii) Episode-level mixtures of existing public-family attacks expose a welfare weakness that the registered profit-constrained search does not cover. Supporting these are a conditional analysis of when free replacement makes a ban costless, measured failure boundaries (stronger and independently authored attackers, coalitions, the terminal-reserve collapse and a tested repair), and two registered tests whose original failure, amendments, and fresh-market replication are documented in a record to be released with the paper.
40:\paragraph{Results in brief.} Q1: pooled over the six fresh markets, R3 and C$^*$ are ``\site{int_q1_cat}'' within the registered margin under X7-SC, and likewise under D2+H3: R3 is not materially better than the development-selected verified-history comparator at the same budget. Q2: in the pooled factorial contrasts, the priority phase and newest-first targeting each lower the measured gain (main effects \site{int_q2_p} and \site{int_q2_g}), and either one alone accounts for most of the reduction. Q3: the training-selected attack envelopes have lower measured gains against R3 than against B3 on every evaluated market, a finite-search comparison that does not establish robustness to the searched families; the selected unconstrained welfare attack lowers R3's gross efficiency to \site{int_q3_w0}, and exploratory lotteries over existing attacks, selected on the evaluation records, reach efficiency well below the \site{int_w1} of the registered W1 search at non-negative estimated gain, with public-family attacks alone; the W1 search therefore supplies no efficiency bound for randomised policies, and the mixtures' population profitability is not established. Q4: the B3--R3 comparison passes on \site{int_q4_k} of six fresh markets, all three passes qualified by search flags; on the other three, R3's estimated advantage is positive but below the registered threshold.
48:\paragraph{Costly verification and audits.} Costly state verification goes back to~\cite{townsend1979optimal}; allocation with costly verification~\cite{benporath2014optimal}, limited punishments~\cite{li2020mechanism}, financially constrained agents~\cite{li2021financially}, and ex post verification with limited penalties~\cite{mylovanov2017optimal} assume persistent agents. Recursive inspection games spend a finite stock of inspections~\cite{vonstengel2016recursive}; audit games optimise randomised inspection against a best-responding attacker~\cite{blocki2013audit}; targeted and untargeted inspection under fixed capacity~\cite{liu2013enforcement} and dynamic monitoring under resource constraints~\cite{solan2021dynamic} are also studied; optimal committed audit policies against the worst equilibrium of the audited agents, with budgeted variants, are derived in~\cite{das2026optimally}. Our rules are searched and tuned heuristics, not optima of these models. Paid computation with verification by recomputation and colluding workers is analysed in~\cite{fernandezanta2015algorithmic}.
57:\paragraph{Offers, effort, delivery.} In each round an active provider privately chooses an effort $q_i \in [0, q^{\max}_i]$ for all its jobs and submits a public offer: a claim $c_i \in [0,1]$ (a promise that expected delivered quality is at least $c_i$) and a per-unit bid. A served job delivers $y = q_i + \varepsilon$ with $\varepsilon \sim N(0,\sigma^2)$, independently across jobs; the buyer's value is $v_j y$. Delivering below the claim is shading.
67:\paragraph{Benchmark and metrics.} One focal provider deviates while the others play honestly at full effort with truthful claims; this is a unilateral deviation, not an equilibrium. For a seed with first-best surplus $S^*$, the focal provider's \emph{gain} is its profit under the attack minus its profit under a selected truthful reference, divided by $S^*/N$. \emph{Gross efficiency} is $(W + \text{audit cost})/S^*$, with $W$ the realised social surplus net of audit cost; net efficiency is $W/S^*$. Gain is a difference of two searched values, so search error can bias it either way. The second test adds two objectives at its headline market: welfare attacks that minimise gross efficiency, without a constraint (W0) or subject to a nonnegative mean normalised gain over the attacker's reference on the training seeds (W1), whose profitability is then called supported only if its nominal 95\% lower bound on the evaluation seeds is nonnegative; and coalitions of two or five providers, scored by the total gain $G_{\mathrm{tot}}$ and by the worst member's mean gain $G_{\min}$, both against a coordinated truthful reference. Coalition results say nothing about coalition stability.
112:Every unilateral attacker family reads only the provider's own history across its identities, the round, its own parameters, and the rule's public constants $T$ and $L$; it does not observe the remaining global budget or other identities' ranks. Coalition members may share their members' own histories. For each parametrised family a registered search (CMA-ES with restarts on training seeds) finds the attack. A rule's truthful reference is then selected on training seeds from one menu built from its D2+H3 and X7-SC searches and frozen; the W1 welfare searches, which need that reference, run after the freeze; coalitions use their own staged joint truthful reference; and no evaluation-seed episode of a market runs before all of its choices are frozen.
121:X5-AG/v2 & Age-gated shading with the public constants & \const{7} & second test, all seven markets \\
122:H4 & Sealed, defence-aware, written after every defender was frozen; loaded once after the draw & at most \const{15} & second test, headline \\
130:H4's code was committed only by its hash before the lock and released after the report review; it is in \texttt{sealed2/h4/} of the release (bundle SHA-256 \texttt{cba512aa\ldots}), with its author's note on which families it contains as special cases.
132:\paragraph{Search quality.} Scheduled cells get a doubling check: the registered search continues with as many restarts again, and the cell is flagged if the doubled search improves the attacker's normalised profit or the reference's normalised profit (profit cells), the welfare attack's efficiency (welfare cells), or the coalition objective by at least \const{0.005}, or if a W1 search finds a feasible candidate where the original found none. A doubled search's winner is reported beside the cell and never replaces its frozen estimate. Cells without a scheduled check carry no search-quality claim. A cell is \emph{missing} if it did not complete or is invalid: not run (a cap stop or a cut), a refused sample, a nonfinite statistic, a search with no finite candidate, or a failed load of H4; a missing cell removes every decision that uses it. A \emph{search-flagged} cell keeps its decision, labelled as a decision about the prescribed search procedure, and leaves that rule's robustness statement for that family unanswered. The search bounds exposure to the searched families and optimiser; it does not certify robustness.
135:\paragraph{Claims.} The original claim was locked and timestamped on 17 October 2026, before the rule was implemented. At $\beta = \evone{0.05}$, the median position, and on 40 fresh seeds, its \emph{rule clause} required, for each confirmatory family, a one-sided 95\% lower bound of R3's gross efficiency of at least \evone{0.90}, a one-sided 95\% upper bound of its gain of at most \evone{0.30}, and audit cost within budget on every seed. Its \emph{baseline clause} required, for each of B2 and B3, a confirmatory family in which either the paired inflation-caused efficiency-loss difference exceeded \evone{0.05} or the baseline's gain exceeded \evone{1.0}, at the 98.75\% level. Amendment 1, registered after the baselines' development results showed that the baseline clause was unlikely to pass, added an amended claim on the public identity-replacement family D2+H3: the same absolute part as the rule clause (gross-efficiency lower bound at least \evone{0.90}, gain upper bound at most \evone{0.30}, budget compliance) and paired gain reductions of at least \evone{0.10} against B2 and B3 at the 98.75\% level, plus the H2 rule clause. After a development test killed the first rule, Amendment 3 registered one successor, R3, before its implementation.
137:\paragraph{Sealing.} The sealed family H2 was written in a separate session from a pinned copy of the repository, and only its hash was committed. Before unsealing, at the author's request, the custodian disclosed that H2 contains D2; that H2 does not exit or re-enter was stated in the public specification before the lock.
163:\paragraph{Questions.} Q1: does R3 ($F_{111}$) leave a lower or higher identity-replacement gain than C$^*$, at the fixed pair? Q2: what do the priority phase, the residual targeting, and the pacing contribute, alone and together? Q3: do the results hold against X7-SC, X5-AG/v2, the defence-aware sealed family H4, welfare attacks, and coalitions, and does R4 repair the reserve collapse? Q4: does the first test's comparison of B3 and R3 under D2+H3 replicate on fresh markets? Q1 and Q4 are confirmatory; Q2 and Q3 are descriptive.
165:\paragraph{Development.} All choices before the draw were development, on the headline market and the development instance dev0 (branch \texttt{two20k}): a benchmark priced every cell; the comparator was selected and the tuned variants were tuned; the defenders were frozen at a signed commit; a separate session wrote H4 against the frozen defenders and committed only its hash; a coverage check on frozen development attacks admitted calibration multipliers $\kappa = \const{0.5}$ for Q1 and $\kappa = \const{0.25}$ for Q4; and the predictions were written and hashed. Budget caps were \const{12} USD for development and \const{40} USD for evaluation, within a written authorisation of \const{52} USD. The evaluation cap forced three registered cuts: the tuned variants, H4, and the D2 extras run on the headline market only.
178:Q2, Q3 & Registered analyses descriptive, with nominal intervals and extrema selected on training data; the post hoc lottery analysis selects its companion and weight on evaluation data. \\\bottomrule
247:\paragraph{Stronger attacks and where R3 fails (Q3).} Table~\ref{tab:q3-envelope} gives each core rule's attack envelope: the family with the highest training gain, evaluated unchanged. These are finite-search results, not bounds on the families. Against B3 the selected envelope reaches \site{r_q3_f000_f1} on fresh1; against R3 it is \site{r_q3_f111_f1} there, and against C$^*$ \site{r_q3_cs_f1}, from \site{r_q3_cs_f1_fam}. H4 was written in a separate session against the frozen defenders and committed by its hash before the lock; its author's containment note states that it contains D2+H3 exactly as a special case, so it extends the public family rather than offering a disjoint attack concept. Evaluated at the headline market only, its selected search gains \site{r_q3_f111_h4} against R3 and \site{r_q3_f000_h4} against B3. Robustness against D2+H3 is unanswered for every core rule because of search flags, and so is R3's robustness against X7-SC; X5-AG/v2 and H4 carry no search-quality claim. Welfare attacks are the clearest weakness. At the headline market, the selected W0 attacks (no profit constraint) yield gross efficiency \site{r_q3_w0_f000} for B3 and \site{r_q3_w0} for R3, with gains relative to the truthful reference of \site{r_q3_w0g_f000} and \site{r_q3_w0g_f111}; C$^*$ is like R3. Under the prescribed W1 searches (mean gain at least zero), the selected feasible attacks yield efficiency \site{r_q3_w1} for R3, while B3 stays at \site{r_q3_w1_f000} (Table~\ref{tab:q3-welfare}). These finite-search results are not lower bounds on efficiency over a broader policy class. An episode-level mixture, which picks a welfare attack or a profitable attack at the start of each episode, satisfies a mean-gain constraint only when its probability-weighted component gains satisfy that constraint; we examine such mixtures on the existing evaluation records. On the records used to select them, W0 weights of \site{r_ph_w_r3} for R3 and \site{r_ph_w_cs} for C$^*$, with the H4 attack as companion, give estimated normalised gains of \site{r_ph_g_r3} and \site{r_ph_g_cs} and gross efficiencies of \site{r_ph_e_r3} and \site{r_ph_e_cs}; with the public D2+H3 attack as companion the efficiencies are \site{r_ph_e_r3_d} and \site{r_ph_e_cs_d} (Tables~\ref{tab:ph-welfare} and~\ref{tab:ph-welfare-sens}). The registered W1 constraint is a non-negative mean gain on the training seeds. Reconstructed from the search archives, the training mean gains of these mixtures, each at its rule--companion pair's weight in Table~\ref{tab:ph-welfare}, are \site{r_ph_t_r3} and \site{r_ph_t_r3_d} for R3 and \site{r_ph_t_cs} and \site{r_ph_t_cs_d} for C$^*$ (H4 and D2+H3 companions): three meet the training constraint, but C$^*$'s public-family mixture does not. At its evaluation-selected weight of \site{r_ph_wd_cs}, C$^*$'s public-family mixture fails the training constraint. At \site{r_ph_fw_cs}, the largest weight on the same grid at which both the training mean gain and the evaluation bound are non-negative, it has training gain \site{r_ph_ft_cs}, estimated evaluation gain \site{r_ph_fg_cs}, and gross efficiency \site{r_ph_fe_cs}, against \site{r_ph_w1_cs} under the registered W1 search (last row of Table~\ref{tab:ph-welfare}). Both rules therefore show substantial empirical efficiency losses with public-family mixtures alone; H4 is not needed for a drop of this size, and population profitability remains unestablished. The weights are the largest at which a nominal one-sided \const{95} percent normal bound on the mean gain stays non-negative; that bound is not adjusted for selection, the weight and the companion family were chosen on the evaluation seeds, and the bound is close to zero at the selected weights, so this checks the policy class and is not an out-of-sample estimate. The mixture efficiencies stay above \const{0.90}; the analysis does not touch Q4 or its registered predicate. For coalitions of two synchronised members, the selected total gains are \site{r_q3_coal_f000} against B3 and \site{r_q3_coal_f111_c2} against R3 (search flagged); for five, \site{r_q3_coal_f000_c5} and \site{r_q3_coal_f111} (total objective), while the policy selected for the minimum-member objective leaves R3's worst member a mean gain of \site{r_q3_coal_f111_c5min}; the decoy-and-beneficiary family gives \site{r_q3_db_f000} against B3 and \site{r_q3_db_f111} against R3. These comparisons establish neither coalition stability nor an ordering across every coalition family (Table~\ref{tab:q3-coalitions}). At $\rho = \const{1}$, where R3's terminal reserve collapses, R3 leaves \site{r_rep_f111} under D2+H3; the repair R4 lowers this to \site{r_rep_r4} and C$^*$ with the capped schedule (C$^*$/S2) to \site{r_rep_cs2} (Table~\ref{tab:q3-repair}).
250:\caption{Exploratory, after the report: at the headline market, the efficiency of the selected W1 and W0 attacks, and, for each companion family, the episode-level lottery between the W0 attack and a profitable attack of the same rule (two displayed companions, H4 and D2+H3; all five examined companions are in \texttt{posthoc.json}) at the largest W0 weight on a grid of step \const{0.0005} whose mean gain keeps a non-negative nominal one-sided \const{95} percent lower bound, unadjusted for selection; estimated gain, that bound, and the mixture's efficiency, all on the evaluation records that selected the weight; ``Train gain'' is the mixture's mean gain on the training seeds (the registered W1 constraint requires it to be non-negative), reconstructed from the search archives. The row marked training-feasible, added after external review, uses the largest grid weight at which both the evaluation bound and the training gain are non-negative. B3's W0 attack has a positive estimated gain.}\label{tab:ph-welfare}
255:\caption{Exploratory, evaluation records: estimated normalised gain / gross efficiency of the episode-level lottery at fixed display weights $w$ (not separately optimised), for the two displayed companions, H4 and D2+H3; all five examined companions are in \texttt{posthoc.json}.}\label{tab:ph-welfare-sens}
261:\caption{Q3 attack envelope per core rule and market; H4 at the headline market only.}\label{tab:q3-envelope}
266:\caption{Q3 training-selected welfare attacks under W0 and W1, with W1's profitability class.}\label{tab:q3-welfare}
293:\paragraph{Predictions.} Tables~\ref{tab:predictions} and~\ref{tab:predictions-b} score every registered prediction from the report. For Q4-b, the original scoring script compared the report's raw component $p$-values, although the prediction is registered on calibrated values; the corrected script compares the calibrated values, \site{r_pred_q4b_g} against \site{r_pred_q4b_e} on each of fresh0, fresh2, and fresh5. The prediction remains fulfilled and the total is unchanged: a scoring correction with no change of verdict, separate from the corrected labels of Tables~\ref{tab:q1} and~\ref{tab:q4}. The predictions differ in stakes and are not independent, so the count of fulfilled predictions is not a validation score. The failures are informative: we expected the priority phase to matter little, the replication to hold on at least five markets, X5-AG/v2 to stay below D2+H3, and the unconstrained welfare attack to leave R3's and C$^*$'s efficiency at the registered level, and none of these held.
309:\paragraph{What the two tests support together.} At the fixed parameters, the prescribed D2+H3 searches yield a lower measured gain for R3 than for B3 on every sampled market, with R3's registered efficiency condition met. The gain is measured against each rule's frozen truthful reference; it does not isolate the marginal benefit of being allowed to replace identities, which would need a matched comparison with replacement disabled. The registered comparison does not establish that margin across all six sampled fresh markets. The pooled factorial contrasts and the comparison with C$^*$ support a measured benefit shared by more than one targeting design; they do not establish the same ordering for every variant on every market. At $\rho = \const{0.2}$, pacing slightly raises the measured gain while changing efficiency little; at $\rho = \const{1}$, the terminal reserve that pacing adds exhausts the allowance and causes R3's collapse, which the capped schedule only partly repairs.
311:\paragraph{What they do not support.} The selected unconstrained welfare attacks lower the gross efficiency of all three core rules by a similar amount while earning less than the truthful reference against R3 and C$^*$; that is a loss relative to honest play, not necessarily a negative profit. Exploratory mixtures expose policies omitted by the prescribed W1 search that have substantially lower empirical efficiency at non-negative estimated gain; their population profitability remains unestablished, and the favourable W1 result for R3 and C$^*$ is not a lower bound on efficiency. Robustness to the searched families is not established: the doubling checks find missed improvements but cannot bound the remaining gap, and several decisions hold only for the prescribed search procedure. The fresh-market configurations differ from the registered ones in the last binary digit; re-evaluating the frozen policies and references with the registered configurations leaves every Q1 and Q4 decision unchanged, a check that does not repeat search or reference selection.
313:\paragraph{Exact but costly checks.} The model's audit already reveals delivered quality exactly, at a cost charged to the operator's budget. An execution proof such as FlashProve checks a different object, that a committed computation ran, and does not remove delivery noise. It fits the model's audit cost only if the operator funds both proving and verification; provider-funded proving would need separate incentive accounting. Either way, which jobs to check and how to sanction remain the questions; if the cost of a proof fell close to that of the computation itself, the case for sampled audits would weaken. This discussion is outside the registered tests and changes none of their claims.
319:For the uniform-audit baselines with refund-and-ban enforcement and no bonds, free replacement removes the ban's continuation cost. At the fixed parameters, the prescribed D2+H3 searches yield a lower measured gain for R3 than for B3 on every sampled market, but the registered gain-and-efficiency comparison passes on only three of six fresh markets, all three qualified by search flags. R3 and the development-selected verified-history comparator are pooled-equivalent within the registered margin under both Q1 families. At the headline market, the selected unconstrained welfare attacks yield gross efficiency of about \site{c_w0} against all three core rules and earn less than the truthful reference against R3 and C$^*$. The registered W1 search yields efficiency near \site{c_w1} for R3 and C$^*$; exploratory episode-level mixtures selected on the evaluation records yield \site{c_mx_r3} and \site{c_mx_cs} at non-negative estimated gain. The registered W1 search therefore supplies no efficiency bound for randomised policies; the population profitability of the selected mixtures remains unestablished. These conclusions concern frozen searches and references, with interval calibration admitted on development fixtures. The record of both tests, including the original failure, the amendments, the deviations, and the failed predictions, will be released with the paper.
322:\paragraph{Availability.} The paper artifact will have its own release commit and archive hash. It identifies the frozen evaluation code by the signed tag \texttt{protocol-v2} and preserves the original tagged-code report. It contains the code, the tuned files, all records of both tests (including incomplete, failed, and cut cells), the market generator, the block headers, the released H4 bundle, and the deviation evidence, and, separately dated, the decision-stability re-evaluation, the exploratory post hoc analyses with the per-seed evaluation and training inputs of the lottery analysis, the prediction-scoring correction with its regression test, the inference audit, and the paper sources. One command (\texttt{docs/revision/deviation/reproduce\_deviation.py}) checks the artifact against the tag and reproduces the second test's report under the disclosed configuration substitution; the paper's second-test tables and figures are regenerated from the tagged report, the disclosed stability output, and the exploratory post hoc and audit outputs by the scripts in \texttt{docs/revision/paper-v2}, \texttt{docs/revision/posthoc}, and \texttt{docs/revision/audit}, and the first test's records and verdict are in the release as recorded in October~\const{2026}.

