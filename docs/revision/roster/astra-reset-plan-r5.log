   179	def copy_inputs(src, out, need: dict[str, str]) -> None:
   180	    """Copy each input read-only, checked against its recorded hash; an existing identical copy is kept."""
   181	    for rid, sha in sorted(need.items()):
   182	        p, q = R.path_of(src, rid), R.path_of(out, rid)
   183	        if not p.exists():
   184	            _refuse(f"input {rid} is missing in {src}")
   185	        if sha_file(p) != sha:
   186	            _refuse(f"input {rid} differs from the hash in the original records")
   187	        if q.exists():
   188	            if sha_file(q) != sha:
   189	                _refuse(f"{q} exists and differs from the original {rid}")
   190	            continue
   191	        q.parent.mkdir(parents=True, exist_ok=True); shutil.copyfile(p, q); q.chmod(0o444)
   192	    prev = read(Path(out) / "inputs.json")
   193	    if prev is not None and prev != {**prev, **need}:
   194	        _refuse("inputs.json lists other hashes for the same records")
   195	    write(Path(out) / "inputs.json", {**(prev or {}), **need})
