   364	
   365	def compare_doubling(src, out, rid: str) -> dict:
   366	    """Validation (d), plan draft 5: a doubling record against the registered one; exact on the flag, the seeds, and the
   367	    discrete knobs; 1e-9 on the continuous knobs, the changes, and the held-out per-seed gains."""
   368	    p = lambda b: Path(b) / "doubling" / (R._safe(rid) + ".json")
   369	    a, b = read(p(src)), read(p(out))
   370	    if a is None or b is None:
   371	        return {"pass": False, "problems": ["a record is missing"]}
   372	    problems = []
   373	    if bool(a.get("incomplete")) != bool(b.get("incomplete")):
   374	        problems.append("flag differs")
   375	    ha, hb = a["heldout"], b["heldout"]
   376	    if ha["seeds"] != hb["seeds"]:
   377	        problems.append("seeds differ")
   378	    ka, kb = ha["knobs"], hb["knobs"]; disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   379	    if set(ka) != set(kb) or any(ka[k] != kb[k] for k in disc):
   380	        problems.append("discrete knob differs")
   381	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   382	    chg = max(abs(a.get(k, 0.0) - b.get(k, 0.0)) for k in ("attack_change", "reference_change"))
   383	    gd = max((abs(x - y) for x, y in zip(ha["gain"], hb["gain"])), default=0.0) if len(ha["gain"]) == len(hb["gain"]) else float("inf")
   384	    if rel > KNOB_TOL or chg > GAIN_TOL or gd > GAIN_TOL:
   385	        problems.append(f"tolerance exceeded (knobs {rel:.3g}, changes {chg:.3g}, gains {gd:.3g})")
   386	    return {"pass": not problems, "max_knob_rel": rel, "max_change_abs": chg, "max_gain_abs": gd, "problems": problems}
   387	
   388	
   389	def reproduce_doubling(src, out, rid: str, root: str, cfgs: dict, params: dict, salt_sha256: str) -> dict:
   390	    """Rerun the registered doubling check of one fresh-market D2+H3 cell with the frozen stage, against copies of its inputs."""
   391	    label, rest = rid.split("@", 1); rule = rid.split("|")[1]
   392	    j = R.job(R.market(label, root, 0.2, cfg=cfgs[label], salt_sha256=salt_sha256), rule, "D2+H3", "profit", params=params)
   393	    need = inputs(src, [j]); need[j["id"]] = sha_file(R.path_of(src, j["id"]))
   394	    copy_inputs(src, out, need)
   395	    rec = R.stage_doubling(j, out, CUTS, H4_EXCLUDED)
   396	    write(Path(out) / "doubling" / (R._safe(rid) + ".json"), {"stage": "doubling", "id": rid, **rec})
   397	    return compare_doubling(src, out, rid)
   398	
   399	
   400	def reproduce(src, out, root: str, params: dict, salt_sha256: str, workers: int = 1) -> dict:
   401	    """Rerun the registered headline F111 D2 search and evaluation through this script's path (input copies, freeze,
   402	    acceptance) and compare with the registered records."""
   403	    mkt = R.market("headline", root, 0.2, salt_sha256=salt_sha256)
   404	    j = R.job(mkt, "F111", "D2", "profit", params=params)
   405	    reg = read(R.path_of(src, REPRO))
   406	    container = {"headline": {"container_hash": (reg or {}).get("provenance", {}).get("cfg_sha256")}}
   407	    preflight(out, src, [j], salt_sha256, container)
   408	    copy_inputs(src, out, inputs(src, [j]))
   409	    run_stage("search", [j], out, workers); prefreeze(out, [j])
   410	    accept(out, [j], salt_sha256, {"headline": {"container_hash": reg["provenance"]["cfg_sha256"]}})
   411	    run_stage("evaluate", [j], out, workers)
   412	    rep = compare(src, out); write(Path(out) / "gate.json", {"stage": "reproduction gate", "cell": REPRO, **rep}); inventory(out)
   413	    return rep
