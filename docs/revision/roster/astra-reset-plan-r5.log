   416	def main(argv=None) -> int:
   417	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   418	    ap.add_argument("--src", default=str(EVAL_ALL)); ap.add_argument("--out", required=True)
   419	    ap.add_argument("--draw", default=str(ROOT / "results/v2/draw/draw.json")); ap.add_argument("--instances", default=str(ROOT / "results/v2/draw/instances.json"))
   420	    ap.add_argument("--cfgs", default=str(ROOT / "results/v2/deviation/cfg_linux.json")); ap.add_argument("--addendum", default=str(ROOT / "results/v2/report/addendum.json"))
   421	    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
   422	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
   423	    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--smoke", action="store_true")
   424	    ap.add_argument("--reproduce", action="store_true", help=f"validation (a): rerun {REPRO} and compare (plan draft 5)")
   425	    ap.add_argument("--reproduce-doubling", dest="repro_dbl", default=None, help="validation (d): a registered D2+H3 doubling cell id")
   426	    ap.add_argument("--report", default=str(ROOT / "results/v2/report/report.json"), help="for the diagnostics stage")
   427	    a = ap.parse_args(argv); out = Path(a.out); check_out(out, a.src)
   428	    from sim.records import cfg_from_dict
   429	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   430	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
   431	    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
   432	    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   433	    if a.repro_dbl:
   434	        rep = reproduce_doubling(a.src, out, a.repro_dbl, root, cfgs, json.loads(Path(a.params).read_text()), salt_sha)
   435	        print(json.dumps({"reproduce_doubling": a.repro_dbl, **rep}))
   436	        return 0 if rep["pass"] else 1
   437	    if a.reproduce:
   438	        rep = reproduce(a.src, out, root, json.loads(Path(a.params).read_text()), salt_sha, a.workers)
   439	        print(json.dumps({"reproduce": REPRO, **rep}))
   440	        return 0 if rep["pass"] else 1
   441	    jobs = build_jobs(root, cfgs, json.loads(Path(a.params).read_text()), salt_sha, tuple(a.markets.split(",")), a.smoke)
   442	    check_configs(jobs, container); check_salt(out, salt_sha, jobs); check_commit(jobs); check_code()
   443	    if not a.smoke:
   444	        check_pairing(a.src, jobs)
   445	    steps = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory") if a.stage == "all" else (a.stage,)
   446	    for st in steps:
   447	        if st == "inputs":
   448	            copy_inputs(a.src, out, inputs(a.src, jobs))
   449	        elif st == "search":
   450	            run_stage("search", jobs, out, a.workers)
   451	        elif st == "freeze":
   452	            prefreeze(out, jobs)
   453	        elif st == "diagnostics":
   454	            write(out / "diagnostics.json", diagnostics(a.src, out, jobs, json.loads(Path(a.report).read_text())))
   455	        elif st in ("evaluate", "doubling"):
   456	            accept(out, jobs, salt_sha, container, src=a.src); run_stage(st, jobs, out, a.workers)
   457	        else:
   458	            inventory(out)
   459	        print(json.dumps({"stage": st, "jobs": len(jobs)}), flush=True)
   460	    return 0
