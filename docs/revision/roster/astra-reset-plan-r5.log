   144	def inputs(src, jobs: list[dict]) -> dict[str, str]:
   145	    """Every record the frozen evaluation and doubling stages read for `jobs`, with the hash the original records hold:
   146	    the reference from the context's original freeze, its menu and bank records from the reference's `upstream`, and
   147	    (recursively) the `upstream` of each copied search record."""
   148	    need: dict[str, str] = {}
   149	    for j in jobs:
   150	        ctx = j["context"]; fr = read(R.path_of(src, f"freeze/{ctx}"))
   151	        if fr is None:
   152	            _refuse(f"the original freeze of {ctx} is missing")
   153	        if "cuts" not in fr or "h4_excluded" not in fr or fr["cuts"] != CUTS or fr["h4_excluded"] != H4_EXCLUDED:
   154	            _refuse(f"the original freeze of {ctx} does not state cuts {CUTS} with H4 loaded")
   155	        rid = f"reference/{ctx}/{j['rule']}"
   156	        if rid not in fr["records"]:
   157	            _refuse(f"{rid} is not in the original freeze of {ctx}")
   158	        ref = read(R.path_of(src, rid))
   159	        if ref is None:
   160	            _refuse(f"{rid} is missing in {src}")
   161	        want = _expected_reference_upstream(rid)
   162	        if want is not None and set(ref.get("upstream") or {}) != want:
   163	            _refuse(f"{rid}: its dependencies are not the registered menu and cuts-{CUTS} bank")
   164	        need[rid] = fr["records"][rid]; todo = dict(ref["upstream"])
   165	        while todo:
   166	            u, s = todo.popitem()
   167	            if need.setdefault(u, s) != s:
   168	                _refuse(f"{u}: two original records hold different hashes")
   169	            if fr["records"].get(u, s) != s:
   170	                _refuse(f"{u}: its hash differs from the original freeze of {ctx}")
   171	            for k, v in ((read(R.path_of(src, u)) or {}).get("upstream") or {}).items():
   172	                if need.get(k, v) != v or todo.get(k, v) != v:
   173	                    _refuse(f"{k}: two original records hold different hashes")
   174	                if k not in need:
   175	                    todo[k] = v
   176	    return need
