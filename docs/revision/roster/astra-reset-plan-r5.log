   264	def reset_stats(results, focal: int) -> dict:
   265	    """Plan section 4: per episode, the focal provider's identity replacements, the rounds they were created, the rounds
   266	    without a focal offer (banned or waiting), and the ban rounds imposed on its identities."""
   267	    import numpy as np
   268	    resets, rounds, no_offer, bans = [], [], [], []
   269	    for r in results:
   270	        mine = [i for i, e in enumerate(r.entity_of) if e == focal]
   271	        new = [i for i in mine if r.identity_generation[i] > 0]
   272	        resets.append(len(new)); rounds.append([int(r.identity_round[i]) for i in new])
   273	        no_offer.append(int(np.isnan(r.claims[:, focal]).sum()))
   274	        bans.append(int(sum(v for h in r.history for i, v in h.consequences.bans.items() if i in mine)))
   275	    return {"resets": resets, "reset_rounds": rounds, "no_offer_rounds": no_offer, "ban_rounds": bans,
   276	            "mean_resets": float(np.mean(resets)), "p_any_reset": float(np.mean([x > 0 for x in resets])),
   277	            "mean_no_offer_rounds": float(np.mean(no_offer)), "mean_ban_rounds": float(np.mean(bans))}
