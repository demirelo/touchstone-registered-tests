   315	KNOB_TOL, GAIN_TOL = 1e-9, 1e-9                      # plan draft 5, section 3 (a)
   316	
   317	
   318	EXACT_PROV = ("runner_sha256", "salt_sha256", "cfg_sha256", "rule_params_sha256", "root", "seeds_train", "seeds_val", "seeds_eval", "context", "budget")
   319	
   320	
   321	def _finite(*xs) -> bool:
   322	    import math
   323	    return all(math.isfinite(v) for x in xs for v in (x if isinstance(x, (list, tuple)) else [x]) if isinstance(v, (int, float)))
   324	
   325	
   326	def compare(src, out, rid: str = REPRO) -> dict:
   327	    """Validation (a), plan draft 5: exact on the provenance keys (the commit may differ), the episode count, the attack and
   328	    twin archive sizes, `best_source`, the discrete knobs, the search and evaluation dependency ids, the reference hash and
   329	    the seeds; continuous knobs within KNOB_TOL relative and per-seed gains within GAIN_TOL absolute; every value finite.
   330	    `identical` additionally needs bit-identical knobs and gains."""
   331	    a, b = read(R.path_of(src, rid)), read(R.path_of(out, rid)); ea, eb = read(R.eval_path(src, rid)), read(R.eval_path(out, rid))
   332	    if None in (a, b, ea, eb):
   333	        return {"pass": False, "identical": False, "problems": ["a record is missing"]}
   334	    problems = []
   335	    ka, kb = a["attack"]["best_knobs"], b["attack"]["best_knobs"]
   336	    if not _finite(list(ka.values()), list(kb.values()), ea["gain"], eb["gain"]):
   337	        problems.append("nonfinite value")
   338	    if set(ka) != set(kb):
   339	        problems.append("knob names differ")
   340	    disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   341	    if any(ka[k] != kb.get(k) for k in disc):
   342	        problems.append("discrete knob differs")
   343	    rel = max((abs(ka[k] - kb[k]) / max(abs(ka[k]), 1e-300) for k in ka if k not in disc and k in kb), default=0.0)
   344	    if not rel <= KNOB_TOL:
   345	        problems.append(f"knob tolerance exceeded ({rel:.3g})")
   346	    for k in EXACT_PROV:
   347	        if a["provenance"].get(k) != b["provenance"].get(k):
   348	            problems.append(f"{k} differs")
   349	    ua, ub = ea.get("upstream") or {}, eb.get("upstream") or {}
   350	    refs = sorted(u for u in ua if u.startswith("reference/"))
   351	    for what, x, y in (("episode count", a.get("runs"), b.get("runs")), ("best_source", a["attack"].get("best_source"), b["attack"].get("best_source")),
   352	                       ("archive size", len(a["attack"].get("archive", [])), len(b["attack"].get("archive", []))),
   353	                       ("twin archive size", len((a.get("twin") or {}).get("archive", [])), len((b.get("twin") or {}).get("archive", []))),
   354	                       ("dependency set", sorted(a.get("upstream") or {}), sorted(b.get("upstream") or {})),
   355	                       ("evaluation dependency set", sorted(ua), sorted(ub)), ("reference hash", [ua.get(r) for r in refs], [ub.get(r) for r in refs]),
   356	                       ("seeds", ea["seeds"], eb["seeds"])):
   357	        if x != y:
   358	            problems.append(f"{what} differs")
   359	    gd = max((abs(x - y) for x, y in zip(ea["gain"], eb["gain"])), default=0.0) if len(ea["gain"]) == len(eb["gain"]) else float("inf")
   360	    if not gd <= GAIN_TOL:
   361	        problems.append(f"gain tolerance exceeded ({gd:.3g})")
   362	    return {"pass": not problems, "identical": not problems and ka == kb and ea["gain"] == eb["gain"], "max_knob_rel": rel, "max_gain_abs": gd, "problems": problems}
