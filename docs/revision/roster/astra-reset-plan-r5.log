   326	def compare(src, out, rid: str = REPRO) -> dict:
   327	    """Validation (a), plan draft 5: exact on the provenance keys (the commit may differ), the episode count, the attack and
   328	    twin archive sizes, `best_source`, the discrete knobs, the search and evaluation dependency ids, the reference hash and
   329	    the seeds; continuous knobs within KNOB_TOL relative and per-seed gains within GAIN_TOL absolute; every value finite.
   330	    `identical` additionally needs bit-identical knobs and gains."""
   331	    a, b = read(R.path_of(src, rid)), read(R.path_of(out, rid)); ea, eb = read(R.eval_path(src, rid)), read(R.eval_path(out, rid))
   332	    if None in (a, b, ea, eb):
   333	        return {"pass": False, "identical": False, "problems": ["a record is missing"]}
   334	    problems = []
   335	    ka, kb = a["attack"]["best_knobs"], b["attack"]["best_knobs"]
   336	    if not _finite(list(ka.values()), list(kb.values()), ea["gain"], eb["gain"]):
   337	        problems.append("nonfinite value")
   338	    if set(ka) != set(kb):
   339	        problems.append("knob names differ")
   340	    disc = [k for k in ka if isinstance(ka[k], int) and not isinstance(ka[k], bool)]
   341	    if any(ka[k] != kb.get(k) for k in disc):
