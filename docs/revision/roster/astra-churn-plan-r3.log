   278	def check_cap(started: float | None, need_s: float, cap: float = STOP_USD, usd_per_hour: float = POD_USD_PER_HOUR, now: float | None = None,
   279	              prior_usd: float = 0.0) -> None:
   280	    """An estimate-based stage-admission limit. No running stage is ever killed (author, 2026-11-10): before each stage,
   281	    the pod time billed since `started`, plus the charges of earlier failed attempts (`prior_usd`), plus the stage's
   282	    estimate, is compared with the cap, and the driver stops between stages if it would be passed. A stage that overruns
   283	    its estimate can therefore end above the cap; pod deletion on completion or failure is the launcher's job."""
   284	    import time
   285	    if started is None:
   286	        return
   287	    spent = float(prior_usd) + ((now if now is not None else time.time()) - float(started)) / 3600 * usd_per_hour
   288	    need = float(need_s) / 3600 * usd_per_hour
   289	    if spent + need > cap:
   290	        raise SystemExit(f"churn arm stopped between stages: {spent:.2f} USD billed + {need:.2f} USD for the next stage would pass the {cap:.2f} USD cap")
