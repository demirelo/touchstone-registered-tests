   269	def check_started(started, now: float | None = None) -> None:
   270	    """Production runs need the pod's allocation time (epoch seconds, in the past)."""
   271	    import math
   272	    import time
   273	    now = time.time() if now is None else now
   274	    if started is None or not isinstance(started, (int, float)) or not math.isfinite(started) or not (1.6e9 < float(started) <= now):
