scripts/revision_v2.py:1322:def main(argv=None) -> int:
     1	"""The 2 x 2 x 2 decomposition of R3 (design 3.2) and the repaired R3, R4 (design 3.4). Every cell is B3's allocation and
     2	payment with refund-and-ban enforcement; cells differ in pacing (S: B3's spread count or R3's reserve schedule) and in
     3	selection (P: the priority phase over identities younger than L rounds; G: the newest-first half of the residual). F000 is
     4	B3, F111 is R3, F011 is the killed amendment-2 rule (tests/oracles). Ties: when P = G = 0 the uniform order is B3's (stable
     5	order of the audit key over jobs in assignment order); otherwise R3's (audit key, then job)."""
     6	from __future__ import annotations
     7	
     8	import numpy as np
     9	
    10	from .base import AuditRecord, Consequences, Mechanism, Offers, StateView
    11	from .pacing import ReservePacing, spread_cap, spread_count
    12	from .second_score import SecondScore
    13	
    14	NAMES = tuple(f"F{p}{g}{s}" for p in (0, 1) for g in (0, 1) for s in (0, 1)) + ("R4",)
    15	
    16	
    17	def select(jobs_by_identity: dict, audit_key, first_round: dict, t: int, L: int, k: int, P: int, G: int, order: list | None = None) -> list:
    18	    """k audited jobs in order. Priority phase (P = 1): the jobs of identities with 0 <= t - first_round < L, by (-first_round,
    19	    audit_key, job). Residual r: with G = 1, ceil(r / 2) picks by (-first_round, audit_key, job), then uniform by (audit_key, job);
    20	    with G = 0, all uniform. With P = G = 0, uniform is B3's stable audit-key order over `order` (jobs in assignment order)."""
    21	    remaining = {int(j): int(i) for i, jobs in jobs_by_identity.items() for j in jobs}
    22	    k = max(0, min(int(k), len(remaining)))
    23	    if not P and not G:
    24	        jobs = np.asarray(order if order is not None else list(remaining), dtype=np.int64)
    25	        idx = np.argsort(np.asarray(audit_key)[jobs], kind="stable")
    26	        return jobs[idx[:k]].tolist()
    27	    born = lambda i: int(first_round.get(i, t))
    28	    newest = lambda j: (-born(remaining[j]), float(audit_key[j]), j)
    29	    chosen: list = []
    30	    if P:
    31	        fresh = sorted((j for j, i in remaining.items() if 0 <= int(t) - born(i) < int(L)), key=newest)
    32	        for j in fresh[:k]:
    33	            remaining.pop(j); chosen.append(j)
    34	    r = k - len(chosen)
    35	    k_t = (r + 1) // 2 if G else 0
    36	    for _ in range(k_t):
    37	        pick = min(remaining, key=newest)
    38	        remaining.pop(pick); chosen.append(pick)
    39	    rest = sorted(remaining, key=lambda j: (float(audit_key[j]), j))
    40	    chosen.extend(rest[: r - k_t])
    41	    return chosen
    42	
    43	
    44	class FactorialRule(Mechanism):
    45	    def __init__(self, P: int, G: int, S: int, tol: float, L: int, reserve: str = "full") -> None:
    46	        if any(v not in (0, 1) for v in (P, G, S)):
    47	            raise ValueError("P, G, S must be 0 or 1")
    48	        self.P, self.G, self.S, self.tol, self.L, self.reserve = int(P), int(G), int(S), float(tol), int(L), str(reserve)
    49	        if self.reserve != "full" and not (self.P and self.G and self.S):
    50	            raise ValueError("the half reserve is R4 only")
    51	        self.name = "R4" if self.reserve == "half" else f"F{self.P}{self.G}{self.S}"
    52	        self._b3 = SecondScore(self.tol, self.L)
    53	        self._pacing = ReservePacing(self.reserve, self.L)
    54	        self.T, self.cap = 1, 1
