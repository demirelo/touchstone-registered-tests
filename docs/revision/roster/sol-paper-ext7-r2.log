    rep["q4"]["markets"][m]["p_gain"], rep["q4"]["markets"][m]["p_eff"] = 0.30, 0.26
    sc = S.score(rep, C.extract(out))["Q4-b"]
    assert sc["status"] == "failed" and sc["cells"][0]["value"] == pytest.approx((1.0, 1.0))


