    72	                             else "fulfilled" if c == "equivalent, direction R3 lower" else "failed"}])
    73	    est = _num(q1("D2+H3").get("estimate"))
    74	    out["Q1-a-alt"] = _combine([{"cell": "D2+H3", "value": c, "status": NA if c is None or est is None or c.startswith("not decided")
    75	                                 else "fulfilled" if (c == "ordered, size not established" and est > 0) else "failed"}])
    76	    c = cat("X7-SC")
    77	    out["Q1-b"] = _combine([{"cell": "X7-SC", "value": c, "status": NA if c is None or c.startswith("not decided") or c == "refused"
    78	                             else "fulfilled" if c in ("equivalent", "equivalent, direction R3 lower") else "failed"}])
    79	    neg = lambda v: None if v is None else -v                     # the report's side fields are F111 minus C*; Q1-c is C* minus F111
    80	    out["Q1-c"] = _combine([_cell(f, neg(_get(q1(f), "side", "gross_eff_diff")), lambda v: -0.01 <= v <= 0.01) for f in ("D2+H3", "X7-SC")])
    81	    out["Q1-d"] = _combine([{"cell": f, "value": q1(f).get("better"), "status": NA if cat(f) is None or "efficiency" not in q1(f)
    82	                             else "fulfilled" if q1(f).get("better") is None else "failed"} for f in ("D2+H3", "X7-SC")])
    83	    s = lambda kind, f, k: _est(_get(rep, "q2", kind, f, k))
    84	    out["Q2-a"] = _combine([_cell(k, s("searched", "D2+H3", k), lambda v: v <= -0.05) for k in ("G", "S")])
    85	    out["Q2-b"] = _combine([_cell("P", s("searched", "D2+H3", "P"), lambda v: abs(v) < 0.03)])
    86	    out["Q2-c"] = _combine([_cell("PG", s("searched", "D2+H3", "PG"), lambda v: abs(v) < 0.03),
    87	                            _cell("PS", s("searched", "D2+H3", "PS"), lambda v: abs(v) < 0.03),
    88	                            _cell("GS", s("searched", "D2+H3", "GS"), lambda v: v <= 0)])
    89	    out["Q2-d"] = _combine([_cell(f"{k} {f}", (s("fixed", f, k), s("searched", f, k)), lambda v: abs(v[0]) < abs(v[1]))
    90	                            for f in ("D2+H3", "X7-SC") for k in ("P", "G", "S")])
    91	    diff = lambda m, r, a, b: (None if _gain(cells, m, r, a) is None or _gain(cells, m, r, b) is None
    92	                               else _gain(cells, m, r, a) - _gain(cells, m, r, b))
    93	    out["Q3-a"] = _combine([_cell(f"{m} {r}", diff(m, r, "X7-SC", "D2+H3"), lambda v: v < 0.05) for m in MARKETS for r in ("F111", "C*")])
    94	    out["Q3-b"] = _combine([_cell("headline F111", diff("headline", "F111", "H4", "X7-SC"), lambda v: v <= 0.05)])
    95	    out["Q3-c"] = _combine([_cell(f"{m} {r}", diff(m, r, "X5-AG/v2", "D2+H3"), lambda v: v < 0) for m in MARKETS for r in ("F111", "C*")])
    96	    groups = ["c2_synchronised", "c2_staggered", "c5_synchronised", "c5_staggered", "c2_roles"]
    97	    co = lambda r, g: _get(rep, "q3", "coalition", r, g)
    98	    out["Q3-d"] = _combine([_cell(f"{r} {g}", (_est(_get(co(r, g), "G_min")), _est(_get(co(r, g), "G_tot"))),
    99	                                  lambda v: v[0] - 0.5 * v[1] <= 0) for r in ("F111", "C*") for g in groups])
   100	    ben = lambda r: (_get(cells, f"headline@rho0.2|{r}|X8-DB|total|c2_roles", "member_gain") or [None])[0]
   101	    out["Q3-e"] = _combine([_cell("headline", (ben("F111"), ben("C*")), lambda v: v[0] > v[1])])
   102	    eff = lambda r, o: _get(rep, "q3", "welfare_selected", r, o, "result", "efficiency")
   103	    out["Q3-f"] = _combine([_cell(f"{r} {o}", eff(r, o), lambda v: v >= 0.90) for o in ("W0", "W1") for r in ("F111", "C*")]
   104	                           + [_cell(f"F000<F111 {o}", (eff("F000", o), eff("F111", o)), lambda v: v[0] < v[1]) for o in ("W0", "W1")])
   105	    rp = lambda r: _get(rep, "secondary", "repair_rho1", r, "D2", "estimate")
   106	    out["Q3-g"] = _combine([_cell("headline rho1", (rp("F111"), rp("R4")), lambda v: v[0] - v[1] >= 0.10)])
   107	    k = _get(rep, "q4", "k")
   108	    out["Q4-a"] = _combine([_cell("k", k, lambda v: v >= 5)])
   109	    mk = _get(rep, "q4", "markets") or {}
   110	    elig = [m for m in (_get(rep, "q4", "failing") or []) if isinstance(mk.get(m), dict)]
   111	    out["Q4-b"] = _combine([_cell(m, (_cal(mk[m].get("p_gain")), _cal(mk[m].get("p_eff"))), lambda v: v[0] > v[1]) for m in elig])
   112	    return out
   113	
   114	
   115	# Eligibility (external review round 7). predictions-v2.md: a target that is "incomplete (design 6.5)" is not assessed;
   116	# design 6.5 calls a search-flagged cell "incomplete" and keeps its estimate for the prescribed search procedure, and keeps
   117	# every confirmatory decision that uses it. score() above reads the numbers only; the map below names each cell's
   118	# required searches and rescored the predictions under two stricter readings. Descriptive only.
   119	RULES8 = tuple(f"F{a}{b}{c}" for a in "01" for b in "01" for c in "01")
   120	DECISIONS = frozenset({"Q1-a", "Q1-a-alt", "Q1-b", "Q1-d", "Q4-a", "Q4-b"})   # score a confirmatory decision or its label
   121	SCOPES = ("numerical", "q3", "descriptive")
   122	COALITION_FAMILY = {"c2_roles": "X8-DB"}                                   # the other coalition groups are X6-SE/v2
   123	
   124	
   125	def _sid(m, r, fam, obj="profit", grp=None, rho="0.2"):
   126	    return f"{m}@rho{rho}|{r}|{fam}|{obj}" + (f"|{grp}" if grp else "")
   127	
   128	
   129	def inputs(pid: str, cell: str) -> list:
   130	    """The searches a prediction cell needs (ids as in the report's search_flagged list)."""
   131	    q1 = lambda fam: [_sid(m, r, fam) for m in FRESH for r in ("C*", "F111")]
   132	    q2 = lambda fam: [_sid(m, r, fam) for m in FRESH for r in RULES8]          # searched cells and the fixed-attack bank
   133	    if pid in ("Q1-a", "Q1-a-alt"):
   134	        return q1("D2+H3")
   135	    if pid in ("Q1-b", "Q1-c", "Q1-d"):
   136	        return q1(cell)
   137	    if pid in ("Q2-a", "Q2-b", "Q2-c"):
   138	        return q2("D2+H3")
   139	    if pid == "Q2-d":
   140	        return q2(cell.split()[1])
   141	    if pid in ("Q3-a", "Q3-b", "Q3-c"):
   142	        m, r = cell.split()
   143	        a, b = {"Q3-a": ("X7-SC", "D2+H3"), "Q3-b": ("H4", "X7-SC"), "Q3-c": ("X5-AG/v2", "D2+H3")}[pid]
   144	        return [_sid(m, r, a), _sid(m, r, b)]
   145	    if pid == "Q3-d":
   146	        r, g = cell.split()
   147	        fam = COALITION_FAMILY.get(g, "X6-SE/v2")
   148	        return [_sid("headline", r, fam, "min", g), _sid("headline", r, fam, "total", g)]
   149	    if pid == "Q3-e":
   150	        return [_sid("headline", r, "X8-DB", "total", "c2_roles") for r in ("F111", "C*")]
   151	    if pid == "Q3-f":
   152	        rules, o = (("F000", "F111"), cell.split()[1]) if cell.startswith("F000<") else ((cell.split()[0],), cell.split()[1])
   153	        return [_sid("headline", r, f, o) for r in rules for f in ("D2+H3", "X7-SC")]
   154	    if pid == "Q3-g":
   155	        return [_sid("headline", r, "D2", rho="1") for r in ("F111", "R4")]
   156	    if pid == "Q4-a":
   157	        return [_sid(m, r, "D2+H3") for m in FRESH for r in ("F000", "F111")]
   158	    if pid == "Q4-b":
   159	        return [_sid(cell, r, "D2+H3") for r in ("F000", "F111")]
   160	    raise ValueError(f"no input map for {pid}")
   161	
   162	
   163	def _safe(rid: str) -> str:
   164	    return rid.replace("|", "__").replace("/", "~").replace("*", "star")          # revision_v2._safe
   165	
   166	
   167	def dependencies(records, ids) -> dict:
   168	    """Search id -> every record key its evaluated estimate depends on: the id, then the recorded upstream links (file
   169	    hashes) of its evaluation record, followed transitively (references, banks, warm-start incumbents). An id without an
   170	    evaluation or search record raises: an unmapped input must not pass as unflagged."""
   171	    root = Path(records); index = {}
   172	    for f in root.rglob("*.json"):
   173	        index[hashlib.sha256(f.read_bytes()).hexdigest()] = f
   174	    out = {}
   175	    for rid in ids:
   176	        start = next((f for f in (root / "evaluate" / f"{_safe(rid)}.json", root / "search" / f"{_safe(rid)}.json") if f.exists()), None)
   177	        if start is None:
   178	            raise FileNotFoundError(f"no evaluation or search record for {rid}")
   179	        keys, todo, seen = {rid}, [start], set()
   180	        while todo:
   181	            f = todo.pop()
   182	            if f in seen:
   183	                continue
   184	            seen.add(f)
   185	            up = json.loads(f.read_text()).get("upstream") or {}
   186	            for k, h in up.items():
   187	                keys.add(k)
   188	                if h in index:
   189	                    todo.append(index[h])
   190	        out[rid] = keys
   191	    return out
   192	
   193	
   194	def eligibility(sc: dict, flagged, scope: str, deps: dict | None = None) -> dict:
   195	    """Each cell lists its flagged required searches: its direct inputs and, with deps, everything they depend on. Under
   196	    'q3' a Q3 cell with a flagged required search is not assessed; under 'descriptive' every cell outside DECISIONS is (a
   197	    convention of this sensitivity: design 6.5 keeps the decisions, it does not say how predictions about them are
   198	    scored); 'numerical' keeps the scorer's statuses."""
   199	    if scope not in SCOPES:
   200	        raise ValueError(f"unknown scope {scope}")
   201	    fl, out = set(flagged), {}
   202	    for pid, v in sc.items():
   203	        hit = scope == "descriptive" and pid not in DECISIONS or scope == "q3" and pid.startswith("Q3-")
   204	        cells = []
   205	        for c in v.get("cells", []):
   206	            req = set(inputs(pid, c["cell"]))
   207	            for x in list(req):
   208	                req |= (deps or {}).get(x, set())
   209	            f = sorted(req & fl)
   210	            cells.append({**c, "flagged": f, "status": NA if (hit and f) else c["status"]})
   211	        out[pid] = {**_combine(cells), "cells": cells} if cells else dict(v)
   212	    return out
   213	
   214	
   215	def tally(sc: dict) -> dict:
   216	    st = [v["status"] for v in sc.values()]
   217	    return {s: st.count(s) for s in ("fulfilled", "failed", NA)}
   218	
   219	
   220	def eligibility_map(sc: dict, flagged, deps: dict | None = None) -> dict:
   221	    """Tallies with dependencies (the readings) and with direct inputs only (as in external review round 7); every cell
   222	    with its direct inputs, flagged required searches, and status under each reading."""
   223	    by = {s: eligibility(sc, flagged, s, deps) for s in SCOPES}
   224	    direct = {s: tally(eligibility(sc, flagged, s)) for s in SCOPES}
   225	    cells = lambda pid: {c["cell"]: {"inputs": inputs(pid, c["cell"]), "flagged": c["flagged"],
   226	                                     "status": {s: next(d["status"] for d in by[s][pid]["cells"] if d["cell"] == c["cell"]) for s in SCOPES}}
   227	                         for c in by["numerical"][pid].get("cells", [])}
   228	    return {"flagged": sorted(set(flagged)), "dependencies_traced": deps is not None,
   229	            "tally": {s: tally(by[s]) for s in SCOPES}, "tally_direct_inputs": direct,
   230	            "targets": {pid: {"decision": pid in DECISIONS, "status": {s: by[s][pid]["status"] for s in SCOPES},
   231	                              "flagged": sorted({x for c in by["numerical"][pid].get("cells", []) for x in c["flagged"]}),
   232	                              "cells": cells(pid)}
   233	                        for pid in sorted(sc)}}
   234	
   235	
   236	def main(argv=None) -> int:
   237	    ap = argparse.ArgumentParser(); ap.add_argument("--report", required=True); ap.add_argument("--cells", required=True)
   238	    ap.add_argument("--write", required=True)
   239	    ap.add_argument("--eligibility", help="also write the eligibility map (flagged inputs, three readings) here")
   240	    ap.add_argument("--records", help="evaluation records (eval/all); with --eligibility, trace recorded dependencies")
   241	    a = ap.parse_args(argv); rep = json.loads(Path(a.report).read_text())
   242	    sc = score(rep, json.loads(Path(a.cells).read_text()))
   243	    Path(a.write).write_text(json.dumps(sc, indent=1, sort_keys=True))
   244	    if a.eligibility:
   245	        ids = sorted({x for pid, v in sc.items() for c in v.get("cells", []) for x in inputs(pid, c["cell"])})
   246	        deps = dependencies(a.records, ids) if a.records else None
   247	        em = eligibility_map(sc, rep.get("search_flagged") or [], deps)
   248	        Path(a.eligibility).write_text(json.dumps(em, indent=1, sort_keys=True))
   249	    return 0
   250	
   251	
   252	if __name__ == "__main__":
   253	    sys.exit(main())
"""Tests for cells_v2.py (per-cell means from the verified evaluation records) and score_v2.py (the hashed prediction
scoring table, cell by cell). The world is the code's own synthetic world (tests/test_report_v2.py)."""
import json
import sys
from pathlib import Path

import pytest

ROOT = Path(__file__).resolve().parents[3]
sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(Path(__file__).resolve().parent))
import cells_v2 as C  # noqa: E402
import score_v2 as S  # noqa: E402
from tests import test_report_v2 as W  # noqa: E402


@pytest.fixture
def world(tmp_path, monkeypatch):
    out, cat = W._world(tmp_path)
    return out, W._run(monkeypatch, out, cat)


def test_cells_reads_means_and_hashes(world):
    out, _ = world
    cells = C.extract(out)
    rid = "headline@rho0.2|F111|X7-SC|profit"
    gains = json.loads((out / "evaluate" / (C.safe(rid) + ".json")).read_text())["gain"]
    assert abs(cells[rid]["gain"] - sum(gains) / len(gains)) < 1e-12
    assert len(cells[rid]["sha256"]) == 64
    x8 = cells["headline@rho0.2|F111|X8-DB|total|c2_roles"]
    assert len(x8["member_gain"]) == 2


def test_every_prediction_scored_with_a_valid_status(world):
    out, rep = world
    sc = S.score(rep, C.extract(out))
    ids = {"Q1-a", "Q1-a-alt", "Q1-b", "Q1-c", "Q1-d", "Q2-a", "Q2-b", "Q2-c", "Q2-d", "Q3-a", "Q3-b", "Q3-c", "Q3-d", "Q3-e",
           "Q3-f", "Q3-g", "Q4-a", "Q4-b"}
    assert set(sc) == ids
    assert all(v["status"] in ("fulfilled", "failed", "not assessed") for v in sc.values())


def test_q1a_follows_the_category(world):
    out, rep = world
    rep["q1"]["tests"]["C*-F111|D2+H3"]["category"] = "equivalent, direction R3 lower"
    assert S.score(rep, C.extract(out))["Q1-a"]["status"] == "fulfilled"
    rep["q1"]["tests"]["C*-F111|D2+H3"]["category"] = "C* materially lower"
    assert S.score(rep, C.extract(out))["Q1-a"]["status"] == "failed"


def test_q1b_excludes_the_c_star_lower_direction(world):
    out, rep = world
    rep["q1"]["tests"]["C*-F111|X7-SC"]["category"] = "equivalent, direction C* lower"
    assert S.score(rep, C.extract(out))["Q1-b"]["status"] == "failed"


def test_cell_aggregation_missing_cell_is_not_assessed_but_a_failed_cell_fails(world):
    out, rep = world
    cells = C.extract(out)
    del cells["fresh3@rho0.2|C*|X7-SC|profit"]
    st = S.score(rep, cells)["Q3-a"]
    assert st["status"] in ("not assessed", "failed")
    if st["status"] == "not assessed":
        assert any(c["status"] == "not assessed" for c in st["cells"])
    cells["fresh0@rho0.2|F111|X7-SC|profit"]["gain"] = cells["fresh0@rho0.2|F111|D2+H3|profit"]["gain"] + 0.2
    assert S.score(rep, cells)["Q3-a"]["status"] == "failed"


def test_q3d_uses_the_difference_also_for_nonpositive_totals(world):
    out, rep = world
    for r in ("F111", "C*"):
        for g in rep["q3"]["coalition"][r]:
            rep["q3"]["coalition"][r][g] = {"G_tot": {"estimate": -0.2}, "G_min": {"estimate": -0.05, "bounds": [None, None]}}   # -0.05 > 0.5 x -0.2
    assert S.score(rep, C.extract(out))["Q3-d"]["status"] == "failed"
    for r in ("F111", "C*"):
        for g in rep["q3"]["coalition"][r]:
            rep["q3"]["coalition"][r][g] = {"G_tot": {"estimate": -0.2}, "G_min": {"estimate": -0.15, "bounds": [None, None]}}   # -0.15 <= 0.5 x -0.2
    assert S.score(rep, C.extract(out))["Q3-d"]["status"] == "fulfilled"


def test_q4b_strict_tie_fails_and_no_eligible_market_is_not_assessed(world):
    out, rep = world
    rep["q4"]["failing"] = []
    assert S.score(rep, C.extract(out))["Q4-b"]["status"] == "not assessed"
    m = "fresh1"
    rep["q4"]["failing"] = [m]; rep["q4"]["markets"][m]["p_gain"] = rep["q4"]["markets"][m]["p_eff"] = 0.5
    assert S.score(rep, C.extract(out))["Q4-b"]["status"] == "failed"


def test_q4a_needs_a_decision(world):
    out, rep = world
    rep["q4"]["k"] = None
    assert S.score(rep, C.extract(out))["Q4-a"]["status"] == "not assessed"
    rep["q4"]["k"] = 5
    assert S.score(rep, C.extract(out))["Q4-a"]["status"] == "fulfilled"


def test_q1c_reports_c_star_minus_f111_as_registered(world):
    out, rep = world
    rep["q1"]["tests"]["C*-F111|D2+H3"]["side"]["gross_eff_diff"] = 0.004          # the report's side fields are F111 minus C*
    cell = [c for c in S.score(rep, C.extract(out))["Q1-c"]["cells"] if c["cell"] == "D2+H3"][0]
    assert cell["value"] == -0.004


def test_q4b_compares_calibrated_p_values_as_registered(world):
    """Raw 0.30 > 0.26, but calibrated with kappa 0.25 both cap at 1: a tie, which fails (predictions-v2.md, Q4-b)."""
    out, rep = world
    m = "fresh1"; rep["q4"]["failing"] = [m]
    rep["q4"]["markets"][m]["p_gain"], rep["q4"]["markets"][m]["p_eff"] = 0.30, 0.26
    sc = S.score(rep, C.extract(out))["Q4-b"]
    assert sc["status"] == "failed" and sc["cells"][0]["value"] == pytest.approx((1.0, 1.0))


# External review round 7: the rubric (predictions-v2.md) makes a target "incomplete (design 6.5)" not assessed, and design
# 6.5 calls a search-flagged cell "incomplete". The numerical scorer ignored the flags; the eligibility map makes each
# prediction cell's required searches explicit and rescored the predictions under two stricter readings.
FLAG_Q3B = "headline@rho0.2|F111|X7-SC|profit"


def test_inputs_name_the_required_searches_of_each_prediction_cell():
    assert S.inputs("Q3-a", "fresh1 C*") == ["fresh1@rho0.2|C*|X7-SC|profit", "fresh1@rho0.2|C*|D2+H3|profit"]
    assert S.inputs("Q3-b", "headline F111") == ["headline@rho0.2|F111|H4|profit", FLAG_Q3B]
    assert S.inputs("Q3-d", "C* c2_roles") == ["headline@rho0.2|C*|X8-DB|min|c2_roles", "headline@rho0.2|C*|X8-DB|total|c2_roles"]
    assert S.inputs("Q3-d", "F111 c2_staggered")[0] == "headline@rho0.2|F111|X6-SE/v2|min|c2_staggered"
    assert S.inputs("Q3-e", "headline") == ["headline@rho0.2|F111|X8-DB|total|c2_roles", "headline@rho0.2|C*|X8-DB|total|c2_roles"]
    q2 = S.inputs("Q2-a", "G")
    assert len(q2) == 48 and "fresh4@rho0.2|F111|D2+H3|profit" in q2 and all("|D2+H3|" in x for x in q2)
    assert all("|X7-SC|" in x for x in S.inputs("Q2-d", "P X7-SC"))
    assert "fresh0@rho0.2|C*|D2+H3|profit" in S.inputs("Q1-c", "D2+H3")
    assert S.inputs("Q3-g", "headline rho1") == ["headline@rho1|F111|D2|profit", "headline@rho1|R4|D2|profit"]


def _sc():
    f = lambda c, s: {"cell": c, "status": s, "value": 0.0}
    return {"Q1-a": {"status": "fulfilled", "cells": [f("D2+H3", "fulfilled")]},
            "Q1-c": {"status": "fulfilled", "cells": [f("D2+H3", "fulfilled"), f("X7-SC", "fulfilled")]},
            "Q2-a": {"status": "failed", "cells": [f("G", "fulfilled"), f("S", "failed")]},
            "Q3-b": {"status": "fulfilled", "cells": [f("headline F111", "fulfilled")]},
            "Q3-c": {"status": "failed", "cells": [f("fresh1 C*", "failed"), f("fresh2 F111", "failed")]},
            "Q3-e": {"status": "fulfilled", "cells": [f("headline", "fulfilled")]}}


def test_a_flagged_required_search_makes_the_q3_cell_not_assessed():
    flagged = [FLAG_Q3B, "fresh1@rho0.2|C*|D2+H3|profit", "headline@rho0.2|C*|X8-DB|min|c2_roles", "fresh4@rho0.2|F111|D2+H3|profit"]
    e = S.eligibility(_sc(), flagged, "q3")
    assert e["Q3-b"]["status"] == "not assessed" and e["Q3-b"]["cells"][0]["flagged"] == [FLAG_Q3B]
    assert e["Q3-c"]["status"] == "failed"                  # fresh2 F111 fails without a flagged input
    assert e["Q3-e"]["status"] == "fulfilled"              # the C* flag is on the minimum objective, Q3-e uses the total
    assert e["Q2-a"]["status"] == "failed" and e["Q1-c"]["status"] == "fulfilled"      # outside the Q3 scope


def test_the_descriptive_reading_also_covers_q1c_and_q2_but_never_a_decision():
    flagged = ["fresh1@rho0.2|C*|D2+H3|profit", "fresh4@rho0.2|F111|D2+H3|profit"]
    e = S.eligibility(_sc(), flagged, "descriptive")
    assert e["Q2-a"]["status"] == "not assessed" and e["Q1-c"]["status"] == "not assessed"
    assert e["Q1-a"]["status"] == "fulfilled"              # a confirmatory decision is kept (design 6.5)
    num = S.eligibility(_sc(), flagged, "numerical")                   # flags are listed, statuses unchanged
    assert {k: v["status"] for k, v in num.items()} == {k: v["status"] for k, v in _sc().items()}
    assert num["Q2-a"]["cells"][0]["flagged"] == ["fresh4@rho0.2|F111|D2+H3|profit"]
    with pytest.raises(ValueError):
        S.eligibility(_sc(), flagged, "other")


def test_eligibility_map_tallies_each_reading():
    m = S.eligibility_map(_sc(), [FLAG_Q3B, "fresh4@rho0.2|F111|D2+H3|profit"])
    assert m["tally"]["numerical"] == {"fulfilled": 4, "failed": 2, "not assessed": 0}
    assert m["tally"]["q3"] == {"fulfilled": 3, "failed": 2, "not assessed": 1}
    assert m["tally"]["descriptive"] == {"fulfilled": 2, "failed": 1, "not assessed": 3}
    assert m["targets"]["Q3-b"]["status"] == {"numerical": "fulfilled", "q3": "not assessed", "descriptive": "not assessed"}
    assert m["targets"]["Q1-a"]["decision"] is True and m["targets"]["Q3-b"]["flagged"] == [FLAG_Q3B]


