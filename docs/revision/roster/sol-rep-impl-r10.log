   185	    threshold, "not passed at the cap" when k equals the cap and no round passes; the held-out winner is the last round's."""
   186	    from convergence_v2 import _passes
   187	    rounds = rec.get("rounds")
   188	    if not isinstance(rounds, list) or not 1 <= len(rounds) <= max_rounds:
   189	        return "rounds missing or beyond the cap"
   190	    for i, r in enumerate(rounds):
   191	        if not isinstance(r, dict) or type(r.get("round")) is not int or r["round"] != i + 1 or not _finite([r.get(k) for k in ("attack_f", "attack_change", "reference_f", "reference_change")]) \
   192	                or not _knobs_ok(r.get("best_knobs")):
   193	            return f"round {i + 1} malformed or nonfinite"
   194	    ok = [_passes(r) for r in rounds]
   195	    if rec["status"] == "passed" and not (ok[-1] and not any(ok[:-1])):
   196	        return "status passed without a final passing round"
   197	    if rec["status"] == STATUSES[1] and (len(rounds) != max_rounds or any(ok)):
   198	        return "status at the cap without the capped, unpassed rounds"
   199	    if not _same((rec.get("heldout") or {}).get("knobs"), rounds[-1]["best_knobs"]):
   200	        return "held-out winner differs from the last round's winner"
   201	    return None
   202	
   203	
   204	def _round1_ready(rec, doubling, search) -> bool:
   205	    """Round 1 was measured and both records it is compared with are well-formed: then any disagreement below is a
   206	    round-1 mismatch, not a malformed record."""
   207	    rec, doubling, search = _d(rec), _d(doubling), _d(search)
   208	    if rec is None or doubling is None or search is None or not isinstance(rec.get("round1_gate"), dict):
   209	        return False
   210	    rounds, h, g = rec.get("rounds"), doubling.get("heldout"), rec["round1_gate"]
   211	    if not (isinstance(rounds, list) and rounds and isinstance(rounds[0], dict) and isinstance(h, dict) and
   212	            _finite(h.get("gain")) and _knobs_ok(h.get("knobs")) and isinstance(search.get("attack"), dict) and
   213	            _knobs_ok(search["attack"].get("best_knobs"))):
   214	        return False
   215	    r1, fh = rounds[0], rec.get("heldout")                  # the measured values and both doubling changes must be
   216	    if not (_finite([doubling.get("attack_change"), doubling.get("reference_change")]) and   # well-formed (review r7)
   217	            type(r1.get("round")) is int and r1["round"] == 1 and           # review rep-impl-r9: every round-1 field
   218	            _finite([r1.get(k) for k in ("attack_f", "attack_change", "reference_f", "reference_change")]) and   # _rounds_problem checks
   219	            _finite([g.get("heldout_mean")]) and
   220	            _knobs_ok(r1.get("best_knobs")) and _knobs_ok(g.get("heldout_knobs"))):
   221	        return False
   222	    return not (isinstance(fh, dict) and _same(fh.get("knobs"), h["knobs"])) or _finite(fh.get("gain"))
   223	
   224	
   225	def _round1_problem(rec: dict, doubling, search=None) -> str | None:
   226	    """Round 1 against this cell's own doubling record and frozen search (reviews rep-impl-r4, r5): with zero
   227	    differences, the comparison's round-1 winner equals the doubling's held-out knobs, its held-out mean equals the mean
   228	    of the doubling's held-out gains (the same np.mean of the same values), and round 1's two changes equal the
   229	    doubling's; round 1's best knobs are the doubling's winner or the frozen search winner (the better of the two); and a
   230	    final winner equal to the doubling's winner has the doubling's held-out gains exactly. All five hold on every Run B
   231	    record with an identical round 1 (76 records; 48 with that final winner)."""
   232	    import numpy as np
   233	    if not _round1_ready(rec, doubling, search):
   234	        return "no valid doubling or search record to check round 1 against"
   235	    g, r1, h = rec["round1_gate"], rec["rounds"][0], doubling["heldout"]
   236	    if not _same(g.get("heldout_knobs"), h["knobs"]):
   237	        return "round-1 winner differs from the doubling record's held-out winner"
   238	    if not _same(g.get("heldout_mean"), float(np.mean(h["gain"]))):
   239	        return "round-1 held-out mean differs from the doubling record's"
   240	    if not (_same(r1.get("attack_change"), doubling.get("attack_change")) and _same(r1.get("reference_change"), doubling.get("reference_change"))):
   241	        return "round-1 changes differ from the doubling record's"
   242	    if not any(_same(r1.get("best_knobs"), k) for k in (h["knobs"], search["attack"]["best_knobs"])):
   243	        return "round-1 best knobs are neither the doubling winner nor the frozen winner"
   244	    fh = rec.get("heldout")
   245	    if isinstance(fh, dict) and _same(fh.get("knobs"), h["knobs"]) and not _same(fh.get("gain"), h["gain"]):
   246	        return "the doubling winner's held-out gains differ from the doubling record's"
   247	    return None
   248	
