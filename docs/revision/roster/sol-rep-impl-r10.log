             "mkt": {"seeds_eval": [11, 12], "cfg": {"N": 4}}} for i in range(n)]
    d = _dbl_dir(jobs)
    return [{"id": f"c{i}", "job": j, "dir": d} for i, j in enumerate(jobs)]
