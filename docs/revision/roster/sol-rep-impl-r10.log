   343	def _lost(cdir: Path, ids: list, hours: dict, max_rounds: int) -> None:
   344	    from convergence_v2 import restart_hours
   345	    write_record(cdir / "lost_cells.json", {"lost": ids, "restart_hours": restart_hours([hours[k] * max_rounds for k in ids])})
