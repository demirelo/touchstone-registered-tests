   484	def _n_bins() -> int:
   485	    from churn_v2 import AGE_EDGES
   486	    return len(AGE_EDGES) - 1
   487	
   488	
   489	def _shares_ok(sh, n_episodes: int) -> bool:
   490	    """Newcomer audit counts (churn_v2.newcomer_shares): one episode per evaluation seed, each with the prescribed number
   491	    of age bins of [served, audited], finite and nonnegative, audited at most served (review rep-impl-r3)."""
   492	    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
   493	    if not isinstance(per, list) or len(per) != n_episodes:
   494	        return False
   495	    nb = _n_bins()
   496	    for e in per:
   497	        f = e.get("focal") if isinstance(e, dict) else None
   498	        if not isinstance(f, list) or len(f) != nb:
   499	            return False
   500	        for b in f:
   501	            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
   502	                return False
   503	    return True
   504	
   505	
   506	def diag_ok(row, seeds, knobs) -> bool:
   507	    """A diagnostics row (frozen: diagnostics.json cells[...]["base"]; continued: its own record) for this winner: its
   508	    knobs, the job's ordered evaluation seeds, finite per-seed profits and well-formed audit counts (review rep-impl-r2)."""
   509	    return isinstance(row, dict) and _same(row.get("knobs"), knobs) and isinstance(row.get("seeds"), list) and \
   510	        _same(row["seeds"], list(seeds)) and _finite(row.get("normalized")) and len(row["normalized"]) == len(seeds) and \
   511	        _shares_ok(row.get("shares"), len(seeds))
