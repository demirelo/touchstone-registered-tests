   442	@_checked
   443	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   444	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   445	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   446	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   447	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   448	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   449	    import revision_v2 as R
   450	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   451	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   452	    if ev is None:
   453	        return "no evaluation record"
   454	    if ev.get("stage") != "evaluate" or not _same(ev.get("id"), job["id"]) or not _same(ev.get("provenance"), job["provenance"]):
   455	        return "evaluation record of another stage, cell or run"
   456	    if not _valid_held(ev, seeds):
   457	        return "evaluation values nonfinite or on other seeds"
   458	    if (n := _n_of(job)) is None or safe_terms(ev, n) is None:
   459	        return "evaluation normalizer not positive after division by N, or a term not finite"
   460	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
   461	        return "evaluation: " + x
   462	    if db is None:
   463	        return "no doubling record"
   464	    if db.get("stage") != "doubling" or not _same(db.get("id"), job["id"]) or not _same(db.get("provenance"), job["provenance"]) or db.get("kind") != "profit":
   465	        return "doubling record of another stage, cell, run or kind"
   466	    ch = [db.get("attack_change"), db.get("reference_change")]
   467	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   468	        return "doubling changes nonfinite or flag missing"
   469	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   470	        return "doubling flag differs from its changes"
   471	    h = db.get("heldout")
   472	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   473	        return "doubling held-out result missing, nonfinite or on other seeds"
   474	    if safe_terms(h, n) is None:
   475	        return "doubling normalizer not positive after division by N, or a term not finite"
   476	    ref = read_record(R.path_of(d, rid))
   477	    if ref is None or not isinstance(ref.get("upstream"), dict):
   478	        return "no reference record"
   479	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   480	        return "doubling: " + x
   481	    return None
   482	
