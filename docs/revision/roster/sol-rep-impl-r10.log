   428	
   429	def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
   430	    import revision_v2 as R
   431	    from sim.records_v2 import sha_file
   432	    up = rec.get("upstream")
   433	    if not isinstance(up, dict) or set(up) != set(want):
   434	        return "dependency set differs"
   435	    for u, h in up.items():
   436	        q = R.path_of(d, u)
   437	        if not q.is_file() or sha_file(q) != h:
   438	            return f"dependency hash differs: {u}"
   439	    return None
