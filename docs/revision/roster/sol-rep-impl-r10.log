   516	
   517	def diagnostics_binding(d: Path, kind: str, p: float, jobs: list) -> dict:
   518	    """Written by rep_v2's rate stage right after the diagnostics step and before the inventory (review rep-impl-r3): the
   519	    sha256 of diagnostics.json, the rate, and per cell the job id, its provenance (this run's commit, draw and salt) and
   520	    the hashes of the search and doubling records whose winners the diagnostics reran."""
   521	    import revision_v2 as R
   522	    from sim.records_v2 import sha_file
   523	    d = Path(d); h = lambda q: sha_file(q) if q.is_file() else None
   524	    return {"stage": "diagnostics binding", "kind": kind, "rate": float(p), "diagnostics": h(d / "diagnostics.json"),
   525	            "cells": {f"{j['context']}|{j['rule']}": {"id": j["id"], "provenance": j["provenance"], "search": h(R.path_of(d, j["id"])),
   526	                                                       "doubling": h(d / "doubling" / (R._safe(j["id"]) + ".json"))} for j in jobs}}
   527	
   528	
   529	def diag_bound(d: Path, kind: str, p: float, ck: str, job: dict) -> bool:
   530	    """The frozen diagnostics of cell `ck` belong to this job, rate and run: the binding names this rate, the current
   531	    diagnostics.json, this job's id and provenance, and the current search and doubling records."""
