   263	@_checked
   264	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3, doubling=None, search=None) -> str | None:
   265	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   266	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   267	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   268	    job's ordered evaluation seeds; a measured round 1 must agree with this cell's doubling record (`doubling`;
   269	    _round1_problem). The job must carry its evaluation seeds: no check is skipped."""
   270	    seeds = (job.get("mkt") or {}).get("seeds_eval")
   271	    if not seeds:
   272	        return "the job has no evaluation seeds to check against"
   273	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or not _same(rec.get("id"), key):
   274	        return "not a continuation record of this cell"
   275	    if not _same(rec.get("provenance"), job.get("provenance")):
   276	        return "continuation record of another job or run"
   277	    st = rec.get("status")
   278	    if st not in STATUSES:
   279	        return f"unknown continuation status {st!r}"
   280	    if st == STATUSES[3] and not _mismatch(rec, doubling, search):      # reviews rep-impl-r7, r8: the status needs
   281	        return "a round-1 mismatch status without measured evidence"    # measured evidence (a failing comparison or values)
   282	    if st in STATUSES[:2]:
   283	        g = rec.get("round1_gate")
   284	        if not (identical(rec) or (smoke and g == SMOKE_GATE)):
   285	            return "a continued winner without its own identical round-1 comparison"
   286	        if isinstance(g, dict) and not (_knobs_ok(g.get("heldout_knobs")) and _finite([g.get("heldout_mean")])):
   287	            return "round-1 comparison without a finite round-1 winner"
   288	        h = rec.get("heldout")
   289	        if not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   290	            return "held-out result missing, nonfinite, on other seeds or with a zero normalizer"
   291	        if (n := _n_of(job)) is None or safe_terms(h, n) is None:          # review rep-impl-r6: the same normalizer and
   292	            return "held-out normalizer not positive after division by N, or a term not finite"   # term checks as scoring
   293	        if x := _rounds_problem(rec, max_rounds):
   294	            return x
   295	        if isinstance(g, dict) and (x := _round1_problem(rec, doubling, search)):
   296	            return x
   297	    return None
   298	
   299	
   300	def _set_aside(cdir: Path, dest: Path) -> None:
   301	    """Move a record that will be rerun out of the way (no deletion), so that a lost worker shows as a missing record and
   302	    is never masked by the old one (review rep-impl-r2)."""
   303	    if dest.exists():
   304	        sup = cdir / "superseded"; sup.mkdir(parents=True, exist_ok=True)
   305	        n = len(list(sup.glob(dest.stem + ".*.json")))
   306	        dest.rename(sup / f"{dest.stem}.{n}.json")
   307	
   308	
   309	def _prov_wellformed(prov, like) -> bool:
   310	    """A provenance shaped like this job's own: the same fields, each of the same JSON type and not empty (review
   311	    rep-impl-r7: {} or an id of None or [] is a malformed record, not another run's binding)."""
   312	    if not isinstance(prov, dict) or not isinstance(like, dict) or set(prov) != set(like):
   313	        return False
   314	    kind = lambda v: "bool" if isinstance(v, bool) else "num" if isinstance(v, (int, float)) else type(v).__name__
   315	    return all(prov[k] is not None and kind(prov[k]) == kind(like[k]) and (not isinstance(prov[k], (str, list, dict)) or prov[k])
   316	               for k in like)
   317	
   318	
   319	def _foreign(prov, like) -> bool:
   320	    """Plan section 5 ("reuse only this run's records"): a well-formed provenance that names another job or run refuses
   321	    the resume; a missing or malformed one is an invalid record, rerun."""
   322	    return _prov_wellformed(prov, like) and not _same(prov, like)
   323	
   324	
   325	def _mismatch(rec, doubling=None, search=None) -> bool:
   326	    """A measured round 1 that differs from the doubling record at all: the recorded status, a comparison that is not
   327	    identical, or (with the cell's doubling and search records) any recorded round-1 value that disagrees with them
   328	    (_round1_problem; review rep-impl-r5). A cell refused before round 1 ("not run") or a smoke run ("not compared")
   329	    measured nothing."""
   330	    rec = _d(rec)
   331	    if rec is None:
   332	        return False
   333	    if not _gate_wellformed(rec.get("round1_gate")):      # no comparison, or a malformed one: an invalid record, whatever
   334	        return False                                      # the status says (review rep-impl-r7: a status proves nothing)
   335	    if not identical(rec):                                # a failing comparison, whatever the status
   336	        return True                                       # (review rep-impl-r8: no status shortcut either way)
   337	    return _round1_ready(rec, doubling, search) and _round1_problem(rec, doubling, search) is not None
   338	
