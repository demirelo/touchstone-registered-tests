     1	"""Pod safety primitives for the follow-up launchers (internal reviews r8-r16 of reset_pod.sh). Every function fails
     2	closed: a failed listing counts as "pods may still exist", and success needs a successful listing that shows no pod.
     3	Elapsed budgets use the monotonic clock; deadlines (HARD_TS) are wall-clock epoch seconds.
     4	
     5	Spend (r16): the record is the account balance difference, NAME.bal0 (written before the first creation request) minus
     6	the balance at least an hour after the watchdog ended. Other usage on the account during that time is included, so the
     7	record can overstate the spend, never understate it. The launcher prints only estimates.
     8	
     9	CLI (exit 0 = success):
    10	  podctl.py reconcile NAME [KEEP_ID]          delete every pod named NAME except KEEP_ID; verified by a fresh listing
    11	  podctl.py delete ID SECONDS                 delete one pod and verify it is gone within SECONDS
    12	  podctl.py price ID                          print ID's price (finite, positive); exit 1 when unknown
    13	  podctl.py balance                           print "BALANCE SPEND_PER_HR"; exit 1 when unknown
    14	  podctl.py spend NAME                        print the recorded spend (USD, rounded up to a cent); refused until the
    15	                                              watchdog ended at least WAIT_AFTER_WATCHDOG s ago and no pod is named NAME
    16	  podctl.py watchdog NAME HARD_TS DONE_FILE   after DONE_FILE, or from HARD_TS (also writes NAME.blocked): delete every
    17	                                              pod named NAME; exits only with DONE_FILE and the settle time of empty
    18	                                              listings; then writes NAME.wdend and releases NAME.launchlock
    19	  podctl.py unlock NAME                       release NAME.launchlock (only an empty directory)
    20	  podctl.py may-create NAME HARD_TS           exit 0 only before HARD_TS and while NAME.blocked does not exist
    21	  podctl.py remaining UNTIL_TS                print the seconds left (0 when past)
    22	"""
    23	from __future__ import annotations
    24	
    25	import datetime
    26	import json
    27	import math
    28	import os
    29	import subprocess
    30	import sys
    31	import time
    32	from decimal import ROUND_CEILING, Decimal, InvalidOperation
    33	
    34	HERE = os.path.dirname(os.path.abspath(__file__))
    35	PY = sys.executable
    36	
    37	SETTLE = 300               # seconds of consecutive empty listings, counted only after DONE, before the watchdog ends
    38	AMBIGUOUS_SETTLE = 1800    # the same while NAME.request is "pending" (an outstanding or ambiguous creation request)
    39	WAIT_AFTER_WATCHDOG = 3600  # assumed bound on the delay before the account balance shows the last charge
    40	
    41	
    42	def _run(args, timeout=60):
    43	    try:
    44	        r = subprocess.run([PY, os.path.join(HERE, "runpod.py")] + args, capture_output=True, text=True, timeout=timeout)
    45	        return r.returncode, r.stdout
    46	    except subprocess.TimeoutExpired:
    47	        return 124, ""
    48	
    49	
    50	def list_pods(run=_run, timeout=60):
    51	    """The pods as a list, or None when the listing failed (never an empty list on failure). No command runs without a
    52	    positive budget, and the budget is passed unchanged (r12, r13)."""
    53	    if float(timeout) <= 0:
    54	        return None
    55	    rc, out = run(["list"], timeout=float(timeout))
    56	    if rc != 0:
    57	        return None
    58	    try:
    59	        pods = json.loads(out)
    60	    except ValueError:
    61	        return None
    62	    return pods if isinstance(pods, list) else None
    63	
    64	
    65	def named(pods, name):
    66	    return [p["id"] for p in pods if p.get("name") == name]
    67	
    68	
    69	def delete_verified(pid, seconds, run=_run, clock=time.monotonic, sleep=time.sleep):
    70	    """Delete PID until a successful listing no longer shows it, within SECONDS of elapsed time."""
    71	    end = clock() + seconds
    72	    while clock() < end:
    73	        run(["delete", pid], timeout=min(60.0, end - clock()))
    74	        if clock() >= end:
    75	            break
    76	        pods = list_pods(run, min(60, end - clock()))
    77	        if clock() < end + 1e-9 and pods is not None and pid not in [p["id"] for p in pods]:
    78	            return clock() <= end
    79	        sleep(min(15, max(0.0, end - clock())))
    80	    return False
    81	
    82	
    83	def reconcile(name, keep="", seconds=600, run=_run, clock=time.monotonic, sleep=time.sleep):
    84	    """Delete every pod named NAME except KEEP; True only when a successful listing shows none left."""
    85	    end = clock() + seconds
    86	    while clock() < end:
    87	        pods = list_pods(run, min(60, end - clock()))
    88	        if pods is not None and clock() <= end:
    89	            extra = [i for i in named(pods, name) if i != keep]
    90	            if not extra:
    91	                return True
    92	            for i in extra:
    93	                if clock() >= end:
    94	                    break
    95	                delete_verified(i, end - clock(), run, clock, sleep)
    96	        sleep(min(15, max(0.0, end - clock())))
    97	    return False
    98	
    99	
   100	def may_create(name, hard_ts, clock=time.time, here=HERE):
   101	    return clock() < hard_ts and not os.path.exists(os.path.join(here, f"{name}.blocked"))
   102	
