   149	def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, attempts, ledger=None, tag: str | None = None, clock=time.time,
   150	                   stop_file=None, soft_deadline=None) -> CostStop:
   151	    """A paid run must state the pod allocation time, a positive rate (the price ceiling), the launcher's attempts file,
   152	    and the ledger with the run's tag: closed attempts of this launch and recorded spend of earlier launches count toward
   153	    the cap (no default of zero)."""
   154	    if started is None:
   155	        _refuse("a paid run needs --started-at (the pod allocation time)")
   156	    if not usd_per_hour > 0 or not cap_usd > 0:
   157	        _refuse("a paid run needs a positive rate and cap")
   158	    if attempts is None:
   159	        _refuse("a paid run needs --attempts (the launcher's attempts file)")
   160	    if not tag:
   161	        _refuse("a paid run needs --run-tag and --ledger (spend of earlier launches)")
   162	    prior = attempts_spend(attempts, usd_per_hour)["closed_usd"] + ledger_spend(ledger, tag)
   163	    return CostStop(cap_usd, usd_per_hour, started, clock, prior, stop_file, soft_deadline)
