   287	def recompute(src, conv, markets=FRESH, resamples: int = C.RESAMPLES, expected: dict | None = None) -> dict:
   288	    """Q1 (C* - R3; D2+H3 and X7-SC) and Q4 (B3 - R3, D2+H3) per market and pooled, with this run's validated final
   289	    winners (`expected`: cell id -> binding) substituted and the frozen winners elsewhere; descriptive."""
   290	    expected = expected or {}
   291	    for rid in expected:
   292	        if not (Path(conv) / "convergence" / (R._safe(rid) + ".json")).exists():
   293	            raise ValueError(f"{rid}: the run's result is missing")
   294	    sub, out = [], {}
   295	    for q, (a, b, fam) in {"q1": ("C*", "F111", "D2+H3"), "q1_x7": ("C*", "F111", "X7-SC"), "q4": ("F000", "F111", "D2+H3")}.items():
   296	        fz_a, fz_b, cv_a, cv_b = {}, {}, {}, {}
   297	        for m in markets:
   298	            ra, rb = (f"{m}@rho0.2|{r}|{fam}|profit" for r in (a, b))
   299	            if read(R.eval_path(src, ra)) is None or read(R.eval_path(src, rb)) is None:
   300	                continue
   301	            (fa, ca, sa), (fb, cb, sb) = _cell_gains(src, conv, ra, expected), _cell_gains(src, conv, rb, expected)
   302	            fz_a[m], fz_b[m], cv_a[m], cv_b[m] = fa, fb, ca, cb
   303	            sub += [r for r, s_ in ((ra, sa), (rb, sb)) if s_ and r not in sub]
   304	        if fz_a:
   305	            out[q] = {"frozen": C.pooled_paired(fz_a, fz_b, resamples), "converged": C.pooled_paired(cv_a, cv_b, resamples)}
   306	    return {"label": "exploratory sensitivity; the frozen estimates stay primary; " + C.SCOPE, **out, "substituted": sub}
