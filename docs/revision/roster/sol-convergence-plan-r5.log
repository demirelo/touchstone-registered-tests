    59	def finite(*xs) -> bool:
    60	    def vals(x):
    61	        if isinstance(x, dict):
    62	            for v in x.values():
    63	                yield from vals(v)
    64	        elif isinstance(x, (list, tuple)):
    65	            for v in x:
    66	                yield from vals(v)
    67	        elif isinstance(x, (int, float)) and not isinstance(x, bool):
    68	            yield x
    69	    return all(math.isfinite(v) for x in xs for v in vals(x))
