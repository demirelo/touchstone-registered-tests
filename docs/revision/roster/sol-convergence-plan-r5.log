   274	def _cell_gains(src, conv, rid: str, expected: dict):
   275	    f = read(R.eval_path(src, rid))
   276	    if rid not in expected:
   277	        return f["gain"], f["gain"], False
   278	    c = read(Path(conv) / "convergence" / (R._safe(rid) + ".json"))
   279	    if c is None or c.get("id") != rid or c.get("binding") != expected[rid] or "heldout" not in c:
   280	        raise ValueError(f"{rid}: no validated result of this run (binding)")
   281	    g = c["heldout"]["gain"]
   282	    if c["heldout"]["seeds"] != f["seeds"] or len(g) != len(f["gain"]) or not G.finite(g):
   283	        raise ValueError(f"{rid}: held-out seeds, length or values invalid")
   284	    return f["gain"], g, True
