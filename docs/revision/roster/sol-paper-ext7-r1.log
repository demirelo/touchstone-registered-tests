    24	    """d = g_C* - g_F111 (positive: R3 lower gain). Categories in order: materially lower, equivalent, ordered but size not
    25	    established, inconclusive (design 9.3)."""
    26	    if kappa is None:
    27	        return NO_DECISION
    28	    mean = stratified_mean(strata_diffs)                       # refuses nonfinite or short strata
    29	    tail = ALPHA / (2 * m) * kappa
    30	    lo, hi = stratified_at(strata_diffs, "lower", tail), stratified_at(strata_diffs, "upper", tail)
    31	    if lo > MARGIN:
    32	        return "R3 materially lower"
    33	    if hi < -MARGIN:
    34	        return "C* materially lower"
    35	    if lo >= -MARGIN and hi <= MARGIN:
    36	        return ("equivalent, direction R3 lower" if mean > 0 else "equivalent, direction C* lower") if holm_reject else "equivalent"
    37	    return "ordered, size not established" if holm_reject else "inconclusive"
