   103	def q4_markets(pa: list, pb: list, kappa: float | None) -> dict:
   104	    if kappa is None:
   105	        return {"decided": False, "p": None, "pass": None, "k": None}
   106	    p = [max(calibrated(a, kappa), calibrated(b, kappa)) for a, b in zip(pa, pb)]
   107	    rej = holm(p, ALPHA)
   108	    return {"decided": True, "p": p, "pass": rej, "k": int(sum(rej))}
   109	
   110	
   111	def w1_class(lower: float, upper: float) -> str:
   112	    """Design 6.2 (draft 7): W1 profitability on evaluation seeds from the constraint mean's interval."""
   113	    if float(lower) >= 0.0:
   114	        return "supported"
   115	    if float(upper) < 0.0:
   116	        return "contradicted"
   117	    return "unresolved"
