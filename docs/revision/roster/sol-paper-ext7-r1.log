   358	def build(out, protocol: dict, instances: dict, h4: dict, catalog: list[dict], cuts: int | None = None) -> dict:
   359	    h4 = h4 or {}; cuts = int(protocol.get("cuts", 0) if cuts is None else cuts)
   360	    rep = verify_records(out, catalog, instances, protocol, h4, cuts, not h4.get("loaded"))
   361	    if not rep.get("ok"):
   362	        raise SystemExit(f"verify found stale, foreign, or erroneous records; the report is refused: {json.dumps(rep)[:600]}")
   363	    missing, no_doubling = set(), set()
   364	    for c in rep.get("contexts", {}).values():
   365	        missing |= set(c.get("missing", [])); no_doubling |= set(c.get("missing_doubling", []))
   366	    R = Records(out, catalog, missing, _flagged(out, catalog), no_doubling); conf = bool((instances or {}).get("confirmatory")); kappa = protocol.get("kappa") or {}
   367	    r = {"confirmatory": conf, "q1": q1(R, kappa.get("Q1"), conf), "q2": q2(R), "q3": q3(R, bool(h4.get("loaded"))), "q4": q4(R, kappa.get("Q4"), conf)}
   368	    r["secondary"] = secondary(R); r["doubling"] = doubling(R); r["doubling_missing"] = sorted(no_doubling)
   369	    for j in catalog:
   370	        if read(RV.eval_path(R.out, j["id"])) is None:
   371	            R.missing.add(j["id"])
   372	    r["missing"] = sorted(R.missing); r["search_flagged"] = sorted(R.flagged); r["multiplicity"] = MULTIPLICITY
   373	    r["unanswered"] = [q.upper() for q in ("q1", "q2", "q3") if _unanswered(r[q])] + (["Q4"] if r["q4"] == "unanswered" else [])
   374	    return json.loads(json.dumps(r, default=float))
