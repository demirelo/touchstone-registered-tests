    65	def q1_efficiency(eff_strata, tail: float = 0.025) -> str:
    66	    """The pooled paired gross-efficiency difference (the favoured rule minus the other): nominal one-sided 97.5 percent
    67	    bounds against -0.01 (descriptive, not calibrated)."""
    68	    lo, hi = stratified_at(eff_strata, "lower", tail), stratified_at(eff_strata, "upper", tail)
    69	    if lo >= -EFF_MARGIN:
    70	        return "efficiency condition met"
    71	    if hi < -EFF_MARGIN:
    72	        return "efficiency loss"
    73	    return "efficiency non-inferiority unresolved"
