    17	def safe(rid: str) -> str:
    18	    return rid.replace("|", "__").replace("/", "~").replace("*", "star")      # revision_v2._safe
    19	
    20	
    21	def extract(out) -> dict:
    22	    import numpy as np
    23	    from scripts.report_v2 import _est, _interval
    24	    cells = {}
    25	    for f in sorted((Path(out) / "evaluate").glob("*.json")):
    26	        rec = json.loads(f.read_text()); rid = rec.get("id")
    27	        if not rid:
    28	            continue
    29	        e = {"sha256": hashlib.sha256(f.read_bytes()).hexdigest()}
    30	        if "gain" in rec:
    31	            g = np.asarray(rec["gain"], dtype=float); e.update(gain=_est(g), gain_interval=_interval(g))
    32	        if "eff_attack" in rec:
    33	            e["eff_attack"] = _est(np.asarray(rec["eff_attack"], dtype=float))
    34	        if "member_gain" in rec:
    35	            e["member_gain"] = [float(np.mean(m)) for m in rec["member_gain"]]
    36	        cells[rid] = e
    37	    return cells
    38	
    39	
    40	def main(argv=None) -> int:
    41	    ap = argparse.ArgumentParser(); ap.add_argument("--out", required=True); ap.add_argument("--write", required=True)
    42	    a = ap.parse_args(argv)
    43	    Path(a.write).write_text(json.dumps(extract(a.out), indent=1, sort_keys=True))
    44	    return 0
    45	
