    40	def q1_family(tests: dict, kappa: float | None, slots: int = Q1_SLOTS) -> dict:
    41	    """Holm over the fixed slots; a test whose strata are None (a missing cell) or refused enters with p = 1, undecided."""
    42	    names = list(tests)
    43	    if kappa is None:
    44	        return {n: {"p": None, "reject": None, "category": NO_DECISION} for n in names}
    45	    p, why = [], {}
    46	    for n in names:
    47	        if tests[n] is None:
    48	            p.append(1.0); why[n] = MISSING; continue
    49	        try:
    50	            p.append(calibrated(stratified_two_sided(tests[n], 0.0), kappa))
    51	        except NumericalRefusal:
    52	            p.append(1.0); why[n] = REFUSED
    53	    p += [1.0] * max(0, int(slots) - len(p))
    54	    rej = holm(p, ALPHA); out = {}
    55	    for i, n in enumerate(names):
    56	        if n in why:
    57	            out[n] = {"p": None, "reject": None, "category": why[n]}; continue
    58	        try:
    59	            out[n] = {"p": p[i], "reject": rej[i], "category": q1_category(tests[n], kappa, rej[i], m=int(slots))}
    60	        except NumericalRefusal:
    61	            out[n] = {"p": None, "reject": None, "category": REFUSED}
    62	    return out
