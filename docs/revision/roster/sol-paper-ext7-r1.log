   377	def _flagged(out, catalog: list[dict]) -> set:
   378	    """Cells whose scheduled doubling check exceeded the threshold (design 6.5 'search-flagged')."""
   379	    by = {RV._safe(j["id"]): j["id"] for j in catalog}; d = Path(out) / "doubling"; got = set()
   380	    for p in sorted(d.glob("*.json")) if d.exists() else []:
   381	        rec = read(p)
   382	        if rec is not None and rec.get("incomplete") is True and p.stem in by:
   383	            got.add(by[p.stem])
   384	    return got
