COALITION_STEPS = ("joint_twin", "joint_reference_pre", "joint_reference", "coalition_select")
SCHEDULE_ORDER = ("synchronised", "staggered")


def _group(job: dict, catalog: list[dict]) -> list[dict]:
    return [j for j in catalog if j["context"] == job["context"] and j["objective"] in ("total", "min") and _coalition_tag(j) == _coalition_tag(job)]


def _x6_schedules(group: list[dict]) -> list[str]:
    present = {j["schedule"] for j in group if j["family"] == "X6-SE/v2"}
    return [s for s in SCHEDULE_ORDER if s in present]


def _members(job: dict) -> tuple:
    return tuple(int(e) for e in x6v2_members(job["mkt"]["cfg"], job["mkt"]["focal"], int(job["c"])))


def _desc(job: dict, knobs: dict) -> dict:
    return profile_descriptor("knobs", job["family"], job["schedule"], knobs)


def _desc_key(d: dict) -> tuple:
    return (d["kind"], d["family"], d["schedule"], None if d["knobs"] is None else exact_key(d["knobs"]))


def _project_desc(job: dict, knobs: dict) -> dict:
    """The truthful projection of a coalition profile (spec 5.2): every member's claim clipped to its effort; for X8-DB
    only the beneficiary's clip changes, every decoy knob is kept."""
    return _desc(job, family_for(job["family"], *constants(job)).project(dict(knobs)))


def _representable(job: dict, desc: dict) -> bool:
    return desc["kind"] == "knobs" and desc["family"] == job["family"] and (job["family"] == "X8-DB" or desc["schedule"] == job["schedule"])


def _rows_of(job: dict, desc: dict, seeds, cache) -> np.ndarray:
    T, L = constants(job); members = _members(job)
    return _member_rows(job["mkt"]["cfg"], rule_factory(job), members, seeds, cache, profile_factories(desc, members, T, L))


def _coalition_objective(job: dict, kind: str, ref, cache) -> CoalitionObjective:
    T, L = constants(job); m = job["mkt"]
    return CoalitionObjective(m["cfg"], rule_factory(job), _members(job), family_for(job["family"], T, L), m["seeds_train"], cache, kind,
                              joint_ref=ref, staggered=job["schedule"] == "staggered", T=T, L=L, family_name=job["family"])

def stage_evaluate(job: dict, out: Path) -> dict:
    T, L = constants(job); cache = SeedCache(); m = job["mkt"]; cell = eval_cell(job)
    if job["objective"] == "diagnostic":                 # design 6.7: a fixed profile, no search, no reference
        return {"seeds": list(cell.seeds), **honest_replacement(m["cfg"], rule_factory(job), m["focal"], cell.seeds, cache)}
    rec = read(path_of(out, job["id"]))
    if job["objective"] == "profit":
        fam = family_for(job["family"], T, L, job.get("h4")); cand, _, _ = reference_of(job, out)
        return {"seeds": list(cell.seeds), **gain_fields(cell, fam, rec["attack"]["best_knobs"], cand, cache)}
    if job["objective"] in ("W0", "W1"):
        if rec["selected"] is None:
            return {"seeds": list(cell.seeds), "no_feasible_candidate": True}
        fam = family_for(job["family"], T, L); fr = run_focal(cell, lambda: fam.make(dict(rec["selected"])), cache)
        out_ = {"seeds": list(cell.seeds), "eff": gross_efficiency(fr.results).tolist(), "normalized": fr.normalized.tolist()}
        if job["objective"] == "W1":
            cand, _, _ = reference_of(job, out); ref = run_focal(cell, cand.policy_factory, cache)
            out_["constraint"] = (fr.normalized - ref.normalized).tolist()
        return out_
    jrec = read(path_of(out, f"joint_reference/{job['context']}/{_coalition_tag(job)}"))
    if job["objective"] == "min":
        win = read(path_of(out, f"coalition_select/{job['context']}/{_coalition_tag(job)}"))["winners"][job["id"]]["descriptor"]
    else:
        win = _desc(job, rec["selected"])
    rows = _rows_of(job, win, cell.seeds, cache); ref_rows = _rows_of(job, jrec["descriptor"], cell.seeds, cache)
    g = rows - ref_rows
    return {"seeds": list(cell.seeds), "member_gain": g.tolist(), "total": float(g.mean(axis=1).sum()), "min": float(g.mean(axis=1).min()),
            "winner": win, "reference": jrec["descriptor"]}


def _cross_rules(ctx: str, family: str, catalog: list[dict], bank: dict) -> tuple[dict, list]:
    by_rule = {j["rule"]: j for j in catalog if j["context"] == ctx and j["family"] == family and j["objective"] == "profit" and j["rule"] in MAN.FACTORIAL}
    return by_rule, [r for r in MAN.FACTORIAL if r in by_rule and r in bank["attacks"]]


def cross_expected(ctx: str, family: str, catalog: list[dict], out: Path) -> tuple[dict, set]:
    """The provenance and dependency ids of a cross record, derived independently of any stored record."""
    bank = read(path_of(out, f"bank/{ctx}/{family}"))
    if bank is None:
        raise SystemExit(f"cross {ctx}/{family}: no fixed-attack bank")
    if read(path_of(out, f"bank_train/{ctx}/{family}")) is None:
        raise SystemExit(f"cross {ctx}/{family}: no training-seed bank matrix (frozen before the evaluation)")
    _, rules = _cross_rules(ctx, family, catalog, bank)
    ids = {f"freeze/{ctx}", f"bank/{ctx}/{family}", f"bank_train/{ctx}/{family}"} | {f"reference/{ctx}/{r}" for r in rules}
    ids |= {f"envelope_select/{ctx}/{r}/{family}" for r in rules if path_of(out, f"envelope_select/{ctx}/{r}/{family}").exists()}
    return aux_provenance(_first(catalog, context=ctx)["mkt"], family=family), ids


def stage_cross(ctx: str, family: str, catalog: list[dict], out: Path) -> dict:
    bank = read(path_of(out, f"bank/{ctx}/{family}")); by_rule, rules = _cross_rules(ctx, family, catalog, bank); cache = SeedCache(); mat, rows, prof = [], {}, {}
    prov, ids = cross_expected(ctx, family, catalog, out)
    up = {u: sha_file(path_of(out, u)) for u in sorted(ids)}
    for a in rules:
        row = []
        for r in rules:
            j = by_rule[r]; T, L = constants(j); fam = family_for(family, T, L); cell = eval_cell(j)
            cand, _, _ = reference_of(j, out)
            att = run_focal(cell, lambda: fam.make(dict(bank["attacks"][a])), cache); ref = run_focal(cell, cand.policy_factory, cache)
            scale = np.array([x.sstar for x in att.results]) / cell.cfg.N; gain = (att.profit - ref.profit) / scale
            rows[f"{a}>{r}"] = gain.tolist(); row.append(float(gain.mean()))
            prof[f"{a}>{r}"] = {"profit_attack": (att.profit / scale).tolist(), "profit_ref": (ref.profit / scale).tolist(),     # design 6.6 terms
                                "eff_attack": gross_efficiency(att.results).tolist(), "net_eff_attack": [float(x) for x in _net_eff(att.results)]}
        mat.append(row)
    env = {r: (read(path_of(out, f"envelope_select/{ctx}/{r}/{family}")) or {}).get("choice") for r in rules}
    return {"stage": "cross", "provenance": prov, "upstream": up, "context": ctx, "family": family, "attacks": rules, "rules": rules,
            "matrix": mat, "per_seed": rows, "profit_rows": prof, "envelope": env}


    tag = rest.rsplit("_", 1)[0] if kind == "joint_twin" else rest
