   271	
   272	def check_started(started, now: float | None = None) -> None:
   273	    """Production runs need the pod's allocation time (epoch seconds, in the past)."""
   274	    import math
   275	    import time
   276	    now = time.time() if now is None else now
   277	    if started is None or not isinstance(started, (int, float)) or not math.isfinite(started) or not (1.6e9 < float(started) <= now):
   278	        raise SystemExit(f"churn arm refused: --started must be the pod's allocation time in epoch seconds, got {started!r}")
   279	
   280	
   281	def check_cap(started: float | None, need_s: float, cap: float = STOP_USD, usd_per_hour: float = POD_USD_PER_HOUR, now: float | None = None,
   282	              prior_usd: float = 0.0) -> None:
   283	    """An estimate-based stage-admission limit. No running stage is ever killed (author, 2026-11-10): before each stage,
   284	    the pod time billed since `started`, plus the charges of earlier failed attempts (`prior_usd`), plus the stage's
   285	    estimate, is compared with the cap, and the driver stops between stages if it would be passed. A stage that overruns
   286	    its estimate can therefore end above the cap; pod deletion on completion or failure is the launcher's job."""
   287	    import time
   288	    if started is None:
   289	        return
   290	    spent = float(prior_usd) + ((now if now is not None else time.time()) - float(started)) / 3600 * usd_per_hour
   291	    need = float(need_s) / 3600 * usd_per_hour
   292	    if spent + need > cap:
   293	        raise SystemExit(f"churn arm stopped between stages: {spent:.2f} USD billed + {need:.2f} USD for the next stage would pass the {cap:.2f} USD cap")
   294	
