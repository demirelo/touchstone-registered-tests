   303	def require_gate(base, require_identical: bool = False) -> dict:
   304	    """Every production churn stage needs a saved p = 0 gate of this driver version that passed its criterion; on the pod
   305	    (`require_identical`) that criterion is bit identity (the author's decision, card touchstone-reset-repro-pass)."""
   306	    g = read(Path(base) / "gate-p0" / "gate.json"); inv = read(Path(base) / "gate-p0" / "inventory.json")
   307	    want = R.cell_id(f"{GATE_CELL[0]}@rho0.2", GATE_CELL[1], "D2+H3", "profit")
   308	    if not g or not g.get("pass") or not g.get("gate_ok", g.get("pass")) or g.get("registered") != want or g.get("churn") != f"{want}|churn0":
   309	        raise SystemExit("churn arm refused: no saved passing p = 0 gate for this cell")
   310	    if require_identical and not (g.get("require_identical") and g.get("gate_ok") and g.get("identical")):
   311	        raise SystemExit("churn arm refused: the saved gate is not a bit-identical pod gate")
   312	    if not inv or inv.get("environment", {}).get("churn_driver_sha256") != sha_file(Path(__file__)):
   313	        raise SystemExit("churn arm refused: the saved gate was run by another driver version")
   314	    return g
