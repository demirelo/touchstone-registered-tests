   207	def _diag_one(job: dict, out: str) -> tuple:
   208	    import numpy as np
   209	    from sim.cell import SeedCache, run_focal
   210	    install(); j = job
   211	    T, L = R.constants(j); fam = R.family_for("D2+H3", T, L); cell = R.eval_cell(j)
   212	    pols = {"base": read(R.path_of(out, j["id"]))["attack"]["best_knobs"],
   213	            "doubled": read(Path(out) / "doubling" / (R._safe(j["id"]) + ".json"))["heldout"]["knobs"]}
   214	    row = {}
   215	    for k, knobs in pols.items():
   216	        fr = run_focal(cell, lambda knobs=knobs: fam.make(dict(knobs)), SeedCache())
   217	        row[k] = {"knobs": knobs, "seeds": [int(x) for x in cell.seeds], "normalized": [float(x) for x in fr.normalized],
   218	                  "mean_normalized": float(np.mean(fr.normalized)), "shares": newcomer_shares(fr.results, cell.focal)}
   219	    return f"{j['context']}|{j['rule']}", row
