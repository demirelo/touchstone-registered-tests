   371	PREFLIGHT_VERSION = 2   # review r5: draft-4 records (no run status) are never reused
   372	
   373	
   374	def _saved_preflight(stage: str, jobs: list[dict], out, limit: int, margin: float) -> dict | None:
   375	    """A saved measurement of this stage that still applies: same memory limit and margin, a positive peak taken only from
   376	    real runs, and measured jobs that belong to this job list. Anything else is no evidence."""
   377	    p = Path(out) / f"memory_preflight_{stage}.json"
   378	    if not p.exists():
   379	        return None
   380	    try:
   381	        rec = json.loads(p.read_text())
   382	    except ValueError:
   383	        return None
   384	    ids = {j["id"] for j in jobs}; rule_of = {j["id"]: j.get("rule") for j in jobs}
   385	    meas = rec.get("measured") or []
   386	    covered = (stage != "evaluate") or ({rule_of.get(i) for i in meas} == {j.get("rule") for j in jobs})   # review r5
   387	    ok = (rec.get("version") == PREFLIGHT_VERSION and covered
   388	          and rec.get("statuses") == {i: "done" for i in meas}                         # explicit real-run evidence (r5)
   389	          and rec.get("stage") == stage and rec.get("limit_bytes") == limit and rec.get("margin") == margin
   390	          and isinstance(rec.get("task_peak_bytes"), int) and rec["task_peak_bytes"] > 0 and rec.get("measured")
   391	          and set(rec["measured"]) <= ids and set(rec.get("peaks") or {}) == set(rec["measured"])
   392	          and rec["task_peak_bytes"] == max(rec["peaks"].values()))
   393	    return rec if ok else None
   394	
   395	
   396	def memory_preflight(stage: str, jobs: list[dict], out, requested: int, runner=None, limit: int | None = None, parent: int | None = None,
   397	                     margin: float = 1.25) -> dict:
   398	    """Pod-side, before a four-profile stage (plan section 7): run the sample tasks for real in child processes, take the
   399	    largest peak, add a margin of 25 percent for variation across markets, rules and winners, and choose the workers that
   400	    fit the memory limit beside the parent. The measured tasks' records are kept and not run again.
   401	    Review r4: a task whose record already existed ("skipped") is no measurement; the next unfinished task of the same
   402	    group is measured instead. A retry reuses a validated saved measurement; without either, dispatch is refused."""
   403	    import resource
   404	    import time
   405	    t0 = time.time(); runner = runner or _measure_child
   406	    parent = parent if parent is not None else resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == "darwin" else 1024)
   407	    limit = limit if limit is not None else memory_limit()
   408	    saved = _saved_preflight(stage, jobs, out, limit, margin)
   409	    if saved is not None:
   410	        w = plan_workers(limit, int(margin * saved["task_peak_bytes"]), parent, requested)
   411	        rec = {**saved, "parent_bytes": parent, "requested": requested, "workers": w, "reused": True, "seconds": time.time() - t0}
   412	        write(Path(out) / f"memory_preflight_{stage}.json", rec)
   413	        return rec
   414	    peaks, skipped = {}, []
   415	    for group in _preflight_groups(stage, jobs):
   416	        for j in group:
   417	            r = runner(stage, j, out, jobs)
   418	            if r.get("status") == "done":
   419	                peaks[j["id"]] = int(r["peak_rss_bytes"]); break
   420	            skipped.append(j["id"])
   421	        else:
   422	            raise SystemExit(f"churn arm refused: no memory evidence for {stage} (every task of a group was already done "
   423	                             f"and no saved measurement applies)")
   424	    peak = max(peaks.values())
   425	    w = plan_workers(limit, int(margin * peak), parent, requested)
   426	    rec = {"version": PREFLIGHT_VERSION, "statuses": {i: "done" for i in peaks},
   427	           "stage": stage, "limit_bytes": limit, "task_peak_bytes": peak, "peaks": peaks, "margin": margin, "parent_bytes": parent,
   428	           "requested": requested, "workers": w, "measured": list(peaks), "skipped": skipped, "reused": False, "seconds": time.time() - t0}
   429	    write(Path(out) / f"memory_preflight_{stage}.json", rec)
   430	    return rec
   431	
