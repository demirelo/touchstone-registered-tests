   243	def _mapped_view(out, view, cid: str, rid: str) -> None:
   244	    """Copies of a churn cell's search, evaluation, and doubling records under the registered id, so the reset driver's
   245	    comparators read both sides by one id; only the id fields and the cell's own upstream key are renamed."""
   246	    sr = read(R.path_of(out, cid)); ev = read(R.eval_path(out, cid)); db = read(Path(out) / "doubling" / (R._safe(cid) + ".json"))
   247	    if sr is not None:
