   349	def _measure_child(stage: str, job: dict, out, catalog: list[dict]) -> dict:
   350	    """Run one stage task of `job` in a child process (its record is written as in production). Returns the child's peak
   351	    RSS in bytes and the task status: "done" for a real run, "skipped" when a valid record already existed (review r4)."""
   352	    import pickle
   353	    import subprocess
   354	    jp = Path(out) / f"memory_preflight_{stage}.pkl"; jp.write_bytes(pickle.dumps((stage, job, catalog)))
   355	    r = subprocess.run([sys.executable, str(HERE / "churn_memory.py"), "--task", str(jp), str(out)], capture_output=True, text=True)
   356	    if r.returncode != 0:
   357	        raise SystemExit(f"churn arm refused: memory preflight failed: {r.stderr[-300:]}")
   358	    return json.loads(r.stdout.strip().splitlines()[-1])
