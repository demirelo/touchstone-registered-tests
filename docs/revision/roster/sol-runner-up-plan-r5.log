   284	def _score(base, doubled) -> dict:
   285	    vals = [None if isinstance(x, str) else x["cstar_minus_runner_up"]["estimate"] > 0 for x in (base, doubled)]   # a tie is not met
   286	    score = "not available" if None in vals else ("met" if all(vals) else ("failed" if not any(vals) else "not established"))
   287	    return {"statement": EXPECTATION, "base": vals[0], "doubled": vals[1], "score": score}
