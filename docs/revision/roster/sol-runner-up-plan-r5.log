   195	def _verified_dir(d, stage: str, cell: str, inputs: dict, budget, site: str, src=None) -> dict:
   196	    """A reset-driver evidence directory: the gate record names this stage and cell and passed; the inventory lists every
   197	    required record and every listed hash equals its file; the reset driver is the current one; the inputs equal those
   198	    recomputed from the original records; the search record has the full budget; and, with `src`, the comparison is
   199	    recomputed against the registered records and passes."""
   200	    d = Path(d); g, inv, inp = read(d / "gate.json"), read(d / "inventory.json"), read(d / "inputs.json")
   201	    srch = read(F.R.path_of(d, cell)); drv = sha_file(HERE.parent / "followup" / "reset_followup_v2.py")
   202	    recs = (inv or {}).get("records") or {}; env = (inv or {}).get("environment") or {}
   203	    problems = []
   204	    if g is None or g.get("stage") != stage or g.get("cell") != cell or g.get("pass") is not True:
   205	        problems.append("gate record missing, unrelated, or failed")
   206	    if missing := [r for r in _required_records(d, stage, cell) if r not in recs or not (d / r).exists()]:
   207	        problems.append(f"required records missing or unlisted: {missing}")
   208	    if bad := [r for r, h in recs.items() if not (d / r).exists() or sha_file(d / r) != h]:
   209	        problems.append(f"inventory hashes differ from the files: {bad[:3]}")
   210	    if env.get("driver_sha256") != drv:
   211	        problems.append("made by another reset driver")
   212	    if inp != inputs:
   213	        problems.append("inputs differ from the current original records")
   214	    if srch is None or list((srch.get("provenance") or {}).get("budget") or []) != list(budget):
   215	        problems.append("not the registered full budget")
   216	    rep = None
   217	    if not problems and src is not None:
   218	        rep = F.compare(src, d) if stage == "reproduction gate" else F.compare_doubling(src, d, cell)
   219	        if not rep.get("pass"):
   220	            problems.append(f"the recomputed comparison fails: {rep.get('problems')}")
   221	    if problems:
   222	        _refuse(f"{site} evidence in {d}: {problems}")
   223	    return {"gate": g, "environment": env, "recomputed": rep}
