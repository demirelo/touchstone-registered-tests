4. One pod: the reproduction gate first (bit identity, `--require-identical`; stop and report on any difference), then `--stage all` with
   `--diag-cells fresh0@rho0.2|F111|D2|profit` (inputs, search, freeze, evaluate, doubling, spot diagnostics, inventory);
   records retrieved, the pod deleted and the deletion verified, the spend recorded.
5. On the Mac after retrieval: the diagnostics of all 18 D2 winners and their reverse switches (`--stage diagnostics`),
   checked against the pod's spot-check cell. The three headline cells (registered D2 records) run on the Mac before the
   pod (`--headline-diagnostics`, 200 seeds); with the 18 fresh cells this gives the 63 policies and 42 switch
   comparisons of section 4 plus the 21 reverse switches.
6. Analysis: a new `reset` block in `posthoc_v2.py` (tested first), a table, and a paragraph in section 9 with sites; the
   section-1 headline numbers enter at the same time, labelled exploratory.
7. Internal review of the paper change, then the next external package.
"""Cost estimates of Run A (draft 3) and Run B (draft 3) from experiments/v2/benchmark/timings.json.
Usage (repository root): python3 docs/revision/followup2/cost_estimate.py"""
import json

t = json.load(open("experiments/v2/benchmark/timings.json"))["timings"]; u = 0.108; pod = 0.56; prep = 0.3
ev = lambda k: t["eval160"][k] * 200 / 160
h = lambda s: s / 3600
# Run A
a_core = 6 * (t["d2h3_cell"] + ev("profit") + t["doubling"] + t["x7_cell"] + ev("x7") + t["doubling_x7"] + t["reference"])
gate_a = t["d2h3_cell"] + ev("profit")                                   # the reset driver's reproduction gate on the pod
crit_a = t["d2h3_cell"] + t["x7_cell"] + 6 * t["reference"] + ev("x7") + t["doubling_x7"]   # six serial reference calls
billed_a = (h(gate_a) + h(crit_a) + prep) * pod
est_a = max(h(a_core) * u + h(gate_a) * u, billed_a)
print(f"A: {h(a_core):.2f} core-h ({h(a_core) * u:.2f} USD at 0.108); gate {h(gate_a):.2f} h; billed path {h(gate_a) + h(crit_a) + prep:.2f} h = {billed_a:.2f} USD; "
      f"estimate {est_a:.2f}, x1.25 {est_a * 1.25:.2f}; stop cap and reservation 3.00")
# Run B (draft 3): 10 D2+H3 and 9 X7-SC cells (14 flagged + 5 nesting X7-SC cells), up to 3 rounds, each round with
# its held-out evaluation allowance; the gate cells (headline X7-SC, fresh D2+H3) run serially first
rd = lambda x7: (t["doubling_x7"] if x7 else t["doubling"]) + ev("profit")
b_core = 3 * (10 * rd(False) + 9 * rd(True))
gate_b = rd(True) + rd(False)
crit_b = 3 * rd(True)                                                     # 16 workers: the 9 X7-SC cells start first
billed_b = (h(gate_b) + h(crit_b) + prep) * pod
est_b = max(h(b_core + gate_b) * u, billed_b)
print(f"B: {h(b_core):.2f} core-h ({h(b_core) * u:.2f} USD at 0.108); gate {h(gate_b):.2f} h serial; billed path {h(gate_b) + h(crit_b) + prep:.2f} h = {billed_b:.2f} USD; "
      f"estimate {est_b:.2f}, x1.25 {est_b * 1.25:.2f}; stop cap and reservation 4.25")
#!/bin/bash
# Snapshot guard: run a private copy, so an edit to this file cannot reach a running launch.
if [ -z "${LAUNCH_SNAPSHOT:-}" ]; then
  snapf="/Users/oemer.demirel/Projects/touchstone/results/pods/snap_$(basename "$0" .sh)_$$.sh"; cp "$0" "$snapf"
  LAUNCH_SNAPSHOT="$snapf" exec bash "$snapf" "$@"
fi
# Reset follow-up (docs/revision/reset-experiment-plan.md, draft 5) on one Runpod CPU pod, adapted from eval_pod.sh.
# Order on the pod: the reproduction gate (bit identity, --require-identical; the author's decision), then the 18 D2 cells
# stage by stage (inputs and search with all vCPUs; evaluate, doubling and the spot diagnostics with WEVAL workers for
# memory), then the inventory. Spending (the author: do not kill jobs): at the reserved cap the pod stops BETWEEN stages
# (a STOP file the remote script reads before each stage); only at HARD x the cap is the pod deleted mid-stage, as an
# absolute guard. An EXIT/INT/TERM trap pulls what exists, deletes the pod and verifies the deletion.
# Usage: reset_pod.sh <code_tgz> <bundle_tgz> <tag> <cap_usd> <local_out>
# Env: EXPECT (commit inside the code tarball), MAXCPH, optional WEVAL (default 10), MINMEM (default 28), HARD (default 1.3).
set -u
PY=/opt/homebrew/bin/python3; P=/Users/oemer.demirel/Projects/touchstone/results/pods
TGZ=${1:?code tarball}; BTGZ=${2:?bundle tarball}; TAG=${3:?tag}; CAP=${4:?cap_usd}; LOUT=${5:?local_out}; cd $P
EXPECT=${EXPECT:?commit}; MAXCPH=${MAXCPH:?max usd per hour}; WEVAL=${WEVAL:-10}; MINMEM=${MINMEM:-28}; HARD=${HARD:-1.3}
mkdir -p "$LOUT" logs_r_$TAG
$PY -c "import sys,tarfile; ms=tarfile.open(sys.argv[1]).getmembers(); d=[m.name for m in ms if m.name.split('/')[-1].startswith('._')]; o=[m.name for m in ms if m.uid!=0]; print('tarball guard: %d AppleDouble, %d non-root' % (len(d),len(o))); sys.exit(1 if d or o else 0)" "$TGZ" || { echo "code tarball refused"; exit 1; }
hg=$(mktemp -d); tar xzf "$TGZ" -C "$hg" 2>/dev/null || { echo "code tarball refused: cannot unpack"; exit 1; }
# Code guard (fails closed: every git call's status is checked): HEAD is EXPECT, protocol-v2 is an ancestor, the tree is
# clean, every path changed since the tag is in the code freeze's allowed paths, and scripts/, sim/, tests/ equal the tag.
guard() {
  cd "$1" || return 1
  [ "$(git rev-parse HEAD 2>/dev/null)" = "$EXPECT" ] || { echo "HEAD is not $EXPECT"; return 1; }
  git merge-base --is-ancestor protocol-v2 HEAD || { echo "protocol-v2 is not an ancestor"; return 1; }
  st=$(git status --porcelain) || { echo "git status failed"; return 1; }; [ -z "$st" ] || { echo "tree not clean: $st" | head -c 300; return 1; }
  ch=$(git diff --name-only protocol-v2 HEAD) || { echo "git diff failed"; return 1; }
  bad=$(echo "$ch" | grep -v -e '^docs/' -e '^experiments/v2/' -e '^paper/' -e '^sealed2/h4/' -e '^$' || true); [ -z "$bad" ] || { echo "changed outside the allowed paths: $bad" | head -c 300; return 1; }
  git diff --quiet protocol-v2 -- scripts/ sim/ tests/ || { echo "scripts/, sim/ or tests/ differ from protocol-v2"; return 1; }
  echo "code guard: ok at $(git rev-parse --short HEAD)"
}
( guard "$hg" ); g=$?; mv -- "$hg" ~/.Trash/hg_reset_$$
[ $g -eq 0 ] || { echo "code tarball refused"; exit 1; }
[ -n "${DRYRUN:-}" ] && { echo "dry run: guards passed; no pod created"; exit 0; }
# verify DIR: every record in DIR/inventory.json exists with its hash.
verify() { $PY - "$1" <<'PYV'
import hashlib, json, sys
from pathlib import Path
d = Path(sys.argv[1]); inv = json.loads((d / "inventory.json").read_text())
bad = [k for k, h in inv["records"].items() if not (d / k).is_file() or hashlib.sha256((d / k).read_bytes()).hexdigest() != h]
print(f"verify {d.name}: {len(inv['records'])} records, {len(bad)} bad"); sys.exit(1 if bad else 0)
PYV
}
tmo() { perl -e 'alarm shift; exec @ARGV' "$@"; }
NAME=ts-r-$TAG; DONE=$P/$NAME.done; ATT=$P/$NAME.attempts
rm_ok() { [ -e "$1" ] && mv -- "$1" ~/.Trash/"$(basename "$1").$$"; true; }
rm_ok "$DONE"; rm_ok "$P/$NAME.blocked"; : > "$ATT"
id=""; state="NOT STARTED"; rc=1; cph=0; a0=0; tfirst=0
# Pod safety lives in podctl.py (test_podctl.py, with mutation checks): fail-closed listing, deletion verified within
# elapsed time, reconciliation, a creation block from the hard deadline, and a watchdog that runs on after this launcher
# exits, until no pod named $NAME remains.
cleanup() {
  trap - EXIT INT TERM
  if [ -n "$id" ]; then
    try=0
    while :; do   # after RUN OK: keep the pod and retry until both directories verify, or until 2 min before the hard deadline
      try=$((try+1)); ok=1
      for spec in "followup-reset/ $LOUT/followup-reset/ 900" "followup-gate/ $LOUT/followup-gate/ 300"; do
        set -- $spec; rem=$(( hard - 120 - $(date +%s) )); [ $rem -le 0 ] && { ok=0; break; }; t=$3; [ $rem -lt $t ] && t=$rem
        tmo $t $PY runpod.py pull $id /root/touchstone/results/v2/$1 "$2" >/dev/null 2>&1 || ok=0
      done
      rem=$(( hard - 120 - $(date +%s) )); [ $rem -gt 0 ] && tmo $(( rem < 300 ? rem : 300 )) $PY runpod.py pull $id /root/touchstone/results/logs/ logs_r_$TAG/ >/dev/null 2>&1
      if [ "$state" = "RUN OK" ] && [ $ok = 1 ]; then { verify "$LOUT/followup-gate" && verify "$LOUT/followup-reset"; } || ok=0; fi
      [ $ok = 1 ] && break
      echo "$(date +%H:%M) pull or verification failed (try $try)"
      if [ "$state" = "RUN OK" ]; then [ "$(date +%s)" -ge $(( hard - 120 )) ] && break; else [ $try -ge 3 ] && break; fi
      sleep 60
    done
    [ $ok = 1 ] || { [ "$state" = "RUN OK" ] && state="RUN OK BUT RECORDS NOT VERIFIED"; rc=1; }
    if $PY podctl.py delete $id 1800; then echo "$(date +%H:%M) $id deleted (verified)"; echo "$id $(date +%s) deleted" >> "$ATT"; else echo "$(date +%H:%M) $id: deletion not verified in 30 min; the watchdog keeps trying (billing may continue)"; rc=1; fi
  fi
  $PY podctl.py reconcile $NAME || { echo "$(date +%H:%M) reconcile failed; the watchdog keeps trying"; rc=1; }
  touch "$DONE"     # the watchdog then deletes any orphan pod and exits only after SETTLE s of empty listings
  # Spend: one pod at a time is guaranteed by reconciliation before every request, so the time from the first creation
  # request to the last verified deletion (or to now, if one is unverified) at MAXCPH bounds the spend of all attempts.
  if [ "$tfirst" -gt 0 ]; then echo "$(date +%H:%M) spend bound: $(( $(date +%s) - tfirst ))s at $MAXCPH USD/h = $($PY -c "print(round(($(date +%s)-$tfirst)/3600*float('$MAXCPH'),3))") USD (pod events in $ATT; record the bound with budget_v2.py --record)"; fi
  echo "$(date +%H:%M) end: $state"
  exit $rc
}
trap cleanup EXIT INT TERM
# Deadlines from the first creation request at the price ceiling MAXCPH (a bound across attempts).
t0=$(date +%s); soft=$(( t0 + $($PY -c "print(int(3600*float('$CAP')/float('$MAXCPH')))") )); hard=$(( t0 + $($PY -c "print(int(3600*float('$CAP')*float('$HARD')/float('$MAXCPH')))") ))
nohup $PY podctl.py watchdog $NAME $hard "$DONE" >> logs_r_$TAG/watchdog.log 2>&1 &
disown
# One creation request at a time (create_one.py, no hidden retries). Before EVERY request: reconciliation must succeed (no
# untracked pod), the watchdog must allow creation, and the soft deadline must be ahead. An ambiguous answer is followed by
# a 30 s wait and reconciliation before the next request; an unambiguous refusal (no capacity) tries the next flavor.
req=0; tries=0
while [ $tries -lt 3 ] && [ $req -lt 36 ]; do
  $PY podctl.py reconcile $NAME 600 || { state="RECONCILE FAILED BEFORE REQUEST $((req+1))"; exit 1; }
  $PY podctl.py may-create $NAME $hard || { state="CREATION BLOCKED (hard deadline)"; exit 1; }
  [ "$(date +%s)" -lt "$soft" ] || { state="SOFT DEADLINE BEFORE START"; exit 1; }
  [ "$tfirst" -gt 0 ] || tfirst=$(date +%s)
  out=$(tmo 120 $PY create_one.py $NAME $(( req % 12 )) 2>/dev/null | tail -n 1); req=$((req+1))
  id=$(echo "$out" | $PY -c 'import sys,json; print(json.loads(sys.stdin.read()).get("id",""))' 2>/dev/null)
  amb=$(echo "$out" | $PY -c 'import sys,json; d=json.loads(sys.stdin.read() or "{}"); print(1 if d.get("ambiguous", True) else 0)' 2>/dev/null || echo 1)
  if [ -z "$id" ]; then
    if [ "$amb" = 1 ]; then echo "$(date +%H:%M) ambiguous creation answer; reconciling"; sleep 30; $PY podctl.py reconcile $NAME 600 || { state="RECONCILE FAILED AFTER AN AMBIGUOUS ANSWER"; exit 1; }; tries=$((tries+1)); fi
    continue
  fi
  v=16; echo "$id $(date +%s) start" >> "$ATT"
  cph=$(tmo 60 $PY runpod.py list 2>/dev/null | $PY -c "import sys,json; print(next((p.get('costPerHr') or 0) for p in json.load(sys.stdin) if p['id']=='$id'))" 2>/dev/null)
  $PY -c "import sys; sys.exit(0 if 0<float('${cph:-0}' or 0)<=float('$MAXCPH') else 1)" || { state="PRICE ${cph:-unknown} NOT IN (0, $MAXCPH]"; exit 1; }
  a0=$(date +%s); up=""; while [ "$(date +%s)" -lt "$soft" ] && [ $(( $(date +%s) - a0 )) -lt 240 ]; do r=$(tmo 30 $PY runpod.py ssh $id 'echo up' 2>/dev/null | head -c 2); [ "$r" = up ] && { up=1; break; }; sleep 10; done
  [ -n "$up" ] && break
  echo "$(date +%H:%M) $id unreachable; deleting"; $PY podctl.py delete $id 600 || { state="UNREACHABLE POD NOT DELETED"; exit 1; }; echo "$id $(date +%s) deleted" >> "$ATT"; id=""; tries=$((tries+1))
done
[ -z "$id" ] && { state="NO POD"; exit 1; }
echo "$(date +%H:%M) pod $id ($v vCPU, $cph USD/h): soft stop in $(( soft - $(date +%s) ))s, hard stop in $(( hard - $(date +%s) ))s (cap $CAP USD)"
tmo 900 $PY runpod.py push $id $TGZ /root/rc.tgz >/dev/null 2>&1
tmo 1800 $PY runpod.py push $id $BTGZ /root/rb.tgz >/dev/null 2>&1
tmo 900 $PY runpod.py ssh $id 'mkdir -p touchstone bundle && tar xzf rc.tgz -C touchstone && tar xzf rb.tgz -C bundle && (which uv >/dev/null || curl -LsSf https://astral.sh/uv/install.sh 2>/dev/null | sh >/dev/null 2>&1); export PATH=$HOME/.local/bin:$PATH; cd touchstone && uv sync --frozen -q 2>&1 | tail -n 2; mkdir -p results/logs' >/dev/null 2>&1
chk=$(tmo 300 $PY runpod.py ssh $id "cd touchstone; export PATH=\$HOME/.local/bin:\$PATH; echo git=\$(git rev-parse HEAD 2>&1) env=\${TOUCHSTONE_IDENTITY_SALT:-unset} bundle=\$(ls /root/bundle/eval-all/freeze | wc -l); m=\$(cat /sys/fs/cgroup/memory.max 2>/dev/null || cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null); case \$m in max|''|9223372036854*) m=\$(awk '/MemTotal/ {print \$2*1024}' /proc/meminfo);; esac; echo memgb=\$((m/1073741824)); echo py=\$(uv run --frozen python -c 'import platform,numpy;print(platform.python_version(),numpy.__version__)' 2>&1 | tail -n 1 | tr ' ' _)" 2>/dev/null | tr '\n' ' ')
echo "$(date +%H:%M) prep: $chk"
case "$chk" in *"git=$EXPECT"*"env=unset"*) ;; *) state="PREP FAILED"; exit 1 ;; esac
memgb=$(echo "$chk" | sed -n 's/.*memgb=\([0-9]*\).*/\1/p'); [ -n "$memgb" ] && [ "$memgb" -ge "$MINMEM" ] || { state="PREP FAILED (memory ${memgb:-unknown} GB < $MINMEM GB)"; exit 1; }
cat > /tmp/r_remote_$TAG.sh <<EOS
#!/bin/bash
cd /root/touchstone; export OMP_NUM_THREADS=1 PATH=\$HOME/.local/bin:\$PATH; unset TOUCHSTONE_IDENTITY_SALT; unset TOUCHSTONE_LOCKED
B=/root/bundle; A="--src \$B/eval-all --draw \$B/draw/draw.json --instances \$B/draw/instances.json --cfgs \$B/deviation/cfg_linux.json --addendum \$B/report/addendum.json --report \$B/report/report.json"
D=docs/revision/followup/reset_followup_v2.py
{ [ -e /root/STOP ] || [ \$(date +%s) -ge $soft ]; } && { echo "== STOPPED BEFORE gate (cap) \$(date +%H:%M)"; exit 1; }
echo "== gate start \$(date +%H:%M)"
uv run --frozen python \$D --reproduce --require-identical --out results/v2/followup-gate --workers 1 \$A >> results/logs/r_gate.log 2>&1 || { echo "== GATE FAILED \$(date +%H:%M)"; exit 1; }
echo "== gate passed (bit-identical) \$(date +%H:%M)"
for st in inputs search freeze evaluate doubling diagnostics inventory; do
  { [ -e /root/STOP ] || [ \$(date +%s) -ge $soft ]; } && { echo "== STOPPED BEFORE \$st (cap) \$(date +%H:%M)"; exit 1; }
  w=$v; case \$st in evaluate|doubling|diagnostics) w=$WEVAL ;; esac
  echo "== stage \$st start \$(date +%H:%M) workers \$w"
  uv run --frozen python \$D --stage \$st --diag-cells 'fresh0@rho0.2|F111|D2|profit' --workers \$w --out results/v2/followup-reset \$A >> results/logs/r_run.log 2>&1 || { echo "== RUN FAILED at \$st \$(date +%H:%M)"; exit 1; }
done
echo "== RUN OK \$(date +%H:%M)"
EOS
tmo 120 $PY runpod.py push $id /tmp/r_remote_$TAG.sh /root/r_remote.sh >/dev/null 2>&1
tmo 120 $PY runpod.py ssh $id "chmod +x /root/r_remote.sh; (nohup /root/r_remote.sh > /root/touchstone/results/logs/r_remote.log 2>&1 < /dev/null &)" >/dev/null 2>&1
state="RUNNING"; stopped=""
while true; do
  sleep 120
  now=$(date +%s)
  [ "$now" -ge "$hard" ] && { state="HARD DEADLINE ($HARD x cap at $MAXCPH USD/h; the watchdog deletes the pod)"; exit 1; }
  if [ "$now" -ge "$soft" ] && [ -z "$stopped" ]; then tmo 60 $PY runpod.py ssh $id 'touch /root/STOP && test -e /root/STOP' >/dev/null 2>&1 && stopped=1 && echo "$(date +%H:%M) cap reached: the pod stops after the running stage"; fi
  st=$(tmo 90 $PY runpod.py ssh $id "tail -c 240 /root/touchstone/results/logs/r_remote.log" 2>/dev/null | tr '\n' ' ')
  echo "$(date +%H:%M) [soft $(( soft - now ))s, hard $(( hard - now ))s] $st" | tail -c 320
  case "$st" in
    *"RUN OK"*) state="RUN OK"; rc=0; exit 0 ;;
    *"GATE FAILED"*) state="GATE FAILED (not bit-identical; 18 cells not started)"; exit 1 ;;
    *"RUN FAILED"*|*"STOPPED BEFORE"*) state="$(echo "$st" | grep -o '== [A-Z].*' | head -c 120)"; exit 1 ;;
  esac
done
"""Pod safety primitives for the follow-up launchers (internal reviews r8-r9 of reset_pod.sh). Every function fails
closed: a failed listing counts as "pods may still exist", and success needs a successful listing that shows no pod.
Time limits are measured in elapsed seconds, never in loop counts.

CLI (exit 0 = success):
  podctl.py reconcile NAME [KEEP_ID]          delete every pod named NAME except KEEP_ID; verified by a fresh listing
  podctl.py delete ID SECONDS                 delete one pod and verify it is gone within SECONDS
  podctl.py watchdog NAME HARD_TS DONE_FILE   after DONE_FILE, or from HARD_TS (also writes NAME.blocked): delete every
                                              pod named NAME; exits only with DONE_FILE and SETTLE s of empty listings
  podctl.py may-create NAME HARD_TS           exit 0 only before HARD_TS and while NAME.blocked does not exist
  podctl.py remaining UNTIL_TS                print the seconds left (0 when past)
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
PY = sys.executable


def _run(args, timeout=60):
    try:
        r = subprocess.run([PY, os.path.join(HERE, "runpod.py")] + args, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout
    except subprocess.TimeoutExpired:
        return 124, ""


def list_pods(run=_run, timeout=60):
    """The pods as a list, or None when the listing failed (never an empty list on failure)."""
    rc, out = run(["list"], timeout=max(1, int(timeout)))
    if rc != 0:
        return None
    try:
        pods = json.loads(out)
    except ValueError:
        return None
    return pods if isinstance(pods, list) else None


def named(pods, name):
    return [p["id"] for p in pods if p.get("name") == name]


def delete_verified(pid, seconds, run=_run, clock=time.time, sleep=time.sleep):
    """Delete PID until a successful listing no longer shows it, within SECONDS of elapsed time."""
    end = clock() + seconds
    while clock() < end:
        run(["delete", pid], timeout=max(1, int(min(60, end - clock()))))
        if clock() >= end:
            break
        pods = list_pods(run, min(60, end - clock()))
        if clock() < end + 1e-9 and pods is not None and pid not in [p["id"] for p in pods]:
            return clock() <= end
        sleep(min(15, max(0.0, end - clock())))
    return False


def reconcile(name, keep="", seconds=600, run=_run, clock=time.time, sleep=time.sleep):
    """Delete every pod named NAME except KEEP; True only when a successful listing shows none left."""
    end = clock() + seconds
    while clock() < end:
        pods = list_pods(run, min(60, end - clock()))
        if pods is not None and clock() <= end:
            extra = [i for i in named(pods, name) if i != keep]
            if not extra:
                return True
            for i in extra:
                if clock() >= end:
                    break
                delete_verified(i, end - clock(), run, clock, sleep)
        sleep(min(15, max(0.0, end - clock())))
    return False


def may_create(name, hard_ts, clock=time.time, here=HERE):
    return clock() < hard_ts and not os.path.exists(os.path.join(here, f"{name}.blocked"))


SETTLE = 300          # seconds of consecutive empty listings, with the launcher done, before the watchdog ends


def watchdog(name, hard_ts, done_file, run=_run, clock=time.time, sleep=time.sleep, here=HERE, settle=SETTLE):
    """Ends only when DONE_FILE exists and successful listings show no pod named NAME for SETTLE consecutive seconds, so a
    delayed creation behind an ambiguous answer is still caught (r11). Before HARD_TS it deletes a pod only after DONE (the
    launcher reconciles before DONE, so any pod then is an orphan). From HARD_TS it blocks creation and deletes every pod
    named NAME, with no retry limit."""
    blocked = False
    empty_since = None
    while True:
        if not blocked and clock() >= hard_ts:
            open(os.path.join(here, f"{name}.blocked"), "w").write(str(int(clock())))
            print(f"{time.strftime('%H:%M')} WATCHDOG: hard deadline; creation blocked; deleting every pod named {name}", flush=True)
            blocked = True
        done = os.path.exists(done_file)
        if done or blocked:
            pods = list_pods(run)
            if pods is None:
                empty_since = None
            else:
                ids = named(pods, name)
                if ids:
                    empty_since = None
                    for i in ids:
                        print(f"{time.strftime('%H:%M')} WATCHDOG: deleting {i}", flush=True)
                        delete_verified(i, 120, run, clock, sleep)
                else:
                    empty_since = clock() if empty_since is None else empty_since
                    if done and clock() - empty_since >= settle:
                        print(f"{time.strftime('%H:%M')} WATCHDOG: no pod named {name} for {settle}s and the launcher is done", flush=True)
                        return 0
        sleep(30 if blocked else min(30, max(0.0, hard_ts - clock())) or 30)


def main(argv) -> int:
    cmd, a = argv[0], argv[1:]
    if cmd == "reconcile":
        return 0 if reconcile(a[0], a[1] if len(a) > 1 else "") else 1
    if cmd == "delete":
        return 0 if delete_verified(a[0], float(a[1])) else 1
    if cmd == "watchdog":
        return watchdog(a[0], float(a[1]), a[2])
    if cmd == "may-create":
        return 0 if may_create(a[0], float(a[1])) else 1
    if cmd == "remaining":
        print(max(0, int(float(a[0]) - time.time()))); return 0
    print(__doc__); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

