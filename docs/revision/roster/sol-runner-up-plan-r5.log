   290	def analysis(out, src, report: dict, markets=MARKETS, fams=FAMS, resamples: int = C.RESAMPLES) -> dict:
   291	    """Per family: runner-up minus R3, C* minus runner-up and C* minus R3, base and doubled, each rule against its own
   292	    unchanged frozen reference, paired on the evaluation seeds, from unrounded values; exploratory."""
   293	    res = {}
   294	    for fam in fams:
   295	        base = _contrasts(_base(out, LABEL, fam, markets), _base(src, "F111", fam, markets), _base(src, "C*", fam, markets), markets, resamples)
   296	        dbl = _contrasts(_doubled_out(out, fam, markets), _doubled_report(report, "F111", fam, markets), _doubled_report(report, "C*", fam, markets), markets, resamples)
   297	        flags = {}
   298	        for m in markets:
   299	            rec = read(Path(out) / "doubling" / (R._safe(R.cell_id(MAN.context(m), LABEL, fam, "profit")) + ".json")) or {}
   300	            flags[m] = {k: rec.get(k) for k in ("attack_change", "reference_change", "incomplete")}
   301	        row = {"label": "exploratory, after the report; " + C.SCOPE, "base": base, "doubled": dbl, "flags": flags}
   302	        if fam == "D2+H3":
   303	            row["expectation"] = _score(base, dbl)
   304	        res[fam] = row
   305	    return res
