   276	    if not G.finite([ru[m][1] for m in markets], [r3[m][1] for m in markets], [cs[m][1] for m in markets]):
   277	        return "not available"
   278	    g = lambda d: {m: d[m][1] for m in markets}
   279	    a, b, c = C.pooled_paired(g(ru), g(r3), resamples), C.pooled_paired(g(cs), g(ru), resamples), C.pooled_paired(g(cs), g(r3), resamples)
   280	    return {"runner_up_minus_r3": {**a, "category": C.q1_category(a["interval"])}, "cstar_minus_runner_up": b,
   281	            "cstar_minus_r3": {**c, "category": C.q1_category(c["interval"])}}
