    70	        if fr is None or fr.get("cuts") != CUTS or fr.get("h4_excluded") != H4_EXCLUDED:
    71	            _refuse(f"the original freeze of {ctx} is missing or not cuts {CUTS} with H4 loaded")
    72	        for fam in MAN.menu_families(R.manifest_ctx(ctx), LABEL):
    73	            for other in MAN.bank_rules(R.manifest_ctx(ctx), fam, CUTS, H4_EXCLUDED):
    74	                if other == LABEL:
