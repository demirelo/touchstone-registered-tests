def test_per_market_intervals_and_the_conditional_label():
    rng = np.random.default_rng(2)
    a = {m: rng.normal(0.1, 0.05, 40) for m in ("m0", "m1")}; b = {m: np.zeros(40) for m in ("m0", "m1")}
    got = C.pooled_paired(a, b, 999, 0)
    for m in ("m0", "m1"):
