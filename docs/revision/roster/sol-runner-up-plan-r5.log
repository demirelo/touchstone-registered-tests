        s = B.cma_seeds(k, R5)
        assert len(s) == R5 and not (s & used); used |= s
    assert B.cma_seeds(1, R5) == set(range(R5 + 2, 2 * R5 + 2))             # round 1 = the registered doubling (seed 1)


