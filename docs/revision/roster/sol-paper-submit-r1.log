"""Post-analysis extract for the paper (not part of the stamped manifest): R3's audit counts and full audit allocation per
winner set, rate and market, from exactly the diagnostics records the committed collector (rep_collect.collect) accepts
for expectation 5, the list of cells whose continued search produced the primary winner, the collector's status fields,
and the sha256 of the run's analysis, draw and manifest, so that replication_paper.py can refuse a stale extract.

Exactness: the collector is run unchanged. Four of its module functions are wrapped for the duration of the call only:
diag_ok and cont_diag_ok remember the diagnostics row they accept, _audit_of returns the same (audited, served) tuple
with that row's allocation and the winner's replacement switch x attached, and select_winner records which
continuation record produced which winner kind. Nothing the collector decides changes. Binding: the analysis is
recomputed from the same collected records exactly as rep_v2's analyse stage does, and the extract is written only if
it is byte-identical to the run's analysis.json.

Authentication of the extract's own fields: --check rebuilds the extract from the run records and requires it to be
byte-identical to the committed file; test_replication_extract.py pins the committed file's sha256 (EXTRACT_SHA256), so
any later edit fails the gate until the extract is rebuilt from the records and the pin is updated deliberately.

Usage: replication_extract.py --out <followup3-rep dir> --manifest <manifest> --draw <draw.json> (--write | --check) <json>"""
import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

CATS = ("honest_replacement", "honest_initial", "focal")
STEM = re.compile(r"^(menu|cthr)-p(0|0\.03|0\.05)__fresh([0-5])@rho0\.2__(F111|Cstar|F000)__D2\+H3__profit(__churn(0\.03|0\.05))?$")
CTHR_POLICY = "Cstar"          # every cthr-directory cell is C-thr, run on the C* policy slot
WINNER_KINDS = ("continued", "unresolved")


def sha_file(p) -> str:
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()


def records_digest(out) -> tuple:
    """(file count, sha256 over "<relative path> <sha256>" lines of every file under --out except analysis.json, sorted by
    path): identifies the run records an extract was built from, so that an archived copy can be matched."""
    out = Path(out)
    lines = sorted(f"{q.relative_to(out).as_posix()} {sha_file(q)}" for q in out.rglob("*") if q.is_file() and q != out / "analysis.json")
    return len(lines), hashlib.sha256("\n".join(lines).encode()).hexdigest()


def allocation(shares: dict) -> dict:
    """The draft-10 audit allocation (docs/revision/posthoc/churn_block.py, audit_allocation) for one winner: per-episode
    [served, audited] counts summed over episodes; young = the first age bin (younger than ten rounds); established =
    the other bins. A zero denominator gives None."""
    per = shares["per_episode"]
    nb = len(per[0]["focal"]) if per else 0
    t = {c: [[sum(e[c][b][j] for e in per) for j in (0, 1)] for b in range(nb)] for c in CATS}
    served = sum(t[c][b][0] for c in CATS for b in range(nb))
    audits = sum(t[c][b][1] for c in CATS for b in range(nb))
    yh = [t["honest_replacement"][0][j] + t["honest_initial"][0][j] for j in (0, 1)]
    eh = [sum(t[c][b][j] for c in ("honest_replacement", "honest_initial") for b in range(1, nb)) for j in (0, 1)]
    fo = [sum(t["focal"][b][j] for b in range(nb)) for j in (0, 1)]
    div = lambda a, b: a / b if b else None
    return {"young_honest_job_share": div(yh[0], served), "young_honest_audit_share": div(yh[1], audits),
            "established_honest_audit_rate": div(eh[1], eh[0]), "focal_job_share": div(fo[0], served),
            "focal_audit_rate": div(fo[1], fo[0])}


class Counts(tuple):
    """(audited, served), as the collector stores it, carrying the allocation of the same shares."""
    for s, lab in SETS:
        for p in RATES:
            t = analysis[s]["terms"][p]
            for r in RULES:
                v = {k: [t[m][r][k] for m in MARKETS] for k in ("attack", "reference", "gain", "eff_attack")}
                mean = lambda k: sum(v[k]) / len(v[k])
                lines.append(" & ".join([lab, p, r.replace("C*", "C$^*$"), _f(mean("attack")), _f(mean("reference")), _f(mean("gain")),
                                         _f(mean("eff_attack")), _f(min(v["eff_attack"]))]) + " \\\\")
    return "\n".join(lines + ["\\bottomrule", "\\end{tabular}", ""])


def table_alloc(summ: dict) -> str:
    """R3's audit allocation per set and rate: equal-weight means over the markets with diagnostics, and the range of
    the audited share of the attacker's jobs over those markets."""
    lines = ["\\begin{tabular}{llrrrrrrrr}", "\\toprule",
             "Winners & $p$ & Markets & Young honest jobs & Young honest audits & Established honest rate & Attacker jobs & "
             "Attacker rate & Attacker range & Replacing \\\\", "\\midrule"]
    for s, lab in SETS:
        for p in RATES:
            a, au = summ[s]["alloc"][p], summ[s]["audit"][p]
            lines.append(" & ".join([lab, p, f"{a['markets']}/6"] + [_f(a[k]) for k in ALLOC]
                                    + [f"{_f(au['focal_audit_min'])}--{_f(au['focal_audit_max'])}", f"{a['replacing_markets']}/{a['markets']}"]) + " \\\\")
    return "\n".join(lines + ["\\bottomrule", "\\end{tabular}", ""])


def _dump(d: dict) -> str:
    return json.dumps(d, indent=1, sort_keys=True) + "\n"


def outputs(analysis, extract, analysis_sha, summary_path, table_path) -> dict:
    s = summary(analysis, extract, analysis_sha)
    d = Path(table_path).parent
    return {Path(summary_path): _dump(s), Path(table_path): table(analysis),
            d / "replication_markets.tex": table_markets(analysis), d / "replication_absolute.tex": table_absolute(analysis),
            d / "replication_terms.tex": table_terms(analysis), d / "replication_alloc.tex": table_alloc(s)}


def write(analysis, extract, analysis_sha, summary_path, table_path) -> None:
    for path, text in outputs(analysis, extract, analysis_sha, summary_path, table_path).items():
        path.write_text(text)


def check(analysis, extract, analysis_sha, summary_path, table_path) -> list:
    return [f"stale: {p} (run replication_paper.py --write)"
            for p, want in outputs(analysis, extract, analysis_sha, summary_path, table_path).items()
            if not p.exists() or p.read_text() != want]


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()
    for k in ("analysis", "extract", "summary", "table"):
        ap.add_argument(f"--{k}", required=True)
    g = ap.add_mutually_exclusive_group(required=True); g.add_argument("--write", action="store_true"); g.add_argument("--check", action="store_true")
    a = ap.parse_args(argv)
    an, ex = (json.loads(Path(p).read_text()) for p in (a.analysis, a.extract))
    sha = sha_file(a.analysis)
    if a.write:
        write(an, ex, sha, a.summary, a.table); return 0
    probs = check(an, ex, sha, a.summary, a.table)
    print("\n".join(probs) or "ok")
    return 1 if probs else 0


if __name__ == "__main__":
    sys.exit(main())
    fig.savefig(path, metadata={"CreationDate": None}); plt.close(fig)   # no timestamp: the bytes depend only on the data (Astra d10-r1, 8)


def _same_pdf(d: dict, path: Path) -> bool:
    """The PDF on disk equals a fresh rendering of the data, byte for byte."""
    import tempfile
    if not path.exists():
        return False
    with tempfile.TemporaryDirectory() as t:
        fresh = Path(t) / "fig.pdf"; _draw(d, fresh)
        return fresh.read_bytes() == path.read_bytes()


def write(d: dict, figdir, tabdir, summary_path=None, summary=None, ttable=None, rtable=None, dtable=None) -> None:
    fd, td = Path(figdir), Path(tabdir)
    if dtable is not None:
        (td / "posthoc_churn_delta.tex").write_text(dtable)
    if rtable is not None:
        (td / "posthoc_runnerup.tex").write_text(rtable)
    if ttable is not None:
        (td / "posthoc_churn_t.tex").write_text(ttable)
    if summary_path is not None:
        Path(summary_path).write_text(json.dumps(summary, indent=1, sort_keys=True) + "\n")
    (fd / "fig_churn.data.json").write_text(json.dumps(d, indent=1, sort_keys=True))
    _draw(d, fd / "fig_churn.pdf")
    (td / "posthoc_churn_audit.tex").write_text(audit_table(d))


def check(d: dict, figdir, tabdir, summary_path=None, summary=None, ttable=None, rtable=None, dtable=None) -> list:
    fd, td = Path(figdir), Path(tabdir); bad = []
    if dtable is not None and (not (td / "posthoc_churn_delta.tex").exists() or (td / "posthoc_churn_delta.tex").read_text() != dtable):
        bad.append("posthoc_churn_delta.tex: stale or missing; run --write")
    if rtable is not None and (not (td / "posthoc_runnerup.tex").exists() or (td / "posthoc_runnerup.tex").read_text() != rtable):
        bad.append("posthoc_runnerup.tex: stale or missing; run --write")
    if ttable is not None and (not (td / "posthoc_churn_t.tex").exists() or (td / "posthoc_churn_t.tex").read_text() != ttable):
        bad.append("posthoc_churn_t.tex: stale or missing; run --write")
    if summary_path is not None:
        sp = Path(summary_path)
        if not sp.exists() or json.loads(sp.read_text()) != json.loads(json.dumps(summary, sort_keys=True)):
            bad.append(f"{sp.name}: stale or missing; run --write")
    f = fd / "fig_churn.data.json"
    if not f.exists() or json.loads(f.read_text()) != json.loads(json.dumps(d, sort_keys=True)) or not _same_pdf(d, fd / "fig_churn.pdf"):
        bad.append("fig_churn: stale or missing; run --write")
    t = td / "posthoc_churn_audit.tex"
    if not t.exists() or t.read_text() != audit_table(d):
        bad.append("posthoc_churn_audit.tex: stale or missing; run --write")
    return bad


def main(argv=None) -> int:
    ap = argparse.ArgumentParser()

