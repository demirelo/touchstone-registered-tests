def pod_gate_ok(rep: dict, require_identical: bool) -> bool:
    """The author's decision (card touchstone-reset-repro-pass): on the pod, start the 18 cells only if the reproduction
    is bit-identical; on the Mac, the draft-5 criterion applies."""
    return bool(rep.get("identical")) if require_identical else bool(rep.get("pass"))


def reproduce(src, out, root: str, params: dict, salt_sha256: str, workers: int = 1) -> dict:
    """Rerun the registered headline F111 D2 search and evaluation through this script's path (input copies, freeze,
    acceptance) and compare with the registered records."""
    mkt = R.market("headline", root, 0.2, salt_sha256=salt_sha256)
    j = R.job(mkt, "F111", "D2", "profit", params=params)
    reg = read(R.path_of(src, REPRO))
    container = {"headline": {"container_hash": (reg or {}).get("provenance", {}).get("cfg_sha256")}}
    preflight(out, src, [j], salt_sha256, container)
    copy_inputs(src, out, inputs(src, [j]))
    run_stage("search", [j], out, workers); prefreeze(out, [j])
    accept(out, [j], salt_sha256, {"headline": {"container_hash": reg["provenance"]["cfg_sha256"]}})
    run_stage("evaluate", [j], out, workers)
    rep = compare(src, out); write(Path(out) / "gate.json", {"stage": "reproduction gate", "cell": REPRO, **rep}); inventory(out)
    return rep


def headline_jobs(root: str, params: dict, salt_sha256: str) -> list[dict]:
    """The three registered headline D2 cells (not cut; their records are in the source)."""
    mkt = R.market("headline", root, 0.2, salt_sha256=salt_sha256)
    return [R.job(mkt, r, "D2", "profit", params=params) for r in RULES]


def headline_diagnostics(src, out, root: str, params: dict, salt_sha256: str, report: dict) -> dict:
    """Plan section 4 at the headline market, on the Mac before the pod: 9 policies and 6 switches on the 200 seeds."""
    res = diagnostics(src, out, headline_jobs(root, params, salt_sha256), report, d2_from=src)
    write(Path(out) / "diagnostics_headline.json", res)
    return res


POD_STEPS = ("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory")
SPOT = "fresh0@rho0.2|F111|D2|profit"                 # plan section 4: the cell diagnosed on the pod and on the Mac


def diag_jobs(jobs: list[dict], which: str) -> list[dict]:
    return jobs if which == "all" else [j for j in jobs if j["id"] in which.split(",")]


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--src", default=str(EVAL_ALL)); ap.add_argument("--out", required=True)
    ap.add_argument("--draw", default=str(ROOT / "results/v2/draw/draw.json")); ap.add_argument("--instances", default=str(ROOT / "results/v2/draw/instances.json"))
    ap.add_argument("--cfgs", default=str(ROOT / "results/v2/deviation/cfg_linux.json")); ap.add_argument("--addendum", default=str(ROOT / "results/v2/report/addendum.json"))
    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--markets", default=",".join(MARKETS))
    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
    ap.add_argument("--workers", type=int, default=1); ap.add_argument("--smoke", action="store_true")
    ap.add_argument("--reproduce", action="store_true", help=f"validation (a): rerun {REPRO} and compare (plan draft 5)")
    ap.add_argument("--require-identical", dest="req_id", action="store_true", help="the pod gate: exit 1 unless the reproduction is bit-identical")
    ap.add_argument("--reproduce-doubling", dest="repro_dbl", default=None, help="validation (d): a registered D2+H3 doubling cell id")
    ap.add_argument("--report", default=str(ROOT / "results/v2/report/report.json"), help="for the diagnostics stage")
    ap.add_argument("--headline-diagnostics", dest="hl_diag", action="store_true", help="plan section 4: the three headline cells, on the Mac")
    ap.add_argument("--diag-cells", dest="diag_cells", default="all", help=f"diagnostics stage: 'all' (Mac, after retrieval) or cell ids (pod: {SPOT})")
    a = ap.parse_args(argv); out = Path(a.out); check_out(out, a.src)
    from sim.records import cfg_from_dict
    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
    cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
    if a.hl_diag:
        params = json.loads(Path(a.params).read_text()); j0 = headline_jobs(root, params, salt_sha)
        check_salt(out, salt_sha, j0); check_commit(j0); check_code(); check_pairing(a.src, j0)
        headline_diagnostics(a.src, out, root, params, salt_sha, json.loads(Path(a.report).read_text())); inventory(out)
        print(json.dumps({"headline_diagnostics": len(j0)})); return 0
    if a.repro_dbl:
        rep = reproduce_doubling(a.src, out, a.repro_dbl, root, cfgs, json.loads(Path(a.params).read_text()), salt_sha)
        print(json.dumps({"reproduce_doubling": a.repro_dbl, **rep}))
        return 0 if rep["pass"] else 1
    if a.reproduce:
        rep = reproduce(a.src, out, root, json.loads(Path(a.params).read_text()), salt_sha, a.workers)
        ok = pod_gate_ok(rep, a.req_id)
        print(json.dumps({"reproduce": REPRO, "require_identical": a.req_id, "gate_ok": ok, **rep}))
        return 0 if ok else 1
    jobs = build_jobs(root, cfgs, json.loads(Path(a.params).read_text()), salt_sha, tuple(a.markets.split(",")), a.smoke)
    check_configs(jobs, container); check_salt(out, salt_sha, jobs); check_commit(jobs); check_code()
    if not a.smoke:
        check_pairing(a.src, jobs)
    steps = POD_STEPS if a.stage == "all" else (a.stage,)
    for st in steps:
        if st == "inputs":
            copy_inputs(a.src, out, inputs(a.src, jobs))
        elif st == "search":
            run_stage("search", jobs, out, a.workers)
        elif st == "freeze":
            prefreeze(out, jobs)
        elif st == "diagnostics":
            dj = diag_jobs(jobs, a.diag_cells)
            write(out / ("diagnostics.json" if a.diag_cells == "all" else "diagnostics_spot.json"), diagnostics(a.src, out, dj, json.loads(Path(a.report).read_text())))
        elif st in ("evaluate", "doubling"):
            accept(out, jobs, salt_sha, container, src=a.src); run_stage(st, jobs, out, a.workers)
        else:
            inventory(out)
        print(json.dumps({"stage": st, "jobs": len(jobs)}), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main())
def main(argv=None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--src", default=str(F.EVAL_ALL)); ap.add_argument("--out", required=True); ap.add_argument("--report", required=True)
    ap.add_argument("--posthoc", default=str(HERE.parent / "posthoc" / "posthoc.json"), help="its `nesting` block adds X7-SC cells")
    ap.add_argument("--draw", required=True); ap.add_argument("--instances", required=True); ap.add_argument("--cfgs", required=True); ap.add_argument("--addendum", required=True)
    ap.add_argument("--params", default=str(ROOT / "experiments/v2/params.json")); ap.add_argument("--cells", default=None, help="comma list; default the whole run")
    ap.add_argument("--max-rounds", dest="max_rounds", type=int, default=MAX_ROUNDS); ap.add_argument("--workers", type=int, default=1)
    ap.add_argument("--smoke", action="store_true"); ap.add_argument("--gate", action="store_true", help="round 1 only, compared with the registered doubling")
    ap.add_argument("--site", choices=("mac", "pod"), default="pod", help="where this runs; a pod run is paid and needs --started-at")
    ap.add_argument("--evidence", action="append", default=[], help="gate records (Mac and pod) for the gate cells (full runs)")
    ap.add_argument("--cap-usd", dest="cap", type=float, default=4.25); ap.add_argument("--usd-per-hour", dest="rate", type=float, default=0.56)
    ap.add_argument("--started-at", dest="started", type=float, default=None)
    ap.add_argument("--attempts", default=None, help="the launcher's attempts file (closed attempts count toward the cap); required for a paid run")
    ap.add_argument("--ledger", default=str(ROOT / "docs/revision/budget-ledger.json"), help="recorded spend of earlier launches")
    ap.add_argument("--run-tag", dest="run_tag", default=None, help="ledger tag prefix of this run's launches (e.g. convergence); required for a paid run")
    ap.add_argument("--stop-file", dest="stop_file", default=None, help="the launcher's STOP file, checked before each stage or round")
    ap.add_argument("--soft-deadline", dest="soft", type=float, default=None, help="the launcher's soft deadline (epoch seconds)")
    a = ap.parse_args(argv)
    G.pin_settings(); out = Path(a.out); F.check_out(out, a.src)
    if not 1 <= a.max_rounds <= MAX_ROUNDS:
        _refuse(f"--max-rounds must be 1 to {MAX_ROUNDS}")
    from sim.records import cfg_from_dict
    report = json.loads(Path(a.report).read_text()); nesting = json.loads(Path(a.posthoc).read_text())["nesting"]
    root = json.loads(Path(a.draw).read_text())["hash"]; salt = json.loads(Path(a.instances).read_text())["salt_sha256"]
    params = json.loads(Path(a.params).read_text()); cfgs = {k: cfg_from_dict(v) for k, v in json.loads(Path(a.cfgs).read_text()).items()}
    plan = cells_for(report, nesting); check_rounds(a.max_rounds, a.gate, plan["nesting"])
    cells = a.cells.split(",") if a.cells else plan["cells"]
    if bad := [c for c in cells if c not in plan["cells"]]:
        _refuse(f"not cells of this run: {bad}")
    out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
    jobs = [job_for(c, root, cfgs, params, salt, a.smoke) for c in cells]
    container = dict(json.loads(Path(a.addendum).read_text())["deviations"]["configs"])
    for j in jobs:                                               # headline: the registered record's configuration hash
        if j["mkt"]["label"] == "headline":
            container["headline"] = {"container_hash": read(R.path_of(a.src, j["id"]))["provenance"]["cfg_sha256"]}
    F.check_salt(out, salt, jobs); F.check_commit(jobs); F.check_code(); F.check_configs(jobs, container)
    if not a.smoke:
        F.check_pairing(a.src, jobs)
        for j in jobs:
            G.check_budget(j, R.path_of(a.src, j["id"]))
    needs = {j["id"]: cell_inputs(a.src, j) for j in jobs}
    F.copy_inputs(a.src, out, merge_inputs(list(needs.values())))     # one call: the helper refuses added keys
    drv = sha_file(Path(__file__))
    emb = lambda j: (report["doubling"].get(R.cell_id(j["context"], j["rule"], "D2+H3", "profit")) or {}).get("heldout", {}).get("knobs") if j["id"] in plan["nesting"] else None
    dbl_rec = lambda j: Path(a.src) / "doubling" / (R._safe(j["id"]) + ".json")
    def bind_for(j, inputs, smoke, gate):
        st = {"max_rounds": 1 if gate else a.max_rounds, "threshold": THRESHOLD, "seeds": "1+(k-1)R", "gate": gate,
              "nesting": (j["id"] in plan["nesting"]) and not gate}
        return G.binding(inputs_sha=G.sha_json(inputs), provenance=j["provenance"], smoke=smoke, settings=st, driver_sha=drv,
                         deps=deps_for(a.report, a.posthoc, dbl_rec(j), None if gate else emb(j)))
    bind = lambda j: bind_for(j, needs[j["id"]], a.smoke, a.gate)
    if not a.smoke and not a.gate:
        gj = {c: job_for(c, root, cfgs, params, salt, False) for c in GATE_CELLS}
        check_run_evidence(a.evidence, a.smoke, a.gate, {c: bind_for(j, cell_inputs(a.src, j), False, True) for c, j in gj.items()})
    t = json.loads((ROOT / "experiments/v2/benchmark/timings.json").read_text())["timings"]; ev = t["eval160"]["profit"] * 200 / 160
    hours = lambda j: ((t["doubling_x7"] if j["family"] == "X7-SC" else t["doubling"]) + ev) / 3600 + 0.1     # a round, its evaluation, shutdown
    paid = a.site == "pod" and not a.smoke
    stop = G.paid_cost_stop(a.cap, a.rate, a.started, a.attempts, a.ledger, a.run_tag, stop_file=a.stop_file, soft_deadline=a.soft) if paid else None
    cargs = worker_cost_args(stop) if paid else None
    files = {"driver": Path(__file__), "plan": HERE / "convergence-plan.md", "report": Path(a.report), "posthoc": Path(a.posthoc)}
    if a.gate:
        res = {}
        for j in jobs:                                           # serial; admission before each gate cell
            if stop and not stop.allow(f"gate {j['id']}", hours(j)):
                write(out / "cost_stop.json", stop.report()); G.inventory(out, DEVIATIONS, files, argv); return 3
            res[j["id"]] = gate_cell(j, out, a.src, a.site, bind(j), cargs, hours(j))
            write(out / "gate" / (R._safe(j["id"]) + f"__{a.site}.json"), res[j["id"]])
        G.inventory(out, DEVIATIONS, files, argv)
