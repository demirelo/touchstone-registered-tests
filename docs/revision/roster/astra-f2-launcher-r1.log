   196	# The generated remote scripts, executed under a scratch root with a stub `uv` (logs each call; acts as $STUB says):
   197	# every end state, the order of calls (admission before each paid step, the gate before the driver), and the flags.
   198	mkdir -p stubbin junk
   199	cat > stubbin/uv <<'EOF'
   200	#!/bin/bash
   201	# stub for `uv run --frozen python <script> ...`. STUB words: admit@<hours>=refuse|crash, gate=fail|crash|cap, run=cap|fail|crash
   202	echo "$*" >> "$REMOTE_ROOT/calls.log"
   203	s=$4; what=run; hours=""; prev=""
   204	for i in "$@"; do [ "$prev" = "--hours" ] && hours=$i; prev=$i; done
   205	case "$s" in *guards.py) what="admit@$hours" ;; *reset_followup_v2.py) what=gate ;; *convergence_v2.py) case " $* " in *" --gate "*) what=gate ;; esac ;; esac
   206	act=""; for w in $STUB; do [ "${w%%=*}" = "$what" ] && act=${w#*=}; done
   207	case "$what:$act:$s" in
   208	  admit*:refuse:*) echo '{"stopped_before": "next step"}'; exit 3 ;;
   209	  admit*:crash:*) echo "follow-up refused: no launcher attempts file"; exit 1 ;;
   210	  gate:fail:*reset_followup_v2.py) echo '{"reproduce": "x", "require_identical": true, "gate_ok": false}'; exit 1 ;;
   211	  gate:fail:*) exit 4 ;;
   212	  gate:cap:*) exit 3 ;;
   213	  *:crash:*) echo "Traceback (most recent call last): ValueError"; exit 1 ;;
   214	  run:cap:*) echo '{"stopped_before": "search", "cap_usd": 3.0}'; exit 3 ;;
   215	  run:fail:*) exit 4 ;;
   216	esac
   217	exit 0
   218	EOF
