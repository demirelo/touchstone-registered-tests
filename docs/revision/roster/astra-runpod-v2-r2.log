    13	def _http(method, path, body=None):
    14	    """(HTTP status, parsed body); an HTTP error is (code, {"error": code, "body": text}); network errors raise."""
    15	    req = urllib.request.Request(BASE + path, data=json.dumps(body).encode() if body else None, method=method, headers=HEADERS)
    16	    try:
    17	        with urllib.request.urlopen(req, timeout=60) as r:
    18	            t = r.read().decode(); return r.status, (json.loads(t) if t else None)
    19	    except urllib.error.HTTPError as e:
    20	        return e.code, {"error": e.code, "body": e.read().decode()[:500]}
    21	
    22	
    23	def api(method, path, body=None):
    24	    return _http(method, path, body)[1]
    25	
    26	
    27	def _direct(p):
    28	    d = (p.get("ssh") or {}).get("direct") if isinstance(p.get("ssh"), dict) else None
    29	    return (d.get("host"), d.get("port")) if isinstance(d, dict) else (None, None)
