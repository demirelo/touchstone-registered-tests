    39	def list_pods():
    40	    """Every non-terminated pod in the v1 shape, following the cursor; ValueError on any answer it cannot read."""
    41	    out, cursor = [], None
    42	    for _ in range(1000):
    43	        status, d = _http("GET", "/pods" + (f"?cursor={urllib.parse.quote(cursor)}" if cursor else ""))
    44	        if status != 200 or not isinstance(d, dict) or not isinstance(d.get("pods"), list) or not isinstance(d.get("pagination"), dict):
    45	            raise ValueError(f"unreadable pod listing (HTTP {status})")
    46	        for p in d["pods"]:
    47	            if not isinstance(p, dict) or not isinstance(p.get("id"), str) or not p["id"] or not isinstance(p.get("name"), str):
    48	                raise ValueError("a pod without a string id and name")   # it would vanish from podctl.named()
    49	            if p.get("status") != "TERMINATED":
    50	                out.append(_v1(p))
    51	        pg = d["pagination"]
    52	        if "nextCursor" in pg and pg.get("hasNextPage") is False and pg["nextCursor"] is None:
    53	            return out
    54	        if pg.get("hasNextPage") is not True or not isinstance(pg.get("nextCursor"), str) or not pg["nextCursor"]:
    55	            raise ValueError("unreadable or inconsistent pagination")
    56	        cursor = pg["nextCursor"]
    57	    raise ValueError("too many pages")
    58	
