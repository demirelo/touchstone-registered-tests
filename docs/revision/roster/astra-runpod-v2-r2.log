    32	def _v1(p):
    33	    host, port = _direct(p)
    34	    cpu = p.get("cpu") if isinstance(p.get("cpu"), dict) else {}
    35	    return {"id": p["id"], "name": p.get("name"), "desiredStatus": p.get("status"), "publicIp": host,
    36	            "portMappings": {"22": port} if port is not None else {}, "costPerHr": p.get("cost"), "vcpuCount": cpu.get("vcpuCount")}
