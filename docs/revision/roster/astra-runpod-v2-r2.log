    65	def ssh(pod_id, cmd, timeout=None):
    66	    ip, port = target(pod_id)
    67	    if not ip or not port:
    68	        return subprocess.CompletedProcess([], 255, "", "no direct ssh endpoint")
    69	    return subprocess.run(["ssh", "-i", SSHKEY, "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=20", "-p", str(port), f"root@{ip}", cmd],
    70	                          capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
    71	
    72	
    73	def rsync(pod_id, src, dst, pull=False):
    74	    ip, port = target(pod_id)
    75	    if not ip or not port:
    76	        return subprocess.CompletedProcess([], 255, "", "no direct ssh endpoint")
    77	    e = f"ssh -i {SSHKEY} -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -p {port}"
    78	    a, b = (f"root@{ip}:{src}", dst) if pull else (src, f"root@{ip}:{dst}")
    79	    return subprocess.run(["rsync", "-az", "-e", e, a, b], capture_output=True, text=True)
