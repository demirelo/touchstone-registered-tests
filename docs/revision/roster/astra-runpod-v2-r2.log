   220	
   221	def watchdog(name, hard_ts, done_file, run=_run, clock=time.time, sleep=time.sleep, here=HERE, settle=SETTLE,
   222	             mono=time.monotonic):
   223	    """Ends only when DONE_FILE exists and successful listings show no pod named NAME for the settle time, counted from
   224	    DONE onwards (r11); while NAME.request is "pending" (an outstanding or ambiguous creation request) the settle time is
   225	    at least AMBIGUOUS_SETTLE. After DONE (the launcher reconciles first) any pod named NAME is an orphan and is deleted.
   226	    From HARD_TS it also blocks creation and deletes every pod named NAME, with no retry limit. On exit it writes
   227	    NAME.wdend and releases NAME.launchlock (it is the last process of a launch). Wall time (CLOCK) is used only for the
   228	    hard deadline; the settle time and deletion budgets use MONO, so a clock change cannot shorten them (r16)."""
   229	    blocked = False
   230	    empty_since = None
   231	    while True:
   232	        if not blocked and clock() >= hard_ts:
   233	            open(os.path.join(here, f"{name}.blocked"), "w").write(str(int(clock())))
   234	            print(f"{time.strftime('%H:%M')} WATCHDOG: hard deadline; creation blocked; deleting every pod named {name}", flush=True)
   235	            blocked = True
   236	        done = os.path.exists(done_file)
   237	        need = max(settle, AMBIGUOUS_SETTLE) if _request_pending(here, name) else settle
   238	        if done or blocked:
   239	            pods = list_pods(run)
   240	            if pods is None:
   241	                empty_since = None
   242	            else:
   243	                ids = named(pods, name)
   244	                if ids:
   245	                    empty_since = None
   246	                    for i in ids:
   247	                        print(f"{time.strftime('%H:%M')} WATCHDOG: deleting {i}", flush=True)
   248	                        delete_verified(i, 120, run, mono, sleep)
   249	                elif done:
   250	                    empty_since = mono() if empty_since is None else empty_since
   251	                    if mono() - empty_since >= need:
   252	                        open(os.path.join(here, f"{name}.wdend"), "w").write(f"{time.time()} {time.monotonic()}")   # wall, monotonic (r17)
   253	                        try:
   254	                            os.rmdir(os.path.join(here, f"{name}.launchlock"))
   255	                        except OSError:
   256	                            pass
   257	                        print(f"{time.strftime('%H:%M')} WATCHDOG: no pod named {name} for {need}s after the launcher was done; "
   258	                              f"record the spend with `podctl.py spend {name}` from {WAIT_AFTER_WATCHDOG}s after now", flush=True)
   259	                        return 0
   260	                else:
   261	                    empty_since = None
   262	        sleep(30 if blocked else min(30, max(0.0, hard_ts - clock())) or 30)
   263	
   264	
   265	def main(argv) -> int:
   266	    cmd, a = argv[0], argv[1:]
   267	    if cmd == "reconcile":
   268	        return 0 if reconcile(a[0], a[1] if len(a) > 1 else "") else 1
   269	    if cmd == "delete":
   270	        return 0 if delete_verified(a[0], float(a[1])) else 1
   271	    if cmd == "price":
   272	        p = price(a[0]); print(p if p is not None else "unknown"); return 0 if p is not None else 1
   273	    if cmd == "balance":
   274	        b = balance(); print(f"{b[0]} {b[1]}" if b else "unknown"); return 0 if b else 1
   275	    if cmd == "spend":
   276	        usd, note = spend(a[0]); print(f"{usd} USD ({note})" if usd is not None else f"refused: {note}"); return 0 if usd is not None else 1
   277	    if cmd == "watchdog":
