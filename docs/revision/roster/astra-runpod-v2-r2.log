   117	def _finite(v, minimum):
   118	    try:
   119	        v = float(v)
   120	    except (TypeError, ValueError):
   121	        return None
   122	    return v if math.isfinite(v) and v >= minimum else None
   123	
   124	
   125	def price_of(pod):
   126	    """The pod's price in USD/h when it is finite and positive, else None (missing, null, zero or unreadable: r12)."""
   127	    v = _finite((pod or {}).get("costPerHr"), 0)
   128	    return v if v is not None and v > 0 else None
