   137	def balance(run=_run):
   138	    """(balance USD, account spend USD/h) from `runpod.py balance`, or None when either is missing or unreadable."""
   139	    rc, out = run(["balance"], timeout=60)
   140	    if rc != 0:
   141	        return None
   142	    try:
   143	        d = json.loads(out)
   144	    except ValueError:
   145	        return None
   146	    if not isinstance(d, dict):
   147	        return None
   148	    b, s = _finite(d.get("balance"), -math.inf), _finite(d.get("spendPerHr"), 0)
   149	    return None if b is None or s is None else (b, s)
   150	
   151	
   152	def _utc(ts):
   153	    return datetime.datetime.fromtimestamp(ts, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
   154	
   155	
   156	def spend(name, run=_run, clock=time.time, here=HERE, mono=time.monotonic):
   157	    """(USD rounded up to a cent, note) or (None, reason); on success also writes NAME.spent. Needs NAME.bal0, NAME.wdend
   158	    at least WAIT_AFTER_WATCHDOG s old by both wall and monotonic time (r17; after a restart the wait cannot be verified
   159	    and spend is refused), a successful listing with no pod named NAME, a readable balance, and a balance that did not
   160	    rise (a rise proves a credit or deposit). The difference is valid only if no deposit or credit was added in the
   161	    window (r16): the author confirms that on the Runpod billing page; the note names the window. It holds
   162	    NAME.launchlock while it works, so it cannot overlap a launch (r17), and publishes NAME.spent atomically."""
   163	    lock = os.path.join(here, f"{name}.launchlock")
   164	    try:
   165	        os.mkdir(lock)
   166	    except OSError:
   167	        return None, "a launch or its watchdog holds NAME.launchlock"
   168	    try:
   169	        return _spend_locked(name, run, clock, here, mono)
   170	    finally:
   171	        try:
   172	            os.rmdir(lock)
   173	        except OSError:
   174	            pass
   175	
   176	
   177	def _spend_locked(name, run, clock, here, mono):
   178	    f0 = os.path.join(here, f"{name}.bal0")
   179	    try:
   180	        bal0 = Decimal(open(f0).read().split()[0]); t0 = os.path.getmtime(f0)
   181	    except (OSError, IndexError, InvalidOperation):
   182	        return None, "no starting balance (NAME.bal0)"
   183	    try:
   184	        wdend, wdmono = (float(x) for x in open(os.path.join(here, f"{name}.wdend")).read().split()[:2])
   185	    except (OSError, ValueError):
   186	        return None, "the watchdog has not ended"
   187	    if mono() < wdmono:
   188	        return None, "the machine restarted since the watchdog ended, so the wait cannot be verified; take the spend from the Runpod billing page"
   189	    if clock() - wdend < WAIT_AFTER_WATCHDOG or mono() - wdmono < WAIT_AFTER_WATCHDOG:
   190	        return None, f"wait until {WAIT_AFTER_WATCHDOG} s after the watchdog ended"
   191	    pods = list_pods(run)
   192	    if pods is None or named(pods, name):
   193	        return None, "a pod named NAME may still exist"
   194	    b = balance(run)
   195	    if b is None:
   196	        return None, "balance unknown"
   197	    now = Decimal(str(b[0]))
   198	    if now > bal0:
   199	        return None, "the balance rose (a credit or deposit was added); take the spend from the Runpod billing page"
   200	    usd = float((bal0 - now).quantize(Decimal("0.01"), rounding=ROUND_CEILING))
   201	    note = (f"balance difference; valid only if no deposit or credit was added between {_utc(t0)} and {_utc(clock())} "
   202	            f"(check the Runpod billing page)"
   203	            + (f"; the account still bills {b[1]} USD/h elsewhere, so this overstates" if b[1] > 0 else ""))
   204	    final, tmp = os.path.join(here, f"{name}.spent"), os.path.join(here, f"{name}.spent.tmp")
   205	    try:
   206	        with open(tmp, "w") as f:
   207	            f.write(f"{usd} USD {note}\n"); f.flush(); os.fsync(f.fileno())
   208	        os.replace(tmp, final)     # published only when complete (r17)
   209	    except OSError as e:
   210	        return None, f"could not write the spend record ({e})"
   211	    return usd, note
