   140	    if rec["status"] == "passed" and not (ok[-1] and not any(ok[:-1])):
   141	        return "status passed without a final passing round"
   142	    if rec["status"] == STATUSES[1] and (len(rounds) != max_rounds or any(ok)):
   143	        return "status at the cap without the capped, unpassed rounds"
   144	    if (rec.get("heldout") or {}).get("knobs") != rounds[-1]["best_knobs"]:
   145	        return "held-out winner differs from the last round's winner"
   146	    return None
   147	
   148	
   149	def cont_problem(rec, key: str, job: dict, smoke: bool = False, max_rounds: int = 3) -> str | None:
   150	    """A continuation record (reviews rep-impl-r2, r3): stage, id, provenance, a known status; a winner it supplies
   151	    ("passed" or "not passed at the cap") needs its own identical round-1 comparison with a finite round-1 winner (smoke:
   152	    not compared), well-formed rounds (_rounds_problem) and a finite held-out result with positive normalizers on the
   153	    job's ordered evaluation seeds. The job must carry its evaluation seeds: no check is skipped."""
   154	    seeds = (job.get("mkt") or {}).get("seeds_eval")
   155	    if not seeds:
   156	        return "the job has no evaluation seeds to check against"
   157	    if not isinstance(rec, dict) or rec.get("stage") != "convergence" or rec.get("id") != key:
   158	        return "not a continuation record of this cell"
   159	    if rec.get("provenance") != job.get("provenance"):
   160	        return "continuation record of another job or run"
   161	    st = rec.get("status")
   162	    if st not in STATUSES:
   163	        return f"unknown continuation status {st!r}"
   164	    if st in STATUSES[:2]:
   165	        g = rec.get("round1_gate")
   166	        if not (identical(rec) or (smoke and g == SMOKE_GATE)):
   167	            return "a continued winner without its own identical round-1 comparison"
   168	        if isinstance(g, dict) and not (_knobs_ok(g.get("heldout_knobs")) and _finite([g.get("heldout_mean")])):
   169	            return "round-1 comparison without a finite round-1 winner"
   170	        h = rec.get("heldout")
   171	        if not (_valid_held(h, seeds) and _knobs_ok(h.get("knobs"))):
   172	            return "held-out result missing, nonfinite, on other seeds or with a zero normalizer"
   173	        if x := _rounds_problem(rec, max_rounds):
   174	            return x
   175	    return None
   176	
   177	
   178	def _set_aside(cdir: Path, dest: Path) -> None:
   179	    """Move a record that will be rerun out of the way (no deletion), so that a lost worker shows as a missing record and
   180	    is never masked by the old one (review rep-impl-r2)."""
   181	    if dest.exists():
   182	        sup = cdir / "superseded"; sup.mkdir(parents=True, exist_ok=True)
   183	        n = len(list(sup.glob(dest.stem + ".*.json")))
   184	        dest.rename(sup / f"{dest.stem}.{n}.json")
   185	
   186	
   187	def _mismatch(rec) -> bool:
   188	    """A measured round 1 that differs from the doubling record at all. A cell refused before round 1 ("not run") or a
   189	    smoke run ("not compared") measured nothing."""
   190	    if rec is None:
   191	        return False
   192	    if str(rec.get("status", "")).startswith("stopped: round 1"):
   193	        return True
   194	    return isinstance(rec.get("round1_gate"), dict) and not identical(rec)
