def cma_seeds(k: int, restarts: int) -> set:
    s = round_seed(k, restarts) + restarts                     # continue_search passes seed + restarts to cma_search
    return set(range(s + 1, s + 1 + restarts))                 # cma_search uses seed + 1 + r


