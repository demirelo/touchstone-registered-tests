   278	
   279	def _valid_held(h, seeds) -> bool:
   280	    """Finite per-seed values on the ordered seeds, and a positive normalizer S* on every seed (terms_of divides by it;
   281	    review rep-impl-r3)."""
   282	    return isinstance(h, dict) and list(h.get("seeds") or []) == list(seeds) and \
   283	        all(_finite(h.get(f)) and len(h[f]) == len(seeds) for f in FIELDS) and all(x > 0 for x in h["sstar"])
   284	
   285	
   286	def _deps_problem(d: Path, rec: dict, want: set) -> str | None:
   287	    import revision_v2 as R
   288	    from sim.records_v2 import sha_file
   289	    up = rec.get("upstream")
   290	    if not isinstance(up, dict) or set(up) != set(want):
   291	        return "dependency set differs"
   292	    for u, h in up.items():
   293	        q = R.path_of(d, u)
   294	        if not q.is_file() or sha_file(q) != h:
   295	            return f"dependency hash differs: {u}"
   296	    return None
   297	
   298	
   299	def base_problem(d: Path, job: dict, ev, db) -> str | None:
   300	    """The evaluation and doubling records of one cell (plan section 4; review rep-impl-r2): stage, id, provenance, finite
   301	    values on the job's ordered evaluation seeds; the evaluation depends exactly on the context's freeze, the rule's
   302	    reference and the cell's search, the doubling on those and the reference's menu, every hash equal to the file in
   303	    the rate directory; the doubling is a profit record with finite changes, a held-out winner with finite knobs, and
   304	    its flag equals the frozen rule (revision_v2.doubling_report)."""
   305	    import revision_v2 as R
   306	    seeds = job["mkt"]["seeds_eval"]; ctx = job["context"]
   307	    fz, rid = f"freeze/{ctx}", f"reference/{ctx}/{job['rule']}"
   308	    if ev is None:
   309	        return "no evaluation record"
   310	    if ev.get("stage") != "evaluate" or ev.get("id") != job["id"] or ev.get("provenance") != job["provenance"]:
   311	        return "evaluation record of another stage, cell or run"
   312	    if not _valid_held(ev, seeds):
   313	        return "evaluation values nonfinite or on other seeds"
   314	    if x := _deps_problem(d, ev, {fz, rid, job["id"]}):
   315	        return "evaluation: " + x
   316	    if db is None:
   317	        return "no doubling record"
   318	    if db.get("stage") != "doubling" or db.get("id") != job["id"] or db.get("provenance") != job["provenance"] or db.get("kind") != "profit":
   319	        return "doubling record of another stage, cell, run or kind"
   320	    ch = [db.get("attack_change"), db.get("reference_change")]
   321	    if not _finite(ch) or not isinstance(db.get("incomplete"), bool):
   322	        return "doubling changes nonfinite or flag missing"
   323	    if db["incomplete"] != any(c >= R.THRESHOLD - 1e-12 for c in ch):
   324	        return "doubling flag differs from its changes"
   325	    h = db.get("heldout")
   326	    if not _valid_held(h, seeds) or not _knobs_ok(h.get("knobs")):
   327	        return "doubling held-out result missing, nonfinite or on other seeds"
   328	    ref = read_record(R.path_of(d, rid))
   329	    if ref is None or not isinstance(ref.get("upstream"), dict):
   330	        return "no reference record"
   331	    if x := _deps_problem(d, db, set(ref["upstream"]) | {fz, rid, job["id"]}):
   332	        return "doubling: " + x
   333	    return None
   334	
   335	
   336	def _n_bins() -> int:
   337	    from churn_v2 import AGE_EDGES
   338	    return len(AGE_EDGES) - 1
   339	
   340	
   341	def _shares_ok(sh, n_episodes: int) -> bool:
   342	    """Newcomer audit counts (churn_v2.newcomer_shares): one episode per evaluation seed, each with the prescribed number
   343	    of age bins of [served, audited], finite and nonnegative, audited at most served (review rep-impl-r3)."""
   344	    per = (sh or {}).get("per_episode") if isinstance(sh, dict) else None
   345	    if not isinstance(per, list) or len(per) != n_episodes:
   346	        return False
   347	    nb = _n_bins()
   348	    for e in per:
   349	        f = e.get("focal") if isinstance(e, dict) else None
   350	        if not isinstance(f, list) or len(f) != nb:
   351	            return False
   352	        for b in f:
   353	            if not (isinstance(b, list) and len(b) == 2 and _finite(b) and 0 <= b[1] <= b[0]):
   354	                return False
   355	    return True
   356	
   357	
   358	def diag_ok(row, seeds, knobs) -> bool:
   359	    """A diagnostics row (frozen: diagnostics.json cells[...]["base"]; continued: its own record) for this winner: its
   360	    knobs, the job's ordered evaluation seeds, finite per-seed profits and well-formed audit counts (review rep-impl-r2)."""
   361	    return isinstance(row, dict) and row.get("knobs") == knobs and list(row.get("seeds") or []) == list(seeds) and \
   362	        _finite(row.get("normalized")) and len(row["normalized"]) == len(seeds) and _shares_ok(row.get("shares"), len(seeds))
   363	
