def place_heldout(status: str, held: dict) -> dict:
    """A cost-stopped cell keeps its frozen estimate as primary; its partial result goes to a separate field."""
    return {"partial": held} if status == "stopped at the cost cap" else {"heldout": held}


def check_rounds(max_rounds: int, gate: bool, nesting: list) -> None:
    if not gate and nesting and max_rounds < 2:
        _refuse("--max-rounds must be at least 2 for a continuation run with nesting cells")


def deps_for(report, posthoc, registered_doubling, embedded) -> dict:
    """What a result depends on besides its inputs and driver: helpers, plan, report, posthoc, the registered doubling
    record of the cell, and the embedded doubled D2+H3 incumbent (nesting cells)."""
    h = lambda p: sha_file(p) if p is not None and Path(p).exists() else None
    return {"reset_followup_v2.py": h(HERE.parent / "followup" / "reset_followup_v2.py"), "guards.py": h(HERE / "guards.py"), "common.py": h(HERE / "common.py"),
            "plan": h(HERE / "convergence-plan.md"), "report": h(report), "posthoc": h(posthoc), "registered_doubling": h(registered_doubling),
            "embedded_incumbent": G.sha_json(embedded) if embedded is not None else None}


def round1_agrees(r1: dict, registered: dict, tol: float = 1e-9) -> bool:
    return all(abs(r1[k] - registered[k]) <= tol for k in ("attack_change", "reference_change"))


def job_for(rid: str, root: str, cfgs: dict, params: dict, salt: str, smoke: bool) -> dict:
    ctx, rule, fam, _ = rid.split("|"); label = ctx.split("@")[0]
    mkt = R.market(label, root, 0.2, smoke=smoke, cfg=cfgs.get(label), salt_sha256=salt)
    return R.job(mkt, rule, fam, "profit", smoke=smoke, params=params)


def cell_inputs(src, job: dict) -> dict:
    need = F.inputs(src, [job]); p = R.path_of(src, job["id"])
    fr = read(R.path_of(src, f"freeze/{job['context']}"))
    if job["id"] not in fr["records"] or fr["records"][job["id"]] != sha_file(p):
        _refuse(f"{job['id']}: its search record differs from the original freeze")
    need[job["id"]] = fr["records"][job["id"]]
    for u, s in (read(p).get("upstream") or {}).items():
        if need.setdefault(u, s) != s:
            _refuse(f"{u}: two original records hold different hashes")
    return need


"""Churn-aware continuation adapter (replication-plan.md, section 4; review r1 blocker). `convergence_v2.run_cell` imports
`sim.reference.select_reference` at call time, so `churn_v2.install()` (which wraps only `revision_v2.select_reference`)
does not reach it, and frozen menu candidates would keep their no-churn training scores. install_continuation() installs
churn and wraps the sim.reference function the same way: under churn every candidate except abstain is replayed.
Call it in the parent and in every worker (pool initializer) before run_cell."""
import sys
from dataclasses import replace
from pathlib import Path

HERE = Path(__file__).resolve().parent
for p in (HERE.parent / "churn", HERE.parent / "followup2"):
    if str(p) not in sys.path:
        sys.path.insert(0, str(p))


def install_continuation() -> None:
    import churn_v2
    import sim.reference as SR
    churn_v2.install()
    if getattr(SR, "_rep_wrapped", False):
        return
    orig = SR.select_reference

    def select_reference(cell, candidates, cache):
        if cell.others:
            candidates = [c if c.name == "abstain" else replace(c, known_profit=None, known_normalized=None) for c in candidates]
        return orig(cell, candidates, cache)

    SR.select_reference = select_reference
    SR._rep_wrapped = True
def test_continued_diagnostics_use_the_continuation_worker_count(monkeypatch, tmp_path):
    # review rep-impl-r3 (Sol 6, Astra 6): the launcher's restart lowers only --workers-cont, so the diagnostics pool must
    # follow it; with --workers-eval 9 and --workers-cont 3 the diagnostics run on 3 workers
    import types
    import rep_collect as C
    got = {}
    monkeypatch.setattr(D, "_context", lambda a: types.SimpleNamespace())
    monkeypatch.setitem(sys.modules, "churn_v2", types.SimpleNamespace(install=lambda: None))
    monkeypatch.setattr(D, "_jobs_by_dir", lambda c, smoke: {})
    monkeypatch.setattr(C, "flagged_cells", lambda base, jobs: [])
    monkeypatch.setattr(D, "continuation_queue", lambda q: q)
    monkeypatch.setattr(D, "gate_item", lambda jobs, out: {"id": "g"})
    monkeypatch.setattr(C, "run_queue", lambda *a, **k: {"exit": 0})
    monkeypatch.setattr(C, "run_diagnostics", lambda base, jobs, w, smoke=False: got.setdefault("w", w) and {"exit": 0})
    a = types.SimpleNamespace(out=str(tmp_path), smoke=True, workers_cont=3, workers_eval=9, peak_cont=1e9)
    assert D.stage_continue(a) == 0 and got["w"] == 3
