    monkeypatch.setattr(D, "run_cells", _pool(calls, {"c0": {"status": "odd"}}))
    D.run_queue(q, tmp_path, 1, gate=_gate())
    monkeypatch.setattr(D, "run_cells", _pool(calls))
    with pytest.raises(SystemExit):
