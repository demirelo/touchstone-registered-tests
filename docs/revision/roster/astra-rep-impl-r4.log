   410	
   411	def collect(base: Path, jobs_by_dir: dict, gate: dict | None, smoke: bool = False) -> dict:
   412	    """Records for both winner sets (recs[rate][market][rule] with gains, attack and reference terms, efficiency and
   413	    seeds), R3's audit counts for both sets, and the winner counts. Every record is checked before use (review
   414	    rep-impl-r2): a cell whose evaluation or doubling record fails base_problem is unscorable (plan section 4); a frozen
   415	    diagnostics row that fails diag_ok gives no audit count. Only flagged cells look at a continuation record; a flagged
   416	    cell without one is "not continued". The primary set is unavailable after a round-1 mismatch in any continuation
   417	    record or without this run's identical gate record (also when no cell is flagged). A flagged cell whose continuation
   418	    record fails cont_problem keeps its validated frozen winner and counts as not continued (plan section 4; review
   419	    rep-impl-r3). A frozen R3 audit count needs diagnostics bound to this job, rate and run (diag_bound) and complete
   420	    (diag_ok); a continued R3 winner's audit count needs its checked continued diagnostics."""
   421	    import convergence_v2  # noqa: F401
   422	    import revision_v2 as R
   423	    base = Path(base); cdir = base / "continuation"
   424	    allrec = [read_record(q) for q in sorted(cdir.glob("*.json")) + sorted((cdir / "gate").glob("*.json")) if q.name != "lost_cells.json"]
   425	    mismatch = any(_mismatch(r) for r in allrec)
   426	    g = read_record(cdir / "gate" / (R._safe(gate["id"]) + ".json")) if gate else None
   427	    gate_ok = g is not None and cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1) is None and \
   428	        g.get("status") in STATUSES[:2] and (identical(g) or (smoke and g.get("round1_gate") == SMOKE_GATE))
   429	    frozen, primary, problems, unscorable = {}, {}, [], []
   430	    counts = {"frozen": 0, "continued": 0, "unresolved": 0, "stopped": 0, "not continued": 0}
   431	    audit = {"frozen": {}, "primary": {}}
   432	    for (kind, p), jobs in jobs_by_dir.items():
   433	        rk = "0" if p == 0 else f"{p:g}"; d = base / f"{kind}-p{p:g}"
   434	        diag = (read_record(d / "diagnostics.json") or {}).get("cells") or {} if kind == "menu" else {}
   435	        for j in jobs:
   436	            m, r = j["mkt"]["label"].replace("fresh", "rep"), analysis_rule(kind, j["rule"])
   437	            ev = read_record(R.eval_path(d, j["id"])); db = read_record(d / "doubling" / (R._safe(j["id"]) + ".json"))
   438	            seeds = j["mkt"]["seeds_eval"]
   439	            if (why := base_problem(d, j, ev, db)) is not None:
   440	                unscorable.append(f"{kind}-p{p:g}|{j['id']}: {why}"); continue
   441	            n = _n_agents(j); fz = terms_of(ev, n)
   442	            frozen.setdefault(rk, {}).setdefault(m, {})[r] = fz
   443	            fa = None
   444	            if r == "R3" and kind == "menu":
   445	                ck = f"{j['context']}|{j['rule']}"
   446	                row = (diag.get(ck) or {}).get("base")
   447	                sr = read_record(R.path_of(d, j["id"])) or {}
   448	                if diag_bound(d, kind, p, ck, j) and diag_ok(row, seeds, (sr.get("attack") or {}).get("best_knobs")):
   449	                    fa = _audit_of(row["shares"]); audit["frozen"].setdefault(rk, {})[m] = fa
   450	                elif ck in diag:
   451	                    problems.append(f"{kind}-p{p:g}|{j['id']}: frozen diagnostics fail their checks")
   452	            win, kw, crec = fz, "frozen", None
   453	            key = _key(kind, p, j["id"])
   454	            if db["incomplete"]:
   455	                crec = read_record(cdir / (R._safe(key) + ".json"))
   456	                if crec is None:
   457	                    kw = "not continued"
   458	                elif (why := cont_problem(crec, key, j, smoke)) is not None:     # plan section 4: invalid output keeps
   459	                    problems.append(f"{key}: {why}"); kw = "not continued"     # the validated frozen winner
   460	                else:
   461	                    try:
   462	                        _, kw = select_winner(fz["gain"], crec)
   463	                    except Round1Mismatch:
   464	                        kw = "frozen"
   465	                    if kw in ("continued", "unresolved"):
   466	                        win = terms_of(crec["heldout"], n)
   467	            counts[kw] += 1
   468	            primary.setdefault(rk, {}).setdefault(m, {})[r] = win
   469	            if r == "R3" and kind == "menu" and fa is not None:
   470	                if kw in ("continued", "unresolved"):
   471	                    cd = read_record(cdir / "diagnostics" / (R._safe(key) + ".json"))
   472	                    if cont_diag_ok(cd, key, j, crec["heldout"]["knobs"]):
   473	                        audit["primary"].setdefault(rk, {})[m] = _audit_of(cd["shares"])
   474	                    elif cd is not None:
   475	                        problems.append(f"{key}: continued diagnostics fail their checks")
   476	                else:
   477	                    audit["primary"].setdefault(rk, {})[m] = fa
   478	    if not gate_ok:
   479	        problems.append("no identical gate record of this run's gate cell")
   480	    bad = mismatch or not gate_ok
   481	    return {"frozen": frozen, "primary": None if bad else primary, "audit": audit, "counts": counts,
   482	            "round1_mismatch": mismatch, "gate_ok": gate_ok, "problems": problems, "unscorable": unscorable}
   483	
   484	
   485	def _diag_cont(job: dict, knobs: dict) -> dict:
   486	    """In a worker: the churn arm's diagnostic run (churn_v2._diag_one) for a continued winner's knobs on the evaluation
   487	    seeds under the cell's churn: per-seed normalised profits and newcomer audit counts (plan section 3, expectation 5
   488	    on the primary winners)."""
   489	    import churn_v2
