   168	                        delta[m] = absolute[m] - (b["0"][comp] - b["0"]["R3"])
   169	            row = {"absolute_markets": {m: {"ci95": _ci(v)} for m, v in absolute.items()},
   170	                   "absolute_pooled": {"ci95": _ci(sum(absolute.values()) / len(MARKETS))} if len(absolute) == len(MARKETS) else None}
   171	            if p != "0":
