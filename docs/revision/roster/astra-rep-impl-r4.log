   397	
   398	def terms_of(h: dict, n: int) -> dict:
   399	    """Per seed: gain = attack term - reference term, each normalised by S*/N (sim/reference.evaluate_gain)."""
   400	    sc = [x / n for x in h["sstar"]]
   401	    return {"gain": list(h["gain"]), "attack": [a / s for a, s in zip(h["profit_attack"], sc)],
   402	            "reference": [r / s for r, s in zip(h["profit_ref"], sc)], "eff_attack": list(h["eff_attack"]), "seeds": list(h["seeds"])}
   403	
   404	
   405	def _audit_of(shares: dict) -> tuple:
   406	    per = shares["per_episode"]
   407	    fo = [sum(e["focal"][b][i] for e in per for b in range(len(e["focal"]))) for i in (0, 1)]
   408	    return fo[1], fo[0]                                                   # (audited, served)
