   367	
   368	def diagnostics_binding(d: Path, kind: str, p: float, jobs: list) -> dict:
   369	    """Written by rep_v2's rate stage right after the diagnostics step and before the inventory (review rep-impl-r3): the
   370	    sha256 of diagnostics.json, the rate, and per cell the job id, its provenance (this run's commit, draw and salt) and
   371	    the hashes of the search and doubling records whose winners the diagnostics reran."""
   372	    import revision_v2 as R
   373	    from sim.records_v2 import sha_file
   374	    d = Path(d); h = lambda q: sha_file(q) if q.is_file() else None
   375	    return {"stage": "diagnostics binding", "kind": kind, "rate": float(p), "diagnostics": h(d / "diagnostics.json"),
   376	            "cells": {f"{j['context']}|{j['rule']}": {"id": j["id"], "provenance": j["provenance"], "search": h(R.path_of(d, j["id"])),
   377	                                                       "doubling": h(d / "doubling" / (R._safe(j["id"]) + ".json"))} for j in jobs}}
   378	
   379	
   380	def diag_bound(d: Path, kind: str, p: float, ck: str, job: dict) -> bool:
   381	    """The frozen diagnostics of cell `ck` belong to this job, rate and run: the binding names this rate, the current
   382	    diagnostics.json, this job's id and provenance, and the current search and doubling records."""
   383	    import revision_v2 as R
   384	    from sim.records_v2 import sha_file
   385	    b = read_record(Path(d) / BINDING); c = ((b or {}).get("cells") or {}).get(ck)
   386	    q = Path(d) / "diagnostics.json"
   387	    return isinstance(c, dict) and b.get("stage") == "diagnostics binding" and b.get("kind") == kind and b.get("rate") == float(p) and \
   388	        q.is_file() and b.get("diagnostics") == sha_file(q) and c.get("id") == job["id"] and c.get("provenance") == job["provenance"] and \
   389	        R.path_of(d, job["id"]).is_file() and c.get("search") == sha_file(R.path_of(d, job["id"])) and \
   390	        c.get("doubling") == sha_file(Path(d) / "doubling" / (R._safe(job["id"]) + ".json"))
   391	
   392	
   393	def cont_diag_ok(rec, key: str, job: dict, knobs) -> bool:
   394	    return isinstance(rec, dict) and rec.get("stage") == "continued diagnostics" and rec.get("id") == key and \
   395	        rec.get("provenance") == job["provenance"] and diag_ok(rec, job["mkt"]["seeds_eval"], knobs)
