    jobs, gate, a5, key = _diag_setup(tmp_path)
    rec = {"stage": "continued diagnostics", "id": key, "provenance": a5["provenance"], "knobs": {"u0": 3.0, "x": 2},
           "seeds": [11, 12], "normalized": [0.1, 0.2], "shares": _sh(100, 5)}
