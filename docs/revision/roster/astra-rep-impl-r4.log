   197	DIAG_HOURS = 60.0 * 1.33 / 3600     # one continued winner's diagnostics (stage_continue's admission: 60 s per cell at p > 0)
   198	
   199	
   200	def _lost(cdir: Path, ids: list, hours: dict, max_rounds: int) -> None:
   201	    from convergence_v2 import restart_hours
   202	    write_record(cdir / "lost_cells.json", {"lost": ids, "restart_hours": restart_hours([hours[k] * max_rounds for k in ids])})
   203	
   204	
   205	def run_queue(queue: list, base: Path, workers: int, cost=None, max_rounds: int = 3, gate: dict | None = None,
   206	              smoke: bool = False) -> dict:
   207	    """The nonzero-churn gate first, then the flagged cells, every cell in a child process that saves its own record
   208	    (Run B's pool). The gate is the first p = 0.05 cell whether flagged or not (plan section 5); it runs round 1 only and
   209	    its record (continuation/gate/) never enters a result. Exit codes: 4 a round-1 mismatch anywhere, measured or saved
   210	    (no restart); 6 a cell error; 5 a lost worker (lost_cells.json holds the restart estimate); 3 a cost stop (a
   211	    cost-refused gate stops before the queue); 0 otherwise. A resume reuses this run's completed records and reruns only
   212	    cost-stopped ones."""
   213	    import convergence_v2  # noqa: F401  (first: it puts scripts/ on the path)
   214	    import revision_v2 as R
   215	    if gate is None:
   216	        raise SystemExit("replication refused: the continuation needs its gate cell (the first p = 0.05 cell)")
   217	    cdir = Path(base) / "continuation"; cdir.mkdir(parents=True, exist_ok=True)
   218	    gdest = cdir / "gate" / (R._safe(gate["id"]) + ".json")
   219	    dest = lambda c: cdir / (R._safe(c["id"]) + ".json")
   220	    items = [(gate, gdest)] + [(c, dest(c)) for c in queue]
   221	    saved = {d: read_record(d) for _, d in items}
   222	    other = [c["id"] for c, d in items if saved[d] is not None and saved[d].get("provenance") != c["job"].get("provenance")]
   223	    if other:                                                            # plan section 5: reuse only this run's records
   224	        raise SystemExit(f"replication refused: saved continuation records of another job or run: {other[:3]}")
   225	    if any(_mismatch(r) for r in saved.values()):
   226	        return {"run": 0, "exit": 4, "gate": "round-1 mismatch on record: continuation stays stopped"}   # also on resume (plan section 4)
   227	    bad = [(c["id"], saved[d].get("status")) for c, d in items if saved[d] is not None and saved[d].get("status") not in STATUSES]
   228	    if bad:                                                              # review rep-impl-r2: no reuse of an unknown record
   229	        raise SystemExit(f"replication refused: saved continuation records with an unknown status: {bad[:3]}")
   230	    hours = {c["id"]: round_hours(c["job"]) for c, _ in items}
   231	    # review rep-impl-r3: a saved record is reused only if it passes the same checks collect applies; any other record
   232	    # (incomplete, malformed, nonfinite) means "no passing record" and its cell is rerun (plan section 4: a resume
   233	    # continues from the first cell without a passing record); the old record is set aside, never deleted
   234	    invalid = lambda c, d, mr: saved[d] is not None and not cost_stopped(saved[d]) and cont_problem(saved[d], c["id"], c["job"], smoke, mr) is not None
   235	    rerun = lambda c, d, mr: saved[d] is None or cost_stopped(saved[d]) or invalid(c, d, mr)
   236	    run = 0
   237	    if rerun(gate, gdest, 1):
   238	        _set_aside(cdir, gdest)
   239	        lost, failed = run_cells(_cont_one, [gate], [(gate["job"], gate["dir"], 1, cost, hours[gate["id"]])], 1, [gdest],
   240	                                 [{"id": gate["id"], "gate": True}])
   241	        run += 1
   242	        if failed:
   243	            return {"run": run, "failed": failed, "exit": 6, "gate": "the gate cell raised an error"}
   244	        if lost:
   245	            _lost(cdir, lost, hours, 1)
   246	            return {"run": run, "lost": lost, "exit": 5, "gate": "the gate cell's worker was lost"}
   247	    g = read_record(gdest)
   248	    if _mismatch(g):
   249	        return {"run": run, "exit": 4, "gate": "round-1 mismatch at the gate: continuation stopped"}
   250	    if cost_stopped(g):
   251	        return {"run": run, "exit": 3, "gate": "the gate cell was refused at the cost cap: no further cell started"}
   252	    if not smoke and not identical(g):                                   # the gate must prove identity, not just not fail
   253	        return {"run": run, "exit": 4, "gate": "the gate has no identical round-1 comparison: continuation stopped"}
   254	    if (why := cont_problem(g, gate["id"], gate["job"], smoke, max_rounds=1)) is not None:
   255	        return {"run": run, "exit": 6, "gate": f"the gate record fails its checks: {why}"}
   256	    todo = [c for c in queue if rerun(c, dest(c), max_rounds)]          # same order; completed, valid cells reused
   257	    for c in todo:
   258	        _set_aside(cdir, dest(c))
   259	    lost, failed = ([], {}) if not todo else run_cells(
   260	        _cont_one, todo, [(c["job"], c["dir"], max_rounds, cost, hours[c["id"]]) for c in todo], workers,   # module-level fn
   261	        [dest(c) for c in todo], [{"id": c["id"]} for c in todo])
   262	    recs = [read_record(dest(c)) for c in todo]
   263	    mismatch = [c["id"] for c, r in zip(todo, recs) if _mismatch(r)]
   264	    stopped = [c["id"] for c, r in zip(todo, recs) if cost_stopped(r)]
   265	    if lost and not mismatch and not failed:
   266	        _lost(cdir, lost, hours, max_rounds)
   267	    code = 4 if mismatch else 6 if failed else 5 if lost else 3 if stopped else 0
   268	    return {"run": run + len(todo), "lost": lost, "failed": failed, "mismatch": mismatch, "stopped": stopped, "exit": code}
   269	
