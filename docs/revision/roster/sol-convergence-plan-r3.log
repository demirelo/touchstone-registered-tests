   179	def run_cell(job: dict, out, max_rounds: int = MAX_ROUNDS, src=None, cost: tuple | None = None, round_hours: float = 0.0,
   180	             embedded: dict | None = None, min_rounds: int = 1) -> dict:
   181	    from sim.cell import SeedCache
   182	    from sim.locked import load_locked
   183	    from sim.records import search_from_json
   184	    from sim.reference import reference_candidates, select_reference
   185	    from sim.search import Objective, cma_search
   186	    T, L = R.constants(job); fam = R.family_for(job["family"], T, L); cell = R.train_cell(job); st = R.settings(job); cache = SeedCache()
   187	    rec = read(R.path_of(out, job["id"])); prev = search_from_json(rec["attack"]); twin = search_from_json(rec["twin"])
   188	    frozen_ref, rrec, _ = R.reference_of(job, out); prev_ref = float(np.mean(rrec["per_seed_normalized"]))
   189	    cands, _, _ = R.menu(job, out, CUTS, H4_EXCLUDED); order = tuple(load_locked()["reference_order"])
   190	    stopper = G.CostStop(*cost) if cost else None
   191	    emb = R.embed_h3(embedded, T) if embedded is not None else None
   192	    rounds, gate, outcome = [], None, "round cap"
   193	    if stopper and not stopper.allow("round 1", round_hours):           # admission before the cell's first round
   194	        return {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": [],
   195	                "status": "stopped at the cost cap", "passed_round": None, "round1_gate": "not run", "claim": CLAIM, "cost": stopper.report()}
   196	    for k in range(1, max_rounds + 1):
   197	        obj = Objective(cell, fam, cache); obj.archive.update(prev.archive)     # revision_v2.continue_search, with the round's incumbents
   198	        new = cma_search(obj, fam, st, round_seed(k, st.restarts) + st.restarts, incumbents=round_incumbents(k, prev.best_knobs, emb))
   199	        best = new if new.best_f > prev.best_f else replace(new, best_x=prev.best_x, best_knobs=prev.best_knobs, best_f=prev.best_f, best_source=prev.best_source)
   200	        extra = reference_candidates(cell, fam, best, twin, [], order)
   201	        ref = select_reference(cell, cands + [c for c in extra if c.knobs is not None], cache); ref_f = float(np.mean(ref.per_seed_normalized))
   202	        rounds.append({"round": k, "restarts_total": st.restarts * (k + 1), "cma_seeds": sorted(cma_seeds(k, st.restarts)), "attack_f": float(best.best_f),
   203	                       "attack_change": float(best.best_f - prev.best_f), "reference_f": ref_f, "reference_change": ref_f - prev_ref,
   204	                       "best_knobs": dict(best.best_knobs), "best_source": best.best_source})
   205	        if k == 1 and src is not None:                          # the registered doubling's held-out winner is round 1's search winner
   206	            reg = read(Path(src) / "doubling" / (R._safe(job["id"]) + ".json"))
   207	            h1 = R.gain_fields(R.eval_cell(job), fam, new.best_knobs, frozen_ref, SeedCache())
   208	            r1 = {**rounds[0], "heldout": {"knobs": dict(new.best_knobs), "seeds": list(R.eval_cell(job).seeds), "gain": h1["gain"]}}
   209	            gate = compare_round1(reg, r1) if reg is not None else {"pass": False, "problems": ["no registered doubling record"]}
   210	        prev, prev_ref = best, ref_f
   211	        outcome = decide(k, rounds[-1], gate, stopper.allow(f"round {k + 1}", round_hours) if stopper else True, max_rounds, min_rounds)
   212	        if outcome != "continue":
   213	            break
   214	    status = {"passed": "passed", "round cap": "not passed at the cap", "cost cap": "stopped at the cost cap",
   215	              "round-1 mismatch": "stopped: round 1 differs from the registered doubling"}[outcome]
   216	    res = {"stage": "convergence", "id": job["id"], "provenance": job["provenance"], "restarts": st.restarts, "rounds": rounds, "status": status,
   217	           "passed_round": passed_round(rounds), "round1_gate": gate if gate is not None else "not compared (smoke)", "claim": CLAIM,
   218	           "frozen_best_f": float(rec["attack"]["best_f"]), "embedded_doubled_d2h3": emb is not None, "min_rounds": min_rounds,
   219	           "cost": stopper.report() if stopper else None}
   220	    if outcome != "round-1 mismatch":
   221	        held = R.gain_fields(R.eval_cell(job), fam, prev.best_knobs, frozen_ref, SeedCache())
   222	        res["heldout"] = {"knobs": dict(prev.best_knobs), "seeds": list(R.eval_cell(job).seeds), **held}
   223	    return res
