    79	def test_gate_evidence_needs_both_cells_from_the_mac_and_this_machine(tmp_path):
    80	    here, mac = G.environment(), {"cpu": "Apple M3", "machine": "arm64"}
    81	    cells = {"a": {"inputs_sha": "i", "driver_sha": "d"}, "b": {"inputs_sha": "i", "driver_sha": "d"}}
    82	    ps = []
    83	    for c in cells:
    84	        for site, env in (("mac", mac), ("pod", here)):
    85	            p = tmp_path / f"{c}-{site}.json"; _gate(p, c, site, env); ps.append(p)
    86	    G.check_gate_evidence(ps, cells)
    87	    for drop in ps:                                                               # every one of the four is required
    88	        with pytest.raises(SystemExit, match="evidence"):
    89	            G.check_gate_evidence([p for p in ps if p != drop], cells)
    90	    write(tmp_path / "x.json", {"pass": True})                                    # an unrelated passing file does not count
    91	    with pytest.raises(SystemExit, match="evidence"):
    92	        G.check_gate_evidence([ps[0], tmp_path / "x.json"], cells)
    93	    for kw in ({"smoke": True}, {"inputs": "j"}, {"driver": "e"}, {"ok": False}):
    94	        q = tmp_path / "bad.json"; _gate(q, "a", "pod", here, **kw)
    95	        with pytest.raises(SystemExit, match="evidence"):
    96	            G.check_gate_evidence([q] + [p for p in ps if p.name != "a-pod.json"], cells)
    97	    q = tmp_path / "other-env.json"; _gate(q, "a", "pod", mac)                   # a pod record from another machine
    98	    with pytest.raises(SystemExit, match="evidence"):
    99	        G.check_gate_evidence([q] + [p for p in ps if p.name != "a-pod.json"], cells)
