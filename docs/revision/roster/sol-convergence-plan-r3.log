   110	def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, prior_usd: float, clock=time.time) -> CostStop:
   111	    """A paid run must state the pod allocation time and a positive rate; earlier failed attempts are counted."""
   112	    if started is None:
   113	        _refuse("a paid run needs --started-at (the pod allocation time)")
   114	    if not usd_per_hour > 0 or not cap_usd > 0:
   115	        _refuse("a paid run needs a positive rate and cap")
   116	    return CostStop(cap_usd, usd_per_hour, started, clock, prior_usd)
