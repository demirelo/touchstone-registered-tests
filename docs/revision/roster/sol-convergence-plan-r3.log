[project]
name = "touchstone"
version = "0.1.0"
description = "Audit-and-allocation rules for markets of adaptive agents: simulator"
requires-python = ">=3.12"
dependencies = ["numpy>=2.0", "scipy>=1.13", "cma>=4.0", "pyyaml>=6.0", "pandas>=2.2", "matplotlib>=3.9", "anthropic>=1.0", "typesafe-sdk>=0.3"]

[dependency-groups]
dev = ["pytest>=8.0"]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["sim"]

[tool.pytest.ini_options]
testpaths = ["tests"]
filterwarnings = ["ignore:Could not import matplotlib.pyplot:UserWarning"]   # cma plotting is not used
markers = ["slow: end-to-end smoke paths that take more than ten minutes; selected with --runslow"]

hook: PostToolUse
hook: PostToolUse Completed
hook: PreToolUse
