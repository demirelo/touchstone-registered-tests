   145	def decide(k: int, last: dict, gate: dict | None, cost_ok: bool, max_rounds: int = MAX_ROUNDS, min_rounds: int = 1) -> str:
   146	    """After round k: stop on a round-1 mismatch, on a pass (from round `min_rounds`), at the round cap, or (before the
   147	    next round) at the cost cap."""
   148	    if k == 1 and gate is not None and not gate["pass"]:
   149	        return "round-1 mismatch"
   150	    if k >= min_rounds and _passes(last):
   151	        return "passed"
   152	    if k >= max_rounds:
   153	        return "round cap"
   154	    return "continue" if cost_ok else "cost cap"
