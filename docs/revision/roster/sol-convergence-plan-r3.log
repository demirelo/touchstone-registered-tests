   226	def gate_cell(job: dict, out, src, site: str, bind: dict, cost: tuple | None = None, round_hours: float = 0.0) -> dict:
   227	    """Gate mode: round 1 only, compared with the registered doubling record; saved full-budget evidence bound to the
   228	    cell's inputs, this driver, the site, and the environment."""
   229	    r = run_cell(job, out, max_rounds=1, src=src, cost=cost, round_hours=round_hours)
   230	    ok = isinstance(r["round1_gate"], dict) and r["round1_gate"]["pass"] is True
   231	    return {"stage": "convergence gate", "cell": job["id"], "pass": bool(ok), "site": site, "comparison": r["round1_gate"],
   232	            "binding": bind, "environment": G.environment()}
