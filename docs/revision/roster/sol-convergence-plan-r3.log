   114	CLAIM = ("a cell that passes 'passed the registered incremental check within three rounds' (a capped search extension "
   115	         "of R restarts per round); this is not convergence, not optimality, and not a bound on the remaining search error")
   116	DEVIATIONS = ("continued searches of the 14 flagged profit cells and of the X7-SC cells with a nesting shortfall of at least 0.005, "
   117	              "beyond the registered doubling, up to three rounds of R restarts",
   118	              "from round 2 a nesting cell's X7-SC search also starts from the doubled D2+H3 winner embedded in X7-SC, and such a cell runs at least two rounds",
   119	              "the final winner is evaluated against the unchanged frozen reference; reselected references are diagnostics only",
   120	              "unflagged cells, frozen banks and X7-SC's original D2+H3 incumbents are unchanged; the 7 flagged coalition cells and "
   121	              "the unchecked fresh factorial cells are not in this run", "exploratory sensitivity after the report; the frozen estimates stay primary")
   122	KNOB_TOL, VAL_TOL = 1e-9, 1e-9
