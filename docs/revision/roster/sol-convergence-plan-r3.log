   102	def cell_inputs(src, job: dict) -> dict:
   103	    need = F.inputs(src, [job]); p = R.path_of(src, job["id"])
   104	    fr = read(R.path_of(src, f"freeze/{job['context']}"))
   105	    if job["id"] not in fr["records"] or fr["records"][job["id"]] != sha_file(p):
