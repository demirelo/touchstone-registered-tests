print(f"verify {d.name}: {len(recs)} records, {len(bad)} bad, {len(extra)} not inventoried"); sys.exit(1 if bad or extra or not recs else 0)
PYV
}
tmo() { perl -e 'alarm shift; exec @ARGV' "$@"; }
DONE=$P/$NAME.done; ATT=$P/$NAME.attempts
rm_ok() { [ -e "$1" ] && mv -- "$1" ~/.Trash/"$(basename "$1").$$"; true; }
# One launch per NAME: the lock is taken before any marker changes; the watchdog (the last process) releases it.
mkdir "$P/$NAME.launchlock" 2>/dev/null || { echo "LOCKED: $NAME.launchlock exists (another launch or its watchdog still runs; remove it only after checking)"; exit 1; }
unlock() { $PY podctl.py unlock $NAME >/dev/null 2>&1; }
# Spend records are never overwritten (r16): a launch is refused while the previous launch's spend is unrecorded; a
# recorded one (NAME.spent, written by podctl.py spend) is moved with its inputs to spend_records/NAME.<time>/.
spent_ok() { grep -Eq '^[0-9]+(\.[0-9]+)? USD ' "$P/$NAME.spent" 2>/dev/null; }   # a complete record only (r17)
if [ -e "$P/$NAME.bal0" ] && ! spent_ok; then echo "refused: the previous launch's spend is not recorded (podctl.py spend $NAME)"; unlock; exit 1; fi
if [ -e "$P/$NAME.spent" ] && ! spent_ok; then echo "refused: $NAME.spent is not a complete spend record"; unlock; exit 1; fi
if spent_ok; then
  arch="$P/spend_records/$NAME.$(date +%s)"; mkdir -p "$arch" || { echo "refused: cannot archive the spend record"; unlock; exit 1; }
  for f in bal0 wdend spent attempts; do [ -e "$P/$NAME.$f" ] && { mv -- "$P/$NAME.$f" "$arch/" || { echo "refused: cannot archive $NAME.$f"; unlock; exit 1; }; }; done
fi
for f in "$DONE" "$P/$NAME.blocked" "$P/$NAME.request" "$P/$NAME.wdend" "$P/$NAME.ambiguous" "$P/$NAME.acct" "$P/$NAME.unpriced"; do rm_ok "$f"; done; : > "$ATT"
b0=$(tmo 90 $PY podctl.py balance) || { echo "refused: account balance unknown"; unlock; exit 1; }
echo "$b0" > "$P/$NAME.bal0" && [ -s "$P/$NAME.bal0" ] || { echo "refused: cannot write $NAME.bal0"; unlock; exit 1; }
id=""; state="NOT STARTED"; rc=1; cph=0; a0=0; tfirst=0; unresolved=""; started=""; req=0; wd=""
# Pod safety lives in podctl.py (test_podctl.py): fail-closed listing, deletion verified within
# elapsed time, reconciliation, a creation block from the hard deadline, and a watchdog that runs on after this launcher
# exits, until no pod named $NAME remains.
cleanup() {
  trap - EXIT INT TERM
  if [ -n "$id" ] && [ -n "$started" ]; then
    try=0
    while :; do   # after RUN OK: keep the pod and retry until every directory verifies, or until 2 min before the hard deadline
      try=$((try+1)); ok=1
      for d in $OUTS; do
        t=1800
        rem=$(( hard - 120 - $(date +%s) )); [ $rem -le 0 ] && { ok=0; break; }; [ $rem -lt $t ] && t=$rem
        tmo $t $PY runpod.py pull $id "/root/touchstone/results/v2/$d/" "$LOUT/$d/" >/dev/null 2>&1 || ok=0
      done
      rem=$(( hard - 120 - $(date +%s) )); [ $rem -gt 0 ] && tmo $(( rem < 300 ? rem : 300 )) $PY runpod.py pull $id /root/touchstone/results/logs/ $LOGD/ >/dev/null 2>&1
      if [ "$state" = "RUN OK" ] && [ $ok = 1 ]; then for d in $OUTS; do verify "$LOUT/$d" || ok=0; done; fi
      [ $ok = 1 ] && break
      echo "$(date +%H:%M) pull or verification failed (try $try)"
      if [ "$state" = "RUN OK" ]; then [ "$(date +%s)" -ge $(( hard - 120 )) ] && break; else [ $try -ge 3 ] && break; fi
      sleep 60
    done
    [ $ok = 1 ] || { [ "$state" = "RUN OK" ] && state="RUN OK BUT RECORDS NOT VERIFIED"; rc=1; }
  fi
  if [ -n "$id" ]; then
    if $PY podctl.py delete $id 1800; then echo "$(date +%H:%M) $id deleted (verified)"; echo "$id $(date +%s) deleted" >> "$ATT"; else echo "$(date +%H:%M) $id: deletion not verified in 30 min; the watchdog keeps trying (billing may continue)"; rc=1; unresolved=1; fi
  fi
  $PY podctl.py reconcile $NAME || { echo "$(date +%H:%M) reconcile failed; the watchdog keeps trying"; rc=1; unresolved=1; }
  grep -qx pending "$P/$NAME.request" 2>/dev/null && { echo "$(date +%H:%M) a creation request is outstanding or ambiguous; the watchdog settles for 30 minutes"; unresolved=1; }
  touch "$DONE"     # the watchdog then deletes any orphan pod and exits only after its settle time of empty listings
  if [ -z "$wd" ] || ! kill -0 "$wd" 2>/dev/null; then
    echo "$(date +%H:%M) WATCHDOG NOT RUNNING"; rc=1
    if [ $req = 0 ]; then unlock; else unresolved=1; echo "$(date +%H:%M) $NAME.launchlock kept: no process deletes a late pod; check the Runpod console"; fi
  fi
  if [ "$req" = 0 ] && [ -e "$P/$NAME.bal0" ]; then   # no request was sent: nothing to record; keep the baseline as unused
    mkdir -p "$P/spend_records" && mv -- "$P/$NAME.bal0" "$P/spend_records/$NAME.$(date +%s).bal0.unused"
  fi
  [ "$tfirst" -gt 0 ] && echo "$(date +%H:%M) spend estimate so far (not a record): $(( $(date +%s) - tfirst ))s at the ceiling $MAXCPH USD/h = $($PY -c "import math; print(math.ceil(($(date +%s)-$tfirst)/3600*float('$MAXCPH')*1000)/1000)") USD (pod events in $ATT)"
  [ "$req" -gt 0 ] && echo "$(date +%H:%M) record the spend with: podctl.py spend $NAME (at least 1 h after the watchdog ends; $LOGD/watchdog.log), then budget_v2.py --record with a tag starting $RUNTAG-"
  [ -n "$unresolved" ] && { echo "$(date +%H:%M) UNRESOLVED: check the Runpod console the next day before any relaunch"; rc=1; }
  echo "$(date +%H:%M) end: $state"
  exit $rc
}
trap cleanup EXIT INT TERM
# Deadlines from the first creation request at the price ceiling MAXCPH (a bound across attempts), less PRIOR: the
# soft deadline leaves CAP - PRIOR, the hard deadline HARD x CAP - PRIOR (churn r1 review).
t0=$(date +%s); soft=$(( t0 + $($PY -c "print(int(3600*(float('$CAP')-float('$PRIOR'))/float('$MAXCPH')))") )); hard=$(( t0 + $($PY -c "print(int(3600*(float('$CAP')*float('$HARD')-float('$PRIOR'))/float('$MAXCPH')))") ))
nohup $PY podctl.py watchdog $NAME $hard "$DONE" >> $LOGD/watchdog.log 2>&1 &
wd=$!; echo $wd > "$P/$NAME.wdpid"; disown
sleep 1; kill -0 "$wd" 2>/dev/null || { state="WATCHDOG DID NOT START"; exit 1; }
# One creation request at a time (create_one.py, no hidden retries). Before EVERY request: reconciliation must succeed (no
# untracked pod), the watchdog must allow creation, and the soft deadline must be ahead. An unambiguous refusal (HTTP 4xx,
# e.g. no capacity) tries the next flavor. An AMBIGUOUS answer ends creation for this launch (r11): no further request,
# so two pods can never overlap. NAME.request is "pending" from before each request until a clear answer (r15), so a stop
# during creation also makes the watchdog delete a late pod and settle for 30 minutes.
tries=0
while [ $tries -lt 3 ] && [ $req -lt 36 ]; do
  kill -0 "$wd" 2>/dev/null || { state="WATCHDOG NOT RUNNING BEFORE REQUEST $((req+1))"; exit 1; }
  $PY podctl.py reconcile $NAME || { state="RECONCILE FAILED BEFORE REQUEST $((req+1))"; exit 1; }
  $PY podctl.py may-create $NAME $hard || { state="CREATION BLOCKED (hard deadline)"; exit 1; }
  [ "$(date +%s)" -lt "$soft" ] || { state="SOFT DEADLINE BEFORE START"; exit 1; }
  [ "$tfirst" -gt 0 ] || tfirst=$(date +%s)
  cph=0; id=""
  { echo pending > "$P/$NAME.request" && grep -qx pending "$P/$NAME.request"; } || { state="CANNOT WRITE $NAME.request BEFORE REQUEST $((req+1))"; exit 1; }
  req=$((req+1)); rq0=$(date +%s)   # billing may start with the request (churn r1 review): every charge counts from here
  out=$(tmo 120 $PY create_one.py $NAME $(( (req-1) % 12 )) 2>/dev/null | tail -n 1)
  id=$(echo "$out" | $PY -c 'import sys,json; print(json.loads(sys.stdin.read()).get("id",""))' 2>/dev/null)
  amb=$(echo "$out" | $PY -c 'import sys,json; d=json.loads(sys.stdin.read() or "{}"); print(1 if d.get("ambiguous", True) else 0)' 2>/dev/null || echo 1)
  if [ -z "$id" ]; then
    if [ "$amb" = 1 ]; then echo "$(date +%H:%M) ambiguous creation answer; no further request"; state="AMBIGUOUS CREATION ANSWER (no retry)"; exit 1; fi
    echo clear > "$P/$NAME.request"; continue
  fi
  echo clear > "$P/$NAME.request"
  v=16; a0=$rq0; echo "$id $rq0 start" >> "$ATT"
  # Only a finite positive price at or below the ceiling is accepted; otherwise (above, missing, null, zero, failed
  # listing, timeout) the pod is deleted at once, with no retrieval (r15); the balance difference records what it cost.
  cph=$(tmo 60 $PY podctl.py price $id 2>/dev/null) || cph=""
  if ! $PY -c "import sys; sys.exit(0 if 0<float(sys.argv[1])<=float(sys.argv[2]) else 1)" "${cph:-0}" "$MAXCPH" 2>/dev/null; then
    state="PRICE ${cph:-unknown} NOT IN (0, $MAXCPH]"; echo "$(date +%H:%M) $id: $state; deleting"
    $PY podctl.py delete $id 600 && { echo "$id $(date +%s) deleted" >> "$ATT"; id=""; }; exit 1
  fi
  u0=$(date +%s); up=""; while [ "$(date +%s)" -lt "$soft" ] && [ $(( $(date +%s) - u0 )) -lt 240 ]; do r=$(tmo 30 $PY runpod.py ssh $id 'echo up' 2>/dev/null | head -c 2); [ "$r" = up ] && { up=1; break; }; sleep 10; done
  [ -n "$up" ] && break
  echo "$(date +%H:%M) $id unreachable; deleting"; $PY podctl.py delete $id 600 || { state="UNREACHABLE POD NOT DELETED"; exit 1; }; echo "$id $(date +%s) deleted" >> "$ATT"; id=""; tries=$((tries+1))
done
[ -z "$id" ] && { state="NO POD"; exit 1; }
echo "$(date +%H:%M) pod $id ($v vCPU, $cph USD/h): soft stop in $(( soft - $(date +%s) ))s, hard stop in $(( hard - $(date +%s) ))s (run $RUN, cap $CAP USD, PRIOR $PRIOR USD)"
tmo 900 $PY runpod.py push $id $TGZ /root/rc.tgz >/dev/null 2>&1 || { state="UPLOAD FAILED (code)"; exit 1; }
tmo 1800 $PY runpod.py push $id $BTGZ /root/rb.tgz >/dev/null 2>&1 || { state="UPLOAD FAILED (bundle)"; exit 1; }
tmo 900 $PY runpod.py ssh $id 'set -e; mkdir -p touchstone bundle; tar xzf rc.tgz -C touchstone; tar xzf rb.tgz -C bundle; which uv >/dev/null || { curl -LsSf https://astral.sh/uv/install.sh | sh >/dev/null 2>&1; }; export PATH=$HOME/.local/bin:$PATH; cd touchstone; uv sync --frozen -q; mkdir -p results/logs' >/dev/null 2>&1 || { state="PREP FAILED (unpack or sync)"; exit 1; }
chk=$(tmo 300 $PY runpod.py ssh $id "cd touchstone; export PATH=\$HOME/.local/bin:\$PATH; echo git=\$(git rev-parse HEAD 2>&1) env=\${TOUCHSTONE_IDENTITY_SALT:-unset} bundle=\$(ls /root/bundle/eval-all/freeze | wc -l); m=\$(cat /sys/fs/cgroup/memory.max 2>/dev/null || cat /sys/fs/cgroup/memory/memory.limit_in_bytes 2>/dev/null); case \$m in max|''|9223372036854*) m=\$(awk '/MemTotal/ {print \$2*1024}' /proc/meminfo);; esac; echo memgb=\$((m/1073741824)); echo py=\$(uv run --frozen python -c 'import platform,numpy;print(platform.python_version(),numpy.__version__)' 2>&1 | tail -n 1 | tr ' ' _)" 2>/dev/null | tr '\n' ' ')
echo "$(date +%H:%M) prep: $chk"
case "$chk" in *"git=$EXPECT"*"env=unset"*) ;; *) state="PREP FAILED"; exit 1 ;; esac
memgb=$(echo "$chk" | sed -n 's/.*memgb=\([0-9]*\).*/\1/p'); [ -n "$memgb" ] && [ "$memgb" -ge "$MINMEM" ] || { state="PREP FAILED (memory ${memgb:-unknown} GB < $MINMEM GB)"; exit 1; }
# The admission inputs (plans section 5, launcher handoff): this launch's attempts file (closed attempts count at the
# ceiling; the open start is this pod's request time) and the ledger (earlier launches of the run tag). Both are fixed
# for the pod's life (no attempt event or ledger row can appear while it runs), so one push covers every paid step.
tmo 120 $PY runpod.py push $id "$ATT" /root/f2.attempts >/dev/null 2>&1 || { state="UPLOAD FAILED (attempts)"; exit 1; }
tmo 120 $PY runpod.py push $id "$SNAP" /root/f2.ledger.json >/dev/null 2>&1 || { state="UPLOAD FAILED (ledger)"; exit 1; }
# The run's own steps, kept literal ($ expands on the pod); inserted into the remote script below as one value.
if [ "$RUN" = A ]; then
RBODY=$(cat <<'RA'
step "reset gate" 0.61
"""Shared guards of the follow-up runs in docs/revision/followup2 (internal review round 1 of both plans): pinned search
settings, budgets checked against the frozen records, saved results reused only under the same binding, a
driver-specific inventory, a cost stop between stages (never a kill), and saved reproduction evidence."""
from __future__ import annotations

import json
import math
import os
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[2]
sys.path.insert(0, str(ROOT)); sys.path.insert(0, str(HERE.parent / "followup"))

import reset_followup_v2 as F  # noqa: E402
from sim.records_v2 import read, sha_file, write  # noqa: E402

PINNED = ("experiments/locked.yaml", "experiments/revision-v2-manifest.yaml")


def _refuse(msg: str):
    raise SystemExit(f"follow-up refused: {msg}")


def pin_settings() -> None:
    """The locked search settings and the manifest are those of protocol-v2, with no TOUCHSTONE_LOCKED override."""
    if os.environ.get("TOUCHSTONE_LOCKED"):
        _refuse("TOUCHSTONE_LOCKED is set; the locked settings must be the registered file")
    r = subprocess.run(["git", "diff", "--quiet", "protocol-v2", "--", *PINNED], cwd=ROOT)
    if r.returncode != 0:
        _refuse(f"{PINNED} differ from protocol-v2 (or the tag is missing)")


def check_budget(job: dict, frozen_record) -> None:
    rec = read(frozen_record)
    if rec is None or list(rec["provenance"]["budget"]) != list(job["budget"]):
        _refuse(f"{job['id']}: search budget {job['budget']} is not the frozen record's {None if rec is None else rec['provenance']['budget']}")


def binding(inputs_sha: str, provenance: dict, smoke: bool, settings: dict, driver_sha: str, deps: dict | None = None) -> dict:
    """`deps`: hashes of everything else a result depends on (helpers, plan, report, posthoc, registered records)."""
    b = {"inputs_sha": inputs_sha, "provenance": provenance, "smoke": bool(smoke), "settings": settings, "driver_sha": driver_sha, "deps": dict(deps or {})}
    return json.loads(json.dumps(b, default=float))              # the form it has when read back (tuples become lists)


def reusable(path, b: dict) -> bool:
    """False if nothing is saved; True if the saved result has this exact binding; refused otherwise (never overwritten)."""
    rec = read(path)
    if rec is None:
        return False
    if rec.get("binding") != b:
        _refuse(f"{path}: a saved result with another binding exists")
    return True


def finite(*xs) -> bool:
    def vals(x):
        if isinstance(x, dict):
            for v in x.values():
                yield from vals(v)
        elif isinstance(x, (list, tuple)):
            for v in x:
                yield from vals(v)
        elif isinstance(x, (int, float)) and not isinstance(x, bool):
            yield x
    return all(math.isfinite(v) for x in xs for v in vals(x))


def environment() -> dict:
    env = dict(F.environment()); env.pop("driver_sha256", None)          # the helper hashes the reset driver, not this one
    return env


def inventory(out, deviations, files: dict, args) -> dict:
    """Every output file with its hash; this run's deviations; hashes of this driver, the shared modules, the imported
    helpers, the plan and the report; the run arguments and the environment."""
    out = Path(out)
    fixed = {"common.py": HERE / "common.py", "guards.py": HERE / "guards.py", "reset_followup_v2.py": HERE.parent / "followup" / "reset_followup_v2.py",
             "revision_v2.py": ROOT / "scripts" / "revision_v2.py"}
    hashes = {k: sha_file(Path(p)) for k, p in {**fixed, **files}.items() if Path(p).exists()}
    recs = {str(p.relative_to(out)): sha_file(p) for p in sorted(out.rglob("*"))
            if p.is_file() and p.name != "inventory.json" and not p.name.endswith((".lock", ".tmp"))}
    inv = {"stage": "inventory", "deviations": list(deviations), "files": hashes, "args": list(args), "environment": environment(), "records": recs}
    write(out / "inventory.json", inv)
    return inv


class CostStop:
    """Checked between stages: a stage starts only if the billed time so far plus its estimate stays within the cap.
    A running stage is never interrupted (the author: do not kill jobs); the run stops and reports instead."""

    def __init__(self, cap_usd: float, usd_per_hour: float, started: float, clock=time.time, prior_usd: float = 0.0,
                 stop_file=None, soft_deadline: float | None = None):
        self.cap, self.rate, self.started, self.clock, self.stopped, self.log = float(cap_usd), float(usd_per_hour), float(started), clock, None, []
        self.prior = float(prior_usd)                                    # earlier attempts and launches of the same run count toward the cap
        self.stop_file, self.soft = (Path(stop_file) if stop_file else None), soft_deadline     # the launcher's STOP file and soft deadline

    def allow(self, stage: str, est_hours: float) -> bool:
        if not (math.isfinite(float(est_hours)) and est_hours >= 0):
            _refuse(f"the step estimate {est_hours} hours must be finite and nonnegative")
        spent = self.prior + (self.clock() - self.started) / 3600 * self.rate; ok = spent + est_hours * self.rate <= self.cap + 1e-9
        if (self.stop_file is not None and self.stop_file.exists()) or (self.soft is not None and self.clock() >= self.soft):
            ok = False
        self.log.append({"stage": stage, "spent_usd": round(spent, 4), "next_usd": round(est_hours * self.rate, 4), "allowed": ok})
        if not ok and self.stopped is None:
            self.stopped = stage
        return ok

    def report(self) -> dict:
        return {"cap_usd": self.cap, "usd_per_hour": self.rate, "prior_usd": self.prior, "stopped_before": self.stopped, "log": self.log,
                "note": "an admission limit checked before each stage or round; a running stage finishes, so billing can exceed the cap by that stage"}


def attempts_spend(path, usd_per_hour: float, started: float | None = None, now: float | None = None) -> dict:
    """The launcher's attempts file (results/pods/reset_pod.sh: one line per event, `<pod> <epoch> start` or
    `<pod> <epoch> deleted`), validated: finite epochs in nondecreasing order, every deletion after its pod's start, and
    exactly one open attempt (the current pod). A closed attempt is billed at `usd_per_hour` (the price ceiling); the open
    one is the caller's, counted from `started`, which must lie between the open start and `now`."""
    p = Path(path) if path else None
    if p is None or not p.exists():
        _refuse(f"no launcher attempts file at {path}")
    starts, closed, last = {}, 0.0, -math.inf
    for line in p.read_text().splitlines():
        if not line.strip():
            continue
        parts = line.split()
        if len(parts) != 3 or parts[2] not in ("start", "deleted"):
            _refuse(f"unreadable line in the attempts file {p}: {line!r}")
        try:
            t = float(parts[1])
        except ValueError:
            t = math.nan
        if not math.isfinite(t) or t < last:
            _refuse(f"a nonfinite or out-of-order epoch in the attempts file {p}: {line!r}")
        last = t; pod, ev = parts[0], parts[2]
        if ev == "start":
            if pod in starts:
                _refuse(f"two starts of {pod} in the attempts file {p}")
            starts[pod] = t
        else:
            if pod not in starts:
                _refuse(f"a deletion of {pod} without an earlier start in the attempts file {p}")
            closed += (t - starts.pop(pod)) / 3600 * usd_per_hour
    if len(starts) != 1:
        _refuse(f"the attempts file {p} must have exactly one open attempt, the current pod; it has {sorted(starts)}")
    (pod, t_open), = starts.items()
    if started is not None:
        now = time.time() if now is None else now
        if not (t_open <= float(started) <= now):
            _refuse(f"the allocation time {started} is not between the open attempt's start {t_open} and now {now}")
    return {"closed_usd": closed, "open": [pod], "open_start": t_open}


def ledger_spend(ledger, tag_prefix: str) -> float:
    """Spend recorded in the budget ledger for earlier launches of this run (the launcher truncates its attempts file);
    the ledger must have a `spent` list whose rows carry a tag and a finite, nonnegative amount."""
    d = read(ledger) if ledger else None
    if not isinstance(d, dict) or not isinstance(d.get("spent"), list):
        _refuse(f"no valid budget ledger at {ledger} (a `spent` list is required)")
    tot = 0.0
    for r in d["spent"]:
        usd = r.get("usd") if isinstance(r, dict) else None
        if not isinstance(usd, (int, float)) or isinstance(usd, bool) or not math.isfinite(usd) or usd < 0 or "tag" not in r:
            _refuse(f"a malformed spend row in the ledger {ledger}: {r!r}")
        if str(r["tag"]).startswith(tag_prefix):
            tot += float(usd)
    return tot


def paid_cost_stop(cap_usd: float, usd_per_hour: float, started, attempts, ledger=None, tag: str | None = None, clock=time.time,
                   stop_file=None, soft_deadline=None) -> CostStop:
    """A paid run must state the pod allocation time, a positive rate (the price ceiling), the launcher's attempts file,
    and the ledger with the run's tag: closed attempts of this launch and recorded spend of earlier launches count toward
    the cap (no default of zero)."""
    if started is None:
        _refuse("a paid run needs --started-at (the pod allocation time)")
    if not (math.isfinite(float(usd_per_hour)) and usd_per_hour > 0 and math.isfinite(float(cap_usd)) and cap_usd > 0):
        _refuse("a paid run needs a finite positive rate and cap")
    if attempts is None:
        _refuse("a paid run needs --attempts (the launcher's attempts file)")
    if not tag:
        _refuse("a paid run needs --run-tag and --ledger (spend of earlier launches)")
    att = attempts_spend(attempts, usd_per_hour, started, clock())
    prior = att["closed_usd"] + ledger_spend(ledger, tag)
    return CostStop(cap_usd, usd_per_hour, att["open_start"], clock, prior, stop_file, soft_deadline)   # counted from the recorded open event


ENV_KEYS = ("cpu", "machine", "platform", "python", "numpy", "scipy", "cma", "blas")


def same_environment(a: dict, b: dict) -> bool:
    return all(a.get(k) == b.get(k) for k in ENV_KEYS)


def check_gate_evidence(paths, want: dict) -> None:
    """Run B: for every gate cell, a passing gate record from the Mac and one from this machine (same numerical stack),
    each with exactly the expected binding (full-budget provenance, gate settings, input hashes, driver, dependencies)."""
    recs = [read(p) for p in paths]; here = environment()
    for cell, b in want.items():
        for site in ("mac", "pod"):
            ok = [r for r in recs if r and r.get("stage") == "convergence gate" and r.get("cell") == cell and r.get("site") == site
                  and r.get("pass") is True and r.get("binding") == b and (site == "mac" or same_environment(r.get("environment") or {}, here))]
            if not ok:
                _refuse(f"no valid {site} gate evidence for {cell}")


REPRO_CELL, DBL_CELL = "headline@rho0.2|F111|D2|profit", "fresh0@rho0.2|F111|D2+H3|profit"


def _required_records(d: Path, stage: str, cell: str) -> list:
    if stage == "reproduction gate":
        return ["gate.json", "inputs.json", str(F.R.path_of(d, cell).relative_to(d)), str(F.R.eval_path(d, cell).relative_to(d)),
                f"freeze/{cell.split('|')[0]}.json"]
    return ["gate.json", "inputs.json", str(F.R.path_of(d, cell).relative_to(d)), f"doubling/{F.R._safe(cell)}.json"]


def _deps_ok(d: Path, up: dict, want_ids: set) -> bool:
