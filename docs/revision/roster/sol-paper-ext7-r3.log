   172	# Internal review ext7 r1 (both seats): the map must follow recorded dependencies (references, banks, warm starts), not
   173	# only direct inputs; refusal statuses and non-finite values must make a cell not assessed; the export lists every cell.
   174	def _write(d, rel, obj):
   175	    import hashlib
   176	    p = d / rel; p.parent.mkdir(parents=True, exist_ok=True); b = json.dumps(obj).encode(); p.write_bytes(b)
   177	    return hashlib.sha256(b).hexdigest()
