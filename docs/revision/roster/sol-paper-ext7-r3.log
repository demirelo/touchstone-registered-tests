   183	    hr = _write(tmp_path, "reference/fresh0@rho0.2/Cstar.json", {"stage": "reference", "upstream": {a: ha}})
   184	    hb = _write(tmp_path, "search/b.json", {"stage": "search", "upstream": {a: ha}})
   185	    _write(tmp_path, f"evaluate/{S._safe(b)}.json", {"stage": "evaluate", "upstream": {b: hb, "reference/fresh0@rho0.2/C*": hr}})
   186	    deps = S.dependencies(tmp_path, [b])
   187	    assert deps[b] == {a, b, "reference/fresh0@rho0.2/C*"}
   188	    with pytest.raises(FileNotFoundError):
