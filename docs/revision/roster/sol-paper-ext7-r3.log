   167	def dependencies(records, ids) -> dict:
   168	    """Search id -> every record key its evaluated estimate depends on: the id, then the recorded upstream links (file
   169	    hashes) of its evaluation record, followed transitively (references, banks, warm-start incumbents). An id without an
   170	    evaluation or search record raises: an unmapped input must not pass as unflagged."""
   171	    root = Path(records); index = {}
   172	    for f in root.rglob("*.json"):
   173	        index[hashlib.sha256(f.read_bytes()).hexdigest()] = f
   174	    out = {}
   175	    for rid in ids:
   176	        start = next((f for f in (root / "evaluate" / f"{_safe(rid)}.json", root / "search" / f"{_safe(rid)}.json") if f.exists()), None)
   177	        if start is None:
   178	            raise FileNotFoundError(f"no evaluation or search record for {rid}")
   179	        keys, todo, seen = {rid}, [start], set()
   180	        while todo:
   181	            f = todo.pop()
   182	            if f in seen:
   183	                continue
   184	            seen.add(f)
   185	            up = json.loads(f.read_text()).get("upstream") or {}
   186	            for k, h in up.items():
   187	                keys.add(k)
   188	                if h not in index:
   189	                    raise FileNotFoundError(f"unresolved upstream link {k} ({h[:12]}) of {f}")
   190	                todo.append(index[h])
   191	        out[rid] = keys
   192	    return out
