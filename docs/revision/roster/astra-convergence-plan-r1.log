def expected_upstream(rid: str, catalog: list[dict], cuts: int = 0, h4_excluded: bool = False) -> set:
    """The dependency ids a record must list (design 6.4 order), derived independently of the record."""
    by = _by_id(catalog)
    if "|" in rid:
        j = by[rid]; ctx, rule, fam, obj = j["context"], j["rule"], j["family"], j["objective"]
        if obj == "profit":
            return {_menu_id(ctx, rule, "D2+H3")} if fam == "X7-SC" else set()
        if obj == "W0":
            return {cell_id(ctx, rule, "D2+H3", "W0")} if fam == "X7-SC" else set()
        if obj == "W1":
            return {f"reference/{ctx}/{rule}"} | ({cell_id(ctx, rule, "D2+H3", "W1")} if fam == "X7-SC" else set())
        if obj == "total":
            return {_twin_id(ctx, _coalition_tag(j), j["schedule"])} if fam == "X6-SE/v2" else set()
        return {f"joint_reference_pre/{ctx}/{_coalition_tag(j)}"}
    kind, ctx, rest = rid.split("/", 2)
    if kind == "reference":
        ids = {_menu_id(ctx, rest, f) for f in MAN.menu_families(manifest_ctx(ctx), rest)}
        if rest in FIXED:
            ids |= {_menu_id(ctx, o, f) for f in MENU for o in MAN.bank_rules(manifest_ctx(ctx), f, cuts, h4_excluded) if o != rest}
        return ids
    if kind == "envelope":
        return {f"reference/{ctx}/{rest}"} | {cell_id(ctx, rest, f, "profit") for f in MAN.doc()["envelope_families"] if cell_id(ctx, rest, f, "profit") in by}
    if kind == "bank":
        return {cell_id(ctx, r, rest, "profit") for r in MAN.FACTORIAL if cell_id(ctx, r, rest, "profit") in by}
    if kind == "bank_train":
        return {f"bank/{ctx}/{rest}"} | {f"reference/{ctx}/{r}" for r in MAN.FACTORIAL if cell_id(ctx, r, rest, "profit") in by}
    if kind == "envelope_select":
        return {f"bank_train/{ctx}/{rest.rsplit('/', 1)[1]}"}
    if kind == "welfare_select":
        rule, obj = rest.rsplit("/", 1)
        return {cell_id(ctx, rule, f, obj) for f in MENU if cell_id(ctx, rule, f, obj) in by}
    if kind in COALITION_STEPS:
        group = _group(_group_job(kind, ctx, rest, catalog), catalog)
        tot = {j["id"] for j in group if j["objective"] == "total"}; mins = {j["id"] for j in group if j["objective"] == "min"}
        if kind == "joint_twin":
            return set()
        if kind == "joint_reference_pre":
            return {_twin_id(ctx, rest, s) for s in _x6_schedules(group)} | tot
        if kind == "joint_reference":
            return {f"joint_reference_pre/{ctx}/{rest}"} | mins
        return {f"joint_reference/{ctx}/{rest}"} | mins
    raise ValueError(rid)


