from __future__ import annotations

import hashlib
import json
from pathlib import Path

import yaml

from .config import MarketConfig, ProviderParams

import os

DEFAULT_PATH = Path(__file__).resolve().parents[1] / "experiments" / "locked.yaml"


def load_locked(path: str | Path | None = None) -> dict:
    """The locked file; TOUCHSTONE_LOCKED (read at call time) exists for synthetic tests only, and scripts/check_claim.py
    refuses to run with it set."""
    path = Path(path) if path is not None else Path(os.environ.get("TOUCHSTONE_LOCKED") or DEFAULT_PATH)
    with open(path) as f:
        return yaml.safe_load(f)


def seeds(locked: dict, namespace: str) -> list[int]:
    v = locked["seeds"].get(namespace)
    if v is None and namespace == "final_eval":
        from .registry import SEALED_DIR
        if (SEALED_DIR / "final_eval_seeds.json").exists():
            from .sealed import final_eval_seeds, verify_bundle
            verify_bundle(SEALED_DIR, locked)                 # the seeds count only from a bundle that matches the lock commitment
            return final_eval_seeds(SEALED_DIR)
    if v is None:
        raise ValueError(f"seed namespace {namespace!r} is not available (final-eval seeds are released with the sealed bundle)")
    return [int(x) for x in v]


def sha256_file(path: str | Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 16), b""):
            h.update(chunk)
    return h.hexdigest()


def settings_hash(locked: dict) -> str:
    """Hash of every experimental setting: the whole file except the version label and the blocks written at the lock
    (tuned, calibration, the coverage report hash and consequences, the comprehension fixture hash, and the sealed
    bundle hash by the lock tooling; identity_salt_sha256 by the separate session; h1.cost_cap_usd from the token
    pilot), so installing them at the lock keeps the pre-lock artifacts valid."""
    skip = ("version", "tuned", "calibration", "identity_salt_sha256", "sealed_bundle_sha256", "coverage_report_sha256",
            "comprehension_fixture_sha256", "coverage_consequences")
    bound = {k: v for k, v in locked.items() if k not in skip}
    if isinstance(bound.get("h1"), dict):
        bound["h1"] = {k: v for k, v in bound["h1"].items() if k not in ("cost_cap_usd", "prices")}   # measured figures, never results
    return hashlib.sha256(json.dumps(bound, sort_keys=True).encode()).hexdigest()


def market_config_from_locked(locked: dict) -> MarketConfig:
    mk = locked["market"]; pt = mk["providers"]
    providers = tuple(ProviderParams(q_max=float(q), a=float(a), b=float(b), k=int(k))
                      for q, a, b, k in zip(pt["q_max"], pt["a"], pt["b"], pt["k"]))
    return MarketConfig(N=int(mk["N"]), J=int(mk["J"]), T=int(mk["T"]), sigma=float(mk["sigma"]), e=float(mk["e"]),
                        v_min=float(mk["v_min"]), v_max=float(mk["v_max"]), providers=providers, alpha=0.0, budget=0.0)
"""Shared analysis of the follow-up runs (docs/revision/followup2): paired seed bootstrap and the descriptive Q1 category."""
import sys
from pathlib import Path

import numpy as np
import pytest

sys.path.insert(0, str(Path(__file__).resolve().parent))
import common as C  # noqa: E402


def test_pooled_difference_is_the_mean_of_market_means():
    a = {"m0": np.array([0.3, 0.5]), "m1": np.array([0.1, 0.1, 0.1])}
    b = {"m0": np.array([0.1, 0.1]), "m1": np.array([0.0, 0.0, 0.0])}
    got = C.pooled_paired(a, b, resamples=999, seed=0)
    assert got["markets"] == {"m0": pytest.approx(0.3), "m1": pytest.approx(0.1)} and got["estimate"] == pytest.approx(0.2)
    lo, hi = got["interval"]; assert lo <= 0.2 <= hi


def test_bootstrap_is_reproducible_and_pairs_seeds():
    rng = np.random.default_rng(1); x = rng.normal(size=50); y = x + 0.01
    a, b = {"m": y}, {"m": x}
    g1, g2 = C.pooled_paired(a, b, 999, 0), C.pooled_paired(a, b, 999, 0)
    assert g1 == g2 and g1["interval"][0] == pytest.approx(0.01) and g1["interval"][1] == pytest.approx(0.01)   # paired: no spread


@pytest.mark.parametrize("iv,cat", [((0.06, 0.08), "materially lower (R3 lower)"), ((-0.09, -0.06), "materially lower (comparator lower)"),
                                    ((0.01, 0.03), "equivalent, direction R3 lower"), ((-0.03, 0.03), "equivalent"),
                                    ((0.02, 0.07), "ordered, size not established"), ((-0.02, 0.07), "inconclusive")])
def test_descriptive_q1_category_uses_the_registered_margin(iv, cat):
    assert C.q1_category(iv) == cat


def test_unequal_seeds_are_refused():
    with pytest.raises(ValueError):
        C.pooled_paired({"m": np.zeros(2)}, {"m": np.zeros(3)}, 99, 0)
