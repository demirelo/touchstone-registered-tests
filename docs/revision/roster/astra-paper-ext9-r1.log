+               "mean_false_refund": float(np.mean([b["false_refund"] for b in v["bins"]]))} for r, v in d.items()}
+    res["r3_minus_cstar_profit_per_round"] = res["F111"]["mean_profit_per_round"] - res["C*"]["mean_profit_per_round"]
+    return res
+
