   389	def memory_preflight(stage: str, jobs: list[dict], out, requested: int, runner=None, limit: int | None = None, parent: int | None = None,
   390	                     margin: float = 1.25) -> dict:
   391	    """Pod-side, before a four-profile stage (plan section 7): run the sample tasks for real in child processes, take the
   392	    largest peak, add a margin of 25 percent for variation across markets, rules and winners, and choose the workers that
   393	    fit the memory limit beside the parent. The measured tasks' records are kept and not run again.
   394	    Review r4: a task whose record already existed ("skipped") is no measurement; the next unfinished task of the same
   395	    group is measured instead. A retry reuses a validated saved measurement; without either, dispatch is refused."""
   396	    import resource
   397	    import time
   398	    t0 = time.time(); runner = runner or _measure_child
   399	    parent = parent if parent is not None else resource.getrusage(resource.RUSAGE_SELF).ru_maxrss * (1 if sys.platform == "darwin" else 1024)
   400	    limit = limit if limit is not None else memory_limit()
   401	    saved = _saved_preflight(stage, jobs, out, limit, margin)
   402	    if saved is not None:
   403	        w = plan_workers(limit, int(margin * saved["task_peak_bytes"]), parent, requested)
   404	        rec = {**saved, "parent_bytes": parent, "requested": requested, "workers": w, "reused": True, "seconds": time.time() - t0}
   405	        write(Path(out) / f"memory_preflight_{stage}.json", rec)
   406	        return rec
   407	    peaks, skipped = {}, []
   408	    for group in _preflight_groups(stage, jobs):
   409	        for j in group:
   410	            r = runner(stage, j, out, jobs)
   411	            if r.get("status") == "done":
   412	                peaks[j["id"]] = int(r["peak_rss_bytes"]); break
   413	            skipped.append(j["id"])
   414	        else:
   415	            raise SystemExit(f"churn arm refused: no memory evidence for {stage} (every task of a group was already done "
   416	                             f"and no saved measurement applies)")
   417	    peak = max(peaks.values())
   418	    w = plan_workers(limit, int(margin * peak), parent, requested)
   419	    rec = {"stage": stage, "limit_bytes": limit, "task_peak_bytes": peak, "peaks": peaks, "margin": margin, "parent_bytes": parent,
   420	           "requested": requested, "workers": w, "measured": list(peaks), "skipped": skipped, "reused": False, "seconds": time.time() - t0}
   421	    write(Path(out) / f"memory_preflight_{stage}.json", rec)
   422	    return rec
