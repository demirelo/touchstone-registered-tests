   453	def _run_rate(out, jobs, steps, a, salt_sha, container, p, started) -> None:
   454	    F.check_configs(jobs, container); F.check_salt(out, salt_sha, jobs); F.check_commit(jobs); F.check_code()
   455	    if not a.smoke:
   456	        F.check_pairing(a.src, jobs)
   457	    slow = 1.33 if p > 0 else 1.0
   458	    lim = None if a.smoke else memory_limit()                                   # review r4: the limit persists across commands
   459	    sv = saved_workers(out, lim); w_mem = min(a.workers_eval, sv) if sv else a.workers_eval
   460	    cap = lambda need: check_cap(started, need, a.stop_usd, a.usd_per_hour, prior_usd=a.prior_usd)
   461	    for st in steps:
   462	        if st == "inputs":
   463	            F.copy_inputs(a.src, out, F.inputs(a.src, jobs))
   464	        elif st == "search":
   465	            cap(STAGE_SECONDS["search"] * slow * _waves(len(jobs), a.workers_search)); run_stage("search", jobs, out, a.workers_search)
   466	        elif st == "freeze":
   467	            F.prefreeze(out, jobs)
   468	        elif st in ("evaluate", "doubling"):
   469	            sec = STAGE_SECONDS[st] * slow
   470	            k = len(preflight_sample(st, jobs)) if (not a.smoke and len(jobs) > 1) else 0
   471	            cap(sec * (k + _waves(len(jobs) - k, w_mem)))                       # admission includes the serial preflight tasks
   472	            F.accept(out, jobs, salt_sha, container, src=a.src)
   473	            rest = jobs
   474	            if k:
   475	                mp = memory_preflight(st, jobs, out, w_mem)
   476	                w_mem = save_workers(out, min(w_mem, mp["workers"]), mp.get("limit_bytes", lim), st)
   477	                rest = [j for j in jobs if j["id"] not in set(mp["measured"])]
   478	                cap(sec * _waves(len(rest), w_mem))                             # admission again with the chosen workers
   479	            run_stage(st, rest, out, w_mem)
   480	        elif st == "diagnostics":
   481	            if not a.smoke and len(jobs) > 1:
   482	                sv = saved_workers(out, lim)
   483	                if sv is None:
   484	                    raise SystemExit("churn arm refused: diagnostics needs memory evidence (an evaluate or doubling preflight "
   485	                                     "of this output on this memory limit)")
   486	                w_mem = min(w_mem, sv)
   487	            cap(STAGE_SECONDS["diagnostics"] * slow * _waves(len(jobs), w_mem))
   488	            write(Path(out) / "diagnostics.json", diagnostics(out, jobs, w_mem))
   489	        else:
   490	            inventory(out, p)
   491	        print(json.dumps({"churn": p, "stage": st, "jobs": len(jobs), "workers_memory": w_mem}), flush=True)
