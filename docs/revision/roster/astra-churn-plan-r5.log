   542	    if not a.smoke:
   543	        require_gate(base, a.req_id)
   544	    for p in (float(x) for x in a.rates.split(",")):
   545	        out = base / f"p{p:g}"; out.mkdir(parents=True, exist_ok=True); R.install_salt(root, out)
   546	        jobs = build_jobs(root, cfgs, params, salt_sha, p, tuple(a.markets.split(",")), tuple(a.rules.split(",")), a.smoke)
   547	        _run_rate(out, jobs, steps, a, salt_sha, container, p, a.started)
   548	    return 0
