   532	        jobs = build_jobs(root, cfgs, params, salt_sha, 0.0, (GATE_CELL[0],), (GATE_CELL[1],), a.smoke)
   533	        _run_rate(out, jobs, ("inputs", "search", "freeze", "evaluate", "doubling", "inventory"), a, salt_sha, container, 0.0, a.started)
   534	        rid = R.cell_id(f"{GATE_CELL[0]}@rho0.2", GATE_CELL[1], "D2+H3", "profit")
   535	        g = gate_compare(a.src, out, rid, jobs[0]["id"], a.req_id); inventory(out, 0.0)
   536	        print(json.dumps({"gate_ok": g["gate_ok"], "identical": g["identical"], "search": g["search"].get("problems"), "doubling": g["doubling"].get("problems")}), flush=True)
   537	        if not g["gate_ok"] and not a.smoke:
