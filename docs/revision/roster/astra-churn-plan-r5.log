   519	        base.mkdir(parents=True, exist_ok=True)
   520	        write(base / "run.json", {"started": a.started, "usd_per_hour": a.usd_per_hour, "prior_usd": a.prior_usd, "stop_usd": a.stop_usd})
   521	    if a.usd_per_hour is None:
   522	        a.usd_per_hour = POD_USD_PER_HOUR
   523	    from sim.records import cfg_from_dict
   524	    root = json.loads(Path(a.draw).read_text())["hash"]; salt_sha = json.loads(Path(a.instances).read_text())["salt_sha256"]
   525	    container = json.loads(Path(a.addendum).read_text())["deviations"]["configs"]
