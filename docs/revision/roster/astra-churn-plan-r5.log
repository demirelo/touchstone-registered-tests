   371	def _saved_preflight(stage: str, jobs: list[dict], out, limit: int, margin: float) -> dict | None:
   372	    """A saved measurement of this stage that still applies: same memory limit and margin, a positive peak taken only from
   373	    real runs, and measured jobs that belong to this job list. Anything else is no evidence."""
   374	    p = Path(out) / f"memory_preflight_{stage}.json"
   375	    if not p.exists():
   376	        return None
   377	    try:
   378	        rec = json.loads(p.read_text())
   379	    except ValueError:
   380	        return None
   381	    ids = {j["id"] for j in jobs}
   382	    ok = (rec.get("stage") == stage and rec.get("limit_bytes") == limit and rec.get("margin") == margin
   383	          and isinstance(rec.get("task_peak_bytes"), int) and rec["task_peak_bytes"] > 0 and rec.get("measured")
   384	          and set(rec["measured"]) <= ids and set(rec.get("peaks") or {}) == set(rec["measured"])
   385	          and rec["task_peak_bytes"] == max(rec["peaks"].values()))
   386	    return rec if ok else None
