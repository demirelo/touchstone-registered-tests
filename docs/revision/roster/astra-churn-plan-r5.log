    13	def billed(workers_search=16, workers_eval=9, preflight=True):
    14	    gate = S["search"] + S["evaluate"] + S["doubling"]                     # the p = 0 gate cell, serially
    15	    sec = gate
    16	    for s in SLOW.values():
    17	        ke, kd = (RULES, 1) if preflight else (0, 0)
    18	        sec += s * (S["search"] * _waves(JOBS, workers_search)
    19	                    + S["evaluate"] * (ke + _waves(JOBS - ke, workers_eval))
    20	                    + S["doubling"] * (kd + _waves(JOBS - kd, workers_eval))
    21	                    + S["diagnostics"] * _waves(JOBS, workers_eval))
    22	    h = sec / 3600 + PREP_H
    23	    return {"stage_hours": round(sec / 3600, 2), "billed_hours": round(h, 2), "usd": round(h * USD_H, 2)}
