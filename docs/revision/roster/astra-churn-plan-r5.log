   500	    ap.add_argument("--rules", default=",".join(RULES)); ap.add_argument("--rates", default=",".join(f"{p:g}" for p in RATES))
   501	    ap.add_argument("--stage", default="all", choices=("inputs", "search", "freeze", "evaluate", "doubling", "diagnostics", "inventory", "all"))
   502	    ap.add_argument("--workers-search", dest="workers_search", type=int, default=16); ap.add_argument("--workers-eval", dest="workers_eval", type=int, default=9)
   503	    ap.add_argument("--started", type=float, default=None, help="epoch seconds of pod allocation; spend is billed from it")
   504	    ap.add_argument("--stop-usd", dest="stop_usd", type=float, default=STOP_USD)
   505	    ap.add_argument("--usd-per-hour", dest="usd_per_hour", type=float, default=None, help="the pod's actual hourly price (required in production)")
   506	    ap.add_argument("--prior-usd", dest="prior_usd", type=float, default=0.0, help="charges of earlier failed attempts of this arm")
   507	    ap.add_argument("--gate", choices=("first", "only", "skip"), default="first", help="the p = 0 reproduction gate (plan section 3 c)")
   508	    ap.add_argument("--require-identical", dest="req_id", action="store_true", help="the pod gate: bit identity (the author's decision)")
   509	    ap.add_argument("--smoke", action="store_true")
   510	    a = ap.parse_args(argv); base = Path(a.out); F.check_out(base, a.src)
