   425	def saved_workers(out, limit) -> int | None:
   426	    """The lowest worker count validated on this memory limit by an earlier preflight of this output (any command)."""
   427	    p = Path(out) / "memory_workers.json"
   428	    if limit is None or not p.exists():
   429	        return None
   430	    try:
   431	        rec = json.loads(p.read_text())
   432	    except ValueError:
   433	        return None
   434	    w = rec.get("workers")
   435	    return w if rec.get("limit_bytes") == limit and isinstance(w, int) and w >= 1 else None
   436	
   437	
   438	def save_workers(out, workers: int, limit, stage: str) -> int:
   439	    prev = saved_workers(out, limit); w = min(workers, prev) if prev else workers
   440	    p = Path(out) / "memory_workers.json"; old = json.loads(p.read_text()) if p.exists() else {}
   441	    stages = old.get("stages", {}) if old.get("limit_bytes") == limit else {}
   442	    write(p, {"workers": w, "limit_bytes": limit, "stages": {**stages, stage: workers}})
   443	    return w
   444	
   445	
   446	STAGE_SECONDS = {"search": 2084.3, "evaluate": 120.0, "doubling": 997.8, "diagnostics": 60.0}   # benchmark, per job (plan section 7)
   447	
   448	
   449	def _waves(n: int, w: int) -> int:
   450	    return -(-n // max(1, w)) if n > 0 else 0
